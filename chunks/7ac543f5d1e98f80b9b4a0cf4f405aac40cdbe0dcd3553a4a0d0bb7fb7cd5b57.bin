[ClickDoroti]
if,[#IncrMode:#ok]
  if,[#item:#ok]
    if,[#cursor:[#rs1,#ve,#arc,#la1,#la2,#la4,#np1,#st1,#re,#ps4,#in,#flw,#np,#pf,#la6]]

      if,[#cursor:#arc]
        cursor,#default
        anim,[#sound,0,[],"Cs03an02 frame 1","dol-03",#ext,true,0,true,true]
        SetEvnt,#incr1
        quit
      endif

      if,[#cursor:#rs1]
        cursor,#default
        if,[#WasEvnt:#incr1]
          anim,[#sound,0,[],"Cs03an02 frame 1","dol-08",#ext,true,0,true,true]
        else
          anim,[#sound,0,[],"Cs03an02 frame 1","dol-02",#ext,true,0,true,true]
          Cmd,["WrongIncr"]
        endif
        quit
      endif

      if,[#cursor:#ve]
        cursor,#default
        if,[#WasEvnt:#incr1]
          anim,[#sound,0,[],"Cs03an02 frame 1","dol-04",#ext,true,0,true,true]
          SetEvnt,#IncrDone
          CloseDB1,true
          snd,["IncrDone",#ppt,true]
          SetHelp,"Mel11" 
          LockHelp,true
          SetEvnt,#Mel11Talk
          ClearStuck,#ok
          goto,"cafe"
        else
          anim,[#sound,0,[],"Cs03an02 frame 1","dol-02",#ext,true,0,true,true]
          Cmd,["WrongIncr"]
        endif
        quit
      endif

      if,[#cursor:[#la1,#la2,#la4,#re,#np1,#st1,#ps4,#in]]
        anim,[#sound,0,[],"Cs03an02 frame 1","dol-08",#ext,true,0,true,true]
        cursor,#default
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:#flw]
        cursor,#default
        anim,[#sound,0,[],"Cs03an02 frame 1","dol-08a",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:#np]
        cursor,#default
        anim,[#sound,0,[],"Cs03an02 frame 1","dol-09",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:[#pf,#la6]]
        cursor,#default
        anim,[#sound,0,[],"Cs03an02 frame 1","dol-10",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

    else
      cursor,#default
      anim,[#sound,0,[],"Cs03an02 frame 1","dol-05",#ext,true,0,true,true]
      Cmd,["WrongIncr"]
    endif
  endif
  quit
endif
;
if,[#cursor:#flw]
  cursor,#default
  snd,["mok-ok",#ppt,true]
  anim,[#simple,0,[],"Cs03an11 frame 1","doA2-05a",#ext,true,1,true,true]
  quit
endif
;
if,[#stuck:#ok]
  if,[#item:#ok]
    Hide,16
;
    if,[#WasEvnt:[#close_db12_cloths,#close_db11_photos]]
      snd,["mok-bad",#ppt,true]
      quit 
    endif
;
    if,[#WasEvnt:#can_get_JulBag13]
      if,[#cursor:#JulBag13]
        Cmd,["UnStuck",true]
        anim,[#sound,0,[],"Cs03an02 frame 1","doA1-22m",#ext,true,0,true,true]
        ClrEvnt,#can_get_JulBag13
      else
