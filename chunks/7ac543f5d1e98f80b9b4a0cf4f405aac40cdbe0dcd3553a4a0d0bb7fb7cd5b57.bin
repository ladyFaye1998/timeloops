        SetEvnt,#return_cafe_zoom
        CloseDB1,false
        goto,"cafe"
      endif
    endif
  endif
  quit
else
  if,[#item:#ok]
    if,[#cursor:#rs1]
      if,[#WasEvnt:#can_get_rs1]
        cursor,#default
