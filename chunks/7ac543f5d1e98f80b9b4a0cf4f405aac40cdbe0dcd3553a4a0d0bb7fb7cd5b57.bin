  quit
endif
;
if,[#part:"2"]
  if,[#NotEvnt:#have_notes]
    SetEvnt,#can_get_no
  endif
;
  if,[#NotEvnt:[#return_disk_zoom,#have_notes]]
    anim,[#simple,0,[],"Rs01an1a frame 1","paging",#ppt,false,1,false,false]
    anim,[#sound,0,[],"Rs01an1b frame 1","rib2-01",#ext,true,0,false,false]
