␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{
  "schema_version": 1,
  "locale": "he",
  "source": "Original Hebrew question bitmap sheets. Manual transcription; line breaks joined; original words and question order retained.",
  "review_status": "manual_transcription_with_independent_ocr_cross_check_and_visual_resolution_of_disagreements",
  "sheets": {
    "st5_db1": [
      "1967? איך הגעתי לכאן?",
      "מה אני אמורה לעשות כאן?"
    ],
    "st5_db12": [
      "זה עונש על זה שראיתי יותר מדי את \"חזרה לעתיד\"? מה אני אמורה לעשות עכשיו?"
    ],
    "st5_db11": [
      "אולי ראית מישהו לבוש מעיל נוצות ורוד?",
      "אתה מכיר את העיתונאית מילה גארדיאן?",
      "אתה מכיר את שילה מחנות הבגדים?",
      "אתה מכיר את ריק מחנות התקליטים?"
    ],
    "cafea_db11": [
      "סליחה שאני מתערבת, אבל... איזה פילם נעלם לך?",
      "למה הפילם כל כך חשוב לך?"
    ],
    "cafea_db111": [
      "יש לך מושג איפה הפילם יכול להיות?",
      "אולי מישהו לקח את הפילם?"
    ],
    "cafea_db112": [
      "למה אבא צריך את הפילם?",
      "למה שלא תלכי לפגישה בלי הפילם?"
    ],
    "cafea_db12": [
      "נעלמה לך שמלה?",
      "מאיפה נעלמה השמלה?",
      "למה שמישהו ייקח שמלה?"
    ],
    "cafea_db121": [
      "אבל מי היה רוצה את שמלת החרוזים המוזרה הזאת?",
      "ג'ימי מקנזי לא יזהה אותך בלי השמלה?"
    ],
    "cafea_db123": [
      "נראה לך שמישהו יגנוב שמלה בשביל לטרפד פגישה?",
      "מי יכול לרצות לטרפד את הפגישה שלך עם ג'ימי?"
    ],
    "cafea_db21": [
      "איזה פילם אבד?",
      "האם את היא זו שביטלה את הפגישה עם ג'ימי מקנזי?",
      "אולי שכחת את הפילם איפהשהו?"
    ],
    "cafea_db211": [
      "איזה מחדל אקולוגי?",
      "למה צילמת את זה?"
    ],
    "cafea_db212": [
      "מי היה רוצה לטרפד את הפגישה שלכם?",
      "יכול להיות שמי שרוצה לטרפד את הפגישה הוא שגנב את הפילם?"
    ],
    "cafea_db213": [
      "אולי תנשמי קצת נשימות יוגה - זה תמיד עוזר לך.",
      "תתאמצי להיזכר - זה חשוב להמשך הקשר שלך עם ג'ימי."
    ],
    "cafea_db22": [
      "איזה פתק?",
      "מה חשוד בפתק?"
    ],
    "cafea_db221": [
      "למה אמא שלך היתה מתנגדת לזה?",
      "למה שמישהו יזייף פתק?"
    ],
    "cafea_db222": [
      "מי יכול היה לשלוח את הפתק?",
      "מי ידע על הפתק האנונימי ששלחת לג'ימי?"
    ],
    "cafed_db11": [
      "אולי יש לך מושג מי גנב את הפילם של אליס?",
      "למה הפילם הזה כל כך חשוב לאליס?"
    ],
    "cafed_db112": [
      "למה נראה לך שאליס דלוקה על ג'ימי?",
      "שמעתי שכולן דלוקות על ג'ימי. גם את?"
    ],
    "cafed_db12": [
      "מתבטלת? למה?",
      "אולי את יודעת מי אחראי לזה?"
    ],
    "cafed_db122": [
      "למה שמישהו ירצה למנוע מאליס לפגוש את ג'ימי?",
      "למה הזכרת את סוזן?"
    ],
    "cafed_db13": [
      "את אלרגית למשהו?",
      "את צריכה את הממחטה שלך?",
      "יש לך שם חיבה?"
    ],
    "cafed_db21": [
      "למה הפילם הזה כל כך חשוב לאליס?",
      "אולי יש לך מושג איפה הפילם יכול להיות?"
    ],
    "cafed_db211": [
      "למה את חושבת ככה?",
      "איך אליס מסבירה את הפגישה שלה עם ג'ימי?"
    ],
    "cafed_db22": [
      "מי היה מזייף פתק כדי לטרפד את הפגישה?",
      "את חושבת שאליס מפחדת מכל מה שקורה?"
    ],
    "cafed_db221": [
      "ואת עצמך לא סיפרת לאף אחד?",
      "היית היום במקרה במעבדה?"
    ],
    "cloths_db11": [
      "אולי מצאת כאן פילם?",
      "את מקומית? אולי את יודעת משהו על פיליפס כימיקלים?",
      "אולי את מכירה עיתונאי ששמו ג'ימי מקנזי?"
    ],
    "cloths_db113": [
      "איזו שמועה?",
      "מי מפיץ את השמועה הזו?"
    ],
    "cloths_db12": [
      "קפצתי לקחת את שמלת החרוזים של אליס.",
      "מישהו גנב ממך שמלה?",
      "מה היית עושה אם היית יודעת שג'ימי יוצא עם מישהי אחרת?"
    ],
    "cloths_db121": [
      "אם הקבלה אצלי, אז איך קרה שמישהו הצליח לקחת את השמלה?",
      "יש לך מושג מי לקח את השמלה?"
    ],
    "cloths_db21": [
      "את יוצאת עם ג'ימי מקנזי?",
      "מה היית עושה אם האקס שלך היה מתחיל עם בחורה אחרת?",
      "האם את הבת של מנהל פיליפס כימיקלים?"
    ],
    "cloths_db211": [
      "איזה סיפורים מספרים על המפעל של אבא שלך?",
      "מי מפיץ את השקרים על המפעל של אבא שלך?"
    ],
    "cloths_db213": [
      "את חושבת שלאנשים אחרים יש בעיה עם זה שאת עשירה?",
      "לאיזה מטרות אביך תורם את הכסף?"
    ],
    "cloths_db22": [
      "איבדת זוג משקפיים?",
      "מצאתי פתק שבו ג'ימי מקנזי כותב שהוא יהיה נאמן לך לנצח...",
      "יש לך קול מדהים. היית רוצה לשיר בלהקה?",
      "את יכולה לשיר לי משהו?"
    ],
    "cloths_db221": [
      "תווים של איזה שיר זה?",
      "מי זה סרג'נט פפר?"
    ],
    "cloths_db222": [
      "למה לא היית חוזרת לג'ימי?",
      "את מכירה מישהו עם כתב יד כמו זה?"
    ],
    "diskr_db11": [
      "אני יכולה לעזור לך?"
    ],
    "diskr_db12": [
      "אולי היה כאן היום מישהו לבוש מעיל נוצות?",
      "יש לך צעיף כמו שלי. גם שלך משיר נוצות?"
    ],
    "diskr_db121": [
      "מי זאת וורוניקה?",
      "למה אתה אומר וורוניקה בטון מלגלג?"
    ],
    "diskr_db122": [
      "לאן הלכת היום?",
      "באמת מצאתי עקבות שלך בתיק של אליס..."
    ],
    "diskr_db21": [
      "אולי אתה מכיר את ג'ימי מקנזי?",
      "איך אתה מרגיש כשאתה קורא ביקורת שלילית עליך?"
    ],
    "diskr_db211": [
      "אתה רוצה לומר שאתה וג'ימי חברים?",
      "אתה יודע עם מי ג'ימי מקנזי יוצא?"
    ],
    "diskr_db22": [
      "וואוו! אתה תהיה זמר גדול. אני יכולה לקבל חתימה?!",
      "יש לך בעיה בכתיב?",
      "על מה השיר הזה...?"
    ],
    "lab2_db11": [
      "אולי ראית כאן במקרה סרט צילום?",
      "אכפת לך שאני אסתובב כאן? אליס שלחה אותי לחפש את סרט הצילום שלה?",
      "יום אחד אתה עוד תזכה בפרס נובל. אגב, אולי ראית כאן פילם?"
    ],
    "lab2_db111": [
      "אני ... אהיה קרובה של אליס.",
      "לא, אני לא קרובה של אליס."
    ],
    "lab2_db113": [
      "מי חיפשה את סרט הצילום?",
      "בשביל מה היא הייתה צריכה את הפילם?"
    ],
    "lab2_db12": [
      "לא. דווקא באתי לחפש את השמלה של אליס.",
      "למה חשבת שבאתי לחפש מספריים?",
      "אולי אתה מכיר איזו בטי?"
    ],
    "lab2_db122": [
      "מי עוד היה כאן היום?",
      "איפה המספריים שהשאירו כאן?"
    ],
    "lab2_db123": [
      "אולי אתה מכיר איזו וורוניקה?",
      "אולי אתה מכיר בחורה שקוראים לה בטי?"
    ],
    "lab2_db21": [
      "אולי שמעת משהו על התמונות שצולמו בפיליפס כימיקלים?",
      "אתה מקנא באליס על ההישגים שלה?",
      "אולי ראית כאן את הפילם של אליס?"
    ],
    "lab2_db211": [
      "מי בא לכאן הבוקר?",
      "מה חיפשו כאן?"
    ],
    "lab2_db22": [
      "אולי מישהו ביקר כאן הבוקר?",
      "אני רוצה לראות דוגמה של כתב היד שלך.",
      "אתה טוב באיות נכון? אולי אתה יכול להראות לי איך כותבים \"פשוט\"?"
    ],
    "lab2_db221": [
      "אז מי ביקר כאן חוץ ממני?",
      "מה יש לחפש במעבדה שכולם מבקרים פה?"
    ],
    "papern_db11": [
      "אולי שמעת משהו על פילם שכולם מדברים עליו?",
      "ג'ימי מקנזי עובד כאן?"
    ],
    "papern_db111": [
      "נראה לי שאת תהיי עיתונאית גדולה. אז אולי יש לך רעיון איפה הפילם יכול להיות?",
      "גם את מנסה להשיג את הפילם של פיליפס כימיקלים?"
    ],
    "papern_db112": [
      "איפה ג'ימי?",
      "כקולגה של ג'ימי, אולי את יודעת עם מי הוא יוצא בימים אלה?"
    ],
    "papern_db12": [
      "תגידי, את הוורוניקה שחתומה על טופס הפיתוח?",
      "וורוניקה, ראית את ג'ימי?",
      "אני חושבת שמצאתי במעבדה משהו ששייך לך..."
    ],
    "papern_db122": [
      "אז אולי את יכולה לגלות לי מי זו וורוניקה?"
    ],
    "papern_db123": [
      "על מה הכתבה שאת מכינה?",
      "אולי ראית מישהו חשוד כשהיית במעבדה?"
    ],
    "papern_db21": [
      "הי, ג'ימי מקנזי עובד כאן?",
      "מי התקשרה לבטל את הפגישה?",
      "את יודעת אם ג'ימי יוצא עם מישהי ששמה אליס קפלן?"
    ],
    "papern_db211": [
      "איפה אפשר למצוא את ג'ימי?",
      "אולי את יודעת אם ג'ימי קבע להיום פגישה חשובה?"
    ],
    "papern_db212": [
      "מי למשל?",
      "ג'ימי יהיה מאוכזב?"
    ],
    "papern_db213": [
      "מי זאת שילה?",
      "התכוונתי לאליס, שנלחמת למען שוויון זכויות, אהבה, שלום... את מכירה אותה?"
    ],
    "papern_db22": [
      "זאת את ששכחת משהו במעבדה?",
      "על מה את כותבת עכשיו?",
      "איך השגת את כתבת השער לעצמך?"
    ],
    "papern_db222": [
      "אני אבוא. את יכולה רק לרשום לי את הכתובת?",
      "את יכולה להסביר לי איך להגיע?"
    ],
    "photos_db11": [
      "אולי את מכירה מישהי שקוראים לה וורוניקה?",
      "אולי שמעת על העיתונאי ג'ימי מקנזי?",
      "היית הולכת עם שמלה של אליס?",
      "יש לך שמלה מדליקה, איפה קנית אותה?"
    ],
    "photos_db112": [
      "למה הוא לא בשבילך?",
      "מי כן בשבילך?"
    ],
    "photos_db21": [
      "את מכירה מישהו שחותם בשם: סמך פא (ס.פ)?",
      "את מכירה את אליס קפלן?",
      "איזה שיר זמזמת כשנכנסתי?",
      "יש לך קול יפה. חשבת פעם להצטרף לאיזו להקה?"
    ],
    "photos_db212": [
      "היית יוצאת עם מישהו שאליס יוצאת איתו?",
      "את יודעת משהו על הפגישה המבוטלת של אליס?"
    ],
    "st1_db2": [
      "שמעת אולי על ג'ימי מקנזי?",
      "אתה מכיר את אליס קפלן?"
    ],
    "st1_db3": [
      "אתה מכיר את הבחורה שעובדת בחנות הצילום?",
      "אולי אתה מכיר את דורותי החברה של אליס?",
      "אתה מכיר את לארי צ'אנג מהמעבדה?"
    ],
    "st3_db11": [
      "אולי אתה יודע איפה הארמון לאומנויות יפות?"
    ]
  }
