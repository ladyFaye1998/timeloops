  if,[#story:"1"]
    if,[#WasEvnt:#Clue3]
      Cmd,["HipiTalk","shyAn04",false]
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    if,[#WasEvnt:#Clue2]
      Cmd,["HipiTalk","shyAn02",false]
      SetEvnt,#Clue3
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    if,[#WasEvnt:#Clue1]
      Cmd,["HipiTalk","shyAn03",false]
      SetEvnt,#Clue2
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    Cmd,["HipiTalk","shyAn05",false]
    SetEvnt,#Clue1
    Cmd,["HipiTalk","shyAn81",true]
    quit
  else
    if,[#WasEvnt:#Clue3]
      Cmd,["HipiTalk","shyAn07",false]
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    if,[#WasEvnt:#Clue2]
      Cmd,["HipiTalk","shyAn06",false]
      SetEvnt,#Clue3
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    if,[#WasEvnt:#Clue1]
      Cmd,["HipiTalk","shyAn08",false]
      SetEvnt,#Clue2
      Cmd,["HipiTalk","shyAn81",true]
      quit
    endif
;
    Cmd,["HipiTalk","shyAn05",false]
    SetEvnt,#Clue1
    Cmd,["HipiTalk","shyAn81",true]
    quit
  endif
else
  Cmd,["HipiTalk","shyAn81",true]
endif
