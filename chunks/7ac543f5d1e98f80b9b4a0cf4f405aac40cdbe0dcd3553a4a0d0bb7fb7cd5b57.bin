␀␀␀␀␀␀␀␀; COMMANDS
;-------------
[Goto]
if,[#cursor:#direction]
  goto,"param1"
endif
[END]

[PickItem]
if,[#cursor:#direction]
  cursor,#"param1"
  if,[#NotEvnt:#took_"param1",#InBag:[#julia,#"param1",false]]
    hide,"param1"
  endif
  SetEvnt,#took_"param1"
endif
[END]

[ZoomItem]
if,[#cursor:#direction]
  snd,["ItemZoom",#ppt,flase]
  zoom,"param1"
endif
[END]

[QtnClick]
hlt,
Qtn,"param1"
[END]

[MellHelp]
OpenMell,"param2"
MellTalk,"param1"
CloseMell
[END]

[DoIncr]
snd,["incr",#ppt,true]
anim,[#sound,0,[],""param1"",""param2"",#ext,true,0,true,true]
blink,[53,false]
;
if,[#NotEvnt:#FirstIncrWarn]
  OpenMell,false
  MellTalk,"mel8"
  CloseMell
  SetEvnt,#FirstIncrWarn
endif
;
if,[#WasEvnt:#SecondIncrWarn]
  ClrEvnt,#SecondIncrWarn
  OpenMell,false
  MellTalk,"mel10"
  CloseMell
  SetEvnt,#SecondIncr
endif
;
SetHelp,"Mel9"
[END]

[DoWrongIncr]
ClrEvnt,#IncrFail
;
if,[#NotEvnt:#Incr1]
  WrongIncr,"" 
endif
;
if,[#GameFailed:#ok]
  NewGame,""
else
  if,[#IncrFailed:#ok]
    anim,[#sound,0,[],""param1"",""param2"",#ext,true,0,true,true]
    CloseDB1,true
    SetEvnt,#IncrFail
    IncrOff,""
    goto,"param3"
  endif
endif
[END]

[Stuck]
if,[#Eval:[true,"param1"]]
  snd,["mok-in",#ppt,true]
  stuck,true
else
  stuck,false
endif
Blink,[54,true]
[END]

[UnStuck]
UnStuck,"param1"
cursor,#default
if,[#Eval:[true,"param1"]]
  snd,["mok-ok",#ppt,true]
else
  snd,["mok-bad",#ppt,true]
endif
[END]

[ClsStuck]
UnStuck,false
cursor,#default
CloseDB1,false
goto,"param1"
[END]

[ENDFILE]
