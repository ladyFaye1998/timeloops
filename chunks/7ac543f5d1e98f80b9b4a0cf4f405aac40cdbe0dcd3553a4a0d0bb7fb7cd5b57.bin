  SetEvnt,#HideRick
endif
[END]

[ClickRick]
if,[#part:"2"]
  if,[#item:#ok]
    if,[#cursor:#no]
      if,[#WasEvnt:#can_get_no]
        cursor,#default
        snd,["mok-ok",#ppt,true]
        show,16  
        anim,[#sound,0,[],"Rs01an2 frame 1","riB2-02h",#ext,true,0,true,true]
        SetEvnt,#have_notes
