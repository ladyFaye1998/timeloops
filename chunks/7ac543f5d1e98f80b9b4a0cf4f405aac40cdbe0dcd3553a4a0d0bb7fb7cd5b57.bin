    snd,["mok-bad",#ppt,true]
  else
    if,[#NotEvnt:#have_notes]
      anim,[#sound,0,[],"Rs01an2 frame 1","rib2-02",#ext,true,0,true,true]
      Blink,[53,true]
    else
      if,[#NotEvnt:#enter_diskr]
        anim,[#sound,0,[],"Rs01an2 frame 1","rib2-03",#ext,true,0,true,true]
        Blink,[53,true]
      else
        Cmd,["goto","diskr"]
      endif
    endif
  endif
else
  if,[#item:#ok]
    snd,["mok-bad",#ppt,true]
  else
    Cmd,["goto","diskr"]
  endif
endif
[END]

