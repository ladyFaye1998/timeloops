          cursor,#default
          snd,["mok-ok",#ppt,true]
          anim,[#sound,0,[],"np01an13 frame 1","niB2-10h",#ext,true,0,true,true]
        endif
        quit
      endif

      snd,["mok-bad",#ppt,true]
