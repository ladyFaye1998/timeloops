[LarryClick]
if,[#IncrMode:#ok]
  if,[#item:#ok]
    if,[#cursor:[#ds4,#mlg,#la4,#ds2,#la3]]

      if,[#cursor:#ds4]
        cursor,#default
        anim,[#sound,0,[],"La01an06 frame 1","lal-06",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:#mlg]
        cursor,#default
        anim,[#sound,0,[],"La01an06 frame 1","lal-09",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:[#la4,#ds2]]
        cursor,#default
        anim,[#sound,0,[],"La01an06 frame 1","lal-07",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

      if,[#cursor:#la3]
        cursor,#default
        anim,[#sound,0,[],"La01an06 frame 1","lal-05",#ext,true,0,true,true]
        Cmd,["WrongIncr"]
        quit
      endif

    else
      cursor,#default
      anim,[#sound,0,[],"La01an06 frame 1","lal-02",#ext,true,0,true,true]
      Cmd,["WrongIncr"]
    endif
  endif
  quit
endif

if,[#part:"1"]
  if,[#stuck:#ok]
    if,[#item:#ok]
      Hide,20
      if,[#cursor:#JulBag12]
        Cmd,["UnStuck",true]
        anim,[#simple,0,[13],"La01an03 frame 1","",#ext,true,1,false,false]
        anim,[#sound,0,[0,14],"La01an02 frame 1","laA1-20m",#ext,true,0,false,false]
        anim,[#simple,0,[14,0,0,13],"La01an07 frame 1","",#ext,true,1,false,true]
      else
        Cmd,["UnStuck",false]
        anim,[#simple,0,[13],"La01an03 frame 1","",#ext,true,1,false,false]
        anim,[#sound,0,[0,14],"La01an02 frame 1","lal-02",#ext,true,0,false,false]
        anim,[#simple,0,[14,0,0,13],"La01an07 frame 1","",#ext,true,1,false,true]
        CloseDB1,false
        goto,"lab1"
      endif
    endif
  else
    if,[#item:#ok]
      snd,["mok-bad",#ppt,true]
    else
      if,[#AsitSolved:["lab",false]]
        anim,[#simple,0,[13],"La01an03 frame 1","",#ext,true,1,false,false]
        anim,[#sound,0,[0,14],"La01an02 frame 1","laA1-02a",#ext,true,0,false,false]
        anim,[#simple,0,[14,0,0,13],"La01an07 frame 1","",#ext,true,1,false,true]
        Asit,"lab"  
        if,[#AsitSolved:["lab",true]]
          SetEvnt,#asit_lab
          DB1,#DB11
        endif
      else
        DB1,#DB11
      endif
    endif
  endif
  quit
else
  if,[#item:#ok]
    if,[#cursor:#la3]
      if,[#WasEvnt:#can_get_la3ps4]
        cursor,#default
        snd,["mok-ok",#ppt,true]
        bmp,[13,"larryLa3"]
        anim,[#sound,0,[],"La01an06 frame 1","laA2-30h",#ext,true,0,true,true]
        bmp,[13,"larry"]
        blink,[53,true]
      endif 
      quit
    endif

    if,[#cursor:#ps4]
      if,[#WasEvnt:#can_get_la3ps4]
        cursor,#default
        snd,["mok-ok",#ppt,true]
        bmp,[13,"larryPs4"]
        anim,[#sound,0,[],"La01an06 frame 1","laA2-30hh",#ext,true,0,true,true]
        bmp,[13,"larry"]
        more,3
        DB2,#DB123
      endif
      quit
    endif

    if,[#cursor:#flw]
      cursor,#default
      snd,["mok-ok",#ppt,true]
      bmp,[13,"larryFlw"]
      anim,[#sound,0,[],"La01an06 frame 1","laA2-h",#ext,true,0,true,true]
      bmp,[13,"larry"]
      quit
    endif

    snd,["mok-bad",#ppt,true]
  else
    DB1,#DB12
  endif
endif
[END]

