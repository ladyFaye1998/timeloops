          "source": "Google Translate TTS (gTTS)",
          "sha256": "c663d29185d085e98700031084ac813df7dc3e0183819c48cfc951cb1ffe2d5d",
          "text": "Lucardon-Pfeffer.",
          "source_text": "Lucardon Pepper.",
          "transcription_review_required": false
        },
        "jshb2-20": {
          "path": "res://assets/languages/de/audio/jshb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0eb55657aacb59377b90b93ab19b246c4931160d44895be42f88a4da8fc4893e",
          "text": "Ich habe eine Notiz von Jimmy Mackenzie gefunden, in der es heiÃŸt, dass er dir immer treu bleiben wird.",
          "source_text": "I found a note written by Jimmy Mackenzie, saying he'll always be loyal to you.",
          "transcription_review_required": false
        },
        "jshb2-21": {
          "path": "res://assets/languages/de/audio/jshb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "76c7a1b6d3b75b1c8797e967c07ea09373971293d8a9d02a5cca139fe02a51c1",
          "text": "Warum gehst du nicht zu Jimmy zurÃ¼ck?",
          "source_text": "Why wouldn't you go back to Jimmy?",
          "transcription_review_required": false
        },
        "jshb2-22": {
          "path": "res://assets/languages/de/audio/jshb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5d7aa923087124ac8fbbe6c81059be630ac557010fef998db87cca447fee421b",
          "text": "Kennen Sie zufÃ¤llig diese Handschrift?",
          "source_text": "Do you by any chance know this handwriting?",
          "transcription_review_required": false
        },
        "jshb2-30": {
          "path": "res://assets/languages/de/audio/jshb2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4d16d77928fd31c5a3da22cff87fb1ce3ce0365828610565893ac7398d5ebf4e",
          "text": "Du hast eine tolle Stimme. Hast du jemals darÃ¼ber nachgedacht, einer Band beizutreten?",
          "source_text": "You have a great voice. Did you ever think of joining a band?",
          "transcription_review_required": false
        },
        "jshb2-40": {
          "path": "res://assets/languages/de/audio/jshb2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c5253b67818b2899c1046e90db8d22957ddcbc7049654a6150ea980839e3446f",
          "text": "Los, sing mir!",
          "source_text": "Go on, sing to me!",
          "transcription_review_required": false
        },
        "sha1-01": {
          "path": "res://assets/languages/de/audio/sha1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a3d333989541779981ff759587265e27ea372b9fc065cad5d2eeb0e7a021143c",
          "text": "Weit weg, Mann, dein Outfit ist so cool.",
          "source_text": "Far out, man, your outfit is so cool.",
          "transcription_review_required": false
        },
        "sha1-02": {
          "path": "res://assets/languages/de/audio/sha1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af8423501f620a8c21a019000783f0a56728df704606adb9139c6f2118bd53af",
          "text": "Tata.",
          "source_text": "Tata.",
          "transcription_review_required": false
        },
        "sha1-03": {
          "path": "res://assets/languages/de/audio/sha1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fdad3f2400ba8fc47106ad8870d273d88323f9f41a46535cf1c243e53d14cb10",
          "text": "Ich bin beschÃ¤ftigt, Liebling. Mary und Faithful werden jeden Moment hier sein.",
          "source_text": "I'm busy, darling. Mary and Faithful will be here any minute.",
          "transcription_review_required": false
        },
        "sha1-10": {
          "path": "res://assets/languages/de/audio/sha1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "58183d7bb4b4ea1dd577506114a759ee4f35eccbe46be7cc589ba1bfac50bb34",
          "text": "Film? Das ist ein Scherz, oder? Dies ist ein BekleidungsgeschÃ¤ft, falls Sie es noch nicht bemerkt haben.",
          "source_text": "Film? You're kidding, right? This is a clothing store in case you hadn't noticed.",
          "transcription_review_required": false
        },
        "sha1-20": {
          "path": "res://assets/languages/de/audio/sha1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b5999aea56f495f5791e583723d1ac498ecd77619e2062d9d36a638fdf9d4bc",
          "text": "Phillips Factory ist das Unternehmen meiner Familie und niemand wird es ruinieren.",
          "source_text": "Phillips Factory is my family's business, and no one's going to ruin it.",
          "transcription_review_required": false
        },
        "sha1-30": {
          "path": "res://assets/languages/de/audio/sha1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "54a006926239ad44cf4c457f695cc703b42b9c4c825c962cd4c6a817a95034cf",
          "text": "Jimmy Mackenzie, woher kommt die Idee, dass ich ihn kenne?",
          "source_text": "Jimmy Mackenzie, where do you get the idea that I know him?",
          "transcription_review_required": false
        },
        "sha1-31": {
          "path": "res://assets/languages/de/audio/sha1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "813a022eeacaca5c2edb569816e4cc5f036965b4f870069d5911cc2d582c5c4e",
          "text": "Es gibt ein GerÃ¼cht, dass Philip's Chemicals giftige Chemikalien entsorgt. Das stimmt nicht und es gibt keinen Film, der das beweist.",
          "source_text": "There's a rumor that Philip's chemicals dumps poisonous chemicals. It's not true and there's no film to prove it.",
          "transcription_review_required": false
        },
        "sha1-32a": {
          "path": "res://assets/languages/de/audio/sha1-32a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2e159d594cee58359f2583e73eec1784cc6cc8aa16eea1040842cc479178c036",
          "text": "Jimmy.",
          "source_text": "Jimmy.",
          "transcription_review_required": false
        },
        "sha1-32b": {
          "path": "res://assets/languages/de/audio/sha1-32b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0f250151eb7db679b58b3b0494b6b94280ff75d7b4ee859afcd7f0b1b1ccb0e8",
          "text": "Als ich ihn fallen lieÃŸ, war er so verletzt, dass er sich diese lÃ¤cherliche Geschichte ausgedacht hat.",
          "source_text": "When I dumped him, he was so hurt, he made up that ridiculous story.",
          "transcription_review_required": false
        },
        "sha130ha": {
          "path": "res://assets/languages/de/audio/sha130ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4ab054be001299a4873a45fa19d5cbbaa0b3f2ead0436eb28d32428b33b32364",
          "text": "Also...",
          "source_text": "Well...",
          "transcription_review_required": false
        },
        "sha130hb": {
          "path": "res://assets/languages/de/audio/sha130hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "614ba945561f6a348b6fde7a1f6445e69de5b2d6561160c00c68c4d4342a213f",
          "text": "Zu Ihrer Information, die ganze Geschichte ist eine LÃ¼ge. Dasselbe wie das GerÃ¼cht Ã¼ber Philips Chemikalien.",
          "source_text": "For your information, that whole story is a lie. Same as the rumor about Philip's chemicals.",
          "transcription_review_required": false
        },
        "sha2-01": {
          "path": "res://assets/languages/de/audio/sha2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "15ce7362895703de7aef309661ed622495ab617e17ea3fbe0357b228c01d5bf6",
          "text": "Was fÃ¼r ein Nagellack?",
          "source_text": "What far out nail polish?",
          "transcription_review_required": false
        },
        "sha2-02": {
          "path": "res://assets/languages/de/audio/sha2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0fe86adf19139037aac18b2281c147a157a93864cf269de45f12d7c597780a54",
          "text": "Ciao!",
          "source_text": "Ciao!",
          "transcription_review_required": false
        },
        "sha2-03": {
          "path": "res://assets/languages/de/audio/sha2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0fd4ccba394e0c1c2eb81ae297f4bf01bd0b5fd594563c8f5073d57df26ded0a",
          "text": "Habe ich dir gesagt, wie toll dein Nagellack ist?",
          "source_text": "Did I tell you how groovy your nail polish is?",
          "transcription_review_required": false
        },
        "sha2-10": {
          "path": "res://assets/languages/de/audio/sha2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e98aba202263bb78d143cf2c888b54f130bcb3c0837efbe074ed916cb7fb1669",
          "text": "Ich gebe niemandem etwas ohne Quittung.",
          "source_text": "I don't give anything to anyone without a receipt.",
          "transcription_review_required": false
        },
        "sha2-10h": {
          "path": "res://assets/languages/de/audio/sha2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9d902f05b14170ac3152919d8ae6b44b7fc7542b8062ed85993339500c60adad",
          "text": "Oh, tut mir leid, aber ich habe es nicht. Jemand kam schon, um es abzuholen.",
          "source_text": "Oh, I'm sorry, but I don't have it. Someone already came to pick it up.",
          "transcription_review_required": false
        },
        "sha2-11": {
          "path": "res://assets/languages/de/audio/sha2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "93eef1d8cbdbcb000a59d2e0082598120075fcfdac0349d3c1030899f135308d",
          "text": "Ich stellte es auf die Theke und ging fÃ¼r eine Minute nach drauÃŸen. Als ich zurÃ¼ckkam, war das Kleid weg. NatÃ¼rlich werde ich es irgendwie wieder gut machen, Alice.",
          "source_text": "I put it on the counter and went outside for a minute. When I came back, the dress was gone. Of course, I'll make it up to Alice somehow.",
          "transcription_review_required": false
        },
        "sha2-12a": {
          "path": "res://assets/languages/de/audio/sha2-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ad3f021b1a2d38fdedfa68a61dd61741df31833a5473e630d5779726cfcc9e6f",
          "text": "Wer auch immer es war, hat etwas zurÃ¼ckgelassen.",
          "source_text": "Whoever it was left something behind.",
          "transcription_review_required": false
        },
        "sha2-12b": {
          "path": "res://assets/languages/de/audio/sha2-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "06ec225b4b74b3f9721ffaa76b16de546970810548b36a8c22e24f509182a5b0",
          "text": "Ich nehme an, es stammt von einer dieser hÃ¤sslichen Federjacken.",
          "source_text": "I suppose it's from one of those ugly, feathered jackets.",
          "transcription_review_required": false
        },
        "sha2-12c": {
          "path": "res://assets/languages/de/audio/sha2-12c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "928b90bbf5418ff3e04f582462bcf835bffd4d9eca184d171d99bebb653877d7",
          "text": "Ich vertraue niemandem, der sich wie ein Sittich kleidet.",
          "source_text": "I don't trust anyone who dresses like a parakeet.",
          "transcription_review_required": false
        },
        "sha2-20": {
          "path": "res://assets/languages/de/audio/sha2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "912d5af57bf3d1194b0d653ae4a869f6bf46c97d6b4d9888e0b1dba2a9946e01",
          "text": "Dies ist ein exklusiver Laden. Hier stiehlt niemand etwas.",
          "source_text": "This is an exclusive store. Nobody steals anything from here.",
          "transcription_review_required": false
        },
        "sha2-30": {
          "path": "res://assets/languages/de/audio/sha2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "12519f8a82502c3b0e41ac4f81a4f86635b52a1168804040c9a57130539e95fb",
          "text": "Was willst du von mir? Ich habe es dir bereits gesagt. Ich habe ihn verlassen, nicht umgekehrt.",
          "source_text": "What do you want from me? I've already told you. I left him, not the other way around.",
          "transcription_review_required": false
        },
        "sha2-30m": {
          "path": "res://assets/languages/de/audio/sha2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5638f93d6c7387aa0a79aebd8c12cb0c0e7f012edf54989811b40ae5859a5a5f",
          "text": "Das sind wirklich originelle Farben.",
          "source_text": "These are really original colors.",
          "transcription_review_required": false
        },
        "sha2-h": {
          "path": "res://assets/languages/de/audio/sha2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bccb5343d50402a0582a10b45977a788ddbcdf85a6d24373652dc56b7fc13a41",
          "text": "Ich denke, ich werde es mir ins Haar stecken. Es ist wirklich in diesen Tagen.",
          "source_text": "I think I'll put it in my hair. It's really in these days.",
          "transcription_review_required": false
        },
        "shb1-01": {
          "path": "res://assets/languages/de/audio/shb1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f92ed3c14e3dc89ebfe9db600115198b983a2643ec1ab3039d15c020a712f155",
          "text": "Hallo. Sie befinden sich im angesagtesten Laden in San Francisco. Sogar Twiggy kauft hier ein.",
          "source_text": "Hi. You're in the hippest store in San Francisco. Even Twiggy shops here.",
          "transcription_review_required": false
        },
        "shb1-02": {
          "path": "res://assets/languages/de/audio/shb1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e80e8a6ae16da92a33be71fed47c26e8f5c4508187231307e668ad9818bd5767",
          "text": "Deine Kleidung ist etwas altmodisch, aber deine Haarspangen gefallen mir.",
          "source_text": "Your clothes are a bit old-fashioned, but I dig your hair clips.",
          "transcription_review_required": false
        },
        "shb1-03": {
          "path": "res://assets/languages/de/audio/shb1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d6c19564c8d52ecfba7f13c8bcb08a6146e0bd65a210727a544c3520991a7324",
          "text": "TschÃ¼ss.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "shb1-04": {
          "path": "res://assets/languages/de/audio/shb1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1352797e5bf2451b2ca4b2854e0b3509cc7366824cbb039db2ecd7ecf7bf3fb3",
          "text": "Liebling, du musst mir nur sagen, wo du diese Haarspange gekauft hast.",
          "source_text": "Darling, you just have to tell me where you bought that hair clip.",
          "transcription_review_required": false
        },
        "shb1-10": {
          "path": "res://assets/languages/de/audio/shb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf50d2942768bb4f99ed199c34fc7cf847b04d3935ccf5c3a1e4c1a6dbebdf49",
          "text": "Jimmy McKenzie, warum glaubst du, dass ich ihn Ã¼berhaupt kenne?",
          "source_text": "Jimmy McKenzie, why do you think I even know him?",
          "transcription_review_required": false
        },
        "shb1-10h": {
          "path": "res://assets/languages/de/audio/shb1-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "93ff575b3b2b608cc0b4ab1d1cbd9f2494e363dcb9a85981d5832fad0d9e8b36",
          "text": "Oh, das. Es sind alles LÃ¼gen. Genau wie die LÃ¼gen, die sie Ã¼ber die Fabrik meines Vaters verbreiten.",
          "source_text": "Oh, that. It's all lies. Just like the lies they're spreading about my father's factory.",
          "transcription_review_required": false
        },
        "shb1-11": {
          "path": "res://assets/languages/de/audio/shb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7da07b9947bc5c57870d2b92e5973c624df1d9c3093d2069a06f5ef1c79a4e1e",
          "text": "Dass er Gift ins Meer schÃ¼ttet. Das sind alles LÃ¼gen und es gibt keinen Film, der das beweist.",
          "source_text": "That he's pouring poison into the sea. It's all lies, and they don't have a film to prove it.",
          "transcription_review_required": false
        },
        "shb1-12a": {
          "path": "res://assets/languages/de/audio/shb1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a64adb0caa5af2e064710c4542a418f3913e71c6de1f8c483dfa61d66ebe2196",
          "text": "Es ist Jimmy.",
          "source_text": "It's Jimmy.",
          "transcription_review_required": false
        },
        "shb1-12b": {
          "path": "res://assets/languages/de/audio/shb1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "baaaef6700ebb424d2b40705efb0ee40f99f74aae55ed6e0cc23d8c560a33f26",
          "text": "Er ist so verletzt, dass ich ihn verlassen habe, dass er versucht, sich an mir zu rÃ¤chen, indem er meinen Vater verletzt.",
          "source_text": "He's so hurt that I left him, that he's trying to get back at me by hurting my father.",
          "transcription_review_required": false
        },
        "shb1-20": {
          "path": "res://assets/languages/de/audio/shb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d89124406a1a8eaf3f96ae097f59f5f32c9571a72c1ff3a0d65cabd11c0c146d",
          "text": "Wie kannst du es wagen, mir diese Frage zu stellen, Sheila Phillips?",
          "source_text": "How dare you ask me, Sheila Phillips, that question?",
          "transcription_review_required": false
        },
        "shb1-20m": {
          "path": "res://assets/languages/de/audio/shb1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "752cefa3fd821f7ea310d89e8601da327fbde693f6129ef1fe8b521fde2534ed",
          "text": "Wow. Diamanten sind die besten Freunde eines MÃ¤dchens. Es muss natÃ¼rlich sein, du wirst GlÃ¼ck haben.",
          "source_text": "Wow. Diamonds are a girl's best friend. It must, of course, you'll fortune.",
          "transcription_review_required": false
        },
        "shb1-30a": {
          "path": "res://assets/languages/de/audio/shb1-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af5a7bdec5a6db79cc175c7f7b6066b24ae2558ae9c8968275534d3a66705d61",
          "text": "Ja, und ich bin stolz darauf. Ich habe kein Problem damit, reich zu sein.",
          "source_text": "Yes, and I'm proud of it. I don't have any problem with being rich.",
          "transcription_review_required": false
        },
        "shb1-30b": {
          "path": "res://assets/languages/de/audio/shb1-30b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d7222509334f4ce9a04dafa7ce8a67d24ed1a93b47a5bc7aee7143115c2f5293",
          "text": "Jedenfalls spendet mein Vater sein Geld fÃ¼r einen guten Zweck.",
          "source_text": "Anyway, my father gives his money away to good causes.",
          "transcription_review_required": false
        },
        "shb1-31": {
          "path": "res://assets/languages/de/audio/shb1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ffd695554385b33a4ee558efebdad27868a30503c71b1bc2f6509a6da7882171",
          "text": "Da bin ich mir sicher. Warum sollten sie sonst mitten in der Nacht kommen und Fotos von Dingen machen, die gar nicht existieren?",
          "source_text": "I'm sure of it. Otherwise, why would they come in the middle of the night and take photos of things that don't even exist?",
          "transcription_review_required": false
        },
        "shb1-32": {
          "path": "res://assets/languages/de/audio/shb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8f8ef01bf9fb3c822bb840c70af788b0a841f000b6d8679bdfa8ab9cf1501df4",
          "text": "Nun ja, wir fÃ¶rdern junge Wissenschaftler wie zum Beispiel Larry Chang. Er kann Ihnen sagen, dass wir nie DDT verwendet haben.",
          "source_text": "Well, we sponsor young scientists like Larry Chang, for example. He can tell you that we've never used DDT.",
          "transcription_review_required": false
        },
        "shb2-01": {
          "path": "res://assets/languages/de/audio/shb2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "04f2f2d520759baf7a5ea3c4d93f849b1e6f5a93c336c17fe5eedf4d1e778bd3",
          "text": "Du kommst gerade noch rechtzeitig. Jane kommt gleich. Fonda, meine ich.",
          "source_text": "You're just in time. Jane is about to arrive. Fonda, I mean.",
          "transcription_review_required": false
        },
        "shb2-02": {
          "path": "res://assets/languages/de/audio/shb2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "60b9923a1f19d74e499a46be1debe9f9fa2871bb9681896350aaa738be1df9f9",
          "text": "Willst du nicht auf Jane warten? Nun ja.",
          "source_text": "Don't you want to wait for Jane? Oh, well.",
          "transcription_review_required": false
        },
        "shb2-03": {
          "path": "res://assets/languages/de/audio/shb2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8b19b6894f31e3aa41cb349d878a248efc26a2031f1d3fbc66a7a84d937b15bd",
          "text": "Du vermisst Jane einfach.",
          "source_text": "You just miss Jane.",
          "transcription_review_required": false
        },
        "shb2-10": {
          "path": "res://assets/languages/de/audio/shb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bfb08a0913d2bfb1b62fecede001440cc2f624495a73f50bacdd6f7724647818",
          "text": "GlÃ¤ser? Warum glaubst du, dass ich eine Brille verloren habe?",
          "source_text": "Glasses? Why do you think I lost a pair of glasses?",
          "transcription_review_required": false
        },
        "shb2-11": {
          "path": "res://assets/languages/de/audio/shb2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e86b9cc87c10a43ed1ac526b01e5bc5cd43fb4a096415eb32936821aa6056f59",
          "text": "Ich kann keine Noten lesen, aber ich bin sicher, dass Rick aus dem Plattenladen weiÃŸ, um welches StÃ¼ck es sich handelt.",
          "source_text": "I can't read music, but I'm sure Rick from the record store will know what piece this is.",
          "transcription_review_required": false
        },
        "shb2-12": {
          "path": "res://assets/languages/de/audio/shb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2f93eea788fa8e5e5a75f5f4b7c5c4080c8fb70356da1487b528e22d77513eff",
          "text": "Bist du gestern geboren oder so? Sergeant Pepper heiÃŸt das neue Album der Beatles.",
          "source_text": "Were you born yesterday or something? Sergeant Pepper is the name of the new Beatles album.",
          "transcription_review_required": false
        },
        "shb2-20": {
          "path": "res://assets/languages/de/audio/shb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "61a5a00d1b4679eac63ef18e1a480bcbe93797042e8c4c08c7a0dc149fb0c66d",
          "text": "Nein, du lÃ¼gst. Lass mich schnell sehen.",
          "source_text": "No, you're lying. Let me see quickly.",
          "transcription_review_required": false
        },
        "shb2-20h": {
          "path": "res://assets/languages/de/audio/shb2-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "77c4c4d9ffb02eeca865f66431ae58f28a176adb37d52d5afb918206c9c35df4",
          "text": "Oh, das ist nicht Jimmys Handschrift. Aber tÃ¤uschen Sie sich nicht, ich wÃ¼rde nicht zu ihm zurÃ¼ckkehren wollen, selbst wenn er um sein Leben betteln wÃ¼rde.",
          "source_text": "Oh, that's not Jimmy's handwriting. But make no mistake, I wouldn't want to go back to him even if he begged for his life.",
          "transcription_review_required": false
        },
        "shb2-21": {
          "path": "res://assets/languages/de/audio/shb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d738515f70bdbcd06788ea2f8ba98d821b82de4e2d0d83695b305568cdb027c2",
          "text": "Lasst uns etwas klarstellen. Ich habe ihn verlassen, nicht umgekehrt. AuÃŸerdem glaube ich, dass getan wurde, was getan wurde. Ich bin nicht wie Rick, der sein Liebesleben recycelt.",
          "source_text": "Let's get something straight. I left him, not the other way around. Also, I believe that what's done is done. I'm not like Rick, who recycles his love life.",
          "transcription_review_required": false
        },
        "shb2-22": {
          "path": "res://assets/languages/de/audio/shb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4bbb41725d4980a9387d8045db08cfded0f65be5b272ae01f2bc1ac9d2c40b8e",
          "text": "Nein, ich habe es noch nie gesehen.",
          "source_text": "No, I've never seen it before.",
          "transcription_review_required": false
        },
        "shb2-30": {
          "path": "res://assets/languages/de/audio/shb2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b6d5980405a0ff179a0f64b219773e2f20ce83235226e0baad50680af7a9610a",
          "text": "Nun, ich habe Leute sagen hÃ¶ren, dass ich eine Stimme habe, genau wie Janice Joplin. Aber meine Stimme ist hÃ¶her als ihre. Mm-hmm, nimm dir noch ein StÃ¼ck meines Herzens, Baby. Mm-hmm.",
          "source_text": "Well, I've heard people say that I've got a voice just like Janice Joplin. But my voice has a higher pitch than hers. Mm-hmm, take another piece of my heart, baby. Mm-hmm.",
          "transcription_review_required": false
        },
        "shb2-40": {
          "path": "res://assets/languages/de/audio/shb2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "242aa52958865ee927fd0d7827be9d428735ed23f6b1bc6aa79f697af1c56c62",
          "text": "Du bist zu viel, das weiÃŸt du. Sieht das fÃ¼r dich wie meine Dusche aus?",
          "source_text": "You're too much, you know that. Does this look like my shower to you?",
          "transcription_review_required": false
        },
        "shb2-40m": {
          "path": "res://assets/languages/de/audio/shb2-40m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2d900709a9677ce1f091d8fafaf6a9466f1194128daa0ec61dd38f78cfa1ac38",
          "text": "Ah, die nÃ¤chste Winterkollektion. Aber es ist so altmodisch. Seltsam.",
          "source_text": "Ah, next winter's collection. But it's so old-fashioned. Strange.",
          "transcription_review_required": false
        },
        "shb210ha": {
          "path": "res://assets/languages/de/audio/shb210ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "94c3131aa0bc97180cfeae6c7e8bf84c1a96360e49ae72e51c1cc0353602430e",
          "text": "Was? Glaubst du, ich habe das geschrieben, weil meine Initialen SP sind? Als nÃ¤chstes werden Sie Sergeant Pepper beschuldigen.",
          "source_text": "What? You think I wrote that because my initials are SP? Next thing, you'll be accusing Sergeant Pepper.",
          "transcription_review_required": false
        },
        "shb210hb": {
          "path": "res://assets/languages/de/audio/shb210hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "42d6fc27ec29593cc38026e7126a4cb3ea8822f6661ffca5cc58375dd11346cf",
          "text": "Ã„hm, es muss dem Kerl gehÃ¶ren, der hier seine Musik vergessen hat.",
          "source_text": "Um, it must belong to the guy who forgot his music here.",
          "transcription_review_required": false
        },
        "shl-01": {
          "path": "res://assets/languages/de/audio/shl-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e891fab927dac8c876ac592741df7f75614d9205a25685886c38d9e3cdb47e2",
          "text": "Warum zum Teufel glaubst du, dass ich es getan habe?",
          "source_text": "Why on earth would you think I did it?",
          "transcription_review_required": false
        },
        "shl-02": {
          "path": "res://assets/languages/de/audio/shl-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e79cbc3efa97fa7839d9e875fe651df0386be8f44a1f3689cbf28bc9c3b4b6f6",
          "text": "Warum bereitet mir das Sorgen?",
          "source_text": "Why is this any concern of mine?",
          "transcription_review_required": false
        },
        "shl-03": {
          "path": "res://assets/languages/de/audio/shl-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0fb80d92eb2f600c70444d376aedea334ade9f16f91839ddac3d1c891b1f7093",
          "text": "Hey, ich bin nicht so verzweifelt.",
          "source_text": "Hey, I'm not that desperate.",
          "transcription_review_required": false
        },
        "shl-04": {
          "path": "res://assets/languages/de/audio/shl-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7cebaa3b9792bb9e299c732a3fc2c1eb525912d8a57bff426af711cbef3cfccc",
          "text": "Das beweist immer noch nichts.",
          "source_text": "This still doesn't prove anything.",
          "transcription_review_required": false
        },
        "shl-05": {
          "path": "res://assets/languages/de/audio/shl-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "13537e770ebf3b0d0cced646ab50f70774d908cd6e48f04f2358833b3782f6fa",
          "text": "Ich kann nicht glauben, dass sie all das tut, nur um ihn kennenzulernen.",
          "source_text": "I can't believe she's doing all that stuff just to meet him.",
          "transcription_review_required": false
        },
        "shl-06": {
          "path": "res://assets/languages/de/audio/shl-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e7979666c1c9a3b3388b84acc96651fcc7b73fbc11b5107caef23a7e26e7266b",
          "text": "Na und?",
          "source_text": "So what?",
          "transcription_review_required": false
        },
        "shl-07": {
          "path": "res://assets/languages/de/audio/shl-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4d2a533307b33343e38db7c79623f3d1ac8143eea3adc91406d3b72e11603351",
          "text": "Man kann nicht einfach unschuldige Menschen beschuldigen. Bist du beim KGB oder was?",
          "source_text": "You can't just accuse innocent people. Are you with a KGB or what?",
          "transcription_review_required": false
        },
        "shla-01": {
          "path": "res://assets/languages/de/audio/shla-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d68d6986b10f89eb550ffcbee15ecc24c2e48a84b232b7aeeae264f24b79cf87",
          "text": "Ich wusste die ganze Zeit, dass es Dorothy war. Es steht ihr Ã¼berall ins Gesicht geschrieben. Kein Wunder, dass ihr Kleidungsgeschmack so verabscheuungswÃ¼rdig ist.",
          "source_text": "I knew it was Dorothy all along. It's written all over her. No wonder her taste in clothes is so despicable.",
          "transcription_review_required": false
        },
        "shlb-01": {
          "path": "res://assets/languages/de/audio/shlb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a5fb873fd738d2f22cd59a333a3271b4de36c40bdfe5b3970c7b52567a03c92f",
          "text": "Es ist erbÃ¤rmlich, wie Rick versucht, an Alice festzuhalten. Ich sage: Wenn du jemanden liebst, lass ihn frei.",
          "source_text": "It's pathetic how Rick tries to hang on to Alice. I say, if you love someone, set them free.",
          "transcription_review_required": false
        },
        "jria1-10": {
          "path": "res://assets/languages/de/audio/jria1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b564beaba783a7b69db294c92942efd323301f7d23a2896d2f2e727673bb281c",
          "text": "Vielleicht kann ich dir helfen.",
          "source_text": "Maybe I can help you.",
          "transcription_review_required": false
        },
        "jria2-10": {
          "path": "res://assets/languages/de/audio/jria2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e58db06e1a128e9cd4de251363b46436ef38d5fb9cfc4a3ffc8bd0221589041d",
          "text": "Hat heute jemand mit einer rosa Weste den Laden besucht?",
          "source_text": "Did anyone wearing a pink vest visit the store today?",
          "transcription_review_required": false
        },
        "jria2-11": {
          "path": "res://assets/languages/de/audio/jria2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b03b7f594c946f25019695d35e340ff7a99faec7c17dc4e9c13e6524e5be7111",
          "text": "Wer ist Veronica?",
          "source_text": "Who's Veronica?",
          "transcription_review_required": false
        },
        "jria2-12": {
          "path": "res://assets/languages/de/audio/jria2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "94407bd951e171ac9108da2ad14641572fc3954df5ff0c62c870a1fbfbbf3eed",
          "text": "Warum verspottest du Veronica?",
          "source_text": "Why are you mocking Veronica?",
          "transcription_review_required": false
        },
        "jria2-20": {
          "path": "res://assets/languages/de/audio/jria2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "549edc821697f0ca5fa4983eb1a4094c7b12bf3151ae779e29fe6b8b62fcfbc0",
          "text": "Ich habe einen Schal genau wie deinen! HinterlÃ¤sst deines auch Ã¼berall seine Federn?",
          "source_text": "I have a scarf exactly like yours! Does yours also leave its feathers everywhere?",
          "transcription_review_required": false
        },
        "jria2-21": {
          "path": "res://assets/languages/de/audio/jria2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5f9e75da50691653b878e49015665611c806da2bb017cb54c928cad6f89b6934",
          "text": "Wo warst du heute?",
          "source_text": "Where have you been today?",
          "transcription_review_required": false
        },
        "jria2-22": {
          "path": "res://assets/languages/de/audio/jria2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "93f1602c9a3b064c9047563b67751be48fd98eb99fec9a107cfb0da47935bae2",
          "text": "Ich habe Spuren von dir in Alices Tasche gefunden.",
          "source_text": "I found traces of you in Alice's bag.",
          "transcription_review_required": false
        },
        "jrib1-10": {
          "path": "res://assets/languages/de/audio/jrib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e2c3d46e3ba4bac8ab120594bbfe269348109c0c9b47c3dd7c157eefe80b7859",
          "text": "Kennen Sie zufÃ¤llig Jimmy McKenzie?",
          "source_text": "Do you happen to know Jimmy McKenzie?",
          "transcription_review_required": false
        },
        "jrib1-11": {
          "path": "res://assets/languages/de/audio/jrib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cfca465932a5f22ca25c0ec1ada8cf6c6f7a2c2eeba07d1699440b01c2e796a5",
          "text": "Willst du mir sagen, dass ihr beide Freunde seid?",
          "source_text": "You want to tell me that you two are friends?",
          "transcription_review_required": false
        },
        "jrib1-12": {
          "path": "res://assets/languages/de/audio/jrib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "71cdd4dec5a24afa11da557670b3e9d541797ac22d6a1628ab9d4228a496bf27",
          "text": "Wissen Sie, wen Jimmy Mackenzie dieser Tage trifft? Remantisch gesehen meine ich.",
          "source_text": "Do you know who Jimmy Mackenzie's seeing these days? Remantically speaking, I mean.",
          "transcription_review_required": false
        },
        "jrib1-20": {
          "path": "res://assets/languages/de/audio/jrib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e1e400f125591fa52cef82fe2e4d5d40ecc881ffc5dbe0f10e4512d6db3cb2ba",
          "text": "Wie fÃ¼hlen Sie sich, wenn Sie eine schlechte Bewertung erhalten?",
          "source_text": "How do you feel when you get a bad review?",
          "transcription_review_required": false
        },
        "jrib2-10": {
          "path": "res://assets/languages/de/audio/jrib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "88aae42c42ec42f581a971c13d47f1c0578e0f6b077e9bb01d9a140b6d73aff0",
          "text": "Wow, du scheinst groÃŸartig zu sein. Kann ich dein Autogramm haben?",
          "source_text": "Wow, you seem great. Can I have your autograph?",
          "transcription_review_required": false
        },
        "jrib2-20": {
          "path": "res://assets/languages/de/audio/jrib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "acd71b24b85524257dfffd6d3bd74464a77ff9bf23adf76182ef9383732ea458",
          "text": "Worum geht es in diesem Lied?",
          "source_text": "What's this song about?",
          "transcription_review_required": false
        },
        "jrib2-30": {
          "path": "res://assets/languages/de/audio/jrib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "89bef871a07944748dd188862c031fa1fa3d3ff61af0c66ece0b92ea3b98d11d",
          "text": "Haben Sie ein Problem mit der Rechtschreibung?",
          "source_text": "Do you have a problem with spelling?",
          "transcription_review_required": false
        },
        "ria1-02": {
          "path": "res://assets/languages/de/audio/ria1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d07d3e28aaacddc600587efe40e4c2c66f29716c3f3e252d3e769f8c7f9348d6",
          "text": "Ich kann jetzt nicht reden. Ich habe gerade gehÃ¶rt, dass meine Ex-Freundin Ã¼ber mich hinweg ist. Ich bin verloren.",
          "source_text": "I can't talk now. I just heard my ex-girlfriend is over me. I'm lost.",
          "transcription_review_required": false
        },
        "ria1-03": {
          "path": "res://assets/languages/de/audio/ria1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "37a916c2ef3de65c799b79865dfcfd3f60ea90baf1493c2eb984ba836171ddb1",
          "text": "Ich bin heute etwas niedergeschlagen. Ich muss jetzt meditieren, wenn es Ihnen nichts ausmacht.",
          "source_text": "I'm a little bit down today. I need to meditate now, if you don't mind.",
          "transcription_review_required": false
        },
        "ria1-10": {
          "path": "res://assets/languages/de/audio/ria1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e6855b9765efcbbe9ab138b7a4c3906313a836efe671654e275999d8108069f6",
          "text": "Ihr alle, ich kann ein wenig Hilfe von meinen Freunden gebrauchen, aber ich wÃ¤re jetzt lieber allein.",
          "source_text": "Y'all, I can use a little help from my friends, but I'd rather be alone now.",
          "transcription_review_required": false
        },
        "ria2-01": {
          "path": "res://assets/languages/de/audio/ria2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "281be9bb1b0bcebb62402fb20ad4b535d7cf89ed728a0633bbe6767f78a97eb9",
          "text": "Das kann mir nicht passieren. Ich kann meine GlÃ¼cksgitarre nicht finden und habe heute Abend eine Show!",
          "source_text": "This can't be happening to me. I can't find my lucky pick for my guitar, and I have a show tonight!",
          "transcription_review_required": false
        },
        "ria2-02": {
          "path": "res://assets/languages/de/audio/ria2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f11e08abbcfc810806e9377eb6f754d184b1afac031e500c7c3457cbec1bea8d",
          "text": "Ich komme jetzt mit nichts klar, es tut mir leid.",
          "source_text": "I can't deal with anything now, I'm sorry.",
          "transcription_review_required": false
        },
        "ria2-03": {
          "path": "res://assets/languages/de/audio/ria2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b49d739ef0a0a83ae35e8a23d1649fbdd3945f6d9da37be3b4355cb7f74145b0",
          "text": "Was fÃ¼r ein Schwung, Mann? Ich gehÃ¶re ganz dir, habe meine Ruhe gefunden, entspannt, Mann.",
          "source_text": "What swingin', man? I'm all yours, found my pickin' down, laid back, man.",
          "transcription_review_required": false
        },
        "ria2-05": {
          "path": "res://assets/languages/de/audio/ria2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "155db9675a36cfb48ab55af3cd5918360ae7a72624562f4a6517a5f93ae4fd38",
          "text": "Hallo, schon wieder. WÃ¤hrend es, wie Lennon sagt, nichts Neues unter der Sonne gibt. Ha.",
          "source_text": "Hey, again. While, like, Lennon says, there's nothing new under the sun. Ha.",
          "transcription_review_required": false
        },
        "ria2-10": {
          "path": "res://assets/languages/de/audio/ria2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e3e22d179f4b53aad20cbfbcdb29ae4f1a305312a83a6560d49754cb656e684",
          "text": "Tut mir leid, Schwester. Fragen Sie mich, welche Art von Musik sie mÃ¶gen, und ich werde sie gleich beantworten, aber die rosa Weste?",
          "source_text": "Sorry, sister. Ask me what kind of music they dig, and I'll answer it in a second, but the pink vest?",
          "transcription_review_required": false
        },
        "ria2-10h": {
          "path": "res://assets/languages/de/audio/ria2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bcbea962da1d39e7251bf7220310c22c9d0421cb0e71fb6952e736bd60069a68",
          "text": "Jetzt redest du. Der Paul Onka, meine Dame. Ja, sie hat das zurÃ¼ckgelassen. Veronika.",
          "source_text": "Now you're talking. The Paul Onka, lady. Yeah, she left this behind. Veronica.",
          "transcription_review_required": false
        },
        "ria2-11a": {
          "path": "res://assets/languages/de/audio/ria2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ba5f86b9179d770d12bb0431b3d0fa4b9faaba4d98a6e9f2dd0af0cb25eb2ef9",
          "text": "Schwester, wann bist du auf diesem Planeten angekommen?",
          "source_text": "Sister, when did you arrive on this planet?",
          "transcription_review_required": false
        },
        "ria2-11b": {
          "path": "res://assets/languages/de/audio/ria2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "25a422cc4d5a23991fa02f96a826a452da4f756e088861089b7322aee56dea55",
          "text": "Veronica, wie in Betty und Veronica, aus den Archie-Comics, wissen Sie, Betty und Veronica, beide in denselben Typen aus der Schule verliebt.",
          "source_text": "Veronica, as in Betty and Veronica, from the Archie's comics, you know, Betty and Veronica, both in love with the same guy from school.",
          "transcription_review_required": false
        },
        "ria2-12": {
          "path": "res://assets/languages/de/audio/ria2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d33a6b9a30a3feeff107bec84e34e7bd97acca19a8de7cdb4419d777a2b848ba",
          "text": "Hallo, wach auf, wir sind in den 60ern, Comics sind drauÃŸen, als wollten wir das Original.",
          "source_text": "Hello, wake up, it's the 60s, comics are out, like we want the real thing.",
          "transcription_review_required": false
        },
        "ria2-20": {
          "path": "res://assets/languages/de/audio/ria2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cba2a8c8b1e11ca4d9a82036c7f3a1509d559580e5eaf0f157b6a475bf0bfcf0",
          "text": "Das kann ich nachvollziehen, Mann. Ich weiÃŸ. Was fÃ¼r ein Mist. Ich hinterlasse Spuren, wohin ich auch gehe.",
          "source_text": "I can relate to that, man. I know. What a bummer. I leave tracks wherever I go.",
          "transcription_review_required": false
        },
        "ria2-21": {
          "path": "res://assets/languages/de/audio/ria2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "60d8fa28a86ededba21caaf7b4d013731874de7ef6998505b360321d607fc3cc",
          "text": "Heute war ich den ganzen Tag hier und habe jede Schublade nach meiner Auswahl durchsucht, aber die gute Nachricht ist, dass ich sie in Jeffersons Flugzeug gefunden habe, Mann.",
          "source_text": "Today, I was here all day searching every drawer for my pick, but good news, I found it in Jefferson's airplane, man.",
          "transcription_review_required": false
        },
        "ria2-22": {
          "path": "res://assets/languages/de/audio/ria2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "58aa40221e886f4133899a8c4c5b40c57f2eab895b45a79264114022f8dee149",
          "text": "Hey, neugieriges MÃ¤dchen, ich habe Wichtigeres zu tun, als mir deine Anschuldigungen anzuhÃ¶ren, okay?",
          "source_text": "Hey, nosy girl, I have more important things to do than to listen to your accusations, okay?",
          "transcription_review_required": false
        },
        "ria2-22m": {
          "path": "res://assets/languages/de/audio/ria2-22m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6dbf618fdbf1e27c407e93ddfc6e501391746348f3fc6d794f2230980f6d5b7e",
          "text": "Weit weg, Mann, eine Miniaturplatte, aber ich sage dir, fÃ¼r etwas so Kleines werden die Leute nicht bezahlen.",
          "source_text": "Far out, man, a miniature record, but I'm telling you, people aren't gonna pay for something that small.",
          "transcription_review_required": false
        },
        "ria2-h": {
          "path": "res://assets/languages/de/audio/ria2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf97725953de4cba3b7310e5fe0043e7bd73304add094cf1761f3e36bdaf71d0",
          "text": "Es riecht nach Teenagergeist.",
          "source_text": "It smells like a teen spirit.",
          "transcription_review_required": false
        },
        "rib1-01": {
          "path": "res://assets/languages/de/audio/rib1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b704e3467a1db8fea076582cfa0f4a6125cfe76e43fc954c410c2bc2f3d3c4e",
          "text": "Musik, Schwester, ist der SchlÃ¼ssel zu deiner Seele. Frieden und Harmonie werden Ihr Ziel sein. Tief, oder?",
          "source_text": "Music, Sister, is the key to your soul. Peace and harmony will become your goal. Deep, huh?",
          "transcription_review_required": false
        },
        "rib1-02": {
          "path": "res://assets/languages/de/audio/rib1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f6ead8502fc7a501cd343fb927ae490279ab7bac0ca79f46a330db0197aaa38e",
          "text": "Wenn Sie mich fragen, wie es mir heute geht, scheinen alle meine Probleme gestern so weit weg zu sein. Ja.",
          "source_text": "If you ask me how I feel today well, yesterday all my troubles seem so far away. Yeah.",
          "transcription_review_required": false
        },
        "rib1-03": {
          "path": "res://assets/languages/de/audio/rib1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "66ea733296b075c69fbe069d85569dcf94a1212088ede3c7383f5d1a41bc9a1b",
          "text": "Alles Liebe, Schwester!",
          "source_text": "Love to you, sister!",
          "transcription_review_required": false
        },
        "rib1-04": {
          "path": "res://assets/languages/de/audio/rib1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fcfadb4ca055b70240a043775078d0a6577fbf3e77750751075502b5d13c13a5",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib1-10": {
          "path": "res://assets/languages/de/audio/rib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5ecb9c6264c2662bd906e28c761c3cd6599c39889976c4d351004731c4f8af87",
          "text": "Ja, sicher. Er ist eine coole Katze und ich mag den Kerl.",
          "source_text": "Yeah, sure. He's one cool cat, and I like the guy.",
          "transcription_review_required": false
        },
        "rib1-11": {
          "path": "res://assets/languages/de/audio/rib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f9641d4db56f77f96b95df11733e71cfe0c5464a5e7aacd39ef005577646ec6d",
          "text": "Was lÃ¤sst Sie anders denken?",
          "source_text": "What makes you think differently?",
          "transcription_review_required": false
        },
        "rib1-11h": {
          "path": "res://assets/languages/de/audio/rib1-11h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d7b59f714fe99faffb65ba4910be9bb6debef8104a1b52d7ccd4db133021fd85",
          "text": "Nun ja, Jimmy kann beim Schreiben grausam sein, aber ich glaube an die Meinungsfreiheit, also sage ich, lass es sein. Jedenfalls hat er sich schon bei mir entschuldigt, Mann.",
          "source_text": "Oh, well, that, well, Jimmy can be cruel with his writing, but I believe in the freedom of speech, so I say, let it be. Anyhow, he already apologized to me, man.",
          "transcription_review_required": false
        },
        "rib1-12a": {
          "path": "res://assets/languages/de/audio/rib1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "43bb90b0021e164cdf0531f00594cee99c642a6f9545e32f020a4588654bad73",
          "text": "Er hat sich gerade von Sheila getrennt, Mann. Ich schÃ¤tze, er liebt sie nicht mehr.",
          "source_text": "He just split up with Sheila, man. I guess he doesn't love her anymore.",
          "transcription_review_required": false
        },
        "rib1-12b": {
          "path": "res://assets/languages/de/audio/rib1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7bb0bda6fbc90cd0b871637c6b823dab36862873d23809455799e127ea5e18ec",
          "text": "Das erinnert mich an meine eigene Liebe. Oh, warum, das war sie nicht gewesen, ich weiÃŸ es nicht. Sie sagte, hah.",
          "source_text": "Which reminds me of my own love. Oh, why, she hadn't been, I don't know. She was saying, hah.",
          "transcription_review_required": false
        },
        "rib1-20": {
          "path": "res://assets/languages/de/audio/rib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0db7bf0f0654a1a3c2ed0cb3dd0839117c3e2007b35806aec36ffd19ea96d9d0",
          "text": "Ich habe das Negative satt, bla, bla, bla, Mann. Ich wÃ¼nschte, meine Eris kÃ¶nnte nur Musik hÃ¶ren.",
          "source_text": "I am sick and tired of negative blah, blah, blah, man. I wish my Eris could only hear music.",
          "transcription_review_required": false
        },
        "rib1-20m": {
          "path": "res://assets/languages/de/audio/rib1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bc86a5e581d859c6a9b1d534eef36c35996174ee2537d408b90fd01732c511bf",
          "text": "Was fÃ¼r eine coole neue Maschine, Mann. Ein wandelnder Musikplayer. Das bewegt mich, Mann.",
          "source_text": "What a cool new machine, man. A walking music player. That moves me, man.",
          "transcription_review_required": false
        },
        "rib2-01": {
          "path": "res://assets/languages/de/audio/rib2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a6e68fd2663551dab7750537021fb8bc78ec5977b0d12b49c7501e5b2d1b2aed",
          "text": "Ich kann jetzt nicht reden, Mann. Ich habe meine Musik fÃ¼r das heutige Konzert verloren.",
          "source_text": "I can't talk now, man. I lost my music for tonight's concert.",
          "transcription_review_required": false
        },
        "rib2-02": {
          "path": "res://assets/languages/de/audio/rib2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "538ad7c0aa58bd87adece5b8481cf2b32122a56f3a2f36a10332794afe66876e",
          "text": "Mit diesem BlÃ¶dsinn komme ich jetzt nicht wirklich klar. Meine Musik fÃ¼r das heutige Konzert ist nirgendwo zu finden.",
          "source_text": "I can't really deal with this rubbish now. My music for tonight's concert is like nowhere to be found.",
          "transcription_review_required": false
        },
        "rib2-02h": {
          "path": "res://assets/languages/de/audio/rib2-02h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bedd676ee21aed56d75a77a2a4396fc99ac0ebb5d052b964b21bf744d285b751",
          "text": "Was ist das? Ich kann es nicht lesen. Ich habe meine Brille nicht. Oh, Mann. Was fÃ¼r ein Tag. Was fÃ¼r ein Tag.",
          "source_text": "What is this? I can't read it. I don't have my glasses. Oh, man. What a day. What a day.",
          "transcription_review_required": false
        },
        "rib2-03": {
          "path": "res://assets/languages/de/audio/rib2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "006ace08a71a9fb009160d6a1505f282d8fa21f46eebba0ac789d8bd79a13d3f",
          "text": "Wo ist meine Brille?",
          "source_text": "Where are my glasses?",
          "transcription_review_required": false
        },
        "rib2-04a": {
          "path": "res://assets/languages/de/audio/rib2-04a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8f48c29a82ae5ce8ab2453d3af4ced8ef778c4c0a6dde8cf3d94fb7a407c3619",
          "text": "Mal sehen. Ja, das ist meine Musik.",
          "source_text": "Let's see. Yes, this is my music.",
          "transcription_review_required": false
        },
        "rib2-04b": {
          "path": "res://assets/languages/de/audio/rib2-04b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c3552568aa0d0a7abbd0e18519d883de27d10de5f6701a076f5bac33b4a5bc0b",
          "text": "Die Musik lÃ¤uft!",
          "source_text": "The music's up!",
          "transcription_review_required": true
        },
        "rib2-05": {
          "path": "res://assets/languages/de/audio/rib2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7c1a64cabb7b76a9d003880aed629e7ed8fbde7a6078d8c7d8e06cc1a65a63c0",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib2-05a": {
          "path": "res://assets/languages/de/audio/rib2-05a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7c1a64cabb7b76a9d003880aed629e7ed8fbde7a6078d8c7d8e06cc1a65a63c0",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib2-06": {
          "path": "res://assets/languages/de/audio/rib2-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cef4a17c2830762aa0b51ebf232a92169efb4d8fd26ae14c2d38a1b05324cd31",
          "text": "Ich liebe dich fÃ¼r immer!",
          "source_text": "I love you forever!",
          "transcription_review_required": false
        },
        "rib2-10": {
          "path": "res://assets/languages/de/audio/rib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "32e51328fd61d8148f6eadb36f2f485e35512f3dae276e778755bc295a20ce1c",
          "text": "Es wird mir eine Ehre sein. Hier, das ist mein KÃ¼nstlername. HÃ¤?",
          "source_text": "Like, it'll be my honor. Here, that's my stage name. Huh?",
          "transcription_review_required": false
        },
        "rib2-20": {
          "path": "res://assets/languages/de/audio/rib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e25d2ba58a3c25614aa283fa786d4e3245463bb1169e296731f0c59bdfa61199",
          "text": "Es geht um die Sehnsucht nach einem geliebten Menschen, der nie wieder mir gehÃ¶ren wird.",
          "source_text": "It's about longing for a loved one who will never be mine again.",
          "transcription_review_required": false
        },
        "rib2-30": {
          "path": "res://assets/languages/de/audio/rib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f368a716c222f7f06efb5f923a6f71f8c1799a9be493ebb64dc5803f1ddd0b2e",
          "text": "NatÃ¼rlich nicht, ich habe in der ersten Klasse den ersten Platz beim Rechtschreibwettbewerb gewonnen.",
          "source_text": "Of course not, I won first place in the spelling bee when I was in first grade.",
          "transcription_review_required": false
        },
        "ril-01": {
          "path": "res://assets/languages/de/audio/ril-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "acf92d76bd9bcfd005dcdd716708032c47b288514b1af8ebd17be20dd8bf0dd0",
          "text": "Ich, denkst du, ich bin es? Was hast du gegen mich?",
          "source_text": "Me, you think it's me? What do you have against me?",
          "transcription_review_required": false
        },
        "ril-02": {
          "path": "res://assets/languages/de/audio/ril-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2429012566d14a0327d203f1a9f5ba34a95e07b584c4901c90f23ad11031a73e",
          "text": "Sie kÃ¶nnen immer noch beweisen, dass ich das jetzt geschrieben habe.",
          "source_text": "You still can prove that I wrote that now.",
          "transcription_review_required": false
        },
        "ril-03": {
          "path": "res://assets/languages/de/audio/ril-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "34b8b157b549d66c143f932dfe93e07a42fc42d807b64e8fd308e9e1165a10aa",
          "text": "Du kannst immer noch nicht beweisen, dass ich es bin.",
          "source_text": "You still cannot prove that it's me.",
          "transcription_review_required": false
        },
        "ril-04": {
          "path": "res://assets/languages/de/audio/ril-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6eec71f4b598ab938327fc5a8acf99184b70951043590331922eec67dbbd6441",
          "text": "Ja, ich bin S.P. Na und?",
          "source_text": "Yes, I'm S.P. So what?",
          "transcription_review_required": false
        },
        "ril-05": {
          "path": "res://assets/languages/de/audio/ril-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "76c5258649ba6b89c792e01d9e4fcdbf346a4ed2210733139d7abcc3948fd032",
          "text": "Okay, okay, ich gebe es zu. Ich tat es. Ich konnte den Gedanken nicht ertragen, dass meine geliebte Alice den berÃ¼chtigten Jimmy Mackenzie treffen wÃ¼rde. Ich weiÃŸ nur, dass sie sich verlieben werden. Oh, ich bin so ein eifersÃ¼chtiger Typ. Aber keine Sorge, ich werde den Film Jimmy persÃ¶nlich schenken.",
          "source_text": "Alright, alright, I admit it. I did it. I couldn't bear the thought of my darling Alice meeting the infamous Jimmy Mackenzie. I just know they'll fall in love. Oh, I am such a jealous guy. But don't worry, I'm going to give the film to Jimmy myself.",
          "transcription_review_required": false
        },
        "ril-06": {
          "path": "res://assets/languages/de/audio/ril-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f47a79e6ec70f2a534dfae629f9cdb26661948bd5306f0fe01bbf0c394219d65",
          "text": "Das beweist noch nichts.",
          "source_text": "This doesn't prove anything yet.",
          "transcription_review_required": false
        },
        "ril-07": {
          "path": "res://assets/languages/de/audio/ril-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0c0bd98123beba6bf163bf1925fc9919827878cb8ad5210956ef3778d9582862",
          "text": "Was hat das mit mir zu tun?",
          "source_text": "What does this have to do with me?",
          "transcription_review_required": false
        },
        "ril-08": {
          "path": "res://assets/languages/de/audio/ril-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7d6d85ec87b954169c3f2e6d3d029b0d22c312c125ac482203d6e51c92e946aa",
          "text": "Ã„h, so leicht.",
          "source_text": "Uh, so light.",
          "transcription_review_required": false
        },
        "ril-09": {
          "path": "res://assets/languages/de/audio/ril-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "160ade062dbf6d11c8fed7f244c47b3a7268598d8aea518c6a381c50f29666e1",
          "text": "Nun, sie ist wunderschÃ¶n, aber sie ist nicht mein Typ, Mann. Ich mag BrÃ¼netten.",
          "source_text": "Well, she's beautiful, but she's not my type, man. I like brunettes.",
          "transcription_review_required": false
        },
        "ril-10": {
          "path": "res://assets/languages/de/audio/ril-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "909fcf686df90f34f473189b5313d02966a39acac5be5abd1d544af1e80eb0b2",
          "text": "Man kann nicht einfach durch die Stadt gehen und Leute beschuldigen, als sei jemand unschuldig, solange nicht das Gegenteil bewiesen ist.",
          "source_text": "You can't just go around town accusing people like a person is innocent unless proven otherwise.",
          "transcription_review_required": false
        },
        "rila-01": {
          "path": "res://assets/languages/de/audio/rila-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "46df62bf55fb0a12182278fedf270a788d0c7482d262046c2823573391a0e22b",
          "text": "In dieser kleinen Stadt passiert wirklich etwas. Ãœberall werden die Menschen grÃ¼n. Dorothy will Alices Wohnung. Wer ist ein echter Freund? Was fÃ¼r eine Schande.",
          "source_text": "Things really happen in this little town. People are turning green all around. Dorothy wants Alice's place. Who's a real friend? What a disgrace.",
          "transcription_review_required": false
        },
        "ala3b-01": {
          "path": "res://assets/languages/de/audio/ala3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f9039bcfae28af0e3984692c94d2a11c0c18eabde07556c73bd9f17bce5cb8a3",
          "text": "Ja, ich bin die Fotografin, nicht sie. Hey!",
          "source_text": "Yes, I'm the photographer, not her. Hey!",
          "transcription_review_required": false
        },
        "ala3b-02": {
          "path": "res://assets/languages/de/audio/ala3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9761e08f9c18f8af1e7cd6b364a5ccdb196462caf304c1de539063565de7484d",
          "text": "Ja, und was ist damit?",
          "source_text": "Yeah, and what about this?",
          "transcription_review_required": false
        },
        "ala3b-04a": {
          "path": "res://assets/languages/de/audio/ala3b-04a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "74340448d054b5ea08da8851fb468a114d1a3ce60fbbaccb66f2dd9454f8fe75",
          "text": "Hey, wo ist Julia?",
          "source_text": "Hey, where's Julia?",
          "transcription_review_required": false
        },
        "ala3b-04b": {
          "path": "res://assets/languages/de/audio/ala3b-04b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af39dacf26e37b26ee681ba2bf825a5645e89f71f982e1659562a2cd63e5d1c4",
          "text": "Ich mÃ¶chte ihr danken. Ich hoffe, dass ich die Gelegenheit bekomme, sie wiederzusehen. Ich mag sie wirklich.",
          "source_text": "I want to thank her. I hope I'll get a chance to meet her again. I really like her.",
          "transcription_review_required": false
        },
        "alb3b-02": {
          "path": "res://assets/languages/de/audio/alb3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff51e7e7042469e06090d1b71dad58be189a2bef1273446220b57707ca708446",
          "text": "Ja, Rick. Bei echter Liebe geht es nicht darum, jemanden zu besitzen. Es geht darum, dieser Person Freiheit zu geben.",
          "source_text": "Yes, Rick. Real love is not about owning someone. It's about giving that person freedom.",
          "transcription_review_required": false
        },
        "doa3b-01": {
          "path": "res://assets/languages/de/audio/doa3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8ffc14c51683f96922cbe154cd2f1f0c737fd982516db016d7b9583099a7e73a",
          "text": "Ja klar, und deshalb trage ich das Kleid und die Tasche. Oh, und die Zeichnung habe ich auch.",
          "source_text": "Yeah, sure, and that's why I'm wearing the dress, carrying the bag. Oh, and I have the drawing too.",
          "transcription_review_required": false
        },
        "doa3b-02": {
          "path": "res://assets/languages/de/audio/doa3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "69aeda8c3a465f0857c68bf51aefc4d5a78c70ed16f43ac2184a5058935ce409",
          "text": "Das gehÃ¶rt mir, du Dieb!",
          "source_text": "That's mine, you thief!",
          "transcription_review_required": false
        },
        "doa3b-04": {
          "path": "res://assets/languages/de/audio/doa3b-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3f81628a6c3a04a01fe3d79215ea8344d0a8abadf2b4b73b33b3b8eb477d9766",
          "text": "Okay, ich gebe auf. Wie auch immer, ich habe genug von euch Selbstgerechten.",
          "source_text": "Okay, I give up. Anyway, I've had enough of you self-righteous people.",
          "transcription_review_required": false
        },
        "jia3b-01": {
          "path": "res://assets/languages/de/audio/jia3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c2bf212225eaa2e3564de36d85a6e73ee33dd803e8ab783b154c1efc403683b0",
          "text": "Sie sind also der Fotograf. Ich denke, wir sollten uns besser kennenlernen.",
          "source_text": "So, you're the photographer. I think we should get to know each other better.",
          "transcription_review_required": false
        },
        "jia3b-02": {
          "path": "res://assets/languages/de/audio/jia3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5cbae5d8dbf74345f50441d956f88e434b03ae8b34453c8555e45049d7c89060",
          "text": "Gott sei Dank bist du es. Sie war nicht wirklich mein Typ, aber als ich dich sah...",
          "source_text": "Thank goodness it's you. She wasn't really my type, but the minute I saw you...",
          "transcription_review_required": false
        },
        "jib3-01": {
          "path": "res://assets/languages/de/audio/jib3-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b64b68b6a875cd4728c85364c4801c76d5d8275c8df10cd271070921bad5c30d",
          "text": "Vielen Dank, dass Sie mir den Film gebracht haben, obwohl ich sagen muss, dass ich mich wirklich darauf gefreut habe, das MÃ¤dchen kennenzulernen, das die Bilder gemacht hat.",
          "source_text": "Thanks for bringing me the film, although I must say I was really looking forward to meeting the girl who took the pictures.",
          "transcription_review_required": false
        },
        "jib3a-02": {
          "path": "res://assets/languages/de/audio/jib3a-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "540892d368781269fa1d8fca1a3ef280bcfdce89af3fd6ee44505c198fd8734d",
          "text": "Aber ich wÃ¼rde trotzdem gerne wissen, wie der Fotograf aussieht.",
          "source_text": "But I'd still really like to know what the photographer looks like.",
          "transcription_review_required": false
        },
        "jib3a-03": {
          "path": "res://assets/languages/de/audio/jib3a-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fd69dee87eee95922ff78810faddfa47e79802fdb43884aded1949623b0d8e88",
          "text": "Wow, deine Tante ist wunderschÃ¶n.",
          "source_text": "Wow, your aunt is gorgeous.",
          "transcription_review_required": false
        },
        "jib3a-04": {
          "path": "res://assets/languages/de/audio/jib3a-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a2fbd83c11cd35ad99e8a1e59277ae83a610b7599c2c55b0c97ee98c715b91a6",
          "text": "Ich habe immer an Liebe auf den ersten Blick oder das erste Bild oder was auch immer geglaubt.",
          "source_text": "I always believed in love at first sight, or first picture, or whatever.",
          "transcription_review_required": false
        },
        "jib3b-02": {
          "path": "res://assets/languages/de/audio/jib3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b81381a4e2c6df1da28f9494687e9e0330aec9b0983d2f596d589790a997172f",
          "text": "Du bist so liberal, das liebe ich an einer Frau.",
          "source_text": "You're so liberal, I love that in a woman.",
          "transcription_review_required": false
        },
        "mend": {
          "path": "res://assets/languages/de/audio/mend.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9feb7851c757327059fce3d9f404defb7bd7e6009d97ae0d993fdfb7093d1049",
          "text": "Ã„hm, Julia, ich habe gute und schlechte Nachrichten. Die schlechte Nachricht ist, ich schÃ¤tze, du gehst doch nicht nach Hause.",
          "source_text": "Um, Julia, I have some good news and some bad news. The bad news is, I guess you're not going home after all.",
          "transcription_review_required": false
        },
        "mend2": {
          "path": "res://assets/languages/de/audio/mend2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9bb36a7ecc32448bac7013c748862890d75660ce507072c5c3687dd3c1c7f77e",
          "text": "Aber die gute Nachricht ist: Sie reisen nach Paris in die wilden 20er Jahre. Du musst ein weiteres RÃ¤tsel lÃ¶sen.",
          "source_text": "But the good news is, you're going to Paris to the roaring 20s. You got another mystery to solve.",
          "transcription_review_required": false
        },
        "rib3a-01": {
          "path": "res://assets/languages/de/audio/rib3a-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ca9ef5c32968c5d2114b2f24670c2ffff04acac85b71148df81679e30a43487f",
          "text": "Oh, du willst sie nicht treffen. Es ist, Ã¤h, mein hÃ¤sslicher alter Hase.",
          "source_text": "Oh, you don't want to meet her. It's, uh, my ugly old hand.",
          "transcription_review_required": false
        },
        "rib3a-02": {
          "path": "res://assets/languages/de/audio/rib3a-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "70d8fa48259894baa1b6b62af070306a8e4f6e2449b31787b232b32418ffd3db",
          "text": "Du kannst nicht beweisen, dass es nicht meine alten Hasen sind, oder?",
          "source_text": "You can't prove it's not my old hands, can you?",
          "transcription_review_required": false
        },
        "rib3b-01": {
          "path": "res://assets/languages/de/audio/rib3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07f807e5f9444e1f0fb90cc6c0efcb5f01a472d7d890e17e6047eaba6d25220a",
          "text": "Es tut mir leid, Alice, aber ich habe es nur getan, weil ich dich so sehr liebe! Ich denke, wenn ich dich nicht zu meinem machen kann, muss ich dich gehen lassen.",
          "source_text": "I'm sorry, Alice, but I only did it because I love you so much! I guess that if I can't make you be mine, then I've gotta let you go.",
          "transcription_review_required": false
        },
        "jul1a": {
          "path": "res://assets/languages/de/audio/jul1a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "145cbe8ad6ca3a3e76a43b0215d04f7e13a376ae3c70af1682e37d1aeec10d7d",
          "text": "Hallo Mel, Julia hier.",
          "source_text": "Hi, Mel, Julia here.",
          "transcription_review_required": false
        },
        "jul1b": {
          "path": "res://assets/languages/de/audio/jul1b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "48bce9acc07dba1dc913dcc6d2cab4550b11355635ba94e56f651563e950a573",
          "text": "Ich hatte den schlimmsten Tag.",
          "source_text": "I had the worst day.",
          "transcription_review_required": false
        },
        "jul1c": {
          "path": "res://assets/languages/de/audio/jul1c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e89d23f98f188b18680fcde7c0cfbbd49de7909057377f6bb29d555b5cc37746",
          "text": "Zuerst hatte ich Streit mit meiner Mutter. Sie hat nur eines im Kopf.",
          "source_text": "First, I had a fight with my mom. She has only one thing on her mind.",
          "transcription_review_required": false
        },
        "jul1d": {
          "path": "res://assets/languages/de/audio/jul1d.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "88bc8559b83de580247a79c028d91da55574f790635d7c436e7f3e09a602c47b",
          "text": "Eigentlich auch die Rettung der Wale und mein Studium.",
          "source_text": "Actually too, saving the whales and my studies.",
          "transcription_review_required": false
        },
        "jul1e": {
          "path": "res://assets/languages/de/audio/jul1e.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "069a72717715fa061dc8d27d9868f461d3eae4991d24585aab20d4b2f8df2103",
          "text": "Dann sah ich auf dem Weg zur Schule, wie Laura mit Dylan kicherte. Ich wurde so nervÃ¶s, dass ich nicht sprechen konnte. Mann, ich wÃ¼nschte, ich kÃ¶nnte diesen Tag noch einmal von vorne beginnen.",
          "source_text": "Then, on my way to school, I saw Laura giggling with Dylan. I got so nervous, I couldn't speak. Man, I wish I could start this day from the beginning again.",
          "transcription_review_required": false
        },
        "jul2": {
          "path": "res://assets/languages/de/audio/jul2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "97f2767847b8545906b9c63404fc39e50e80c8a484b69a2e50e0c46ec5c10aeb",
          "text": "Wow. Was passiert?",
          "source_text": "Wow. What's happening?",
          "transcription_review_required": false
        },
        "mel1": {
          "path": "res://assets/languages/de/audio/mel1.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a04df4e71f3a6905a476131303553f3de07bd2e50c699b0e2ec39d605b3b8cb4",
          "text": "Ich weiÃŸ, was du meinst. Vielleicht kann ich Ihnen helfen, das zu beheben. Seien Sie ruhig und geben Sie diese Adresse im Internet ein. Zeitschleifen.com.",
          "source_text": "I know what you mean. Maybe I can help you fix that. Sit tight and enter this address on the net. Time Loops.com.",
          "transcription_review_required": false
        },
        "jbye": {
          "path": "res://assets/languages/de/audio/jbye.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d6c19564c8d52ecfba7f13c8bcb08a6146e0bd65a210727a544c3520991a7324",
          "text": "TschÃ¼ss.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "jlaa1-10": {
          "path": "res://assets/languages/de/audio/jlaa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "211ff97309c2434003d32997f8ac465dfe8937910181fbc6af4fa860cc09883f",
          "text": "Haben Sie hier eine Filmrolle gefunden?",
          "source_text": "Did you find a roll of film here?",
          "transcription_review_required": false
        },
        "jlaa1-11": {
          "path": "res://assets/languages/de/audio/jlaa1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7a5c7c51d9e8d7dc174b7f0ac02fdf666bc28a87748c86a57eda752e10661d50",
          "text": "Ich werde...",
          "source_text": "I'm going to be...",
          "transcription_review_required": false
        },
        "jlaa1-12": {
          "path": "res://assets/languages/de/audio/jlaa1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "49e4359acf748768b04a7b058504db01a9ebd5723cf73d36eb3900f5402e79f2",
          "text": "NEIN.",
          "source_text": "No.",
          "transcription_review_required": false
        },
        "jlaa1-20": {
          "path": "res://assets/languages/de/audio/jlaa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6154762e86b8a7bdb936a4f9f5156d2ec2345219bdef558a004deb5081690a8c",
          "text": "StÃ¶rt es Sie, wenn ich mich umsehe? Alice hat mich hierher geschickt, um nach einem Film zu suchen.",
          "source_text": "Do you mind if I take a look around? Alice sent me here to look for a film.",
          "transcription_review_required": false
        },
        "jlaa1-30": {
          "path": "res://assets/languages/de/audio/jlaa1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "231b69ff7c8990bcbedf90ad039ac2e493de1d00aaab896bafd9b813234b6798",
          "text": "Ich spÃ¼re, dass Sie ein NobelpreistrÃ¤ger sind. Haben Sie hier zufÃ¤llig eine Reihe von Filmen gesehen?",
          "source_text": "I sense that you're a Nobel Prize material. Did you see a row of film around here by any chance?",
          "transcription_review_required": false
        },
        "jlaa1-31": {
          "path": "res://assets/languages/de/audio/jlaa1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ad26c153d77921c9bee0f3a4e34cf26b8a3a686cfb5acb65828b5c2e1c5cc49c",
          "text": "Wer war sie?",
          "source_text": "Who was she?",
          "transcription_review_required": false
        },
        "jlaa1-32": {
          "path": "res://assets/languages/de/audio/jlaa1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a58380e79856452e6db71c5b09f369bc6c1770a5838029cbb817f44b76ef4d0d",
          "text": "Hat dieses MÃ¤dchen gesagt, warum sie den Film braucht?",
          "source_text": "Did this girl say why she needed the film?",
          "transcription_review_required": false
        },
        "jlaa2-10": {
          "path": "res://assets/languages/de/audio/jlaa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fb9e64dab9091f4e2e9189d3911bd36d168c31f653ee458187fb1aee07a26faf",
          "text": "Ich suche keine Schere. Ich bin gekommen, um Alices Kleid zu suchen.",
          "source_text": "I'm not looking for scissors. I came to look for Alice's dress.",
          "transcription_review_required": false
        },
        "jlaa2-20": {
          "path": "res://assets/languages/de/audio/jlaa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2b841b62c7026a41ebe47fdb5a6dab0ea947112a08e5695b4786fe1e31a77f32",
          "text": "Warum dachten Sie, ich sei wegen einer Schere gekommen?",
          "source_text": "What made you think I came for scissors?",
          "transcription_review_required": false
        },
        "jlaa2-21": {
          "path": "res://assets/languages/de/audio/jlaa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c3877905884326ea9ce70572913d0f6feb94ae684e77edc23d2b0fb4f7f471d5",
          "text": "Wer hat Ihrer Meinung nach seine Schere hier gelassen?",
          "source_text": "Who do you think left their scissors here?",
          "transcription_review_required": false
        },
        "jlaa2-22": {
          "path": "res://assets/languages/de/audio/jlaa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5313ffa18db0c8a7cee820fd8d42fda133da96ef0a1c7fc6f04eff690bd2dadf",
          "text": "Wo haben sie die Schere gelassen?",
          "source_text": "Where did they leave the scissors?",
          "transcription_review_required": false
        },
        "jlaa2-30": {
          "path": "res://assets/languages/de/audio/jlaa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c2b30d71d96600acadc7490e6aa51bcbcc2be059272cfb62ced0eddc17087caa",
          "text": "Kennen Sie jemanden namens Betty?",
          "source_text": "Do you know anyone by the name of Betty?",
          "transcription_review_required": false
        },
        "jlaa2-31": {
          "path": "res://assets/languages/de/audio/jlaa2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "630dc15cf19efd16348f2e16bf9f3f381fa2aa4f64d009107ba59868ff1cfe16",
          "text": "Kennen Sie jemanden namens Veronica?",
          "source_text": "Do you know someone called Veronica?",
          "transcription_review_required": false
        },
        "jlaa2-32": {
          "path": "res://assets/languages/de/audio/jlaa2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "086c05863c33518944b3e217b10373b1fe99fc3bd9bbba13f21b795500c7ff84",
          "text": "Kennen Sie ein MÃ¤dchen namens Betty?",
          "source_text": "Do you know a girl called Betty?",
          "transcription_review_required": false
        },
        "jlaa2-by": {
          "path": "res://assets/languages/de/audio/jlaa2-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2146bad560f5dbdbac919197902b1f4ca88baddfbb1f34166277cca0da5ad9cf",
          "text": "Bis spÃ¤ter!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "jlab1-10": {
          "path": "res://assets/languages/de/audio/jlab1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "02ccbb8c3ba806cfebab2ad56370cadc56bce16de7b2ad0bad9be2c5a707c6dd",
          "text": "Wissen Sie etwas Ã¼ber die Fotos, die bei Philip's Chemicals aufgenommen wurden?",
          "source_text": "Do you know anything about the photos that were taken at Philip's Chemicals?",
          "transcription_review_required": false
        },
        "jlab1-11": {
          "path": "res://assets/languages/de/audio/jlab1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f29f2d0cf563e990e9b3b5182cbd0d2ef151f8c0844a422ced974b3f5a56fb64",
          "text": "Wer kam sonst noch hierher?",
          "source_text": "Who else came here?",
          "transcription_review_required": false
        },
        "jlab1-12": {
          "path": "res://assets/languages/de/audio/jlab1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05c4a507c4d8d2d1040f4c4a37e9bcbbabfe11e634a5764beea5a67e97c00145",
          "text": "Wonach sucht diese andere Person?",
          "source_text": "What does this other person come looking for?",
          "transcription_review_required": false
        },
        "jlab1-20": {
          "path": "res://assets/languages/de/audio/jlab1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1b328645ac5b13875e355955b8d0e48348e60558f114cce741c522da2541129e",
          "text": "WÃ¼rden Sie sagen, dass es einen Wettbewerb zwischen Ihnen und Alice gibt?",
          "source_text": "Would you say there's competition going on between you and Alice?",
          "transcription_review_required": false
        },
        "jlab1-30": {
          "path": "res://assets/languages/de/audio/jlab1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b416e9d259cb8b1b7286b630e0fb058e8a1ba2a7707ca67c4ad3a14d58a6903e",
          "text": "Haben Sie hier eine Filmrolle gefunden?",
          "source_text": "Did you find a roll of film here?",
          "transcription_review_required": false
        },
        "jlab2-10": {
          "path": "res://assets/languages/de/audio/jlab2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a9e64608c91f38752518fc0146360b8169e90b9b9f9fe5daa91892f956197532",
          "text": "HÃ¶r zu, Larry, hattest du heute Morgen auÃŸer mir noch andere Besucher?",
          "source_text": "Listen, Larry, did you have any other visitors this morning besides me?",
          "transcription_review_required": false
        },
        "jlab2-11": {
          "path": "res://assets/languages/de/audio/jlab2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b8e4f2af945c929d1e28d12884213645017bc6b93ee40f28335c075e09ca534b",
          "text": "Wer ist heute hier?",
          "source_text": "Who is here today?",
          "transcription_review_required": false
        },
        "jlab2-12": {
          "path": "res://assets/languages/de/audio/jlab2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9f7db381aa85568176383ae24323633e19887430f0c960efec65b9e5ef874557",
          "text": "Was machte diese Person hier?",
          "source_text": "What was this person doing here?",
          "transcription_review_required": false
        },
        "jlab2-20": {
          "path": "res://assets/languages/de/audio/jlab2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f50e990c17f4291eeccbe2d80c44391f50c4ee4747c13b8e2997342f2be67e4a",
          "text": "Ich wÃ¼rde gerne eine Probe Ihrer Handschrift sehen.",
          "source_text": "I'd like to see a sample of your handwriting.",
          "transcription_review_required": false
        },
        "jlab2-30": {
          "path": "res://assets/languages/de/audio/jlab2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a33d817b55dad567325a76b137c06caa7b66fed771db37b8aef296701b475709",
          "text": "Ich habe das GefÃ¼hl, dass du wirklich gut in der Rechtschreibung bist. KÃ¶nnten Sie fÃ¼r mich â€žwunderschÃ¶nâ€œ buchstabieren?",
          "source_text": "I have a feeling that you're real good at spelling. Could you spell gorgeous for me?",
          "transcription_review_required": false
        },
        "laa1-01": {
          "path": "res://assets/languages/de/audio/laa1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b423258fe26410430a4401e570f838ea58024f4236b6b08cae73d536b31fb50",
          "text": "Oh nein! Du hast meine Notizen durcheinander gebracht! Jetzt weiÃŸ ich nicht, welche RÃ¶hre die richtige ist, die rote oder die blaue.",
          "source_text": "Oh, no! You messed up my notes! Now I don't know which tube is the right one to use, the red or the blue.",
          "transcription_review_required": false
        },
        "laa1-03": {
          "path": "res://assets/languages/de/audio/laa1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0df5b522d068698275f46783337e16da6080458882caccd430617a07ace7ab2c",
          "text": "TschÃ¼ss!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "laa1-04": {
          "path": "res://assets/languages/de/audio/laa1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0d382955dac128c694868cf53b16c256854fda9b8af6bb1ec2967e6904957a19",
          "text": "Oh, du musst mir helfen, aus diesem Schlamassel herauszukommen!",
          "source_text": "Oh, you gotta help me get out of this mess!",
          "transcription_review_required": false
        },
        "laa1-05": {
          "path": "res://assets/languages/de/audio/laa1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bc4ff80afc881041d56a866d1f09da6529c345f0174871fd6e48f43cbeb3d643",
          "text": "Was willst du dieses Mal?",
          "source_text": "What do you want this time?",
          "transcription_review_required": false
        },
        "laa1-10": {
          "path": "res://assets/languages/de/audio/laa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ec3081a148c0c62b5b4e3578fdd3c2a68742021c9ac261a857836d4747a6526a",
          "text": "Warum fragen mich alle stÃ¤ndig nach irgendeinem dummen Film? Bin ich ein VerdÃ¤chtiger oder was? Und wer bist du? Sind Sie mit Alice verwandt?",
          "source_text": "Why does everyone keep asking me about some stupid film? Am I a suspect or what? And who are you? Are you related to Alice?",
          "transcription_review_required": false
        },
        "laa1-11": {
          "path": "res://assets/languages/de/audio/laa1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "09a3be74f573266abd476f64468ac4ed02fed5e6125581a5d36d84b32b3bdaa8",
          "text": "Ooh, du gehst mit ihrem Bruder aus, aber ist er nicht etwa 12 oder so?",
          "source_text": "Ooh, you're dating her brother, but isn't he like 12 or something?",
          "transcription_review_required": false
        },
        "laa1-12": {
          "path": "res://assets/languages/de/audio/laa1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ce8e9bb52deb4876f6b9248079876e1009c4def29a374908be31c64375358c35",
          "text": "Seltsam, du siehst genauso aus wie sie.",
          "source_text": "Strange, you look just like her.",
          "transcription_review_required": false
        },
        "laa1-20": {
          "path": "res://assets/languages/de/audio/laa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7962c29c2a2df26885cbbaaeb15ddd150a703820641bad57b245976b04ea9940",
          "text": "Ja, das macht mir etwas aus. Es ist schon schlimm genug, dass Alice mich all diese Berechnungen alleine machen lÃ¤sst, und jetzt lÃ¤sst sie dich herumschnÃ¼ffeln?",
          "source_text": "Yes, I do mind. It's bad enough that Alice leaves me to do all these calculations by myself, and now she has you snooping around?",
          "transcription_review_required": false
        },
        "laa1-20m": {
          "path": "res://assets/languages/de/audio/laa1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f8700deb6a8920312c83d679e30d0d6b59f77d7b4d0f68f8bd80948b0101a139",
          "text": "Wow, danke! Wie hast du es so klein gemacht?",
          "source_text": "Whoa, thanks! How did you get it so small?",
          "transcription_review_required": false
        },
        "laa1-30": {
          "path": "res://assets/languages/de/audio/laa1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5ff8494687e7cc7959cf13ba8a7331dc79fe0138c0581e381c846da7a14dee8a",
          "text": "Halleluja bei der Vision! Was den Film betrifft, habe ich ihn nicht gesehen, aber ein MÃ¤dchen kam hierher und fragte danach.",
          "source_text": "Hallelujah at the vision! As for the film, I haven't seen it, but there was a girl who came here asking about it.",
          "transcription_review_required": false
        },
        "laa1-31": {
          "path": "res://assets/languages/de/audio/laa1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dbfe13ab73f5d854a03388ded7d6476d6e261105fa5457e2307d6582ef88c6c1",
          "text": "Ich weiÃŸ nicht. Ich war zu beschÃ¤ftigt, um sie Ã¼berhaupt anzusehen. Ich erinnere mich, dass sie die ganze Zeit nieste und etwas Ã¼ber Sonnenblumen murmelte.",
          "source_text": "I don't know. I was too busy to even look at her. I do remember that she was sneezing all the time and muttering something about sunflower.",
          "transcription_review_required": false
        },
        "laa1-32": {
          "path": "res://assets/languages/de/audio/laa1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "48acf6cb533f3919faef426a25cd6f7752e489f439745103074ed2d15d48fbf9",
          "text": "Nein, aber vielleicht war sie die Reporterin von The Guardian, die mich stÃ¤ndig anruft und nach dem Film fragt.",
          "source_text": "No, but maybe she was that reporter from The Guardian who keeps calling and asking me about the film.",
          "transcription_review_required": false
        },
        "laa2-01": {
          "path": "res://assets/languages/de/audio/laa2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d42d95f21459a62083e3bc7f5e076d287c3aff5e7d2a34c6e519952fc4a13a5c",
          "text": "Oh, du schon wieder! Bist du wegen deiner Schere gekommen?",
          "source_text": "Oh, you again! Did you come for your scissors?",
          "transcription_review_required": false
        },
        "laa2-02": {
          "path": "res://assets/languages/de/audio/laa2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5421db7dad03a6439722fec74fbd9fbe8e3e712cd6e75996fd0e5a652c372afd",
          "text": "Warum habe ich das GefÃ¼hl, dass ich es tun werde?",
          "source_text": "Why do I have a feeling that I will?",
          "transcription_review_required": false
        },
        "laa2-03": {
          "path": "res://assets/languages/de/audio/laa2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e7c4b36e30364bd0a4073e5ccc364ec7f55b2b65ce82dbbd801a2f2cb56b9d5e",
          "text": "Vielleicht sind Sie dieses Mal auf der Suche nach einer Schere?",
          "source_text": "Maybe this time you're looking for a scissors?",
          "transcription_review_required": false
        },
        "laa2-10": {
          "path": "res://assets/languages/de/audio/laa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "755c2522a13cbab90bd81c8e2f56afd12356b9911d8134b2b98da7375b9819e8",
          "text": "Kleid? Wir arbeiten daran, einen Mann auf den Mond zu bringen, und Sie sind auf der Suche nach einem blÃ¶den Kleid?",
          "source_text": "Dress? We're working on putting a man on the moon, and you are looking for a stupid dress?",
          "transcription_review_required": false
        },
        "laa2-20": {
          "path": "res://assets/languages/de/audio/laa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e75e4e8efb6af75756548e775b96853abd61964aaf0ca34bcb08909dcd8fbe42",
          "text": "Ich war mir sicher, dass du es warst, der sie hier zurÃ¼ckgelassen hat. Ich schÃ¤tze, jemand anderes hat mich besucht.",
          "source_text": "I was sure it was you who left them here. I guess someone else paid me a visit.",
          "transcription_review_required": false
        },
        "laa2-21": {
          "path": "res://assets/languages/de/audio/laa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ef88bb6de2925324479cf23e83a0b10e1c8cf01b671270da76f745f8b9958fb3",
          "text": "Wer sie hinterlassen hat, hat einen exquisiten Geschmack und Duft, mmm, Charmont 500, genau meine Wahl.",
          "source_text": "Whoever left them has exquisite taste and perfume, mmm, Charmont 500, my choice exactly.",
          "transcription_review_required": false
        },
        "laa2-22": {
          "path": "res://assets/languages/de/audio/laa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6ba75f15f818a854b89a74f92078465d4a17bdc3052dd2da0431c2b70197c0ea",
          "text": "BÃ¤r, neben Alices BÃ¼chern.",
          "source_text": "Bear, next to Alice's books.",
          "transcription_review_required": false
        },
        "laa2-30": {
          "path": "res://assets/languages/de/audio/laa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8cb8a5cf0a359c669758d1cc7a386245a72fab08452944635828aebaf998f02e",
          "text": "Warum glaubst du, dass ich jemanden namens Betty kenne?",
          "source_text": "Why would you think that I'd know someone called Betty?",
          "transcription_review_required": false
        },
        "laa2-30h": {
          "path": "res://assets/languages/de/audio/laa2-30h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "55e5843be78403e0deff6c9ece0618bed1c768892ca39f145aef3fd262276af9",
          "text": "Ach, Betty, meine Mutter Betty! Ich sollte sie anrufen, aber was willst du von Betty?",
          "source_text": "Ah, Betty, my mother Betty! I should give her a call, but what do you want from Betty?",
          "transcription_review_required": false
        },
        "laa2-30hh": {
          "path": "res://assets/languages/de/audio/laa2-30hh.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "87c597a74d9dc0130f03b18f6d7d08645f748ae811990ded07d351746bd92eee",
          "text": "Hey, meine Mutter weiÃŸ nichts von Veronica, aber sie weiÃŸ viele Dinge.",
          "source_text": "Hey, my mother does not know of Veronica, but she does know many suhings.",
          "transcription_review_required": false
        },
        "laa2-31": {
          "path": "res://assets/languages/de/audio/laa2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "192fb79d143e9e5d24ecb0f51d2028a727bbfd744e8a3175f0ab6c892225a797",
          "text": "Ich habe einen Artikel gelesen, der von jemandem geschrieben wurde und den er Nika nannte. Ist Nika nicht die AbkÃ¼rzung fÃ¼r Veronica? Ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha.",
          "source_text": "I read an article written by someone called it Nika, isn't Nika short for Veronica? Ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha.",
          "transcription_review_required": false
        },
        "laa2-32": {
          "path": "res://assets/languages/de/audio/laa2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "eef4844e6b408d27449a5e4540e36732df562f6cc4f776ec6b6f87bb8db41ab9",
          "text": "Ich bin hier, um meine Nachforschungen anzustellen, und nicht, um alle Arten von Bettys kennenzulernen.",
          "source_text": "I'm here to do my research, not to meet all kinds of Betty's.",
          "transcription_review_required": false
        },
        "laa2-h": {
          "path": "res://assets/languages/de/audio/laa2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f96d03a816d350b70ad6382101018865d7aad253170f1185393fa35866ee012d",
          "text": "Oh nein! Keine weitere Sonnenblume! Mein Labor sieht aus wie ein Van-Gogh-GemÃ¤lde!",
          "source_text": "Oh no! Not another sunflower! My lab looks like a Van Gogh painting!",
          "transcription_review_required": false
        },
        "lab1-01": {
          "path": "res://assets/languages/de/audio/lab1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1499126c34d1c7bcd6cf0398999e3f9b5d3df0e9e413578c74d091b7a54db236",
          "text": "Komm nicht rein! Ich bin mitten in einem Experiment!",
          "source_text": "Don't come in! I'm in the middle of an experiment!",
          "transcription_review_required": false
        },
        "lab1-02": {
          "path": "res://assets/languages/de/audio/lab1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "03da0901c9bbf1253cd5d8e64b2fc1f2b316de54d3fb5cc0e689985593b92f6a",
          "text": "Ja.",
          "source_text": "Yes.",
          "transcription_review_required": false
        },
        "lab1-04": {
          "path": "res://assets/languages/de/audio/lab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0df5b522d068698275f46783337e16da6080458882caccd430617a07ace7ab2c",
          "text": "TschÃ¼ss!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "lab1-05": {
          "path": "res://assets/languages/de/audio/lab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1de6a26e81ebbd7f0e063930308d95f65dac1c3fc22249b8edce3ea98b98a539",
          "text": "Oh! Du bist es wieder!",
          "source_text": "Oh! It's you again!",
          "transcription_review_required": false
        },
        "lab1-10": {
          "path": "res://assets/languages/de/audio/lab1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c4a3b8021df49f23b2cdf2be57cb538d5dba56ddde1f4162ace072473a74dc6a",
          "text": "Warum sollte ich Ihrer Meinung nach etwas Ã¼ber diese Fotos wissen?",
          "source_text": "Why do you think I should know anything about these photos?",
          "transcription_review_required": false
        },
        "lab1-10h": {
          "path": "res://assets/languages/de/audio/lab1-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "84770b6fcde63e79b1de3bde6ac4463c0402c004cde498cc25b51d3792c74c13",
          "text": "Nein, das stimmt. Es Ã¤hnelt Alice sehr, wenn sie ihre persÃ¶nlichen Notizen auf die Laborpapiere schreibt. Jetzt verstehe ich, warum dieser andere heute Morgen hierher gekommen ist.",
          "source_text": "Nah, that figures. It's so much like Alice to write her personal notes on the lab's paper. Now I understand why that other one came here this morning.",
          "transcription_review_required": false
        },
        "lab1-11": {
          "path": "res://assets/languages/de/audio/lab1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1aa680cf5b94a222cb5b3367f61800a3486d068e15662fa966c0cc3c2e0e40c3",
          "text": "Ich habe nicht einmal einen Blick darauf geworfen. Ich nahm an, dass es Alice war, aber spÃ¤ter fand ich heraus, dass es jemand anderes war, als ich sie Sopran singen hÃ¶rte.",
          "source_text": "I didn't even take a look. I assumed it was Alice, but then, later I figured out that it was someone else when I heard her singing soprano.",
          "transcription_review_required": false
        },
        "lab1-12": {
          "path": "res://assets/languages/de/audio/lab1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3a2b8935cf34bfdce38d3bea51c7f816d1df073b9971a150809a16b61c2e0980",
          "text": "Ich weiÃŸ nicht. Ich nehme an, dass es der Film ist, nach dem jeder sucht, vor allem der neugierige Reporter, der mich stÃ¤ndig belÃ¤stigt, aber meine Lippen sind verschlossen.",
          "source_text": "I don't know. I suppose the film that everyone's after, especially that nosy reporter who keeps bothering me, but my lips are sealed.",
          "transcription_review_required": false
        },
        "lab1-20": {
          "path": "res://assets/languages/de/audio/lab1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1255c6e4837c23e5207f2676376d32c1bd7613955c8a0814f514bf823e45b0fe",
          "text": "Wettbewerb? Zwischen mir und Alice? Ha! Gibt es einen Grund, warum ich sie beneiden sollte?",
          "source_text": "Competition? Between me and Alice? Ha! Is there any reason why I should envy her?",
          "transcription_review_required": false
        },
        "lab1-30": {
          "path": "res://assets/languages/de/audio/lab1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b87354734a8333bda995ea04d1d2c3233bf96a92159aa969fb772579127d117f",
          "text": "Alice hat ihren Film verloren? Dieses MÃ¤dchen sollte nicht mehr fotografieren dÃ¼rfen. Ich meine, sie sollte keine Bilder machen, die sie in Schwierigkeiten bringen.",
          "source_text": "Alice lost her film? That girl shouldn't be allowed to take pictures anymore. I mean she shouldn't take pictures that get her into trouble.",
          "transcription_review_required": false
        },
        "lab120ha": {
          "path": "res://assets/languages/de/audio/lab120ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6cbac4eea7347b1a7b629ee3fdfb93a088f9840b56d32a89a779d444305cd4cf",
          "text": "Oh, wen interessiert das?",
          "source_text": "Oh, who cares about that?",
          "transcription_review_required": false
        },
        "lab120hb": {
          "path": "res://assets/languages/de/audio/lab120hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff01725c0c0d678aee488c632f26ac4ce4ce4403763bd07e10825b8c810709b8",
          "text": "Ich sitze hier mit einem groÃŸen Stipendium von Phillips, Camagulls.",
          "source_text": "I'm sitting here with a big grant from Phillips, Camagulls.",
          "transcription_review_required": false
        },
        "lab2-01": {
          "path": "res://assets/languages/de/audio/lab2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4af9868996a1d1ab5371c75544b8aa266eeaeeb7e6d01f4e776e1951672d975c",
          "text": "Ich stehe kurz vor einem groÃŸen Durchbruch!",
          "source_text": "I'm on the verge of a major breakthrough!",
          "transcription_review_required": false
        },
        "lab2-02": {
          "path": "res://assets/languages/de/audio/lab2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fb88524aca03799198886cde92c741038a76c920872114cf7b618f6cbe5c88a4",
          "text": "Ja, ja.",
          "source_text": "Yes, yes.",
          "transcription_review_required": false
        },
        "lab2-03": {
          "path": "res://assets/languages/de/audio/lab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0c50e843a97f86f082ef0082518d085b010a500ec588d8108a22158be993c5fb",
          "text": "Auch Sie haben keinen Respekt vor wissenschaftlichen Entdeckungen?!",
          "source_text": "You, again, don't you have any respect for scientific discoveries?!",
          "transcription_review_required": false
        },
        "lab2-10": {
          "path": "res://assets/languages/de/audio/lab2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ad0ebdad442ac4a5153fae1f28a2f1415d58fbd758758d5b8abe46e44ea7d888",
          "text": "Bevor Sie mit Ihrem KreuzverhÃ¶r beginnen, mÃ¶chte ich uns beiden etwas Zeit ersparen. Heute Morgen war jemand hier.",
          "source_text": "Before you begin your cross-examination, let me save us both some time. There was someone here this morning.",
          "transcription_review_required": false
        },
        "lab2-11": {
          "path": "res://assets/languages/de/audio/lab2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "54e6191e8f84aceb56d275e8c6741cb47246029e8d9dcca9d9c0e66fcc30ee8f",
          "text": "Dieselbe Person, die die Sopranstimme hat, aber ich hatte keine Gelegenheit, sie zu sehen, weil meine Brille von den DÃ¤mpfen im Labor beschlagen war.",
          "source_text": "The same person who has the soprano voice, but I didn't get a chance to see her because my glasses were fogged up from the fumes in the lab.",
          "transcription_review_required": false
        },
        "lab2-12a": {
          "path": "res://assets/languages/de/audio/lab2-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "67ece1544e3f46618aea4a8efb26545a1f99b993182ab8d090ed9385325a6a9a",
          "text": "Ich habe keine Ahnung, aber wer auch immer es war, hat seine Brille zurÃ¼ckgelassen.",
          "source_text": "I have no idea, but whoever it was, left their glasses behind.",
          "transcription_review_required": false
        },
        "lab2-12b": {
          "path": "res://assets/languages/de/audio/lab2-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e089534a85d0037cf634021b4286e5d2526506e1dab206cf0f1a578a7a56abe8",
          "text": "Das ist Ã¼brigens genau die gleiche Brille, die dieser neugierige Reporter trÃ¤gt.",
          "source_text": "By the way, these are the exact same glasses as that nosey reporter wears.",
          "transcription_review_required": false
        },
        "lab2-20": {
          "path": "res://assets/languages/de/audio/lab2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c5eed175800d98480498d8d15600ee9cafe08710b55dc4b0ed3410e759fb9d6b",
          "text": "Ich habe keine Zeit fÃ¼r deine Anschuldigungen! Ich widme meine Zeit der Arbeit an Entdeckungen und Innovationen! Wenn Sie mÃ¶chten, dass ich einen Graphologietest mache, mÃ¼ssen Sie einen Gerichtsbeschluss einholen!",
          "source_text": "I don't have time for your accusations! I devote my time to working on discoveries and innovations! If you want me to do a graphology test, you'll have to get a court order!",
          "transcription_review_required": false
        },
        "lab2-20m": {
          "path": "res://assets/languages/de/audio/lab2-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "90779fa081287745edb0d9f6c9d9c7637f333e15639d056d9c95772b638521c4",
          "text": "GroÃŸartige Erfindungen der 1990er Jahre von Robert Palmer! Oh, da ist ein Robert Palmer in meinem Physikunterricht! Ich wusste nicht, dass er Science-Fiction schrieb!",
          "source_text": "Great inventions of the 1990s by Robert Palmer! Oh, there's a Robert Palmer in my physics class! I didn't know he wrote science fiction!",
          "transcription_review_required": false
        },
        "lab2-30": {
          "path": "res://assets/languages/de/audio/lab2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1e23b080c3cfd65b686dbe6b0421b7851a2fa7d024c5c6dc5b4c6e1bb4940380",
          "text": "NatÃ¼rlich kann ich. Mein GedÃ¤chtnis ist phÃ¤nomenal.",
          "source_text": "Of course I can. My memory is phenomenal.",
          "transcription_review_required": false
        },
        "lal-01": {
          "path": "res://assets/languages/de/audio/lal-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4ce5718bf84797b2258a1c243ac4aab670f0d03173dd082e8126cb09814c43d8",
          "text": "Mich? Warum denkst du, dass ich es bin?",
          "source_text": "Me? Why do you think it's me?",
          "transcription_review_required": false
        },
        "lal-02": {
          "path": "res://assets/languages/de/audio/lal-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b4dd1e467186767f0ebffd9b549c0d25055b8a3a81b8fb076768758c78000f71",
          "text": "Ich habe damit nichts zu tun!",
          "source_text": "I have nothing to do with this!",
          "transcription_review_required": false
        },
        "lal-04": {
          "path": "res://assets/languages/de/audio/lal-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5fc824077bb0021e5e6c673cdbee4f6ee5832bd33ed112cf6ddebd2e308eee95",
          "text": "Na und? Wie kannst du es wagen?",
          "source_text": "So what? How dare you?",
          "transcription_review_required": false
        },
        "lal-05": {
          "path": "res://assets/languages/de/audio/lal-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7a4378e3b7b3f9d50b80bf645b89c2fc55ff37d765067c27cdbb9fba265ea149",
          "text": "Der einzige Mensch auf dieser Welt, der mich wirklich liebt, und das willst du mir nehmen?",
          "source_text": "The only human being who truly loves me in this world, and you want to take that away from me?",
          "transcription_review_required": false
        },
        "lal-06": {
          "path": "res://assets/languages/de/audio/lal-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cd6371a8b9173cab6d8b9d51fd4d88fd199c9a9512b6d5130afb60c4dff934cc",
          "text": "Ist sie nicht wunderschÃ¶n? Sobald sie liest, was fÃ¼r ein groÃŸartiger Wissenschaftler ich bin, wird sie sich unsterblich in mich verlieben.",
          "source_text": "Isn't she beautiful? Once she reads what a great scientist I am, she'll fall madly in love with me.",
          "transcription_review_required": false
        },
        "lal-07": {
          "path": "res://assets/languages/de/audio/lal-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f4616096f80216ae6c965a25d638394abf5b05cafeb4fe361c4d2c64a449a782",
          "text": "Na und?",
          "source_text": "So what?",
          "transcription_review_required": false
        },
        "lal-08": {
          "path": "res://assets/languages/de/audio/lal-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3af76aaf1413e131da5e76df4566b4b9eeaafd5fe4599b18ceef144bc8fa9bda",
          "text": "Wussten Sie, dass Sie und Ihre Anschuldigungen mich einen Tag Arbeit gekostet haben? Verschwenden Sie nicht noch mehr Zeit!",
          "source_text": "Do you know that you and your accusations cost me a day's work? Do not waste any more of my time!",
          "transcription_review_required": false
        },
        "lal-09": {
          "path": "res://assets/languages/de/audio/lal-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4cd2b7d0a4e84cd5d237ec5a594c997939a64808f277527fcc03501e7edc2922",
          "text": "Das sollte mir gehÃ¶ren!",
          "source_text": "That was meant to be mine!",
          "transcription_review_required": false
        },
        "mel10": {
          "path": "res://assets/languages/de/audio/mel10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "72133e849a4d2b94305e89454c222cc3adb207dba88bce978617744f0be5c5bb",
          "text": "Du wirst noch einmal darÃ¼ber nachdenken. Lasst uns nichts Voreiliges tun. Wenn du einen Fehler machst, treffen sich deine Eltern nicht und du wirst fÃ¼r immer im Zeittunnel schweben.",
          "source_text": "You'll think again. Let's not do anything hasty. If you make a mistake, your parents won't meet, and you'll be floating in the time tunnel forever.",
          "transcription_review_required": false
        },
        "mel11": {
          "path": "res://assets/languages/de/audio/mel11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3f18d84733cd11a65b0329cf70d49af5f4c530fefd357dd67c5a42a876bd4a5e",
          "text": "Jetzt kÃ¶nnen Sie Ihre Eltern kennenlernen. Beeil dich, ich brauche dich wieder hier bei mir.",
          "source_text": "Now you can make your parents meet. Hurry, I need you back here with me.",
          "transcription_review_required": false
        },
        "mel12": {
          "path": "res://assets/languages/de/audio/mel12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "926c66f8ce9efa7fc7d98c2d42f5233262ace9985d9eeea388d92c6480e8a2f4",
          "text": "Suchen Sie nach etwas, das zeigt, dass Alice die Fotografin ist.",
          "source_text": "Look for something to show that Alice is the photographer.",
          "transcription_review_required": false
        },
        "mel2": {
          "path": "res://assets/languages/de/audio/mel2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f94427c2aa83af5be84437e71f6fcb93563bf6b25121527a1fd8404481bc0388",
          "text": "Hey, komm schon. Klicken Sie auf diese Person. Es sieht so aus, als hÃ¤tten sie Ihnen etwas Interessantes zu sagen.",
          "source_text": "Hey, come on. Click on this person. It looks as though they have something interesting to tell you.",
          "transcription_review_required": false
        },
        "mel21": {
          "path": "res://assets/languages/de/audio/mel21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4e42434063c6ee3e5ebc4a833b65c887859f42c2ad44cb55fab713aac554e87d",
          "text": "Sie scheint nicht aufhÃ¶ren zu kÃ¶nnen. Vielleicht gibt es etwas, das sie dazu bringt, mit dem Niesen aufzuhÃ¶ren.",
          "source_text": "She can't seem to stop. Maybe there's something that will make her stop sneezing.",
          "transcription_review_required": false
        },
        "mel22": {
          "path": "res://assets/languages/de/audio/mel22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8bde8748885c5e5c552d916a1c232409364af328dcf4585ffce3a148e94de00e",
          "text": "Anstatt zu versuchen, dieses Problem zu lÃ¶sen, versuchen Sie, das Objekt zu entfernen, das das Problem verursacht.",
          "source_text": "Instead of trying to solve this problem, try to remove the object that creates the problem.",
          "transcription_review_required": false
        },
        "mel23": {
          "path": "res://assets/languages/de/audio/mel23.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bc3c1f4dce17e3438f9a4be8b3b43b4055a6f2dde0cd033a7ffd3a31660dcc11",
          "text": "Ich glaube, Shy-Ann war schon da. Ich bin sicher, sie kann uns helfen.",
          "source_text": "I think Shy-Ann's been around. I'm sure she can help us.",
          "transcription_review_required": false
        },
        "mel3": {
          "path": "res://assets/languages/de/audio/mel3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f14894fbc9a8030735aee507fe9b58bad02158190e8dccb4d098573eca2a57ac",
          "text": "Ich denke, jeder hier ist irgendwie involviert. Versuchen Sie, sich auf das einzulassen, was sie sagen. MÃ¶glicherweise verbergen sie etwas.",
          "source_text": "I think everyone here is involved somehow. Try to tune into what they're saying. They may be hiding something.",
          "transcription_review_required": false
        },
        "mel36": {
          "path": "res://assets/languages/de/audio/mel36.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "000008c1d39cfa1c3884e6745b1550ebf26d83e1bd250a831fec56d949b5b585",
          "text": "Vielleicht hat die Person, die den Film aufgenommen hat, ihn zur Entwicklung abgegeben.",
          "source_text": "Maybe the person who took the film dropped it off to be developed.",
          "transcription_review_required": false
        },
        "mel4": {
          "path": "res://assets/languages/de/audio/mel4.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7000ddaa412185a75f81676055c878b5384e53724cdce6db188e65f60f4725dd",
          "text": "Erinnerst du dich, wie wir im Zimmer meiner Schwester herumgeschnÃ¼ffelt haben? Machen Sie es gerne auch hier! Man weiÃŸ nie, was man finden wird!",
          "source_text": "Remember how we used to snoop around in my sister's room? Feel free to do it here, too! You never know what you may find!",
          "transcription_review_required": false
        },
        "mel5": {
          "path": "res://assets/languages/de/audio/mel5.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05695004ae98bd04c1acdef83d6322e425c73a8b27dececbff7a5784169d7d2e",
          "text": "Fragen Sie lieber etwas, was auch immer Sie wollen!",
          "source_text": "You'd better ask something, whatever you want!",
          "transcription_review_required": false
        },
        "mel6": {
          "path": "res://assets/languages/de/audio/mel6.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1ca58910f3644f9468a28a7a809cb12919b35ad8af8fc6d6bf0de6fc226f626b",
          "text": "Wir mÃ¼ssen darÃ¼ber nachdenken, was wir dieser Person von unserer Zeit schenken kÃ¶nnen, das ideale Geschenk, das den Zweck erfÃ¼llt.",
          "source_text": "We've got to think about what we can give this person from our time, the ideal gift that will do the trick.",
          "transcription_review_required": false
        },
        "mel6a": {
          "path": "res://assets/languages/de/audio/mel6a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f046dd3d0d761a75f14e5edb33d217253a3faaf831fb005671adc5caf8b8307f",
          "text": "Oh-oh, ich glaube, du hast hier jemanden wirklich wÃ¼tend gemacht. Warum suchen Sie nicht in Ihrem RÃ¼cken nach etwas, das sie beruhigt, damit wir unsere Reise fortsetzen kÃ¶nnen?",
          "source_text": "Uh-oh, I think you made someone here really mad. Why don't you look in your back for something that'll pacify them, so that we can continue our journey?",
          "transcription_review_required": false
        },
        "mel7": {
          "path": "res://assets/languages/de/audio/mel7.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0acc541b6b07201d64fbd086970cfb91e086bb4cecf490882ecd72d6681278e5",
          "text": "Vielleicht kÃ¶nnen Sie ihnen etwas zeigen, das Sie gesammelt haben und das sie zum Reden bringt.",
          "source_text": "Maybe you can show them something you collected that will make them talk.",
          "transcription_review_required": false
        },
        "mel8": {
          "path": "res://assets/languages/de/audio/mel8.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0a215c9afd201d4dc605a68f1321c5e7ce73cb8b699a643631f2b84c5b451df8",
          "text": "Sind Sie sicher, dass Sie das tun mÃ¶chten? Jemanden zu beschuldigen ist eine sehr ernste Angelegenheit und dafÃ¼r braucht man Beweise.",
          "source_text": "Are you sure you want to do that? Accusing someone is a very serious matter, and you need proof for that.",
          "transcription_review_required": false
        },
        "mel9": {
          "path": "res://assets/languages/de/audio/mel9.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "65268d0e0f42ab64f4315e0deecb98a2c02593667946d863bfaed3b36a37dc21",
          "text": "Ich habe dir gesagt, dass sie Beweise sehen wollen. Ich hoffe wirklich, dass Sie genÃ¼gend Beweise haben.",
          "source_text": "I told you they'd want to see proof. I sure hope you have enough evidence.",
          "transcription_review_required": false
        },
        "melquit": {
          "path": "res://assets/languages/de/audio/melquit.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3efe836ee8702583f3898b059b0190e1cc53ad2030cb8ad46f3f47f93d75ebef",
          "text": "Sind Sie sicher, dass Sie das Spiel beenden mÃ¶chten?",
          "source_text": "Are you sure you want to quit the game?",
          "transcription_review_required": false
        },
        "jnia1-10": {
          "path": "res://assets/languages/de/audio/jnia1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f49d06264b9bd34adb4159effb21e130ec49cce9e8299a5768fb603eddb7eec9",
          "text": "Vielleicht haben Sie etwas Ã¼ber eine Filmrolle gehÃ¶rt, nach der jeder sucht?",
          "source_text": "Maybe you heard something about a roll of film that everyone's looking for?",
          "transcription_review_required": false
        },
        "jnia1-11": {
          "path": "res://assets/languages/de/audio/jnia1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "86390f26154ab0049f54e1c19b1e84cde65600f6a70a078435573c6eff4696a6",
          "text": "Ich habe das GefÃ¼hl, dass Sie eines Tages ein berÃ¼hmter Reporter werden und mit Ihren scharfen Sinnen wissen mÃ¼ssen, wo der Film ist.",
          "source_text": "I have a feeling that one day you'll become a famous reporter, with your sharp senses, you must know where the film is.",
          "transcription_review_required": false
        },
        "jnia1-12": {
          "path": "res://assets/languages/de/audio/jnia1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "821913d4b7e2e38ec49f2b812448b145268679aea3be22db4e986865d1cff895",
          "text": "Sind Sie auch hinter diesem Film her?",
          "source_text": "Are you also after that film?",
          "transcription_review_required": false
        },
        "jnia1-20": {
          "path": "res://assets/languages/de/audio/jnia1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "83aab3da76ed2d73664e9c8f438e902353b6b94030ee889c0c09048600312f35",
          "text": "Arbeitet hier Jimmy Mackenzie?",
          "source_text": "Is this where Jimmy Mackenzie works?",
          "transcription_review_required": false
        },
        "jnia1-21": {
          "path": "res://assets/languages/de/audio/jnia1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5fb8bd2b5f25670ffb3bccbf4c93689087650bbb87c0877a24b4de559bb17ad8",
          "text": "Wo ist er?",
          "source_text": "Where is he?",
          "transcription_review_required": false
        },
        "jnia1-22": {
          "path": "res://assets/languages/de/audio/jnia1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0a1c61ed3a591f71075bd9ae5370812e53f20dfe23dfd58d89f90f616925c73e",
          "text": "Du arbeitest mit Jimmy. Wissen Sie, wen er heutzutage trifft? Romantisch meine ich.",
          "source_text": "You work with Jimmy. Do you know who he's seeing these days? Romanticly, I mean.",
          "transcription_review_required": false
        },
        "jnia2-10": {
          "path": "res://assets/languages/de/audio/jnia2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "99f8843619e9a529f2a85b34ac1fc9ce45cbf41537b12d818cd6b6cc3b91b661",
          "text": "Sag mir, bist du die Veronica, die auf diesem Entwicklungsblatt unterschrieben hat?",
          "source_text": "Tell me, are you the Veronica who signed on this development sheet?",
          "transcription_review_required": false
        },
        "jnia2-20": {
          "path": "res://assets/languages/de/audio/jnia2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "19cb19ee11d51b592e3b08576fa502848b313ada1a395786d64934be0266b67d",
          "text": "Veronica, ist Jimmy hier?",
          "source_text": "Veronica, is Jimmy here?",
          "transcription_review_required": false
        },
        "jnia2-21": {
          "path": "res://assets/languages/de/audio/jnia2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6774317ab05790573759594502a5193827ad13ea7da32569795743e8ad6b4cec",
          "text": "Wer ist also diese mysteriÃ¶se Veronica?",
          "source_text": "So who's this mysterious Veronica?",
          "transcription_review_required": false
        },
        "jnia2-30": {
          "path": "res://assets/languages/de/audio/jnia2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f60a61dc39c1f127e1acbc11a92baf5295d69e849e7d0bdf0e34cea5d335b451",
          "text": "Ich glaube, ich habe im Labor etwas gefunden, das Ihnen gehÃ¶rt.",
          "source_text": "I think I might have found something in the lab that belongs to you.",
          "transcription_review_required": false
        },
        "jnia2-31": {
          "path": "res://assets/languages/de/audio/jnia2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7b5b040a4056c38b7910a0e01689c4497cd714b78d89d80fc3cfefff98fdbd3c",
          "text": "Worum geht es in dem Interview?",
          "source_text": "What's the interview about?",
          "transcription_review_required": false
        },
        "jnia2-32": {
          "path": "res://assets/languages/de/audio/jnia2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2482a54c4f3be4d6e404619f6583bde957bd69b6943eb5d35f3250669f2044ed",
          "text": "Haben Sie bemerkt, dass jemand VerdÃ¤chtiges auf Larry Changs SchoÃŸ herumlungerte?",
          "source_text": "Did you notice anyone suspicious hanging around Larry Chang's lap?",
          "transcription_review_required": false
        },
        "jnib1-10": {
          "path": "res://assets/languages/de/audio/jnib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fc5c10834c2fd61654a4d260d70c39900f672636ad106db780b3b38cd571f8f9",
          "text": "Hallo! Arbeitet Jimmy Mackenzie hier?",
          "source_text": "Hi! Does Jimmy Mackenzie work here?",
          "transcription_review_required": false
        },
        "jnib1-11": {
          "path": "res://assets/languages/de/audio/jnib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "84fc1435af9542953a15601ac733af74221c1318833f49fab4f7ad04615333cc",
          "text": "Wo kann ich ihn finden?",
          "source_text": "Where can I find him?",
          "transcription_review_required": false
        },
        "jnib1-12": {
          "path": "res://assets/languages/de/audio/jnib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0afca7cd797ff36510f1b9d03573013afc694ecf94153b15517e30a7b1be78b8",
          "text": "Wissen Sie zufÃ¤llig, ob Sie heute ein wichtiges Meeting haben?",
          "source_text": "Would you happen to know if you have an important meeting today?",
          "transcription_review_required": false
        },
        "jnib1-20": {
          "path": "res://assets/languages/de/audio/jnib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "563b019f7aef8f00b09e1ae49c74126e893ae0e39c4c7004dca4b5df133669d6",
          "text": "Rufen Sie an, um das Treffen sofort abzusagen.",
          "source_text": "Call to cancel the meeting just now.",
          "transcription_review_required": false
        },
        "jnib1-21": {
          "path": "res://assets/languages/de/audio/jnib1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "903358a5175168fad6ced4e69d407153b2fd76b332a4be6bf627c2934be43949",
          "text": "Wer zum Beispiel?",
          "source_text": "Who, for instance?",
          "transcription_review_required": false
        },
        "jnib1-22": {
          "path": "res://assets/languages/de/audio/jnib1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4dfab0b23f518ae6f94415edbb17f7f314692843825b4f4c87656068ac95c6fb",
          "text": "Wird Jimmy enttÃ¤uscht sein?",
          "source_text": "Is Jimmy going to be disappointed?",
          "transcription_review_required": false
        },
        "jnib1-30": {
          "path": "res://assets/languages/de/audio/jnib1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c57c65faee6af61ccf4f4aff051bd2574a0edb971ed0f93a48c2ac083a256bad",
          "text": "Wissen Sie zufÃ¤llig, ob Jimmy McKenzie und Alice Kaplan zusammen sind?",
          "source_text": "Do you happen to know if Jimmy McKenzie and Alice Kaplan are dating?",
          "transcription_review_required": false
        },
        "jnib1-31": {
          "path": "res://assets/languages/de/audio/jnib1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4302960fe1678820900762efe0dbe0e8cd628c25e78e1f761308b599f8c8313a",
          "text": "Wer ist Sheila?",
          "source_text": "Who's Sheila?",
          "transcription_review_required": false
        },
        "jnib1-32": {
          "path": "res://assets/languages/de/audio/jnib1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff63b15d3391837862eb5dfc276902940b353486f008141c77863401c5efe511",
          "text": "Ich meinte Alice, Miss Equal Rights, Peace and Love, Alice.",
          "source_text": "I meant Alice, Miss Equal Rights, Peace and Love, Alice.",
          "transcription_review_required": false
        },
        "jnib2-10": {
          "path": "res://assets/languages/de/audio/jnib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d63296b19e7a457e44a9fec498384fefc03249231cbd7df31a344981669af18b",
          "text": "Haben Sie etwas im Labor vergessen?",
          "source_text": "Did you forget something in the lab?",
          "transcription_review_required": false
        },
        "jnib2-20": {
          "path": "res://assets/languages/de/audio/jnib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "387b68109470249ff082800912244ca2b10b0ea80b0dad0d27df349e146e1473",
          "text": "Woran arbeitest du?",
          "source_text": "What are you working on?",
          "transcription_review_required": false
        },
        "jnib2-21": {
          "path": "res://assets/languages/de/audio/jnib2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f113c94ec8d7155a64eca6d6330631556ed63b4a0b44b0e569d697416d4b6d52",
          "text": "KÃ¶nnen Sie die Adresse aufschreiben, wo es sein wird?",
          "source_text": "Can you write down the address where it's going to be?",
          "transcription_review_required": false
        },
        "jnib2-22": {
          "path": "res://assets/languages/de/audio/jnib2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "52dacd40735d62d16cc0f023b12109df440af351f2ef43b82dbd63c0930165b1",
          "text": "KÃ¶nnen Sie mir eine Wegbeschreibung geben?",
          "source_text": "Can you give me directions?",
          "transcription_review_required": false
        },
        "jnib2-30": {
          "path": "res://assets/languages/de/audio/jnib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b7768212e7867e3615a666d658d540f976b3cbae7e4a107cc08df0d2f2ec9d70",
          "text": "Wie sind Sie auf diesen Artikel aufmerksam geworden?",
          "source_text": "How did you get the scoop on this article?",
          "transcription_review_required": false
        },
        "nia1-01": {
          "path": "res://assets/languages/de/audio/nia1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "33f9cf53f48ce8f6d68c17b2bbf29917c09647c61d95cdac83d97df861a28fd6",
          "text": "Danke fÃ¼r die UnterstÃ¼tzung. Oh, wenn nur Frauen auf der ganzen Welt untereinander kommunizieren kÃ¶nnten. Nein, das geht auf keinen Fall.",
          "source_text": "Thanks for the support. Oh, if only women all over the world could communicate among themselves. Nah, there's no way that could be done.",
          "transcription_review_required": false
        },
        "nia1-03": {
          "path": "res://assets/languages/de/audio/nia1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f076904235dcd8211b9b06e5359ddd8a918e1e707619ba1894a0679f598a3ee3",
          "text": "Frieden!",
          "source_text": "Peace!",
          "transcription_review_required": false
        },
        "nia1-04": {
          "path": "res://assets/languages/de/audio/nia1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8b41c18a833953194328155afded24ec53e16c5e789f109f8f6f96031f5af1d5",
          "text": "Was willst du, Schwester?",
          "source_text": "What do you want, sister?",
          "transcription_review_required": false
        },
        "nia1-10a": {
          "path": "res://assets/languages/de/audio/nia1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "861b45cd2c50f678be49cda3108483dbe54189f2481efa60555baef04c99401f",
          "text": "HÃ¶ren.",
          "source_text": "Listen.",
          "transcription_review_required": false
        },
        "nia1-10b": {
          "path": "res://assets/languages/de/audio/nia1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c4d208863abca24f377a31bb45532c2905beacc88f39e7fc31fd2902b12c308",
          "text": "Jimmy hier hat mir bereits erzÃ¤hlt, dass er einen anonymen Brief Ã¼ber einen Film erhalten hat, der Philips Chemikalien belastet. Es sollte meine Geschichte sein, aber Sie wissen, dass es da drauÃŸen eine MÃ¤nnerwelt ist.",
          "source_text": "Jimmy here already told me that he got an anonymous letter about a film incriminating Philip's chemicals. It should be my story, but you know it's a man's world out there.",
          "transcription_review_required": false
        },
        "nia1-11": {
          "path": "res://assets/languages/de/audio/nia1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "017f21eadf95d981eab21121022506a2de07c370b2698be8bdd137623441561a",
          "text": "Hey! Versuchen Sie diese schmeichelhaften Tricks nicht an mir!",
          "source_text": "Hey! Don't try those flattering tricks on me!",
          "transcription_review_required": false
        },
        "nia1-12": {
          "path": "res://assets/languages/de/audio/nia1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e361cf93ba583047e16ee020e94f2cc440dca6d1f5e269c3d0ecba26fcc3cf5",
          "text": "Warum fragst du? Hat Ihnen Larry Chang diesen Unsinn erzÃ¤hlt? Er hat ein Stipendium von Philip's Chemicals bekommen, wissen Sie.",
          "source_text": "Why do you ask? Did Larry Chang tell you that nonsense? He got a scholarship from Philip's Chemicals, you know.",
          "transcription_review_required": false
        },
        "nia1-20a": {
          "path": "res://assets/languages/de/audio/nia1-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a85dd35085f6195b833f03e3d906014667b4973192c032a7cf039d4b8f72b42e",
          "text": "Ja, das ist sein Schreibtisch.",
          "source_text": "Yep, that's his desk.",
          "transcription_review_required": false
        },
        "nia1-20b": {
          "path": "res://assets/languages/de/audio/nia1-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "83eb5954037abbe5da0e09ae0f0a3e8899be7d931f8f72d3ead99b6f34bf9445",
          "text": "Riecht himmlisch.",
          "source_text": "Smells heavenly.",
          "transcription_review_required": false
        },
        "nia1-21": {
          "path": "res://assets/languages/de/audio/nia1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "373f1405cc627e1e90336f70ae92aad8764b79629b9b6ca9a16fadd16f5054b9",
          "text": "Hier, dort und Ã¼berall.",
          "source_text": "Here, there and everywhere.",
          "transcription_review_required": false
        },
        "nia1-22": {
          "path": "res://assets/languages/de/audio/nia1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6070ec1e5769b0cfdbec7ce9e444200244cfee8a312babcf28099cd6e2eb52c8",
          "text": "HÃ¶r zu, neugierig. Jimmy Mackenzie ist nicht mein einziges Interesse am Leben. Ich bin nicht wie Sheila Phillips, die von Jimmy besessen ist, selbst nachdem er sie verlassen hat.",
          "source_text": "Listen, nosy. Jimmy Mackenzie's not my only interest in life. I'm not like Sheila Phillips, who's obsessed with Jimmy even after he dumped her.",
          "transcription_review_required": false
        },
        "nia2-01": {
          "path": "res://assets/languages/de/audio/nia2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fcfadb4ca055b70240a043775078d0a6577fbf3e77750751075502b5d13c13a5",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nia2-02": {
          "path": "res://assets/languages/de/audio/nia2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7c1a64cabb7b76a9d003880aed629e7ed8fbde7a6078d8c7d8e06cc1a65a63c0",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nia2-03": {
          "path": "res://assets/languages/de/audio/nia2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a85e2c741cb07af5daca90f73805764040576ddf0790fc0b0b6a329379d0b620",
          "text": "Es gibt nichts Neues unter der Sonne, und wir sind hier, um etwas zu bewirken.",
          "source_text": "There's nothing new under the sun, and we are here to make a difference.",
          "transcription_review_required": false
        },
        "nia2-10": {
          "path": "res://assets/languages/de/audio/nia2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "67f7ea19cfd090545233abd16883b3f76f2b020e8b218e33a887937dd601ad42",
          "text": "Hey, ich bin ein Reporter, der Geschichten recherchiert, nicht sie erfindet.",
          "source_text": "Hey, I'm a reporter investigating stories, not creating them.",
          "transcription_review_required": false
        },
        "nia2-10m": {
          "path": "res://assets/languages/de/audio/nia2-10m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9e63ace1a824bd99664fea2223086c2bb8d63226e0f7bbc7d749fbaa11372121",
          "text": "Nixon wird PrÃ¤sident. Nur weil Sie so einfallsreich sind, werde ich Ihre vorherigen Anschuldigungen vergessen.",
          "source_text": "Nixon will become president. Just because you have such an imaginative mind, I'll forget your previous accusations.",
          "transcription_review_required": false
        },
        "nia2-20": {
          "path": "res://assets/languages/de/audio/nia2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1e77aff504f5c998f8f485f67b935ac7df1b063e7f84672e1e1d614339474027",
          "text": "Warum denkst du, dass ich Veronica heiÃŸe?",
          "source_text": "What makes you think my name is Veronica?",
          "transcription_review_required": false
        },
        "nia2-20h": {
          "path": "res://assets/languages/de/audio/nia2-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "69ad0705def4b153d59f1b24c6b949ec54f53cfda82d9624dcfd2592a3ba01c2",
          "text": "Oh, du dachtest, Nika wÃ¤re die AbkÃ¼rzung fÃ¼r Veronica. Eigentlich ist es die AbkÃ¼rzung fÃ¼r Monica.",
          "source_text": "Oh, you thought Nika was short for Veronica. Actually, it's short for Monica.",
          "transcription_review_required": false
        },
        "nia2-21a": {
          "path": "res://assets/languages/de/audio/nia2-21a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b41bee56f23edbc78b3bc238440c48b150e42b79f9e40793ac7727d2df4c7bb8",
          "text": "Dann sind Sie bei uns an der richtigen Person.",
          "source_text": "Well, you came to the right person.",
          "transcription_review_required": false
        },
        "nia2-21b": {
          "path": "res://assets/languages/de/audio/nia2-21b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3f063cbc44f3db5d420c327279691e206e9f6d0735a6920de1eff61a988c6343",
          "text": "Ich recherchiere alle MÃ¤dchen auf dem Campus, um herauszufinden, von welchen High Schools sie kommen. Glauben Sie mir, es gibt keine Veronica.",
          "source_text": "I'm doing research on all the girls on campus to check which high schools they came from. Believe me, there is no Veronica.",
          "transcription_review_required": false
        },
        "nia2-30": {
          "path": "res://assets/languages/de/audio/nia2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "97fb8dabde0e3c7df9628a622c33ea4e74bf4f35526d703d7d74f987d814420d",
          "text": "Ja, ich war einfach da. Was hast du gefunden?",
          "source_text": "Yeah, I was just there. What did you find?",
          "transcription_review_required": false
        },
        "nia2-30h": {
          "path": "res://assets/languages/de/audio/nia2-30h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af67e777930396e01e37772a6996c2dc0ff505a3777c758cf9c9a387e6b918b7",
          "text": "Sie gehÃ¶ren nicht mir. Ich schneide nicht, wÃ¤hrend ich meine Probanden interviewe.",
          "source_text": "They're not mine. I don't do any cutting while interviewing my subjects.",
          "transcription_review_required": false
        },
        "nia2-31": {
          "path": "res://assets/languages/de/audio/nia2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1c68bcdbe43e685c1fe86e86bb20b9826088b84865d9965f426c02583f1101dc",
          "text": "Ich Ã¼berprÃ¼fe verschiedene Gymnasien, um zu sehen, wie viel Prozent ihrer weiblichen SchÃ¼ler eine hÃ¶here Ausbildung absolvieren. Ich interviewe alle MÃ¤dchen auf dem Campus.",
          "source_text": "I'm checking different high schools to see what percentage of their women's students continue on to higher education. I'm interviewing all the girls on campus.",
          "transcription_review_required": false
        },
        "nia2-32": {
          "path": "res://assets/languages/de/audio/nia2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0ebdb820035332f448c5858b1c30e9b883ae4661c9c5d03fd51e2a61f07dbd96",
          "text": "Nicht heute, aber jetzt, wo Sie es erwÃ¤hnen, habe ich gesehen, wie Susan, das MÃ¤dchen aus Photoshop, auf seltsame Weise den Korridor auf und ab ging.",
          "source_text": "Not today, but now that you mention it, I did see Susan, the girl from the Photoshop, walking up and down the corridor in a funny sort of way.",
          "transcription_review_required": false
        },
        "nia2-h": {
          "path": "res://assets/languages/de/audio/nia2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f9a86aaa99c835a9604191e39cd79c18a3b4267f3a29b6b3b6b3a4c0314ecb99",
          "text": "Ich muss ehrlich zu Ihnen sein. Blumen sind mir gleichgÃ¼ltig.",
          "source_text": "I have to be frank with you. I'm indifferent to flowers.",
          "transcription_review_required": false
        },
        "nib1-01": {
          "path": "res://assets/languages/de/audio/nib1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a054d78265bf3fc346ac02a6c0a8fdcdea927ecc6d78b8f88160edc1c9d5f320",
          "text": "Okay, der Film ist weg und Ihr Meeting wird mÃ¶glicherweise abgesagt.",
          "source_text": "Okay, so the film is gone and your meeting might be canceled.",
          "transcription_review_required": false
        },
        "nib1-02": {
          "path": "res://assets/languages/de/audio/nib1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8425a14b55d4b2cb88423cce9cd3bc794606e4b44c5ba702ad74afa32f129cef",
          "text": "Einen Moment, ich muss Jimmy eine Nachricht hinterlassen, dass sein Treffen mÃ¶glicherweise abgesagt wird.",
          "source_text": "Just a minute, I need to leave Jimmy a note saying that his meeting might be cancelled.",
          "transcription_review_required": false
        },
        "nib1-03": {
          "path": "res://assets/languages/de/audio/nib1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7c1a64cabb7b76a9d003880aed629e7ed8fbde7a6078d8c7d8e06cc1a65a63c0",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nib1-04": {
          "path": "res://assets/languages/de/audio/nib1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d647b97698daae3181b6c056ae2a79416cc5bdc18b4fae901c62b82e50161cd4",
          "text": "Ich hÃ¤tte fast vergessen, Jimmy eine Nachricht Ã¼ber das MÃ¤dchen zu schreiben, das angerufen hat, um das Treffen abzusagen.",
          "source_text": "I almost forgot to write Jimmy a note about that girl who called to cancel the meeting.",
          "transcription_review_required": false
        },
        "nib1-10": {
          "path": "res://assets/languages/de/audio/nib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6526e017a773e3ed9612adf9e27fc09bca7aff4846804c3df4b1af2913515f30",
          "text": "Warum fragst du? Hast du eine Geschichte fÃ¼r ihn? Vielleicht kann ich dir helfen.",
          "source_text": "Why do you ask? Do you have a story for him? Maybe I can help you.",
          "transcription_review_required": false
        },
        "nib1-11": {
          "path": "res://assets/languages/de/audio/nib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7915f3d3b9604d43a03522ea499cfa994597114f731ef0e4c9e738ca5e43df27",
          "text": "Glaubst du, ich bin seine SekretÃ¤rin? Wenn ich ein Mann wÃ¤re, wÃ¼rde ich eine Million Dollar wetten, wÃ¼rden Sie annehmen, ich sei ein Reporter.",
          "source_text": "Do you think I'm his secretary? Now if I were as a man, I'd bet you a million dollars you'd assume I was a reporter.",
          "transcription_review_required": false
        },
        "nib1-12": {
          "path": "res://assets/languages/de/audio/nib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3ff2ca5a63e85fe1c63f8949ec90ecd53626b0e33c958725f05aedc8c6d70cfc",
          "text": "Das spricht sich in dieser Stadt schnell herum, oder? Er hat ein Treffen mit einem MÃ¤dchen, das ihm Beweise fÃ¼r eine Umweltkatastrophe in Philips Chemiefabrik liefern soll.",
          "source_text": "Word gets around fast in this town, huh? He's got a meeting with some girl who's supposed to give him evidence of an ecological disaster at Philip's chemicals.",
          "transcription_review_required": false
        },
        "nib1-20": {
          "path": "res://assets/languages/de/audio/nib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3aabb148c34a9c09e244cc9b1bdf83535c8d227e2df251b08519cee22e6fca8b",
          "text": "Wow, du hast Ohren wie ein Elefant! Das war das anonyme MÃ¤dchen, das die Notiz geschrieben hat. Sie sagte, dass der Film verschwunden sei. Kein Wunder. Es gibt viele Menschen, die Jimmy davon abhalten wollen, bei einem potenziellen Skandal eine gute Spur zu bekommen.",
          "source_text": "Wow, you've got ears like an elephant! That was the anonymous girl who wrote the note. She said that the film has disappeared. It's no wonder. There are many people who'd want to prevent Jimmy from getting a good lead on a potential scandal.",
          "transcription_review_required": false
        },
        "nib1-21": {
          "path": "res://assets/languages/de/audio/nib1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8a7357863d497661723e98733cdf15f9246e1c1ce07e4590aaf119d095724b39",
          "text": "Zum Beispiel Rick vom Musikladen. Wenn Sie verstehen, was ich meine, hat Jimmy eine nicht so positive Rezension Ã¼ber seine Musik geschrieben. Und reden wir gar nicht erst Ã¼ber all seine Ex-Freundinnen, die Groll gegen ihn hegen.",
          "source_text": "For instance, Rick from the music store. Jimmy wrote a not-so-positive review about his music if you get what I'm saying. And let's not even begin to talk about all his ex-girlfriends who hold grudges against him.",
          "transcription_review_required": false
        },
        "nib1-22": {
          "path": "res://assets/languages/de/audio/nib1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "898c0956a9715fdd134f7fa9da59b0fc63c41e7a1ce4b55dc53d2f7c2660b12d",
          "text": "Was denken Sie? Auf so einen KnÃ¼ller wartet er schon seit Jahren. HÃ¤tte ich diese Geschichte nur vor ihm in die HÃ¤nde bekommen.",
          "source_text": "What do you think? He's been waiting for a scoop like this for years. If only I had laid my hands on that story before him.",
          "transcription_review_required": false
        },
        "nib1-30": {
          "path": "res://assets/languages/de/audio/nib1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "658a20ca77e05583d15edab704c7f18d1f35a82303a5300694d7a2c848d06152",
          "text": "Alice, wer ist Alice? Oh, du meinst Sheila.",
          "source_text": "Alice, who's Alice? Oh, you mean Sheila.",
          "transcription_review_required": false
        },
        "nib1-31": {
          "path": "res://assets/languages/de/audio/nib1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "75a3d966dcecfbd201c309fc908d5b0a548611d391faee4dd28f9e9e5f6cd787",
          "text": "Sheila Phillips, seine am Boden zerstÃ¶rte Ex. Es ist eine Woche her und sie ist immer noch nicht Ã¼ber ihn hinweg.",
          "source_text": "Sheila Phillips, his devastated ex. It's been a week and she's still not over him.",
          "transcription_review_required": false
        },
        "nib1-32": {
          "path": "res://assets/languages/de/audio/nib1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "104f3be7d51766a71096445eab3ec3b6f5b1ded4558b8a364fad95f0a14139d0",
          "text": "Naja, sind wir das nicht alle, aber egal, nein, ich kenne deine Alice nicht.",
          "source_text": "Well, aren't we all, but anyway, no, I don't know your Alice.",
          "transcription_review_required": false
        },
        "nib2-01": {
          "path": "res://assets/languages/de/audio/nib2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1c177f6a474b42313bb91638b41e8d26b97c5f63de7ac8a418a37ae47e9b94ee",
          "text": "Ich bin sehr beschÃ¤ftigt. Ich habe morgen einen Abgabetermin fÃ¼r die Titelseite.",
          "source_text": "I'm really busy. I have a front page deadline for tomorrow.",
          "transcription_review_required": false
        },
        "nib2-02": {
          "path": "res://assets/languages/de/audio/nib2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "370f257079177f353a462103e4500f7e44e8e0aeb5ab5b3b9450abb4f9d00688",
          "text": "Ich bin beschÃ¤ftigt. Ich muss einen Artikel schreiben.",
          "source_text": "I'm busy. I have an article to write.",
          "transcription_review_required": false
        },
        "nib2-03": {
          "path": "res://assets/languages/de/audio/nib2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "560f0016e36a9f0d343d6963845404c611705f9ac816c2aedd96aed1d563e135",
          "text": "Frieden.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nib2-10": {
          "path": "res://assets/languages/de/audio/nib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "940760754abd11d42d590a20019aca05902c3fddc93ffd9ec632b6591af6ac3e",
          "text": "Warum fragst du?",
          "source_text": "Why do you ask?",
          "transcription_review_required": false
        },
        "nib2-10h": {
          "path": "res://assets/languages/de/audio/nib2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "25ce964dcad14b145fa62fc8d31f721aa2b2394b86e3d1f890e51f6c1daf7b6a",
          "text": "Ist das ein Witz? Kannst du nicht sehen, dass ich meine Brille trage?",
          "source_text": "Is this a joke? Can't you see I'm wearing my glasses?",
          "transcription_review_required": false
        },
        "nib2-20": {
          "path": "res://assets/languages/de/audio/nib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c26357c3ac0aae4f9b149c8a9a71ee8198971cd3968e3d418c32e1c8cc466cd7",
          "text": "Ein Artikel Ã¼ber diese Rallye, die wir organisieren. Frauen fÃ¼r die ERA. Es wird wild. Wir werden die Welt verÃ¤ndern. Du solltest auch kommen.",
          "source_text": "An article about this rally we're organizing. Women for the ERA. It's going to be wild. We're going to change the world. You should come, too.",
          "transcription_review_required": false
        },
        "nib2-21": {
          "path": "res://assets/languages/de/audio/nib2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7ef24c17dd730e7dbf10004a3ee4b44de0ab1563548c099adac76780a96e72e1",
          "text": "Sicher.",
          "source_text": "Sure.",
          "transcription_review_required": false
        },
        "nib2-22": {
          "path": "res://assets/languages/de/audio/nib2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "78478a19e81a30803820f738093fe56802037f92103b29347622827f01ecd805",
          "text": "Es ist zwei Blocks von hier entfernt auf der rechten Seite.",
          "source_text": "It's two blocks from here on your right.",
          "transcription_review_required": false
        },
        "nib2-30": {
          "path": "res://assets/languages/de/audio/nib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "afc5082a4e0b6f0e64a19b5bf14ceab70c64c40d764332dfdae90f66f7c28dd3",
          "text": "Was meinst du damit, wie bin ich darauf gekommen? DafÃ¼r habe ich hart gearbeitet. Als Frau muss ich noch hÃ¤rter arbeiten. Sie geben mir nie Hinweise.",
          "source_text": "What do you mean, how did I get it? I worked hard for that. As a woman, I have to work even harder. They never give me any leads.",
          "transcription_review_required": false
        },
        "nib2-30m": {
          "path": "res://assets/languages/de/audio/nib2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "92198579c2c10b1c69630a0b9babe6db157ddb44416dadfcb24d1d664ff14815",
          "text": "Wird Martin Luther King ermordet? Hey, woher hast du diese Informationen? Sind Sie vom FBI?",
          "source_text": "Martin Luther King will be assassinated? Hey, where did you get this information? Are you from the FBI?",
          "transcription_review_required": false
        },
        "nil-01": {
          "path": "res://assets/languages/de/audio/nil-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1f6bee3b01dd179ae89f86cc18bcc3f204ad49324f5688984b89033cc994f955",
          "text": "Was bringt Sie auf die Idee, dass ich schuldig bin?",
          "source_text": "What gives you the idea that I'm guilty?",
          "transcription_review_required": false
        },
        "nil-02": {
          "path": "res://assets/languages/de/audio/nil-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "afc794a7a3e68e6703a67f03748f7b54ab1893d2017edbd6fe6640e6878d93fa",
          "text": "Das ist nicht meins.",
          "source_text": "This is not mine.",
          "transcription_review_required": false
        },
        "nil-03": {
          "path": "res://assets/languages/de/audio/nil-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "77adceea5e62f8255862207333218c780a261c547f4fc4e315282c1374489833",
          "text": "Also...",
          "source_text": "So...",
          "transcription_review_required": false
        },
        "nil-04": {
          "path": "res://assets/languages/de/audio/nil-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "23a8e2a9bbaffe688317bb54cb71844e930cb70d30c32cd220c6793ca36e49f5",
          "text": "Endlich ist es schÃ¶n zu sehen, dass auch Frauen Forschungsstipendien erhalten. Ich bin stolz auf sie.",
          "source_text": "At last, it's good to see women receiving research scholarships, too. I'm proud of her.",
          "transcription_review_required": false
        },
        "nil-05": {
          "path": "res://assets/languages/de/audio/nil-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e28d841045f34f415df181bbeb905c7fc252cdcae6632510b144ca46093ada44",
          "text": "Wie Sie sehen, habe ich meine Kleider nie gekÃ¼rzt.",
          "source_text": "As you can see, I never shortened my dresses.",
          "transcription_review_required": false
        },
        "nil-06": {
          "path": "res://assets/languages/de/audio/nil-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "573e576c2ab815e9518b3548555d3abafbc49b4085c2c8060e036647cb492eab",
          "text": "Okay, also ich war es. Ich gebe zu, dass ich diesen Klatschartikel geschrieben habe. Was kann ich tun? Ich muss hier auch die Drecksarbeit erledigen.",
          "source_text": "Okay, so it was me. I admit I wrote that gossipy article. What can I do? I have to do the dirty work around here, too.",
          "transcription_review_required": false
        },
        "nil-07": {
          "path": "res://assets/languages/de/audio/nil-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "866fe37cf609dadddc1576217f6e1a784f84ebe26f0fd6f7570a9c2b0d298bfd",
          "text": "Mit diesen unzuverlÃ¤ssigen BlÃ¤ttern wird man es als Journalist nie schaffen.",
          "source_text": "You'll never make it as a journalist with those unreliable leaves.",
          "transcription_review_required": false
        },
        "nila-01": {
          "path": "res://assets/languages/de/audio/nila-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "edda9a5950813872947851c322c11692c68bb85baf323e990334236802fb4725",
          "text": "Sie haben eine sehr gute Detektivarbeit geleistet. Oh, wenn nur Frauen die Welt regieren wÃ¼rden, wÃ¤re es ein besserer Ort.",
          "source_text": "You did some very good detective work. Oh, if only women ruled the world it would be a better place.",
          "transcription_review_required": false
        },
        "nilb-01": {
          "path": "res://assets/languages/de/audio/nilb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b77df1c865ddfc5920a35e0e70b2b79623c0d83e2884c9a0009b1ed6a1e65e68",
          "text": "Ich wusste, dass du den Job schaffen wÃ¼rdest. Du bist eine Frau, nicht wahr?",
          "source_text": "I knew you'd get the job done. You're a woman, aren't you?",
          "transcription_review_required": false
        },
        "jsua2-20": {
          "path": "res://assets/languages/de/audio/jsua2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4c7cda807b0d0a59300e01574da16396babcbeace73f15cd8a020d0b0aee8813",
          "text": "Kennen Sie Jimmy Mackenzie?",
          "source_text": "Do you know Jimmy Mackenzie?",
          "transcription_review_required": false
        },
        "jsua2-21": {
          "path": "res://assets/languages/de/audio/jsua2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "76b209306f2241aec2deeebf81bb88ae557721e53dafd2c3431cd2c58241d100",
          "text": "Jimmy ist nicht dein Geschmack? Ich dachte, er wÃ¤re jedermanns Geschmack.",
          "source_text": "Jimmy's not your taste? I thought he was everyone's taste.",
          "transcription_review_required": false
        },
        "jsua2-22": {
          "path": "res://assets/languages/de/audio/jsua2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fd319acbade465283919112708bf097b093bf78b6229aebc220f5ec73cecc88d",
          "text": "Was ist Ihr Geschmack?",
          "source_text": "What is your taste?",
          "transcription_review_required": false
        },
        "jsua2-30": {
          "path": "res://assets/languages/de/audio/jsua2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "97e5eb101059cb2396ce1be7e7dd02746b0f7d721bca5e221f4678fe8c73eae1",
          "text": "Susan, wÃ¼rdest du eines von Alices Kleidern tragen?",
          "source_text": "Susan, would you wear one of Alice's dresses?",
          "transcription_review_required": false
        },
        "jsua2-40": {
          "path": "res://assets/languages/de/audio/jsua2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b415dd658a62f0e70a8a62af3d675da16833c4ec16318d6878d7c5cdac426a45",
          "text": "Ich liebe dein Kleid. Wo kaufen Sie ein?",
          "source_text": "I love your dress. Where do you do your shopping?",
          "transcription_review_required": false
        },
        "jsub2-10": {
          "path": "res://assets/languages/de/audio/jsub2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ebfe29128ff4a61ccd72bc9c60b657efeb752612f3acff7af9e56de918e75422",
          "text": "Kennen Sie jemanden mit den Initialen SP?",
          "source_text": "Do you know anyone with the initials SP?",
          "transcription_review_required": false
        },
        "jsub2-20": {
          "path": "res://assets/languages/de/audio/jsub2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "97c20b7226fdf998a4f8fc214c2bb42911b494a850279771feefbe959bb2e1c1",
          "text": "Kennen Sie Alice Kaplan?",
          "source_text": "Do you know Alice Kaplan?",
          "transcription_review_required": false
        },
        "jsub2-21": {
          "path": "res://assets/languages/de/audio/jsub2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b17a4d45e2637bc5932b28bbe8db85394a1a347ec8cae1794e327e66093dc76",
          "text": "WÃ¼rdest du mit jemandem ausgehen, mit dem Alice ausgeht?",
          "source_text": "Would you go out with someone who Alice dates?",
          "transcription_review_required": false
        },
        "jsub2-22": {
          "path": "res://assets/languages/de/audio/jsub2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6410f506decdc486e067c87a320e4ffc82da844e8540046adfd2321c95ba504d",
          "text": "Wissen Sie etwas Ã¼ber die Absage von Alices Treffen?",
          "source_text": "Do you know anything about Alice's meeting being canceled?",
          "transcription_review_required": false
        },
        "jsub2-30": {
          "path": "res://assets/languages/de/audio/jsub2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1d140948be3b55d12da684bc040a5e6b4be7a089dae61d00fbf947577b399fb2",
          "text": "Welches Lied lief da im Radio?",
          "source_text": "What song was that playing on the radio?",
          "transcription_review_required": false
        },
        "jsub2-40": {
          "path": "res://assets/languages/de/audio/jsub2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4d16d77928fd31c5a3da22cff87fb1ce3ce0365828610565893ac7398d5ebf4e",
          "text": "Du hast eine tolle Stimme. Hast du jemals darÃ¼ber nachgedacht, einer Band beizutreten?",
          "source_text": "You have a great voice. Did you ever think of joining a band?",
          "transcription_review_required": false
        },
        "sua1-01": {
          "path": "res://assets/languages/de/audio/sua1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "45538b5eca9fc4c47e12e38ef47a8b6c828bf120c8a111a8e8bc035098f40a8f",
          "text": "Nur eine Minute!",
          "source_text": "Just a minute!",
          "transcription_review_required": false
        },
        "sua1-02": {
          "path": "res://assets/languages/de/audio/sua1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bbd7ce7607f440b484966bd3b252a2227931e7b0261a61e74353d129b860e3d5",
          "text": "Ich komme! Kennst du die grÃ¼ne Tasche, die Alice hat? Nun, ich habe genau so eins.",
          "source_text": "I'm coming! You know that green bag Alice has? Well, I got one just like it.",
          "transcription_review_required": false
        },
        "sua1-03": {
          "path": "res://assets/languages/de/audio/sua1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ffafc61e9283a09d49dbb41674ef1b01ffa73ae50c8ec2e2d90f12a592ee0c81",
          "text": "Bitte lassen Sie Ihren Film auf dem Schreibtisch und tragen Sie Ihren Namen in das Entwicklungsblatt ein.",
          "source_text": "Please leave your film on the desk and fill in your name on the development sheet.",
          "transcription_review_required": false
        },
        "sua2-01": {
          "path": "res://assets/languages/de/audio/sua2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "61b40d97cbb372e350972f5dc42f574dd38c3b44d4ea0435c147fc75ee3a1214",
          "text": "Hallo, ich bin Susan. Wie kann ich dir helfen?",
          "source_text": "Hi, I'm Susan. How can I help you?",
          "transcription_review_required": false
        },
        "sua2-02": {
          "path": "res://assets/languages/de/audio/sua2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8d009a5eec86d90260863b7725faeca28c9c22ec081b3882e370c5645ad5ca11",
          "text": "Oh, ich hoffe, sie hat meine Notiz nicht gelesen.",
          "source_text": "Oh, I hope she didn't read my note.",
          "transcription_review_required": false
        },
        "sua2-03": {
          "path": "res://assets/languages/de/audio/sua2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8d009a5eec86d90260863b7725faeca28c9c22ec081b3882e370c5645ad5ca11",
          "text": "Oh, ich hoffe, sie hat meine Notiz nicht gelesen.",
          "source_text": "Oh, I hope she didn't read my note.",
          "transcription_review_required": false
        },
        "sua2-10": {
          "path": "res://assets/languages/de/audio/sua2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e7929f4e8b282f577f05666c6ed953c939513736f7ba4032e6faad5d75a738dd",
          "text": "Hast du einen Blick auf meine persÃ¶nliche Notiz geworfen? Mein Privatleben ist sehr privat.",
          "source_text": "Did you peek at my personal note? My private life is very private.",
          "transcription_review_required": false
        },
        "sua2-20b": {
          "path": "res://assets/languages/de/audio/sua2-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7da5e273e22852727edabc0c9e74580d8c0981872407fc3d99712902f129196c",
          "text": "Ich habe von ihm gehÃ¶rt. Viele MÃ¤dchen hier auf dem Campus sind in ihn verliebt. PersÃ¶nlich ist er nicht mein Geschmack.",
          "source_text": "I've heard about him. A lot of girls here on campus are in love with him. Personally, he's not my taste.",
          "transcription_review_required": false
        },
        "sua2-21": {
          "path": "res://assets/languages/de/audio/sua2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d0b47c98c8a928c5fb5cef4631acc093f09e94e91b8125a130646b3ca376ab6d",
          "text": "Ist einer dieser beliebten Typen? Heutzutage versuche ich, mich von solchen Typen fernzuhalten. In der High School war ich in einen beliebten Mann verliebt und hÃ¤tte dadurch fast meinen besten Freund verloren.",
          "source_text": "Is one of those popular guys? Nowadays, I try to stay away from those types. In high school, I was in love with a popular guy, and it almost cost me my best friend.",
          "transcription_review_required": false
        },
        "sua2-22": {
          "path": "res://assets/languages/de/audio/sua2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "874583276f363b41e3c9468caa604497312e0697f37777352478f17f94ffc13e",
          "text": "Jemand, der seine Arbeit sehr ernst nimmt und engagiert ist, so engagiert, dass er nicht einmal den Kopf hebt, um mich anzusehen.",
          "source_text": "Someone who is very serious and committed to his work, so committed that he doesn't even lift his head to look at me.",
          "transcription_review_required": false
        },
        "sua2-30a": {
          "path": "res://assets/languages/de/audio/sua2-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "65ecc78bd4da743ebf5c2f67d9ae68ddbdfb4e1d9122b270025b8c3c2c5ca38b",
          "text": "Alices Kleider? Nein. Ihre grÃ¼ne Tasche, ja. Ihr blauer GÃ¼rtel, klar. Oh, ich wÃ¼nschte, ich kÃ¶nnte ihre Kleider tragen, aber ich habe nicht ihre Figur.",
          "source_text": "Alice's dresses? No. Her green bag, yes. Her blue belt, sure. Oh, I wish I could wear her dresses, but I don't have her figure.",
          "transcription_review_required": false
        },
        "sua2-30c": {
          "path": "res://assets/languages/de/audio/sua2-30c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "53ee4338161222a838d57a23c3961df7d9cd005777aa24a0ebe28f07905d1969",
          "text": "Und ich habe nicht ihr seidig glattes Haar.",
          "source_text": "And I don't have her silky straight hair.",
          "transcription_review_required": false
        },
        "sua2-30m": {
          "path": "res://assets/languages/de/audio/sua2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "35166eed9bd5db5c2e47117d5043787db44d897a587eddbda26a1b385f92d376",
          "text": "Wow, weit drauÃŸen. Ich brauche mein BÃ¼geleisen nicht mehr.",
          "source_text": "Wow, far out. I don't need my iron anymore.",
          "transcription_review_required": false
        },
        "sua2-40": {
          "path": "res://assets/languages/de/audio/sua2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "58c1f6b8cb28dee0f0925c82366a63dc650c2b2bbecfb50ed006cde6ea680b94",
          "text": "Und Sheilas Boutique? Sie hat dort umwerfende Dinge, wie das Perlenkleid, das Alice hat. Aber das gibt es nicht in meiner GrÃ¶ÃŸe.",
          "source_text": "And Sheila's boutique? She's got mind-blowing things there, like the beaded dress Alice has. But that doesn't come in my size.",
          "transcription_review_required": false
        },
        "sua2-h": {
          "path": "res://assets/languages/de/audio/sua2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1b70f2aea0fd3e9bcf7aefe4211d6a1b228f293bab9fc461c185798e227daf8a",
          "text": "Hey, kannst du das bitte von mir wegschieben? Ich bin allergisch gegen Sonnenblumen.",
          "source_text": "Hey, can you please move that away from me? I'm allergic to sunflowers.",
          "transcription_review_required": false
        },
        "sub1-01": {
          "path": "res://assets/languages/de/audio/sub1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fad4821804269e0c8be6a6b958150413b9310cb56a13f43a31f03f865ba4e390",
          "text": "Ich werde da sein, es ist nicht das Ende der Welt. Du wirst jemanden finden, der besser fÃ¼r dich ist.",
          "source_text": "I'll be there, it's not the end of the world. You'll find someone who's better for you.",
          "transcription_review_required": false
        },
        "sub1-03": {
          "path": "res://assets/languages/de/audio/sub1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6590f708f22ef6ebcc73a14011a117479e5a23b2f039514b374da0786e579f19",
          "text": "Lassen Sie den Film einfach auf der Theke liegen und tragen Sie Ihren Namen und Ihre Adresse in das Entwicklungsblatt ein.",
          "source_text": "Just leave the film on the counter and fill in your name and address on the development sheet.",
          "transcription_review_required": false
        },
        "sub2-01": {
          "path": "res://assets/languages/de/audio/sub2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b7516df5a06afd883300fe4c76970a2621b7eb4414b5d8aa254628ae8429d79e",
          "text": "Was fÃ¼r ein cooles Lied. Diese Worte kann ich wirklich nachvollziehen.",
          "source_text": "What a cool song. Those words I can really relate.",
          "transcription_review_required": false
        },
        "sub2-02": {
          "path": "res://assets/languages/de/audio/sub2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "104da723bed6012076abac1f2e6084f3a4bbca6699a378cbfa75a697028b24cf",
          "text": "Niemand sollte das sehen.",
          "source_text": "Nobody should see this.",
          "transcription_review_required": false
        },
        "sub2-03": {
          "path": "res://assets/languages/de/audio/sub2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e0824e8e598fdc4101599864793447db9332c653643b7029b54730270ef4a2dc",
          "text": "Ich hoffe, sie kann meine Notiz nicht lesen.",
          "source_text": "I hope she can't read my note.",
          "transcription_review_required": false
        },
        "sub2-04": {
          "path": "res://assets/languages/de/audio/sub2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "709da4188030db32220ab362f918648ff6c92abca5c258ae8e3e557be255d58d",
          "text": "Entschuldigung, wir haben geschlossen.",
          "source_text": "Sorry, we're closed.",
          "transcription_review_required": false
        },
        "sub2-10": {
          "path": "res://assets/languages/de/audio/sub2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "83f58751a823a047f8b36ee4e69ccfb614da35eca0d2f615061748b92bf6ae2c",
          "text": "SP? Nein. Warte. Du hast auf meine Notiz geschaut. Es ist persÃ¶nlich.",
          "source_text": "SP? No. Wait. You looked at my note. It's personal.",
          "transcription_review_required": false
        },
        "sub2-20a": {
          "path": "res://assets/languages/de/audio/sub2-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8eb0de55001ec29bff1251359194a4d91871c4964aaac532e3fbd7a9fb2c4644",
          "text": "NatÃ¼rlich kenne ich Alice. Wow, sie ist so weit drauÃŸen.",
          "source_text": "Sure I know Alice. Wow, she's so far out.",
          "transcription_review_required": false
        },
        "sub2-20b": {
          "path": "res://assets/languages/de/audio/sub2-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "55e384419786b6e5f6f6b8154bf898b7c3ecd7e233d22c73b4a19c1d52d5a0d8",
          "text": "Sie hat diese ganze PersÃ¶nlichkeit. Was fÃ¼r ein wunderschÃ¶ner Sterblicher. Jungs sind von ihr verzaubert.",
          "source_text": "She's got this whole personality. What a beautiful mortal. Guys are enchanted by her.",
          "transcription_review_required": false
        },
        "sub2-21": {
          "path": "res://assets/languages/de/audio/sub2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0d04984f0bc59029825790ebed5350c215a0b6156d3811fe1ec25f0d415a9998",
          "text": "Mich? Ich wÃ¼nsche. Aber ich glaube nicht, dass die Alice-Dates des Kerls Lust hÃ¤tten, mit mir auszugehen.",
          "source_text": "Me? I wish. But I don't think the guy's Alice dates would want to go out with me.",
          "transcription_review_required": false
        },
        "sub2-22": {
          "path": "res://assets/languages/de/audio/sub2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "71b8586d379de336df2cbdef321dacdeeb11bddb672a521ca903ee494ad2bc0a",
          "text": "Abgesagt? Bist du sicher? Ich sollte doch nichts von diesem Treffen wissen, oder?",
          "source_text": "Cancelled? Are you sure? I'm not supposed to know anything about this meeting, am I?",
          "transcription_review_required": false
        },
        "sub2-30a": {
          "path": "res://assets/languages/de/audio/sub2-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d255c9467e0060e42bf4cffd18771ee29ae0b60b29e259044a7a3f17b2404932",
          "text": "Und bringt Sie zu Ihrem Platz am Fluss.",
          "source_text": "And takes you down to your place by the river.",
          "transcription_review_required": false
        },
        "sub2-30b": {
          "path": "res://assets/languages/de/audio/sub2-30b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "20a8dd5547996ec6c9d60396b23e70660e03c3adfbae6c23586c7b7dcc021a06",
          "text": "Es ist Susan von Leonard Cohen.",
          "source_text": "It's Susan, by Leonard Cohen.",
          "transcription_review_required": false
        },
        "sub2-40": {
          "path": "res://assets/languages/de/audio/sub2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d02fbab0132c82e6cd058844823895655e8178892a44eb853d71899e15a33ea8",
          "text": "Eine Band? Ich bin nicht wirklich der Typ. Ich neige dazu, Dinge zu ruinieren. Wenn ich auf die BÃ¼hne kÃ¤me, wÃ¼rde sie wahrscheinlich einstÃ¼rzen. Erst diese Woche habe ich hier drei Kameras kaputt gemacht.",
          "source_text": "A band? I'm not really the type. I tend to ruin things. If I got up on the stage, it would probably cave in. Just this week, I broke three cameras here.",
          "transcription_review_required": false
        },
        "sub2-40m": {
          "path": "res://assets/languages/de/audio/sub2-40m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8d4596bb8fc75bceea61f33ac9e0340f2f0a143cd941e52f4e7fa88878ff1b8a",
          "text": "Ruby, ist das wirklich nur ein einziges Mal? Ich kann es also wirklich nicht zerstÃ¶ren!",
          "source_text": "Ruby, is this really just for one time only? So I really can't destroy it!",
          "transcription_review_required": false
        },
        "sub2-s2": {
          "path": "res://assets/languages/de/audio/sub2-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e3ca5ec5b170964b37d7928f12adbe7ec8afca7f21b61a43e562bc7509213174",
          "text": "Es ist gut, dass ich die Notiz zerrissen habe.",
          "source_text": "It's a good thing I tore up the note.",
          "transcription_review_required": false
        },
        "sub2-s3": {
          "path": "res://assets/languages/de/audio/sub2-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e3950a154371d5647beed7751b9841cf48477f0da4c47c3c55ec0f61d3e60252",
          "text": "Wow! Sie konnte die Notiz vom Block aus reproduzieren.",
          "source_text": "Wow! She was able to reproduce the note from the pad.",
          "transcription_review_required": false
        },
        "sul-01": {
          "path": "res://assets/languages/de/audio/sul-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d6cea63f6e47af17e27d216409ff78e6a6d9c025f0b5f93f5cdbdfc56657bd7d",
          "text": "Glaubst du, ich bin es? Oh mein Gott, warum?",
          "source_text": "You think it's me? Oh my gosh, why?",
          "transcription_review_required": false
        },
        "sul-02": {
          "path": "res://assets/languages/de/audio/sul-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "acbfcdc321139e7270d95b8750ab44675227bd9795692bd8046716883b70e5dd",
          "text": "Aber warum sollte ich mir selbst eine Notiz schreiben?",
          "source_text": "But why would I write a note to myself?",
          "transcription_review_required": false
        },
        "sul-03": {
          "path": "res://assets/languages/de/audio/sul-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "74d38f8dfdf41c028fe8d64496785e9dde5821de5c8e279e58548e6cb55fbbe1",
          "text": "Das hat nichts mit mir zu tun.",
          "source_text": "This has nothing to do with me.",
          "transcription_review_required": false
        },
        "sul-04": {
          "path": "res://assets/languages/de/audio/sul-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "24f9d8fb031ea5722aad03a286eb4271e1b47ae2e3ee908196a5f264e08871b2",
          "text": "Das beweist nicht, dass ich es bin!",
          "source_text": "That doesn't prove it's me!",
          "transcription_review_required": false
        },
        "sul-05": {
          "path": "res://assets/languages/de/audio/sul-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d822485cc3df86d990e128f60ddd3d262c2efd2054595b897c3dbb8bf349e445",
          "text": "Alice ist so talentiert. Ich wÃ¼nschte, ich kÃ¶nnte genau wie sie sein.",
          "source_text": "Alice is so talented. I wish I could be just like her.",
          "transcription_review_required": false
        },
        "sul-06": {
          "path": "res://assets/languages/de/audio/sul-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1247eff80801371219603ab20a90252dd62ab6e97b840608847ff0f38e0a28cb",
          "text": "Es gibt ein Gesetz, das das Schreiben von Briefen an alte Freunde verbietet.",
          "source_text": "Law against writing letters to old friends is there.",
          "transcription_review_required": false
        },
        "sul-07": {
          "path": "res://assets/languages/de/audio/sul-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3f91649c25851cef47732ed0b4e166fc92c5928ca49238ff40edf66e494ed18f",
          "text": "Als nÃ¤chstes gehen Sie herum und beschuldigen unschuldige Menschen. Einige von uns sind sehr empfindlich und so etwas kÃ¶nnte uns jahrelang verfolgen.",
          "source_text": "It's next there that you go around accusing innocent people. Some of us are very sensitive, and something like this could haunt us for years.",
          "transcription_review_required": false
        },
        "sula-01": {
          "path": "res://assets/languages/de/audio/sula-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "45cd094b8103a3640445a7bd837d63dd1b15e5080a19e2d483617a2e2dd6577c",
          "text": "Dorothy, ich kann nicht glauben, dass sie so etwas tun wÃ¼rde! Ich denke, das Leben in einer GroÃŸstadt hat auch ihren Tribut gefordert.",
          "source_text": "Dorothy, I can't believe she'd do a thing like that! I guess living in a big city has taken its toll on her, too.",
          "transcription_review_required": false
        },
        "sulb-01": {
          "path": "res://assets/languages/de/audio/sulb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1e8ee5b4425f3e31cc21df2c98f00644fe39864be7a8ba11a357b061ab1f6320",
          "text": "Ich kann nicht glauben, dass es Rick ist. Er ist so eine sanfte Seele. Ich bin sicher, er hat es aus Liebe getan. Ich wÃ¼nschte, jemand wÃ¼rde mich so lieben.",
          "source_text": "I can't believe it's Rick. He's such a gentle soul. I'm sure he did it out of love. I wish someone would love me like that.",
          "transcription_review_required": false
        },
        "dyab-01": {
          "path": "res://assets/languages/de/audio/dyab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e0ab98cee582f3030d49ffcaeef35ed6d89a5840bb2fe57c7532b3cffabcf7a9",
          "text": "Nicht viel. Ich weiÃŸ, dass ihr politisches Engagement nicht gefÃ¤llt. Sie lÃ¤sst mich nie eines meiner Poster an ihre TÃ¼r hÃ¤ngen.",
          "source_text": "Not much. I know she doesn't dig political involvement. She never lets me hang any of my posters on her door.",
          "transcription_review_required": false
        },
        "dyab-02": {
          "path": "res://assets/languages/de/audio/dyab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b63c9f718c0d59760a1873241f3a7286c1fde919e6d5db86ed5982ee02f77569",
          "text": "Eine Freundin von mir war einmal mit ihr zusammen. Alles war cool, Mann, bis sie mit all dem Zeug Ã¼ber die Ehe und ein Haus mit einem weiÃŸen Lattenzaun angefangen hat.",
          "source_text": "A friend of mine dated her once. Everything was cool, man, until she started all this stuff about marriage and a house with a white picket fence.",
          "transcription_review_required": false
        },
        "dyab-03": {
          "path": "res://assets/languages/de/audio/dyab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "79cf0f084b00e2832e9af333f1b77d9ab731cf48a6fb758fc52de1542b29bc47",
          "text": "Ihn weiÃŸ ich nicht, weil er das Labor nie verlÃ¤sst.",
          "source_text": "Him, I don't know, like, cause he never comes out of the lab.",
          "transcription_review_required": false
        },
        "dyab1-01": {
          "path": "res://assets/languages/de/audio/dyab1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e323324029954fbf03f728ae9a6f39383ca530a3abb893a7350103f22b869484",
          "text": "USA raus aus Vietnam. USA raus aus Vietnam.",
          "source_text": "U.S. out of Vietnam. U.S. out of Vietnam.",
          "transcription_review_required": false
        },
        "dyab1-02": {
          "path": "res://assets/languages/de/audio/dyab1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "82fada7400715697d752b61bbe1759d1217ad9a71283ac2686ea335f16e31bb6",
          "text": "Hey, schÃ¶ne sterbliche Frau. Liebe und Frieden fÃ¼r dich. Hier, haben Sie einen Aufsatz.",
          "source_text": "Hey, beautiful mortal woman. Love and peace to you. Here, have a paper.",
          "transcription_review_required": false
        },
        "dyab1-03": {
          "path": "res://assets/languages/de/audio/dyab1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f1769a1aa4dda9797efeba6637884306f0654fab51873df8cb06c7a46a8ceaff",
          "text": "Jimmy, der Mann selbst, natÃ¼rlich, Mann, der das nicht tut. Wie ein wahrer Idealist, ein wahrer Rebell.",
          "source_text": "Jimmy, the man himself, of course, man, who doesn't. Like a true idealist, a true rebel.",
          "transcription_review_required": false
        },
        "dyab1-04": {
          "path": "res://assets/languages/de/audio/dyab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7f46d649a2db5503ec1bd618a245e8df9c07687392ae665b7d0b506dd4e74f35",
          "text": "Alice, die BrÃ¼nette. Ja, sie ist eine typische Waage. Sie kÃ¤mpft fÃ¼r Gerechtigkeit und Gleichheit. Sehr positive Stimmung, Mann.",
          "source_text": "Alice, the brunette. Yeah, she's a typical Libra. She fights for justice and equality. Very positive vibes, man.",
          "transcription_review_required": false
        },
        "dyab1-05": {
          "path": "res://assets/languages/de/audio/dyab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c8024a56d7392ddd191664f0748eaf8e2dbfeb50888e35668539c7dab7c7225f",
          "text": "Gerne helfen. Du bist wie ein wandelnder Regenbogen, Mann.",
          "source_text": "Glad to help. You're like a walking rainbow, man.",
          "transcription_review_required": false
        },
        "dyab2-01": {
          "path": "res://assets/languages/de/audio/dyab2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1fe011805f02a2591a8912bb504fdbd3c188282228c6d7d8c0adc6c684e0933c",
          "text": "Hey, du schon wieder. Es muss hier eine kosmische Energie zwischen uns passieren, ja. Ich dachte nur, ich muss dir etwas sagen.",
          "source_text": "Hey, you again. There must be some cosmic energy happening between us here, yeah. I was just thinking I've got something to tell you.",
          "transcription_review_required": false
        },
        "dyab2-01a": {
          "path": "res://assets/languages/de/audio/dyab2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "507eaba0153f4f22949cefac461c2c17f24b8d559d7e37ea5a5e65c0e9f8cf43",
          "text": "Alice sucht Ã¼berall nach dir.",
          "source_text": "Alice is looking for you everywhere.",
          "transcription_review_required": false
        },
        "dyab2-03": {
          "path": "res://assets/languages/de/audio/dyab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "02ce02c3a4e96fdb2c225e5dcaf2c346cbd81beb0e8b5f8cb2a8afc99789c84d",
          "text": "Definitiv.",
          "source_text": "Definitely.",
          "transcription_review_required": false
        },
        "dyab3-01": {
          "path": "res://assets/languages/de/audio/dyab3-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5ff8efd61901c3e17276ed1999a43ad631f134017c87d4a8099d004bc8c8e66b",
          "text": "Hey, du fÃ¤llst immer wieder vom Himmel, wo immer ich bin. Vielleicht waren wir in einem frÃ¼heren Leben wie in einer Seele vereint.",
          "source_text": "Hey, you just keep falling out of the sky wherever I am. Maybe in a past life, we were like united in one soul.",
          "transcription_review_required": false
        },
        "jdyab-01": {
          "path": "res://assets/languages/de/audio/jdyab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "790ad401af62eb7356ad4d7777dff89a4a9d083c45efb19257b8cc67bb09add7",
          "text": "Wissen Sie etwas Ã¼ber das MÃ¤dchen aus dem Fotoladen?",
          "source_text": "Do you know anything about the girl from the photo store?",
          "transcription_review_required": false
        },
        "jdyab-02": {
          "path": "res://assets/languages/de/audio/jdyab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d81737b8ca4e1b1ec7a40a3861030d632d5be95ab537dadf8757429a41773de7",
          "text": "Kennen Sie Dorothy, Alices Freundin?",
          "source_text": "Do you know Dorothy, Alice's friend?",
          "transcription_review_required": false
        },
        "jdyab-03": {
          "path": "res://assets/languages/de/audio/jdyab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "725b9ca5b60178cb799bf736ca2e13d999ef1e1359549441041a3f3dd0a266e4",
          "text": "Kennen Sie Larry Chang aus dem Labor?",
          "source_text": "Do you know Larry Chang from the lab?",
          "transcription_review_required": false
        },
        "jdyab1-03": {
          "path": "res://assets/languages/de/audio/jdyab1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff2f267ad523609fbe3c922bc8c12d046eecabdc487230755dd68a1d7cd1f044",
          "text": "Kennen Sie Jimmy Mackenzie, den Reporter?",
          "source_text": "Do you know Jimmy Mackenzie, the reporter?",
          "transcription_review_required": false
        },
        "jdyab1-04": {
          "path": "res://assets/languages/de/audio/jdyab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d2dd7fef25ff315c8b643a1cb61dfd924a35e3acb37eedede4c7815e92f69c28",
          "text": "Kennen Sie Alice Kaplan?",
          "source_text": "Do you know Alice Kaplan?",
          "transcription_review_required": false
        },
        "jdyab1-05": {
          "path": "res://assets/languages/de/audio/jdyab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9ac9f360f8352aa0da75e5a2bf640ff83901bb5846684c49c8574e86ea939a00",
          "text": "Danke!",
          "source_text": "Thanks!",
          "transcription_review_required": false
        },
        "jdyab2-03": {
          "path": "res://assets/languages/de/audio/jdyab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "109757555a06923886f7712861cece056c7be10b105131bb71841c4078ee06f2",
          "text": "Bis bald!",
          "source_text": "See you soon!",
          "transcription_review_required": false
        },
        "dya2-01": {
          "path": "res://assets/languages/de/audio/dya2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2cc6b64acaba5e247b8659ebf76b08f9ab955982308dac9e441e0f9c04df9224",
          "text": "Ich habe etwas fÃ¼r dich.",
          "source_text": "I've got something for you.",
          "transcription_review_required": false
        },
        "dya2-02": {
          "path": "res://assets/languages/de/audio/dya2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05a23ae09c75c59c26fa1cfbeb1bc2944836dab8e5e3f73e0edea7f74480118f",
          "text": "Das ganze Feld entspricht eher dem, was ich Ihnen geben wollte, aber es passte nicht in meinen Van.",
          "source_text": "The whole field is more like what I wanted to give you, but it didn't fit in my van.",
          "transcription_review_required": false
        },
        "dyab3-03": {
          "path": "res://assets/languages/de/audio/dyab3-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1bd9beffbac61fe2d20d638caf9cbc12914db862599735c522442ea35bbaa743",
          "text": "Biegen Sie an der Graffitiwand links ab und fahren Sie dann geradeaus.",
          "source_text": "Turn left at the graffiti wall and then just go straight.",
          "transcription_review_required": false
        },
        "dyab3-04": {
          "path": "res://assets/languages/de/audio/dyab3-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "abf152b2970184d816277c8c5f3d7274fb0c66dcabd14cc88360b903cb62e89b",
          "text": "HÃ¶ren Sie, einige von uns gehen in den Wald, um sich mit Mutter Natur zu vereinen. Wir sind wie Umarmungen von BÃ¤umen und meditieren. Es wird groovig. Willst du mitmachen?",
          "source_text": "Listen, some of us are going to the forest to unite with Mother Nature. We're like hugs from trees and meditate. It's gonna be groovy. Wanna join us?",
          "transcription_review_required": false
        },
        "jdyab3-03": {
          "path": "res://assets/languages/de/audio/jdyab3-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9bb46e974dbc78b0c40f498a856f6ffec8549cb3ab9c73e28c5a3c11907fc1c4",
          "text": "KÃ¶nnen Sie mir sagen, wie ich zum Palast der SchÃ¶nen KÃ¼nste komme?",
          "source_text": "Can you tell me how to get to the Palace of Fine Arts?",
          "transcription_review_required": false
        },
        "dya2-10": {
          "path": "res://assets/languages/de/audio/dya2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c10c84bee11bb7084997a0089f775577a864f481661f08fd4a900eceead50f64",
          "text": "Ich mag deinen Stil. Du bist einer dieser Hipchicks. Sie mÃ¼ssen ein SchÃ¼tze sein, ein Freigeist mit Visionen. Habe ich recht oder was?",
          "source_text": "I dig your style. You're one of those hipchicks. You must be a Sagittarian, a free spirit with vision. Am I right or what?",
          "transcription_review_required": false
        },
        "dya2-10a": {
          "path": "res://assets/languages/de/audio/dya2-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "69e54f788bdc1b6f469a096e90e2e07874844bab5e9a24603ff380c036702a6b",
          "text": "Ich mag deinen Stil, du bist eine dieser hippen MÃ¤dels.",
          "source_text": "I dig your style, you're one of those hip chicks.",
          "transcription_review_required": false
        },
        "dya2-11": {
          "path": "res://assets/languages/de/audio/dya2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e3b463c59c72123ca7d6a8dea01c72ab62a01236c1744f4a395496f403a6c09c",
          "text": "Ja, sicher. Ich glaube schon. Nun ja, wissen Sie, jede Menge Leute haben sie. Vielleicht weiÃŸ Cheyennell Bescheid.",
          "source_text": "Yeah, sure. I think so. Well, you know, tons of people have them. Maybe Cheyennell know.",
          "transcription_review_required": false
        },
        "dya2-12": {
          "path": "res://assets/languages/de/audio/dya2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3f7f484c454777f0b671b1e88c007925d747c30a4b9367b96809351bc31547bd",
          "text": "Hey, Regenbogen. Ich denke darÃ¼ber nach, einen Treffpunkt fÃ¼r Harmonie zu veranstalten. Ein spiritueller Suahre heute Abend. Kannst du kommen?",
          "source_text": "Hey, Rainbow. I'm thinking about having a hangout for harmony. A spiritual suahre tonight. Can you come?",
          "transcription_review_required": false
        },
        "dyab-04": {
          "path": "res://assets/languages/de/audio/dyab-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ce3c89e4c9c0ee40abe6ea0e396a2e87bdb799478a2b140b5a9e6bef78235385",
          "text": "Ein Freund von mir traf sie einmal, er hatte den ganzen Abend keine Gelegenheit, den Mund aufzumachen. Sie ist nur an einer Kugel interessiert. Am Ende gab es also noch ein Eis.",
          "source_text": "A friend of mine met her once, he didn't get a chance to open his mouth the whole evening. All she's interested in is a scoop. So, in the end, they had an ice cream.",
          "transcription_review_required": false
        },
        "dyab-05": {
          "path": "res://assets/languages/de/audio/dyab-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f58460ba311654cbf4546377bb331deda354b09947d269a89b4d1a9c664402a4",
          "text": "Was fÃ¼r ein materielles MÃ¤dchen. Ein Freund von mir holte sie mit seinem VW-Bus ab. War nicht gut genug fÃ¼r sie. Sie fÃ¤hrt nur in Cadillacs.",
          "source_text": "What a material girl. A friend of mine came to pick her up in his VW van. Wasn't good enough for her. She only rides in Cadillacs.",
          "transcription_review_required": false
        },
        "dyab-06": {
          "path": "res://assets/languages/de/audio/dyab-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6962bc345d032b8be61a6e4fd00c50c64897729924ff4d67e7c2995873842b40",
          "text": "Ja, ein ziemlich spiritueller Mensch, gut mit seinem Inneren verbunden, ein wirklich sanfter Kerl.",
          "source_text": "Yeah, quite a spiritual human being, well connected with his inner self, a real mellow fellow.",
          "transcription_review_required": false
        },
        "jdya2-11": {
          "path": "res://assets/languages/de/audio/jdya2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf9132741cf49ef881cfaeccaecd392143d1c6a6b00ddc38f44cdf970f6e6d6b",
          "text": "Kennen Sie jemanden, der einen rosa Federmantel hat?",
          "source_text": "Do you know anyone who has a pink feather coat?",
          "transcription_review_required": false
        },
        "jdyab-04": {
          "path": "res://assets/languages/de/audio/jdyab-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dc83b7c94d41cfbdfa37e0e9cd038b6574b49454b0c1e7a61cb7d0c32dd9e96d",
          "text": "Kennen Sie den Reporter von The Guardian?",
          "source_text": "Do you know the reporter from The Guardian?",
          "transcription_review_required": false
        },
        "jdyab-05": {
          "path": "res://assets/languages/de/audio/jdyab-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d7d2904c3ee7b98b1b51c7e732672919f725b8d43887bd87ac3a9fe9cd7e8b37",
          "text": "Kennen Sie Sheila aus dem BekleidungsgeschÃ¤ft?",
          "source_text": "Do you know Sheila from the clothing store?",
          "transcription_review_required": false
        },
        "jdyab-06": {
          "path": "res://assets/languages/de/audio/jdyab-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6036858632208e3b78e569b4c1f6a1d8d403d06329e73b38840bbb939d5d6d9f",
          "text": "Kennen Sie Rick aus dem Plattenladen?",
          "source_text": "Do you know Rick from the record store?",
          "transcription_review_required": false
        },
        "jmeab-02": {
          "path": "res://assets/languages/de/audio/jmeab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b86a5e8d76bba338378c10aea3db3abfd456b6a14dbe36df39643e9e30f9d5d6",
          "text": "Danke, dass du mich hierher gebracht hast!",
          "source_text": "Thanks for landing me here!",
          "transcription_review_required": false
        },
        "jmeab-10": {
          "path": "res://assets/languages/de/audio/jmeab-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0e9432449edf52ff9192163a7e2556e4647bf23f0342fca8024cb78dc2a98935",
          "text": "1967, wie kam es dazu?",
          "source_text": "1967, how did that happen?",
          "transcription_review_required": false
        },
        "jmeab-20": {
          "path": "res://assets/languages/de/audio/jmeab-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f64e4336c6ad76b81c0d1cba759724d44d6ea3753c66f61fa2e9d66530483e2c",
          "text": "Was mache ich hier?",
          "source_text": "What am I doing here?",
          "transcription_review_required": false
        },
        "jmeab-21": {
          "path": "res://assets/languages/de/audio/jmeab-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "821be90388b95e3df422fd6dfd16f48991101993eea80321d18566506cb6980b",
          "text": "Das muss meine Strafe dafÃ¼r sein, dass ich zu oft in die Zukunft zurÃ¼ckgeschaut habe. Also, was soll ich jetzt tun?",
          "source_text": "This must be my punishment for watching back to the future too many times. So, what should I do now?",
          "transcription_review_required": false
        },
        "meab-01": {
          "path": "res://assets/languages/de/audio/meab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4911c517936fcdccbf1b5fa890583b3e6e363068339f5750b999cb770614a89b",
          "text": "Willkommen, Reisender. Sie sind gerade in den Rockin' Sixties gelandet. Die Ortszeit hier ist 10 Uhr, das Jahr 1967, Standort San Francisco. Es ist der Sommer der Liebe.",
          "source_text": "Welcome time, traveler. You've just landed in the Rockin' Sixties. The local time here is 10 a.m., the year 1967, location San Francisco. It's the summer of love.",
          "transcription_review_required": false
        },
        "meab-02": {
          "path": "res://assets/languages/de/audio/meab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9c814f2b644ca4c9759e89be4c5dadfc42648a631c13c1d874d79069cb3e1f41",
          "text": "Denken Sie daran, dass Sie entweder zuerst Ihren Vater oder Ihre Mutter finden kÃ¶nnen, aber jeder Weg, den Sie einschlagen, fÃ¼hrt Sie zu einer anderen Geschichte.",
          "source_text": "Remember, you can choose to find either your father first or your mother, but each path you decide to take will lead you to a different story.",
          "transcription_review_required": false
        },
        "meab-03": {
          "path": "res://assets/languages/de/audio/meab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b8ed000f6471857df3c94a0f5a741257f657abfe38a3f4fbf5677874d7ed730",
          "text": "Wow, ich beneide dich. 1967, San Francisco? So cool. Die GeschÃ¤fte, die Kleidung? Sie mÃ¼ssen nur hineingehen und sie sich ansehen.",
          "source_text": "Wow, I envy you. 1967, San Francisco? So cool. The shops, the clothes? You just have to go in and check them out.",
          "transcription_review_required": false
        },
        "meab-10": {
          "path": "res://assets/languages/de/audio/meab-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4af4bc105f242bad72ea4e371c0879bb6712216aab1bdc5138454f02421d10f8",
          "text": "Oh-oh, ich wollte Sie zurÃ¼ck in den heutigen Morgen schicken, nicht ins Jahr 1967.",
          "source_text": "Uh-oh, I meant to send you back to this morning, not to 1967.",
          "transcription_review_required": false
        },
        "meab-20": {
          "path": "res://assets/languages/de/audio/meab-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3cfc4ed97ebc983291dec7da79f762ddad3818c6d1ad2679313df5fb84f7b031",
          "text": "Hoppla, etwas in der Geschichte hat sich geÃ¤ndert. Deine Eltern sollten sich heute Abend treffen, aber dazu wird es nicht kommen. Ãœbersetzung? Das wird dir nicht passieren. Du musst dafÃ¼r sorgen, dass sie sich treffen.",
          "source_text": "Oops, something in history has changed. Your parents were supposed to meet tonight, but it's not gonna happen. Translation? You're not going to happen. You have to make them meet.",
          "transcription_review_required": false
        },
        "meab-21": {
          "path": "res://assets/languages/de/audio/meab-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9fdb8f4fd5f7533dff11a4d91b5b66b4f87fb10ea8be80c94109a2139b2bbf24",
          "text": "Beten, schÃ¤tze ich, das ist nur ein Scherz. Sie mÃ¼ssen mit Menschen sprechen und Nachforschungen anstellen. Holen Sie sich Hinweise und Informationen.",
          "source_text": "Pray, I guess, just kidding. You need to talk to people and investigate. Get some clues and information.",
          "transcription_review_required": false
        },
        "meab-22a": {
          "path": "res://assets/languages/de/audio/meab-22a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "24d1f1dc9b8b42c530a86afc62308ad24a177d9a2ced440189c4b9b358fbfd67",
          "text": "Alice Kaplan, deine Mutter, verbringt ihre Zeit zwischen den Unterrichtsstunden im Bell's Cafe.",
          "source_text": "Alice Kaplan, your mother, spends her time at Bell's Cafe between classes.",
          "transcription_review_required": false
        },
        "meab-22b": {
          "path": "res://assets/languages/de/audio/meab-22b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0159de2bc14313dcb04d2fc30665e7fc3c7eeeb4b5693ffe8da54d77dc9c8a96",
          "text": "Jimmy Mackenzie, Ihr Vater, ist ein berÃ¼hmter Reporter, der fÃ¼r die Zeitung Guardian arbeitet.",
          "source_text": "Jimmy Mackenzie, your father, is a famous reporter working for the Guardian newspaper.",
          "transcription_review_required": false
        },
