func _build_settings_overlay() -> void:
	_settings_overlay = ColorRect.new()
	_settings_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_settings_overlay.color = Color(0.15, 0.065, 0.025, 0.76)
	_settings_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	# Above every adventure/minigame/ending presenter, below scene transitions.
	_settings_overlay.z_index = 3050
	_settings_overlay.visible = false
	add_child(_settings_overlay)

	_settings_card = Panel.new()
	_settings_overlay.add_child(_settings_card)
	_settings_overlay.resized.connect(_layout_settings)
	_gameplay_settings_button = _make_menu_utility_button(_copy("settings"))
	_gameplay_settings_button.name = "GameplaySettingsButton"
	_gameplay_settings_button.z_index = 2500
	_gameplay_settings_button.visible = false
	_gameplay_settings_button.add_theme_color_override("font_color", PAPER)
	_gameplay_settings_button.add_theme_color_override("font_hover_color", Color.WHITE)
	_gameplay_settings_button.add_theme_font_override("font", JuliaThemeFactory.display_font())
	_gameplay_settings_button.pressed.connect(_open_settings)
	_body.add_child(_gameplay_settings_button)


func _build_casebook() -> void:
	_clue_journal = JuliaClueJournal.new()
	_clue_journal.clue_discovered.connect(_on_casebook_clue_discovered)
	_clue_journal.clue_read_state_changed.connect(
		_on_casebook_read_state_changed
	)
	_clue_journal.journal_restored.connect(_on_casebook_journal_refreshed)
	_clue_journal.journal_cleared.connect(_on_casebook_journal_refreshed)

	_casebook_button = Button.new()
	_casebook_button.name = "CasebookButton"
	_casebook_button.custom_minimum_size = Vector2(66.0, 66.0)
	_casebook_button.size = Vector2(66.0, 66.0)
	_casebook_button.focus_mode = Control.FOCUS_ALL
	_casebook_button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	_casebook_button.icon = _load_texture(FLOWER_ICON_PATH)
	_casebook_button.expand_icon = true
	_casebook_button.add_theme_constant_override("icon_max_width", 48)
	_casebook_button.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_casebook_button.z_index = 35
	_casebook_button.pressed.connect(_open_casebook)
	add_child(_casebook_button)

	_casebook_unread_badge = Label.new()
	_casebook_unread_badge.name = "UnreadStamp"
	_casebook_unread_badge.position = Vector2(46.0, -5.0)
	_casebook_unread_badge.size = Vector2(27.0, 27.0)
	_casebook_unread_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_casebook_unread_badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_casebook_unread_badge.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_casebook_unread_badge.add_theme_font_size_override("font_size", 14)
	_casebook_unread_badge.add_theme_color_override(
		"font_color",
		Color.WHITE
	)
	_casebook_unread_badge.add_theme_stylebox_override(
		"normal",
		JuliaThemeFactory.make_box(
			ACCENT,
			PAPER,
			2,
			0,
			0.0,
			0.0
		)
	)
	_casebook_unread_badge.z_index = 1
	_casebook_button.add_child(_casebook_unread_badge)

	_casebook_view = JuliaEvidenceJournalView.new()
	_casebook_view.name = "EvidenceCasebook"
	# At z 100 the open casebook drew under the opaque adventure view, so J or
	# Tools > Journal only froze the game. GUI picking follows sibling order,
	# not z_index: added after _shell_margin (the adventure view and the
	# Settings button), the casebook already takes the clicks over play. The
	# settings overlay draws above it but never shows with it: _open_settings
	# closes the casebook first.
	_casebook_view.z_index = CASEBOOK_Z_INDEX
	_casebook_view.bind_journal(_clue_journal)
	_casebook_view.close_requested.connect(_close_casebook)
	add_child(_casebook_view)


func _build_toast() -> void:
	_toast_panel = Panel.new()
	_toast_panel.z_index = TOAST_Z_INDEX
	_toast_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_toast_panel.modulate.a = 0.0
	add_child(_toast_panel)

	var margin: MarginContainer = MarginContainer.new()
	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	margin.add_theme_constant_override("margin_left", 18)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 18)
	margin.add_theme_constant_override("margin_bottom", 12)
	_toast_panel.add_child(margin)

	_toast_label = Label.new()
	_toast_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_toast_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_toast_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	margin.add_child(_toast_label)


func _apply_theme() -> void:
	theme = JuliaThemeFactory.build(_high_contrast, _large_text)
	_backdrop.set_high_contrast(_high_contrast)

	var paper_color: Color = Color.WHITE if _high_contrast else PAPER
	var ink_color: Color = Color.BLACK if _high_contrast else INK
	var panel_border: Color = INK if _high_contrast else ACCENT
	var stage_style: StyleBoxFlat = JuliaThemeFactory.make_box(
		Color.TRANSPARENT,
		Color.TRANSPARENT,
		0,
		0,
		0.0,
		0.0
	)
	_stage_card.add_theme_stylebox_override("panel", stage_style)

	var side_style: StyleBoxFlat
	if _view_mode == ViewMode.MAIN_MENU:
		side_style = JuliaThemeFactory.make_box(
			Color.TRANSPARENT,
			Color.TRANSPARENT,
			0,
			0,
			0.0,
			0.0
		)
	else:
		side_style = JuliaThemeFactory.make_box(
			Color(paper_color, 0.985),
			Color.TRANSPARENT,
			0,
			0,
			0.0,
			0.0
		)
		side_style.shadow_color = WARM_SHADOW
		side_style.shadow_size = 6
		side_style.shadow_offset = Vector2(-5.0, 7.0)
	_side_panel.add_theme_stylebox_override("panel", side_style)

	_settings_card.add_theme_stylebox_override(
		"panel",
		JuliaThemeFactory.make_box(paper_color, panel_border, 2, 0, 0.0, 0.0)
	)
	_toast_panel.add_theme_stylebox_override(
		"panel",
		JuliaThemeFactory.make_box(
			Color(PAPER_DEEP, 0.99),
			ACCENT,
			0,
			0,
			0.0,
			0.0
		)
	)
	_toast_label.add_theme_color_override("font_color", ink_color)
	_apply_casebook_access_style()


func _apply_casebook_access_style() -> void:
	if not is_instance_valid(_casebook_button):
		return
	var paper_color: Color = Color.WHITE if _high_contrast else PAPER
	var ink_color: Color = Color.BLACK if _high_contrast else INK
	var focus_color: Color = Color.BLACK if _high_contrast else TEAL
	var normal_style: StyleBoxFlat = JuliaThemeFactory.make_box(
		paper_color,
		ink_color,
		2,
		0,
		7.0,
		7.0
	)
	normal_style.shadow_color = WARM_SHADOW
	normal_style.shadow_size = 5
	normal_style.shadow_offset = Vector2(3.0, 4.0)
	_casebook_button.add_theme_stylebox_override("normal", normal_style)
	_casebook_button.add_theme_stylebox_override(
		"hover",
		JuliaThemeFactory.make_box(
			PAPER_DEEP,
			ACCENT,
			3,
			0,
			7.0,
			7.0
		)
	)
	_casebook_button.add_theme_stylebox_override(
		"pressed",
		JuliaThemeFactory.make_box(
			GOLD,
			ink_color,
			3,
			0,
			7.0,
			7.0
		)
	)
	_casebook_button.add_theme_stylebox_override(
		"focus",
		JuliaThemeFactory.make_box(
			paper_color,
			focus_color,
			4,
			0,
			7.0,
			7.0
		)
	)
	_casebook_button.add_theme_stylebox_override(
		"disabled",
		JuliaThemeFactory.make_box(
			Color(PAPER_DEEP, 0.74),
			Color(MUTED, 0.62),
			1,
			0,
			7.0,
			7.0
		)
	)


func _apply_locale() -> void:
	JuliaGameLocalization.current = _locale
	var rtl: bool = _locale == "he"
	layout_direction = Control.LAYOUT_DIRECTION_RTL if rtl else Control.LAYOUT_DIRECTION_LTR
	TranslationServer.set_locale(_locale)

	_brand_label.text = _copy("brand")
	_brand_label.language = _locale
	_brand_label.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	_brand_label.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT if rtl else HORIZONTAL_ALIGNMENT_LEFT
	)
	_language_button.text = _copy("language_button")
	_language_button.tooltip_text = _copy("language_tooltip")
	_language_button.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	_settings_button.text = _copy("settings")
	_settings_button.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	_fullscreen_button.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	if is_instance_valid(_casebook_view):
		_casebook_view.set_localization(
			_locale,
			{},
			Callable(self, "_copy")
		)
	if is_instance_valid(_full_adventure):
		_full_adventure.set_locale(_locale)
	_update_casebook_access()
	_layout_casebook_access()
	_update_chrome_layout()
	_update_fullscreen_button()
	_refresh_legacy_menu_controls()
	_rebuild_side_content()
	_update_stage_labels()
	_update_footer()
	_layout_body()
	if _settings_overlay.visible:
		_rebuild_settings()


func _update_chrome_layout() -> void:
	if not is_instance_valid(_header):
		return
	var rtl: bool = _locale == "he"
	if rtl:
		_header.move_child(_header_controls, 0)
		_header.move_child(_header_spacer, 1)
		_header.move_child(_brand_label, 2)
	else:
		_header.move_child(_brand_label, 0)
		_header.move_child(_header_spacer, 1)
		_header.move_child(_header_controls, 2)
	# Menu utilities live in the editorial menu composition itself. Keeping the
	# launcher-like chrome hidden gives the key art and primary action hierarchy
	# room to breathe.
	_header.visible = false
	_brand_label.visible = false
	if is_instance_valid(_footer):
		_footer.visible = false


func _rebuild_side_content() -> void:
	if not is_instance_valid(_side_content):
		return
	_clear_children(_side_content)
	_side_content.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL if _locale == "he" else Control.LAYOUT_DIRECTION_LTR
	)

	if _view_mode == ViewMode.MAIN_MENU:
		_build_menu_content()
	elif _view_mode == ViewMode.FIRST_SCENE:
		_build_scene_content()


func _build_menu_content() -> void:
	# The title and controls share one axis over the existing illustrated fade.
	var top_space := Control.new()
	top_space.name = "MenuTopSpace"
	top_space.custom_minimum_size.y = 48.0
	_side_content.add_child(top_space)

	var title := _make_label(_copy("menu_title"), 88 if _locale == "he" else 96, Color("b92d60"))
	title.name = "MenuTitle"
	title.add_theme_font_override("font", JuliaThemeFactory.display_font(700.0))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_constant_override("outline_size", 0)
	title.add_theme_color_override("font_shadow_color", Color("cc942f"))
	title.add_theme_constant_override("shadow_offset_x", 0)
	title.add_theme_constant_override("shadow_offset_y", 2)
	_side_content.add_child(title)

	var subtitle := _make_label(
		_copy("menu_subtitle").replace(". ", ".\n"),
		21 if not _large_text else 25, Color("493126")
	)
	subtitle.name = "MenuSubtitle"
	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	subtitle.add_theme_constant_override("line_spacing", 1)
	_side_content.add_child(subtitle)

	var flex := Control.new()
	flex.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_side_content.add_child(flex)

	var resume_slot: String = _best_resume_slot()
	if not resume_slot.is_empty():
		var continue_button: Button = _make_menu_action_button(
			_copy("continue_game"), true
		)
		continue_button.name = "ContinueButton"
		continue_button.pressed.connect(_continue_game)
		_side_content.add_child(continue_button)
		_menu_primary_action = continue_button

	var start_button: Button = _make_menu_action_button(
		_copy("start"), resume_slot.is_empty()
	)
	start_button.name = "NewGameButton"
	start_button.pressed.connect(_start_first_scene)
	_side_content.add_child(start_button)
	if resume_slot.is_empty():
		_menu_primary_action = start_button
		_menu_secondary_action = null
		# Reserve the secondary action's space so Continue never shifts the menu.
		var secondary_space := Control.new()
		secondary_space.name = "MenuSecondarySpace"
		secondary_space.custom_minimum_size.y = 44.0 if not _large_text else 50.0
		_side_content.add_child(secondary_space)
	else:
		_menu_secondary_action = start_button
		_menu_primary_action.focus_neighbor_bottom = (
			_menu_secondary_action.get_path()
		)
		_menu_secondary_action.focus_neighbor_top = (
			_menu_primary_action.get_path()
		)

	var edition_label := _make_label("×ž×”×“×•×¨×”" if _locale == "he" else "Edition", 15, MUTED)
	edition_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_side_content.add_child(edition_label)
	var edition_row := HBoxContainer.new()
	edition_row.name = "EditionSelector"
	edition_row.layout_direction = Control.LAYOUT_DIRECTION_LTR
	edition_row.add_theme_constant_override("separation", 24)
	_side_content.add_child(edition_row)
	for edition: String in ["modern", "legacy"]:
		var edition_button := _make_menu_utility_button(edition.capitalize())
		edition_button.flat = false
		edition_button.tooltip_text = ("××™×•×¨×™× ×•×ž×ž×©×§ ×ž×—×•×“×©×™×" if _locale == "he" else "Recreated art and interface") if edition == "modern" else ("×”×ž×©×—×§ ×”×ž×§×•×¨×™" if _locale == "he" else "The original game")
		edition_button.name = "Edition" + edition.capitalize()
		edition_button.custom_minimum_size = Vector2(112, 44)
		edition_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		edition_button.add_theme_font_override("font", JuliaThemeFactory.display_font())
		edition_button.add_theme_font_size_override("font_size", 19 if not _large_text else 22)
		var selected := StyleBoxFlat.new()
		selected.bg_color = Color.TRANSPARENT
		selected.border_color = TEAL
		selected.border_width_bottom = 3
		selected.expand_margin_left = -48.0
		selected.expand_margin_right = -48.0
		edition_button.add_theme_stylebox_override("pressed", selected)
		edition_button.add_theme_stylebox_override("hover_pressed", selected)
		edition_button.add_theme_color_override("font_pressed_color", TEAL)
		edition_button.add_theme_color_override("font_hover_pressed_color", TEAL)
		edition_button.toggle_mode = true
		edition_button.button_pressed = edition == _presentation_edition
		edition_button.pressed.connect(_select_edition.bind(edition))
		edition_row.add_child(edition_button)

	var utility_row: HBoxContainer = HBoxContainer.new()
	utility_row.name = "MenuUtilityRow"
	utility_row.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL
		if _locale == "he"
		else Control.LAYOUT_DIRECTION_LTR
	)
	utility_row.add_theme_constant_override("separation", 12)
	utility_row.alignment = BoxContainer.ALIGNMENT_CENTER
	_side_content.add_child(utility_row)

	var settings_link: Button = _make_menu_utility_button(_copy("settings"))
	settings_link.name = "MenuSettingsButton"
	settings_link.pressed.connect(_open_settings)
	utility_row.add_child(settings_link)

	var language_link: Button = _make_menu_utility_button(
		_copy("language_button")
	)
	language_link.name = "MenuLanguageButton"
	language_link.tooltip_text = _copy("language_tooltip")
	language_link.pressed.connect(_toggle_locale)
	utility_row.add_child(language_link)

	var fullscreen_link: Button = _make_menu_utility_button(
		_copy("windowed") if _is_fullscreen() else _copy("fullscreen")
	)
	fullscreen_link.name = "MenuFullscreenButton"
	fullscreen_link.pressed.connect(_toggle_fullscreen)
	utility_row.add_child(fullscreen_link)
	fullscreen_link.visible = not OS.has_feature("android")
	if is_instance_valid(_menu_primary_action):
		call_deferred("_focus_menu_primary_action")


func _focus_menu_primary_action() -> void:
	if (
		_view_mode == ViewMode.MAIN_MENU
		and (
			not is_instance_valid(_settings_overlay)
			or not _settings_overlay.visible
		)
		and is_instance_valid(_menu_primary_action)
		and _menu_primary_action.is_inside_tree()
		and _menu_primary_action.is_visible_in_tree()
	):
		_menu_primary_action.grab_focus()


func _build_scene_content() -> void:
	if _street5_slice == null or not _street5_slice.is_ready():
		_build_game_data_error()
		return

	var title_key: String = _dialogue_speaker_key
	if _dialogue_step == DialogueStep.FAMILY and not _dialogue_busy:
		title_key = "family_title"
	elif _dialogue_step == DialogueStep.EXPLORE and not _dialogue_busy:
		title_key = "explore_title"
	_build_dialogue_header(title_key)

	var line_key: String = _dialogue_line_key
	if not _dialogue_busy:
		match _dialogue_step:
			DialogueStep.OPENING:
				line_key = "dialogue_choose"
			DialogueStep.FOLLOW_UP:
				line_key = "dialogue_follow_up_prompt"
			DialogueStep.FAMILY:
				line_key = "family_prompt"
			DialogueStep.EXPLORE:
				line_key = "explore_prompt"
	var line: Label = _make_label(
		_copy(line_key),
		20 if not _large_text else 24,
		INK
	)
	line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	line.add_theme_constant_override("line_spacing", 5)
	_side_content.add_child(line)

	var spacer: Control = Control.new()
	spacer.custom_minimum_size.y = 5.0
	_side_content.add_child(spacer)

	match _dialogue_step:
		DialogueStep.OPENING:
			_build_opening_choices()
		DialogueStep.FOLLOW_UP:
			_build_follow_up_choice()
		DialogueStep.FAMILY:
			_build_family_choices()
		DialogueStep.EXPLORE:
			_build_explore_actions()

	var flex: Control = Control.new()
	flex.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_side_content.add_child(flex)

	var back_button: Button = _make_utility_button(_copy("back_menu"))
	back_button.pressed.connect(_return_to_menu)
	_side_content.add_child(back_button)


func _build_dialogue_header(title_key: String) -> void:
	var name_label: Label = _make_label(
		_copy(title_key),
		30 if not _large_text else 35,
		ACCENT
	)
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_side_content.add_child(name_label)

	var accent_rule: ColorRect = ColorRect.new()
	accent_rule.color = GOLD
	accent_rule.custom_minimum_size = Vector2(76.0, 4.0)
	accent_rule.size_flags_horizontal = (
		Control.SIZE_SHRINK_END
		if _locale == "he"
		else Control.SIZE_SHRINK_BEGIN
	)
	accent_rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_side_content.add_child(accent_rule)

	if title_key == "speaker_mell":
		var role_label: Label = _make_label(
			_copy("speaker_mell_role"),
			12 if not _large_text else 14,
			TEAL
		)
		role_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_side_content.add_child(role_label)


func _build_game_data_error() -> void:
	var title: Label = _make_label(
		_copy("game_data_error_title"),
		34 if not _large_text else 40,
		Color("ffb1b1")
	)
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_side_content.add_child(title)
	var explanation: Label = _make_label(
		_copy("game_data_error_body"),
		16 if not _large_text else 19,
		INK
	)
	explanation.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	explanation.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_side_content.add_child(explanation)
	var retry_button: Button = _make_primary_button(_copy("retry"))
	retry_button.pressed.connect(_retry_street5)
	_side_content.add_child(retry_button)
	var back_button: Button = _make_utility_button(_copy("back_menu"))
	back_button.pressed.connect(_return_to_menu)
	_side_content.add_child(back_button)


func _build_opening_choices() -> void:
	if _dialogue_busy and _dialogue_line_key == "dialogue_intro":
		var skip_button: Button = _make_utility_button(
			_copy("skip_intro")
		)
		skip_button.custom_minimum_size.y = 42.0
		skip_button.pressed.connect(_skip_opening_greeting)
		_side_content.add_child(skip_button)

	var where_text: String = _copy("choice_where")
	if _asked_where:
		where_text = _copy("choice_done_prefix") + where_text
	_add_dialogue_choice(
		where_text,
		_on_opening_choice.bind(1),
		not _asked_where
	)

	var what_text: String = _copy("choice_what")
	if _asked_what:
		what_text = _copy("choice_done_prefix") + what_text
	_add_dialogue_choice(
		what_text,
		_on_opening_choice.bind(2),
		not _asked_what
	)

	var continue_button: Button = _make_secondary_button(
		_copy("finish_conversation")
	)
	continue_button.custom_minimum_size.y = 46.0
	continue_button.disabled = _dialogue_busy
	continue_button.pressed.connect(_finish_opening_conversation)
	_side_content.add_child(continue_button)


func _build_follow_up_choice() -> void:
	var follow_text: String = _copy("choice_follow_up")
	if _asked_follow_up:
		follow_text = _copy("choice_done_prefix") + follow_text
	_add_dialogue_choice(
		follow_text,
		_on_follow_up_choice,
		true
	)


func _build_family_choices() -> void:
	_add_dialogue_choice(
		_copy("choose_left_portrait"),
		_on_father_pressed,
		true
	)
	_add_dialogue_choice(
		_copy("choose_right_portrait"),
		_on_mother_pressed,
		false
	)


func _build_explore_actions() -> void:
	_add_dialogue_choice(
		_copy("play_lamp"),
		_on_stage_hotspot_pressed,
		true
	)
	var replay_button: Button = _make_secondary_button(
		_copy("replay_conversation")
	)
	replay_button.custom_minimum_size.y = 46.0
	replay_button.disabled = _dialogue_busy
	replay_button.pressed.connect(_restart_street5_conversation)
	_side_content.add_child(replay_button)


func _add_dialogue_choice(
	text_value: String,
	callback: Callable,
	primary: bool
) -> void:
	var choice: Button = (
		_make_primary_button(text_value)
		if primary
		else _make_secondary_button(text_value)
	)
	_apply_button_direction(choice)
	choice.custom_minimum_size.y = 48.0 if not _large_text else 58.0
	choice.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	choice.disabled = _dialogue_busy
	choice.pressed.connect(callback)
	_side_content.add_child(choice)


func _make_label(value: String, font_size: int, color: Color) -> Label:
	var result: Label = Label.new()
	result.text = value
	result.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	result.language = _locale
	# Keep physical alignment stable. Text direction handles glyph order while
	# the surrounding container handles semantic RTL/LTR child order.
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if _locale == "he"
		else Control.TEXT_DIRECTION_LTR
	)
	result.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT if _locale == "he" else HORIZONTAL_ALIGNMENT_LEFT
	)
	if font_size > 0:
		result.add_theme_font_size_override("font_size", font_size)
	result.add_theme_color_override("font_color", color)
	return result


func _make_primary_button(value: String) -> Button:
	var result: Button = Button.new()
	result.text = value
	_apply_button_direction(result)
	result.custom_minimum_size.y = 52.0 if not _large_text else 62.0
	result.add_theme_font_size_override("font_size", 18 if not _large_text else 21)
	result.add_theme_color_override("font_color", INK)
	result.add_theme_color_override("font_hover_color", INK)
	result.add_theme_color_override("font_pressed_color", INK)
	result.add_theme_color_override("font_focus_color", INK)
	result.add_theme_color_override("font_disabled_color", Color(MUTED, 0.66))
	result.alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT
		if _locale == "he"
		else HORIZONTAL_ALIGNMENT_LEFT
	)
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	var normal: StyleBoxFlat = StyleBoxFlat.new()
	normal.bg_color = PAPER_DEEP
	normal.border_color = ACCENT
	normal.border_width_left = 6 if _locale != "he" else 0
	normal.border_width_right = 6 if _locale == "he" else 0
	normal.border_width_bottom = 1
	normal.content_margin_left = 18.0
	normal.content_margin_right = 18.0
	normal.content_margin_top = 10.0
	normal.content_margin_bottom = 10.0

	var hover: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	hover.bg_color = Color("f3c65e")
	hover.border_color = CORAL
	hover.border_width_bottom = 3

	var pressed: StyleBoxFlat = hover.duplicate() as StyleBoxFlat
	pressed.bg_color = Color("e7af38")

	var focus: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	focus.border_color = TEAL
	focus.border_width_bottom = 3

	var disabled: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	disabled.bg_color = Color("eadfbd")
	disabled.border_color = Color(MUTED, 0.30)

	result.add_theme_stylebox_override("normal", normal)
	result.add_theme_stylebox_override("hover", hover)
	result.add_theme_stylebox_override("pressed", pressed)
	result.add_theme_stylebox_override("focus", focus)
	result.add_theme_stylebox_override("disabled", disabled)
	return result


func _make_menu_action_button(value: String, primary: bool) -> Button:
	var result := Button.new()
	result.text = value
	result.focus_mode = Control.FOCUS_ALL
	result.custom_minimum_size.y = (62.0 if primary else 44.0) if not _large_text else (70.0 if primary else 50.0)
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	result.add_theme_font_size_override("font_size", (24 if primary else 20) + (3 if _large_text else 0))
	result.add_theme_font_override("font", JuliaThemeFactory.display_font())
	result.add_theme_color_override("font_color", Color("fff1d0") if primary else INK)
	result.add_theme_color_override("font_hover_color", Color("fff1d0") if primary else TEAL)
	result.add_theme_color_override("font_pressed_color", Color("fff1d0") if primary else ACCENT)
	result.add_theme_color_override("font_focus_color", Color("fff1d0") if primary else TEAL)
	result.alignment = HORIZONTAL_ALIGNMENT_CENTER
	var normal := StyleBoxFlat.new()
	normal.bg_color = Color("267d76") if primary else Color.TRANSPARENT
	normal.border_color = Color("185953")
	normal.border_width_bottom = 3 if primary else 0
	normal.set_corner_radius_all(16)
	normal.content_margin_left = 18.0
	normal.content_margin_right = 18.0
	normal.content_margin_top = 6.0
	normal.content_margin_bottom = 6.0
	var hover := normal.duplicate() as StyleBoxFlat
	hover.bg_color = Color("328e80") if primary else Color(PAPER, 0.6)
	var pressed := normal.duplicate() as StyleBoxFlat
	pressed.bg_color = Color("205f5a") if primary else Color(PAPER_DEEP, 0.6)
	var focus := StyleBoxFlat.new()
	focus.bg_color = Color.TRANSPARENT
	focus.border_color = GOLD
	focus.set_border_width_all(2)
	focus.set_corner_radius_all(16)
	result.add_theme_stylebox_override("normal", normal)
	result.add_theme_stylebox_override("hover", hover)
	result.add_theme_stylebox_override("pressed", pressed)
	result.add_theme_stylebox_override("focus", focus)
	_apply_button_direction(result)
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	return result


func _make_menu_utility_button(value: String) -> Button:
	var result := _make_utility_button(value)
	result.custom_minimum_size = Vector2(48.0, 48.0)
	result.add_theme_font_size_override("font_size", 18 if not _large_text else 21)
	result.add_theme_color_override("font_color", INK)
	result.add_theme_color_override("font_hover_color", ACCENT)
	result.add_theme_color_override("font_focus_color", TEAL)
	result.add_theme_color_override("font_pressed_color", ACCENT)
	result.add_theme_constant_override("outline_size", 0)
	return result

func _make_secondary_button(value: String) -> Button:
	var result: Button = _make_primary_button(value)
	result.add_theme_font_size_override(
		"font_size",
		17 if not _large_text else 20
	)

	var normal: StyleBoxFlat = StyleBoxFlat.new()
	normal.bg_color = Color(PAPER, 0.76)
	normal.border_color = Color(MUTED, 0.48)
	normal.border_width_bottom = 1
	normal.content_margin_left = 18.0
	normal.content_margin_right = 18.0
	normal.content_margin_top = 10.0
	normal.content_margin_bottom = 10.0

	var hover: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	hover.bg_color = Color("f2dfad")
	hover.border_color = ACCENT
	hover.border_width_bottom = 3
	var pressed: StyleBoxFlat = hover.duplicate() as StyleBoxFlat
	pressed.bg_color = Color("e9d092")
	var focus: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	focus.border_color = TEAL
	focus.border_width_bottom = 3

	var disabled: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	disabled.bg_color = Color(PAPER, 0.42)
	disabled.border_color = Color(MUTED, 0.24)

	result.add_theme_stylebox_override("normal", normal)
	result.add_theme_stylebox_override("hover", hover)
	result.add_theme_stylebox_override("pressed", pressed)
	result.add_theme_stylebox_override("focus", focus)
	result.add_theme_stylebox_override("disabled", disabled)
	return result


func _make_utility_button(value: String) -> Button:
	var result: Button = Button.new()
	result.text = value
	result.flat = true
	result.custom_minimum_size.y = 38.0
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	result.add_theme_font_size_override(
		"font_size",
		15 if not _large_text else 18
	)
	result.add_theme_color_override("font_color", MUTED)
	result.add_theme_color_override("font_hover_color", ACCENT)
	result.add_theme_color_override("font_focus_color", TEAL)
	result.add_theme_color_override("font_pressed_color", CORAL)
	result.add_theme_stylebox_override("normal", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("pressed", StyleBoxEmpty.new())

	var hover: StyleBoxFlat = StyleBoxFlat.new()
	hover.bg_color = Color.TRANSPARENT
	hover.border_color = ACCENT
	hover.border_width_bottom = 2
	hover.content_margin_left = 4.0
	hover.content_margin_right = 4.0
	var focus: StyleBoxFlat = hover.duplicate() as StyleBoxFlat
	focus.border_color = TEAL
	result.add_theme_stylebox_override("hover", hover)
	result.add_theme_stylebox_override("focus", focus)
	_apply_button_direction(result)
	return result


func _apply_button_direction(button: Button) -> void:
	button.language = _locale
	button.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL
		if _locale == "he"
		else Control.LAYOUT_DIRECTION_LTR
	)
	button.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if _locale == "he"
		else Control.TEXT_DIRECTION_LTR
	)


func _select_edition(edition: String) -> void:
	if edition not in ["modern", "legacy"] or _view_mode != ViewMode.MAIN_MENU or _transitioning:
		return
	if is_instance_valid(_opening_sequence) and _opening_sequence.is_playing():
		return
	if edition != _presentation_edition and is_instance_valid(_full_adventure):
		_adventure_start_generation += 1
		_full_adventure.effect_host.stop_all(false)
		_full_adventure.queue_free()
		_full_adventure = null
	_presentation_edition = edition
	_save_preferences()
	_update_stage_content()
	_rebuild_side_content()
	_layout_body()
	if edition == "legacy" and is_instance_valid(_original_menu):
		_original_menu.show_menu()


func _ensure_original_menu() -> void:
	if is_instance_valid(_original_menu):
		return
	_legacy_menu_backdrop = ColorRect.new()
	_legacy_menu_backdrop.name = "LegacyMenuNavigationBackdrop"
	_legacy_menu_backdrop.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_legacy_menu_backdrop.color = Color.BLACK
	_legacy_menu_backdrop.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_legacy_menu_backdrop.z_index = 29
	_body.add_child(_legacy_menu_backdrop)
	_legacy_menu_backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_original_menu = OriginalMenuScript.new()
	_original_menu.name = "LegacyMainMenu"
	_original_menu.size = _body.size
	_original_menu.z_index = 30
	_body.add_child(_original_menu)
	_original_menu.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	_original_menu.new_game_requested.connect(_start_first_scene)
	_original_menu.load_requested.connect(_load_original_slot)
	_original_menu.quit_requested.connect(func() -> void: get_tree().quit())
	_original_menu.website_requested.connect(func(url: String) -> void: OS.shell_open(url))
	var index := OriginalAssetIndex.new()
	index.scan_runtime_root("res://assets")
	if not _original_menu.configure(index):
		push_error("The preserved main menu could not resolve all original artwork.")
	_edition_return_button = _make_menu_utility_button("Modern")
	_edition_return_button.name = "ReturnToModernMenu"
	_edition_return_button.z_index = 31
	_edition_return_button.add_theme_color_override("font_color", PAPER)
	_edition_return_button.add_theme_color_override("font_hover_color", Color.WHITE)
	_edition_return_button.pressed.connect(_select_edition.bind("modern"))
	_body.add_child(_edition_return_button)
	_legacy_continue_button = _make_menu_utility_button(_copy("continue_game"))
	_legacy_continue_button.name = "LegacyContinueButton"
	_legacy_continue_button.z_index = 31
	_legacy_continue_button.add_theme_color_override("font_color", PAPER)
	_legacy_continue_button.add_theme_color_override("font_hover_color", Color.WHITE)
	_legacy_continue_button.add_theme_color_override("font_focus_color", Color.WHITE)
	_legacy_continue_button.add_theme_color_override("font_pressed_color", Color.WHITE)
	_legacy_continue_button.add_theme_color_override("font_disabled_color", Color(PAPER, 0.42))
	_legacy_continue_button.pressed.connect(_continue_game)
	_body.add_child(_legacy_continue_button)
	_refresh_legacy_menu_controls()


func _refresh_legacy_menu_controls() -> void:
	if not is_instance_valid(_legacy_continue_button):
		return
	_legacy_continue_button.text = _copy("continue_game")
	_legacy_continue_button.disabled = _best_resume_slot().is_empty()
	_legacy_continue_button.tooltip_text = (
		"×”×ž×©×š ×ž×”×©×ž×™×¨×” ×”××—×¨×•× ×”, ×›×•×œ×œ ×©×ž×™×¨×” ××•×˜×•×ž×˜×™×ª"
		if _locale == "he"
		else "Continue the latest save, including autosave"
	)
	for button: Button in [_edition_return_button, _legacy_continue_button]:
		_apply_button_direction(button)
		# The companion controls stay outside the original canvas in both locales.
		button.layout_direction = Control.LAYOUT_DIRECTION_LTR


func _load_original_slot(slot_id: String) -> void:
	if _transitioning or _view_mode != ViewMode.MAIN_MENU:
		return
	_pending_load_slot = slot_id
	_transition_to(ViewMode.ADVENTURE)


func _start_first_scene() -> void:
	if (
		_transitioning
		or _view_mode != ViewMode.MAIN_MENU
		or (
			is_instance_valid(_opening_sequence)
			and _opening_sequence.is_playing()
		)
	):
		return
	_pending_load_slot = ""
	if is_instance_valid(_opening_sequence):
		if is_instance_valid(_original_menu):
			_original_menu.stop_menu_audio()
		# The recovered Director flow always runs the intro on New Game.
		# STOPINTRO was persisted as soon as its first run began; it only
		# relaxed the skip controls on later viewings.
		var is_first_play: bool = not _opening_has_played
		if is_first_play:
			_opening_has_played = true
			_save_preferences()
		_opening_sequence.presentation_edition = _presentation_edition
		_opening_sequence.reduced_motion = _reduced_motion
		_opening_sequence.play(is_first_play)
		call_deferred("_qa_render_state", "opening")
		return
	_transition_to(ViewMode.ADVENTURE)


func _continue_game() -> void:
	if _transitioning or _view_mode != ViewMode.MAIN_MENU:
		return
	var slot_id: String = _best_resume_slot()
	if slot_id.is_empty():
		_rebuild_side_content()
		return
	_pending_load_slot = slot_id
	_transition_to(ViewMode.ADVENTURE)


func _best_resume_slot() -> String:
	var store: JuliaSaveStore = SAVE_STORE_SCRIPT.new()
	return SAVE_STORE_SCRIPT.latest_slot_id(store.list_slot_summaries())


func _on_opening_sequence_ended() -> void:
	_opening_has_played = true
	_transition_from_opening_to_adventure()


func _transition_from_opening_to_adventure() -> void:
	if _transitioning:
		return
	_transitioning = true
	_transition_overlay.mouse_filter = Control.MOUSE_FILTER_STOP

	# The opening hides itself immediately before it emits finished/skipped.
	# Restore its last frame within the same event turn, cover it above every
	# presentation layer, and replace the menu underneath before the next draw.
	if is_instance_valid(_opening_sequence):
		_opening_sequence.visible = true
	_transition_overlay.color.a = 1.0
	_set_view(ViewMode.ADVENTURE)
	_qa_handoff_geometry("after_handoff")
	if is_instance_valid(_opening_sequence):
		_opening_sequence.visible = false

	if _reduced_motion:
		_transition_overlay.color.a = 0.0
		_transition_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_transitioning = false
		_update_casebook_access()
		return

	# Keep one covered frame so freshly mounted adventure nodes can finish
	# their first layout before the game is revealed.
	await get_tree().process_frame
	var fade_in: Tween = create_tween()
	fade_in.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
	fade_in.tween_property(_transition_overlay, "color:a", 0.0, 0.30)
	await fade_in.finished
	_transition_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_transitioning = false
	_update_casebook_access()


func _return_to_menu() -> void:
	_transition_to(ViewMode.MAIN_MENU)


func _transition_to(target: ViewMode) -> void:
	if _transitioning or target == _view_mode:
		return
	_transitioning = true
	if _reduced_motion:
		_set_view(target)
		_transitioning = false
		_update_casebook_access()
		return

	_transition_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	var fade_out: Tween = create_tween()
	fade_out.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	fade_out.tween_property(_transition_overlay, "color:a", 1.0, 0.20)
	await fade_out.finished

	_set_view(target)

	var fade_in: Tween = create_tween()
	fade_in.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
	fade_in.tween_property(_transition_overlay, "color:a", 0.0, 0.30)
	await fade_in.finished
	_transition_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_transitioning = false
	_update_casebook_access()


func _set_view(target: ViewMode) -> void:
	_view_mode = target
	if target == ViewMode.FIRST_SCENE:
		_leave_full_adventure()
		_enter_street5()
	elif target == ViewMode.ADVENTURE:
		_leave_street5()
		_enter_full_adventure()
	else:
		_leave_street5()
		_leave_full_adventure()
	_apply_theme()
	_update_chrome_layout()
	_update_stage_content()
	_rebuild_side_content()
	_update_footer()
	_layout_body()


func _update_stage_content() -> void:
	var is_menu: bool = _view_mode == ViewMode.MAIN_MENU
	var is_legacy_slice: bool = _view_mode == ViewMode.FIRST_SCENE
	var original_menu_open: bool = is_menu and _presentation_edition == "legacy"
	if original_menu_open:
		_ensure_original_menu()
	if is_instance_valid(_original_menu):
		_original_menu.visible = original_menu_open
	if is_instance_valid(_edition_return_button):
		_edition_return_button.visible = original_menu_open
		_legacy_continue_button.visible = original_menu_open
		_legacy_menu_backdrop.visible = original_menu_open
		_refresh_legacy_menu_controls()
	_menu_art.visible = is_menu and not original_menu_open
	_menu_tint.visible = is_menu and not original_menu_open
	_stage_card.visible = is_legacy_slice
	if is_instance_valid(_full_adventure):
		_full_adventure.visible = _view_mode == ViewMode.ADVENTURE
	if is_menu:
		_stage_backdrop.set_mode(JuliaStageBackdrop.StageMode.MENU)
	elif is_legacy_slice:
		_stage_backdrop.set_mode(JuliaStageBackdrop.StageMode.STREET)
		_update_street_view_texture()
	_stage_badge.visible = false
	_sync_street5_nodes()
	_update_stage_labels()


func _sync_street5_nodes() -> void:
	var is_street: bool = _view_mode == ViewMode.FIRST_SCENE
	# Keep the retained regression viewport inactive outside that fixture.
	# Hidden stretched viewports otherwise participate in Android input with
	# no active container layout during the opening-to-adventure handoff.
	if is_instance_valid(_stage_viewport):
		_stage_viewport.gui_disable_input = not is_street
		_stage_viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS if is_street else SubViewport.UPDATE_DISABLED
		_stage_viewport_container.mouse_filter = Control.MOUSE_FILTER_STOP if is_street else Control.MOUSE_FILTER_IGNORE
	if is_instance_valid(_dylen_sprite):
		_dylen_sprite.visible = is_street and _street_view == StreetView.STREET5
	if is_instance_valid(_stage_hud):
		_stage_hud.visible = false
	var dialogue_visible: bool = (
		is_street
		and (
			_dialogue_step != DialogueStep.EXPLORE
			or _dialogue_busy
		)
	)
	if is_instance_valid(_dialogue_scrim):
		_dialogue_scrim.visible = dialogue_visible
	var show_mell: bool = (
		dialogue_visible
		and _street_view == StreetView.STREET5
		and _dialogue_speaker_key == "speaker_mell"
		and _dialogue_step in [
			DialogueStep.OPENING,
			DialogueStep.FOLLOW_UP,
		]
	)
	if is_instance_valid(_mell_portrait):
		_mell_portrait.visible = show_mell
		if show_mell:
			_set_mell_frame(_mell_frame_index)
	_configure_world_hotspots(is_street)
	var show_family: bool = (
		is_street
		and _street_view == StreetView.STREET5
		and _dialogue_step == DialogueStep.FAMILY
	)
	if is_instance_valid(_dad_sprite):
		_dad_sprite.visible = show_family
	if is_instance_valid(_mam_sprite):
		_mam_sprite.visible = show_family
	if is_instance_valid(_dad_hotspot):
		_dad_hotspot.visible = show_family and not _dialogue_busy
		_dad_hotspot.tooltip_text = _copy("choose_left_portrait")
	if is_instance_valid(_mam_hotspot):
		_mam_hotspot.visible = show_family and not _dialogue_busy
		_mam_hotspot.tooltip_text = _copy("choose_right_portrait")
	var can_explore: bool = false
	if is_instance_valid(_stage_hud_talk_button):
		_stage_hud_talk_button.visible = can_explore
	if is_instance_valid(_stage_hud_action_button):
		_stage_hud_action_button.visible = can_explore
	if not is_street:
		_hide_hotspot_prompt()
		if is_instance_valid(_boy_overlay):
			_boy_overlay.visible = false
		if is_instance_valid(_lamp_overlay):
			_lamp_overlay.visible = false
	_update_casebook_access()


func _configure_world_hotspots(is_street: bool) -> void:
	var active_ids: Array[String] = []
	match _street_view:
		StreetView.STREET5:
			active_ids = ["neon", "door", "car", "poster", "alley"]
		StreetView.STREET4:
			active_ids = [
				"s4_to_street5",
				"s4_to_street3",
				"s4_uphill",
				"s4_white_car",
				"s4_yellow_car",
			]
		StreetView.STREET3:
			active_ids = [
				"s3_to_street4",
				"s3_cafe_door",
				"s3_yellow_car",
				"s3_post",
				"s3_window",
			]
	var exploration_open: bool = (
		is_street
		and _dialogue_step == DialogueStep.EXPLORE
		and not _dialogue_busy
	)
	for hotspot_id: String in _world_hotspots:
		var hotspot: Button = _world_hotspots[hotspot_id] as Button
		if is_instance_valid(hotspot):
			hotspot.visible = exploration_open and hotspot_id in active_ids


func _set_dad_active(active: bool) -> void:
	if not is_instance_valid(_dad_sprite):
		return
	_dad_sprite.texture = _load_texture(
		STREET5_DAD_ACTIVE_PATH if active else STREET5_DAD_PATH
	)
	_dad_sprite.size = Vector2(157.0 if active else 146.0, 145.0)


func _update_stage_labels() -> void:
	if not is_instance_valid(_stage_badge):
		return
	_stage_badge.text = _copy("stage_menu" if _view_mode == ViewMode.MAIN_MENU else "stage_game")
	_stage_badge.language = _locale
	_stage_badge.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if _locale == "he"
		else Control.TEXT_DIRECTION_LTR
	)
	if is_instance_valid(_stage_hotspot):
		_stage_hotspot.tooltip_text = _copy("hotspot_neon")
	if is_instance_valid(_stage_hud_label):
		var hud_key: String = "hud_dialogue"
		if _dialogue_busy:
			hud_key = "hud_listen"
		elif _dialogue_step == DialogueStep.FAMILY:
			hud_key = "hud_choose"
		elif _dialogue_step == DialogueStep.EXPLORE:
			hud_key = "hud_explore"
		_stage_hud_label.text = _copy(hud_key)
	if is_instance_valid(_stage_hud_talk_button):
		_stage_hud_talk_button.text = _copy("hud_talk")
	if is_instance_valid(_stage_hud_action_button):
		_stage_hud_action_button.text = _copy("hud_interact")


func _load_texture(path: String) -> Texture2D:
	if not ResourceLoader.exists(path):
		return null
	var loaded: Resource = load(path)
	if loaded is Texture2D:
		return loaded as Texture2D
	return null


func _update_footer() -> void:
	if not is_instance_valid(_footer_status):
		return
	var rtl: bool = _locale == "he"
	_footer_status.text = _copy("footer_menu" if _view_mode == ViewMode.MAIN_MENU else "footer_game")
	_footer_shortcuts.text = _copy("footer_shortcuts")
	_footer_status.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	_footer_shortcuts.text_direction = (
		Control.TEXT_DIRECTION_RTL if rtl else Control.TEXT_DIRECTION_LTR
	)
	_footer_status.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT if rtl else HORIZONTAL_ALIGNMENT_LEFT
	)
	_footer_shortcuts.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_LEFT if rtl else HORIZONTAL_ALIGNMENT_RIGHT
	)
	if rtl:
		_footer.move_child(_footer_shortcuts, 0)
		_footer.move_child(_footer_status, 1)
	else:
		_footer.move_child(_footer_status, 0)
		_footer.move_child(_footer_shortcuts, 1)


func _layout_body() -> void:
	if not is_instance_valid(_body) or not is_instance_valid(_stage_card):
		return
	var available: Vector2 = _body.size
	if is_instance_valid(_gameplay_settings_button):
		_gameplay_settings_button.visible = _view_mode == ViewMode.ADVENTURE
	if available.x <= 1.0 or available.y <= 1.0:
		return

	_menu_art.position = Vector2.ZERO
	_menu_art.size = available
	_menu_tint.position = Vector2.ZERO
	_menu_tint.size = available

	if _view_mode == ViewMode.MAIN_MENU:
		if _presentation_edition == "legacy" and is_instance_valid(_original_menu):
			_side_panel.visible = false
			var original_rect := SafeStageLayout.aspect_fit_rect(available, Vector2(640, 480))
			# On wide displays these companions occupy the black side gutter.
			# Narrow displays reserve a top strip so neither action overlaps the
			# untouched 640x480 Director artwork or its twelve manual save slots.
			var button_width := maxf(120.0, _legacy_continue_button.get_minimum_size().x)
			var button_size := Vector2(button_width, 48.0)
			_edition_return_button.visible = true
			_legacy_continue_button.visible = true
			_edition_return_button.size = button_size
			_legacy_continue_button.size = button_size
			if original_rect.position.x >= button_width + 16.0:
				_original_menu.position = Vector2.ZERO
				_original_menu.size = available
				var gutter_x := (original_rect.position.x - button_width) * 0.5
				_edition_return_button.position = Vector2(gutter_x, 18.0)
				_legacy_continue_button.position = Vector2(gutter_x, 74.0)
			else:
				_original_menu.position = Vector2(0, 64.0)
				_original_menu.size = Vector2(available.x, maxf(1.0, available.y - 64.0))
				var controls_x := (available.x - button_width * 2.0 - 16.0) * 0.5
				_edition_return_button.position = Vector2(controls_x, 8.0)
				_legacy_continue_button.position = Vector2(controls_x + button_width + 16.0, 8.0)
			_layout_toast()
			return
		var menu_margin: float = clampf(available.x * 0.032, 24.0, 54.0)
		var menu_rail_width: float = clampf(
			available.x * 0.34,
			370.0,
			500.0
		)
		_side_panel.visible = true
		_side_panel.position = Vector2(
			menu_margin,
			menu_margin
		)
		_side_panel.size = Vector2(
			menu_rail_width,
			maxf(360.0, available.y - menu_margin * 2.0)
		)
		if WebLayout.enabled():
			_layout_web_menu(available)
		_layout_toast()
		return

	if _view_mode == ViewMode.ADVENTURE:
		_side_panel.visible = false
		_stage_card.visible = false
		if is_instance_valid(_full_adventure):
			_full_adventure.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
			_layout_adventure_settings_access(_full_adventure)
		_layout_toast()
		return

	var fitted_stage: Rect2 = SafeStageLayout.aspect_fit_rect(
		available,
		Vector2(16.0, 9.0)
	)
	var stage_size: Vector2 = fitted_stage.size
	var stage_origin: Vector2 = fitted_stage.position
	_stage_card.position = stage_origin
	_stage_card.size = stage_size

	var show_dialogue_sheet: bool = (
		_dialogue_step != DialogueStep.EXPLORE
		or _dialogue_busy
	)
	_side_panel.visible = show_dialogue_sheet
	if show_dialogue_sheet:
		var sheet_width: float = clampf(
			stage_size.x * 0.64,
			560.0,
			780.0
		)
		var sheet_height: float = clampf(
			stage_size.y * 0.48,
			270.0,
			330.0
		)
		var sheet_margin: float = clampf(
			stage_size.x * 0.018,
			14.0,
			24.0
		)
		_side_panel.position = Vector2(
			stage_origin.x + stage_size.x - sheet_width - sheet_margin,
			stage_origin.y + stage_size.y - sheet_height - sheet_margin
		)
		_side_panel.size = Vector2(sheet_width, sheet_height)
	_layout_toast()


func _layout_web_menu(available: Vector2) -> void:
	var portrait := available.x < 600.0 and available.y > available.x
	var short := available.y < 500.0
	var margin := 12.0 if portrait else 8.0
	var top := minf(224.0, available.y * 0.26) if portrait else margin
	_side_panel.position = Vector2(margin, top)
	_side_panel.size = Vector2(available.x - margin * 2 if portrait else minf(440.0, available.x * 0.48), available.y - top - margin)
	_menu_art.size = Vector2(available.x, minf(360.0, available.y * 0.48)) if portrait else available
	(_menu_tint.material as ShaderMaterial).set_shader_parameter("portrait", portrait)
	var padding: MarginContainer = _side_panel.find_child("MenuRailMargin", true, false)
	for side: String in ["left", "right", "top", "bottom"]:
		padding.add_theme_constant_override("margin_" + side, 8 if short or portrait else 20)
	var title: Label = _side_content.find_child("MenuTitle", true, false)
	if title != null: title.add_theme_font_size_override("font_size", 48 if short else (64 if portrait else (88 if _locale == "he" else 96)))
	var subtitle: Label = _side_content.find_child("MenuSubtitle", true, false)
	if subtitle != null:
		subtitle.visible = not short
		subtitle.add_theme_font_size_override("font_size", 16 if short else 19)
	var top_space: Control = _side_content.find_child("MenuTopSpace", true, false)
	if top_space != null: top_space.custom_minimum_size.y = 0 if short or portrait else 32
	var secondary_space: Control = _side_content.find_child("MenuSecondarySpace", true, false)
	if secondary_space != null: secondary_space.custom_minimum_size.y = 0 if short else 20
	var fullscreen: Button = _side_content.find_child("MenuFullscreenButton", true, false)
	if fullscreen != null: fullscreen.visible = false
	for name: String in ["NewGameButton", "ContinueButton"]:
		var button: Button = _side_content.find_child(name, true, false)
		if button != null:
			button.custom_minimum_size.y = 48 if short else 62
			button.add_theme_font_size_override("font_size", 20 if short else 24)
	_side_content.add_theme_constant_override("separation", 4 if short else 8)


func _layout_settings() -> void:
	if not is_instance_valid(_settings_card):
		return
	var card_size: Vector2 = Vector2(
		minf(740.0, maxf(520.0, size.x - 64.0)),
		minf(680.0, maxf(500.0, size.y - 56.0))
	)
	if WebLayout.enabled():
		card_size = Vector2(minf(740.0, size.x - 16.0), minf(680.0, size.y - 16.0))
	_settings_card.size = card_size
	_settings_card.position = (size - card_size) * 0.5
	if WebLayout.enabled():
		for node: Node in _settings_card.find_children("WebSettingRow", "BoxContainer", true, false):
			(node as BoxContainer).vertical = size.x < 600.0


func _layout_casebook_access() -> void:
	if not is_instance_valid(_casebook_button):
		return
	var edge_margin: float = clampf(size.x * 0.018, 16.0, 28.0)
	var top_margin: float = clampf(size.y * 0.026, 16.0, 24.0)
	var control_size: Vector2 = Vector2(66.0, 66.0)
	_casebook_button.size = control_size
	_casebook_button.position = Vector2(
		size.x - control_size.x - edge_margin
		if _locale == "he"
		else edge_margin,
		top_margin
	)
	_casebook_unread_badge.position = Vector2(
		-7.0 if _locale == "he" else 46.0,
		-5.0
	)


func _layout_toast() -> void:
	if not is_instance_valid(_toast_panel):
		return
	var toast_width: float = minf(560.0, maxf(300.0, size.x - 72.0))
	var toast_height: float = 84.0 if "\n" in _toast_label.text else 66.0
	_toast_panel.size = Vector2(toast_width, toast_height)
	_toast_panel.position = Vector2(
		(size.x - toast_width) * 0.5,
		maxf(24.0, size.y - toast_height - 36.0)
	)
	# fixes-87 round 2: a message shown over Settings (SETTINGS_TOAST_Z_INDEX)
	# sat in this usual bottom slot, over Settings' own footer Close (in
	# portrait it hid it and hung past the card's lower edge). Over Settings
	# it sits just above that Close instead, inside the card. Only the place
	# changes, not the style.
	var footer: Control = _settings_footer_close()
	if _toast_panel.z_index == SETTINGS_TOAST_Z_INDEX and footer != null:
		var footer_rect: Rect2 = get_global_transform().affine_inverse() * footer.get_global_rect()
		_toast_panel.position.y = maxf(8.0, footer_rect.position.y - SETTINGS_TOAST_GAP - toast_height)


func _settings_footer_close() -> Control:
	# The Close button at the foot of the Settings card, when shown.
	if not is_instance_valid(_settings_card) or not _settings_overlay.visible:
		return null
	var footer: Control = _settings_card.find_child("SettingsFooterClose", true, false) as Control
	return footer if footer != null and footer.is_visible_in_tree() else null


func _on_window_resized() -> void:
	WebLayout.configure_root(get_window())
	_layout_body()
	_layout_settings()
	_layout_casebook_access()
	_layout_toast()
	_update_fullscreen_button()
	if OS.has_feature("web"): call_deferred("_qa_render_state", "resized")


func _toggle_locale() -> void:
	_locale = JuliaGameLocalization.CODES[(JuliaGameLocalization.CODES.find(_locale) + 1) % JuliaGameLocalization.CODES.size()]
	_apply_locale()
	_save_preferences()
	_sync_web_language()


func _on_web_language(arguments: Array) -> void:
	if arguments.is_empty(): return
	var desired: String = str(arguments[0].detail)
	if desired not in JuliaGameLocalization.CODES: return
	_locale = desired
	_apply_locale()
	JuliaGameLocalization.apply_tree(self)
	_save_preferences()
	_sync_web_language()


func _sync_web_language() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("window.__juliaSetLanguage && window.__juliaSetLanguage(" + JSON.stringify(_locale) + ", false)", true)


func _can_open_casebook() -> bool:
	var in_adventure: bool = (
		_view_mode == ViewMode.ADVENTURE
		and is_instance_valid(_full_adventure)
		and _full_adventure.has_runtime_session()
	)
	# fixes-87: no casebook over a minigame, the ending or an item close-up
	# (tools_covered: the original game has no notes there); J gives the hint.
	return (
		(_view_mode == ViewMode.FIRST_SCENE or in_adventure)
		and not _casebook_open
		and not _transitioning
		and (not in_adventure or not _full_adventure.has_modern_tool_open())
		and (not in_adventure or not _full_adventure.tools_covered())
		and (
			in_adventure
			or (
				not _street_transitioning
				and not _dialogue_busy
				and not _lamp_animation_running
			)
		)
		and is_instance_valid(_casebook_view)
		and (
			not is_instance_valid(_settings_overlay)
			or not _settings_overlay.visible
		)
	)


func _update_casebook_access() -> void:
	if not is_instance_valid(_casebook_button):
		return
	var in_scene: bool = _view_mode == ViewMode.FIRST_SCENE
	var settings_open: bool = (
		is_instance_valid(_settings_overlay)
		and _settings_overlay.visible
	)
	_casebook_button.visible = (
		in_scene
		and not settings_open
		and not _casebook_open
	)
	_casebook_button.disabled = not _can_open_casebook()
	var unread: int = casebook_unread_count()
	_casebook_unread_badge.visible = unread > 0
	_casebook_unread_badge.text = str(unread)
	var tooltip_key: String = (
		"casebook_open_hint"
		if not _casebook_button.disabled
		else "casebook_wait_hint"
	)
	_casebook_button.tooltip_text = _copy(tooltip_key)
	if unread > 0:
		_casebook_button.tooltip_text += (
			" Â· " + (_copy("casebook_unread_count") % unread)
		)


func _open_casebook() -> bool:
	if not _can_open_casebook():
		return false
	_casebook_previous_focus = get_viewport().gui_get_focus_owner()
	# A focus from a click or tap is hidden (no focus state is drawn); it is
	# given back the same way on closing.
	_casebook_previous_focus_hidden = (
		_casebook_previous_focus != null
		and not _casebook_previous_focus.has_focus(true)
	)
	_casebook_tree_was_paused = get_tree().paused
	_pause_audio_for_casebook()
	_casebook_open = true
	if is_instance_valid(_full_adventure):
		_full_adventure.set_casebook_open(true)
	_hide_hotspot_prompt()
	get_tree().paused = true
	_casebook_view.open_journal(_first_unread_casebook_id())
	# After this input event, before the frame is drawn.
	call_deferred("_repick_hover_over_casebook")
	_update_casebook_access()
	casebook_opened.emit()
	return true


func _repick_hover_over_casebook() -> void:
	# The pointer still hovers the control the casebook now covers (a room
	# hotspot, after J). Its tooltip timer runs in the paused tree, so its
	# tooltip popped up over the casebook and took the first Escape. Re-pick
	# the control under the pointer, as a mouse move would: the hover leaves
	# the covered control and its tooltip is cancelled. Closing re-picks too,
	# so a pointer still resting there hovers that control again.
	if not _casebook_open or not is_inside_tree():
		return
	var hovered: Control = get_viewport().gui_get_hovered_control()
	if (
		hovered != null
		and hovered != _casebook_view
		and not _casebook_view.is_ancestor_of(hovered)
	):
		_casebook_repicked_hover = true
		get_viewport().update_mouse_cursor_state()


func _close_casebook() -> void:
	if not _casebook_open:
		return
	_casebook_open = false
	if is_instance_valid(_casebook_view):
		_casebook_view.close_journal()
	if is_inside_tree():
		get_tree().paused = _casebook_tree_was_paused
	# After the unpause, which resumes every pausable player: the view's hold
	# and the shell's own players then go back to their state from before.
	if is_instance_valid(_full_adventure):
		_full_adventure.set_casebook_open(false)
	_restore_audio_after_casebook()
	if (
		is_instance_valid(_full_adventure)
		and _view_mode == ViewMode.ADVENTURE
		and not Input.is_key_pressed(KEY_SPACE)
	):
		# Space shows the hotspots while it is held. A release while the
		# casebook was open never reached the paused shell, so the reveal
		# stayed on in play.
		_full_adventure.set_hotspot_reveal(false)
	_update_casebook_access()
	if (
		is_instance_valid(_casebook_previous_focus)
		and _casebook_previous_focus.is_visible_in_tree()
	):
		# Shown or hidden as it was: Tools focused by a tap came back drawn as
		# focused, its label lost in the focus box (a blank cream pill).
		_casebook_previous_focus.call_deferred(
			"grab_focus", _casebook_previous_focus_hidden
		)
	_casebook_previous_focus = null
	if _casebook_repicked_hover and is_inside_tree():
		get_viewport().update_mouse_cursor_state.call_deferred()
	_casebook_repicked_hover = false
	casebook_closed.emit()


func _pause_audio_for_casebook() -> void:
	_casebook_audio_pause_state.clear()
	for pair: Array in [
		["ambient", _ambient_player],
		["voice", _voice_player],
		["effects", _sfx_player],
	]:
		var player: AudioStreamPlayer = pair[1] as AudioStreamPlayer
		if not is_instance_valid(player):
			continue
		_casebook_audio_pause_state[str(pair[0])] = player.stream_paused
		player.stream_paused = true


func _restore_audio_after_casebook() -> void:
	for pair: Array in [
		["ambient", _ambient_player],
		["voice", _voice_player],
		["effects", _sfx_player],
	]:
		var player: AudioStreamPlayer = pair[1] as AudioStreamPlayer
		if not is_instance_valid(player):
			continue
		player.stream_paused = bool(
			_casebook_audio_pause_state.get(str(pair[0]), false)
		)
	_casebook_audio_pause_state.clear()


func _first_unread_casebook_id() -> String:
	if _clue_journal == null:
		return ""
	for entry: Dictionary in _clue_journal.entries():
		if not bool(entry.get("read", false)):
			return str(entry.get("id", ""))
	return ""


func serialize_casebook_state() -> Dictionary:
	if _clue_journal == null:
		return {}
	return _clue_journal.snapshot()


func restore_casebook_state(snapshot_data: Dictionary) -> bool:
	if _clue_journal == null or _casebook_open:
		return false
	return _clue_journal.restore(snapshot_data)


func clear_casebook_state() -> bool:
	if _clue_journal == null or _casebook_open:
		return false
	return _clue_journal.clear()


func casebook_unread_count() -> int:
	return 0 if _clue_journal == null else _clue_journal.unread_count()


func is_casebook_open() -> bool:
	return _casebook_open


func _discover_street5_clue(
	clue_id: String,
	show_acknowledgement: bool = true
) -> bool:
	if _clue_journal == null or not STREET5_CLUE_DEFINITIONS.has(clue_id):
		return false
	var definition: Dictionary = (
		STREET5_CLUE_DEFINITIONS[clue_id] as Dictionary
	).duplicate(true)
	var source_id: String = (
		"observation"
		if str(definition.get("source_key", "")).ends_with("observation")
		else "conversation"
	)
	var discovered: bool = _clue_journal.discover(
		clue_id,
		definition,
		"street5",
		source_id
	)
	if discovered and show_acknowledgement:
		_show_toast(_copy("casebook_clue_stamped"))
	return discovered


func _on_casebook_clue_discovered(_clue_id: String) -> void:
	_on_casebook_state_changed()


func _on_casebook_read_state_changed(
	_clue_id: String,
	_is_read: bool
) -> void:
	_on_casebook_state_changed()


func _on_casebook_journal_refreshed() -> void:
	_on_casebook_state_changed()


func _on_casebook_state_changed() -> void:
	_update_casebook_access()
	casebook_state_changed.emit(serialize_casebook_state())


func _open_settings() -> void:
	if _settings_overlay.visible or _edition_transitioning:
		return
	if _casebook_open:
		_close_casebook()
	if _view_mode == ViewMode.ADVENTURE and is_instance_valid(_full_adventure):
		_full_adventure.prepare_for_settings()
		_full_adventure.set_settings_modal(true)
	_rebuild_settings()
	_settings_overlay.visible = true
	_settings_overlay.modulate.a = 1.0 if _reduced_motion else 0.0
	_layout_settings()
	if not _reduced_motion:
		var tween: Tween = create_tween()
		tween.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tween.tween_property(_settings_overlay, "modulate:a", 1.0, 0.18)
	_update_casebook_access()
	call_deferred("_focus_settings_primary")
	call_deferred("_qa_render_state", "settings")


func _close_settings() -> void:
	if is_instance_valid(_modern_credits) and _modern_credits.visible:
		_close_modern_credits()
		return
	if not _settings_overlay.visible or _edition_transitioning:
		return
	if _reduced_motion:
		_settings_overlay.visible = false
		_restore_settings_input()
		_update_casebook_access()
		call_deferred("_focus_menu_primary_action")
		return
	var tween: Tween = create_tween()
	tween.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tween.tween_property(_settings_overlay, "modulate:a", 0.0, 0.14)
	# fixes-87 round 3 (review): a message shown over Settings fades with it.
	# It is not inside the overlay (the shell's panel, z 3060), so it stayed
	# fully opaque through the fade and was dropped only at its end, in
	# _restore_settings_input: for the last frames it sat over the game alone.
	if is_instance_valid(_toast_panel) and _toast_panel.z_index == SETTINGS_TOAST_Z_INDEX:
		if is_instance_valid(_toast_tween):
			_toast_tween.kill()
		tween.parallel().tween_property(_toast_panel, "modulate:a", 0.0, 0.14)
	_settings_closing = true
	await tween.finished
	_settings_closing = false
	_settings_overlay.visible = false
	_restore_settings_input()
	_update_casebook_access()
	call_deferred("_focus_menu_primary_action")


func _rebuild_settings() -> void:
	_clear_children(_settings_card)

	var outer: MarginContainer = MarginContainer.new()
	outer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	outer.add_theme_constant_override("margin_left", 30)
	outer.add_theme_constant_override("margin_top", 26)
	outer.add_theme_constant_override("margin_right", 30)
	outer.add_theme_constant_override("margin_bottom", 24)
	if WebLayout.enabled():
		for side: String in ["left", "right", "top", "bottom"]:
			outer.add_theme_constant_override("margin_" + side, 12)
	_settings_card.add_child(outer)

	var root_stack: VBoxContainer = VBoxContainer.new()
	root_stack.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL if _locale == "he" else Control.LAYOUT_DIRECTION_LTR
	)
	root_stack.add_theme_constant_override("separation", 8)
	outer.add_child(root_stack)

	var heading_row: HBoxContainer = HBoxContainer.new()
	heading_row.add_theme_constant_override("separation", 12)
	root_stack.add_child(heading_row)

	var heading_stack: VBoxContainer = VBoxContainer.new()
	heading_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading_row.add_child(heading_stack)
	var title: Label = _make_label(_copy("settings_title"), 32 if not _large_text else 38, INK)
	if WebLayout.enabled(): title.add_theme_font_size_override("font_size", 26)
	heading_stack.add_child(title)
	var subtitle: Label = _make_label(_copy("settings_subtitle"), 14 if not _large_text else 17, MUTED)
	subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	subtitle.visible = not WebLayout.enabled()
	heading_stack.add_child(subtitle)

	var close_icon: Button = Button.new()
	close_icon.name = "SettingsCloseButton"
	close_icon.text = "\u00d7"
	close_icon.custom_minimum_size = Vector2(48.0, 48.0)
	close_icon.add_theme_font_size_override("font_size", 28)
	close_icon.add_theme_color_override("font_color", MUTED)
	close_icon.add_theme_color_override("font_hover_color", ACCENT)
	close_icon.add_theme_stylebox_override("normal", StyleBoxEmpty.new())
	close_icon.add_theme_stylebox_override("hover", StyleBoxEmpty.new())
	close_icon.add_theme_stylebox_override("pressed", StyleBoxEmpty.new())
	close_icon.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	close_icon.pressed.connect(_close_settings)
	heading_row.add_child(close_icon)

	var separator: HSeparator = HSeparator.new()
	root_stack.add_child(separator)

	var scroll: ScrollContainer = ScrollContainer.new()
	scroll.name = "SettingsScroll"
	NativeTouchScroll.attach(scroll)
	scroll.follow_focus = true
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	root_stack.add_child(scroll)

	var settings_stack: VBoxContainer = VBoxContainer.new()
	settings_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	settings_stack.add_theme_constant_override("separation", 10)
	scroll.add_child(settings_stack)

	settings_stack.add_child(_make_section_label("×ž×”×“×•×¨×ª ×”×ž×©×—×§" if _locale == "he" else "Game edition"))
	_add_edition_setting(settings_stack)
	settings_stack.add_child(_make_section_label(_copy("audio_section")))
	_add_volume_setting(settings_stack)
	for category: String in ["music", "voice", "effects"]:
		_add_audio_category_setting(settings_stack, category)

	settings_stack.add_child(_make_section_label(_copy("display_section")))
	_add_language_setting(settings_stack)
	if not OS.has_feature("android"):
		if not OS.has_feature("web"):
			_add_screen_setting(settings_stack)
		_add_toggle_setting(
			settings_stack,
			_copy("fullscreen_setting"),
			_copy("fullscreen_description"),
			_is_fullscreen(),
			_on_fullscreen_setting_toggled
		)
	_add_filter_setting(settings_stack)

	settings_stack.add_child(_make_section_label(_copy("accessibility_section")))
	_add_toggle_setting(
		settings_stack,
		_copy("high_contrast"),
		_copy("high_contrast_description"),
		_high_contrast,
		_on_high_contrast_toggled
	)
	_add_toggle_setting(
		settings_stack,
		_copy("large_text"),
		_copy("large_text_description"),
		_large_text,
		_on_large_text_toggled
	)
	_add_toggle_setting(
		settings_stack,
		_copy("reduced_motion"),
		_copy("reduced_motion_description"),
		_reduced_motion,
		_on_reduced_motion_toggled
	)
	var credits_button := _make_secondary_button("×™×•×¦×¨×™ ×”×ž×©×—×§" if _locale == "he" else "Original game credits")
	credits_button.name = "SettingsCreditsButton"
	credits_button.pressed.connect(_open_modern_credits)
	settings_stack.add_child(credits_button)

	var footer_separator: HSeparator = HSeparator.new()
	root_stack.add_child(footer_separator)
	var close_button: Button = _make_primary_button(_copy("close"))
	# Named so a message shown over Settings can keep clear of it (fixes-87).
	close_button.name = "SettingsFooterClose"
	close_button.custom_minimum_size.y = 50.0
	close_button.pressed.connect(_close_settings)
	root_stack.add_child(close_button)
	call_deferred("_focus_settings_primary")


func _open_modern_credits() -> void:
	if not _settings_overlay.visible:
		return
	if not is_instance_valid(_modern_credits):
		_modern_credits = ModernCreditsScript.new()
		_modern_credits.size = size
		_modern_credits.z_index = 1
		_settings_overlay.add_child(_modern_credits)
		_modern_credits.close_requested.connect(_close_modern_credits)
		_modern_credits.website_requested.connect(func(url: String) -> void: OS.shell_open(url))
	var index := OriginalAssetIndex.new()
	index.scan_runtime_root("res://assets")
	if not _modern_credits.configure(index, _locale):
		_show_toast("×œ× × ×™×ª×Ÿ ×œ×¤×ª×•×— ××ª ×¨×©×™×ž×ª ×”×™×•×¦×¨×™×" if _locale == "he" else "The credits could not be opened")
		return
	_settings_card.hide()
	_modern_credits.open_credits()


func _close_modern_credits() -> void:
	if is_instance_valid(_modern_credits):
		_modern_credits.hide()
	_settings_card.show()
	var button: Button = _settings_card.find_child("SettingsCreditsButton", true, false)
	if button != null:
		button.grab_focus()


func _focus_settings_primary() -> void:
	if _settings_overlay.visible:
		var close: Button = _settings_overlay.find_child("SettingsCloseButton", true, false)
		if close != null: close.grab_focus()


func _restore_settings_input() -> void:
	if is_instance_valid(_full_adventure):
		_full_adventure.set_settings_modal(false)
	# fixes-87 round 2: a message shown over Settings goes with it. It stayed
	# at z 3060 over the game's bottom bar until it faded.
	if is_instance_valid(_toast_panel) and _toast_panel.z_index == SETTINGS_TOAST_Z_INDEX:
		if is_instance_valid(_toast_tween):
			_toast_tween.kill()
		_toast_panel.modulate.a = 0.0
		_toast_panel.z_index = TOAST_Z_INDEX
	call_deferred("_qa_render_state", "settings_closed")


func _input(event: InputEvent) -> void:
	if (
		_hold_double_tap_off_settings(event)
		or _keep_play_keys_off_focus(event)
		or _keep_conversation_keys_under_cover(event)
	):
		return
	_drop_focus_under_layer(event)
	if not is_instance_valid(_settings_overlay) or not _settings_overlay.visible or not event is InputEventKey:
		return
	var key := event as InputEventKey
	if key.pressed and key.keycode == KEY_ESCAPE:
		_close_settings()
		get_viewport().set_input_as_handled()
		return
	var focused: Control = get_viewport().gui_get_focus_owner()
	if key.pressed and key.keycode == KEY_TAB:
		var choices: Array[Control] = []
		for node: Node in _settings_overlay.find_children("*", "Control", true, false):
			var control := node as Control
			if control.is_visible_in_tree() and control.focus_mode == Control.FOCUS_ALL and not (control is BaseButton and control.disabled):
				choices.append(control)
		if not choices.is_empty():
			var index := choices.find(focused)
			choices[posmod(index + (-1 if key.shift_pressed else 1), choices.size())].grab_focus()
		get_viewport().set_input_as_handled()
	elif focused == null or not _settings_overlay.is_ancestor_of(focused):
		_focus_settings_primary()
		get_viewport().set_input_as_handled()


func _hold_double_tap_off_settings(event: InputEvent) -> bool:
	# fixes-87: the second tap of a double tap on the casebook's Close. In the
	# landscape web layout Close (32,31 84x48) lies over the gameplay Settings
	# button (16,12 128x48). The casebook keeps the presses on Close's spot
	# from the game for a moment after Close, but a second tap landing
	# elsewhere on Settings opened Settings. For that moment no pointer press
	# or release reaches a Settings button within reach of the spot (the
	# guarded spot touches it), wherever on the button it lands.
	if not (event is InputEventMouseButton or event is InputEventScreenTouch):
		return false
	if (
		_casebook_open
		or not is_instance_valid(_casebook_view)
		or not is_instance_valid(_gameplay_settings_button)
		or not _gameplay_settings_button.is_visible_in_tree()
	):
		return false
	var guarded: Rect2 = _casebook_view.close_double_press_area()
	var settings_rect: Rect2 = _gameplay_settings_button.get_global_rect()
	if (
		not guarded.has_area()
		or not guarded.intersects(settings_rect)
		or not settings_rect.has_point(event.get("position"))
	):
		return false
	get_viewport().set_input_as_handled()
	return true


func _keep_play_keys_off_focus(event: InputEvent) -> bool:
	# fixes-87: in play Space is only the hotspot reveal, and a focus the
	# player cannot see presses nothing. After Tools > Journal by pointer the
	# casebook gives Tools back a click's hidden focus: the next Space showed
	# the hotspots and its release pressed Tools (Space is ui_accept), so the
	# dock opened; Enter pressed it too. Here, before the GUI sees the key:
	# Space only reveals, whatever has the focus; Enter on a hidden focus does
	# nothing (a keyboard focus, shown, still takes it; Alt+Enter is
	# fullscreen). Sheets, pages, tools, close-ups, minigames, the ending, the
	# casebook and Settings keep their keys (takes_play_keys is false there).
	if not event is InputEventKey:
		return false
	var key := event as InputEventKey
	if key.keycode not in [KEY_SPACE, KEY_ENTER, KEY_KP_ENTER]:
		return false
	if (
		_view_mode != ViewMode.ADVENTURE
		or _casebook_open
		or _transitioning
		or (is_instance_valid(_settings_overlay) and _settings_overlay.visible)
		or not is_instance_valid(_full_adventure)
		or not _full_adventure.is_visible_in_tree()
		or not _full_adventure.takes_play_keys()
	):
		return false
	var focused: Control = get_viewport().gui_get_focus_owner()
	if focused == null:
		# Nothing to press: Space reaches the reveal in _unhandled_key_input.
		return false
	if key.keycode == KEY_SPACE:
		_full_adventure.set_hotspot_reveal(key.pressed)
		get_viewport().set_input_as_handled()
		return true
	if key.alt_pressed or focused.has_focus(true):
		return false
	get_viewport().set_input_as_handled()
	return true


func _keep_conversation_keys_under_cover(event: InputEvent) -> bool:
	# fixes-87 round 3 (review): the suitcase or an item close-up opened over a
	# conversation does not hold it, and the conversation's own keys come
	# before the shell's Escape (JuliaLegacyDialogueOverlay._unhandled_key_input:
	# Escape ends it, 1 to 9 pick a question). Under the cover Escape ended the
	# conversation and left the suitcase open, and 1 picked a question unseen.
	# While such a cover is the topmost layer over a conversation, Escape closes
	# the cover (handle_escape) and the number keys do nothing.
	if not event is InputEventKey:
		return false
	var key := event as InputEventKey
	if not key.pressed or key.echo:
		return false
	var number: bool = (
		(key.keycode >= KEY_1 and key.keycode <= KEY_9)
		or (key.physical_keycode >= KEY_1 and key.physical_keycode <= KEY_9)
	)
	if key.keycode != KEY_ESCAPE and not number:
		return false
	if (
		_view_mode != ViewMode.ADVENTURE
		or _casebook_open
		or _transitioning
		or (is_instance_valid(_settings_overlay) and _settings_overlay.visible)
		or not is_instance_valid(_full_adventure)
		or not _full_adventure.is_visible_in_tree()
		or not _full_adventure.conversation_under_cover()
	):
		return false
	if key.keycode == KEY_ESCAPE:
		_full_adventure.handle_escape()
	get_viewport().set_input_as_handled()
	return true


func _drop_focus_under_layer(event: InputEvent) -> void:
	# fixes-87 round 2: issue 11 outside play. A focus stays on its control
	# when a minigame, the ending, a close-up, the Pause sheet, the suitcase,
	# a Modern tool, an original page or the loading cover comes up over it:
	# Tools' hidden focus after the Tools > Journal route (on the desktop the
	# trivia and lab cannot take the focus themselves), a room hotspot's, an
	# original toolbar button's. Space, Enter and keypad Enter (ui_accept)
	# still pressed it there: Tools opened its dock unseen under the cover.
	# While play does not have the keyboard, a focus outside the topmost open
	# layer is released before the GUI sees these keys (press or release).
	# The key itself goes on, not marked handled: the layer's own focused
	# control, trivia's Space replay and the lab's and photo's Enter keep it.
	if not event is InputEventKey:
		return
	if (event as InputEventKey).keycode not in [KEY_SPACE, KEY_ENTER, KEY_KP_ENTER]:
		return
	if (
		_view_mode != ViewMode.ADVENTURE
		or _casebook_open
		or _transitioning
		or (is_instance_valid(_settings_overlay) and _settings_overlay.visible)
		or not is_instance_valid(_full_adventure)
		or not _full_adventure.is_visible_in_tree()
		or not _full_adventure.has_runtime_session()
		or _full_adventure.takes_play_keys()
	):
		return
	var focused: Control = get_viewport().gui_get_focus_owner()
	if focused == null:
		return
	if not _full_adventure.is_ancestor_of(focused) and focused.has_focus(true):
		# fixes-87 round 3 (review): no layer of the view lies over the shell's
		# own controls: the gameplay Settings button is drawn and picked over
		# every one (canvas z 2500, last in _body). Reached by Tab, its focus is
		# shown, and Enter or Space press it as in build 80 (Settings opens on
		# top). Releasing it here left a keyboard player no way to open
		# Settings over the Pause sheet, the suitcase, a close-up, a minigame
		# or an original page. A hidden (click) focus there is still dropped.
		return
	var layer: Control = _full_adventure.keyboard_layer()
	if layer != null and (focused == layer or layer.is_ancestor_of(focused)):
		return
	get_viewport().gui_release_focus()


func _make_section_label(value: String) -> Label:
	var result: Label = _make_label(value, 12, ACCENT)
	result.custom_minimum_size.y = 28.0
	result.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM
	return result


func _add_edition_setting(parent: VBoxContainer) -> void:
	var buttons := HBoxContainer.new()
	buttons.layout_direction = Control.LAYOUT_DIRECTION_LTR
	buttons.add_theme_constant_override("separation", 12)
	parent.add_child(buttons)
	for edition: String in ["modern", "legacy"]:
		var button := _make_secondary_button(edition.capitalize())
		button.name = "SettingsEdition" + edition.capitalize()
		button.custom_minimum_size = Vector2(140, 48)
		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		button.disabled = _edition_transitioning or (edition == _presentation_edition and _pending_edition.is_empty())
		button.pressed.connect(_request_settings_edition.bind(edition))
		buttons.add_child(button)
	_edition_status_label = _make_label("", 14, MUTED)
	_edition_status_label.name = "EditionSwitchStatus"
	_edition_status_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	parent.add_child(_edition_status_label)
	_update_edition_status()


func _update_edition_status() -> void:
	var message := "×”×¡×™×¤×•×¨ ×•×”×©×ž×™×¨×•×ª ×ž×©×•×ª×¤×™× ×œ×©×ª×™ ×”×ž×”×“×•×¨×•×ª." if _locale == "he" else "Both editions share your story and saves."
	if not _edition_switch_error.is_empty():
		message = _edition_switch_error
	elif _edition_transitioning:
		message = "×©×•×ž×¨×ª ×•×ž×—×œ×™×¤×” ×ž×”×“×•×¨×”â€¦" if _locale == "he" else "Saving and switching editionâ€¦"
	elif not _pending_edition.is_empty():
		message = (
			"×”×ž×¢×‘×¨ ×œÖ¾%s ×ž×ž×ª×™×Ÿ ×œ×¡×™×•× ×”×¤×¢×•×œ×”. ××¤×©×¨ ×œ×¡×’×•×¨ ××ª ×”×”×’×“×¨×•×ª ×•×œ×”×ž×©×™×š ×œ×©×—×§. ×œ×‘×™×˜×•×œ, ×‘×—×¨×™ ×‘×ž×”×“×•×¨×” ×”× ×•×›×—×™×ª."
			if _locale == "he"
			else "Switch to %s queued until this action finishes. Close Settings to continue playing. Select the current edition to cancel."
		) % _pending_edition.capitalize()
	if is_instance_valid(_edition_status_label):
		_edition_status_label.text = message
	if is_instance_valid(_gameplay_settings_button):
		_gameplay_settings_button.tooltip_text = message if not _pending_edition.is_empty() else _copy("settings")


func _request_settings_edition(edition: String) -> void:
	if edition not in ["modern", "legacy"] or _edition_transitioning or _transitioning:
		return
	_edition_switch_error = ""
	if _view_mode == ViewMode.MAIN_MENU:
		_select_edition(edition)
		_rebuild_settings()
		return
	if _view_mode != ViewMode.ADVENTURE or not is_instance_valid(_full_adventure):
		return
	_pending_edition = "" if edition == _presentation_edition else edition
	_rebuild_settings()


func _process(_delta: float) -> void:
	JuliaGameLocalization.apply_tree(get_tree().root)
	if _pending_edition.is_empty() or _edition_transitioning or _transitioning:
		return
	if _view_mode != ViewMode.ADVENTURE or not is_instance_valid(_full_adventure):
		_pending_edition = ""
		return
	if _full_adventure.can_switch_edition():
		_edition_transitioning = true
		_update_edition_status()
		call_deferred("_apply_pending_edition")


func _apply_pending_edition() -> void:
	var previous: JuliaFullAdventureView = _full_adventure
	if _view_mode != ViewMode.ADVENTURE or _pending_edition not in ["modern", "legacy"] or not is_instance_valid(previous) or not previous.can_switch_edition():
		_edition_transitioning = false
		_update_edition_status()
		return
	var desired := _pending_edition
	var checkpoint := previous.save_before_background()
	if not bool(checkpoint.get("ok", false)):
		_finish_failed_edition_switch("×œ× × ×™×ª×Ÿ ×œ×©×ž×•×¨. ×”×ž×©×—×§ × ×©××¨ ×‘×ž×”×“×•×¨×” ×”× ×•×›×—×™×ª." if _locale == "he" else "Could not save. Your current game is unchanged.")
		return

	var prior_process_mode := previous.process_mode
	previous.process_mode = Node.PROCESS_MODE_DISABLED
	var paused_players: Array[Dictionary] = []
	for node: Node in previous.find_children("*", "AudioStreamPlayer", true, false):
		var player := node as AudioStreamPlayer
		paused_players.append({"player": player, "paused": player.stream_paused})
		player.stream_paused = true
	var replacement: JuliaFullAdventureView = FULL_ADVENTURE_SCRIPT.new()
	replacement.name = "NextAdventureEdition"
	replacement.presentation_edition = desired
	replacement.catalog = previous.catalog
	replacement.save_store = previous.save_store
	# Failed loads must never touch the live journal or its read state.
	replacement.bind_journal(JuliaClueJournal.new())
	replacement.locale = previous.locale
	replacement.size = previous.size
	replacement.z_index = ADVENTURE_Z_INDEX
	replacement.visible = false
	replacement.process_mode = Node.PROCESS_MODE_DISABLED
	_body.add_child(replacement)
	replacement.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_layout_adventure_settings_access(replacement)
	var loaded: Dictionary = await replacement.load_slot(SAVE_STORE_SCRIPT.AUTOSAVE_SLOT_ID)
	if not bool(loaded.get("ok", false)):
		replacement.effect_host.stop_all(false)
		replacement.queue_free()
		previous.process_mode = prior_process_mode
		for record: Dictionary in paused_players:
			if is_instance_valid(record.player):
				record.player.stream_paused = record.paused
		_layout_adventure_settings_access(previous)
		_finish_failed_edition_switch("×”×ž×¢×‘×¨ ×œ× ×”×¦×œ×™×—. ×”×ž×©×—×§ ×”× ×•×›×—×™ × ×©×ž×¨ ×œ×œ× ×©×™× ×•×™." if _locale == "he" else "The edition could not load. Your current game is unchanged.")
		return

	previous.effect_host.stop_all(false)
	previous.hide()
	previous.name = "PreviousAdventureEdition"
	_full_adventure = replacement
	replacement.name = "FullAdventure"
	_presentation_edition = desired
	_adventure_start_generation += 1
	_adopt_adventure_journal(replacement.journal)
	replacement.casebook_requested.connect(_on_adventure_casebook_requested)
	replacement.settings_requested.connect(_open_settings)
	replacement.return_to_menu_requested.connect(_on_adventure_return_to_menu)
	replacement.locale_changed.connect(_on_adventure_locale_changed)
	replacement.set_master_volume(_master_volume)
	replacement.set_reduced_motion(_reduced_motion)
	replacement.set_settings_modal(_settings_overlay.visible)
	replacement.process_mode = Node.PROCESS_MODE_INHERIT
	replacement.show()
	previous.queue_free()
	_pending_edition = ""
	_edition_transitioning = false
	_save_preferences()
	_layout_body()
	if _settings_overlay.visible:
		_rebuild_settings()
	else:
		replacement.call("_show_toast", ("×”×ž×”×“×•×¨×” ×”×•×—×œ×¤×” ×œÖ¾%s" if _locale == "he" else "Switched to %s") % desired.capitalize())
	_update_casebook_access()
	call_deferred("_qa_render_state", "edition_switched")


func _finish_failed_edition_switch(message: String) -> void:
	_pending_edition = ""
	_edition_transitioning = false
	_edition_switch_error = message
	if not _settings_overlay.visible:
		_open_settings()
	else:
		_rebuild_settings()


func _adopt_adventure_journal(next_journal: JuliaClueJournal) -> void:
	for binding: Array in [
		["clue_discovered", _on_casebook_clue_discovered],
		["clue_read_state_changed", _on_casebook_read_state_changed],
		["journal_restored", _on_casebook_journal_refreshed],
		["journal_cleared", _on_casebook_journal_refreshed],
	]:
		if _clue_journal.is_connected(binding[0], binding[1]):
			_clue_journal.disconnect(binding[0], binding[1])
		next_journal.connect(binding[0], binding[1])
	_clue_journal = next_journal
	_casebook_view.bind_journal(_clue_journal)


func _layout_adventure_settings_access(view: JuliaFullAdventureView) -> void:
	if not is_instance_valid(_gameplay_settings_button):
		return
	_gameplay_settings_button.text = _copy("settings")
	_apply_button_direction(_gameplay_settings_button)
	_gameplay_settings_button.layout_direction = Control.LAYOUT_DIRECTION_LTR
	var available := _body.size
	var portrait: bool = WebLayout.enabled() and view.presentation_edition == "modern" and available.x < 700 and available.y > available.x
	var artwork := SafeStageLayout.aspect_fit_rect(available, Vector2(640, 480))
	var button_size := Vector2(maxf(110 if portrait else 128, _gameplay_settings_button.get_minimum_size().x), 48)
	_gameplay_settings_button.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	_gameplay_settings_button.size = button_size
	view.offset_top = 0
	if portrait:
		view.offset_top = 56
		_gameplay_settings_button.position = Vector2(available.x - button_size.x - 12, 4)
	elif artwork.position.x >= button_size.x + 16:
		_gameplay_settings_button.position = Vector2((artwork.position.x - button_size.x) * 0.5, 12)
	else:
		# A separate strip keeps Settings clear of every original score control.
		view.offset_top = 64
		_gameplay_settings_button.position = Vector2((available.x - button_size.x) * 0.5, 8)
	_gameplay_settings_button.visible = _view_mode == ViewMode.ADVENTURE
	# GUI picking follows sibling order, independently of drawing z_index.
	_body.move_child(_gameplay_settings_button, -1)
	# fixes-87 round 3 (review): the view keeps its item close-up card clear of
	# this button, which lies over the whole view (at 844x390 the card's Close
	# was under it: a tap on Close opened Settings). In the view's coordinates.
	view.keep_clear_of_shell_button(
		Rect2(_gameplay_settings_button.position - Vector2(view.offset_left, view.offset_top), button_size)
		if _gameplay_settings_button.visible
		else Rect2()
	)


func _make_setting_row(
	parent: VBoxContainer,
	title_text: String,
	description_text: String
) -> BoxContainer:
	var card: PanelContainer = PanelContainer.new()
	card.custom_minimum_size.y = 68.0 if not _large_text else 80.0
	card.add_theme_stylebox_override(
		"panel",
		JuliaThemeFactory.make_box(
			Color(PAPER, 0.72),
			Color(MUTED, 0.34),
			1,
			0,
			14.0,
			8.0
		)
	)
	parent.add_child(card)

	var row: BoxContainer = BoxContainer.new() if WebLayout.enabled() else HBoxContainer.new()
	if WebLayout.enabled():
		row.name = "WebSettingRow"
		row.vertical = size.x < 600.0
	row.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL if _locale == "he" else Control.LAYOUT_DIRECTION_LTR
	)
	row.add_theme_constant_override("separation", 18)
	card.add_child(row)

	var text_stack: VBoxContainer = VBoxContainer.new()
	text_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text_stack.add_theme_constant_override("separation", 2)
	row.add_child(text_stack)
	text_stack.add_child(_make_label(title_text, 16 if not _large_text else 19, INK))
	var description: Label = _make_label(description_text, 12 if not _large_text else 14, MUTED)
	description.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	text_stack.add_child(description)
	return row


func _style_option_button(button: OptionButton) -> void:
	if WebLayout.enabled(): button.custom_minimum_size.y = 48.0
	_apply_button_direction(button)
	button.alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT
		if _locale == "he"
		else HORIZONTAL_ALIGNMENT_LEFT
	)
	button.add_theme_color_override("font_color", INK)
	button.add_theme_color_override("font_hover_color", INK)
	button.add_theme_color_override("font_pressed_color", INK)
	button.add_theme_color_override("font_focus_color", INK)

	var normal: StyleBoxFlat = StyleBoxFlat.new()
	normal.bg_color = PAPER_DEEP
	normal.border_color = Color(MUTED, 0.44)
	normal.border_width_bottom = 2
	normal.content_margin_left = 12.0
	normal.content_margin_right = 12.0
	normal.content_margin_top = 8.0
	normal.content_margin_bottom = 8.0
	var hover: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	hover.bg_color = Color("f2dfad")
	hover.border_color = ACCENT
	var pressed: StyleBoxFlat = hover.duplicate() as StyleBoxFlat
	pressed.bg_color = Color("e9d092")
	var focus: StyleBoxFlat = normal.duplicate() as StyleBoxFlat
	focus.border_color = TEAL
	focus.border_width_bottom = 3
	button.add_theme_stylebox_override("normal", normal)
	button.add_theme_stylebox_override("hover", hover)
	button.add_theme_stylebox_override("pressed", pressed)
	button.add_theme_stylebox_override("focus", focus)


func _add_toggle_setting(
	parent: VBoxContainer,
	title_text: String,
	description_text: String,
	current_value: bool,
	callback: Callable
) -> void:
	var row: BoxContainer = _make_setting_row(parent, title_text, description_text)
	var toggle: CheckButton = CheckButton.new()
	toggle.text = _copy("on") if current_value else _copy("off")
	toggle.button_pressed = current_value
	toggle.custom_minimum_size.x = 112.0
	if WebLayout.enabled(): toggle.custom_minimum_size.y = 48.0
	toggle.add_theme_color_override("font_color", INK)
	toggle.add_theme_color_override("font_hover_color", ACCENT)
	toggle.add_theme_color_override("font_pressed_color", CORAL)
	_apply_button_direction(toggle)
	toggle.toggled.connect(
		func(enabled: bool) -> void:
			toggle.text = _copy("on") if enabled else _copy("off")
			callback.call(enabled)
	)
	row.add_child(toggle)


func _add_language_setting(parent: VBoxContainer) -> void:
	var row: BoxContainer = _make_setting_row(parent, _copy("language"), _copy("language_description"))
	var choice: OptionButton = OptionButton.new()
	choice.custom_minimum_size.x = 148.0
	_style_option_button(choice)
	choice.name = "GameLanguageChoice"
	for index: int in JuliaGameLocalization.CODES.size():
		choice.add_item(JuliaGameLocalization.NAMES[index], index)
	choice.select(JuliaGameLocalization.CODES.find(_locale))
	choice.item_selected.connect(_on_language_selected)
	row.add_child(choice)


func _add_screen_setting(parent: VBoxContainer) -> void:
	var screen_count: int = DisplayServer.get_screen_count()
	if screen_count <= 1:
		return
	var row: BoxContainer = _make_setting_row(parent, _copy("screen"), _copy("screen_description"))
	var choice: OptionButton = OptionButton.new()
	choice.custom_minimum_size.x = 210.0
	_style_option_button(choice)
	var current: int = get_window().current_screen
	for screen_index: int in range(screen_count):
		var screen_size: Vector2i = DisplayServer.screen_get_size(screen_index)
		choice.add_item(
			"\u200e%d \u00b7 %d\u00d7%d\u200e"
			% [screen_index + 1, screen_size.x, screen_size.y],
			screen_index
		)
	choice.select(clampi(current, 0, screen_count - 1))
	choice.item_selected.connect(_on_screen_selected)
	row.add_child(choice)


func _add_filter_setting(parent: VBoxContainer) -> void:
	var row: BoxContainer = _make_setting_row(parent, _copy("pixel_filter"), _copy("pixel_filter_description"))
	var choice: OptionButton = OptionButton.new()
	choice.custom_minimum_size.x = 148.0
	_style_option_button(choice)
	choice.add_item(_copy("filter_smooth"), 0)
	choice.add_item(_copy("filter_crisp"), 1)
	choice.select(1 if _crisp_filter else 0)
	choice.item_selected.connect(_on_filter_selected)
	row.add_child(choice)


func _add_volume_setting(parent: VBoxContainer) -> void:
	var row: BoxContainer = _make_setting_row(parent, _copy("master_volume"), _copy("master_volume_description"))
	var slider: HSlider = HSlider.new()
	slider.name = "MasterVolumeSlider"
	slider.custom_minimum_size.y = 48.0
	slider.custom_minimum_size.x = 220.0
	slider.min_value = 0.0
	slider.max_value = 1.0
	slider.step = 0.01
	slider.value = _master_volume
	slider.value_changed.connect(_on_volume_changed)
	row.add_child(slider)


func _add_audio_category_setting(parent: VBoxContainer, category: String) -> void:
	var titles := {
		"music": ["×ž×•×–×™×§×”", "Music"],
		"voice": ["×“×™×‘×•×¨", "Voice"],
		"effects": ["××¤×§×˜×™×", "Sound effects"],
	}
	var title: String = titles[category][0 if _locale == "he" else 1]
	var row := _make_setting_row(parent, title, "" )
	var slider := HSlider.new()
	slider.name = category.capitalize() + "VolumeSlider"
	slider.custom_minimum_size = Vector2(220, 48)
	slider.min_value = 0.0
	slider.max_value = 1.0
	slider.step = 0.01
	slider.value = AudioPreferences.level(category)
	slider.tooltip_text = title
	slider.value_changed.connect(func(value: float) -> void: AudioPreferences.set_level(category, value))
	row.add_child(slider)


func _on_language_selected(index: int) -> void:
	_locale = JuliaGameLocalization.CODES[index]
	_apply_locale()
	_save_preferences()
	_sync_web_language()


func _on_screen_selected(index: int) -> void:
	var was_fullscreen: bool = _is_fullscreen()
	if was_fullscreen:
		get_window().mode = Window.MODE_WINDOWED
	get_window().current_screen = index
	if was_fullscreen:
		get_window().mode = (
			Window.MODE_FULLSCREEN if OS.has_feature("web") else Window.MODE_EXCLUSIVE_FULLSCREEN
		)
	_save_preferences()


func _on_filter_selected(index: int) -> void:
	_crisp_filter = index == 1
	_apply_texture_filter()
	_save_preferences()


func _on_fullscreen_setting_toggled(enabled: bool) -> void:
	_set_fullscreen(enabled)


func _on_high_contrast_toggled(enabled: bool) -> void:
	_high_contrast = enabled
	_apply_theme()
	_rebuild_side_content()
	_rebuild_settings()
	_save_preferences()


func _on_large_text_toggled(enabled: bool) -> void:
	_large_text = enabled
	_apply_theme()
	_rebuild_side_content()
	_rebuild_settings()
	_save_preferences()


func _on_reduced_motion_toggled(enabled: bool) -> void:
	_reduced_motion = enabled
	if is_instance_valid(_full_adventure):
		_full_adventure.set_reduced_motion(enabled)
	_save_preferences()


func _on_volume_changed(value: float) -> void:
	_master_volume = value
	_apply_audio()
	_save_preferences()


func _toggle_fullscreen() -> void:
	_set_fullscreen(not _is_fullscreen())


func _set_fullscreen(enabled: bool) -> void:
	if enabled:
		get_window().mode = (
			Window.MODE_FULLSCREEN if OS.has_feature("web") else Window.MODE_EXCLUSIVE_FULLSCREEN
		)
	else:
		get_window().mode = Window.MODE_WINDOWED
	_update_fullscreen_button()
	_save_preferences()


func _is_fullscreen() -> bool:
	return get_window().mode in [Window.MODE_FULLSCREEN, Window.MODE_EXCLUSIVE_FULLSCREEN]


func _update_fullscreen_button() -> void:
	if not is_instance_valid(_fullscreen_button):
		return
	_fullscreen_button.text = _copy("windowed") if _is_fullscreen() else _copy("fullscreen")


func _apply_texture_filter() -> void:
	if not is_instance_valid(_stage_texture):
		return
	_stage_texture.texture_filter = (
		CanvasItem.TEXTURE_FILTER_NEAREST if _crisp_filter else CanvasItem.TEXTURE_FILTER_LINEAR
	)
	if is_instance_valid(_lamp_overlay):
		_lamp_overlay.texture_filter = _stage_texture.texture_filter
	for sprite: TextureRect in [
		_dylen_sprite,
		_dad_sprite,
		_mam_sprite,
		_boy_overlay,
	]:
		if is_instance_valid(sprite):
			sprite.texture_filter = _stage_texture.texture_filter
	if is_instance_valid(_mell_portrait):
		_mell_portrait.texture_filter = _stage_texture.texture_filter


func _apply_audio() -> void:
	AudioPreferences.apply()
	var bus_index: int = AudioServer.get_bus_index("Master")
	if bus_index < 0:
		return
	AudioServer.set_bus_mute(bus_index, _master_volume <= 0.001)
	AudioServer.set_bus_volume_db(
		bus_index,
		linear_to_db(maxf(_master_volume, 0.001))
	)
	if is_instance_valid(_full_adventure):
		_full_adventure.set_master_volume(_master_volume)


func _enter_street5() -> void:
	_street_view = StreetView.STREET5
	_street_transitioning = false
	_stage_texture.modulate.a = 1.0
	_lamp_playback_generation += 1
	_lamp_animation_running = false
	_lamp_overlay.visible = false
	_lamp_overlay.texture = null
	_boy_playback_generation += 1
	_boy_overlay.visible = false
	_boy_overlay.texture = null
	_mell_playback_generation += 1
	_mell_frame_index = 0
	_voice_playback_generation += 1
	_dialogue_step = DialogueStep.OPENING
	_dialogue_busy = true
	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_intro"
	_asked_where = false
	_asked_what = false
	_asked_follow_up = false
	_set_dad_active(false)
	_mam_sprite.texture = _load_texture(STREET5_MAM_PATH)
	if _mell_frames.is_empty():
		_load_mell_frames()

	_street5_slice = JuliaStreet5VerticalSlice.new()
	if not _street5_slice.enter():
		push_error(_street5_slice.error_message)
		_sync_street5_nodes()
		return
	_play_street5_audio()
	_sync_street5_nodes()


func _leave_street5() -> void:
	if _casebook_open:
		_close_casebook()
	_street_view = StreetView.STREET5
	_street_transitioning = false
	if is_instance_valid(_stage_texture):
		_stage_texture.modulate.a = 1.0
	_lamp_playback_generation += 1
	_lamp_animation_running = false
	_boy_playback_generation += 1
	_mell_playback_generation += 1
	_mell_frame_index = 0
	_voice_playback_generation += 1
	_dialogue_busy = false
	if is_instance_valid(_lamp_overlay):
		_lamp_overlay.visible = false
		_lamp_overlay.texture = null
	if is_instance_valid(_boy_overlay):
		_boy_overlay.visible = false
		_boy_overlay.texture = null
	if is_instance_valid(_ambient_player):
		_ambient_player.stop()
		_ambient_player.stream = null
	if is_instance_valid(_voice_player):
		_voice_player.stop()
		_voice_player.stream = null
	if is_instance_valid(_sfx_player):
		_sfx_player.stop()
		_sfx_player.stream = null
	_street5_slice = null
	_sync_street5_nodes()


func _enter_full_adventure() -> void:
	_adventure_start_generation += 1
	var generation: int = _adventure_start_generation
	if not is_instance_valid(_full_adventure):
		_full_adventure = FULL_ADVENTURE_SCRIPT.new()
		_full_adventure.presentation_edition = _presentation_edition
		_full_adventure.name = "FullAdventure"
		_full_adventure.z_index = ADVENTURE_Z_INDEX
		# Give child stage controls their actual viewport before _ready builds
		# and sizes them during the Android intro-to-game handoff.
		_full_adventure.size = _body.size
		_body.add_child(_full_adventure)
		_full_adventure.set_anchors_and_offsets_preset(
			Control.PRESET_FULL_RECT
		)
		_full_adventure.bind_journal(_clue_journal)
		_full_adventure.casebook_requested.connect(_on_adventure_casebook_requested)
		_full_adventure.return_to_menu_requested.connect(
			_on_adventure_return_to_menu
		)
		_full_adventure.settings_requested.connect(_open_settings)
		_full_adventure.locale_changed.connect(
			_on_adventure_locale_changed
		)
	_full_adventure.visible = true
	_layout_adventure_settings_access(_full_adventure)
	_full_adventure.set_locale(_locale)
	_full_adventure.set_master_volume(_master_volume)
	_full_adventure.set_reduced_motion(_reduced_motion)
	var resume_slot: String = _pending_load_slot
	_pending_load_slot = ""
	_start_full_adventure(generation, resume_slot)


func _start_full_adventure(
	generation: int, resume_slot: String = ""
) -> void:
	var result: Dictionary
	if resume_slot.is_empty():
		result = await _full_adventure.start_new_game(
			"heb" if _locale == "he" else _locale
		)
	else:
		result = await _full_adventure.load_slot(resume_slot)
	if generation != _adventure_start_generation:
		return
	if not bool(result.get("ok", false)):
		while _transitioning:
			await get_tree().process_frame
		_transition_to(ViewMode.MAIN_MENU)
		return
	if not resume_slot.is_empty():
		_apply_locale()
	_update_casebook_access()
	call_deferred("_qa_render_state", "adventure")


func _leave_full_adventure() -> void:
	_adventure_start_generation += 1
	if not is_instance_valid(_full_adventure):
		return
	_full_adventure.visible = false
	if is_instance_valid(_full_adventure.effect_host):
		_full_adventure.effect_host.stop_all(false)


func _on_adventure_casebook_requested() -> void:
	if not _open_casebook():
		_show_toast(_copy("casebook_wait_hint"))


func _on_adventure_return_to_menu() -> void:
	_pending_edition = ""
	_edition_switch_error = ""
	_settings_overlay.hide()
	_transition_to(ViewMode.MAIN_MENU)


func _on_adventure_locale_changed(_active_locale: String) -> void:
	_update_casebook_access()


func _play_street5_audio() -> void:
	var ambient_stream: Resource = load(STREET5_AMBIENT_PATH)
	if ambient_stream is AudioStream:
		_ambient_player.stream = ambient_stream as AudioStream
		_ambient_player.play()

	_play_opening_greeting()


func _play_opening_greeting() -> void:
	var playback_generation: int = _voice_playback_generation
	var entrance_sound_duration: float = _play_sfx(MELL_IN_PATH)
	if entrance_sound_duration > 0.0:
		await get_tree().create_timer(entrance_sound_duration).timeout
	if (
		playback_generation != _voice_playback_generation
		or _view_mode != ViewMode.FIRST_SCENE
	):
		return
	if not await _play_voice_clip(
		STREET5_INTRO_PATH,
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.OPENING,
			playback_generation
		)
		return
	_dialogue_busy = false
	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_choose"
	_refresh_street5_presentation()


func _skip_opening_greeting() -> void:
	if (
		_casebook_open
		or not _dialogue_busy
		or _dialogue_step != DialogueStep.OPENING
		or _dialogue_line_key != "dialogue_intro"
	):
		return
	_voice_playback_generation += 1
	_mell_playback_generation += 1
	_mell_frame_index = 0
	_voice_player.stop()
	_voice_player.stream = null
	_sfx_player.stop()
	_sfx_player.stream = null
	_dialogue_busy = false
	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_choose"
	_refresh_street5_presentation()


func _retry_street5() -> void:
	_enter_street5()
	_update_stage_content()
	_rebuild_side_content()
	_update_footer()


func _restart_street5_conversation() -> void:
	if _dialogue_busy or _casebook_open:
		return
	_enter_street5()
	_update_stage_content()
	_rebuild_side_content()


func _refresh_street5_presentation() -> void:
	if _view_mode != ViewMode.FIRST_SCENE:
		return
	_sync_street5_nodes()
	_update_stage_labels()
	_rebuild_side_content()
	_update_footer()
	_layout_body()


func _on_opening_choice(choice_index: int) -> void:
	if _dialogue_busy or _casebook_open:
		return
	if choice_index == 1:
		_asked_where = true
		if _street5_slice != null:
			_street5_slice.run_section("Qtn1_1")
		await _play_question_and_answer(
			"question_where",
			"answer_where",
			"choice_where",
			DialogueStep.OPENING
		)
		return
	_asked_what = true
	if _street5_slice != null:
		_street5_slice.run_section("Qtn1_2")
	await _play_question_and_answer(
		"question_what",
		"answer_what",
		"choice_what",
		DialogueStep.FOLLOW_UP
	)


func _on_follow_up_choice() -> void:
	if _dialogue_busy or _casebook_open:
		return
	_asked_follow_up = true
	if _street5_slice != null:
		_street5_slice.run_section("Qtn12_1")
	await _play_question_and_answer(
		"question_follow_up",
		"answer_follow_up",
		"choice_follow_up",
		DialogueStep.OPENING
	)


func _play_question_and_answer(
	question_audio_key: String,
	answer_audio_key: String,
	question_line_key: String,
	next_step: int
) -> void:
	_dialogue_busy = true
	_voice_playback_generation += 1
	var playback_generation: int = _voice_playback_generation
	_dialogue_speaker_key = "speaker_julia"
	_dialogue_line_key = question_line_key
	_refresh_street5_presentation()

	if not await _play_voice_clip(
		str(STREET5_VOICE_PATHS[question_audio_key]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.OPENING,
			playback_generation
		)
		return

	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_response_playing"
	_refresh_street5_presentation()
	if not await _play_voice_clip(
		str(STREET5_VOICE_PATHS[answer_audio_key]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.OPENING,
			playback_generation
		)
		return

	if STREET5_DIALOGUE_CLUES.has(answer_audio_key):
		_discover_street5_clue(
			str(STREET5_DIALOGUE_CLUES[answer_audio_key])
		)
	_dialogue_step = next_step as DialogueStep
	_dialogue_busy = false
	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_choose"
	_refresh_street5_presentation()


func _finish_opening_conversation() -> void:
	if _dialogue_busy or _casebook_open:
		return
	_dialogue_busy = true
	_voice_playback_generation += 1
	var playback_generation: int = _voice_playback_generation
	_dialogue_speaker_key = "speaker_julia"
	_dialogue_line_key = "dialogue_goodbye"
	_refresh_street5_presentation()
	if not await _play_voice_clip(
		str(STREET5_VOICE_PATHS["question_goodbye"]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.OPENING,
			playback_generation
		)
		return

	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "dialogue_response_playing"
	_refresh_street5_presentation()
	if not await _play_voice_clip(
		str(STREET5_VOICE_PATHS["answer_goodbye"]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.OPENING,
			playback_generation
		)
		return

	var close_sound_duration: float = _play_sfx(MELL_OUT_PATH)
	if close_sound_duration > 0.0:
		await get_tree().create_timer(close_sound_duration).timeout
	if (
		playback_generation != _voice_playback_generation
		or _view_mode != ViewMode.FIRST_SCENE
	):
		return

	if _street5_slice != null:
		_street5_slice.run_section("CloseDB1")
	_dialogue_step = DialogueStep.FAMILY
	_dialogue_busy = false
	_dialogue_speaker_key = "speaker_mell"
	_dialogue_line_key = "family_prompt"
	_set_dad_active(false)
	_mam_sprite.texture = _load_texture(STREET5_MAM_PATH)
	_refresh_street5_presentation()


func _play_voice_clip(
	path: String,
	playback_generation: int
) -> bool:
	var loaded_stream: Resource = load(path)
	if not loaded_stream is AudioStream:
		push_error("Missing dialogue audio: %s" % path)
		return false
	if (
		playback_generation != _voice_playback_generation
		or _view_mode != ViewMode.FIRST_SCENE
	):
		return false
	var stream: AudioStream = loaded_stream as AudioStream
	_voice_player.stop()
	_voice_player.stream = stream
	_voice_player.play()
	var duration: float = maxf(stream.get_length(), 0.1)
	if _dialogue_speaker_key == "speaker_mell":
		return await _animate_mell_speaking(
			duration,
			playback_generation
		)
	await get_tree().create_timer(duration + 0.04).timeout
	return (
		playback_generation == _voice_playback_generation
		and _view_mode == ViewMode.FIRST_SCENE
	)


func _animate_mell_speaking(
	duration: float,
	voice_generation: int
) -> bool:
	if _mell_frames.is_empty():
		_load_mell_frames()
	if _mell_frames.is_empty():
		await get_tree().create_timer(duration + 0.04).timeout
		return (
			voice_generation == _voice_playback_generation
			and _view_mode == ViewMode.FIRST_SCENE
		)

	_mell_playback_generation += 1
	var mell_generation: int = _mell_playback_generation
	var frame_count: int = maxi(
		1,
		int(ceil(duration / MELL_FRAME_SECONDS))
	)
	_set_mell_frame(0)
	for animation_index: int in range(frame_count):
		await get_tree().create_timer(MELL_FRAME_SECONDS).timeout
		if (
			voice_generation != _voice_playback_generation
			or mell_generation != _mell_playback_generation
			or _view_mode != ViewMode.FIRST_SCENE
		):
			_set_mell_frame(0)
			return false
		# The original Lingo starts on frame 1, then advances on the first
		# 15-fps speech tick and displays EndAnim for one full tick.
		_set_mell_frame((animation_index + 1) % _mell_frames.size())
	_set_mell_frame(0)
	return (
		voice_generation == _voice_playback_generation
		and _view_mode == ViewMode.FIRST_SCENE
	)


func _set_mell_frame(frame_index: int) -> void:
	if _mell_frames.is_empty():
		_mell_frame_index = 0
		return
	_mell_frame_index = clampi(frame_index, 0, _mell_frames.size() - 1)
	if is_instance_valid(_mell_portrait):
		_mell_portrait.texture = _mell_frames[_mell_frame_index]


func _load_mell_frames() -> void:
	_mell_frames.clear()
	for frame_number: int in range(
		MELL_FIRST_FRAME,
		MELL_LAST_FRAME + 1
	):
		var member_name: String = (
			"EndAnim"
			if frame_number == MELL_LAST_FRAME
			else "Mel_frame_%d" % (
				frame_number - MELL_FIRST_FRAME + 1
			)
		)
		var path: String = (
			"res://assets/legacy/global_cast/"
			+ "%04d_%s.png" % [frame_number, member_name]
		)
		var frame_texture: Texture2D = _load_texture(path)
		if frame_texture != null:
			_mell_frames.append(frame_texture)


func _play_sfx(path: String) -> float:
	var loaded_stream: Resource = load(path)
	if not loaded_stream is AudioStream:
		push_error("Missing interface sound: %s" % path)
		return 0.0
	var stream: AudioStream = loaded_stream as AudioStream
	_sfx_player.stop()
	_sfx_player.stream = stream
	_sfx_player.play()
	return maxf(stream.get_length(), 0.0)


func _recover_dialogue_after_media_failure(
	fallback_step: int,
	playback_generation: int
) -> void:
	if (
		_view_mode != ViewMode.FIRST_SCENE
		or playback_generation != _voice_playback_generation
	):
		return
	_dialogue_busy = false
	_dialogue_step = fallback_step as DialogueStep
	_dialogue_speaker_key = (
		"speaker_julia"
		if fallback_step == DialogueStep.EXPLORE
		else "speaker_mell"
	)
	_dialogue_line_key = "dialogue_media_error"
	_refresh_street5_presentation()
	_show_toast(_copy("dialogue_media_error"))


func _on_father_pressed() -> void:
	await _select_family_portrait(true)


func _on_mother_pressed() -> void:
	await _select_family_portrait(false)


func _select_family_portrait(father: bool) -> void:
	if (
		_dialogue_busy
		or _casebook_open
		or _dialogue_step != DialogueStep.FAMILY
		or _view_mode != ViewMode.FIRST_SCENE
	):
		return
	_dialogue_busy = true
	_voice_playback_generation += 1
	var playback_generation: int = _voice_playback_generation
	_play_sfx(CLICK_BUTTON_PATH)
	if father:
		_set_dad_active(true)
		_dialogue_line_key = "family_father_speaks"
		if _street5_slice != null:
			_street5_slice.run_section("FatherClick")
	else:
		_mam_sprite.texture = _load_texture(STREET5_MAM_ACTIVE_PATH)
		_dialogue_line_key = "family_mother_speaks"
		if _street5_slice != null:
			_street5_slice.run_section("MotherClick")
	_dialogue_speaker_key = (
		"speaker_left_portrait"
		if father
		else "speaker_right_portrait"
	)
	_refresh_street5_presentation()

	var family_audio_key: String = "father" if father else "mother"
	if not await _play_voice_clip(
		str(STREET5_VOICE_PATHS[family_audio_key]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.FAMILY,
			playback_generation
		)
		return

	_dialogue_step = DialogueStep.EXPLORE
	_dialogue_speaker_key = "speaker_julia"
	_dialogue_line_key = "face_selected_line"
	_refresh_street5_presentation()
	if not await _play_boy_animation_with_voice(
		str(STREET5_VOICE_PATHS["face_selected"]),
		playback_generation
	):
		_recover_dialogue_after_media_failure(
			DialogueStep.EXPLORE,
			playback_generation
		)
		return

	_discover_street5_clue("street5_dylen_reaction")
	_dialogue_busy = false
	_dialogue_speaker_key = "speaker_julia"
	_dialogue_line_key = "explore_prompt"
	_set_dad_active(false)
	_mam_sprite.texture = _load_texture(STREET5_MAM_PATH)
	_refresh_street5_presentation()


func _play_boy_animation_with_voice(
	voice_path: String,
	playback_generation: int
) -> bool:
	if _boy_frames.is_empty():
		_load_boy_frames()
	if _boy_frames.is_empty():
		push_error("The recovered character animation is unavailable.")
		return false
	var loaded_stream: Resource = load(voice_path)
	if not loaded_stream is AudioStream:
		push_error("Missing character audio: %s" % voice_path)
		return false

	var stream: AudioStream = loaded_stream as AudioStream
	_voice_player.stop()
	_voice_player.stream = stream
	_voice_player.play()
	_boy_playback_generation += 1
	var boy_generation: int = _boy_playback_generation
	_boy_overlay.visible = true
	var frame_count: int = maxi(
		_boy_frames.size(),
		int(ceil(maxf(stream.get_length(), 0.1) / BOY_FRAME_SECONDS))
	)
	for frame_index: int in range(frame_count):
		if (
			playback_generation != _voice_playback_generation
			or boy_generation != _boy_playback_generation
			or _view_mode != ViewMode.FIRST_SCENE
		):
			_boy_overlay.visible = false
			_boy_overlay.texture = null
			return false
		_boy_overlay.texture = _make_dylen_face_frame(
			_boy_frames[frame_index % _boy_frames.size()]
		)
		await get_tree().create_timer(BOY_FRAME_SECONDS).timeout
	_boy_overlay.visible = false
	_boy_overlay.texture = null
	return true


func _make_dylen_face_frame(source: Texture2D) -> AtlasTexture:
	var result: AtlasTexture = AtlasTexture.new()
	result.atlas = source
	result.region = Rect2(77.0, 204.0, 28.0, 38.0)
	return result


func _load_boy_frames() -> void:
	for frame_number: int in range(
		BOY_FIRST_FRAME,
		BOY_LAST_FRAME + 1
	):
		var path: String = (
			"res://assets/legacy/street5_cast/"
			+ "%04d_Boy_frame_%d.png"
			% [frame_number, frame_number - BOY_FIRST_FRAME + 1]
		)
		var frame_texture: Texture2D = _load_texture(path)
		if frame_texture != null:
			_boy_frames.append(frame_texture)


func _on_ambient_finished() -> void:
	if (
		_view_mode == ViewMode.FIRST_SCENE
		and is_instance_valid(_ambient_player)
		and _ambient_player.stream != null
	):
		_ambient_player.play()


func _play_lamp_animation() -> void:
	if _casebook_open or _lamp_animation_running:
		return
	if _lamp_frames.is_empty():
		_load_lamp_frames()
	if _lamp_frames.is_empty():
		_show_toast(_copy("runtime_unavailable"))
		return

	_lamp_animation_running = true
	_update_casebook_access()
	_lamp_playback_generation += 1
	var playback_generation: int = _lamp_playback_generation
	_lamp_overlay.visible = true
	for frame_texture: Texture2D in _lamp_frames:
		if (
			playback_generation != _lamp_playback_generation
			or _view_mode != ViewMode.FIRST_SCENE
		):
			break
		_lamp_overlay.texture = frame_texture
		await get_tree().create_timer(LAMP_FRAME_SECONDS).timeout

	if playback_generation == _lamp_playback_generation:
		_lamp_overlay.visible = false
		_lamp_overlay.texture = null
	_lamp_animation_running = false
	_update_casebook_access()


func _load_lamp_frames() -> void:
	for frame_number: int in range(
		LAMP_FIRST_FRAME,
		LAMP_LAST_FRAME + 1
	):
		var path: String = (
			"res://assets/legacy/street5_cast/"
			+ "%04d_s5_anm1_frame_%d.png"
			% [frame_number, frame_number - LAMP_FIRST_FRAME + 1]
		)
		var frame_texture: Texture2D = _load_texture(path)
		if frame_texture != null:
			_lamp_frames.append(frame_texture)


func _on_stage_hotspot_pressed() -> void:
	_on_world_hotspot_pressed("neon")


func _on_placeholder_action() -> void:
	_show_toast(_copy("placeholder_action"))


func _show_toast(message: String) -> void:
	# fixes-87: a message raised while Settings is open ("The credits could not
	# be opened") drew under the settings overlay (3050): in play in the
	# view's toast (620), elsewhere in this panel (80). While Settings is open
	# this panel shows it, raised above the overlay and its credits.
	var over_settings: bool = (
		is_instance_valid(_settings_overlay) and _settings_overlay.visible
		and not _settings_closing
	)
	if (
		not over_settings
		and _view_mode == ViewMode.ADVENTURE
		and is_instance_valid(_full_adventure)
		and _full_adventure.is_visible_in_tree()
	):
		# This panel (z 80) draws under the adventure view (ADVENTURE_Z_INDEX
		# 120, opaque ground), so a message raised during play, such as the
		# casebook wait hint, was never seen. Use the view's own toast, as
		# the edition switch does: the place and style of every in-game
		# message, above the view's sheets and, in Modern, clear of the
		# conversation questions. Both editions: this is remake UI.
		_full_adventure.call("_show_toast", message)
		return
	_toast_panel.z_index = SETTINGS_TOAST_Z_INDEX if over_settings else TOAST_Z_INDEX
	_toast_label.text = message
	_layout_toast()
	if is_instance_valid(_toast_tween):
		_toast_tween.kill()
	if _reduced_motion:
		_toast_panel.modulate.a = 1.0
		await get_tree().create_timer(1.7).timeout
		_toast_panel.modulate.a = 0.0
		_toast_panel.z_index = TOAST_Z_INDEX
		return
	_toast_panel.modulate.a = 0.0
	_toast_panel.position.y += 10.0
	_toast_tween = create_tween()
	_toast_tween.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	_toast_tween.set_parallel(true)
	_toast_tween.tween_property(_toast_panel, "modulate:a", 1.0, 0.16)
	_toast_tween.tween_property(_toast_panel, "position:y", _toast_panel.position.y - 10.0, 0.16)
	_toast_tween.set_parallel(false)
	_toast_tween.tween_interval(1.55)
	_toast_tween.tween_property(_toast_panel, "modulate:a", 0.0, 0.18)
	# Faded out: back at its usual z (fixes-87).
	_toast_tween.tween_callback(func() -> void: _toast_panel.z_index = TOAST_Z_INDEX)


func _run_packaged_street5_qa() -> void:
	await get_tree().process_frame
	_set_view(ViewMode.FIRST_SCENE)
	await get_tree().process_frame
	await get_tree().process_frame
	var entrance_check_stream: Resource = load(MELL_IN_PATH)
	if entrance_check_stream is AudioStream:
		await get_tree().create_timer(
			(entrance_check_stream as AudioStream).get_length() + 0.1
		).timeout
	_load_lamp_frames()
	_load_boy_frames()
	_load_mell_frames()

	var failures: Array[String] = []
	for required_file: String in [
		"res://data/legacy/global.inf",
		"res://data/legacy/heb/street5.inf",
		"res://data/legacy/JADE.original.INI",
	]:
		if not FileAccess.file_exists(required_file):
			failures.append("missing packaged data: %s" % required_file)
	for voice_path: Variant in STREET5_VOICE_PATHS.values():
		if not ResourceLoader.exists(str(voice_path)):
			failures.append("missing packaged voice: %s" % str(voice_path))
		else:
			var voice_resource: Resource = load(str(voice_path))
			if (
				not voice_resource is AudioStream
				or (voice_resource as AudioStream).get_length() <= 0.1
			):
				failures.append("invalid packaged voice: %s" % str(voice_path))
			voice_resource = null
	for interface_audio_path: String in [
		MELL_IN_PATH,
		MELL_OUT_PATH,
		CLICK_BUTTON_PATH,
	]:
		if not ResourceLoader.exists(interface_audio_path):
			failures.append(
				"missing packaged interface sound: %s"
				% interface_audio_path
			)
		else:
			var interface_audio: Resource = load(interface_audio_path)
			if (
				not interface_audio is AudioStream
				or (interface_audio as AudioStream).get_length() <= 0.01
			):
				failures.append(
					"invalid packaged interface sound: %s"
					% interface_audio_path
				)
			interface_audio = null
	for texture_path: String in [
		MENU_IMAGE_PATH,
		STREET5_IMAGE_PATH,
		STREET4_IMAGE_PATH,
		STREET3_IMAGE_PATH,
		STREET5_DYLEN_PATH,
		STREET5_DAD_PATH,
		STREET5_DAD_ACTIVE_PATH,
		STREET5_MAM_PATH,
		STREET5_MAM_ACTIVE_PATH,
	]:
		if not ResourceLoader.exists(texture_path):
			failures.append("missing packaged character art: %s" % texture_path)
	if _street5_slice == null or not _street5_slice.is_ready():
		failures.append("Street 5 runtime did not become ready")
	else:
		if _street5_slice.state.location != "street5":
			failures.append("Street 5 location was not entered")
		if not _street5_slice.state.has_event("WellCome"):
			failures.append("WellCome entry event was not set")
		if _street5_slice.state.is_channel_enabled(14):
			failures.append("entry dialogue channel 14 was not disabled")
		if not _street5_slice.vm.queue.is_empty():
			failures.append("recovered command queue did not drain")
	if not _ambient_player.playing:
		failures.append("ambient audio did not start")
	if not _voice_player.playing:
		failures.append("opening voice did not start")
	if _lamp_frames.size() != 31:
		failures.append("expected 31 lamp frames, found %d" % _lamp_frames.size())
	if _boy_frames.size() != 21:
		failures.append("expected 21 character frames, found %d" % _boy_frames.size())
	if _mell_frames.size() != 18:
		failures.append("expected 18 Mell frames, found %d" % _mell_frames.size())
	if (
		not is_instance_valid(_dylen_sprite)
		or _dylen_sprite.texture == null
		or not _dylen_sprite.visible
	):
		failures.append("authentic Street 5 character is not visible")
	if (
		not is_instance_valid(_mell_portrait)
		or _mell_portrait.texture == null
		or not _mell_portrait.is_visible_in_tree()
	):
		failures.append("authentic animated Mell portrait is not visible")

	if not failures.is_empty():
		for failure: String in failures:
			push_error("JULIA_PACKAGED_SMOKE: %s" % failure)
		_leave_street5()
		await get_tree().create_timer(0.25).timeout
		get_tree().quit(1)
		return
	print("JULIA_PACKAGED_SMOKE: PASS")
	_leave_street5()
	await get_tree().create_timer(0.25).timeout
	get_tree().quit(0)


func _unhandled_key_input(event: InputEvent) -> void:
	if not event is InputEventKey:
		return
	var key_event: InputEventKey = event as InputEventKey
	if (
		key_event.keycode == KEY_SPACE
		and _view_mode == ViewMode.ADVENTURE
		and is_instance_valid(_full_adventure)
	):
		_full_adventure.set_hotspot_reveal(key_event.pressed)
		get_viewport().set_input_as_handled()
		return
	if not key_event.pressed or key_event.echo:
		return
	if _settings_overlay.visible:
		if key_event.keycode == KEY_ESCAPE:
			_close_settings()
		get_viewport().set_input_as_handled()
		return

	if key_event.keycode == KEY_F11 or (
		key_event.keycode == KEY_ENTER and key_event.alt_pressed
	):
		_toggle_fullscreen()
		get_viewport().set_input_as_handled()
		return

	if (
		_view_mode == ViewMode.ADVENTURE
		and is_instance_valid(_full_adventure)
		and key_event.keycode in [KEY_I, KEY_S, KEY_M, KEY_N]
	):
		if _full_adventure.handle_shortcut(key_event.keycode):
			get_viewport().set_input_as_handled()
			return

	if key_event.keycode == KEY_J:
		if _casebook_open:
			_close_casebook()
		elif (
			_view_mode == ViewMode.ADVENTURE
			and is_instance_valid(_full_adventure)
			and _full_adventure.has_runtime_session()
			and not _full_adventure.has_modern_tool_open()
		):
			# J takes the view's Journal route, as Tools > Journal does. Modern
			# closes the dock, inventory and Save sheet, then opens the casebook
			# (or shows the wait hint). Legacy stays the original 1:1 and
			# presses the original notes button instead of the remake casebook.
			_full_adventure.handle_shortcut(KEY_J)
		elif _view_mode in [ViewMode.FIRST_SCENE, ViewMode.ADVENTURE]:
			if not _open_casebook():
				_show_toast(_copy("casebook_wait_hint"))
		get_viewport().set_input_as_handled()
		return

	if key_event.keycode == KEY_ESCAPE:
		if _view_mode == ViewMode.MAIN_MENU and _presentation_edition == "legacy":
			_handle_back_request()
		elif _casebook_open:
			_close_casebook()
		elif (
			_view_mode == ViewMode.ADVENTURE
			and is_instance_valid(_full_adventure)
		):
			_full_adventure.handle_escape()
		elif _settings_overlay.visible:
			_close_settings()
		else:
			_open_settings()
		get_viewport().set_input_as_handled()


func _load_preferences() -> void:
	var config: ConfigFile = ConfigFile.new()
	var error: Error = config.load(SETTINGS_PATH)
	if error != OK:
		return
	_locale = str(config.get_value("interface", "locale", _locale))
	_presentation_edition = str(config.get_value("display", "edition", "modern"))
	if _presentation_edition not in ["modern", "legacy"]:
		_presentation_edition = "modern"
	if _locale not in JuliaGameLocalization.CODES:
		_locale = JuliaLocalizedCopy.DEFAULT_LOCALE
	_high_contrast = bool(config.get_value("accessibility", "high_contrast", _high_contrast))
	_large_text = bool(config.get_value("accessibility", "large_text", _large_text))
	_reduced_motion = bool(config.get_value("accessibility", "reduced_motion", _reduced_motion))
	_crisp_filter = bool(config.get_value("display", "crisp_filter", _crisp_filter))
	_master_volume = clampf(float(config.get_value("audio", "master_volume", _master_volume)), 0.0, 1.0)
	_opening_has_played = bool(
		config.get_value("gameplay", "opening_seen", _opening_has_played)
	)


func _save_preferences() -> void:
	var config: ConfigFile = ConfigFile.new()
	config.set_value("interface", "locale", _locale)
	config.set_value("display", "edition", _presentation_edition)
	config.set_value("accessibility", "high_contrast", _high_contrast)
	config.set_value("accessibility", "large_text", _large_text)
	config.set_value("accessibility", "reduced_motion", _reduced_motion)
	config.set_value("display", "crisp_filter", _crisp_filter)
	config.set_value("display", "fullscreen", _is_fullscreen())
	config.set_value("display", "screen", get_window().current_screen)
	config.set_value("audio", "master_volume", _master_volume)
	config.set_value("gameplay", "opening_seen", _opening_has_played)
	config.save(SETTINGS_PATH)


func _apply_saved_window_mode() -> void:
	# Browser fullscreen requires a fresh user gesture; viewport size belongs
	# to the responsive page rather than the desktop monitor preference.
	if OS.has_feature("android") or WebLayout.enabled():
		return
	var config: ConfigFile = ConfigFile.new()
	if config.load(SETTINGS_PATH) != OK:
		return
	var screen_count: int = DisplayServer.get_screen_count()
	if screen_count > 0:
		var screen_index: int = clampi(
			int(config.get_value("display", "screen", get_window().current_screen)),
			0,
			screen_count - 1
		)
		get_window().current_screen = screen_index
	var fullscreen: bool = bool(config.get_value("display", "fullscreen", false))
	if fullscreen:
		get_window().mode = (
			Window.MODE_FULLSCREEN if OS.has_feature("web") else Window.MODE_EXCLUSIVE_FULLSCREEN
		)
	_update_fullscreen_button()


func _copy(key: String) -> String:
	if key == "language_button": return JuliaGameLocalization.text("Language", _locale)
	return JuliaLocalizedCopy.text(_locale, key)


func _clear_children(parent: Node) -> void:
	for child: Node in parent.get_children():
		parent.remove_child(child)
		child.queue_free()

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_RESUMED:
		call_deferred("_qa_render_state", "resumed")
	elif what == NOTIFICATION_WM_GO_BACK_REQUEST:
		_handle_back_request()
	elif what == NOTIFICATION_WM_CLOSE_REQUEST:
		if is_instance_valid(_full_adventure):
			_full_adventure.save_before_background()
		get_tree().quit()


func _handle_back_request() -> void:
	if is_instance_valid(_opening_sequence) and _opening_sequence.is_playing():
		_qa_handoff_geometry("before_handoff")
		_opening_sequence.request_skip("escape")
	elif _casebook_open:
		_close_casebook()
	elif is_instance_valid(_settings_overlay) and _settings_overlay.visible:
		_close_settings()
	elif _view_mode == ViewMode.ADVENTURE and is_instance_valid(_full_adventure):
		_full_adventure.handle_escape()
		call_deferred("_qa_render_state", "back")
	elif _view_mode == ViewMode.MAIN_MENU and _presentation_edition == "legacy":
		if not _original_menu.handle_back():
			_select_edition("modern")
	else:
		get_tree().quit()


func _qa_handoff_geometry(event_name: String) -> void:
	if not OS.is_debug_build() or not OS.has_feature("android"):
		return
	var collapsed: Array = []
	var pending: Array[Node] = [self]
	while not pending.is_empty():
		var node: Node = pending.pop_back()
		if node is CanvasItem and (node as CanvasItem).get_global_transform_with_canvas().determinant() == 0.0:
			collapsed.append(str(node.get_path()))
		for child: Node in node.get_children():
			pending.append(child)
	print("JULIA_HANDOFF_GEOMETRY: " + JSON.stringify({"event": event_name, "collapsed": collapsed, "fixture_size": str(_stage_viewport.size), "fixture_input_disabled": _stage_viewport.gui_disable_input}))


func _qa_render_state(event_name: String) -> void:
	# Debug Android/Web builds expose observed UI state for real-input checks.
	# Coordinates are measured after layout; the test never guesses tap targets.
	if not OS.is_debug_build() or not (OS.has_feature("android") or OS.has_feature("web")) or not is_node_ready():
		return
	while _transitioning:
		await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().process_frame
	var viewport_size: Vector2 = get_viewport_rect().size
	var record: Dictionary = {
		"event": event_name, "view": ViewMode.keys()[_view_mode],
		"time": Time.get_ticks_msec(), "viewport": [viewport_size.x, viewport_size.y],
		"user_data": OS.get_user_data_dir(),
		"opening": is_instance_valid(_opening_sequence) and _opening_sequence.is_playing(),
	}
	record["settings_open"] = is_instance_valid(_settings_overlay) and _settings_overlay.visible
	if OS.has_feature("web"):
		var observed: Array = []
		for node: Node in find_children("*", "Control", true, false):
			var control := node as Control
			if (control is BaseButton or control is HSlider) and control.is_visible_in_tree():
				observed.append(WebLayout.observed_control(control))
		record["controls"] = observed
	if is_instance_valid(_gameplay_settings_button) and _gameplay_settings_button.is_visible_in_tree():
		var point := _gameplay_settings_button.get_global_rect().get_center()
		record["settings_button"] = [point.x / viewport_size.x, point.y / viewport_size.y]
	if bool(record["settings_open"]):
		var edition_buttons: Dictionary = {}
		for edition: String in ["modern", "legacy"]:
			var button: Button = _settings_overlay.find_child("SettingsEdition" + edition.capitalize(), true, false)
			if button != null and button.is_visible_in_tree():
				var point := button.get_global_rect().get_center()
				edition_buttons[edition] = [point.x / viewport_size.x, point.y / viewport_size.y]
		record["edition_buttons"] = edition_buttons
	if is_instance_valid(_menu_primary_action) and _menu_primary_action.is_visible_in_tree():
		var center: Vector2 = _menu_primary_action.get_global_rect().get_center()
		record["new_game"] = [center.x / viewport_size.x, center.y / viewport_size.y]
	if is_instance_valid(_full_adventure) and _full_adventure.visible:
		var close: Button = _full_adventure.dialogue_overlay.find_child("CloseConversation", true, false)
		if close != null and close.is_visible_in_tree() and not close.disabled:
			var point := close.get_global_rect().get_center()
			record["close_conversation"] = [point.x / viewport_size.x, point.y / viewport_size.y]
		var save_panel: Control = _full_adventure.get("_save_overlay")
		record["save_panel"] = is_instance_valid(save_panel) and save_panel.visible
		# Android log records have a small per-line limit. Keep the full asset
		# resolution graph in desktop artifacts, not in this device-state line.
		var details: Dictionary = _full_adventure.presentation_diagnostics()
		record["scene"] = {
			"location": details.get("location"), "edition": details.get("edition"),
			"loading": details.get("loading"), "stage_scale": details.get("stage_scale"),
			"stage_position": details.get("stage_position"),
			"stage_rect": details.get("stage_rect"), "portrait_tools": details.get("portrait_tools", false),
			"background": str(details.get("background_texture", "")).get_file(),
		}
	print("JULIA_DEVICE_STATE: " + JSON.stringify(record))
	if event_name == "adventure" and is_instance_valid(_full_adventure):
		call_deferred("_qa_wait_for_intro_controls", _full_adventure)


func _qa_wait_for_intro_controls(view: JuliaFullAdventureView) -> void:
	# Read-only smoke observations: automation still taps original UI.
	if not OS.is_debug_build() or not (OS.has_feature("android") or OS.has_feature("web")):
		return
	var deadline := Time.get_ticks_msec() + 90000
	var controls_reported := false
	while Time.get_ticks_msec() < deadline and is_instance_valid(view) and _full_adventure == view:
		if not view.has_runtime_session() or view.current_location_id() != "street5":
			return
		if not view.session.state.dialogue_open and not view.session.state.mell_open and view.can_switch_edition():
			_qa_render_state("intro_finished")
			return
		var close: Button = view.dialogue_overlay.find_child("CloseConversation", true, false)
		if not controls_reported and close != null and close.is_visible_in_tree() and not close.disabled and not view.session.vm.is_waiting() and not view.effect_host.is_voice_active():
			controls_reported = true
			_qa_render_state("intro_controls")
		await get_tree().create_timer(0.1).timeout
