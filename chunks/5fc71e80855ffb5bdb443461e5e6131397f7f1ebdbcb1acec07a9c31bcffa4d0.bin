	_zoom_item_action.add_theme_color_override("font_color", Color("fff9ed"))
	_zoom_item_action.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	_zoom_item_action.pressed.connect(_activate_zoom_item)
