          "text": "Geef me een pauze.",
          "source_text": "Give me a break.",
          "transcription_review_required": false
        },
        "ala1-01": {
          "path": "res://assets/languages/nl/audio/ala1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bf853dc57064c21893b9c7e4c213d28c6dec7c602815895c8d7adc97258df462",
          "text": "Dit is volkomen psychedelisch. Mijn film over Philip's Chemicals is verdwenen.",
          "source_text": "This is totally psychedelic. My film on Philip's Chemicals has disappeared.",
          "transcription_review_required": false
        },
        "ala1-02": {
          "path": "res://assets/languages/nl/audio/ala1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "412f35c56050a51f5606db6d2436c52e9fbf86a2c77a2b49bb1e9a88c6bb5447",
          "text": "Ik ben geruÃ¯neerd zonder die film.",
          "source_text": "I'm ruined without that film.",
          "transcription_review_required": false
        },
        "ala1-03": {
          "path": "res://assets/languages/nl/audio/ala1-03.mp3",
