func _init() -> void:
	# Scene coordinates are physical pixels, independent of text direction.
	layout_direction = Control.LAYOUT_DIRECTION_LTR


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_STOP
	theme = ThemeFactory.build(false, false)
	_build_interface()
	if WebLayout.enabled():
		resized.connect(_layout_web_controls)
		call_deferred("_layout_web_controls")
	set_process(true)


func bind_journal(configured_journal: JuliaClueJournal) -> void:
	journal = (
		configured_journal
		if configured_journal != null
		else ClueJournalScript.new()
	)


func set_locale(value: String) -> void:
	locale = value.to_lower()
	if locale in ["he", "he-il"]:
		locale = "heb"
	_apply_locale()
	if is_instance_valid(ending_sequence): ending_sequence.refresh_language()
	if (_zoom_overlay.visible or (_original_zoom != null and _original_zoom.visible)) and not _zoom_item_id.is_empty():
		_show_item_zoom(_zoom_item_id, _zoom_effect_id)


func start_new_game(requested_locale: String = "heb") -> Dictionary:
	await _ensure_runtime(requested_locale)
	journal.clear()
	_seen_found_items.clear()
	_selected_inventory_item = ""
	_restored_playtime_seconds = 0.0
	_play_started_msec = Time.get_ticks_msec()

	_replace_session(LegacySessionScript.new(catalog))
	session.set_deferred_effects(true)
	var result: Dictionary = presenter.start(
		"street5", 0, 1, locale
	)
	_show_loading(false)
	_refresh_all()
	game_started.emit(result.duplicate(true))
	return result


func load_slot(slot_id: String) -> Dictionary:
	await _ensure_runtime(locale)
	if session == null:
		_replace_session(LegacySessionScript.new(catalog))
		session.set_deferred_effects(true)
	var result: Dictionary = save_store.load(slot_id, session, journal)
	if bool(result.get("ok", false)):
		if presentation_edition == "modern": _reset_modern_mell_speech()
		locale = str(result.get("locale", locale)).to_lower()
		_restored_playtime_seconds = float(
			result.get("playtime_seconds", 0.0)
		)
		_play_started_msec = Time.get_ticks_msec()
		# fixes-87 round 3 (review): the media host is bound first. bind_session
		# re-dispatches the save's pending effects (the line the story waits
		# on), and the host's bind_presenter, when it came after, stopped and
		# dropped them: a game saved during a line never went on after loading
		# (Mel's intro call stayed up, silent, the story waiting forever).
		effect_host.prefer_original_audio = presentation_edition == "legacy"
		effect_host.bind_presenter(presenter)
		presenter.bind_session(session)
		dialogue_overlay.bind(presenter, session)
		dialogue_overlay.set_locale(locale)
		minigame_host.configure_asset_index(catalog.asset_index)
		if original_panels != null:
			original_panels.bind(session, save_store)
		_seen_found_items.clear()
		_sync_inventory_discoveries()
		_refresh_all()
		_show_save_overlay(false)
		_show_loading(false)
		_show_toast(
			"×”×ž×©×—×§ × ×˜×¢×Ÿ" if _is_hebrew() else "Game loaded"
		)
		game_loaded.emit(result.duplicate(true))
	return result


func save_slot(slot_id: String) -> Dictionary:
	if session == null or journal == null:
		return {"ok": false, "message": "No game is running."}
	if modern_notebook != null:
		modern_notebook.commit_notes()
	var result: Dictionary = save_store.save(
		slot_id,
		session,
		journal,
		{
			"locale": locale,
			"playtime_seconds": playtime_seconds(),
			"game_version": str(
				ProjectSettings.get_setting("application/config/version", "")
			),
			"chapter_label": _location_copy(
				str(session.state.location)
			),
			"created_by": "Julia Flower Girl Remastered",
			"profile": {
				"story": session.state.story,
				"part": session.state.part,
			},
		}
	)
	if bool(result.get("ok", false)) and OS.has_feature("web"):
		# FileAccess has written the in-memory filesystem. Do not promise a
		# durable save until the hosting engine's queued IndexedDB flush ends.
		result["pending_persistence"] = true
		_confirm_web_save(slot_id, result.duplicate(true))
	else:
		_report_save_result(slot_id, result)
	return result


func _report_save_result(slot_id: String, result: Dictionary) -> void:
	var ok: bool = bool(result.get("ok", false))
	if ok:
		if slot_id != SaveStoreScript.AUTOSAVE_SLOT_ID:
			_show_toast("×”×ž×©×—×§ × ×©×ž×¨" if _is_hebrew() else "Game saved")
			_rebuild_save_slots()
		game_saved.emit(result.duplicate(true))
	else:
		_show_toast("×œ× × ×™×ª×Ÿ ×œ×©×ž×•×¨ ×›×¨×’×¢" if _is_hebrew() else "The game could not be saved")
		if slot_id != SaveStoreScript.AUTOSAVE_SLOT_ID: _rebuild_save_slots()
	if original_panels != null and slot_id != SaveStoreScript.AUTOSAVE_SLOT_ID:
		original_panels.acknowledge_save(slot_id, ok)


func _confirm_web_save(slot_id: String, result: Dictionary) -> void:
	_web_save_serial += 1
	var token: String = "%d-%d" % [get_instance_id(), _web_save_serial]
	_pending_web_saves[slot_id] = token
	if slot_id != SaveStoreScript.AUTOSAVE_SLOT_ID:
		_show_toast(JuliaGameLocalization.text("Savingâ€¦"))
		_toast_label.set_meta("localization_source_text", "Savingâ€¦")
		_toast_label.set_meta("localization_result_text", _toast_label.text)
		_rebuild_save_slots()
	JavaScriptBridge.eval("""(() => {
		const token = %s;
		const states = globalThis.__juliaSaveAcknowledgments ||= Object.create(null);
		states[token] = 'pending';
		Promise.resolve().then(() => {
			if (typeof globalThis.__juliaPersistUserFS !== 'function') throw new Error('Save flush is unavailable');
			return globalThis.__juliaPersistUserFS();
		}).then(error => {
			if (Object.hasOwn(states, token)) states[token] = error ? 'failed' : 'saved';
		}, () => {
			if (Object.hasOwn(states, token)) states[token] = 'failed';
		});
		setTimeout(() => { delete states[token]; }, 60000);
	})()""" % JSON.stringify(token), true)
	var deadline: int = Time.get_ticks_msec() + 20000
	var status: String = "pending"
	while status == "pending" and Time.get_ticks_msec() < deadline:
		await get_tree().create_timer(0.05, true, false, true).timeout
		status = str(JavaScriptBridge.eval("globalThis.__juliaSaveAcknowledgments?.[%s] || 'failed'" % JSON.stringify(token), true))
	JavaScriptBridge.eval("delete globalThis.__juliaSaveAcknowledgments[%s]" % JSON.stringify(token), true)
	# A newer save of this slot owns its acknowledgment and status.
	if str(_pending_web_saves.get(slot_id, "")) != token: return
	_pending_web_saves.erase(slot_id)
	result.erase("pending_persistence")
	if status != "saved":
		result["ok"] = false
		result["code"] = "persistence_failed"
	_report_save_result(slot_id, result)


func playtime_seconds() -> float:
	var live_seconds: float = 0.0
	if _play_started_msec > 0:
		live_seconds = float(
			Time.get_ticks_msec() - _play_started_msec
		) / 1000.0
	return maxf(0.0, _restored_playtime_seconds + live_seconds)


func set_casebook_open(value: bool) -> void:
	_casebook_open = value
	# The shell's casebook pauses play. Hold the effect host as the Save sheet
	# does: the voice line, sound effects and music keep their place, the host
	# stops processing so no fallback deadline ends a held line, and the story
	# keeps waiting on that same line, which plays on after the casebook.
	# stop_voice(false)/stop_sfx(false) here dropped the line without finishing
	# its job, so the story waited forever once the casebook closed.
	if effect_host != null:
		_set_adventure_modal("casebook", value)


func set_hotspot_reveal(value: bool) -> void:
	if presenter != null:
		presenter.set_accessibility_reveal_hotspots(value)


func set_reduced_motion(enabled: bool) -> void:
	_portrait_reduced_motion = enabled
	if enabled and _portrait_layout_active:
		_portrait_stage_elapsed = 0.24
		_apply_portrait_stage_offset(_portrait_stage_target)
	if is_instance_valid(_modern_mell_phone):
		_modern_mell_phone.set_reduced_motion(enabled)


func set_master_volume(linear: float) -> void:
	var safe: float = clampf(linear, 0.0, 1.0)
	# Master is an absolute bus setting, also used by the shell, opening and
	# menu. Never multiply it into players again when a scene takes ownership.
	var bus_index: int = AudioServer.get_bus_index("Master")
	if bus_index >= 0:
		AudioServer.set_bus_mute(bus_index, safe <= 0.001)
		AudioServer.set_bus_volume_db(bus_index, linear_to_db(maxf(safe, 0.001)))
	_apply_edition_audio_mix()


func _apply_edition_audio_mix() -> void:
	if original_panels != null:
		_set_original_volume(float(original_panels.music_level) / 10.0, float(original_panels.sound_level) / 10.0)
		return
	_apply_game_audio_mix(-4.0, 0.0, -1.0, -10.0)


func _apply_game_audio_mix(music_db: float, voice_db: float, sfx_db: float, duck_db: float) -> void:
	if is_instance_valid(effect_host):
		effect_host.set_mix_levels(music_db, voice_db, sfx_db, duck_db)
	if is_instance_valid(minigame_view):
		minigame_view.set_audio_mix(voice_db, sfx_db)
	if is_instance_valid(ending_sequence):
		ending_sequence.set_mix_levels(music_db, voice_db, sfx_db, duck_db)


func has_runtime_session() -> bool:
	return _runtime_ready and session != null


func can_switch_edition() -> bool:
	# Dialogue choices are durable session state. Active media and minigame
	# gestures are allowed to finish before their presentation is replaced.
	return (
		has_runtime_session()
		and not session.vm.is_waiting()
		and session.vm.queue.is_empty()
		and not minigame_view.visible
		and not (is_instance_valid(ending_sequence) and ending_sequence.visible)
		and not _zoom_overlay.visible
		and not (_original_zoom != null and _original_zoom.visible)
		and not session.state.mell_open
		and not effect_host.is_voice_active()
		and effect_host.pending_effect_ids().is_empty()
	)


func prepare_for_settings() -> void:
	_close_modern_tool()
	_set_tool_dock_open(false)
	_show_inventory_overlay(false)
	_show_save_overlay(false)
	if original_panels != null and not original_panels.page.is_empty():
		# Closing commits the original handwritten notes before a checkpoint.
		original_panels.close_page()


func set_settings_modal(value: bool) -> void:
	_set_adventure_modal("settings", value)


func _set_adventure_modal(reason: String, value: bool) -> void:
	var was_paused: bool = not _modal_pause_reasons.is_empty()
	if value: _modal_pause_reasons[reason] = true
	else: _modal_pause_reasons.erase(reason)
	var paused: bool = not _modal_pause_reasons.is_empty()
	effect_host.set_modal_paused(reason, value)
	if paused == was_paused: return
	for control: Control in [dialogue_overlay, minigame_view]:
		if not is_instance_valid(control): continue
		if paused:
			_settings_key_state[control] = control.is_processing_unhandled_key_input()
			control.set_process_unhandled_key_input(false)
		elif _settings_key_state.has(control):
			control.set_process_unhandled_key_input(_settings_key_state[control])
	if paused:
		# These panels own additional timers and audio outside the effect host.
		for node: Node in [minigame_view, ending_sequence]:
			if not is_instance_valid(node): continue
			_modal_node_state[node] = node.process_mode
			for player: AudioStreamPlayer in node.find_children("*", "AudioStreamPlayer", true, false):
				_modal_extra_audio_state[player] = player.stream_paused
				player.stream_paused = true
			node.process_mode = Node.PROCESS_MODE_DISABLED
	else:
		for player: Variant in _modal_extra_audio_state:
			if is_instance_valid(player): player.stream_paused = _modal_extra_audio_state[player]
		for node: Variant in _modal_node_state:
			if is_instance_valid(node): node.process_mode = _modal_node_state[node]
		_modal_extra_audio_state.clear(); _modal_node_state.clear(); _settings_key_state.clear()


func presentation_diagnostics() -> Dictionary:
	var stage: Control = presenter.get("_stage_surface")
	var background: TextureRect = presenter.get("_background")
	var rendered_stage: Rect2 = WebLayout.control_rect(stage)
	return {
		"location": current_location_id(), "edition": presentation_edition,
		"view_size": str(size), "presenter_size": str(presenter.size),
		"stage_size": str(stage.size), "stage_scale": str(stage.scale),
		"stage_position": str(stage.position), "stage_visible": stage.is_visible_in_tree(),
		"stage_rect": [rendered_stage.position.x, rendered_stage.position.y, rendered_stage.size.x, rendered_stage.size.y],
		"portrait_tools": is_instance_valid(_portrait_backdrop) and _portrait_backdrop.visible,
		"background_texture": background.texture.resource_path if background.texture != null else "",
		"background_visible": background.is_visible_in_tree(),
		"background_resolution": presenter.get("_background_resolution"),
		"loading": _loading_cover.visible,
	}


func current_location_id() -> String:
	return session.state.location if session != null else ""


func presenter_node() -> JuliaLegacyAdventurePresenter:
	return presenter


func _ensure_runtime(requested_locale: String) -> void:
	locale = requested_locale.to_lower()
	if locale in ["he", "he-il"]:
		locale = "heb"
	if journal == null:
		journal = ClueJournalScript.new()
	if save_store == null:
		save_store = SaveStoreScript.new()
	if catalog == null:
		_show_loading(true)
		await get_tree().process_frame
		catalog = ContentCatalog.from_root(
			"res://data/legacy", "res://assets"
		)
	if minigame_host == null:
		minigame_host = MinigameHostScript.new(catalog.asset_index)
		minigame_view.bind_host(minigame_host)
	_runtime_ready = true
	_apply_locale()


func _replace_session(new_session: LegacySession) -> void:
	if presentation_edition == "modern": _reset_modern_mell_speech()
	_disconnect_session()
	# Pending phone fades belong to the previous runtime. They must not keep
	# a phone open over a restored game whose source state has Mell closed.
	_mell_close_effect_ids.clear()
	_mell_fade_direction = 0
	_mell_fade_elapsed = 0.0
	_mell_speaking = false
	if is_instance_valid(_mell_portrait): _mell_portrait.visible = false
	session = new_session
	presenter.bind_session(session)
	effect_host.prefer_original_audio = presentation_edition == "legacy"
	effect_host.bind_presenter(presenter)
	dialogue_overlay.bind(presenter, session)
	dialogue_overlay.set_locale(locale)
	if original_panels != null:
		original_panels.bind(session, save_store)
	_connect_session()


func _build_interface() -> void:
	var ground := ColorRect.new()
	ground.layout_direction = Control.LAYOUT_DIRECTION_LTR
	ground.color = Color("3a2822")
	ground.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	ground.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(ground)

	presenter = AdventurePresenterScene.instantiate()
	if presentation_edition == "legacy":
		presenter.visual_registry.load_data({"schema": "julia-visual-remaster-registry-v1", "overrides": []}, "legacy-original-only")
	# Dynamic children can enter _ready before their anchored size is resolved.
	# Give the fixed-coordinate stage a real layout on its first frame.
	presenter.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	presenter.size = size
	presenter.load_hotspot_geometry(HOTSPOT_GEOMETRY_PATH)
	presenter.load_channel_geometry(CHANNEL_GEOMETRY_PATH)
	presenter.set_scene_channel_exclusions(
		"heb/street5", [13, 14, 18, 19]
	)
	add_child(presenter)
	presenter.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	presenter.call_deferred("_layout_stage")

	effect_host = EffectHostScene.instantiate()
	effect_host.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	effect_host.size = size
	effect_host.z_index = 20
	add_child(effect_host)
	effect_host.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	if presentation_edition == "modern":
		effect_host.suppressed_animation_members = ["boy frame 1", "s5_anm1 frame 1"]
		effect_host.suppressed_animation_prefixes = ["dr01an", "cl_anm1", "s1_anm", "s3_anm", "s4_anm", "train frame", "flags frame", "flower frame", "s6_anm", "s12_anm", "girlturn", "girltalk", "rs01an", "rs1an", "cs01", "cs02", "cs03"]
		presenter.set_scene_channel_exclusions("heb/street1", [15,16])
		presenter.set_scene_channel_exclusions("heb/street3", [16])
		presenter.set_scene_channel_exclusions("street11", [11,12,13,14])
		presenter.set_scene_channel_exclusions("disk_2", [16])
		for document: String in ["heb/diskr_1", "heb/diskr_2"]:
			presenter.set_scene_channel_exclusions(document, [15,16,17,18,19])
		for document: String in ["heb/cafea_1", "heb/cafea_2"]:
			presenter.set_scene_channel_exclusions(document, [19])
		for document: String in ["heb/cafed_1", "heb/cafed_2"]:
			presenter.set_scene_channel_exclusions(document, [15,16])
		for document: String in ["cafe_1", "cafe_2"]:
			presenter.set_scene_channel_exclusions(document, [11])
		effect_host.suppressed_animation_prefixes.append_array(["rnd1cafe","la01an","glass frame","ptakim frame","np01an","pa_anm1","fs01an","ph_anm"])
		for document: String in ["heb/lab2_1","heb/lab2_2"]:
			presenter.set_scene_channel_exclusions(document,[11,12,13,14,15,20,27])
		for document: String in ["paper_1","paper_2"]:
			presenter.set_scene_channel_exclusions(document,[12,18,33,35,36])
		for document: String in ["heb/papern_1","heb/papern_2"]:
			presenter.set_scene_channel_exclusions(document,[11,12,13,14,15,23,24])
		for document: String in ["photo_1","photo_2"]:
			presenter.set_scene_channel_exclusions(document,[28,29])
		for document: String in ["heb/photos_1","heb/photos_2"]:
			presenter.set_scene_channel_exclusions(document,[11,14])
		effect_host.suppressed_animation_prefixes.append_array(["e1jm","e2jm","e1al","e1do","e2rk"])
		presenter.set_scene_channel_exclusions("end1",[1,11,13,14,15,16,18,19,21])
		presenter.set_scene_channel_exclusions("end2",[1,11,12,13,14,15,16,17])
		# Shy An's atlas replaces both the resting still and the old turn overlay.
		presenter.set_scene_channel_exclusions("heb/street13", [12])
		for document: String in ["cloth_1", "cloth_2"]:
			presenter.set_scene_channel_exclusions(document, [17])
		for document: String in ["heb/cloths_1", "heb/cloths_2"]:
			presenter.set_scene_channel_exclusions(document, [15])

	_build_actor_layer()

	dialogue_overlay = (
		OriginalDialogueOverlayScript.new() if presentation_edition == "legacy"
		else DialogueOverlayScript.new()
	)
	dialogue_overlay.z_index = 120
	add_child(dialogue_overlay)
	# GUI picking follows sibling order, not CanvasItem.z_index. Keep the
	# conversation tools above its choices, and below the later modal sheets.
	_build_toolbar()

	minigame_view = OriginalMinigameViewScript.new() if presentation_edition == "legacy" else MinigameViewScript.new()
	minigame_view.visible = false
	minigame_view.z_index = 300
	minigame_view.finished.connect(_on_minigame_finished)
	minigame_view.audio_requested.connect(_on_minigame_audio_requested)
	add_child(minigame_view)

	_build_inventory_overlay()
	_build_save_overlay()
	if presentation_edition == "legacy":
		_build_original_panels()
	else:
		_build_modern_tools()
	_build_zoom_overlay()
	_build_ending_overlay()
	_build_toast()
	_build_loading_cover()
	_connect_presenter()
	_connect_effect_host()
	_apply_edition_audio_mix()


func _build_actor_layer() -> void:
	_actor_stage = presenter.get("_stage_surface") as Control
	if _actor_stage == null:
		return
	var prompt: Control = presenter.get("_prompt_backing") as Control
	if prompt != null:
		prompt.z_index = 80

	if presentation_edition == "modern":
		var dylen_config: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://cast_shared/dylan/rendering.json"))
		var dylen_settings: Dictionary = dylen_config.settings.duplicate(true)
		dylen_settings["prop_variant"] = "papers"
		var dylen_actor := preload("res://src/presentation/modern_dylan_sprite.gd").new()
		dylen_actor.configure(load(dylen_config.source),dylen_settings)
		dylen_actor.process_mode = Node.PROCESS_MODE_DISABLED
		dylen_actor.z_index = 8
		dylen_actor.hide()
		_actor_stage.add_child(dylen_actor)
		var placement: Array = dylen_config.placements.street5.equivalent_scene_rect
		dylen_actor.position = Vector2(placement[0],placement[1])
		dylen_actor.size = Vector2(placement[2],placement[3])
		dylen_actor._layout_pieces()
		dylen_actor.set_contact_shadow(true) # fixes-88 A6: street5 opening pavement
		_dylen_sprite = dylen_actor
		_dylen_frames = dylen_actor.frames
	else:
		_dylen_sprite = _make_stage_sprite(DYLEN_PATH, Vector2(90.0,190.0), Vector2(98.0,224.0),8)
	_dylen_button = _make_actor_button(
		Rect2(90.0, 190.0, 98.0, 224.0), _on_dylen_pressed
	)
	if presentation_edition == "modern":
		var factor: float = _dylen_sprite.size.x/1024.0
		_dylen_button.position = _dylen_sprite.position+Vector2(168,20)*factor
		_dylen_button.size = Vector2(720,1500)*factor

	if presentation_edition == "modern":
		_modern_parents = ModernParentPortraits.new()
		_actor_stage.add_child(_modern_parents)
		_modern_parents.configure()
		_dad_sprite = _modern_parents.father
		_mam_sprite = _modern_parents.mother
	else:
		_dad_sprite = _make_stage_sprite(
			DAD_PATH, Vector2(11.0, 18.0), Vector2(146.0, 145.0), 9
		)
		_mam_sprite = _make_stage_sprite(
			MAM_PATH, Vector2(492.0, 18.0), Vector2(148.0, 145.0), 9
		)
	_dad_button = _make_actor_button(
		Rect2(11.0, 18.0, 146.0, 145.0),
		_on_actor_channel_pressed.bind(18)
	)
	_mam_button = _make_actor_button(
		Rect2(492.0, 18.0, 148.0, 145.0),
		_on_actor_channel_pressed.bind(19)
	)
	if presentation_edition == "modern":
		_style_parent_choice(_dad_button)
		_style_parent_choice(_mam_button)

	_mell_portrait = TextureRect.new()
	_mell_portrait.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_mell_portrait.position = Vector2(390.0, 155.0)
	_mell_portrait.size = Vector2(190.0, 238.0)
	_mell_portrait.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_mell_portrait.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	_mell_portrait.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_mell_portrait.z_index = 15
	_mell_portrait.visible = false
	_actor_stage.add_child(_mell_portrait)
	if presentation_edition == "legacy":
		_original_mell_surface = OriginalScoreSurface.new()
		_original_mell_surface.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		_original_mell_surface.z_index = 200
		_original_mell_surface.visible = false
		add_child(_original_mell_surface)
		_mell_portrait.reparent(_original_mell_surface.stage_control(), false)
		_mell_portrait.position = Vector2(99, 150)
		_mell_portrait.size = Vector2(154, 184)
		_mell_portrait.z_index = 216
		_mell_portrait.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		_original_mell_close = Button.new()
		_original_mell_close.layout_direction = Control.LAYOUT_DIRECTION_LTR
		_original_mell_close.z_index = 218
		_original_mell_close.flat = true
		for style_name: String in ["normal", "hover", "pressed", "disabled", "focus"]:
			_original_mell_close.add_theme_stylebox_override(style_name, StyleBoxEmpty.new())
		_original_mell_close.pressed.connect(_close_mell_help)
		_original_mell_surface.stage_control().add_child(_original_mell_close)
		_original_mell_close.position = Vector2(225, 62)
		_original_mell_close.size = Vector2(23, 21)
	else:
		_modern_mell_phone = ModernMellPhone.new()
		_actor_stage.add_child(_modern_mell_phone)
		_modern_mell_phone.attach_portrait(_mell_portrait)
		_modern_mell_phone.close_requested.connect(_close_mell_help)
		var preferences := ConfigFile.new()
		if preferences.load("user://settings.cfg") == OK:
			_modern_mell_phone.set_reduced_motion(bool(preferences.get_value("accessibility", "reduced_motion", false)))
	_load_mell_frames()
	if presentation_edition == "modern":
		_build_modern_sign()
		_modern_street1 = ModernStreet1.new()
		_actor_stage.add_child(_modern_street1)
		_modern_street2_rack = preload("res://src/presentation/modern_street2_rack.gd").new()
		_actor_stage.add_child(_modern_street2_rack)
		_modern_street3 = ModernStreet3.new()
		_actor_stage.add_child(_modern_street3)
		_modern_street_travel = ModernStreetTravel.new()
		_actor_stage.add_child(_modern_street_travel)
		_modern_cafe = ModernCafeScene.new()
		_actor_stage.add_child(_modern_cafe)
		_modern_lab = ModernLabScene.new()
		_actor_stage.add_child(_modern_lab)
		_modern_paper = ModernPaperScene.new()
		_actor_stage.add_child(_modern_paper)
		_modern_photo = ModernPhotoScene.new()
		_actor_stage.add_child(_modern_photo)
		_modern_finale = ModernFinaleScene.new()
		_actor_stage.add_child(_modern_finale)
		_modern_street6 = ModernStreet6.new()
		_actor_stage.add_child(_modern_street6)
		_modern_street12 = ModernStreet12.new()
		_actor_stage.add_child(_modern_street12)
		_modern_waterfront = ModernWaterfront.new()
		_actor_stage.add_child(_modern_waterfront)
		_modern_cloth_ambient = ModernClothAmbient.new()
		_actor_stage.add_child(_modern_cloth_ambient)


func _style_parent_choice(button: Button) -> void:
	for state: String in ["normal", "hover", "pressed", "focus", "disabled"]:
		var border := StyleBoxFlat.new()
		border.draw_center = false
		border.border_color = Color("347d75") if state in ["hover", "pressed", "focus"] else Color("d8cbb8")
		border.set_border_width_all(3 if state in ["hover", "pressed", "focus"] else 1)
		button.add_theme_stylebox_override(state, border)
	button.flat = false
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND


func _build_modern_sign() -> void:
	var sheet: Texture2D = load("res://rooms_shared/streets/street5-v1.png")
	var region := Rect2(670, 0, 146, 261)
	var atlas := AtlasTexture.new()
	atlas.atlas = sheet
	atlas.region = region
	_modern_sign = TextureRect.new()
	_modern_sign.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_modern_sign.texture = atlas
	_modern_sign.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_modern_sign.stretch_mode = TextureRect.STRETCH_SCALE
	_modern_sign.position = region.position / (sheet.get_width() / 640.0)
	_modern_sign.size = region.size / (sheet.get_width() / 640.0)
	_modern_sign.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var material := ShaderMaterial.new()
	material.shader = ModernNeon
	_modern_sign.material = material
	_actor_stage.add_child(_modern_sign)
	_modern_sign.visible = false


func _build_toolbar() -> void:
	var margin := MarginContainer.new()
	margin.visible = presentation_edition == "modern"
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_top", 0)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_bottom", 14)
	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Tools remain available during conversation gift puzzles, below modals.
	margin.z_index = 130
	add_child(margin)

	var vertical := VBoxContainer.new()
	vertical.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.add_child(vertical)
	var air := Control.new()
	air.layout_direction = Control.LAYOUT_DIRECTION_LTR
	air.size_flags_vertical = Control.SIZE_EXPAND_FILL
	air.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vertical.add_child(air)

	var bottom_row := HBoxContainer.new()
	bottom_row.alignment = BoxContainer.ALIGNMENT_END
	bottom_row.layout_direction = Control.LAYOUT_DIRECTION_LTR
	bottom_row.add_theme_constant_override("separation", 7)
	bottom_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vertical.add_child(bottom_row)

	_tool_dock = PanelContainer.new()
	_tool_dock.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_tool_dock.custom_minimum_size.y = 44.0
	_tool_dock.mouse_filter = Control.MOUSE_FILTER_PASS
	_tool_dock.visible = false
	_tool_dock.add_theme_stylebox_override(
		"panel",
		ThemeFactory.make_box(
			Color(ThemeFactory.INK, 0.86),
			Color(ThemeFactory.WARM_WHITE, 0.20),
			1,
			24,
			7.0,
			5.0
		)
	)
	bottom_row.add_child(_tool_dock)

	var row := GridContainer.new()
	_tool_grid = row
	row.columns = 3
	row.layout_direction = Control.LAYOUT_DIRECTION_LTR
	row.add_theme_constant_override("h_separation", 4)
	row.add_theme_constant_override("v_separation", 4)
	_tool_dock.add_child(row)

	_save_button = _make_toolbar_button()
	_save_button.pressed.connect(_show_save_overlay.bind(true))
	row.add_child(_save_button)
	_settings_button = _make_toolbar_button()
	_settings_button.name = "AdventureSettingsButton"
	_settings_button.pressed.connect(func() -> void: settings_requested.emit())
	row.add_child(_settings_button)
	_casebook_button = _make_toolbar_button()
	_casebook_button.pressed.connect(_request_casebook)
	row.add_child(_casebook_button)
	_inventory_button = _make_toolbar_button()
	_inventory_button.pressed.connect(_show_inventory_overlay.bind(true))
	row.add_child(_inventory_button)
	_map_button = _make_toolbar_button()
	_map_button.name = "AdventureMapButton"
	_map_button.pressed.connect(_show_modern_map)
	row.add_child(_map_button)
	_notes_button = _make_toolbar_button()
	_notes_button.name = "AdventureNotesButton"
	_notes_button.pressed.connect(_show_modern_notebook.bind("notes"))
	row.add_child(_notes_button)
	_hint_button = _make_toolbar_button()
	_hint_button.name = "AdventureMellHintButton"
	_hint_button.pressed.connect(request_mell_hint)
	row.add_child(_hint_button)
	_help_button = _make_toolbar_button()
	_help_button.name = "AdventureHowToPlayButton"
	_help_button.pressed.connect(_show_modern_notebook.bind("help"))
	row.add_child(_help_button)
	_technical_help_button = _make_toolbar_button()
	_technical_help_button.name = "AdventureControlsHelpButton"
	_technical_help_button.pressed.connect(_show_modern_notebook.bind("tech"))
	row.add_child(_technical_help_button)
	for button: Node in row.get_children():
		button.custom_minimum_size = Vector2(148, 48)
		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	_dock_toggle = _make_toolbar_button()
	_dock_toggle.name = "AdventureToolsButton"
	_dock_toggle.text = "×›×œ×™×" if _is_hebrew() else "Tools"
	_dock_toggle.tooltip_text = (
		"×›×œ×™×" if _is_hebrew() else "Tools"
	)
	_dock_toggle.pressed.connect(_toggle_tool_dock)
	_dock_toggle.add_theme_color_override(
		"font_color", ThemeFactory.WARM_WHITE
	)
	_dock_toggle.add_theme_font_size_override("font_size", 18)
	_dock_toggle.custom_minimum_size = Vector2(80.0, 52.0)
	if WebLayout.enabled():
		_dock_toggle.size_flags_vertical = Control.SIZE_SHRINK_END
	bottom_row.add_child(_dock_toggle)

	# These controls remain available through the pause sheet and keyboard
	# shortcuts, but are intentionally absent from moment-to-moment play.
	_menu_button = _make_toolbar_button()
	_menu_button.visible = false
	_menu_button.pressed.connect(_on_menu_pressed)
	add_child(_menu_button)
	_fullscreen_button = _make_toolbar_button()
	_fullscreen_button.visible = false
	_fullscreen_button.pressed.connect(_toggle_fullscreen)
	add_child(_fullscreen_button)
	_held_label = Label.new()
	_held_label.visible = false
	add_child(_held_label)
	_location_label = Label.new()
	_location_label.visible = false
	add_child(_location_label)
	_build_portrait_tools()


func _build_portrait_tools() -> void:
	# Keep the complete scene above a compact luggage edge. The original
	# tools remain available through the explicitly opened Tools drawer.
	_portrait_room_backdrop = TextureRect.new()
	_portrait_room_backdrop.name = "PortraitRoomAtmosphere"
	_portrait_room_backdrop.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_portrait_room_backdrop.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_portrait_room_backdrop.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	_portrait_room_backdrop.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	var atmosphere := ShaderMaterial.new()
	atmosphere.shader = preload("res://src/presentation/portrait_room_atmosphere.gdshader")
	_portrait_room_backdrop.material = atmosphere
	_portrait_room_backdrop.visible = false
	# Above the solid letterbox, below the complete interactive world. This
	# decorative crop has no actors, targets, source effects, or input.
	presenter.add_child(_portrait_room_backdrop)
	presenter.move_child(_portrait_room_backdrop, 1)
	_portrait_backdrop = Panel.new()
	_portrait_backdrop.name = "PortraitTravelKit"
	_portrait_backdrop.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_portrait_backdrop.z_index = 90
	_portrait_backdrop.visible = false
	_portrait_backdrop.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	add_child(_portrait_backdrop)
	var case_art := PortraitTravelKit.new()
	case_art.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_portrait_backdrop.add_child(case_art)
	_portrait_location = Label.new()
	_portrait_location.name = "PortraitLocation"
	_portrait_location.add_theme_font_override("font", ThemeFactory.display_font())
	_portrait_location.add_theme_font_size_override("font_size", 21)
	_portrait_location.add_theme_color_override("font_color", Color("4b3323"))
	_portrait_location.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_portrait_location.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_portrait_location.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	_portrait_location.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_portrait_backdrop.add_child(_portrait_location)
	_portrait_actions = GridContainer.new()
	_portrait_actions.name = "PortraitQuickActions"
	_portrait_actions.columns = 2
	_portrait_actions.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_portrait_actions.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_portrait_actions.add_theme_constant_override("h_separation", 12)
	_portrait_actions.add_theme_constant_override("v_separation", 12)
	_portrait_backdrop.add_child(_portrait_actions)
	var sources: Array[Button] = [_inventory_button, _map_button, _notes_button, _hint_button]
	for index: int in range(sources.size()):
		var source: Button = sources[index]
		var button := Button.new()
		button.name = ["PortraitItemsButton", "PortraitMapButton", "PortraitNotesButton", "PortraitMellButton"][index]
		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		button.custom_minimum_size = Vector2(0, 100)
		button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		button.add_theme_font_override("font", ThemeFactory.display_font())
		button.add_theme_font_size_override("font_size", 20)
		for state: String in ["normal", "hover", "pressed", "focus", "disabled"]:
			var ink := StyleBoxEmpty.new()
			ink.content_margin_top = 48
			ink.content_margin_bottom = 7
			ink.content_margin_left = 17
			ink.content_margin_right = 17
			button.add_theme_stylebox_override(state, ink)
		for state: String in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			button.add_theme_color_override(state, Color("443a28"))
		button.add_theme_color_override("font_disabled_color", Color("68654f"))
		button.pressed.connect(source.pressed.emit)
		_portrait_actions.add_child(button)
		var pocket_art := PortraitTravelKit.new()
		pocket_art.action_index = index
		pocket_art.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		button.add_child(pocket_art)
		_portrait_action_sources[button] = source


func _toggle_tool_dock() -> void:
	_set_tool_dock_open(not _tool_dock.visible)

func _build_original_panels() -> void:
	original_panels = OriginalPanelsScript.new()
	original_panels.size = size
	original_panels.z_index = 100
	add_child(original_panels)
	original_panels.save_requested.connect(_save_original_slot)
	original_panels.return_to_menu_requested.connect(request_return_to_menu)
	original_panels.modal_changed.connect(_on_original_panel_changed)
	original_panels.volume_changed.connect(_set_original_volume)

func _save_original_slot(slot_id: String) -> void:
	if _pending_web_saves.has(slot_id): return
	save_slot(slot_id)

func _on_original_panel_changed(value: bool) -> void:
	_set_adventure_modal("original_panel", value)

func _set_original_volume(music: float, sound: float) -> void:
	var music_db: float = -80.0 if music <= 0.001 else linear_to_db(clampf(music, 0.0, 1.0))
	var sound_db: float = -80.0 if sound <= 0.001 else linear_to_db(clampf(sound, 0.0, 1.0))
	_apply_game_audio_mix(music_db, sound_db, sound_db, 0.0)


func _set_tool_dock_open(value: bool) -> void:
	if value:
		_refresh_original_tool_access()
	_tool_dock.visible = value
	_dock_toggle.text = ("×¡×’×™×¨×”" if _is_hebrew() else "Close") if value else ("×›×œ×™×" if _is_hebrew() else "Tools")
	if WebLayout.enabled():
		_layout_web_controls()


func _build_modern_tools() -> void:
	modern_map = ModernMapScript.new()
	modern_map.size = size
	modern_map.z_index = 240
	add_child(modern_map)
	modern_map.destination_requested.connect(_travel_from_modern_map)
	modern_map.close_requested.connect(_close_modern_tool)
	modern_notebook = ModernNotebookScript.new()
	modern_notebook.size = size
	modern_notebook.z_index = 240
	add_child(modern_notebook)
	modern_notebook.close_requested.connect(_close_modern_tool)
	modern_notebook.notes_changed.connect(_request_autosave)


func has_modern_tool_open() -> bool:
	return _tool_modal_active or (modern_map != null and modern_map.visible) or (modern_notebook != null and modern_notebook.visible)


func tools_covered() -> bool:
	# fixes-87: a minigame (from the moment the story starts one, before it
	# shows), the ending, an item close-up (the Modern sheet or the original
	# zoom) or the loading cover lies over the tools and takes the pointer.
	# The original game offers no tool there, and a panel opened now draws
	# under it: the tool keys are refused (handle_shortcut), and the shell's
	# casebook does not open over it either (_can_open_casebook).
	return (
		_active_activity_effect_id != 0
		or (is_instance_valid(minigame_view) and minigame_view.visible)
		or (is_instance_valid(ending_sequence) and ending_sequence.visible)
		or (is_instance_valid(_zoom_overlay) and _zoom_overlay.visible)
		or (_original_zoom != null and _original_zoom.visible)
		or (is_instance_valid(_loading_cover) and _loading_cover.visible)
	)


func takes_play_keys() -> bool:
	# fixes-87: play itself has the keyboard: the room, with its conversation
	# or the Tools dock, and nothing else up (no sheet, page, tool, close-up,
	# minigame, ending or hold). Only then does the shell keep Space and a
	# hidden focus's Enter from the focused control (main_shell _input).
	return (
		has_runtime_session()
		and _modal_pause_reasons.is_empty()
		and not _inventory_overlay.visible
		and not _save_overlay.visible
		and not has_modern_tool_open()
		and (original_panels == null or original_panels.page.is_empty())
		and not tools_covered()
	)


func keyboard_layer() -> Control:
	# fixes-87 round 2: the topmost open layer, which has the keyboard while
	# play does not (takes_play_keys false), or null. A focus outside it is
	# under it, unseen: the shell keeps Space and Enter from pressing it
	# (main_shell _drop_focus_under_layer). Highest canvas z first.
	if is_instance_valid(_loading_cover) and _loading_cover.visible:
		return _loading_cover
	if is_instance_valid(ending_sequence) and ending_sequence.visible:
		return ending_sequence
	if is_instance_valid(minigame_view) and minigame_view.visible:
		return minigame_view
	if _original_zoom != null and _original_zoom.visible:
		return _original_zoom
	if is_instance_valid(_zoom_overlay) and _zoom_overlay.visible:
		return _zoom_overlay
	for tool: Control in [modern_map, modern_notebook]:
		if tool != null and tool.visible:
			return tool
	if _save_overlay.visible:
		return _save_overlay
	if _inventory_overlay.visible:
		return _inventory_overlay
	if original_panels != null and not original_panels.page.is_empty():
		# The page and its controls, not the original toolbar under it.
		var page_layer: Variant = original_panels.get("_blocker")
		return page_layer if page_layer is Control else original_panels
	return null


func conversation_under_cover() -> bool:
	# fixes-87 round 3 (review): a conversation is open under the suitcase, an
	# item close-up or an original page, which do not hold it (the Pause
	# sheet, Settings, the Modern tools and the suitcase during Mel's call hold
	# its keys with the story: _set_adventure_modal). Its own keys must not act
	# under the cover (main_shell _keep_conversation_keys_under_cover).
	if not is_instance_valid(dialogue_overlay) or not dialogue_overlay.visible or not _modal_pause_reasons.is_empty():
		return false
	var layer: Control = keyboard_layer()
	if layer == null:
		return false
	if layer == _inventory_overlay or layer == _zoom_overlay or layer == _original_zoom:
		return true
	return original_panels != null and (layer == original_panels or layer == original_panels.get("_blocker"))


func _modern_mell_call_on() -> bool:
	# fixes-87 round 2: Mel's call is on screen in Modern (her lines and her
	# questions). The original toolbar is closed while she is on; Legacy
	# follows it already (JuliaOriginalGamePanels.activate_toolbar).
	return original_panels == null and session != null and session.state.mell_open


func _close_play_panels_for_story() -> void:
	# fixes-87 round 2: the story takes the screen (a minigame or the ending
	# starts; in Modern also Mel's call). What the player left open in play
	# stayed open under it. The suitcase and the Tools dock do not hold the
	# story, so a line could run on into a minigame with the suitcase (canvas
	# z 340, after the minigame in tree order) unseen under it, taking every
	# click meant for the minigame (420): the minigame seemed frozen. Close
	# them first, and a close-up the story is not waiting on. A close-up it
	# waits on (a full zoom) holds the story, so nothing starts over it.
	if _zoom_effect_id == 0 and (_zoom_overlay.visible or (_original_zoom != null and _original_zoom.visible)):
		_close_zoom()
	if original_panels == null:
		_close_modern_tool()
		_set_tool_dock_open(false)
		_show_inventory_overlay(false)


func _sync_original_toolbar_pointer() -> void:
	# fixes-87 round 2 (found by check_hidden_panels): Legacy's original
	# toolbar (canvas z 220) lies under a minigame (420 and up) but comes after
	# it in the tree, and GUI picking follows the tree: its buttons took the
	# clicks meant for the minigame's own Leave, Mel's help and text help
	# buttons on the bottom row, so a Legacy minigame could not be left by its
	# button (on a phone, not at all). While the tools are covered the toolbar
	# takes no pointer; it is drawn as before (not one pixel changes).
	if original_panels == null or not is_instance_valid(original_panels.toolbar):
		return
	var covered: bool = tools_covered()
	var toolbar: Control = original_panels.toolbar
	if covered and toolbar.mouse_behavior_recursive != Control.MOUSE_BEHAVIOR_DISABLED:
		toolbar.mouse_behavior_recursive = Control.MOUSE_BEHAVIOR_DISABLED
	elif not covered and toolbar.mouse_behavior_recursive != Control.MOUSE_BEHAVIOR_INHERITED:
		toolbar.mouse_behavior_recursive = Control.MOUSE_BEHAVIOR_INHERITED


func _can_open_original_tool() -> bool:
	return (
		session != null and not session.state.mell_open
		and not session.vm.is_waiting() and session.state.cursor_group == "direction"
		and not minigame_view.visible and not _zoom_overlay.visible
		and not ending_sequence.visible and not _casebook_open
	)


func _refresh_original_tool_access() -> void:
	var available: bool = _can_open_original_tool()
	for button: Button in [_map_button, _notes_button, _help_button, _technical_help_button]:
		button.disabled = not available
	_hint_button.disabled = not available or session.state.mell_sentence.is_empty() or session.state.help_sentences.is_empty()


func _show_modern_map() -> void:
	if modern_map == null or not _can_open_original_tool():
		return
	_close_modern_tool()
	_show_inventory_overlay(false)
	_show_save_overlay(false)
	_set_tool_dock_open(false)
	modern_map.configure(session, locale)
	_begin_modern_tool(modern_map)
	modern_map.show()


func _show_modern_notebook(page: String) -> void:
	if modern_notebook == null or not _can_open_original_tool():
		return
	_close_modern_tool()
	_show_inventory_overlay(false)
	_show_save_overlay(false)
	_set_tool_dock_open(false)
	modern_notebook.configure(session, locale)
	_begin_modern_tool(modern_notebook)
	modern_notebook.open_page(page)


func _begin_modern_tool(panel: Control) -> void:
	_tool_modal_active = true
	_tool_previous_focus = get_viewport().gui_get_focus_owner()
	_set_adventure_modal("modern_tool", true)
	_suspend_tool_background_focus(self, panel)


func _suspend_tool_background_focus(node: Node, panel: Control) -> void:
	if node == panel:
		return
	if node is Control and node.focus_mode != Control.FOCUS_NONE:
		_tool_focus_state[node] = node.focus_mode
		node.focus_mode = Control.FOCUS_NONE
	for child: Node in node.get_children():
		_suspend_tool_background_focus(child, panel)


func _close_modern_tool() -> void:
	if not has_modern_tool_open():
		return
	_tool_modal_active = false
	if modern_notebook != null:
		modern_notebook.commit_notes()
		modern_notebook.hide()
	if modern_map != null:
		modern_map.hide()
	for control: Variant in _tool_focus_state:
		if is_instance_valid(control):
			control.focus_mode = _tool_focus_state[control]
	_tool_focus_state.clear()
	_set_adventure_modal("modern_tool", false)
	if is_instance_valid(_tool_previous_focus) and _tool_previous_focus.is_visible_in_tree():
		_tool_previous_focus.grab_focus()
	_tool_previous_focus = null
	_request_autosave()


func _travel_from_modern_map(destination: String) -> void:
	if modern_map == null or not modern_map.visible or not _can_open_original_tool():
		return
	if destination not in ModernMapScript.DESTINATIONS or not session.state.has_event("enter_" + destination):
		return
	_close_modern_tool()
	# The original ClickOnMap contract; travel never grants discovery.
	if session.state.incrimination_active:
		session.cancel_incrimination()
	session.state.clear_event("StuckGame")
	session.state.close_dialogue(1, true)
	session.enter_location(destination)
	_refresh_all()


func request_mell_hint() -> Dictionary:
	if not _can_open_original_tool() or session.state.mell_sentence.is_empty() or session.state.help_sentences.is_empty():
		return {"ok": false, "reason": "hint unavailable"}
	_set_tool_dock_open(false)
	var sentence: String = session.state.help_sentences[0]
	if session.state.help_sentences.size() > 1:
		session.state.help_sentences.pop_front()
	effect_host.consume_effect({"id": 0, "kind": "sound_requested", "blocking": false, "status": "pending", "payload": {"asset": "melbtn%d" % randi_range(1, 3), "play_type": "ppt", "wait": false}})
	return session.run_section("MellHelp", [sentence, 1])


func _build_inventory_overlay() -> void:
	_inventory_overlay = _make_scrim_overlay(220)
	add_child(_inventory_overlay)
	# Physical coordinates keep the same suitcase arrangement in both languages.
	# The lid is linen, the objects sit on felt, and the controls sit on leather.
	var center := CenterContainer.new()
	center.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_inventory_overlay.add_child(center)
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_inventory_case = InventoryPanel.new()
	_inventory_case.name = "InventorySuitcase"
	_inventory_case.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_inventory_case.custom_minimum_size = Vector2(1056, 704)
	_inventory_case.pivot_offset = Vector2(528, 352)
	_inventory_case.mouse_filter = Control.MOUSE_FILTER_IGNORE
	center.add_child(_inventory_case)
	var case_art := TextureRect.new()
	case_art.name = "SuitcaseArtwork"
	case_art.texture = load("res://assets/generated/suitcase-inventory-modern-v1.png")
	case_art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	case_art.stretch_mode = TextureRect.STRETCH_SCALE
	case_art.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	case_art.layout_direction = Control.LAYOUT_DIRECTION_LTR
	case_art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_inventory_case.add_child(case_art)
	case_art.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var heading_font: Font = ThemeFactory.display_font(600.0)
	_inventory_title = _make_overlay_title()
	_inventory_title.name = "InventoryTitle"
	_inventory_title.add_theme_font_override("font", heading_font)
	_inventory_title.add_theme_font_size_override("font_size", 36)
	_inventory_title.add_theme_color_override("font_color", Color("613819"))
	_inventory_title.add_theme_color_override("font_outline_color", Color("fff0c9"))
	_inventory_title.add_theme_constant_override("outline_size", 3)
	_inventory_case.add_child(_inventory_title)
	_inventory_title.position = Vector2(150, 112)
	_inventory_title.size = Vector2(590, 43)
	_inventory_close_button = _make_suitcase_button(Color("9e451f"), Color("ffedbd"))
	_inventory_close_button.pressed.connect(_show_inventory_overlay.bind(false))
	_inventory_case.add_child(_inventory_close_button)
	_inventory_close_button.position = Vector2(780, 116)
	_inventory_close_button.size = Vector2(124, 44)
	var filters := HBoxContainer.new()
	filters.layout_direction = Control.LAYOUT_DIRECTION_LTR
	filters.add_theme_constant_override("separation", 10)
	_inventory_case.add_child(filters)
	filters.position = Vector2(150, 166)
	filters.size = Vector2(754, 44)
	for key: String in ["all", "julia", "found"]:
		var filter := _make_suitcase_button(Color("f2d796"), Color("613819"))
		filter.name = "InventoryFilter_" + key
		filter.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		filter.custom_minimum_size.y = 44
		filter.add_theme_font_override("font", heading_font)
		filter.add_theme_font_size_override("font_size", 23)
		filter.toggle_mode = true
		filter.pressed.connect(_set_inventory_filter.bind(key))
		filters.add_child(filter)
		_inventory_filters[key] = filter
	_inventory_status = Label.new()
	_inventory_status.add_theme_color_override("font_color", Color("ffe6af"))
	_inventory_status.add_theme_font_size_override("font_size", 20)
	_inventory_status.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	_inventory_case.add_child(_inventory_status)
	_inventory_status.position = Vector2(131, 253)
	_inventory_status.size = Vector2(790, 32)
	_inventory_scroll = ScrollContainer.new()
	_inventory_scroll.name = "InventoryScroll"
	_inventory_scroll.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_inventory_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_inventory_scroll.follow_focus = true
	_inventory_case.add_child(_inventory_scroll)
	NativeTouchScroll.attach(_inventory_scroll)
	_inventory_scroll.position = Vector2(124, 286)
	_inventory_scroll.size = Vector2(808, 284)
	var rail: VScrollBar = _inventory_scroll.get_v_scroll_bar()
	rail.custom_minimum_size.x = 12
	rail.add_theme_stylebox_override("scroll", ThemeFactory.make_box(Color("123a39"), Color("476762"), 1, 5, 0, 0))
	for state: String in ["grabber", "grabber_highlight", "grabber_pressed"]:
		rail.add_theme_stylebox_override(state, ThemeFactory.make_box(Color("d9b364"), Color("654521"), 1, 5, 0, 0))
	_inventory_grid = GridContainer.new()
	_inventory_grid.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_inventory_grid.columns = 5
	_inventory_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_inventory_grid.add_theme_constant_override("h_separation", 8)
	_inventory_grid.add_theme_constant_override("v_separation", 8)
	_inventory_scroll.add_child(_inventory_grid)
	var actions := HBoxContainer.new()
	actions.layout_direction = Control.LAYOUT_DIRECTION_LTR
	actions.add_theme_constant_override("separation", 14)
	_inventory_case.add_child(actions)
	actions.position = Vector2(158, 604)
	actions.size = Vector2(740, 52)
	_clear_item_button = _make_suitcase_button(Color("ab7540"), Color("fff0c4"))
	_clear_item_button.name = "InventoryEmptyHands"
	_clear_item_button.pressed.connect(_clear_held_item)
	actions.add_child(_clear_item_button)
	_inventory_look_button = _make_suitcase_button(Color("efd18a"), Color("4b331e"))
	_inventory_look_button.name = "InventoryLook"
	_inventory_look_button.pressed.connect(_inspect_selected_inventory_item)
	actions.add_child(_inventory_look_button)
	_inventory_use_button = _make_suitcase_button(Color("be5228"), Color("fff1c7"))
	_inventory_use_button.name = "InventoryUse"
	_inventory_use_button.pressed.connect(_use_selected_inventory_item)
	actions.add_child(_inventory_use_button)
	for action: Button in [_clear_item_button, _inventory_look_button, _inventory_use_button]:
		action.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		action.custom_minimum_size.y = 52
		action.add_theme_font_override("font", heading_font)
		action.add_theme_font_size_override("font_size", 23)
	_inventory_case.configure_layout({
		"art": case_art, "title": _inventory_title, "close": _inventory_close_button,
		"filters": filters, "status": _inventory_status, "scroll": _inventory_scroll,
		"grid": _inventory_grid, "actions": actions,
	})


func _make_suitcase_button(pigment: Color, ink: Color) -> Button:
	var button: Button = _make_small_button()
	var normal := ThemeFactory.make_box(pigment, Color("6d451f"), 1, 8, 15, 5)
	normal.border_width_bottom = 3
	normal.shadow_color = Color(0.13, 0.065, 0.02, 0.26)
	normal.shadow_size = 2
	normal.shadow_offset = Vector2(0, 2)
	var hover: StyleBoxFlat = normal.duplicate()
	hover.bg_color = pigment.lightened(0.12)
	hover.border_color = Color("f8de98")
	var pressed: StyleBoxFlat = normal.duplicate()
	pressed.bg_color = Color("376c59")
	pressed.border_color = Color("f6d782")
	pressed.border_width_bottom = 1
	var disabled: StyleBoxFlat = normal.duplicate()
	disabled.bg_color = pigment.darkened(0.2)
	disabled.border_color = Color("765735")
	var focus := ThemeFactory.make_box(Color.TRANSPARENT, Color("fff1b5"), 2, 8, 15, 5)
	button.add_theme_stylebox_override("normal", normal)
	button.add_theme_stylebox_override("hover", hover)
	button.add_theme_stylebox_override("pressed", pressed)
	button.add_theme_stylebox_override("disabled", disabled)
	button.add_theme_stylebox_override("focus", focus)
	for state: String in ["font_color", "font_hover_color", "font_focus_color"]:
		button.add_theme_color_override(state, ink)
	button.add_theme_color_override("font_pressed_color", Color("fff2c5"))
	button.add_theme_color_override("font_disabled_color", Color("cbb38c"))
	button.add_theme_font_size_override("font_size", 21)
	return button


