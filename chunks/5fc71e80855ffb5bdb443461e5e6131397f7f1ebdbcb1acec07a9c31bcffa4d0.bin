          "transcription_review_required": false
        },
        "jshb1-11": {
          "path": "res://assets/languages/de/audio/jshb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "eedb041d7cd919ff8e85a8cb770ae65cf0dade1778fa52aa10ce7d032cb35fcc",
