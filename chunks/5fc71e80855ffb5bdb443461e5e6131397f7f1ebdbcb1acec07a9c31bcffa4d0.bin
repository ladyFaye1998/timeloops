½~øÒ¢CúÎøŸvôïýö._Øã¡ã²óó³U¯l2(G{^™†œä£ÇÈk¼È¥ó>ã\Ü{yòÚ6ð¾³a6ƒÍ³n¾ñ¯çËÉ‡rr¦_¢ö‚í+X8=úÝë9÷¨í+÷?1ëñPÞÁñuGŸìÙhû0,æ\&ÁaAïåÒºñ2my®®ó9á„…¿Ò˜—t¾<Y¹x…ý,Sóã¯¶v¯Ë·ëŒ{MZÓÐ>±üíòcþÊñw7øîýÈ]ö½­æâÅàß©oriÏ}#lx…¼©‡‰ç4Cžþ˜ÉqXü±FNîŸš.˜ÿ"o«»3Ú#(Ã	^…xxvˆ9YÍëgâñç¬ñs—ÆÅÌòt␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform bool sign_active = false;
uniform bool stars_active = false;
uniform float sign_phase = 0.0;
uniform float star_phase = 0.0;

float glint(vec2 point, vec2 center, float offset) {
	vec2 distance = abs(point-center);
	float pulse = pow(max(0.0,sin(star_phase * 6.0 + offset)),3.0);
	float core = exp(-dot(distance,distance)/7.0);
	float rays = exp(-distance.x * 2.2 - distance.y * 0.5) + exp(-distance.y * 2.2 - distance.x * 0.5);
	return (core * 0.55 + rays * 0.3) * pulse;
}

void fragment() {
	vec2 pixel = UV * vec2(640.0,480.0);
	vec3 color = vec3(1.0,0.91,0.50);
	float opacity = 0.0;
	if (stars_active) {
		// Measured visible star centers on rooms_shared/streets/street12-v1.png (1448x1086); see landmark-measurements.json.
		vec2 to_stage = vec2(640.0,480.0)/vec2(1448.0,1086.0);
		opacity += glint(pixel,vec2(218.5,376.9)*to_stage,0.0);
		opacity += glint(pixel,vec2(267.1,377.0)*to_stage,0.6);
		opacity += glint(pixel,vec2(317.3,377.0)*to_stage,1.2);
		opacity += glint(pixel,vec2(217.9,446.0)*to_stage,1.8);
		opacity += glint(pixel,vec2(267.0,446.1)*to_stage,2.4);
		opacity += glint(pixel,vec2(317.4,445.8)*to_stage,3.0);
		opacity += glint(pixel,vec2(217.3,598.1)*to_stage,3.6);
		opacity += glint(pixel,vec2(266.3,598.4)*to_stage,4.2);
		opacity += glint(pixel,vec2(316.4,598.1)*to_stage,4.8);
		opacity += glint(pixel,vec2(316.3,689.4)*to_stage,5.4);
	}
	COLOR = vec4(color,clamp(opacity,0.0,1.0));
}
