        },
        "jdoa2-10": {
          "path": "res://assets/languages/de/audio/jdoa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a0b2293b1529ec054214ffeafab57cb61a57b08c7101385e28aa570ada17f348",
          "text": "Es ist aus, wie kommt es?",
          "source_text": "It's off, how come?",
          "transcription_review_required": false
        },
        "jdoa2-20": {
          "path": "res://assets/languages/de/audio/jdoa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f2e243879a190d8b66ca662b9c9fc5fedbe6b5c761b14323a0ba22dd42869f0d",
          "text": "Wer steckt Ihrer Meinung nach dahinter?",
