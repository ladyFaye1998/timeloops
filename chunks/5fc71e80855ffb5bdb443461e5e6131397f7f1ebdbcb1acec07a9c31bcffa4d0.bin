    "de": {
      "clips": {
        "laa-s14": {
          "path": "res://assets/languages/de/audio/laa-s14.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b80699873d22b7642ddc9350f70686d6d2d964c1f7adc8ba6b1b873e44565579",
          "text": "Das bedeutet keinen Unterschied zwischen der blauen und der roten RÃ¶hre.",
          "source_text": "That doesn't indicate a difference between the blue and the red tubes.",
          "transcription_review_required": false
        },
        "laa1-02a": {
          "path": "res://assets/languages/de/audio/laa1-02a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a9956990d4fe4b7a9418f24623b8e3df6b7c7340f86ac763bcac79f3e72ff2bf",
          "text": "Das richtige Rohr wiegt etwas weniger als die anderen. Meine Waage registriert solche kleinen Unterschiede nicht. Ruiniert!",
          "source_text": "The correct tube weighs a little less than the others. My scale doesn't register such small differences. Ruined!",
          "transcription_review_required": false
        },
        "laa1-s12": {
          "path": "res://assets/languages/de/audio/laa1-s12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ce2c64dd648ad3191aa27870ab4c8c96cc238124b3516563f43f63ba775a587e",
          "text": "Man muss etwas auf die Waage legen, um herauszufinden, welches Rohr weniger wiegt.",
          "source_text": "You need to put something on the scale to find out which tube weighs less.",
          "transcription_review_required": false
        },
        "laa1-s13": {
          "path": "res://assets/languages/de/audio/laa1-s13.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d0426a438d4214acf296fe0262bc68b1ad2276d3841b75988e04bae53e9c45ca",
          "text": "Um diese Waage zu verwenden, mÃ¼ssen Sie etwas auf beide Seiten legen.",
          "source_text": "To use this scale, you need to put something on both sides of it.",
          "transcription_review_required": false
        },
        "laa1-s2": {
          "path": "res://assets/languages/de/audio/laa1-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5e6b44eed66ed6f2e9e689dadc97a0d4cd6d923dfb13ff5a34becb74dbf44c70",
          "text": "Der Unterschied ist noch nicht zu erkennen.",
          "source_text": "It doesn't show the difference yet.",
          "transcription_review_required": false
        },
        "laa1-s3": {
          "path": "res://assets/languages/de/audio/laa1-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "36ae82b264ceec4391e87191bbca4eafd861446046b0873ed266c23776bff163",
          "text": "Dies ist eine Bodenwaage. Es kann nichts wiegen, das weniger als eine Erdmasse hat.",
          "source_text": "This is a ground scale. It can't weigh anything that's less than a ground.",
          "transcription_review_required": false
        },
        "laa1-s4": {
          "path": "res://assets/languages/de/audio/laa1-s4.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1e7ee52aa1426ad423e10885ea38a133f75c4f626a5b4d8cde7a9d88afe3bacb",
          "text": "Erinnern Sie sich, ich habe Ihnen gesagt, dass das Problem darin besteht, zwischen den blauen und roten RÃ¶hren zu unterscheiden? Die gelbe RÃ¶hre ist nicht relevant.",
          "source_text": "Remember, I told you that the problem is to differentiate between the blue and red tubes? The yellow tube is not relevant.",
          "transcription_review_required": false
        },
        "laa1-s7": {
          "path": "res://assets/languages/de/audio/laa1-s7.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "48a2af325b9085494d8e7dfd36592d55aca424be1705a2963152f332ef39a2fb",
          "text": "Vielleicht gelingt es Ihnen eines Tages. Vorausgesetzt, ich lebe lange genug.",
          "source_text": "Maybe you'll succeed one day. That's if I live long enough.",
          "transcription_review_required": false
        },
        "laa1-s8": {
          "path": "res://assets/languages/de/audio/laa1-s8.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1abed923d467baebf99043aa77a04ab30b0e29c86cdd622d1426ff7f170a33bb",
          "text": "HÃ¼bsch! Jetzt sehe ich, dass die blaue RÃ¶hre weniger wiegt. Du hast einen Multiplikationstrick verwendet. Sie haben viele RÃ¶hren verwendet, um das Gewicht einer RÃ¶hre zu ermitteln. Obwohl ich daran auch hÃ¤tte denken kÃ¶nnen, wenn ich nicht so aufgeregt gewesen wÃ¤re.",
          "source_text": "Nice! Now I can see that the blue tube weighs less. You used a multiplication trick. You used many tubes to find the weight of one tube. Although I could have thought of that too if I wasn't so agitated.",
          "transcription_review_required": false
        },
        "laa1-s9": {
          "path": "res://assets/languages/de/audio/laa1-s9.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f17c481622826899753eb9c4c9ced414e4e5ca131f8b07e4cd45bbc525c0333b",
          "text": "Versuchen Sie herauszufinden, welches Rohr weniger wiegt. Wenn Sie sicher sind, klicken Sie auf das Symbol, das Ihre Antwort anzeigt.",
          "source_text": "Try to find out which tube weighs less. When you know for sure, click on the icon that shows your answer.",
          "transcription_review_required": false
        },
        "mel13": {
          "path": "res://assets/languages/de/audio/mel13.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6a98886692db3681eb2ef4166388766167bb8856e65fd7f88c256b3b8fa08b2f",
          "text": "Finden Sie mit der Waage heraus, welches Rohr weniger wiegt.",
          "source_text": "Use the scale to find out which tube weighs less.",
          "transcription_review_required": false
        },
        "mel14": {
          "path": "res://assets/languages/de/audio/mel14.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "759ddb6aea18705b8f53fdc3033d29fec802794928c094c5c1feeff680a8a1f8",
          "text": "HÃ¶ren Sie, ich denke, Sie sollten diese RÃ¶hren besser vergessen. Konzentrieren Sie sich mehr auf die FlÃ¼ssigkeit in ihnen und den Gewichtsunterschied.",
          "source_text": "Listen, I think you'd better forget about these tubes. Concentrate more on the liquid inside them, and the difference in their weights.",
          "transcription_review_required": false
        },
        "mel15": {
          "path": "res://assets/languages/de/audio/mel15.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "75b6a35b30511b36dc6ca30b7da53e8013139bfa82c6e634ff430721c3b6d3da",
          "text": "Hey, ich habe eine Idee. Warum versuchen Sie nicht, groÃŸe Mengen der FlÃ¼ssigkeit zu vergleichen? Das kann auf einen Unterschied hinweisen.",
          "source_text": "Hey, I've got an idea. Why don't you try to compare large quantities of the liquid? That may indicate a difference.",
          "transcription_review_required": false
        },
        "mel16": {
          "path": "res://assets/languages/de/audio/mel16.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f55fe68d6a680f8eac5e59c16f95e121186a0a3bf7f07830845d5b12dc05d2db",
          "text": "Jewel, ich sage dir, auf diesem Zettel stand etwas Wichtiges. Wir mÃ¼ssen einen Weg finden, herauszufinden, was es ist.",
          "source_text": "Jewel, I'm telling you, something important was written on that note. We've got to think of a way to find out what it is.",
          "transcription_review_required": false
        },
        "mel17": {
          "path": "res://assets/languages/de/audio/mel17.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4eb4a341c3a08f5567d766fbf8106d6b51682c168f18262a61ba3bace3a3f45f",
          "text": "Wenn Sie die Notiz selbst nicht erhalten kÃ¶nnen, kÃ¶nnen Sie sich vielleicht eine MÃ¶glichkeit vorstellen, sie zu reproduzieren.",
          "source_text": "If you can't get the note itself, maybe you can think of a way to reproduce it.",
          "transcription_review_required": false
        },
        "sub2-s1": {
          "path": "res://assets/languages/de/audio/sub2-s1.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b56aa2cfd38cf6a146c95a44b52977df4c1400e43490b62797d9b88b0743fa51",
          "text": "Sie kann einfach nicht herausfinden, was in der Notiz steht.",
          "source_text": "There's just no way she can find out what was written in the note.",
          "transcription_review_required": false
        },
        "mel34": {
          "path": "res://assets/languages/de/audio/mel34.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "700c37e2a40156060e2cbb60ad3effcd3431164688823d1d15860e767bd6d12b",
          "text": "Brauchen Sie Hinweise? Ich habe gehÃ¶rt, dass das BlumenmÃ¤dchen viel weiÃŸ.",
          "source_text": "Do you want some clues? I heard that the flower girl knows a lot.",
          "transcription_review_required": false
        },
        "shyan01": {
          "path": "res://assets/languages/de/audio/shyan01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c326462e361f2dbf04f44852ebc67a95e818823949ad09bd26916dec96f4e964",
          "text": "Hey, Fremder. Du bist ein Reisender, genau wie ich. Lass uns ein kleines Quizspiel spielen. Ich erzÃ¤hle dir etwas Ã¼ber die 60er und du sagst mir, ob es wahr oder falsch ist.",
          "source_text": "Hey, stranger. You're a traveler just like me. Let's play a little game of trivia. I'll tell you something about the 60s, and you tell me if it's true or false.",
          "transcription_review_required": false
        },
        "shyan02": {
          "path": "res://assets/languages/de/audio/shyan02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b0e70a0b1254ea48aae363a8bbc9493d5eae93310df81e618ea55e79b8f0c93",
          "text": "Wenn Menschen schlafen gehen, ziehen sie ihre MÃ¤ntel aus.",
          "source_text": "When people go to sleep, they take off their coats.",
          "transcription_review_required": false
        },
        "shyan03": {
          "path": "res://assets/languages/de/audio/shyan03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4c6bb7e25fba9d1181e4131861d82a813a86c3ed464398adba66be9de796c373",
          "text": "Der Alice nahe zu stehen scheint. Anscheinend ist das nicht so nah.",
          "source_text": "Who seems to be close to Alice. Apparently, is not that close.",
          "transcription_review_required": false
        },
        "shyan04": {
          "path": "res://assets/languages/de/audio/shyan04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "635bfdfbfffbadd8bab9d856ac6ed62bc056446e061255381bec6d5d3a499dbe",
          "text": "Comics sind manchmal nicht zum Lachen.",
          "source_text": "Comics are sometimes, no laughing matter.",
          "transcription_review_required": false
        },
        "shyan05": {
          "path": "res://assets/languages/de/audio/shyan05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6a7f7bc497157766e2db434116d5136711054f497a18e2ff9a9907cd4860b28d",
          "text": "Ein Foto ist eine persÃ¶nliche Angelegenheit. Wenn es der Entwicklung Ã¼berlassen wird, sollte es zurÃ¼ckgewonnen werden.",
          "source_text": "A photograph is a personal matter. When left to be developed, it should be reclaimed.",
          "transcription_review_required": false
        },
        "shyan06": {
          "path": "res://assets/languages/de/audio/shyan06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "960eddf9c9c26b6cfbb727d08753caccc591976fa70211c36d7b79fb0ea7373a",
          "text": "Wer auch immer Briefe an Alice schreibt, macht einige ziemlich schlimme Fehler.",
          "source_text": "Whoever it is that writes letters to Alice makes some pretty bad mistakes.",
          "transcription_review_required": false
        },
        "shyan07": {
          "path": "res://assets/languages/de/audio/shyan07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9cc97cd95b5658e7ec7b1e6c955b7be6c602bbc2bec096e99cfd2cfa4fe2e5cb",
          "text": "Wer Unrecht tut, kann die Dinge nicht so sehen, wie sie wirklich sind.",
          "source_text": "The person who does unjust things can't see things as they really are.",
          "transcription_review_required": false
        },
        "shyan08": {
          "path": "res://assets/languages/de/audio/shyan08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "79a4e285e83be058efd294a36a9f12e7011c8ebe518cecdee1f3e1ca7cf98e29",
          "text": "Passt auf. Das X hat das Bild des nÃ¤chsten.",
          "source_text": "Pay attention. The X has the picture of the next.",
          "transcription_review_required": false
        },
        "shyan09": {
          "path": "res://assets/languages/de/audio/shyan09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "763d9224ac6d5f814fd223249a836c5d4242276dd1702ce9afb95e006551d0ef",
          "text": "Die Rolling Stones wurden 1965 von der KÃ¶nigin von England zum britischen Ritter erhoben.",
          "source_text": "The Rolling Stones received British knighthood from the Queen of England in 1965.",
          "transcription_review_required": false
        },
        "shyan10": {
          "path": "res://assets/languages/de/audio/shyan10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a48c41aef33408e48ba045bc042bcbaaff8eaeb1a997dc4602cbbb14a2943625",
          "text": "Es waren die Beatles, denen diese Ehre zuteil wurde.",
          "source_text": "It was the Beatles who received this honor.",
          "transcription_review_required": false
        },
        "shyan11": {
          "path": "res://assets/languages/de/audio/shyan11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a71ba623c61ddcb529739be8167db6d6218b1020d464dfc50dae8b228b5d9dbb",
          "text": "Alan Ginsburg und Timothy Leary waren die Beat-Poeten der Flower-Power-Generation.",
