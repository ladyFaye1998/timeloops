s?žÏýîy4tkÀþÐÎÿö|'ÆVó·:OÙM3/±]æ‰çÓ*Þ/ºràè¹Ö°ƒãî*VØ4nôŒ¹¢¿šOè–6èõ˜Kmw␀>ë4Ñ=´ý$ë"‚ŸÉ&óöæ¾nux—rÏAí –ÞØ™07fçß{”ºenyÚRÃ<#¿æqVá“<ù#Ä88+|õ¸:}v:»û•½‘ß×óGF]ö=F°.q}¹/å¦w&)¼ý”;»#<vÍË¬×<½s¶qçuáïIðJGÂ‡Æ'ùXIíñÙvötWÞK<‰ïø¿ ç:ÔÁ}ëð¾hrŸé™U»9¬Á‹/ãi¬zY¼¢šîB´?3ÛÞâqÁþ|ÓgT<0­òWƒt\ÆïíýÛô@;Øh†‰{áçšŸamo¸–åR©‰T?pZ.-ýª‘•Í¢ë[½;Ñë'‹þº%'¢¿a␀ˆ5aª?Î|æÐÿ{d}Â»">6òµù÷ãÔÖ¹íûšŸÒd:êýoÉ}»Ûæ Søÿ›™¸‡|Ð¶§	zðÎçùQ2hö‰_-3c»òGcü¦îàÎ–k¬Eáô)'îK=éì¾o¥´ãõ³è þ=|·öÜµÐ2mŸ8m¥lâƒÿ␀ìÂçÊd|ñ×¬å:1A]ð¹=‘«¾¨=ùäŸì‚ð8vÍÚù-{føN²Žo3¹¾Ü7v·>ã?0¶§1ù␀`™¡ïõz=›…—è¡eg~g^þg)óK\¼/ý±’ÛŸ“z_HW1—ò¯t9ŽO]n„¿4G›p»‹fŽ~R\ÈïO˜1öÅõ¨yóR×Mô»ãÎcðÁPïz Xƒ—¸qÄ³²]Qùž/‰~±·`øÈß­ÞÜÛDÞü/Ü»÷³p´ïou␀ŸŸý½šâÊ:-»ãcÄí”ó^þm7:ÈÆàQO¸ùÞ”zÿ=Oü›ÁÍÌ<®‡HÏ0Ž!ëêkÔn\üÝøÿØ‰¿ã¨²#ûþ+2Î÷äºU·mé-•fÂÚ¡ß¼ZSö#=—¾M]Ë‹df’oà„§»°€^x%!Cðõ.lñÏðòÍsï¢‹ûX3¤úÊÏyÎî¯M–(GèÝÏXß¾¨ßõ¹É¿eb?␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
uniform sampler2D underpaint : source_color, filter_linear_mipmap;
uniform vec2 left_points[80];
uniform vec2 right_points[80];
uniform int left_count = 0;
uniform int right_count = 0;
uniform vec4 left_bounds;
uniform vec4 right_bounds;
uniform bool expose_left = true;
uniform bool expose_right = true;

bool in_bounds(vec2 p, vec4 b) {return p.x >= b.x && p.y >= b.y && p.x <= b.x+b.z && p.y <= b.y+b.w;}
bool inside_left(vec2 p) {
 bool result=false;
 for(int i=0;i<80;i++) {if(i>=left_count)break;int j=i==0?left_count-1:i-1;vec2 a=left_points[i];vec2 b=left_points[j];if((a.y>p.y)!=(b.y>p.y) && p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)result=!result;}
 return result;
}
bool inside_right(vec2 p) {
 bool result=false;
 for(int i=0;i<80;i++) {if(i>=right_count)break;int j=i==0?right_count-1:i-1;vec2 a=right_points[i];vec2 b=right_points[j];if((a.y>p.y)!=(b.y>p.y) && p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)result=!result;}
 return result;
}
float edge_distance(vec2 p, bool left) {
 float result=1e5;int count=left?left_count:right_count;
 for(int i=0;i<80;i++) {if(i>=count)break;int j=i==0?count-1:i-1;vec2 a=left?left_points[i]:right_points[i];vec2 b=left?left_points[j]:right_points[j];vec2 v=b-a;float t=clamp(dot(p-a,v)/max(dot(v,v),.0001),0.,1.);result=min(result,length(p-(a+v*t)));}
 return result;
}
void fragment() {
 vec2 p=UV*vec2(1024.,1536.);
 bool l=expose_left && in_bounds(p,left_bounds) && inside_left(p);
 bool r=expose_right && in_bounds(p,right_bounds) && inside_right(p);
 float amount=0.;if(l)amount=max(amount,smoothstep(0.,5.,edge_distance(p,true)));if(r)amount=max(amount,smoothstep(0.,5.,edge_distance(p,false)));
 COLOR=mix(texture(TEXTURE,UV),texture(underpaint,UV),amount);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
uniform sampler2D underpaint:source_color,filter_linear_mipmap;
uniform vec2 clip_points[32];
uniform int clip_count=0;
uniform sampler2D held_prop:source_color,filter_linear_mipmap;
void fragment(){
 vec2 p=UV/TEXTURE_PIXEL_SIZE;float d=100000.;bool inside=false;
 for(int i=0;i<32;i++){
  if(i>=clip_count)break;int j=i+1;if(j>=clip_count)j=0;
  vec2 a=clip_points[i];vec2 b=clip_points[j];vec2 v=b-a;
  float t=clamp(dot(p-a,v)/max(dot(v,v),.00001),0.,1.);d=min(d,length(p-(a+t*v)));
  if((a.y>p.y)!=(b.y>p.y)&&p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)inside=!inside;
 }
 float width=max(length(dFdx(p)),length(dFdy(p)))*.8;
 float mask=smoothstep(-width,width,inside?d:-d);
 vec4 color=mix(texture(TEXTURE,UV),texture(underpaint,UV),mask);
 if(p.x>=775. && p.y>=335. && p.y<=760.)color=texture(held_prop,UV);
 COLOR=color;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[remap]

