­.ÿ=Ž&£ÄœæÑ†¡Ëü±Îß5õ ¢•ÁÍw9ˆboÙü¿_äÓÆwÃ_»YÖõ–fpG«ñô©øÈ_î»Ö°û¼O[›wH‰ºfçé8ógë# ½¢ßÜŸIÒ€¬™~ÃŠò‹¬Úÿ¯»ó##âúbÌ}ÙrÈG´+°|ñxÅykÒƒàž0]“º©ê}‹~ÇtÜ/Nó9G—þì|ŠP£†83ä7z ‘-ß¨qïzÑtØwNÞ¡ß3myFÅí»	s-/(?Ögg1gÉÌ¶¶|Zìö*Õ»XyJ]ÐpOŠ7ñÏóÅ^Ö;æ”‡OŽgÝ þˆÞzßos×ù¾ùëoí#×ì´¯î+ä¬eí÷O8¼gÄ9úà/†Íûlç␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
// The front half of the elliptical lip occludes tubes placed inside the pan.
uniform vec4 pan_region;
void fragment() {
    vec4 pixel = texture(TEXTURE, UV);
    vec2 local_uv = (UV - pan_region.xy) / pan_region.zw;
    float ellipse_x = (local_uv.x - 0.5) / 0.48;
    float front_lip = 0.14 + 0.20 * sqrt(max(0.0, 1.0 - ellipse_x * ellipse_x));
    pixel.a *= smoothstep(front_lip - 0.004, front_lip + 0.004, local_uv.y);
    COLOR = pixel;
}
