~nøuò¸uÿùpô™y`×ÙÇ]†’‘}^8?hZù0&>:ö7gÇß_Ã6#ó¹_Žiq»ëïõ®¡C{\\î²ï…l2t¸ÃïXLLùgÎ@Ü¶)¶=yLža¤¹\,=¾PÑGæ=¤>¹Ë×ÆÿÃDki#©¾G/ÓoÞíö;«¸H¯qð¢¦ÆúLQËmyS·á¥Ò±º?j¼Töäâ`-þÉ¾0¼ßoð÷_î÷4§÷Z§ÕÍUÀ?p{êùÐiŒ_ÿi³q›7ãæêÀåwpœÄ␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform sampler2D evidence : source_color, filter_linear;
uniform vec4 evidence_rect;
uniform float progress : hint_range(0.0,1.0)=0.0;
void fragment() {
	vec2 source_uv=evidence_rect.xy+UV*evidence_rect.zw;
	vec4 authored=texture(evidence,source_uv);
	float graphite=(1.0-smoothstep(0.22,0.94,dot(authored.rgb,vec3(0.299,0.587,0.114))))*authored.a;
	float band=1.0-smoothstep(0.20,0.28,abs(UV.y-0.43));
	float first=clamp(progress*2.0,0.0,1.0);
	float second=clamp(progress*2.0-1.0,0.0,1.0);
	float revealed=max(band*first,second);
	COLOR=vec4(vec3(0.13,0.12,0.115),graphite*revealed);
}
