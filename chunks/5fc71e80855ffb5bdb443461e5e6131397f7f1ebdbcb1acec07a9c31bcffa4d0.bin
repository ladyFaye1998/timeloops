          "sha256": "87feb3a90f3ef6d1b4be5bcc67fc560b5ed3801f90d9d2592042479763e5a068",
          "text": "Zie je? Het past bij mij.",
          "source_text": "You see? It fits me.",
          "transcription_review_required": false
        },
        "doa3b-s1": {
          "path": "res://assets/languages/nl/audio/doa3b-s1.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "029cbcc48008e8dec27c7054f2237a06436e377a14d6c98d7191846b88a5eb73",
          "text": "Dat bewijst niet dat het niet van mij is.",
          "source_text": "That doesn't prove it's not mine.",
          "transcription_review_required": false
        },
        "jia3b-s2": {
          "path": "res://assets/languages/nl/audio/jia3b-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "afa96db4450574e4fd11f92a8ad7813bb659663552d319be0464a463b18871dc",
          "text": "Briljant idee om Dorothy het horloge te geven om te bewijzen dat het niet van haar is. Haar bruine lijn laat zien dat ze een horloge heeft met een bredere band.",
          "source_text": "Brilliant idea to give Dorothy the watch to prove that it's not hers. Her tan line shows that she has a watch with a wider strap.",
          "transcription_review_required": false
        },
        "mel19": {
          "path": "res://assets/languages/nl/audio/mel19.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b142ad6e1c994eb1daa8fa76de927ddb37b7cd5d05e4c09035d7dbe23a982854",
          "text": "Dorothy wil het horloge van Alice? Gebruik het om te bewijzen dat het niet van haar is.",
          "source_text": "Dorothy wants Alice's watch? Well, use it to prove that it doesn't belong to her.",
          "transcription_review_required": false
        },
        "mel20": {
          "path": "res://assets/languages/nl/audio/mel20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "70e5ad6bc4c24296d43c61290722358142aaa38d6dad39900054a16455cae1d4",
          "text": "In plaats van te bewijzen dat het horloge van Alice is, zou het gemakkelijker zijn om te bewijzen dat het horloge niet van Dorothy is.",
          "source_text": "Instead of proving that the watch belongs to Alice, it would be easier to prove that the watch doesn't belong to Dorothy.",
          "transcription_review_required": false
        },
        "al-m": {
          "path": "res://assets/languages/nl/audio/al-m.mp3",
