␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform float phase = 0.0;
uniform float green_mix : hint_range(0.0, 1.0) = 0.0;
uniform float softness : hint_range(0.0, 1.0) = 0.0;

vec3 spectrum(float hue) {
	return clamp(abs(fract(hue + vec3(0.0, 0.6666667, 0.3333333)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

void fragment() {
	vec2 p = (UV - 0.5) * vec2(1.3, 1.0);
	float radius = length(p);
	float angle = atan(p.y, p.x);
	float spiral = sin(angle + radius * 56.0 - phase);
	float aa = max(fwidth(spiral), 0.015) + softness * 0.42;
	float band = smoothstep(-aa, aa, spiral - 0.05);
	vec3 rainbow = spectrum(angle / 6.2831853 + radius * 0.17 + 0.5);
	vec3 color = mix(rainbow, vec3(0.12, 0.94, 0.46), green_mix);
	float center_glow = exp(-radius * 17.0) * 0.18;
	vec3 ink = vec3(0.008, 0.024, 0.026);
	vec3 glow = color * (band * 0.88 + center_glow);
	float vignette = 1.0 - smoothstep(0.42, 0.78, radius) * 0.25;
	COLOR = vec4((ink + glow) * vignette, 1.0);
}
