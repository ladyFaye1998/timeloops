const TouchScroll = preload("res://src/ui/native_touch_scroll.gd")
var pressed: int = 0

func _initialize() -> void:
	call_deferred("_run")

func _touch(down: bool, position: Vector2) -> void:
	var event := InputEventScreenTouch.new()
	event.index = 0; event.pressed = down; event.position = position
	Input.parse_input_event(event)
	Input.flush_buffered_events()

func _drag(position: Vector2, relative: Vector2) -> void:
	var event := InputEventScreenDrag.new()
	event.index = 0; event.position = position; event.relative = relative
	Input.parse_input_event(event)
	Input.flush_buffered_events()

func _run() -> void:
	root.size = Vector2i(400, 500)
	root.content_scale_size = Vector2i(400, 500)
	create_timer(12).timeout.connect(func() -> void: quit(1))
	var scroll := ScrollContainer.new()
	scroll.position = Vector2(10, 10); scroll.size = Vector2(300, 220)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	root.add_child(scroll)
	TouchScroll.attach(scroll)
	var stack := VBoxContainer.new()
	stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(stack)
	for index: int in range(12):
		var button := Button.new()
		button.text = "Question %d" % index
		button.custom_minimum_size = Vector2(270, 70)
		button.pressed.connect(func() -> void: pressed += 1)
		stack.add_child(button)
	for frame: int in range(4): await process_frame
	print("TOUCH_SCROLL_FIXTURE viewport=", root.get_visible_rect(), " button=", stack.get_child(1).get_global_rect())
	# New descendants must be connected, not only the initial empty scroll.
	_touch(true, Vector2(100, 130))
	await process_frame
	_touch(false, Vector2(100, 130))
	await process_frame
	print("TOUCH_SCROLL_FIXTURE pressed=", pressed)
	assert(pressed == 1, "Normal touch tap was changed")
	var before: int = pressed
	_touch(true, Vector2(100, 130))
	_drag(Vector2(100, 115), Vector2(0, -15))
	_drag(Vector2(100, 75), Vector2(0, -40))
	_drag(Vector2(100, 45), Vector2(0, -30))
	_touch(false, Vector2(100, 45))
	await process_frame
	assert(scroll.scroll_vertical >= 70, "Touch drag over Button did not scroll")
	assert(pressed == before, "Touch scroll activated a question on release")
	# A topmost modal receives touch; covered content must remain unchanged.
	var shield := Control.new()
	shield.position = Vector2.ZERO; shield.size = Vector2(400, 500)
	shield.mouse_filter = Control.MOUSE_FILTER_STOP
	root.add_child(shield)
	await process_frame
	var saved: int = scroll.scroll_vertical
	_touch(true, Vector2(100, 130))
	_drag(Vector2(100, 40), Vector2(0, -90))
	_touch(false, Vector2(100, 40))
	await process_frame
	assert(scroll.scroll_vertical == saved, "A drag scrolled behind the modal")
	print("NATIVE_TOUCH_SCROLL_PASS: tap, content swipe, no accidental choice, modal shielding")
	quit(0)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node

## Source-backed route driver. Starts a fresh game and never grants inventory,
## events, story numbers, activity results or location transitions directly.
## Media is fast-forwarded through the presentation host; audio listening and
## physical Android playthroughs are separate validation tasks.
const Adventure = preload("res://src/presentation/full_adventure_view.gd")
const ValueParser = preload("res://src/compat/legacy_value_parser.gd")
const LegacyArtAudit = preload("res://src/diagnostics/legacy_art_audit.gd")
var view: JuliaFullAdventureView
var route_story: int
var trace: Array[Dictionary] = []
var failed := false
var capture_dir: String = ""
var captures: Array[String] = []
var _captured_locations: Dictionary = {}
var bag_solutions := {
	1: {"cafea": ["JulBag17",15], "cafed": ["JulBag13",14], "cloths": ["JulBag15",14], "lab2": ["JulBag12",13], "papern": ["JulBag11",12], "photos": ["JulBag14",11], "diskr": ["JulBag16",14]},
	2: {"cafea": ["JulBag25",15], "cafed": ["JulBag27",14], "cloths": ["JulBag24",14], "lab2": ["JulBag28",13], "papern": ["JulBag26",12], "photos": ["JulBag29",11], "diskr": ["JulBag23",14]}
}

func begin(story: int, edition: String) -> void:
	route_story = story
	if not OS.has_feature("android") and not OS.has_feature("web"):
		get_tree().root.size = Vector2i(1280,720)
	get_tree().root.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_IGNORE
	TranslationServer.set_locale(JuliaGameLocalization.current)
	view = Adventure.new()
	view.presentation_edition = edition
	add_child(view)
	await get_tree().process_frame
	await view.start_new_game(JuliaGameLocalization.current)
	view.effect_host.playback_rate = 0.0
	view.ending_sequence.playback_rate = 64.0
	view.ending_sequence.media_problem.connect(func(message: String) -> void: require(false,message))
	view.minigame_view.set_internal_audio_enabled(false)
	await drain()
	await questions()
	await goodbye()
	await click(18 if story == 1 else 19)
	require(view.session.state.has_event("FaceSelect"), "Opening parent choice completed")
	mark("opening completed")
	await capture_checkpoint("opening")

func navigate(target: String) -> void:
	if failed: return
	LegacyArtAudit.context = "%s-part%d" % [target, view.session.state.part]
	if view.session.state.dialogue_open: await goodbye()
	view.call("_clear_held_item")
	var queue: Array = [[view.current_location_id(), []]]
	var visited: Dictionary = {}
	var path: Array = []
	while not queue.is_empty():
		var current: Array = queue.pop_front()
		var location: String = current[0]
		if visited.has(location): continue
		visited[location] = true
		if location == target:
			path = current[1]
			break
		var definition: Dictionary = view.catalog.resolve_location(location, view.session.state.story, "heb")
		for hotspot: Dictionary in definition.get("hotspots", []):
			var command: Array = hotspot.get("click_command", [])
			if command.size() < 2 or name_of(command[0]).to_lower() != "goto": continue
			var next_path: Array = current[1].duplicate(true)
			next_path.append({"from":location,"channel":int(hotspot.channel),"to":name_of(command[1])})
			queue.append([name_of(command[1]),next_path])
		var special: Dictionary = {"lab1": {"channel":2,"to":"lab2"}, "street1":{"channel":1,"to":"photo"}}
		if special.has(location):
			var next_path: Array = current[1].duplicate(true)
			var edge: Dictionary = special[location].duplicate()
			edge["from"] = location
			next_path.append(edge)
			queue.append([edge.to,next_path])
	require(not path.is_empty() or view.current_location_id() == target, "Reachable route to " + target)
	for edge: Dictionary in path:
		await click(int(edge.channel))
		require(view.current_location_id() == edge.to, "Navigation " + str(edge))
	mark("arrived " + target)
	await capture_checkpoint(target)

func click(channel: int, double_click: bool = false) -> void:
	if failed: return
	var before: String = view.current_location_id()
	var result: Dictionary = view.presenter.activate_hotspot(channel, double_click)
	require(bool(result.get("ok", false)), "Playable hotspot %s:%d: %s" % [before, channel, str(result.get("reason", ""))])
	await drain()
	mark("click %s:%d%s" % [before,channel," double" if double_click else ""])

func collect() -> void:
	if failed: return
	for hotspot: Dictionary in view.session.presenter_model().get("hotspots", []):
		if not bool(hotspot.get("visible")) or not bool(hotspot.get("enabled")): continue
		var command: Array = hotspot.get("click_command", [])
		var double_command: Array = hotspot.get("double_click_command", [])
		if command.is_empty(): command = double_command
		if command.size() < 2 or name_of(command[0]).to_lower() not in ["zoomitem","pickitem"]: continue
		if double_command.is_empty(): continue
		var item: String = name_of(command[1])
		if view.session.state.has_inventory_item("found", item): continue
		await click(int(hotspot.channel), true)
		if view.presentation_edition == "modern":
			require(view.session.state.has_inventory_item("found", item) and view.session.state.held_item.is_empty(), "Picked up and stowed source clue " + item)
		else:
			require(view.session.state.held_item.to_lower() == item.to_lower(), "Picked up source clue " + item)
		view.call("_clear_held_item")
		require(view.session.state.has_inventory_item("found", item), "Stored source clue " + item)

func offer(item: String, channel: int) -> void:
	if failed: return
	var result: Dictionary = view.session.select_inventory_item(item)
	require(bool(result.get("ok", false)), "Obtained before offering " + item)
	await click(channel)
	view.call("_clear_held_item")
	mark("offered " + item)

func questions() -> void:
	if failed: return
	var answered: Dictionary = {}
	for _attempt: int in range(60):
		await resolve_bag()
		if not view.session.state.dialogue_open or view.session.state.is_stuck(): break
		view.dialogue_overlay.refresh()
		var active: String = view.dialogue_overlay.active_dialogue_name()
		var index := -1
		for candidate: int in range(view.dialogue_overlay.choice_buttons().size()):
			if not answered.has(active + ":" + str(candidate)):
				index = candidate
				break
		if index < 0:
			if not view.session.state.current_dialogue_secondary.is_empty():
				if view.presentation_edition == "modern":
					var back: Button = view.dialogue_overlay.find_child("BackToMainQuestions",true,false) as Button
					require(back != null and back.visible and not back.disabled, "Visible way back from " + active)
					if back != null: back.pressed.emit()
				else:
					# Original renders both windows. Pick the next visible main question.
					var primary: String = view.session.state.current_dialogue_primary
					var next: Button
					for candidate: int in range(8):
						var button: Button = view.dialogue_overlay.find_child("Original_%s_Question%d" % [primary,candidate+1],true,false) as Button
						if button != null and not button.disabled and not answered.has(primary+":"+str(candidate)):
							next = button
							answered[primary+":"+str(candidate)] = true
							break
					if next == null: break
					next.pressed.emit()
				await drain()
				continue
			break
		answered[active + ":" + str(index)] = true
		var button: Button = view.dialogue_overlay.choice_buttons()[index]
		require(button.is_visible_in_tree() and not button.disabled, "Visible original question " + active + ":" + str(index))
		button.pressed.emit()
		await drain()
		mark("question " + active + ":" + str(index))

func goodbye() -> void:
	if failed or not view.session.state.dialogue_open: return
	var result: Dictionary = view.dialogue_overlay.close_conversation()
	require(bool(result.get("ok",false)), "Conversation can close")
	await drain()

func resolve_bag() -> void:
	if failed or not view.session.state.is_stuck(): return
	var location: String = view.current_location_id()
	if location == "cafed" and view.session.state.part == 2 and view.session.state.has_event("close_db12_cloths") and view.session.state.has_event("close_db11_photos"):
		return # This is the original flower/scissors obstruction, solved later.
	var solution: Array = bag_solutions[route_story].get(location, [])
	if route_story == 2 and location == "cloths" and view.session.state.part == 2: solution = ["JulBag21",14]
	require(not solution.is_empty(), "Known original bag puzzle at " + location)
	if solution.is_empty(): return
	await offer(str(solution[0]), int(solution[1]))
	require(not view.session.state.is_stuck(), "Original personal item resolves " + location)

func talk(channel: int, close_after: bool = true) -> void:
	await click(channel)
	await questions()
	await collect()
	if close_after: await goodbye()

func drain() -> void:
	if failed: return
	for _attempt: int in range(180):
		await get_tree().process_frame
		view.effect_host.stop_all(true)
		if int(view.get("_zoom_effect_id")) > 0: view.call("_close_zoom")
		if int(view.get("_ending_effect_id")) > 0:
			# Software rendering needs room for loading/rendering the
			# complete finale; audio pitch still tops out at 4x during acceleration.
			var ending_timeout_ms: int = 120000 if OS.has_feature("android") or OS.has_feature("web") else 30000
			var deadline: int = Time.get_ticks_msec() + ending_timeout_ms
			while view.ending_sequence.is_playing() and Time.get_ticks_msec() < deadline:
				await get_tree().process_frame
			require(view.ending_sequence.mode == "future", "Complete original ending reaches its future gallery")
			break
		if int(view.get("_active_activity_effect_id")) > 0:
			var movie: String = str(view.minigame_view.host.presenter_model().get("activity", ""))
			if movie == "lab":
				for piece: Dictionary in [{"type":"red","target":"left"},{"type":"blue","target":"right"},{"type":"blue","target":"right"}]:
					view.minigame_view.host.interact("add",piece)
				view.minigame_view.host.interact("submit")
			elif movie == "photo":
				view.minigame_view.host.interact("select_tool","pencilblack")
				view.minigame_view.host.interact("apply_paper")
				view.minigame_view.host.interact("apply_paper")
			elif movie == "watch":
				view.minigame_view.host.interact("take_watch")
				view.minigame_view.host.interact("give_dorothy")
			else: require(false, "Unexpected activity " + movie)
		if not view.session.vm.is_waiting(): break
		for effect: Dictionary in view.session.pending_effects():
			if effect.get("kind") == "panel_blink_requested":
				await get_tree().create_timer(0.75).timeout
				break
	view.presenter.refresh_from_session()
	view.call("_refresh_all")
	await get_tree().process_frame
	require(not view.session.vm.is_waiting() or view.ending_sequence.mode == "future", "Presentation resumes: " + view.current_location_id())

func mark(action: String) -> void:
	trace.append({"action":action,"location":view.current_location_id(),"story":view.session.state.story,"part":view.session.state.part,"primary":view.session.state.current_dialogue_primary,"secondary":view.session.state.current_dialogue_secondary})
	print("ROUTE: ",JSON.stringify(trace.back()))

func require(ok: bool, message: String) -> void:
	if ok or failed: return
	failed = true
	push_error(message)
	print("ROUTE FAILURE STATE: ", JSON.stringify(view.session.state.snapshot()))
	get_tree().quit(1)

func name_of(value: Variant) -> String:
	return ValueParser.legacy_name(value)

func finish() -> void:
	view.effect_host.stop_all(false)
	if OS.has_feature("web"):
		view.reparent(get_tree().root)
		view.name = "QACompletedAdventure"
		return
	view.queue_free()
	await get_tree().process_frame

func capture_checkpoint(label: String) -> void:
	if capture_dir.is_empty() or failed or DisplayServer.get_name() == "headless":
		return
	var key: String = "%s-part%d" % [label, view.session.state.part]
	if _captured_locations.has(key):
		return
	_captured_locations[key] = true
	DirAccess.make_dir_recursive_absolute(capture_dir)
	await get_tree().process_frame
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var filename: String = "%02d-%s.png" % [captures.size() + 1, key]
	var result: Error = get_tree().root.get_texture().get_image().save_png(capture_dir.path_join(filename))
	require(result == OK, "Device checkpoint renders and saves: " + key)
	captures.append(filename)
