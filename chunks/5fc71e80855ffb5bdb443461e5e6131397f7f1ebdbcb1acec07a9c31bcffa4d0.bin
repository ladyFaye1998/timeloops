ìõ¦6â«×¿û4Ÿr øë¿Ìw¸Ï‘`¿Õ—ÁSé0þ´”ÇBÁ[È‡oÃœEË‹šÿ—ïÕMÎ^ÆÂn{I­Øâò
Ñÿ%)an–i¼cúÖ¯␀P÷m1
¤sò‹£x¸.øÒº£å`þpw¿ž/7éWDzþã{kñ[šÈóGIü␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
uniform sampler2D underpaint:source_color,filter_linear_mipmap;
uniform vec2 clip_points[48];
uniform int clip_count=0;
uniform float torso_turn=0.;
void fragment(){
 vec2 p=UV/TEXTURE_PIXEL_SIZE;
 float upper=1.-smoothstep(330.,710.,p.y);
 float side=1.-smoothstep(960.,1110.,p.x);
 float head=1.-smoothstep(330.,370.,p.y);
 p.x-=torso_turn*upper*mix(side,1.,head);
 vec2 sample_uv=p*TEXTURE_PIXEL_SIZE;
 float d=100000.;bool inside=false;
 for(int i=0;i<48;i++){
  if(i>=clip_count)break;int j=i+1;if(j>=clip_count)j=0;
  vec2 a=clip_points[i];vec2 b=clip_points[j];vec2 v=b-a;
  float t=clamp(dot(p-a,v)/max(dot(v,v),.00001),0.,1.);d=min(d,length(p-(a+t*v)));
  if((a.y>p.y)!=(b.y>p.y)&&p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)inside=!inside;
 }
 float width=max(length(dFdx(p)),length(dFdy(p)))*.8;
 float mask=smoothstep(-width,width,inside?d:-d);
 COLOR=mix(texture(TEXTURE,sample_uv),texture(underpaint,sample_uv),mask);
}
