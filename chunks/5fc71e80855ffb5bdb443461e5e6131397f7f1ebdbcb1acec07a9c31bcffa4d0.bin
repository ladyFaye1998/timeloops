          "source": "Google Translate TTS (gTTS)",
          "sha256": "6906cbbed8f957b245153a260cb0e9955bd2e9e1a86d5b80f81f4c6004480bce",
          "text": "Hat hier jemand ein Kleid gestohlen?",
          "source_text": "Did somebody steal a dress from here?",
