uniform float amount : hint_range(0.0, 1.0) = 0.0;
void fragment() {
	vec4 original = texture(TEXTURE, UV);
	vec3 sepia = vec3(dot(original.rgb, vec3(0.393, 0.769, 0.189)),
		dot(original.rgb, vec3(0.349, 0.686, 0.168)),
		dot(original.rgb, vec3(0.272, 0.534, 0.131)));
	COLOR = vec4(mix(original.rgb, clamp(sepia, 0.0, 1.0), amount), original.a);
}
