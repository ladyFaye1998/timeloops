Ì¼GÄÝEµ?¬ù†/}¦®/~ Ã9‰ûY?	ZuÂ_UÛ	L^ãÎ{¹ø»>¶ãÍ·ä÷ºé8¬§q”½<€Ïo*ê¼Øüo¿MŸf0™ygö}é&ñæÔEŽY¿¾ÙÙ!–_ü:”«ë F›*7;[äø°½Ö-œþ“`H[ËŠåƒh{ëxKaï(ùVý‚yƒžÁÎÐ¡N#8l@÷ÓÝ·Uv¹b‘uçÚÎµ44ÚDý#N¾=æb˜öëiOÚvk~¦«ý•ïlÉ!—þ­cƒ}ø§ùV{^âáù©Áùãï²ç¹ºÿ,|'ûˆôm0…6¾_’ëq
^=8ãuGþ¿|Æ2Úœèim˜ÁÛjü¶€å’5UGaâátœ¸ô\ßÑ¥·^K/ÿÏÝòŸû;LŒA¹’ÅïsE0éu¸+‘æéè-oKw¯úùò—ŒoË/u¬#º×1Ÿˆ^␀}-öp°êâoÐdL;féal3`Ý*÷`à×‹Gø°äñáyM¢®}ÀæYèÝzð8©[á1"N»Ñ’Ã‚ŸgÚH´´ø6¼ˆÛ/˜½?‘{¹<¼Þ+9ªïb‡B½$½ú²`4Ú ÊeP~÷-óû¤“kdõJ;˜ïÞ_?þœ3w¾»/ŒxJsY‘»1O_Š¿ÃØÕ0·Þ­ylð×ììÏJÎÜð‡ÅçæÎ_Ñ‡Eº6C®wž!-\¹ ¶bØ:»r1BüZÄ¸ö3ã5œ
êŸycUpr=ó␀␀␀␀␀␀␀␀␀class_name JuliaModernDialogueOverlay
extends JuliaLegacyDialogueOverlay

## Modern typesetting of the original questions. Indices and commands remain
## owned by the recovered session, including question removal and accusation.
const QUESTION_PATH := "res://data/dialogue_questions.he.json"
const DIALOGUE_INK := Color("432c20")
const DIALOGUE_PAPER := Color("ffedc5")
const DIALOGUE_EDGE := Color("a75a32")
const DIALOGUE_ACCENT := Color("28695d")
const FlowerStamp = preload("res://src/ui/retro_flower_stamp.gd")
const WebLayout = preload("res://src/ui/web_layout.gd")
const NativeTouchScroll = preload("res://src/ui/native_touch_scroll.gd")
var _questions: Dictionary = {}
var _choice_scroll: ScrollContainer
var _back_button: Button
var _options_button: MenuButton
var _parity_signature: String = ""
var _compact_actions: GridContainer
var _web_compact_mode: int = -1
var _portrait_scene_offset: float = 0.0
const QUESTION_SOUND_OPTION: int = 1

func _ready() -> void:
	var document: Variant = JSON.parse_string(FileAccess.get_file_as_string(QUESTION_PATH))
	if typeof(document) == TYPE_DICTIONARY:
		_questions = document.get("sheets", {})
	super._ready()

func _set_open(value: bool) -> void:
	super._set_open(value)
	# The conversation occupies only its choice band. A full-window PASS
	# control still captures GUI picking before sibling world hotspots, so it
	# would prevent gifts being offered while the original story is stuck.
	# The band and its buttons retain their own STOP filters.
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func _build_interface() -> void:
	super._build_interface()
	_band_hit_area.name = "ModernDialogueChoices"
	_content.add_theme_constant_override("separation", 10)
	_content.remove_child(_choice_stack)
	_choice_scroll = ScrollContainer.new()
	_choice_scroll.name = "DialogueChoiceScroll"
	_choice_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_choice_scroll.follow_focus = true
	_choice_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_choice_scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_content.add_child(_choice_scroll)
	NativeTouchScroll.attach(_choice_scroll)
	_choice_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_choice_stack.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	_choice_stack.add_theme_constant_override("separation", 10)
	_choice_scroll.add_child(_choice_stack)
	for action: Button in [_accuse_button, _close_button]:
		action.custom_minimum_size = Vector2(148, 44)
		action.add_theme_font_size_override("font_size", 18)
		action.add_theme_font_override("font", JuliaThemeFactory.display_font())
		_style_readable_button(action, true)
	_back_button = _make_icon_action("")
	_back_button.name = "BackToMainQuestions"
	_back_button.custom_minimum_size = Vector2(148, 44)
	_back_button.add_theme_font_size_override("font_size", 18)
	_back_button.add_theme_font_override("font", JuliaThemeFactory.display_font())
	_style_readable_button(_back_button, true)
	_back_button.pressed.connect(return_to_main_questions)
	_action_row.add_child(_back_button)
	_action_row.move_child(_back_button, 0)
	_back_button.hide()
	_options_button = MenuButton.new()
	_options_button.name = "ConversationOptions"
	_options_button.custom_minimum_size = Vector2(100, 44)
	_options_button.add_theme_font_size_override("font_size", 18)
	_style_readable_button(_options_button, true)
	_options_button.add_theme_color_override("font_hover_pressed_color", DIALOGUE_INK)
	_options_button.get_popup().add_theme_font_size_override("font_size", 20)
	_options_button.get_popup().add_theme_color_override("font_color", DIALOGUE_INK)
	_options_button.get_popup().add_theme_color_override("font_hover_color", DIALOGUE_INK)
	_options_button.get_popup().add_theme_color_override("font_separator_color", DIALOGUE_ACCENT)
	_options_button.get_popup().add_theme_color_override("font_disabled_color", Color(DIALOGUE_INK, 0.45))
	_options_button.get_popup().add_theme_stylebox_override("panel", _paper_choice_style(DIALOGUE_PAPER, DIALOGUE_EDGE, 1, true))
	_options_button.get_popup().add_theme_stylebox_override("hover", _paper_choice_style(Color("ffdc8b"), DIALOGUE_ACCENT, 1, true))
	_options_button.get_popup().id_pressed.connect(_on_option_selected)
	_action_row.add_child(_options_button)
	_action_row.move_child(_options_button, 1)
	_compact_actions = GridContainer.new()
	_compact_actions.name = "CompactConversationActions"
	_compact_actions.columns = 2
	_compact_actions.add_theme_constant_override("h_separation", 8)
	_compact_actions.add_theme_constant_override("v_separation", 8)
	_content.add_child(_compact_actions)
	_content.move_child(_compact_actions, 0)
	_compact_actions.hide()
	_choice_stack.minimum_size_changed.connect(_layout_lower_third)

func refresh() -> void:
	if session != null:
		var signature: String = JSON.stringify({
			"sound": session.state.dialogue_sound_enabled,
			"more": session.state.dialogue_more,
			"done": session.state.has_event("IncrDone"),
		})
		if signature != _parity_signature:
			_parity_signature = signature
			_last_signature = ""
	super.refresh()
	if not visible and is_instance_valid(_options_button):
		_options_button.get_popup().hide()

func _render_dialogue(definition: Dictionary) -> void:
	super._render_dialogue(definition)
	var asset_name: String = str(definition.get("question_asset", "")).to_lower()
	var questions: Array = _questions.get(asset_name, [])
	if questions.size() != _choice_buttons.size():
		push_error("Original question transcription does not match commands: " + asset_name)
		return
	_keyed_choice_textures.clear()
	for index: int in range(_choice_buttons.size()):
		var button: Button = _choice_buttons[index]
		button.icon = null
		button.text = str(questions[index])
		button.tooltip_text = button.text
	_accuse_button.text = ("×‘×™×˜×•×œ ×”×¦×’×ª ×¨××™×”" if _is_hebrew() else "Cancel evidence") if session.state.incrimination_active else ("×”×¦×’×ª ×¨××™×”" if _is_hebrew() else "Show evidence")
	_accuse_button.tooltip_text = _accuse_button.text
	_close_button.text = "×¡×™×•× ×”×©×™×—×”" if _is_hebrew() else "End conversation"
	_back_button.text = "×—×–×¨×” ×œ×©××œ×•×ª" if _is_hebrew() else "Main questions"
	_back_button.tooltip_text = _back_button.text
	_back_button.visible = not session.state.current_dialogue_secondary.is_empty() and not session.state.incrimination_active and not session.state.is_stuck()
	_apply_action_direction(_back_button)
	var primary: Dictionary = _find_dialogue(session.state.current_dialogue_primary)
	_accuse_button.visible = session.state.incrimination_allowed and not session.state.is_stuck() and bool(primary.get("properties", {}).get("incrbtn", true))
	for button: Button in _choice_buttons:
		button.disabled = session.state.is_stuck() or (session.state.incrimination_active and not session.state.has_event("IncrDone"))
	_rebuild_options(primary)
	_update_focus_navigation()
	_choice_scroll.scroll_vertical = 0
	_layout_lower_third()
	call_deferred("_layout_lower_third")

func _rebuild_options(primary: Dictionary) -> void:
	_options_button.text = "××¤×©×¨×•×™×•×ª" if _is_hebrew() else "Options"
	_options_button.tooltip_text = "××¤×©×¨×•×™×•×ª ×©×™×—×”" if _is_hebrew() else "Conversation options"
	_apply_action_direction(_options_button)
	var popup: PopupMenu = _options_button.get_popup()
	popup.clear()
	popup.add_check_item("×§×¨×™××ª ×”×©××œ×•×ª ×‘×§×•×œ" if _is_hebrew() else "Read questions aloud", QUESTION_SOUND_OPTION)
	popup.set_item_checked(0, session.state.dialogue_sound_enabled)
	var questions: Array = _questions.get(str(primary.get("question_asset", "")).to_lower(), [])
	var channels: Array = session.state.dialogue_more.keys()
	channels.sort_custom(func(left: Variant, right: Variant) -> bool: return int(left) < int(right))
	var added_separator: bool = false
	for channel_key: Variant in channels:
		var channel: int = int(channel_key)
		var record: Dictionary = session.state.dialogue_more[channel_key]
		if channel not in [86, 87, 88, 89] or str(record.get("primary_dialogue", "")).to_lower() != session.state.current_dialogue_primary.to_lower():
			continue
		if not added_separator:
			popup.add_separator("×©××œ×•×ª ×”×ž×©×š" if _is_hebrew() else "Revisit follow-up questions")
			added_separator = true
		var question: int = int(ValueParser.legacy_name(record.get("question", "0"))) - 1
		var label: String = str(questions[question]) if question >= 0 and question < questions.size() else ("×©××œ×•×ª ×”×ž×©×š" if _is_hebrew() else "Follow-up questions")
		var label_limit: int = maxi(18, int((size.x - 100) / 10)) if WebLayout.enabled() else 48
		popup.add_item(label if label.length() <= label_limit else label.left(label_limit) + "â€¦", channel)
		var index: int = popup.get_item_count() - 1
		popup.set_item_tooltip(index, label)
		popup.set_item_disabled(index, session.state.incrimination_active or session.state.is_stuck())

func _on_option_selected(option: int) -> void:
	if option == QUESTION_SOUND_OPTION:
		toggle_question_sound()
	else:
		open_more(option)

func toggle_question_sound() -> Dictionary:
	if session == null or _waiting:
		return {"ok": false, "reason": "conversation is playing"}
	var result: Dictionary = session.set_dialogue_sound_enabled(not session.state.dialogue_sound_enabled)
	conversation_action.emit(result.duplicate(true))
	refresh()
	return result

func open_more(channel: int) -> Dictionary:
	if session == null or _waiting:
		return {"ok": false, "reason": "conversation is playing"}
	var result: Dictionary = session.open_more_dialogue(channel)
	conversation_action.emit(result.duplicate(true))
	refresh()
	return result

func begin_incrimination() -> Dictionary:
	if session == null or _waiting:
		return {"ok": false, "reason": "conversation is playing"}
	if not session.state.incrimination_active:
		return super.begin_incrimination()
	var result: Dictionary = session.cancel_incrimination()
	conversation_action.emit(result.duplicate(true))
	refresh()
	return result

func return_to_main_questions() -> Dictionary:
	if session == null or _waiting:
		return {"ok": false, "reason": "conversation is playing"}
	var result: Dictionary = session.return_to_primary_dialogue()
	conversation_action.emit(result.duplicate(true))
	refresh()
	return result

func close_conversation() -> Dictionary:
	if presenter == null or session == null or _waiting or session.state.current_dialogue_primary.is_empty():
		return {"ok": false, "reason": "no closable conversation"}
	# Follow-up sheets have no goodbye command; goodbye belongs to DB1.
	var result: Dictionary = presenter.close_dialogue(session.state.current_dialogue_primary)
	conversation_action.emit(result.duplicate(true))
	refresh()
	return result

func choose(index: int) -> Dictionary:
	if session != null and session.state.incrimination_active and not session.state.has_event("IncrDone"):
		return {"ok": false, "reason": "present evidence or end the conversation"}
	return super.choose(index)

func _update_focus_navigation() -> void:
	var focusables: Array[Button] = []
	if is_instance_valid(_back_button) and _back_button.visible: focusables.append(_back_button)
	if is_instance_valid(_options_button) and _options_button.visible: focusables.append(_options_button)
	if _accuse_button.visible: focusables.append(_accuse_button)
	focusables.append(_close_button)
	for button: Button in _choice_buttons:
		if not button.disabled: focusables.append(button)
	for index: int in range(focusables.size()):
		var previous: Button = focusables[wrapi(index - 1, 0, focusables.size())]
		var next: Button = focusables[wrapi(index + 1, 0, focusables.size())]
		focusables[index].focus_neighbor_top = focusables[index].get_path_to(previous)
		focusables[index].focus_neighbor_bottom = focusables[index].get_path_to(next)
		focusables[index].focus_previous = focusables[index].get_path_to(previous)
		focusables[index].focus_next = focusables[index].get_path_to(next)

func _make_choice_button(index: int) -> Button:
	var result: Button = super._make_choice_button(index)
	result.custom_minimum_size.y = 58.0
	result.add_theme_font_size_override("font_size", 26)
	result.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	# Story text remains the original Hebrew even when interface menus use English.
	result.language = "he"
	result.text_direction = Control.TEXT_DIRECTION_RTL
	result.layout_direction = Control.LAYOUT_DIRECTION_RTL
	_style_readable_button(result)
	var flower := FlowerStamp.new()
	flower.petal_color = [Color("e78e32"),Color("ba4370"),Color("609159")][index % 3]
	result.add_child(flower)
	flower.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	return result

func _style_readable_button(button: Button, compact: bool = false) -> void:
	button.flat = false
	for color_name: String in ["font_color", "font_hover_color", "font_focus_color", "font_pressed_color"]:
		button.add_theme_color_override(color_name, DIALOGUE_INK)
	button.add_theme_color_override("font_disabled_color", Color(DIALOGUE_INK, 0.5))
	button.add_theme_constant_override("outline_size", 0)
	button.add_theme_constant_override("shadow_offset_x", 0)
	button.add_theme_constant_override("shadow_offset_y", 0)
	button.add_theme_stylebox_override("normal", _paper_choice_style(DIALOGUE_PAPER, DIALOGUE_EDGE, 1, compact))
	button.add_theme_stylebox_override("hover", _paper_choice_style(Color("ffdc8b"), DIALOGUE_ACCENT, 2, compact))
	button.add_theme_stylebox_override("pressed", _paper_choice_style(Color("f2bf68"), DIALOGUE_ACCENT, 2, compact))
	button.add_theme_stylebox_override("disabled", _paper_choice_style(DIALOGUE_PAPER, DIALOGUE_EDGE, 1, compact))
	var focus := _paper_choice_style(Color.TRANSPARENT, DIALOGUE_ACCENT, 2, compact)
	focus.shadow_size = 0
	button.add_theme_stylebox_override("focus", focus)

func _paper_choice_style(fill: Color, edge: Color, border: int, compact: bool) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = fill
	style.border_color = edge
	style.set_border_width_all(border)
	style.set_corner_radius_all(20 if compact else 24)
	style.content_margin_left = 20.0 if compact else 24.0
	style.content_margin_right = 20.0 if compact else 50.0
	style.content_margin_top = 7.0 if compact else 11.0
	style.content_margin_bottom = 7.0 if compact else 11.0
	style.shadow_color = Color(0.24, 0.10, 0.04, 0.5)
	style.shadow_size = 3
	style.shadow_offset = Vector2(0, 3)
	return style

func _draw() -> void:
	# Individual paper choices provide contrast; keep the scene visible between
	# them instead of tinting the entire bottom of the screen.
	pass

func _focus_initial_choice() -> void:
	if not OS.has_feature("android"):
		for button: Button in _choice_buttons:
			if visible and not button.disabled:
				button.grab_focus()
				return
		if visible: _close_button.grab_focus()

func set_portrait_scene_offset(value: float) -> void:
	if is_equal_approx(_portrait_scene_offset, value): return
	_portrait_scene_offset = value
	# Follow the actual moving scene edge, so choices never cover it during
	# the short exploration/conversation transition.
	_layout_lower_third()


func _layout_lower_third() -> void:
	if not is_instance_valid(_band_hit_area):
		return
	if WebLayout.enabled() and is_instance_valid(_compact_actions):
		_layout_web_dialogue()
		return
	var choice_height: float = maxf(_choice_stack.get_combined_minimum_size().y, maxi(choice_count(), 1) * 58.0)
	var desired: float = minf(54.0 + choice_height, size.y * 0.48)
	var width: float = minf(820.0, maxf(1.0, size.x - 48.0))
	_band_rect = Rect2((size.x - width) * 0.5, maxf(size.y - desired - 22.0, 0.0), width, desired)
	_band_hit_area.position = _band_rect.position
	_band_hit_area.size = _band_rect.size
	_content_margin.position = Vector2.ZERO
	_content_margin.size = _band_rect.size
	for edge: String in ["left", "right", "top", "bottom"]:
		_content_margin.add_theme_constant_override("margin_" + edge, 0)
	queue_redraw()

func _layout_web_dialogue() -> void:
	var narrow := size.x < 700.0
	var short_portrait: bool = WebLayout.is_portrait(size) and size.y < 620.0
	# Keep a complete multiline question readable on short phones. These are
	# the same actions and callbacks, with concise labels and full tooltips.
	_back_button.text = ("×—×–×¨×”" if _is_hebrew() else "Back") if short_portrait else ("×—×–×¨×” ×œ×©××œ×•×ª" if _is_hebrew() else "Main questions")
	_back_button.tooltip_text = "×—×–×¨×” ×œ×©××œ×•×ª" if _is_hebrew() else "Main questions"
	_options_button.text = "â‹¯" if short_portrait else ("××¤×©×¨×•×™×•×ª" if _is_hebrew() else "Options")
	var cancelling: bool = session != null and session.state.incrimination_active
	_accuse_button.tooltip_text = ("×‘×™×˜×•×œ ×”×¦×’×ª ×¨××™×”" if _is_hebrew() else "Cancel evidence") if cancelling else ("×”×¦×’×ª ×¨××™×”" if _is_hebrew() else "Show evidence")
	_accuse_button.text = (("×‘×™×˜×•×œ" if _is_hebrew() else "Cancel") if cancelling else ("×¨××™×”" if _is_hebrew() else "Clue")) if short_portrait else _accuse_button.tooltip_text
	_close_button.tooltip_text = "×¡×™×•× ×”×©×™×—×”" if _is_hebrew() else "End conversation"
	_close_button.text = ("×¡×™×•×" if _is_hebrew() else "End") if short_portrait else _close_button.tooltip_text
	var changed := _web_compact_mode != int(narrow)
	_web_compact_mode = int(narrow)
	var destination: Container = _compact_actions if narrow else _action_row
	for action: Button in [_back_button, _options_button, _accuse_button, _close_button]:
		if action.get_parent() != destination:
			action.reparent(destination)
		action.custom_minimum_size = Vector2(0 if narrow else 148, 48)
		action.size_flags_horizontal = Control.SIZE_EXPAND_FILL if narrow else Control.SIZE_SHRINK_END
		action.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		if changed: action.add_theme_font_size_override("font_size", 16 if narrow else 18)
		for state: String in ["normal", "hover", "pressed", "disabled", "focus"]:
			var style := action.get_theme_stylebox(state) as StyleBoxFlat
			style.content_margin_left = 10 if narrow else 20
			style.content_margin_right = 10 if narrow else 20
	_compact_actions.visible = narrow
	_action_row.visible = not narrow
	if changed: _update_focus_navigation()
	for choice: Button in _choice_buttons:
		if choice.get_theme_font_size("font_size") != 20: choice.add_theme_font_size_override("font_size", 20)
		choice.custom_minimum_size.y = 52
	var width := minf(820, size.x - 24)
	var actions_visible := 0
	for action: Button in [_back_button, _options_button, _accuse_button, _close_button]:
		if action.visible: actions_visible += 1
	var rows := ceili(actions_visible / 2.0) if narrow else 1
	_compact_actions.columns = maxi(1, actions_visible) if short_portrait else 2
	if short_portrait: rows = 1
	var action_height := rows * 48.0 + maxi(0, rows - 1) * 8.0
	action_height = maxf(action_height, destination.get_combined_minimum_size().y)
	var choice_height := maxf(_choice_stack.get_combined_minimum_size().y, maxi(1, choice_count()) * 62.0)
	# Tools stays available for gift puzzles. If the choice band reaches its
	# 80px-wide button at the 14px right inset, reserve the 52px button row,
	# 14px bottom inset and a 12px gap. Wide desktops keep their usual band.
	var band_right := (size.x + width) * 0.5
	var tools_left := size.x - 94.0
	var bottom_clearance := 78.0 if band_right > tools_left else 12.0
	var height := minf(size.y - bottom_clearance - 12.0, minf(action_height + 10.0 + choice_height, size.y * (0.68 if narrow else 0.74)))
	var top: float = size.y - height - bottom_clearance
	if WebLayout.is_portrait(size):
		# Anchor below the rendered picture, not its letterboxed allocation or
		# the bottom of the window. Short conversations should not create a
		# large empty gap; long lists use the space above the compact case.
		var scene_rect: Rect2 = WebLayout.portrait_scene_rect(size)
		top = scene_rect.end.y + _portrait_scene_offset + WebLayout.PORTRAIT_CONTENT_GAP
		var bottom: float = size.y - WebLayout.PORTRAIT_CASE_HEIGHT - WebLayout.PORTRAIT_CONTENT_GAP
		height = minf(action_height + 10.0 + choice_height, maxf(1.0, bottom - top))
	_band_rect = Rect2(Vector2((size.x - width) * 0.5, top), Vector2(width, height))
	_band_hit_area.position = _band_rect.position
	_band_hit_area.size = _band_rect.size
	# Container minimums can briefly exceed the available height while the
	# scene moves. Clip rendering AND pointer picking to the allocated band.
	_band_hit_area.clip_contents = WebLayout.is_portrait(size)
	_content_margin.position = Vector2.ZERO
	_content_margin.size = _band_rect.size
	for edge: String in ["left", "right", "top", "bottom"]:
		_content_margin.add_theme_constant_override("margin_" + edge, 0)
	# Popup follow-ups are the same source entries; touch rows remain usable.
	var popup := _options_button.get_popup()
	if changed:
		popup.add_theme_font_size_override("font_size", 17)
		popup.add_theme_constant_override("v_separation", 20)
	popup.max_size = Vector2i(maxi(1, int(size.x - 16)), maxi(1, int(size.y - 16)))
	queue_redraw()
