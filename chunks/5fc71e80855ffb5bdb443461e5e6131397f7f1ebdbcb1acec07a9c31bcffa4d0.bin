extends RefCounted

signal slot_saved(slot_id: String, summary: Dictionary)
signal slot_loaded(slot_id: String, summary: Dictionary)
signal slot_deleted(slot_id: String)

const LegacySession = preload("res://src/domain/legacy_session.gd")
const ClueJournal = preload("res://src/domain/clue_journal.gd")

const SCHEMA_NAME: String = "julia_flower_save"
const SCHEMA_VERSION: int = 1
const DEFAULT_SAVE_ROOT: String = "user://saves"
const MAX_SAVE_BYTES: int = 16 * 1024 * 1024
const MANUAL_SLOT_IDS: Array[String] = [
	"manual_1",
	"manual_2",
	"manual_3",
	"manual_4", "manual_5", "manual_6", "manual_7", "manual_8",
	"manual_9", "manual_10", "manual_11", "manual_12",
]
const AUTOSAVE_SLOT_ID: String = "autosave"
const ALL_SLOT_IDS: Array[String] = [
	"manual_1",
	"manual_2",
	"manual_3",
	"manual_4", "manual_5", "manual_6", "manual_7", "manual_8",
	"manual_9", "manual_10", "manual_11", "manual_12",
	"autosave",
]

var _save_root: String
var _now_provider: Callable
static var _last_system_save_msec: int = 0


func _init(
	save_root: String = DEFAULT_SAVE_ROOT,
	now_provider: Callable = Callable()
) -> void:
	_save_root = save_root.trim_suffix("/")
	_now_provider = now_provider


func save(
	slot_id: String,
	session: LegacySession,
	journal: ClueJournal,
	metadata: Dictionary = {}
) -> Dictionary:
	var slot_error: Dictionary = _validate_slot_request(slot_id)
	if not slot_error.is_empty():
		return slot_error
	if session == null or journal == null:
		return _failure(
			"invalid_argument",
			"A live session and clue journal are required.",
			slot_id
		)
	var metadata_error: String = _validate_metadata(metadata)
	if not metadata_error.is_empty():
		return _failure(
			"invalid_metadata",
			metadata_error,
			slot_id
		)
	var raw_session: Dictionary = session.save_payload()
	var raw_runtime: Dictionary = _capture_vm_runtime(session)
	if (
		not _is_encodable_value(raw_session)
		or not _is_encodable_value(raw_runtime)
	):
		return _failure(
			"unsupported_state",
			"The live game contains state this save version cannot encode.",
			slot_id
		)

	var timestamp_msec: int = _now_unix_msec()
	var timestamp: int = int(timestamp_msec / 1000)
	var payload: Dictionary = _build_payload(
		session,
		journal,
		metadata,
		timestamp,
		raw_session,
		raw_runtime
	)
	var payload_error: Dictionary = _validate_payload(payload)
	if not payload_error.is_empty():
		return _failure(
			"invalid_payload",
			str(payload_error.get("message", "Save payload is invalid.")),
			slot_id
		)

	var core: Dictionary = {
		"schema": SCHEMA_NAME,
		"schema_version": SCHEMA_VERSION,
		"slot_id": slot_id,
		"slot_kind": _slot_kind(slot_id),
		"saved_at_unix": timestamp,
		"saved_at_unix_msec": timestamp_msec,
		"saved_at_utc": Time.get_datetime_string_from_unix_time(
			timestamp, true
		),
		"summary": _build_summary(slot_id, payload, timestamp),
		"payload": payload,
	}
	core["summary"]["saved_at_unix_msec"] = timestamp_msec
	# Normalize through the same JSON decoder used on read. This removes
	# representation differences such as -0.0 versus 0.0 before hashing.
	var normalized_core_value: Variant = JSON.parse_string(
		_canonical_json(core)
	)
	if typeof(normalized_core_value) != TYPE_DICTIONARY:
		return _failure(
			"serialization_failed",
			"The save document could not be normalized.",
			slot_id
		)
	var normalized_core: Dictionary = normalized_core_value
	var document: Dictionary = normalized_core.duplicate(true)
	document["checksum_sha256"] = _checksum(normalized_core)

	var directory_error: Error = _ensure_save_directory()
	if directory_error != OK:
		return _failure(
			"directory_error",
			"Could not create the save directory.",
			slot_id,
			directory_error
		)
	var write_result: Dictionary = _write_atomically(slot_id, document)
	if not bool(write_result.get("ok", false)):
		return write_result

	var summary: Dictionary = core["summary"].duplicate(true)
	summary["state"] = "ready"
	summary["recovered_from_backup"] = false
	slot_saved.emit(slot_id, summary.duplicate(true))
	return {
		"ok": true,
		"code": "saved",
		"slot_id": slot_id,
		"summary": summary,
	}


func load(
	slot_id: String,
	session: LegacySession,
	journal: ClueJournal
) -> Dictionary:
	var slot_error: Dictionary = _validate_slot_request(slot_id)
	if not slot_error.is_empty():
		return slot_error
	if session == null or journal == null:
		return _failure(
			"invalid_argument",
			"A live session and clue journal are required.",
			slot_id
		)

	var selected: Dictionary = _read_best_document(slot_id)
	if not bool(selected.get("ok", false)):
		return selected
	var document: Dictionary = selected["document"]
	var payload: Dictionary = document["payload"]

	# Preflight on isolated objects so a structurally valid but semantically
	# unusable save cannot partially replace the running game.
	var probe_session := LegacySession.new(session.catalog)
	var probe_journal := ClueJournal.new()
	var probe_result: Dictionary = _restore_payload(
		payload, probe_session, probe_journal
	)
	if not bool(probe_result.get("ok", false)):
		return _failure(
			"restore_rejected",
			str(
				probe_result.get(
					"message",
					"The save references content this build cannot restore."
				)
			),
			slot_id
		)

	var rollback_session: Dictionary = _capture_session_bundle(session)
	var rollback_journal: Dictionary = journal.snapshot()
	var restore_result: Dictionary = _restore_payload(
		payload, session, journal
	)
	if not bool(restore_result.get("ok", false)):
		_restore_session_bundle(rollback_session, session)
		journal.restore(rollback_journal)
		return _failure(
			"restore_failed",
			str(
				restore_result.get(
					"message",
					"The running game could not accept the save."
				)
			),
			slot_id
		)

	var summary: Dictionary = document["summary"].duplicate(true)
	summary["state"] = (
		"recoverable"
		if bool(selected.get("recovered_from_backup", false))
		else "ready"
	)
	summary["recovered_from_backup"] = bool(
		selected.get("recovered_from_backup", false)
	)
	slot_loaded.emit(slot_id, summary.duplicate(true))
	return {
		"ok": true,
		"code": (
			"loaded_backup"
			if summary["recovered_from_backup"]
			else "loaded"
		),
		"slot_id": slot_id,
		"summary": summary,
		"recovered_from_backup": summary["recovered_from_backup"],
		"profile": payload.get("profile", {}).duplicate(true),
		"locale": str(payload.get("locale", session.locale)),
		"playtime_seconds": float(
			payload.get("playtime_seconds", 0.0)
		),
	}


func read_slot_summary(slot_id: String) -> Dictionary:
	var slot_error: Dictionary = _validate_slot_request(slot_id)
	if not slot_error.is_empty():
		return slot_error
	var selected: Dictionary = _read_best_document(slot_id)
	if bool(selected.get("ok", false)):
		var summary: Dictionary = selected["document"]["summary"].duplicate(
			true
		)
		var recovered: bool = bool(
			selected.get("recovered_from_backup", false)
		)
		summary["state"] = "recoverable" if recovered else "ready"
		summary["recovered_from_backup"] = recovered
		return {
			"ok": true,
			"code": "summary",
			"slot_id": slot_id,
			"summary": summary,
		}
	if str(selected.get("code", "")) == "empty_slot":
		return {
			"ok": true,
			"code": "summary",
			"slot_id": slot_id,
			"summary": _empty_summary(slot_id),
		}
	return {
		"ok": true,
		"code": "summary",
		"slot_id": slot_id,
		"summary": _corrupt_summary(slot_id, selected),
	}


func list_slot_summaries() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for slot_id: String in ALL_SLOT_IDS:
		var read_result: Dictionary = read_slot_summary(slot_id)
		result.append(read_result.get("summary", _empty_summary(slot_id)))
	return result


static func latest_slot_id(summaries: Array[Dictionary]) -> String:
	var best_slot: String = ""
	var best_timestamp: int = -1
	for summary: Dictionary in summaries:
		if str(summary.get("state", "")) not in ["ready", "recoverable"]: continue
		# Old schema-one files have seconds only. New optional precision keeps a
		# later manual checkpoint ahead of an earlier same-second autosave.
		var timestamp: int = int(summary.get("saved_at_unix_msec", int(summary.get("saved_at_unix", 0)) * 1000))
		if timestamp < best_timestamp: continue
		best_timestamp = timestamp
		best_slot = str(summary.get("slot_id", ""))
	return best_slot


func delete_slot(slot_id: String) -> Dictionary:
	var slot_error: Dictionary = _validate_slot_request(slot_id)
	if not slot_error.is_empty():
		return slot_error
	var removed_any: bool = false
	for suffix: String in [".save", ".save.bak", ".save.tmp"]:
		var path: String = _save_root.path_join(slot_id + suffix)
		if not FileAccess.file_exists(path):
			continue
		var error: Error = DirAccess.remove_absolute(
			ProjectSettings.globalize_path(path)
		)
		if error != OK:
			return _failure(
				"delete_failed",
				"Could not remove every file belonging to the slot.",
				slot_id,
				error
			)
		removed_any = true
	if removed_any:
		slot_deleted.emit(slot_id)
	return {
		"ok": true,
		"code": "deleted" if removed_any else "already_empty",
		"slot_id": slot_id,
		"deleted": removed_any,
	}


func slot_path(slot_id: String) -> String:
	if not _is_valid_slot_id(slot_id):
		return ""
	return _save_root.path_join(slot_id + ".save")


func backup_path(slot_id: String) -> String:
	if not _is_valid_slot_id(slot_id):
		return ""
	return _save_root.path_join(slot_id + ".save.bak")


func _build_payload(
	session: LegacySession,
	journal: ClueJournal,
	metadata: Dictionary,
	timestamp: int,
	raw_session: Dictionary,
	raw_runtime: Dictionary
) -> Dictionary:
	var profile: Dictionary = metadata.get("profile", {}).duplicate(true)
	var requested_locale: String = str(
		metadata.get("locale", session.locale)
	).strip_edges()
	if requested_locale.is_empty():
		requested_locale = session.locale
	return {
		"payload_version": 1,
		"session": _to_json_value(raw_session),
		"session_runtime": _to_json_value(raw_runtime),
		"clue_journal": _to_json_value(journal.snapshot()),
		"locale": requested_locale,
		"profile": profile,
		"playtime_seconds": maxf(
			0.0, float(metadata.get("playtime_seconds", 0.0))
		),
		"game_version": str(metadata.get("game_version", "")),
		"chapter_label": str(metadata.get("chapter_label", "")),
		"created_by": str(
			metadata.get("created_by", "Julia Flower Girl Remastered")
		),
		"captured_at_unix": timestamp,
	}


func _capture_session_bundle(session: LegacySession) -> Dictionary:
	return {
		"session": _to_json_value(session.save_payload()),
		"runtime": _to_json_value(_capture_vm_runtime(session)),
	}


func _capture_vm_runtime(session: LegacySession) -> Dictionary:
	var maximum_effect_id: int = 0
	for effect: Dictionary in session.state.effect_log:
		maximum_effect_id = maxi(
			maximum_effect_id, int(effect.get("id", 0))
		)
	return {
		"runtime_version": 1,
		"defer_blocking_effects": session.vm.defer_blocking_effects,
		"waiting_effect_id": session.vm.waiting_effect_id,
		"queue": session.vm.queue.duplicate(true),
		"if_stack": session.vm._if_stack.duplicate(true),
		"effect_log": session.state.effect_log.duplicate(true),
		"next_effect_id": maxi(
			session.state._next_effect_id, maximum_effect_id + 1
		),
	}


func _restore_payload(
	payload: Dictionary,
	session: LegacySession,
	journal: ClueJournal
) -> Dictionary:
	var session_payload: Variant = _from_json_value(
		payload.get("session", {})
	)
	var runtime_payload: Variant = _from_json_value(
		payload.get("session_runtime", {})
	)
	var journal_payload: Variant = _from_json_value(
		payload.get("clue_journal", {})
	)
	if (
		typeof(session_payload) != TYPE_DICTIONARY
		or typeof(runtime_payload) != TYPE_DICTIONARY
		or typeof(journal_payload) != TYPE_DICTIONARY
	):
		return {
			"ok": false,
			"message": "The save contains malformed domain snapshots.",
		}

	var session_result: Dictionary = session.restore_payload(session_payload)
	if not bool(session_result.get("ok", false)):
		return {
			"ok": false,
			"message": str(
				session_result.get(
					"reason", "The saved location is unavailable."
				)
			),
		}
	_apply_vm_runtime(runtime_payload, session)
	if not journal.restore(journal_payload):
		return {
			"ok": false,
			"message": "The clue journal snapshot is invalid.",
		}
	return {"ok": true}


func _restore_session_bundle(
	bundle: Dictionary, session: LegacySession
) -> bool:
	var session_payload: Variant = _from_json_value(
		bundle.get("session", {})
	)
	var runtime_payload: Variant = _from_json_value(
		bundle.get("runtime", {})
	)
	if (
		typeof(session_payload) != TYPE_DICTIONARY
		or typeof(runtime_payload) != TYPE_DICTIONARY
	):
		return false
	var result: Dictionary = session.restore_payload(session_payload)
	if not bool(result.get("ok", false)):
		return false
	_apply_vm_runtime(runtime_payload, session)
	return true


func _apply_vm_runtime(
	runtime: Dictionary, session: LegacySession
) -> void:
	session.state.effect_log.clear()
	for effect: Variant in runtime.get("effect_log", []):
		session.state.effect_log.append(
			(effect as Dictionary).duplicate(true)
		)
	session.state._next_effect_id = int(runtime.get("next_effect_id", 1))
	session.vm.defer_blocking_effects = bool(
		runtime.get("defer_blocking_effects", false)
	)
	session.vm.waiting_effect_id = int(
		runtime.get("waiting_effect_id", 0)
	)
	session.vm.queue.clear()
	for instruction: Variant in runtime.get("queue", []):
		session.vm.queue.append(
			(instruction as Dictionary).duplicate(true)
		)
	session.vm._if_stack.clear()
	for frame: Variant in runtime.get("if_stack", []):
		session.vm._if_stack.append(
			(frame as Dictionary).duplicate(true)
		)


func _build_summary(
	slot_id: String, payload: Dictionary, timestamp: int
) -> Dictionary:
	var session_payload: Dictionary = _from_json_value(
		payload.get("session", {})
	)
	var game_state: Dictionary = session_payload.get("game_state", {})
	var profile: Dictionary = payload.get("profile", {})
	var current_location: String = str(
		session_payload.get(
			"current_location_id", game_state.get("location", "")
		)
	)
	return {
		"slot_id": slot_id,
		"slot_kind": _slot_kind(slot_id),
		"saved_at_unix": timestamp,
		"saved_at_utc": Time.get_datetime_string_from_unix_time(
			timestamp, true
		),
		"profile_id": str(profile.get("id", "")),
		"profile_name": str(profile.get("name", "")),
		"locale": str(payload.get("locale", "heb")),
		"playtime_seconds": float(
			payload.get("playtime_seconds", 0.0)
		),
		"location_id": current_location,
		"story": int(game_state.get("story", 0)),
		"part": int(game_state.get("part", 1)),
		"chapter_label": str(payload.get("chapter_label", "")),
		"game_version": str(payload.get("game_version", "")),
		"clue_count": int(
			(
				payload.get("clue_journal", {})
				.get("entries", [])
				.size()
			)
		),
	}


func _validate_payload(payload: Dictionary) -> Dictionary:
	if int(payload.get("payload_version", 0)) != 1:
		return {"message": "Unsupported payload version."}
	if typeof(payload.get("session", null)) != TYPE_DICTIONARY:
		return {"message": "Session snapshot is missing."}
	if typeof(payload.get("session_runtime", null)) != TYPE_DICTIONARY:
		return {"message": "Session runtime snapshot is missing."}
	if typeof(payload.get("clue_journal", null)) != TYPE_DICTIONARY:
		return {"message": "Clue-journal snapshot is missing."}
	if typeof(payload.get("profile", null)) != TYPE_DICTIONARY:
		return {"message": "Profile metadata must be an object."}
	if typeof(payload.get("locale", null)) != TYPE_STRING:
		return {"message": "Locale metadata must be text."}
	if str(payload.get("locale", "")).strip_edges().is_empty():
		return {"message": "Locale metadata cannot be blank."}
	var playtime_value: Variant = payload.get("playtime_seconds", null)
	if typeof(playtime_value) not in [TYPE_INT, TYPE_FLOAT]:
		return {"message": "Playtime metadata must be numeric."}
	var playtime: float = float(playtime_value)
	if playtime < 0.0 or is_nan(playtime) or is_inf(playtime):
		return {"message": "Playtime metadata is invalid."}

	var session_data: Variant = _from_json_value(payload["session"])
	var runtime: Variant = _from_json_value(payload["session_runtime"])
	var clue_data: Variant = _from_json_value(payload["clue_journal"])
	if typeof(session_data) != TYPE_DICTIONARY:
		return {"message": "Session snapshot is malformed."}
	if int(session_data.get("format", 0)) != 1:
		return {"message": "Unsupported legacy-session snapshot."}
	if typeof(session_data.get("game_state", null)) != TYPE_DICTIONARY:
		return {"message": "Game-state snapshot is missing."}
	if str(session_data.get("current_location_id", "")).is_empty():
		return {"message": "A save must name its current location."}
	if typeof(runtime) != TYPE_DICTIONARY:
		return {"message": "Runtime snapshot is malformed."}
	var runtime_error: String = _validate_runtime(runtime)
	if not runtime_error.is_empty():
		return {"message": runtime_error}
	if typeof(clue_data) != TYPE_DICTIONARY:
		return {"message": "Clue-journal snapshot is malformed."}
	var journal_probe := ClueJournal.new()
	if not journal_probe.restore(clue_data):
		return {"message": "Clue-journal snapshot failed validation."}
	if not _is_json_value(payload):
		return {"message": "Payload contains unsupported data."}
	return {}


func _validate_runtime(runtime: Dictionary) -> String:
	if int(runtime.get("runtime_version", 0)) != 1:
		return "Unsupported session-runtime snapshot."
	if (
		typeof(runtime.get("defer_blocking_effects", null))
		!= TYPE_BOOL
	):
		return "Deferred-effect state is malformed."
	if typeof(runtime.get("waiting_effect_id", null)) not in [
		TYPE_INT, TYPE_FLOAT
	]:
		return "Waiting-effect state is malformed."
	if typeof(runtime.get("queue", null)) != TYPE_ARRAY:
		return "VM queue is malformed."
	if typeof(runtime.get("if_stack", null)) != TYPE_ARRAY:
		return "VM condition stack is malformed."
	if typeof(runtime.get("effect_log", null)) != TYPE_ARRAY:
		return "Effect log is malformed."
	if typeof(runtime.get("next_effect_id", null)) not in [
		TYPE_INT, TYPE_FLOAT
	]:
		return "Effect sequence is malformed."

	var waiting_id: int = int(runtime.get("waiting_effect_id", 0))
	var maximum_id: int = 0
	var effect_ids: Dictionary = {}
	var waiting_is_pending: bool = waiting_id == 0
	for effect_value: Variant in runtime.get("effect_log", []):
		if typeof(effect_value) != TYPE_DICTIONARY:
			return "Effect log contains a malformed record."
		var effect: Dictionary = effect_value
		var effect_id: int = int(effect.get("id", 0))
		if effect_id <= 0 or effect_ids.has(effect_id):
			return "Effect identifiers are invalid or duplicated."
		effect_ids[effect_id] = true
		maximum_id = maxi(maximum_id, effect_id)
		var status: String = str(effect.get("status", ""))
		if status not in ["pending", "completed"]:
			return "Effect status is invalid."
		if (
			effect_id == waiting_id
			and status == "pending"
			and bool(effect.get("blocking", false))
		):
			waiting_is_pending = true
	if waiting_id < 0 or not waiting_is_pending:
		return "Waiting effect does not match a pending blocking effect."
	if int(runtime.get("next_effect_id", 0)) <= maximum_id:
		return "Effect sequence would reuse an identifier."
	for instruction: Variant in runtime.get("queue", []):
		if typeof(instruction) != TYPE_DICTIONARY:
			return "VM queue contains a malformed instruction."
	for frame: Variant in runtime.get("if_stack", []):
		if typeof(frame) != TYPE_DICTIONARY:
			return "VM condition stack contains malformed state."
	return ""


func _write_atomically(
	slot_id: String, document: Dictionary
) -> Dictionary:
	var final_path: String = slot_path(slot_id)
	var backup: String = backup_path(slot_id)
	var temporary: String = final_path + ".tmp"
	var serialized: String = _canonical_json(document)
	if serialized.to_utf8_buffer().size() > MAX_SAVE_BYTES:
		return _failure(
			"save_too_large",
			"The save exceeds the supported size limit.",
			slot_id
		)

	var file := FileAccess.open(temporary, FileAccess.WRITE)
	if file == null:
		return _failure(
			"write_failed",
			"Could not open the temporary save file.",
			slot_id,
			FileAccess.get_open_error()
		)
	file.store_string(serialized)
	file.flush()
	var file_error: Error = file.get_error()
	file.close()
	if file_error != OK:
		return _failure(
			"write_failed",
			"Could not finish writing the temporary save file.",
			slot_id,
			file_error
		)

	var temporary_check: Dictionary = _read_document(
		temporary, slot_id
	)
	if not bool(temporary_check.get("ok", false)):
		_remove_if_present(temporary)
		return _failure(
			"verification_failed",
			"The newly written save did not pass verification.",
			slot_id
		)

	var root := DirAccess.open(_save_root)
	if root == null:
		_remove_if_present(temporary)
		return _failure(
			"directory_error",
			"Could not open the save directory.",
			slot_id
		)
	var final_name: String = slot_id + ".save"
	var backup_name: String = final_name + ".bak"
	var temporary_name: String = final_name + ".tmp"
	var had_valid_primary: bool = false
	if FileAccess.file_exists(final_path):
		had_valid_primary = bool(
			_read_document(final_path, slot_id).get("ok", false)
		)
		if had_valid_primary:
			if root.file_exists(backup_name):
				var backup_remove_error: Error = root.remove(backup_name)
				if backup_remove_error != OK:
					_remove_if_present(temporary)
					return _failure(
						"rotate_failed",
						"Could not rotate the previous save backup.",
						slot_id,
						backup_remove_error
					)
			var rotate_error: Error = root.rename(
				final_name, backup_name
			)
			if rotate_error != OK:
				_remove_if_present(temporary)
				return _failure(
					"rotate_failed",
					"Could not preserve the previous save.",
					slot_id,
					rotate_error
				)
		else:
			var corrupt_remove_error: Error = root.remove(final_name)
			if corrupt_remove_error != OK:
				_remove_if_present(temporary)
				return _failure(
					"replace_failed",
					"Could not replace the corrupt primary save.",
					slot_id,
					corrupt_remove_error
				)

	var promote_error: Error = root.rename(temporary_name, final_name)
	if promote_error != OK:
		if had_valid_primary and root.file_exists(backup_name):
			root.rename(backup_name, final_name)
		return _failure(
			"promote_failed",
			"Could not promote the verified temporary save.",
			slot_id,
			promote_error
		)
	return {"ok": true}


func _read_best_document(slot_id: String) -> Dictionary:
	var primary_path: String = slot_path(slot_id)
	var secondary_path: String = backup_path(slot_id)
	var has_primary: bool = FileAccess.file_exists(primary_path)
	var has_backup: bool = FileAccess.file_exists(secondary_path)
	if not has_primary and not has_backup:
		return _failure(
			"empty_slot", "This save slot is empty.", slot_id
		)
	var primary_result: Dictionary = (
		_read_document(primary_path, slot_id)
		if has_primary
		else _failure(
			"missing_primary", "The primary save is missing.", slot_id
		)
	)
	if bool(primary_result.get("ok", false)):
		primary_result["recovered_from_backup"] = false
		return primary_result
	var backup_result: Dictionary = (
		_read_document(secondary_path, slot_id)
		if has_backup
		else _failure(
			"missing_backup", "The backup save is missing.", slot_id
		)
	)
	if bool(backup_result.get("ok", false)):
		backup_result["recovered_from_backup"] = true
		backup_result["primary_error"] = primary_result
		return backup_result
	return {
		"ok": false,
		"code": "corrupt_slot",
		"message": "Neither the primary save nor its backup is valid.",
		"slot_id": slot_id,
		"primary_error": primary_result,
		"backup_error": backup_result,
	}


func _read_document(path: String, expected_slot: String) -> Dictionary:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return _failure(
			"read_failed",
			"Could not open the save file.",
			expected_slot,
			FileAccess.get_open_error()
		)
	var length: int = file.get_length()
	if length <= 0 or length > MAX_SAVE_BYTES:
		file.close()
		return _failure(
			"invalid_size",
			"The save file is empty or too large.",
			expected_slot
		)
	var serialized: String = file.get_as_text()
	var read_error: Error = file.get_error()
	file.close()
	if read_error != OK:
		return _failure(
			"read_failed",
			"Could not read the complete save file.",
			expected_slot,
			read_error
		)
	var parser := JSON.new()
	if parser.parse(serialized) != OK:
		return _failure(
			"invalid_json",
			"The save file is not valid JSON.",
			expected_slot
		)
	if typeof(parser.data) != TYPE_DICTIONARY:
		return _failure(
			"invalid_document",
			"The save file root is not an object.",
			expected_slot
		)
	var document: Dictionary = parser.data
	var validation_error: String = _validate_document(
		document, expected_slot
	)
	if not validation_error.is_empty():
		return _failure(
			"invalid_document", validation_error, expected_slot
		)
	return {
		"ok": true,
		"code": "valid",
		"slot_id": expected_slot,
		"document": document,
	}


func _validate_document(
	document: Dictionary, expected_slot: String
) -> String:
	if str(document.get("schema", "")) != SCHEMA_NAME:
		return "Save schema identifier is not recognized."
	if int(document.get("schema_version", 0)) != SCHEMA_VERSION:
		return "Save schema version is not supported."
	if str(document.get("slot_id", "")) != expected_slot:
		return "Save slot identity does not match its file."
	if str(document.get("slot_kind", "")) != _slot_kind(expected_slot):
		return "Save slot kind does not match its file."
	if typeof(document.get("summary", null)) != TYPE_DICTIONARY:
		return "Save summary is missing."
	if typeof(document.get("payload", null)) != TYPE_DICTIONARY:
		return "Save payload is missing."
	if typeof(document.get("checksum_sha256", null)) != TYPE_STRING:
		return "Save checksum is missing."
	var summary: Dictionary = document["summary"]
	if str(summary.get("slot_id", "")) != expected_slot:
		return "Save summary slot identity is invalid."
	if str(summary.get("slot_kind", "")) != _slot_kind(expected_slot):
		return "Save summary slot kind is invalid."
	if (
		int(summary.get("saved_at_unix", -1))
		!= int(document.get("saved_at_unix", -2))
	):
		return "Save summary timestamp is inconsistent."
	if document.has("saved_at_unix_msec") or summary.has("saved_at_unix_msec"):
		if typeof(document.get("saved_at_unix_msec")) not in [TYPE_INT, TYPE_FLOAT] or typeof(summary.get("saved_at_unix_msec")) not in [TYPE_INT, TYPE_FLOAT]:
			return "Save millisecond timestamp is malformed."
		var milliseconds: int = int(document["saved_at_unix_msec"])
		var seconds: int = int(document["saved_at_unix"])
		if milliseconds != int(summary["saved_at_unix_msec"]) or milliseconds < seconds * 1000 or milliseconds >= (seconds + 1) * 1000:
			return "Save summary millisecond timestamp is inconsistent."
	var supplied_checksum: String = str(document["checksum_sha256"])
	var core: Dictionary = document.duplicate(true)
	core.erase("checksum_sha256")
	var computed_checksum: String = _checksum(core)
	if not supplied_checksum.to_lower() == computed_checksum:
		return "Save checksum verification failed."
	var payload_error: Dictionary = _validate_payload(document["payload"])
	if not payload_error.is_empty():
		return str(payload_error.get("message", "Save payload is invalid."))
	return ""


func _checksum(core: Dictionary) -> String:
	return _canonical_json(core).sha256_text()


func _canonical_json(value: Variant) -> String:
	return JSON.stringify(value, "", true, true)


func _ensure_save_directory() -> Error:
	if not _save_root.begins_with("user://"):
		return ERR_INVALID_PARAMETER
	return DirAccess.make_dir_recursive_absolute(
		ProjectSettings.globalize_path(_save_root)
	)


func _validate_slot_request(slot_id: String) -> Dictionary:
	if not _save_root.begins_with("user://"):
		return _failure(
			"invalid_root",
			"Save storage must remain inside user://.",
			slot_id
		)
	if not _is_valid_slot_id(slot_id):
		return _failure(
			"invalid_slot",
			"Only three manual slots and the autosave slot are supported.",
			slot_id
		)
	return {}


func _is_valid_slot_id(slot_id: String) -> bool:
	return slot_id in ALL_SLOT_IDS


func _slot_kind(slot_id: String) -> String:
	return "autosave" if slot_id == AUTOSAVE_SLOT_ID else "manual"


func _now_unix() -> int:
	if _now_provider.is_valid():
		return maxi(0, int(_now_provider.call()))
	return maxi(0, int(Time.get_unix_time_from_system()))


func _now_unix_msec() -> int:
	if _now_provider.is_valid():
		return maxi(0, int(floor(float(_now_provider.call()) * 1000.0)))
	# Distinct saves within one platform clock tick still retain their order.
	_last_system_save_msec = maxi(int(floor(Time.get_unix_time_from_system() * 1000.0)), _last_system_save_msec + 1)
	return _last_system_save_msec


func _empty_summary(slot_id: String) -> Dictionary:
	return {
		"slot_id": slot_id,
		"slot_kind": _slot_kind(slot_id),
		"state": "empty",
		"recovered_from_backup": false,
	}


func _corrupt_summary(
	slot_id: String, read_result: Dictionary
) -> Dictionary:
	return {
		"slot_id": slot_id,
		"slot_kind": _slot_kind(slot_id),
		"state": "corrupt",
		"recovered_from_backup": false,
		"error_code": str(read_result.get("code", "corrupt_slot")),
		"message": str(
			read_result.get("message", "The save is not readable.")
		),
	}


func _failure(
	code: String,
	message: String,
	slot_id: String = "",
	error: Error = OK
) -> Dictionary:
	var result: Dictionary = {
		"ok": false,
		"code": code,
		"message": message,
	}
	if not slot_id.is_empty():
		result["slot_id"] = slot_id
	if error != OK:
		result["error"] = error
	return result


func _remove_if_present(path: String) -> void:
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(path))


func _to_json_value(value: Variant) -> Variant:
	match typeof(value):
		TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_FLOAT, TYPE_STRING:
			return value
		TYPE_VECTOR2:
			return {
				"__jfg_type": "Vector2",
				"x": value.x,
				"y": value.y,
			}
		TYPE_VECTOR2I:
			return {
				"__jfg_type": "Vector2i",
				"x": value.x,
				"y": value.y,
			}
		TYPE_RECT2:
			return {
				"__jfg_type": "Rect2",
				"x": value.position.x,
				"y": value.position.y,
				"w": value.size.x,
				"h": value.size.y,
			}
		TYPE_RECT2I:
			return {
				"__jfg_type": "Rect2i",
				"x": value.position.x,
				"y": value.position.y,
				"w": value.size.x,
				"h": value.size.y,
			}
		TYPE_COLOR:
			return {
				"__jfg_type": "Color",
				"r": value.r,
				"g": value.g,
				"b": value.b,
				"a": value.a,
			}
		TYPE_ARRAY:
			var converted_array: Array = []
			for item: Variant in value:
				converted_array.append(_to_json_value(item))
			return converted_array
		TYPE_DICTIONARY:
			var needs_wrapper: bool = value.has("__jfg_type")
			for raw_key: Variant in value:
				if typeof(raw_key) != TYPE_STRING:
					needs_wrapper = true
					break
			if needs_wrapper:
				var entries: Array = []
				for raw_key: Variant in value:
					entries.append(
						[
							_to_json_value(raw_key),
							_to_json_value(value[raw_key]),
						]
					)
				return {
					"__jfg_type": "Dictionary",
					"entries": entries,
				}
			var converted_dictionary: Dictionary = {}
			for key: Variant in value:
				var serialized_key: String = str(key)
				converted_dictionary[serialized_key] = _to_json_value(
					value[key]
				)
			return converted_dictionary
	return null


func _from_json_value(value: Variant) -> Variant:
	if typeof(value) == TYPE_ARRAY:
		var restored_array: Array = []
		for item: Variant in value:
			restored_array.append(_from_json_value(item))
		return restored_array
	if typeof(value) != TYPE_DICTIONARY:
		return value
	var kind: String = str(value.get("__jfg_type", ""))
	match kind:
		"Dictionary":
			var restored_entries: Dictionary = {}
			for entry_value: Variant in value.get("entries", []):
				if (
					typeof(entry_value) != TYPE_ARRAY
					or entry_value.size() != 2
				):
					continue
				var restored_key: Variant = _from_json_value(
					entry_value[0]
				)
				# JSON decodes every number as a float. Wrapped dictionaries
				# only accept String or int keys when saved, so restore numeric
				# keys here too, including maps nested inside effect results.
				# Otherwise a loaded game can play but its next save is rejected.
				if (
					typeof(restored_key) == TYPE_FLOAT
					and is_finite(restored_key)
					and restored_key == float(int(restored_key))
				):
					restored_key = int(restored_key)
				restored_entries[restored_key] = _from_json_value(
					entry_value[1]
				)
			return restored_entries
		"Vector2":
			return Vector2(float(value.get("x", 0.0)), float(value.get("y", 0.0)))
		"Vector2i":
			return Vector2i(int(value.get("x", 0)), int(value.get("y", 0)))
		"Rect2":
			return Rect2(
				float(value.get("x", 0.0)),
				float(value.get("y", 0.0)),
				float(value.get("w", 0.0)),
				float(value.get("h", 0.0))
			)
		"Rect2i":
			return Rect2i(
				int(value.get("x", 0)),
				int(value.get("y", 0)),
				int(value.get("w", 0)),
				int(value.get("h", 0))
			)
		"Color":
			return Color(
				float(value.get("r", 0.0)),
				float(value.get("g", 0.0)),
				float(value.get("b", 0.0)),
				float(value.get("a", 1.0))
			)
	var restored_dictionary: Dictionary = {}
	for key: Variant in value:
		restored_dictionary[str(key)] = _from_json_value(value[key])
	return restored_dictionary


func _is_json_value(value: Variant) -> bool:
	match typeof(value):
		TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_STRING:
			return true
		TYPE_FLOAT:
			return not is_nan(value) and not is_inf(value)
		TYPE_ARRAY:
			for item: Variant in value:
				if not _is_json_value(item):
					return false
			return true
		TYPE_DICTIONARY:
			for key: Variant in value:
				if typeof(key) != TYPE_STRING:
					return false
				if not _is_json_value(value[key]):
					return false
			return true
		_:
			return false


func _is_encodable_value(value: Variant) -> bool:
	match typeof(value):
		TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_STRING:
			return true
		TYPE_FLOAT:
			return not is_nan(value) and not is_inf(value)
		TYPE_VECTOR2, TYPE_VECTOR2I, TYPE_RECT2, TYPE_RECT2I, TYPE_COLOR:
			return true
		TYPE_ARRAY:
			for item: Variant in value:
				if not _is_encodable_value(item):
					return false
			return true
		TYPE_DICTIONARY:
			for key: Variant in value:
				if typeof(key) not in [TYPE_STRING, TYPE_INT]:
					return false
				if not _is_encodable_value(value[key]):
					return false
			return true
	return false


func _validate_metadata(metadata: Dictionary) -> String:
	if not _is_json_value(metadata):
		return "Save metadata contains a value that cannot be serialized."
	if typeof(metadata.get("profile", {})) != TYPE_DICTIONARY:
		return "Profile metadata must be an object."
	if (
		metadata.has("locale")
		and typeof(metadata.get("locale")) != TYPE_STRING
	):
		return "Locale metadata must be text."
	if (
		metadata.has("locale")
		and str(metadata.get("locale", "")).strip_edges().is_empty()
	):
		return "Locale metadata cannot be blank."
	if metadata.has("playtime_seconds"):
		var playtime_value: Variant = metadata.get("playtime_seconds")
		if typeof(playtime_value) not in [TYPE_INT, TYPE_FLOAT]:
			return "Playtime metadata must be numeric."
		var playtime: float = float(playtime_value)
		if playtime < 0.0 or is_nan(playtime) or is_inf(playtime):
			return "Playtime metadata cannot be negative or non-finite."
	for text_key: String in [
		"game_version", "chapter_label", "created_by"
	]:
		if (
			metadata.has(text_key)
			and typeof(metadata.get(text_key)) != TYPE_STRING
		):
			return "%s metadata must be text." % text_key
	return ""
