var _locale: String = "he"
var _strings: Dictionary = {}
var _copy_resolver: Callable = Callable()
var _entries: Array[Dictionary] = []
var _selected_id: String = ""
var _journal: Object = null
var _entry_buttons: Dictionary = {}
var _handwriting_fonts: Dictionary = {}
var _close_press_rect: Rect2 = Rect2()
var _close_press_until: int = 0
var _close_press_viewport: Vector2 = Vector2.ZERO
## Frames left in which the selected entry is scrolled into view (fixes-87).
var _reveal_selected_frames: int = 0

var _page_margin: MarginContainer
var _header_title: Label
var _header_eyebrow: Label
var _count_label: Label
var _close_button: Button
var _body: BoxContainer
var _section_divider: ColorRect
var _list_pane: VBoxContainer
var _list_title: Label
var _list_scroll: ScrollContainer
var _entry_stack: VBoxContainer
var _detail_pane: VBoxContainer
var _detail_meta: Label
var _detail_title: Label
var _detail_body: RichTextLabel
var _detail_source: Label
var _empty_state: VBoxContainer
var _empty_title: Label
var _empty_body: Label
var _keyboard_hint: Label


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_STOP
	process_mode = Node.PROCESS_MODE_ALWAYS
	# _process runs only while the selected entry is scrolled into view.
	set_process(false)
	_build_interface()
	_apply_locale()
	_render_entries()
	visible = false


func set_localization(
	locale: String,
	strings: Dictionary = {},
	copy_resolver: Callable = Callable()
) -> void:
	_locale = "en" if locale == "en" else "he"
	_strings = strings.duplicate(true)
	_copy_resolver = copy_resolver
	if is_node_ready():
		_apply_locale()
		_render_entries()


func bind_journal(journal: Object) -> void:
	_disconnect_journal()
	_journal = journal
	if _journal == null:
		update_entries([])
		return
	_connect_journal_signal("clue_discovered", "_on_journal_clue_discovered")
	_connect_journal_signal(
		"clue_read_state_changed",
		"_on_journal_read_state_changed"
	)
	_connect_journal_signal("journal_restored", "_on_journal_refreshed")
	_connect_journal_signal("journal_cleared", "_on_journal_refreshed")
	refresh_from_journal()


func refresh_from_journal() -> void:
	if _journal == null or not _journal.has_method("entries"):
		update_entries([])
		return
	var journal_entries: Variant = _journal.call("entries")
	if journal_entries is Array:
		update_entries(journal_entries as Array)
	else:
		update_entries([])


func update_entries(entries: Array) -> void:
	_entries.clear()
	for value: Variant in entries:
		if value is Dictionary:
			_entries.append((value as Dictionary).duplicate(true))
	if not _contains_entry(_selected_id):
		_selected_id = _first_entry_id()
	if is_node_ready():
		_render_entries()


func open_journal(preferred_id: String = "") -> void:
	if not is_node_ready():
		return
	_close_press_until = 0
	visible = true
	if not preferred_id.is_empty() and _contains_entry(preferred_id):
		_selected_id = preferred_id
	elif not _contains_entry(_selected_id):
		_selected_id = _first_unread_id()
		if _selected_id.is_empty():
			_selected_id = _first_entry_id()
	_render_entries()
	if not _selected_id.is_empty():
		select_entry(_selected_id, true)
	elif is_instance_valid(_close_button):
		_close_button.grab_focus()


func close_journal() -> void:
	visible = false


func request_close() -> void:
	close_journal()
	close_requested.emit()


func _on_close_pressed() -> void:
	_close_press_rect = _close_button.get_global_rect().grow(CLOSE_SECOND_PRESS_SLOP)
	_close_press_until = Time.get_ticks_msec() + CLOSE_SECOND_PRESS_MSEC
	_close_press_viewport = get_viewport_rect().size
	request_close()


func close_double_press_area() -> Rect2:
	# The spot whose pointer presses are still held after Close (the rest of
	# a double tap may come), or an empty rect once that moment is over or
	# the window changed size.
	if (
		visible
		or Time.get_ticks_msec() >= _close_press_until
		or get_viewport_rect().size != _close_press_viewport
	):
		return Rect2()
	return _close_press_rect


func select_entry(clue_id: String, mark_as_read: bool = true) -> bool:
	if not _contains_entry(clue_id):
		return false
	# fixes-87 round 2: the list stays where it is. Every selection rebuilds
	# the entry buttons (marking the clue read rebuilds them too), and the
	# list's follow_focus then scrolled to the new button before it was laid
	# out, at (0, 0): to the top. Bringing the entry back into view from
	# there pinned it to the list's lower edge: a tapped entry jumped away
	# under the finger (the one above slid under it), and each Up moved the
	# list a row instead of the highlight. follow_focus is off for the
	# rebuild, and the list keeps this position: _keep_selected_in_view moves
	# it only for an entry out of view, by the shortest way.
	var keep_scroll: int = _list_scroll.scroll_vertical if is_instance_valid(_list_scroll) else 0
	if is_instance_valid(_list_scroll):
		_list_scroll.follow_focus = false
	_selected_id = clue_id
	if mark_as_read:
		_mark_selected_read(clue_id)
	_render_entries()
	entry_selected.emit(clue_id)
	var button: Button = _entry_buttons.get(clue_id) as Button
	if is_instance_valid(button):
		button.grab_focus()
	if is_instance_valid(_list_scroll):
		_list_scroll.follow_focus = true
		_list_scroll.scroll_vertical = keep_scroll
	_keep_selected_in_view()
	return true


func _keep_selected_in_view() -> void:
	# fixes-87: every selection rebuilds the entry buttons, and a new button
	# has no place in the list until the containers sort it (deferred). The
	# list's follow_focus scrolled to it at once, from position 0, so the list
	# stayed at (or went back to) the top: the casebook opened on the first
	# unread clue with that entry cut off or out of view, and Down could move
	# the selection out of view. Scroll it into view once laid out, in
	# _process (the casebook runs in the paused tree) after this frame's sorts
	# and before the frame is drawn, and on the next frames, in case a sort
	# (an entry's wrapped text, a turned phone) moves it again. From where the
	# list is (select_entry keeps it): an entry in view does not move it.
	_reveal_selected_frames = 3
	set_process(true)


func _process(_delta: float) -> void:
	if _reveal_selected_frames <= 0:
		set_process(false)
		return
	_reveal_selected_frames -= 1
	var button: Control = _entry_buttons.get(_selected_id) as Control
	if (
		visible
		and is_instance_valid(_list_scroll)
		and is_instance_valid(button)
		and _list_scroll.is_ancestor_of(button)
	):
		_list_scroll.ensure_control_visible(button)


func selected_entry_id() -> String:
	return _selected_id


func entries() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for entry: Dictionary in _entries:
		result.append(entry.duplicate(true))
	return result


func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), DESK)
	var compact: bool = size.x < 860.0 or size.y < 600.0
	var outer: float = 10 if compact else 18
	var cover := Rect2(Vector2.ONE * outer, size - Vector2.ONE * outer * 2)
	var cloth := _paper_style(Color("31564d"), Color("203e39"), 2, 11)
	cloth.shadow_color = Color(0.04, 0.025, 0.015, 0.40)
	cloth.shadow_size = 10
	cloth.shadow_offset = Vector2(3, 6)
	draw_style_box(cloth, cover)
	for layer: int in range(3):
		var sheet := cover.grow(-7 - layer * 2)
		draw_style_box(_paper_style(Color("e6dcc3"), Color("c8bda4"), 1, 4), sheet)
	var paper_rect := cover.grow(-12)
	draw_style_box(_paper_style(PAPER, Color("e8dfc8"), 1, 2), paper_rect)
	if not is_instance_valid(_body): return
	var spread: bool = not _body.vertical
	var ring_x: float = _section_divider.global_position.x - global_position.x if spread else paper_rect.position.x + 7
	var binding_top: float = _body.global_position.y - global_position.y + 16
	if spread:
		for layer: int in range(8):
			draw_rect(Rect2(ring_x - 8 + layer * 2, binding_top - 12, 2, maxf(0, paper_rect.end.y - binding_top - 8)), Color(0.26, 0.20, 0.12, 0.035 + (0.08 if layer in [3, 4] else 0.0)))
	for y: int in range(int(binding_top), int(paper_rect.end.y - 14), 43):
		draw_circle(Vector2(ring_x - 6, y), 2.5, Color("817866"))
		draw_circle(Vector2(ring_x + 7, y), 2.5, Color("817866"))
		draw_arc(Vector2(ring_x, y - 3), 10, 0.08, PI * 1.92, 20, Color("4a4337"), 2, true)
		draw_arc(Vector2(ring_x, y - 4), 9, 0.15, PI * 1.85, 20, Color("c4b99e"), 1, true)
	# The rules follow the actual reader, staying behind live, shaped text.
	if _detail_body.visible:
		var reader := Rect2(_detail_body.global_position - global_position, _detail_body.size)
		for y: int in range(int(reader.position.y + 29), int(reader.end.y), 34):
			draw_line(Vector2(reader.position.x, y), Vector2(reader.end.x, y), Color(RULE_BLUE, 0.18), 1)
		var margin_x: float = reader.end.x + 5 if _is_rtl() else reader.position.x - 5
		draw_line(Vector2(margin_x, reader.position.y), Vector2(margin_x, reader.end.y), Color(VERMILION, 0.25), 1)
	for index: int in range(240):
		var x := float((index * 137 + 29) % maxi(1, int(paper_rect.size.x - 12))) + paper_rect.position.x + 6
		var y := float((index * 73 + 11) % maxi(1, int(paper_rect.size.y - 12))) + paper_rect.position.y + 6
		draw_line(Vector2(x, y), Vector2(x + 2, y), Color(0.45, 0.37, 0.24, 0.035), 1)


func _paper_style(fill: Color, edge: Color, border: int, radius: int) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = fill
	style.border_color = edge
	style.set_border_width_all(border)
	style.set_corner_radius_all(radius)
	return style


func _notification(what: int) -> void:
	if what == NOTIFICATION_RESIZED and is_node_ready():
		queue_redraw()
		_apply_responsive_layout()
		# fixes-87: a turned phone lays the list out anew.
		if visible:
			_keep_selected_in_view()


func _input(event: InputEvent) -> void:
	if visible:
		# Escape (ui_cancel) closes the casebook here, before the GUI: a
		# tooltip shown over it (Close's "Esc to close", an entry's title)
		# takes that press for itself, so the first Escape only hid the tooltip.
		if event.is_action_pressed("ui_cancel"):
			request_close()
			get_viewport().set_input_as_handled()
		return
	# Closed by Close a moment ago: the rest of a double tap or double click
	# on its spot must not reach the game shown there now.
	if (
		(event is InputEventMouseButton or event is InputEventScreenTouch)
		and close_double_press_area().has_point(event.get("position"))
	):
		get_viewport().set_input_as_handled()


func _unhandled_key_input(event: InputEvent) -> void:
	if not visible or not event is InputEventKey:
		return
	var key_event := event as InputEventKey
	if not key_event.pressed or key_event.echo:
		return
	match key_event.keycode:
		KEY_ESCAPE, KEY_J:
			request_close()
			get_viewport().set_input_as_handled()
		KEY_UP:
			_move_selection(-1)
			get_viewport().set_input_as_handled()
		KEY_DOWN:
			_move_selection(1)
			get_viewport().set_input_as_handled()
		KEY_HOME:
			_select_by_index(0)
			get_viewport().set_input_as_handled()
		KEY_END:
			_select_by_index(_entries.size() - 1)
			get_viewport().set_input_as_handled()


func _build_interface() -> void:
	var body_face := FontVariation.new()
	body_face.base_font = load(UI_FONT_PATH) as Font
	body_face.variation_opentype = {TextServerManager.get_primary_interface().name_to_tag("wght"): 400.0}
	for language: String in ["he", "en"]:
		var handwriting := FontVariation.new()
		handwriting.base_font = load("res://assets/fonts/gveret-levin/GveretLevin-Regular.ttf" if language == "he" else "res://assets/fonts/caveat/Caveat-wght.ttf") as Font
		# Retain both faces during locale changes and support mixed clue text.
		handwriting.fallbacks = [body_face]
		_handwriting_fonts[language] = handwriting
	_page_margin = MarginContainer.new()
	_page_margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(_page_margin)

	var page := VBoxContainer.new()
	page.add_theme_constant_override("separation", 0)
	_page_margin.add_child(page)

	var header := HBoxContainer.new()
	header.name = "EvidenceHeader"
	header.custom_minimum_size = Vector2(0.0, 104.0)
	header.add_theme_constant_override("separation", 18)
	page.add_child(header)

	var title_group := VBoxContainer.new()
	title_group.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title_group.add_theme_constant_override("separation", 1)
	header.add_child(title_group)

	_header_eyebrow = _make_label("", 14, VERMILION)
	_header_eyebrow.add_theme_constant_override("letter_spacing", 2)
	title_group.add_child(_header_eyebrow)

	_header_title = _make_label("", 40, INK)
	_header_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	title_group.add_child(_header_title)

	_count_label = _make_label("", 15, MUTED)
	_count_label.custom_minimum_size = Vector2(150.0, 0.0)
	_count_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	header.add_child(_count_label)

	_close_button = Button.new()
	_close_button.name = "CloseButton"
	_close_button.custom_minimum_size = Vector2(96.0, 48.0)
	_close_button.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	_close_button.focus_mode = Control.FOCUS_ALL
	_close_button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	_close_button.add_theme_font_size_override("font_size", 16)
	var close_font: Resource = load(UI_FONT_PATH)
	if close_font is Font:
		_close_button.add_theme_font_override("font", close_font as Font)
	_close_button.add_theme_color_override("font_color", INK)
	_close_button.add_theme_color_override("font_hover_color", INK)
	_close_button.add_theme_color_override("font_focus_color", INK)
	_close_button.add_theme_color_override("font_pressed_color", TEAL)
	_close_button.add_theme_stylebox_override(
		"normal",
		_make_text_button_style(Color.TRANSPARENT, INK, 0)
	)
	_close_button.add_theme_stylebox_override(
		"hover",
		_make_text_button_style(ROW_HOVER, TEAL, 1)
	)
	_close_button.add_theme_stylebox_override(
		"pressed",
		_make_text_button_style(ROW_SELECTED, TEAL, 2)
	)
	_close_button.add_theme_stylebox_override(
		"focus",
		_make_text_button_style(Color.TRANSPARENT, TEAL, 2)
	)
	_close_button.pressed.connect(_on_close_pressed)
	header.add_child(_close_button)

	var header_divider := ColorRect.new()
	header_divider.color = Color(RULE_BLUE, 0.22)
	header_divider.custom_minimum_size = Vector2(0.0, 1.0)
	header_divider.mouse_filter = Control.MOUSE_FILTER_IGNORE
	page.add_child(header_divider)

	_body = BoxContainer.new()
	_body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_body.add_theme_constant_override("separation", 0)
	page.add_child(_body)

	_list_pane = VBoxContainer.new()
	_list_pane.name = "EvidenceList"
	_list_pane.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_list_pane.size_flags_stretch_ratio = 0.38
	_list_pane.add_theme_constant_override("separation", 18)
	_body.add_child(_with_margin(_list_pane, 30, 26, 30, 24))

	_list_title = _make_label("", 28, INK)
	_list_pane.add_child(_list_title)

	var list_scroll := ScrollContainer.new()
	list_scroll.name = "EvidenceScroll"
	list_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	list_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	list_scroll.follow_focus = true
	_list_pane.add_child(list_scroll)
	NativeTouchScroll.attach(list_scroll)
	_list_scroll = list_scroll

	_entry_stack = VBoxContainer.new()
	_entry_stack.name = "EvidenceEntries"
	_entry_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_entry_stack.add_theme_constant_override("separation", 2)
	list_scroll.add_child(_entry_stack)

	_section_divider = ColorRect.new()
	_section_divider.color = Color.TRANSPARENT
	_section_divider.custom_minimum_size = Vector2(2.0, 0.0)
	_section_divider.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_body.add_child(_section_divider)

	_detail_pane = VBoxContainer.new()
	_detail_pane.name = "EvidenceDetail"
	_detail_pane.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_detail_pane.size_flags_stretch_ratio = 0.62
	_detail_pane.add_theme_constant_override("separation", 16)
	_body.add_child(_with_margin(_detail_pane, 52, 38, 52, 30))

	_detail_meta = _make_label("", 15, TEAL)
	_detail_meta.add_theme_constant_override("letter_spacing", 1)
	_detail_pane.add_child(_detail_meta)

	_detail_title = _make_label("", 42, INK)
	_detail_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_detail_pane.add_child(_detail_title)

	var detail_rule := ColorRect.new()
	detail_rule.color = Color(TEAL, 0.40)
	detail_rule.custom_minimum_size = Vector2(66.0, 1.0)
	detail_rule.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	detail_rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_detail_pane.add_child(detail_rule)

	_detail_body = RichTextLabel.new()
	_detail_body.name = "EvidenceBody"
	_detail_body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_detail_body.fit_content = false
	_detail_body.scroll_active = true
	_detail_body.selection_enabled = true
	_detail_body.add_theme_font_size_override("normal_font_size", 21)
	_detail_body.add_theme_color_override("default_color", INK)
	_detail_body.add_theme_color_override("font_selected_color", PAPER_LIGHT)
	_detail_body.add_theme_color_override("selection_color", TEAL)
	_detail_body.add_theme_constant_override("line_separation", 8)
	var body_font: Resource = load(UI_FONT_PATH)
	if body_font is Font:
		_detail_body.add_theme_font_override("normal_font", body_font as Font)
	_detail_pane.add_child(_detail_body)

	_detail_source = _make_label("", 14, MUTED)
	_detail_source.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_detail_pane.add_child(_detail_source)

	_empty_state = VBoxContainer.new()
	_empty_state.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_empty_state.alignment = BoxContainer.ALIGNMENT_CENTER
	_empty_state.add_theme_constant_override("separation", 14)
	_detail_pane.add_child(_empty_state)

	var empty_mark := Label.new()
	empty_mark.text = "âœ¿"
	empty_mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	empty_mark.add_theme_font_size_override("font_size", 44)
	empty_mark.add_theme_color_override("font_color", VERMILION)
	_empty_state.add_child(empty_mark)

	_empty_title = _make_label("", 29, INK)
	if WebLayout.enabled(): _empty_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_empty_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_empty_state.add_child(_empty_title)

	_empty_body = _make_label("", 18, MUTED)
	_empty_body.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_empty_body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_empty_body.custom_minimum_size = Vector2(0.0, 72.0)
	_empty_state.add_child(_empty_body)

	var footer_rule := ColorRect.new()
	footer_rule.color = Color(RULE_BLUE, 0.18)
	footer_rule.custom_minimum_size = Vector2(0.0, 1.0)
	footer_rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	page.add_child(footer_rule)

	_keyboard_hint = _make_label("", 14, MUTED)
	_keyboard_hint.custom_minimum_size = Vector2(0.0, 42.0)
	_keyboard_hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	page.add_child(_keyboard_hint)

	# _draw() places the ring binding and the reader's rules from the laid-out
	# rects of these controls. Containers lay out over a few deferred sorts
	# after the casebook is shown or resized (hidden ones do not sort), so a
	# redraw queued before that drew the first open, or a rotation while
	# open, from the old layout. Redraw whenever one of them moves or resizes.
	for control: Control in [_page_margin, page, _body, _section_divider, _detail_pane.get_parent() as Control, _detail_pane, _detail_body]:
		control.item_rect_changed.connect(queue_redraw)
	_detail_body.visibility_changed.connect(queue_redraw)
	# Focus stays on the controls _update_focus_neighbors() links; the clue
	# text's scroll bar still drags and the text scrolls with the arrow keys.
	_detail_body.get_v_scroll_bar().focus_mode = Control.FOCUS_NONE

	_apply_responsive_layout()


func _apply_locale() -> void:
	var direction: int = (
		Control.LAYOUT_DIRECTION_RTL
		if _is_rtl()
		else Control.LAYOUT_DIRECTION_LTR
	)
	layout_direction = direction as LayoutDirection
	if is_instance_valid(_page_margin):
		_page_margin.layout_direction = direction as LayoutDirection
	_header_eyebrow.text = _copy("journal_eyebrow")
	_header_title.text = _copy("journal_title")
	_list_title.text = _copy("journal_list_title")
	_close_button.text = "Ã—  %s" % _copy("journal_close")
	for label: Label in [_header_title, _list_title, _detail_title, _empty_title]:
		label.add_theme_font_override("font", _handwriting_fonts[_locale])
	_close_button.tooltip_text = _copy("journal_close_hint")
	_empty_title.text = _copy("journal_empty_title")
	_empty_body.text = _copy("journal_empty_body")
	_keyboard_hint.text = _copy("journal_keyboard_hint")
	_apply_text_directions()
	# The web spread's binding gutter is on a side that follows the direction.
	_apply_responsive_layout()
	queue_redraw()


func _apply_text_directions() -> void:
	var text_direction: int = (
		Control.TEXT_DIRECTION_RTL
		if _is_rtl()
		else Control.TEXT_DIRECTION_LTR
	)
	# Godot mirrors LEFT/RIGHT alignment with an RTL layout direction. LEFT is
	# therefore the semantic "start" edge here: physical right in Hebrew and
	# physical left in English.
	var alignment: int = HORIZONTAL_ALIGNMENT_LEFT
	for label: Label in [
		_header_eyebrow,
		_header_title,
		_list_title,
		_detail_meta,
		_detail_title,
		_detail_source,
		_keyboard_hint,
	]:
		label.text_direction = text_direction as TextDirection
		label.horizontal_alignment = alignment as HorizontalAlignment
	_count_label.text_direction = text_direction as TextDirection
	_count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_detail_body.text_direction = text_direction as TextDirection
	_empty_title.text_direction = text_direction as TextDirection
	_empty_body.text_direction = text_direction as TextDirection


func _apply_responsive_layout() -> void:
	if not is_instance_valid(_body):
		return
	if WebLayout.enabled():
		_apply_web_layout()
		return
	var compact: bool = size.x < 860.0 or size.y < 600.0
	_body.vertical = compact
	if compact:
		_section_divider.custom_minimum_size = Vector2(0.0, 1.0)
		_list_pane.custom_minimum_size = Vector2(0.0, 180.0)
		_detail_pane.custom_minimum_size = Vector2(0.0, 240.0)
	else:
		_section_divider.custom_minimum_size = Vector2(1.0, 0.0)
		_list_pane.custom_minimum_size = Vector2(310.0, 0.0)
		_detail_pane.custom_minimum_size = Vector2(440.0, 0.0)
	var horizontal_margin: int = 44 if compact else 58
	var top_margin: int = 36 if compact else 44
	var bottom_margin: int = 30 if compact else 38
	_page_margin.add_theme_constant_override("margin_left", horizontal_margin)
	_page_margin.add_theme_constant_override("margin_right", horizontal_margin)
	_page_margin.add_theme_constant_override("margin_top", top_margin)
	_page_margin.add_theme_constant_override("margin_bottom", bottom_margin)


func _apply_web_layout() -> void:
	var portrait := size.x < 600.0
	_body.vertical = portrait
	_page_margin.add_theme_constant_override("margin_left", 38 if portrait else 32)
	_page_margin.add_theme_constant_override("margin_right", 26 if portrait else 32)
	_page_margin.add_theme_constant_override("margin_top", 26)
	_page_margin.add_theme_constant_override("margin_bottom", 26)
	var header: HBoxContainer = find_child("EvidenceHeader", true, false)
	header.custom_minimum_size.y = 66 if portrait else 58
	header.add_theme_constant_override("separation", 8)
	_header_title.add_theme_font_size_override("font_size", 30)
	_header_eyebrow.add_theme_font_size_override("font_size", 12)
	_header_eyebrow.visible = false
	_count_label.visible = not portrait
	_count_label.custom_minimum_size.x = 90
	_close_button.custom_minimum_size = Vector2(84, 48)
	_keyboard_hint.hide()
	_section_divider.custom_minimum_size = Vector2(0, 1) if portrait else Vector2(1, 0)
	_list_pane.custom_minimum_size = Vector2(0, 120) if portrait else Vector2(210, 0)
	_detail_pane.custom_minimum_size = Vector2(0, 260) if portrait else Vector2(0, 0)
	_list_pane.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_detail_pane.size_flags_vertical = Control.SIZE_EXPAND_FILL
	for pane: VBoxContainer in [_list_pane, _detail_pane]:
		pane.add_theme_constant_override("separation", 6)
		var margin := pane.get_parent() as MarginContainer
		for side: String in ["left", "right", "top", "bottom"]:
			margin.add_theme_constant_override("margin_" + side, 12)
	if not portrait:
		# Keep the text of both pages clear of the ring binding on the divider
		# (12 px let the rings touch the clue's title and text). The margins
		# are physical: in Hebrew the list is right of the divider.
		(_list_pane.get_parent() as MarginContainer).add_theme_constant_override(
			"margin_left" if _is_rtl() else "margin_right", WEB_BINDING_GUTTER
		)
		(_detail_pane.get_parent() as MarginContainer).add_theme_constant_override(
			"margin_right" if _is_rtl() else "margin_left", WEB_BINDING_GUTTER
		)
	_list_title.add_theme_font_size_override("font_size", 26)
	_detail_title.add_theme_font_size_override("font_size", 30)
	_detail_meta.add_theme_font_size_override("font_size", 13)
	_detail_body.add_theme_font_size_override("normal_font_size", 17)
	_detail_body.add_theme_constant_override("line_separation", 4)
	_detail_source.add_theme_font_size_override("font_size", 12)
	_empty_title.add_theme_font_size_override("font_size", 27)
	_empty_body.add_theme_font_size_override("font_size", 16)
	_empty_body.custom_minimum_size.y = 48


func _render_entries() -> void:
	if not is_instance_valid(_entry_stack):
		return
	_clear_children(_entry_stack)
	_entry_buttons.clear()

	var unread: int = 0
	for entry: Dictionary in _entries:
		if not bool(entry.get("read", false)):
			unread += 1
	var count_text: String = _count_copy("journal_count", _entries.size())
	if unread > 0:
		count_text += "  Â·  " + _count_copy("journal_unread_count", unread)
	_count_label.text = count_text

	for index: int in range(_entries.size()):
		var entry: Dictionary = _entries[index]
		var clue_id: String = str(entry.get("id", "")).strip_edges()
		if clue_id.is_empty():
			continue
		var button := _make_entry_button(entry, clue_id == _selected_id)
		button.pressed.connect(
			func() -> void:
				select_entry(clue_id, true)
		)
		button.focus_entered.connect(
			func() -> void:
				if clue_id != _selected_id:
					select_entry(clue_id, true)
		)
		_entry_stack.add_child(button)
		_entry_buttons[clue_id] = button

	_render_detail()
	_update_focus_neighbors()
	queue_redraw.call_deferred()


func _count_copy(key: String, count: int) -> String:
	# Hebrew needs the singular for one ("×¤×¨×™×˜ ××—×“", not "1 ×¤×¨×™×˜×™×").
	if count == 1:
		var singular: String = _copy(key + "_one")
		if singular != key + "_one":
			return singular
	return _copy(key) % count


func _make_entry_button(entry: Dictionary, selected: bool) -> Button:
	var title: String = _entry_title(entry)
	var location: String = _entry_location(entry)
	var is_unread: bool = not bool(entry.get("read", false))
	var status_mark: String = "âœ±  " if is_unread else ""
	var second_line: String = location
	if is_unread:
		second_line = (
			_copy("journal_new")
			if second_line.is_empty()
			else "%s  Â·  %s" % [_copy("journal_new"), second_line]
		)

	var button := Button.new()
	button.name = "Entry_%s" % _safe_node_name(str(entry.get("id", "")))
	button.text = status_mark + title
	if not second_line.is_empty():
		button.text += "\n" + second_line
	button.tooltip_text = title
	button.custom_minimum_size = Vector2(0.0, 68.0)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.focus_mode = Control.FOCUS_ALL
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	button.alignment = HORIZONTAL_ALIGNMENT_LEFT
	button.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL
		if _is_rtl()
		else Control.LAYOUT_DIRECTION_LTR
	)
	button.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if _is_rtl()
		else Control.TEXT_DIRECTION_LTR
	)
	button.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	button.add_theme_font_size_override("font_size", 18)
	var button_font: Resource = load(UI_FONT_PATH)
	if button_font is Font:
		button.add_theme_font_override("font", button_font as Font)
	button.add_theme_color_override(
		"font_color",
		INK if selected or not is_unread else VERMILION
	)
	button.add_theme_color_override("font_hover_color", INK)
	button.add_theme_color_override("font_focus_color", INK)
	button.add_theme_color_override("font_pressed_color", INK)
	button.add_theme_stylebox_override(
		"normal",
		_make_row_style(ROW_SELECTED if selected else Color.TRANSPARENT, selected)
	)
	button.add_theme_stylebox_override(
		"hover",
		_make_row_style(ROW_HOVER, true)
	)
	button.add_theme_stylebox_override(
		"pressed",
		_make_row_style(ROW_SELECTED, true)
	)
	button.add_theme_stylebox_override(
		"focus",
		_make_row_style(ROW_SELECTED, true, true)
	)
	return button


func _render_detail() -> void:
	var selected: Dictionary = _entry_by_id(_selected_id)
	var has_entry: bool = not selected.is_empty()
	_detail_meta.visible = has_entry
	_detail_title.visible = has_entry
	_detail_body.visible = has_entry
	_detail_source.visible = has_entry
	_empty_state.visible = not has_entry
	if not has_entry:
		return

	var location: String = _entry_location(selected)
	var metadata_parts: PackedStringArray = []
	if not location.is_empty():
		metadata_parts.append(
			"%s Â· %s" % [_copy("journal_location"), location]
		)
	if not bool(selected.get("read", false)):
		metadata_parts.append(_copy("journal_new"))
	_detail_meta.text = "  Â·  ".join(metadata_parts)
	_detail_title.text = _entry_title(selected)
	_detail_body.text = _entry_body(selected)

	var source: String = _entry_source(selected)
	_detail_source.text = (
		""
		if source.is_empty()
		else "%s Â· %s" % [_copy("journal_source"), source]
	)


func _move_selection(delta: int) -> void:
	if _entries.is_empty():
		return
	var current_index: int = _entry_index(_selected_id)
	if current_index < 0:
		current_index = 0
	else:
		current_index = wrapi(current_index + delta, 0, _entries.size())
	_select_by_index(current_index)


func _select_by_index(index: int) -> void:
	if index < 0 or index >= _entries.size():
		return
	var clue_id: String = str(_entries[index].get("id", ""))
	select_entry(clue_id, true)


func _mark_selected_read(clue_id: String) -> void:
	var entry_index: int = _entry_index(clue_id)
	if entry_index < 0 or bool(_entries[entry_index].get("read", false)):
		return
	if _journal != null and _journal.has_method("mark_read"):
		_journal.call("mark_read", clue_id)
		_entries[entry_index]["read"] = true
	else:
		_entries[entry_index]["read"] = true
		entry_read_requested.emit(clue_id)


func _entry_title(entry: Dictionary) -> String:
	# Resolve older saved inventory entries without changing their read state.
	var item_id: String = str(entry.get("id", "")).trim_prefix("found_")
	var item_presentation = preload("res://src/presentation/modern_item_presentation.gd")
	if str(entry.get("id", "")).begins_with("found_") and item_presentation.definitions().has(item_id.to_lower()):
		return item_presentation.label(item_id, _locale)
	var resolved: String = _resolve_entry_field(
		entry,
		["title_key", "label_key"],
		["title", "label"]
	)
	if not resolved.is_empty():
		return resolved
	var clue_id: String = str(entry.get("id", "")).strip_edges()
	if clue_id.is_empty():
		return _copy("journal_missing_title")
	return clue_id.replace("_", " ").capitalize()


func _entry_body(entry: Dictionary) -> String:
	var resolved: String = _resolve_entry_field(
		entry,
		["body_key", "observation_key", "detail_key"],
		["body", "observation", "detail"]
	)
	return resolved if not resolved.is_empty() else _copy("journal_missing_body")


func _entry_location(entry: Dictionary) -> String:
	var metadata: Dictionary = _entry_metadata(entry)
	var location_key: String = str(metadata.get("location_key", "")).strip_edges()
	if not location_key.is_empty():
		var localized: String = _copy(location_key)
		if localized != location_key:
			return localized
	var location: Variant = metadata.get(
		"location",
		entry.get("location", "")
	)
	return _localized_value(location)


func _entry_source(entry: Dictionary) -> String:
	var metadata: Dictionary = _entry_metadata(entry)
	var source_key: String = str(metadata.get("source_key", "")).strip_edges()
	if not source_key.is_empty():
		var localized: String = _copy(source_key)
		if localized != source_key:
			return localized
	return _localized_value(metadata.get("source", entry.get("source", "")))


func _resolve_entry_field(
	entry: Dictionary,
	key_fields: Array[String],
	value_fields: Array[String]
) -> String:
	var metadata: Dictionary = _entry_metadata(entry)
	for field: String in key_fields:
		var key: String = str(metadata.get(field, entry.get(field, ""))).strip_edges()
		if key.is_empty():
			continue
		var localized: String = _copy(key)
		if localized != key:
			return localized
	for field: String in value_fields:
		var value: Variant = metadata.get(field, entry.get(field, ""))
		var localized: String = _localized_value(value)
		if not localized.is_empty():
			return localized
	return ""


func _localized_value(value: Variant) -> String:
	if value is Dictionary:
		var localized: Dictionary = value
		return str(
			localized.get(
				_locale,
				localized.get("he", localized.get("en", ""))
			)
		).strip_edges()
	return str(value).strip_edges()


func _entry_metadata(entry: Dictionary) -> Dictionary:
	var metadata: Variant = entry.get("metadata", {})
	return metadata as Dictionary if metadata is Dictionary else {}


func _copy(key: String) -> String:
	if _copy_resolver.is_valid():
		var callable_value: Variant = _copy_resolver.call(key)
		var callable_text: String = str(callable_value)
		if not callable_text.is_empty() and callable_text != key:
			return callable_text
	var locale_strings: Variant = _strings.get(_locale, {})
	if locale_strings is Dictionary and (locale_strings as Dictionary).has(key):
		return str((locale_strings as Dictionary)[key])
	if _strings.has(key):
		return str(_strings[key])
	var defaults: Dictionary = DEFAULT_COPY.get(
		_locale,
		DEFAULT_COPY["he"]
	)
	return str(defaults.get(key, key))


func _on_journal_clue_discovered(_clue_id: String) -> void:
	refresh_from_journal()


func _on_journal_read_state_changed(
	_clue_id: String,
	_is_read: bool
) -> void:
	refresh_from_journal()


func _on_journal_refreshed() -> void:
	refresh_from_journal()


func _connect_journal_signal(signal_name: String, method_name: String) -> void:
	if _journal == null or not _journal.has_signal(signal_name):
		return
	var callback := Callable(self, method_name)
	if not _journal.is_connected(signal_name, callback):
		_journal.connect(signal_name, callback)


func _disconnect_journal() -> void:
	if _journal == null:
		return
	for pair: Array in [
		["clue_discovered", "_on_journal_clue_discovered"],
		["clue_read_state_changed", "_on_journal_read_state_changed"],
		["journal_restored", "_on_journal_refreshed"],
		["journal_cleared", "_on_journal_refreshed"],
	]:
		var signal_name: String = pair[0]
		var callback := Callable(self, pair[1])
		if (
			_journal.has_signal(signal_name)
			and _journal.is_connected(signal_name, callback)
		):
			_journal.disconnect(signal_name, callback)
	_journal = null


func _contains_entry(clue_id: String) -> bool:
	return _entry_index(clue_id) >= 0


func _entry_index(clue_id: String) -> int:
	for index: int in range(_entries.size()):
		if str(_entries[index].get("id", "")) == clue_id:
			return index
	return -1


func _entry_by_id(clue_id: String) -> Dictionary:
	var index: int = _entry_index(clue_id)
	return {} if index < 0 else _entries[index]


func _first_entry_id() -> String:
	return "" if _entries.is_empty() else str(_entries[0].get("id", ""))


func _first_unread_id() -> String:
	for entry: Dictionary in _entries:
		if not bool(entry.get("read", false)):
			return str(entry.get("id", ""))
	return ""


func _update_focus_neighbors() -> void:
	# Keyboard focus stays inside the open casebook: every control here that
	# takes focus names a casebook control for each arrow and for Tab and
	# Shift+Tab. Without one, Godot searches the whole window and moved focus
	# onto the paused game controls hidden behind the casebook. Up and Down
	# wrap round the entries; Left and Right switch between the selected entry
	# and the clue text; Tab runs Close, the entries, the clue text, Close.
	var buttons: Array[Button] = []
	for entry: Dictionary in _entries:
		var clue_id: String = str(entry.get("id", ""))
		var button: Button = _entry_buttons.get(clue_id) as Button
		if is_instance_valid(button):
			buttons.append(button)
	var reader: Control = _detail_body if _detail_body.visible else null
	var first: Control = _close_button if buttons.is_empty() else buttons[0]
	var last: Control = _close_button if buttons.is_empty() else buttons[-1]
	var selected: Control = _entry_buttons.get(_selected_id) as Button
	if not is_instance_valid(selected):
		selected = first
	_link_focus(_close_button, _close_button, selected, _close_button, _close_button, first, last if reader == null else reader)
	for index: int in range(buttons.size()):
		var button: Button = buttons[index]
		var across: Control = button if reader == null else reader
		var after: Control = buttons[index + 1] if index + 1 < buttons.size() else (_close_button if reader == null else reader)
		_link_focus(button, buttons[index - 1], buttons[(index + 1) % buttons.size()], across, across, after, _close_button if index == 0 else buttons[index - 1])
	if reader != null:
		_link_focus(reader, reader, reader, selected, selected, _close_button, last)


func _link_focus(control: Control, up: Control, down: Control, left: Control, right: Control, next: Control, previous: Control) -> void:
	control.focus_neighbor_top = control.get_path_to(up)
	control.focus_neighbor_bottom = control.get_path_to(down)
	control.focus_neighbor_left = control.get_path_to(left)
	control.focus_neighbor_right = control.get_path_to(right)
	control.focus_next = control.get_path_to(next)
	control.focus_previous = control.get_path_to(previous)


func _make_label(text: String, font_size: int, color: Color) -> Label:
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	var font_resource: Resource = load(UI_FONT_PATH)
	if font_resource is Font:
		label.add_theme_font_override("font", font_resource as Font)
	return label


func _with_margin(
	content: Control,
	left: int,
	top: int,
	right: int,
	bottom: int
) -> MarginContainer:
	var margin := MarginContainer.new()
	margin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	margin.size_flags_vertical = Control.SIZE_EXPAND_FILL
	margin.size_flags_stretch_ratio = content.size_flags_stretch_ratio
	margin.add_theme_constant_override("margin_left", left)
	margin.add_theme_constant_override("margin_top", top)
	margin.add_theme_constant_override("margin_right", right)
	margin.add_theme_constant_override("margin_bottom", bottom)
	margin.add_child(content)
	return margin


func _make_row_style(
	background: Color,
	accented: bool,
	focus_outline: bool = false
) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = background
	style.content_margin_left = 8.0
	style.content_margin_right = 8.0
	style.content_margin_top = 8.0
	style.content_margin_bottom = 8.0
	style.border_color = Color(RULE_BLUE, 0.20)
	style.border_width_bottom = 1
	if accented:
		style.border_color = Color(TEAL, 0.58)
		style.border_width_bottom = 2
	if focus_outline:
		style.border_color = TEAL
		style.border_width_bottom = 2
	return style


func _make_text_button_style(
	background: Color,
	underline: Color,
	underline_width: int
) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = background
	style.border_color = underline
	style.border_width_bottom = underline_width
	style.content_margin_left = 12.0
	style.content_margin_right = 12.0
	style.content_margin_top = 8.0
	style.content_margin_bottom = 8.0
	return style


func _safe_node_name(value: String) -> String:
	return value.validate_node_name().replace(" ", "_")


func _is_rtl() -> bool:
	return _locale == "he"


func _clear_children(parent: Node) -> void:
	for child: Node in parent.get_children():
		parent.remove_child(child)
		child.queue_free()
