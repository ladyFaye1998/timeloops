func _connect_presenter() -> void:
	presenter.location_presented.connect(_on_location_presented)
	presenter.navigation_requested.connect(_on_navigation_requested)
	presenter.dialogue_requested.connect(_on_dialogue_effect)
	presenter.minigame_requested.connect(_on_minigame_requested)
	presenter.ending_requested.connect(_on_ending_requested)
	presenter.effect_routed.connect(_on_effect_routed)
	presenter.interaction_completed.connect(_on_interaction_completed)


func _connect_effect_host() -> void:
	effect_host.unhandled_blocking_effect.connect(
		_on_unhandled_blocking_effect
	)
	effect_host.media_started.connect(_on_media_started)
	effect_host.media_finished.connect(_on_media_finished)
	effect_host.effect_completed.connect(_on_effect_completed)


func _connect_session() -> void:
	if session == null:
		return
	var state_callback := Callable(self, "_on_session_state_changed")
	if not session.state_changed.is_connected(state_callback):
		session.state_changed.connect(state_callback)
	var location_callback := Callable(self, "_on_session_location_entered")
	if not session.location_entered.is_connected(location_callback):
		session.location_entered.connect(location_callback)


func _disconnect_session() -> void:
	if session == null:
		return
	var state_callback := Callable(self, "_on_session_state_changed")
	if session.state_changed.is_connected(state_callback):
		session.state_changed.disconnect(state_callback)
	var location_callback := Callable(self, "_on_session_location_entered")
	if session.location_entered.is_connected(location_callback):
		session.location_entered.disconnect(location_callback)


func _on_location_presented(model: Dictionary) -> void:
	_location_label.text = _location_copy(
		str(model.get("location_id", ""))
	)
	_refresh_actor_visibility()
	_refresh_toolbar()


func _on_navigation_requested(
	_target: String, _context: Dictionary
) -> void:
	_request_autosave()


func _on_session_location_entered(_location: Dictionary) -> void:
	_expire_toast_on_location_change()
	_request_autosave()
	_refresh_all()


func _on_session_state_changed(_snapshot: Dictionary) -> void:
	_store_modern_collected_item()
	_sync_inventory_discoveries()
	_refresh_all()
	# Dialogue choices and the opening's parent selection can change progress
	# without leaving the room. Start a checkpoint request even after the last
	# navigation autosave has settled; otherwise a reload loses those choices.
	# The debounce and VM-wait guard retain only the latest stable checkpoint.
	_request_autosave()


func _store_modern_collected_item() -> void:
	if presentation_edition != "modern" or session == null or session.vm.is_waiting():
		return
	var item: String = session.canonical_inventory_id(session.state.held_item)
	if item.is_empty() or not session.state.has_event("took_" + item):
		return
	if session.state.has_inventory_item("found", item):
		return
	# PickItem first puts the recovered object in the Director cursor. Modern
	# collection finishes the original bag action so it immediately appears in
	# the suitcase; selecting a stored object still leaves it available to use.
	var definition: Dictionary = catalog.get_item(item)
	if ValueParser.legacy_name(definition.get("properties", {}).get("bag", "")) == "found":
		session.clear_held_item()
		_show_toast(("× ×•×¡×£ ×œ×ž×–×•×•×“×”: %s" if _is_hebrew() else "Added to suitcase: %s") % ModernItems.label(item, locale))
		_request_autosave()


func _on_dialogue_effect(_effect: Dictionary) -> void:
	dialogue_overlay.refresh()


func _on_interaction_completed(
	_channel: int, _double_click: bool, result: Dictionary
) -> void:
	if not bool(result.get("ok", false)):
		var reason: String = str(result.get("reason", ""))
		if reason.contains("blocking"):
			return
		_show_toast(
			"× ×¡×™ ×ž×©×”×• ××—×¨" if _is_hebrew() else "Try something else"
		)


func _on_effect_routed(effect: Dictionary) -> void:
	var kind: String = str(effect.get("kind", ""))
	var payload: Dictionary = _payload(effect)
	match kind:
		"item_zoom_opened":
			_show_item_zoom(str(payload.get("item", "")), 0)
		"channel_member_changed":
			_refresh_actor_textures()
		"mell_open_requested":
			if presentation_edition == "modern":
				_reset_modern_mell_speech()
				# fixes-87 round 2: her call shows over play, not under a suitcase
				# or close-up left open (her phone is at canvas z 210).
				_close_play_panels_for_story()
			_mell_portrait.visible = true
			_update_original_mell()
		"mell_close_requested":
			if presentation_edition == "modern": _reset_modern_mell_speech()
			_mell_close_effect_ids[int(effect.get("id", 0))] = true


func _on_unhandled_blocking_effect(effect: Dictionary) -> void:
	var effect_id: int = int(effect.get("id", 0))
	var kind: String = str(effect.get("kind", ""))
	var payload: Dictionary = _payload(effect)
	match kind:
		"mell_open_requested":
			_mell_portrait.visible = true
			_start_original_mell_fade(1)
			_consume_transition_audio(effect, "Mellin")
		"mell_close_requested":
			_mell_close_effect_ids[effect_id] = true
			_start_original_mell_fade(-1)
			_consume_transition_audio(effect, "Mellout")
		"panel_blink_requested":
			_blink_toolbar(effect_id, int(payload.get("channel", 0)))
		"full_zoom_requested":
			_show_full_zoom(payload.get("screen"), effect_id)
		"activity_requested":
			# The minigame signal starts and eventually completes this blocker.
			pass
		"final_sequence_requested":
			# The ending host owns this blocker until the player closes it.
			pass
		"location_transition_requested", "new_game_requested":
			presenter.complete_blocking_effect(
				effect_id, {"host": "JuliaFullAdventureView"}
			)
		_:
			presenter.complete_blocking_effect(
				effect_id,
				{
					"host": "JuliaFullAdventureView",
					"degraded": true,
					"reason": "presentation effect has no dedicated view",
				}
			)


func _on_minigame_requested(effect: Dictionary) -> void:
	if _active_activity_effect_id != 0:
		return
	var payload: Dictionary = _payload(effect)
	_active_activity_effect_id = int(effect.get("id", 0))
	# fixes-87 round 2: nothing left open stays under the minigame, and
	# Legacy's toolbar under it takes none of its clicks.
	_close_play_panels_for_story()
	_sync_original_toolbar_pointer()
	effect_host.stop_all(false)
	minigame_view.prefer_original_audio = presentation_edition == "legacy"
	var result: Dictionary = await minigame_view.present(
		str(payload.get("activity", "")),
		{
			"seed": int(
				session.state.effect_log.size() * 7919
				+ session.state.story * 101
				+ session.state.part
			),
		}
	)
	if not bool(result.get("ok", false)):
		var effect_id: int = _active_activity_effect_id
		_active_activity_effect_id = 0
		presenter.complete_blocking_effect(
			effect_id,
			{
				"solved": false,
				"degraded": true,
				"reason": result.get("error", "activity could not start"),
			}
		)
		return
	minigame_view.visible = true


func _on_minigame_finished(result: Dictionary) -> void:
	_activity_finished_frame = Engine.get_process_frames()
	if _active_activity_effect_id == 0:
		minigame_view.visible = false
		return
	var effect_id: int = _active_activity_effect_id
	_active_activity_effect_id = 0
	minigame_view.visible = false
	_sync_original_toolbar_pointer()
	presenter.complete_blocking_effect(effect_id, result)
	if (
		session != null
		and not session.state.music.is_empty()
	):
		effect_host.play_music(
			session.state.music, {"source": "activity_return"}
		)
	_request_autosave()


func _on_minigame_audio_requested(
	resolutions: Array[Dictionary]
) -> void:
	# The activity owns its sequential narration and waits for the final line.
	# Replaying the same signal here would overlap two copies of every voice.
	if minigame_view.play_audio_internally:
		return
	for resolution: Dictionary in resolutions:
		var name: String = str(resolution.get("name", ""))
		if name.is_empty():
			continue
		effect_host.consume_effect(
			{
				"id": 0,
				"kind": "sound_requested",
				"blocking": false,
				"status": "pending",
				"payload": {
					"asset": name,
					"play_type": "ppt",
					"wait": false,
				},
			}
		)


func _on_ending_requested(effect: Dictionary) -> void:
	_ending_effect_id = int(effect.get("id", 0))
	var payload: Dictionary = _payload(effect)
	var ending: int = int(str(payload.get("ending", "1")))
	# fixes-87 round 2: nothing left open stays under the ending (Legacy's
	# original zoom reached canvas z 680, over the ending's 520 to 553).
	_close_play_panels_for_story()
	effect_host.stop_all(false)
	dialogue_overlay.visible = false
	_mell_portrait.visible = false
	ending_sequence.prefer_original_audio = presentation_edition == "legacy"
	ending_sequence.presentation_edition = presentation_edition
	if not ending_sequence.configure(catalog.asset_index):
		push_error("Original ending score or media index did not load")
		return
	ending_sequence.play(ending, session.state.story)
	save_slot(SaveStoreScript.AUTOSAVE_SLOT_ID)

func _on_media_started(
	effect_id: int,
	media_kind: String,
	asset_name: String,
	path: String
) -> void:
	if media_kind == "voice":
		if presentation_edition == "modern":
			_sync_modern_actor_speech(effect_host.active_voice_snapshot())
			_reset_modern_mell_speech()
			# audio_requested is dispatched before effect_routed. Identify the
			# original command in the VM log, not the phone visibility or name.
			if session != null and session.state.mell_open and _is_mell_speech_effect(effect_id):
				_mell_voice_effect_id = effect_id
				_mell_voice_path = path
				_mell_portrait.visible = true
				_sync_modern_mell_speech()
				# A voice can start after this frame's portrait update. Commit
				# its sampled mouth immediately instead of showing a stale zero.
				ModernCharacterArt.advance_mell_performance(_mell_portrait, 0.0, _mell_mouth_level, _mell_pose_clock, _mell_mouth_state, _modern_mell_voice_snapshot())
		elif session != null and session.state.mell_open:
			_mell_speaking = true
			_mell_portrait.visible = true
	if media_kind == "animation":
		var folded: String = asset_name.to_lower()
		if presentation_edition == "modern":
			presenter.begin_modern_actor_animation(effect_id, folded)
			if _modern_cafe != null:
				_modern_cafe.sync_scene(current_location_id(),session)
				var source_animation:Dictionary=effect_host.get("_active_animation")
				var source_duration:float=effect_host.active_animation_duration()
				_modern_cafe.begin(effect_id,folded,source_duration,source_animation.get("effect",{}).get("payload",{}))
			if _modern_lab != null and current_location_id() == "lab2":
				_modern_lab.sync_scene(current_location_id(),session.state,_is_hebrew())
				_modern_lab.begin(effect_id,folded)
			if _modern_paper != null and current_location_id() in ["paper","papern"]:
				_modern_paper.sync_scene(current_location_id(),session.state)
				_modern_paper.begin(effect_id,folded)
			if _modern_photo != null and current_location_id() in ["photo","photos"]:
				_modern_photo.sync_scene(current_location_id(),session.state,session)
				_modern_photo.begin(effect_id,folded)
			if _modern_finale != null and current_location_id() in ["end1","end2"]:
				_modern_finale.sync_scene(current_location_id(),session.state)
				_modern_finale.begin(effect_id,folded)
			if _modern_street1 != null and current_location_id() == "street1": _modern_street1.begin(effect_id,folded)
			if _modern_cloth_ambient != null:
				_modern_cloth_ambient.sync_scene(current_location_id())
				_modern_cloth_ambient.begin(effect_id, folded)
			if _modern_street3 != null and current_location_id() == "street3": _modern_street3.begin(effect_id,folded)
			if _modern_street_travel != null and current_location_id() in ["street4","street11"]:
				_modern_street_travel.sync_scene(current_location_id(),presenter.call("_is_scene_channel_visible",11))
				_modern_street_travel.begin(effect_id,folded)
			if _modern_street6 != null and current_location_id() == "street6": _modern_street6.begin(effect_id,folded)
			if _modern_street12 != null and current_location_id() == "street12": _modern_street12.begin(effect_id,folded)
		if presentation_edition == "modern" and "s5_anm1" in folded:
			_modern_sign_effect = effect_id
			_modern_sign_clock = 0.0
			_modern_sign.visible = true
		if (
			"boy" in folded
			or "dy" in folded
			or "np01" in folded
		):
			_character_animation_active = true
			_refresh_actor_visibility()


func _on_media_finished(
	effect_id: int, media_kind: String, _result: Dictionary
) -> void:
	if effect_id == _modern_sign_effect and _modern_sign != null:
		_modern_sign_effect = 0
		_modern_sign.visible = false
	if _modern_street1 != null: _modern_street1.finish(effect_id)
	if _modern_cafe != null: _modern_cafe.finish(effect_id, str(_result.get("reason", "")) == "stopped")
	if _modern_lab != null: _modern_lab.finish(effect_id)
	if _modern_paper != null: _modern_paper.finish(effect_id)
	if _modern_photo != null: _modern_photo.finish(effect_id, str(_result.get("reason", "")) == "stopped")
	if _modern_finale != null: _modern_finale.finish(effect_id)
	if _modern_cloth_ambient != null: _modern_cloth_ambient.finish(effect_id, str(_result.get("reason", "")) == "stopped")
	if _modern_street3 != null: _modern_street3.finish(effect_id, str(_result.get("reason", "")) == "stopped")
	if _modern_street_travel != null: _modern_street_travel.finish(effect_id)
	if _modern_street6 != null: _modern_street6.finish(effect_id, str(_result.get("reason", "")) == "stopped")
	if _modern_street12 != null: _modern_street12.finish(effect_id)
	if media_kind == "voice":
		if presentation_edition == "modern":
			if effect_id == _mell_voice_effect_id: _reset_modern_mell_speech()
		else:
			_mell_speaking = false
			_set_mell_frame(0)
	elif media_kind == "animation":
		if presentation_edition == "modern": presenter.end_modern_actor_animation(effect_id)
		_character_animation_active = false
		_refresh_actor_visibility()


func _on_effect_completed(
	effect_id: int, _result: Dictionary
) -> void:
	if _mell_close_effect_ids.has(effect_id):
		if presentation_edition == "modern": _reset_modern_mell_speech()
		_mell_close_effect_ids.erase(effect_id)
		_mell_portrait.visible = false
	if _autosave_pending and session != null and not session.vm.is_waiting():
		_request_autosave()


func _is_mell_speech_effect(effect_id: int) -> bool:
	if effect_id <= 0 or session == null: return false
	for index: int in range(session.state.effect_log.size() - 1, -1, -1):
		var effect: Dictionary = session.state.effect_log[index]
		if int(effect.get("id", 0)) == effect_id:
			return str(effect.get("kind", "")) == "mell_speech_requested"
	return false


func _reset_modern_mell_speech() -> void:
	_mell_voice_effect_id = 0
	_mell_voice_path = ""
	_mell_voice_seconds = 0.0
	_mell_mouth_level = 0.0
	_mell_mouth_state = {}
	_mell_speaking = false
	if is_instance_valid(_mell_portrait):
		ModernCharacterArt.advance_mell_performance(_mell_portrait, 0.0, 0.0, _mell_pose_clock)


func _modern_mell_voice_snapshot() -> Dictionary:
	var paused: bool = not effect_host.is_processing()
	if session == null or not session.state.mell_open or _mell_voice_effect_id <= 0:
		return {"paused":paused}
	var voice: Dictionary = effect_host.active_voice_snapshot()
	var owned: bool = int(voice.get("effect_id", 0)) == _mell_voice_effect_id and str(voice.get("path", "")) == _mell_voice_path
	return {"owned":owned,"playing":owned and bool(voice.get("playing",false)),
		"paused":paused or bool(voice.get("paused",false)),"path":_mell_voice_path,
		"seconds":_mell_voice_seconds,"effect_id":_mell_voice_effect_id}


func _sync_modern_mell_speech() -> void:
	_mell_speaking = false
	_mell_mouth_level = 0.0
	_mell_mouth_state = {}
	if session == null or not session.state.mell_open or _mell_voice_effect_id <= 0: return
	var voice: Dictionary = effect_host.active_voice_snapshot()
	if int(voice.get("effect_id", 0)) != _mell_voice_effect_id or str(voice.get("path", "")) != _mell_voice_path:
		_reset_modern_mell_speech()
		return
	if not bool(voice.get("playing", false)): return
	_mell_speaking = true
	_mell_voice_seconds = float(voice.get("seconds", 0.0))
	_mell_mouth_level = ModernMellVoice.mouth_level(_mell_voice_path, _mell_voice_seconds)
	_mell_mouth_state = ModernMellVoice.mouth_state(_mell_voice_path, _mell_voice_seconds)


func _consume_transition_audio(
	effect: Dictionary, asset_name: String
) -> void:
	var adapted: Dictionary = effect.duplicate(true)
	adapted["kind"] = "sound_requested"
	adapted["payload"] = {
		"asset": asset_name,
		"play_type": "ppt",
		"wait": true,
	}
	effect_host.consume_effect(adapted)


func _blink_toolbar(effect_id: int, _channel: int) -> void:
	if original_panels != null:
		original_panels.blink_channel(_channel)
		await get_tree().create_timer(40.0 / 60.0).timeout
		presenter.complete_blocking_effect(effect_id, {"host": "OriginalGamePanels", "blinked": true})
		return
	var original: Color = Color.WHITE
	for index: int in range(4):
		_casebook_button.modulate = (
			ThemeFactory.MUSTARD if index % 2 == 0 else original
		)
		await get_tree().create_timer(0.11).timeout
	_casebook_button.modulate = original
	presenter.complete_blocking_effect(
		effect_id, {"host": "JuliaFullAdventureView", "blinked": true}
	)


func _show_full_zoom(screen_value: Variant, effect_id: int) -> void:
	var candidates: Array[String] = []
	_collect_names(screen_value, candidates)
	var texture: Texture2D
	if _original_zoom == null and not candidates.is_empty():
		texture = ModernItems.scene_zoom(candidates[0])
	if texture == null and _original_zoom != null:
		texture = _first_texture(candidates)
	if texture == null:
		presenter.complete_blocking_effect(
			effect_id,
			{
				"host": "JuliaFullAdventureView",
				"degraded": true,
				"reason": "zoom image missing",
			}
		)
		return
	_zoom_effect_id = effect_id
	_zoom_item_id = ""
	_zoom_item_action.visible = false
	_zoom_generation += 1
	var generation: int = _zoom_generation
	if _original_zoom != null:
		_original_zoom.show_full(texture)
	else:
		_zoom_texture.texture = texture
		_zoom_title.text = "×ž×‘×˜ ×ž×§×¨×•×‘" if _is_hebrew() else "A closer look"
		_zoom_overlay.visible = true
	# Original full-zoom exit behavior: mouse-down or the 180-tick hold.
	await get_tree().create_timer(3.0).timeout
	if generation == _zoom_generation:
		_close_zoom()


func _show_item_zoom(item_name: String, effect_id: int) -> void:
	_clear_localized_document()
	_zoom_overlay.hide()
	if _original_zoom != null: _original_zoom.hide()
	if catalog == null:
		return
	var definition: Dictionary = catalog.get_item(item_name)
	_zoom_item_id = item_name
	_zoom_item_action.visible = true
	var owned: bool = session.state.has_inventory_item("found", item_name) or session.state.has_inventory_item("julia", item_name)
	_zoom_item_action.text = ("×”×©×ª×ž×©×™" if owned else "××¡×¤×™") if _is_hebrew() else ("Use item" if owned else "Pick up")
	_zoom_generation += 1
	if _original_zoom != null and JuliaGameLocalization.current == "he":
		_zoom_effect_id = effect_id
		if not _original_zoom.show_item(catalog.asset_index, definition, session.state.story):
			_close_missing_item_zoom(effect_id)
		return
	if _original_zoom != null: _original_zoom.hide()
	var candidates: Array[String] = []
	var zoom: Variant = definition.get("properties", {}).get("zoom")
	if zoom is Array and not zoom.is_empty():
		zoom = zoom[clampi(session.state.story - 1, 0, zoom.size() - 1)]
	_collect_names(zoom, candidates)
	var texture: Texture2D = ModernItems.object_zoom(item_name, candidates[0] if not candidates.is_empty() else "", session.state.story)
	if texture == null:
		_close_missing_item_zoom(effect_id)
		return
	_zoom_effect_id = effect_id
	_zoom_texture.texture = texture
	if JuliaGameLocalization.current != "he":
		var document_key: String = ModernItems.evidence_key(item_name, candidates[0] if not candidates.is_empty() else "", session.state.story)
		if not document_key.is_empty():
			var document: Dictionary = ModernItems.evidence_definitions().get(document_key, {})
			if not document.is_empty():
				_localized_document_viewport = SubViewport.new()
				_localized_document_viewport.transparent_bg = true
				var dimensions: Array = document.get("size", [1200, 900])
				_localized_document_viewport.size = Vector2i(dimensions[0], dimensions[1])
				_localized_document_viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
				add_child(_localized_document_viewport)
				var page = preload("res://src/presentation/modern_evidence_document.gd").new()
				_localized_document_viewport.add_child(page)
				page.configure(document)
				_zoom_texture.texture = _localized_document_viewport.get_texture()
	_zoom_title.text = ModernItems.label(item_name, locale)
	_zoom_overlay.visible = true


func _close_missing_item_zoom(effect_id: int) -> void:
	_zoom_effect_id = 0
	_close_zoom()
	if effect_id > 0:
		presenter.complete_blocking_effect(effect_id, {"degraded": true, "reason": "item image missing"})


func _close_zoom() -> void:
	_clear_localized_document()
	_zoom_generation += 1
	_zoom_item_id = ""
	if _original_zoom != null:
		_original_zoom.visible = false
	if session != null:
		session.state.zoomed_item = ""
	_zoom_overlay.visible = false
	_zoom_texture.texture = null
	if _zoom_effect_id > 0:
		var effect_id: int = _zoom_effect_id
		_zoom_effect_id = 0
		presenter.complete_blocking_effect(
			effect_id, {"host": "JuliaFullAdventureView", "closed": true}
		)


func _clear_localized_document() -> void:
	if is_instance_valid(_localized_document_viewport):
		_localized_document_viewport.queue_free()
	_localized_document_viewport = null


func _activate_zoom_item() -> void:
	if session == null or _zoom_item_id.is_empty():
		return
	session.state.zoomed_item = _zoom_item_id
	var result: Dictionary = session.activate_zoomed_item()
	_close_zoom()
	if presentation_edition == "modern" and bool(result.get("ok", false)):
		_show_inventory_overlay(false)


func _finish_ending() -> void:
	ending_sequence.stop()
	if _ending_effect_id > 0:
		var effect_id: int = _ending_effect_id
		_ending_effect_id = 0
		presenter.complete_blocking_effect(
			effect_id, {"host": "JuliaFullAdventureView"}
		)
	return_to_menu_requested.emit()


func _refresh_all() -> void:
	if session == null:
		return
	_refresh_toolbar()
	_refresh_actor_textures()
	_refresh_actor_visibility()
	dialogue_overlay.refresh()
	if WebLayout.enabled(): _layout_web_controls()
	if _inventory_overlay.visible:
		_rebuild_inventory()


func _refresh_toolbar() -> void:
	if session == null:
		return
	_refresh_added_tool_copy()
	_settings_button.text = "×”×’×“×¨×•×ª" if _is_hebrew() else "Settings"
	if original_panels != null:
		original_panels.refresh()
	var found_count: int = session.state.found_inventory.size()
	var julia_count: int = session.state.julia_inventory.size()
	var item_count: int = found_count + julia_count
	var unread_count: int = journal.unread_count() if journal != null else 0
	_inventory_button.text = "×—×¤×¦×™×" if _is_hebrew() else "Items"
	_inventory_button.tooltip_text = (
		"×—×¤×¦×™× (%d)" % item_count
		if _is_hebrew()
		else "Items (%d)" % item_count
	)
	_casebook_button.text = "×™×•×ž×Ÿ" if _is_hebrew() else "Journal"
	_casebook_button.tooltip_text = (
		"×¨×©×™×ž×•×ª (%d ×—×“×©×•×ª)" % unread_count
		if _is_hebrew()
		else "Journal (%d new)" % unread_count
	)
	_save_button.text = "×”×©×”×™×”" if _is_hebrew() else "Pause"
	_save_button.tooltip_text = (
		"×”×©×”×™×” ×•×©×ž×™×¨×”" if _is_hebrew() else "Pause and save"
	)
	_menu_button.text = "×ª×¤×¨×™×˜" if _is_hebrew() else "Menu"
	_fullscreen_button.text = (
		"×—×œ×•×Ÿ"
		if _is_hebrew() and _is_fullscreen()
		else (
			"×ž×¡×š ×ž×œ×"
			if _is_hebrew()
			else ("Window" if _is_fullscreen() else "Fullscreen")
		)
	)
	_location_label.text = _location_copy(session.state.location)
	_held_label.text = (
		""
		if session.state.held_item.is_empty()
		else (
			"×‘×™×“: %s" % _selected_inventory_label()
			if _is_hebrew()
			else "Using: %s" % _selected_inventory_label()
		)
	)
	_apply_locale_to_label(_location_label)
	_apply_locale_to_label(_held_label)
	for button: Button in [
		_inventory_button,
		_casebook_button,
		_save_button,
		_settings_button,
		_menu_button,
		_fullscreen_button,
	]:
		_apply_locale_to_button(button)
	_refresh_original_tool_access()


func _refresh_added_tool_copy() -> void:
	_map_button.text = "×ž×¤×”" if _is_hebrew() else "Map"
	_notes_button.text = "×¤× ×§×¡" if _is_hebrew() else "Notebook"
	_hint_button.text = "×¢×–×¨×” ×ž×ž×œ" if _is_hebrew() else "Ask Mel"
	_help_button.text = "××™×š ×œ×©×—×§" if _is_hebrew() else "How to play"
	_technical_help_button.text = "×ž×“×¨×™×š ×”×›×œ×™×" if _is_hebrew() else "Controls guide"
	for button: Button in [_map_button, _notes_button, _hint_button, _help_button, _technical_help_button]:
		_apply_locale_to_button(button)


func _refresh_actor_visibility() -> void:
	if session == null or _dylen_sprite == null:
		return
	var street5: bool = session.state.location.to_lower() == "street5"
	# The original Boy animation replaces only the face; its body stays visible.
	# Both editions follow the original prepared visibility on later visits.
	# Visibility is separate from enabled state during the first welcome.
	var source_dylen_visible: bool = _hotspot_visible(13) or _hotspot_visible(14)
	_dylen_sprite.visible = street5 and source_dylen_visible
	if _dylen_sprite is JuliaModernDylanSprite:
		(_dylen_sprite as JuliaModernDylanSprite).set_newspaper_collected(session != null and session.state.has_event("took_np"))
	_dylen_button.visible = _dylen_sprite.visible
	var dylen_channel: int = _visible_actor_channel([13, 14])
	_dylen_button.disabled = dylen_channel < 0
	_dylen_button.set_meta("legacy_channel", dylen_channel)

	var father_visible: bool = street5 and _hotspot_visible(18)
	var mother_visible: bool = street5 and _hotspot_visible(19)
	_dad_sprite.visible = father_visible
	_dad_button.visible = father_visible
	_dad_button.disabled = not _hotspot_enabled(18)
	_mam_sprite.visible = mother_visible
	_mam_button.visible = mother_visible
	_mam_button.disabled = not _hotspot_enabled(19)
	_sync_parent_portraits()
	if not session.state.mell_open and _mell_close_effect_ids.is_empty():
		_mell_portrait.visible = false
	_update_original_mell()


func _update_original_mell() -> void:
	if is_instance_valid(_modern_mell_phone) and session != null:
		_modern_mell_phone.sync(session.state.mell_close_enabled, locale)
	if not is_instance_valid(_original_mell_surface) or session == null:
		return
	if _original_mell_surface.asset_index != session.catalog.asset_index:
		_original_mell_surface.configure(session.catalog.asset_index)
	_original_mell_surface.set_channel_override(217, {"visible": session.state.mell_close_enabled})
	_original_mell_surface.present_frame(90, [215, 217])
	_original_mell_surface.visible = _mell_portrait.visible
	_original_mell_close.visible = session.state.mell_close_enabled


func _start_original_mell_fade(direction: int) -> void:
	if not is_instance_valid(_original_mell_surface):
		return
	_update_original_mell()
	_mell_fade_direction = direction
	_mell_fade_elapsed = 0.0
	_original_mell_surface.modulate.a = 0.0 if direction > 0 else 1.0


func _close_mell_help() -> void:
	if session != null and session.state.mell_close_enabled and _mell_speaking:
		# MellHelp queues its original CloseMell immediately after the voice.
		effect_host.stop_voice(true)


func _refresh_actor_textures() -> void:
	if session == null:
		return
	if presentation_edition == "modern":
		_sync_parent_portraits()
		return
	var dad_member: String = str(
		session.state.channel_members.get(18, "dad1")
	)
	var mam_member: String = str(
		session.state.channel_members.get(19, "mam1")
	)
	_dad_sprite.texture = (
		load(DAD_ACTIVE_PATH)
		if dad_member.to_lower() == "dad2"
		else load(DAD_PATH)
	)
	_mam_sprite.texture = (
		load(MAM_ACTIVE_PATH)
		if mam_member.to_lower() == "mam2"
		else load(MAM_PATH)
	)


func _sync_parent_portraits() -> void:
	if not is_instance_valid(_modern_parents) or session == null: return
	var street5: bool = session.state.location.to_lower() == "street5"
	_modern_parents.sync_channel(18, str(session.state.channel_members.get(18, "dad1")), street5 and _hotspot_visible(18))
	_modern_parents.sync_channel(19, str(session.state.channel_members.get(19, "mam1")), street5 and _hotspot_visible(19))


func _on_dylen_pressed() -> void:
	var channel: int = int(_dylen_button.get_meta("legacy_channel", -1))
	if channel >= 0:
		presenter.activate_hotspot(channel)


func _on_actor_channel_pressed(channel: int) -> void:
	presenter.activate_hotspot(channel)


func _hotspot_visible(channel: int) -> bool:
	for value: Variant in presenter.presenter_model().get("hotspots", []):
		if (
			typeof(value) == TYPE_DICTIONARY
			and int(value.get("channel", -1)) == channel
		):
			return bool(value.get("visible", false))
	return false


func _hotspot_enabled(channel: int) -> bool:
	for value: Variant in presenter.presenter_model().get("hotspots", []):
		if (
			typeof(value) == TYPE_DICTIONARY
			and int(value.get("channel", -1)) == channel
		):
			return bool(value.get("enabled", false))
	return false


func _visible_actor_channel(channels: Array[int]) -> int:
	for channel: int in channels:
		if _hotspot_visible(channel) and _hotspot_enabled(channel):
			return channel
	return -1


func _show_inventory_overlay(value: bool) -> void:
	if value:
		_close_modern_tool()
	if original_panels != null:
		if value:
			original_panels.open_page("found")
		elif original_panels.page in ["found", "julia"]:
			original_panels.close_page()
		return
	if value:
		_set_tool_dock_open(false)
		# Each opening starts with every owned object. A previous visit to
		# Julia's belongings must not hide clues collected since the case closed.
		if not _inventory_overlay.visible:
			_inventory_filter = "all"
			_inventory_scroll.scroll_vertical = 0
		# A pickup held in the original cursor is still owned when switching
		# editions. Finish that bag action before listing the modern suitcase.
		_store_modern_collected_item()
		_rebuild_inventory()
	_inventory_overlay.visible = value
	# fixes-87 round 2: during Mel's call (I is refused then; the Tools dock
	# still offers the suitcase) it holds the story, as the Pause sheet does.
	# It did not: her line ran on under it and her questions opened unseen
	# under it (canvas z 240 < 340), so the first Escape answered them instead
	# of closing the suitcase. Closing it lets her call go on.
	_set_adventure_modal("suitcase", value and _modern_mell_call_on())
	if value and _save_overlay.visible:
		# fixes-87 round 3 (review): one sheet at a time, as J, M and N close
		# both. I over the Pause sheet opened the suitcase under it (canvas z
		# 340 < 350), unusable, and the next Escape closed it, not the sheet.
		_show_save_overlay(false)
	if _inventory_open_tween != null:
		_inventory_open_tween.kill()
	if value:
		_inventory_case.modulate.a = 0.0
		_inventory_open_tween = create_tween()
		_inventory_open_tween.tween_property(_inventory_case, "modulate:a", 1.0, 0.18)


func _rebuild_inventory() -> void:
	var previous_scroll: int = _inventory_scroll.scroll_vertical
	for child: Node in _inventory_grid.get_children():
		_inventory_grid.remove_child(child)
		child.queue_free()
	if session == null:
		return
	var items: Array[String] = []
	if _inventory_filter in ["all", "found"]:
		for value: Variant in session.state.found_inventory.values():
			items.append(str(value))
	if _inventory_filter in ["all", "julia"]:
		for value: Variant in session.state.julia_inventory.values():
			items.append(str(value))
	items.sort_custom(
		func(left: String, right: String) -> bool:
			return left.naturalnocasecmp_to(right) < 0
	)
	for item_name: String in items:
		_inventory_grid.add_child(_make_inventory_item_button(item_name))
	if items.is_empty():
		var empty := Label.new()
		empty.text = "×¢×“×™×™×Ÿ ××™×Ÿ ×—×¤×¦×™× ×‘×ª×™×§ ×”×–×”" if _is_hebrew() else "No items in this bag yet"
		empty.custom_minimum_size = Vector2(750, 90)
		empty.add_theme_color_override("font_color", Color("ffe6af"))
		_apply_locale_to_label(empty)
		_inventory_grid.add_child(empty)
	_inventory_title.text = "×—×¤×¦×™×" if _is_hebrew() else "Items"
	_inventory_close_button.text = "×¡×’×™×¨×”" if _is_hebrew() else "Close"
	_clear_item_button.text = "×™×“×™×™× ×¤× ×•×™×•×ª" if _is_hebrew() else "Empty hands"
	_inventory_look_button.text = "×ž×‘×˜ ×ž×§×¨×•×‘" if _is_hebrew() else "Look"
	_inventory_use_button.text = "×”×©×ª×ž×©×™" if _is_hebrew() else "Use"
	var copy: Dictionary = {"all": "×”×›×•×œ", "julia": "×©×œ ×’×³×•×œ×™×”", "found": "×©× ××¡×¤×•"} if _is_hebrew() else {"all": "All", "julia": "Juliaâ€™s things", "found": "Collected"}
	for key: String in _inventory_filters:
		var filter: Button = _inventory_filters[key]
		filter.text = copy[key]
		filter.set_pressed_no_signal(key == _inventory_filter)
		_apply_locale_to_button(filter)
		filter.layout_direction = Control.LAYOUT_DIRECTION_LTR
	for label: Label in [_inventory_title, _inventory_status]:
		_apply_locale_to_label(label)
	for button: Button in [
		_inventory_close_button, _clear_item_button, _inventory_look_button, _inventory_use_button
	]:
		_apply_locale_to_button(button)
		button.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_refresh_inventory_selection()
	_inventory_scroll.set_deferred("scroll_vertical", previous_scroll)
	_inventory_case.refresh_layout()


func _set_inventory_filter(value: String) -> void:
	_inventory_filter = value
	_inventory_scroll.scroll_vertical = 0
	_rebuild_inventory()


func _make_inventory_item_button(item_name: String) -> Button:
	var definition: Dictionary = catalog.get_item(item_name)
	var properties: Dictionary = definition.get("properties", {})
	var candidates: Array[String] = []
	var zoom: Variant = properties.get("zoom", properties.get("small"))
	if zoom is Array and not zoom.is_empty():
		zoom = zoom[clampi(session.state.story - 1, 0, zoom.size() - 1)]
	_collect_names(zoom, candidates)
	var texture: Texture2D = ModernItems.evidence_texture(item_name, candidates[0] if not candidates.is_empty() else "", session.state.story)
	if texture == null:
		texture = ModernItems.icon(item_name)
	var button := Button.new()
	button.name = "InventoryItem_" + item_name
	button.set_meta("item_id", item_name)
	button.layout_direction = Control.LAYOUT_DIRECTION_LTR
	button.custom_minimum_size = Vector2(150.0, 136.0)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.text = ModernItems.label(item_name, locale)
	button.tooltip_text = button.text
	button.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	button.add_theme_font_size_override("font_size", 18)
	button.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	var picture := TextureRect.new()
	picture.name = "ItemPicture"
	picture.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	picture.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	picture.mouse_filter = Control.MOUSE_FILTER_IGNORE
	picture.layout_direction = Control.LAYOUT_DIRECTION_LTR
	picture.texture = texture
	var icon_source: Texture2D = texture.atlas if texture is AtlasTexture else texture
	# Evidence pages (assets/generated/evidence, up to 1600 px, imported with
	# mipmaps) are drawn here at about 150 x 74 px: sample their mip chain.
	if icon_source != null and (
		icon_source.resource_path.begins_with("res://rooms_shared/")
		or icon_source.resource_path.begins_with("res://assets/generated/evidence/")
	):
		picture.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	button.add_child(picture)
	picture.anchor_right = 1.0
	picture.offset_left = 12
	picture.offset_right = -12
	picture.offset_top = 2
	picture.offset_bottom = 76
	var tag := InventoryTag.new()
	tag.name = "LuggageTag"
	tag.layout_direction = Control.LAYOUT_DIRECTION_LTR
	button.add_child(tag)
	tag.anchor_top = 1.0
	tag.anchor_right = 1.0
	tag.anchor_bottom = 1.0
	tag.offset_left = 3
	tag.offset_right = -3
	tag.offset_top = -55
	tag.offset_bottom = -5
	var paper := ThemeFactory.make_box(Color.TRANSPARENT, Color.TRANSPARENT, 0, 7, 17, 4)
	var selected := ThemeFactory.make_box(Color(0.95, 0.79, 0.39, 0.12), Color("e3bd62"), 2, 7, 17, 4)
	var focus := ThemeFactory.make_box(Color.TRANSPARENT, Color("fff0ba"), 2, 7, 17, 4)
	for style: StyleBoxFlat in [paper, selected, focus]:
		style.content_margin_top = 78
	for state: String in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
		button.add_theme_color_override(state, Color("493620"))
	button.add_theme_stylebox_override("normal", paper)
	button.add_theme_stylebox_override("hover", selected)
	button.add_theme_stylebox_override("pressed", selected)
	button.add_theme_stylebox_override("focus", focus)
	button.set_meta("paper_style", paper)
	button.set_meta("selected_style", selected)
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	button.pressed.connect(_select_inventory_item.bind(item_name))
	button.gui_input.connect(
		func(event: InputEvent) -> void:
			if (
				event is InputEventMouseButton
				and event.pressed
				and event.button_index == MOUSE_BUTTON_LEFT
				and event.double_click
			):
				_select_inventory_item(item_name)
				_inspect_selected_inventory_item()
	)
	_apply_locale_to_button(button)
	button.layout_direction = Control.LAYOUT_DIRECTION_LTR
	return button


func _select_inventory_item(item_name: String) -> void:
	var result: Dictionary = session.select_inventory_item(item_name)
	if bool(result.get("ok", false)):
		_selected_inventory_item = item_name
		_refresh_toolbar()
		_refresh_inventory_selection()


func _refresh_inventory_selection() -> void:
	if session == null:
		return
	var held: String = session.canonical_inventory_id(session.state.held_item)
	var owned: bool = session.state.has_inventory_item("found", held) or session.state.has_inventory_item("julia", held)
	_selected_inventory_item = held if owned else ""
	_inventory_look_button.disabled = not owned
	_inventory_use_button.disabled = not owned
	_inventory_status.text = ModernItems.label(held, locale) if owned else ("×‘×—×¨×™ ×—×¤×¥" if _is_hebrew() else "Choose an item")
	for child: Node in _inventory_grid.get_children():
		if child is Button:
			var selected: bool = str(child.get_meta("item_id", "")).to_lower() == _selected_inventory_item.to_lower()
			child.add_theme_stylebox_override("normal", child.get_meta("selected_style" if selected else "paper_style"))


func _inspect_selected_inventory_item() -> void:
	if session == null or _selected_inventory_item.is_empty():
		return
	if session.vm.is_waiting():
		# fixes-87 round 3 (review): the story waits on a line (the suitcase is
		# open over it; during Mel's call it holds it). The VM's ZoomItem
		# section was only queued behind the line: once the line ended it
		# opened this close-up again by itself, over whatever came next (her
		# questions). Look shows the close-up now, as before, without queueing.
		if (
			session.state.has_inventory_item("found", _selected_inventory_item)
			or session.state.has_inventory_item("julia", _selected_inventory_item)
		):
			_show_item_zoom(_selected_inventory_item, 0)
		return
	var result: Dictionary = session.inspect_inventory_item(_selected_inventory_item)
	if bool(result.get("ok", false)):
		_show_item_zoom(_selected_inventory_item, 0)


func _use_selected_inventory_item() -> void:
	if session == null or _selected_inventory_item.is_empty():
		return
	_show_inventory_overlay(false)


func _clear_held_item() -> void:
	if session == null:
		return
	session.clear_held_item()
	_selected_inventory_item = ""
	_refresh_toolbar()
	_rebuild_inventory()


func _sync_inventory_discoveries() -> void:
	if session == null or journal == null:
		return
	for value: Variant in session.state.found_inventory.values():
		var item_name: String = str(value)
		var key: String = item_name.to_lower()
		if _seen_found_items.has(key):
			continue
		_seen_found_items[key] = true
		journal.discover(
			"found_%s" % key,
			{
				"title": {
					"he": ModernItems.label(item_name, "he"),
					"en": ModernItems.label(item_name, "en"),
				},
				"body": {
					"he": (
						"×”×¤×¨×™×˜ × ××¡×£ ×‘×ž×”×œ×š ×”×—×§×™×¨×”. ××¤×©×¨ ×œ×¤×ª×•×— ××•×ª×• "
						+ "×‘×ª×™×§ ×”×—×¤×¦×™× ×•×œ× ×¡×•×ª ×œ×”×©×ª×ž×© ×‘×• ×¢×œ ×× ×©×™× ×•×ž×§×•×ž×•×ª."
					),
					"en": (
						"This item was collected during the investigation. "
						+ "Open it in the item case or try it on people and places."
					),
				},
				"location": {
					"he": _location_copy(session.state.location, "he"),
					"en": _location_copy(session.state.location, "en"),
				},
				"source": {
					"he": "× ×ž×¦× ×‘×–×™×¨×”",
					"en": "Found in the scene",
				},
			},
			session.state.location,
			"scene"
		)
	_refresh_toolbar()


func _show_save_overlay(value: bool) -> void:
	if value:
		_close_modern_tool()
	if original_panels != null:
		if value:
			original_panels.open_page("save")
		elif original_panels.page == "save":
			original_panels.close_page()
		return
	if value:
		_set_tool_dock_open(false)
		_rebuild_save_slots()
	_save_overlay.visible = value
	_set_adventure_modal("save", value)
	if value and _inventory_overlay.visible:
		# fixes-87 round 3 (review): one sheet at a time, as J, M and N close
		# both. S over the suitcase left it open under the sheet (canvas z 340
		# < 350), and the first Escape closed that covered suitcase. Closed
		# after the sheet holds play, so a hold (Mel's call) never lapses.
		_show_inventory_overlay(false)


func _rebuild_save_slots() -> void:
	for child: Node in _save_slot_stack.get_children():
		_save_slot_stack.remove_child(child)
		child.queue_free()
	_save_title.text = (
		"×©×ž×™×¨×” ×•×”×ž×©×š" if _is_hebrew() else "Save & continue"
	)
	_save_close_button.text = "×¡×’×™×¨×”" if _is_hebrew() else "Close"
	_save_menu_button.text = (
		"×©×ž×™×¨×” ××•×˜×•×ž×˜×™×ª ×•×—×–×¨×” ×œ×ª×¤×¨×™×˜"
		if _is_hebrew()
		else "Autosave and return to menu"
	)
	_apply_locale_to_label(_save_title)
	_apply_locale_to_button(_save_close_button)
	_apply_locale_to_button(_save_menu_button)
	for summary: Dictionary in save_store.list_slot_summaries():
		_save_slot_stack.add_child(_make_save_slot_row(summary))


func _make_save_slot_row(summary: Dictionary) -> Control:
	var panel := PanelContainer.new()
	panel.layout_direction = Control.LAYOUT_DIRECTION_LTR
	panel.custom_minimum_size.y = 88.0
	panel.add_theme_stylebox_override(
		"panel",
		ThemeFactory.make_box(
			Color(ThemeFactory.PAPER, 0.58),
			Color(ThemeFactory.INK, 0.24),
			1,
			2,
			14.0,
			9.0
		)
	)
	var row: BoxContainer = VBoxContainer.new() if WebLayout.enabled() else HBoxContainer.new()
	row.layout_direction = Control.LAYOUT_DIRECTION_LTR
	row.add_theme_constant_override("separation", 10)
	panel.add_child(row)
	var copy := VBoxContainer.new()
	copy.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(copy)
	var slot_id: String = str(summary.get("slot_id", ""))
	panel.name = "SaveSlot_" + slot_id
	var title := Label.new()
	title.text = _slot_title(slot_id)
	title.add_theme_font_size_override("font_size", 19)
	title.add_theme_color_override("font_color", ThemeFactory.INK)
	copy.add_child(title)
	var detail := Label.new()
	detail.text = _slot_detail(summary)
	detail.add_theme_font_size_override("font_size", 16 if WebLayout.enabled() else 13)
	detail.add_theme_color_override(
		"font_color", ThemeFactory.MUTED
	)
	copy.add_child(detail)
	_apply_locale_to_label(title)
	_apply_locale_to_label(detail)
	if WebLayout.enabled():
		title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		detail.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	var actions: BoxContainer = row
	if WebLayout.enabled():
		actions = HBoxContainer.new()
		actions.add_theme_constant_override("separation", 10)
		row.add_child(actions)

	if slot_id != SaveStoreScript.AUTOSAVE_SLOT_ID:
		var save_button := _make_small_button()
		save_button.name = "Save_" + slot_id
		save_button.text = "×©×ž×™×¨×”" if _is_hebrew() else "Save"
		if _pending_web_saves.has(slot_id):
			save_button.disabled = true
		save_button.pressed.connect(save_slot.bind(slot_id))
		actions.add_child(save_button)
		if WebLayout.enabled(): save_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_apply_locale_to_button(save_button)
	if str(summary.get("state", "empty")) in ["ready", "recoverable"]:
		var load_button := _make_small_button()
		load_button.name = "Load_" + slot_id
		load_button.text = "×˜×¢×™× ×”" if _is_hebrew() else "Load"
		load_button.pressed.connect(load_slot.bind(slot_id))
		actions.add_child(load_button)
		if WebLayout.enabled(): load_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_apply_locale_to_button(load_button)
	return panel


func _slot_title(slot_id: String) -> String:
	if slot_id == SaveStoreScript.AUTOSAVE_SLOT_ID:
		return "×©×ž×™×¨×” ××•×˜×•×ž×˜×™×ª" if _is_hebrew() else "Autosave"
	var number: String = slot_id.trim_prefix("manual_")
	return (
		"×©×ž×™×¨×” %s" % number
		if _is_hebrew()
		else "Save %s" % number
	)


func _slot_detail(summary: Dictionary) -> String:
	var state: String = str(summary.get("state", "empty"))
	if state == "empty":
		return "×¤× ×•×™" if _is_hebrew() else "Empty"
	if state == "corrupt":
		return (
			"×”×©×ž×™×¨×” ××™× ×” ×§×¨×™××”"
			if _is_hebrew()
			else "This save cannot be read"
		)
	var chapter: String = str(summary.get("chapter_label", ""))
	var seconds: int = int(summary.get("playtime_seconds", 0.0))
	var time_text: String = "%02d:%02d" % [seconds / 3600, (seconds / 60) % 60]
	return "%s  Â·  %s" % [chapter, time_text]


func _request_autosave() -> void:
	if session == null:
		return
	_autosave_pending = true
	_autosave_generation += 1
	var generation: int = _autosave_generation
	await get_tree().create_timer(AUTOSAVE_DELAY_SECONDS).timeout
	if (
		generation != _autosave_generation
		or session == null
		or session.vm.is_waiting()
	):
		return
	_autosave_pending = false
	save_slot(SaveStoreScript.AUTOSAVE_SLOT_ID)


func _request_casebook() -> void:
	if original_panels != null:
		original_panels.open_page("notes")
		return
	# Hiding the dock, the suitcase or the Save sheet drops the focus of the
	# control in it (the Journal button, an item, a slot). Hand it to the
	# Tools button first, so the casebook gives the focus back there. Keep it
	# hidden when it came from a click or tap: a shown focus drew Tools as
	# focused after the casebook closed.
	var focused: Control = get_viewport().gui_get_focus_owner()
	if focused != null and _dock_toggle.is_visible_in_tree():
		for sheet: Control in [_tool_dock, _inventory_overlay, _save_overlay]:
			if sheet.is_ancestor_of(focused):
				_dock_toggle.grab_focus(not focused.has_focus(true))
				break
	_close_modern_tool()
	_set_tool_dock_open(false)
	_show_inventory_overlay(false)
	_show_save_overlay(false)
	casebook_requested.emit()


func _on_menu_pressed() -> void:
	_show_save_overlay(true)
	_show_toast(
		"×©×ž×¨×™ ×œ×¤× ×™ ×”×—×–×¨×” ×œ×ª×¤×¨×™×˜"
		if _is_hebrew()
		else "Save before returning to the menu"
	)


func request_return_to_menu() -> void:
	if session != null:
		var checkpoint: Dictionary = save_before_background()
		if not bool(checkpoint.get("ok", false)):
			return
	if effect_host != null:
		effect_host.stop_all(false)
	return_to_menu_requested.emit()


func handle_escape() -> bool:
	if Engine.get_process_frames() == _activity_finished_frame and not minigame_view.visible:
		# fixes-87: this Escape has just left a minigame. In the Modern lab and
		# photo it is their Leave button's shortcut; the button goes with the
		# minigame, so the press was never marked handled and reached the
		# shell too, which opened the Pause sheet: one Escape left the
		# minigame and paused the game.
		return true
	if has_modern_tool_open():
		_close_modern_tool()
		return true
	if is_instance_valid(ending_sequence) and ending_sequence.visible:
		ending_sequence.handle_back()
		return true
	if _zoom_overlay.visible or (_original_zoom != null and _original_zoom.visible):
		_close_zoom()
		return true
	# fixes-87 round 3 (review): the sheet drawn on top first. The Pause sheet
	# (canvas z 350) lies over the suitcase (340); with both open the first
	# Escape closed the covered suitcase and seemed to do nothing. (They no
	# longer open together: _show_save_overlay, _show_inventory_overlay.)
	if _save_overlay.visible:
		_show_save_overlay(false)
		return true
	if _inventory_overlay.visible:
		_show_inventory_overlay(false)
		return true
	if minigame_view.visible:
		minigame_view.cancel_activity()
		return true
	if original_panels != null and original_panels.handle_back():
		return true
	if tools_covered() or (original_panels != null and session != null and session.state.mell_open):
		# fixes-87: no Pause sheet or Save page where it would draw under
		# something: a minigame still starting (it shows over the sheet) or
		# the loading cover, and in Legacy Mel's call (the Save page drew
		# under her surface, canvas z 370 < 536; the original toolbar is
		# closed while she is on).
		return true
	_show_save_overlay(true)
	return true


func handle_shortcut(keycode: Key) -> bool:
	if has_modern_tool_open():
		return true
	if keycode in [KEY_I, KEY_S, KEY_J, KEY_M, KEY_N] and tools_covered():
		# fixes-87: a minigame (canvas z 420), the ending (520 to 553) or an
		# item close-up (370; Legacy's original zoom up to 680) covers the
		# tools. S and I opened the Pause sheet (350) or the suitcase (340),
		# Legacy an original page (370), under it: unseen, and the Pause sheet
		# held play, so the game seemed stuck. The original game offers no
		# tool there: both editions refuse these keys, without a message (round
		# 2: J's casebook hint covered the minigames' and the close-up's own
		# buttons for 2 s). The shell's casebook does not open over a cover
		# either (_can_open_casebook).
		return true
	if keycode in [KEY_I, KEY_S, KEY_J, KEY_M, KEY_N] and _modern_mell_call_on():
		# fixes-87 round 2: Modern too refuses the tool keys during Mel's call,
		# as the original toolbar is closed while she is on (Legacy presses
		# its closed buttons below). Only closing what is already open (the
		# suitcase or the Pause sheet, from the Tools dock or Escape) still
		# works. Escape and Android Back keep opening the Pause sheet: it is
		# drawn on top and holds her line (handle_escape).
		if keycode == KEY_I and _inventory_overlay.visible:
			_show_inventory_overlay(false)
		elif keycode == KEY_S and _save_overlay.visible:
			_show_save_overlay(false)
		return true
	match keycode:
		KEY_I:
			if original_panels != null:
				# fixes-87: Legacy I presses the original found-items bag button,
				# as J, M and N press theirs, with its rules: closed during Mel's
				# call (the bag page drew under her surface, canvas z 370 < 536)
				# and while the story waits on a line; with an item held it puts
				# the item back in its bag.
				original_panels.activate_toolbar(53)
			else:
				_show_inventory_overlay(not _inventory_overlay.visible)
			return true
		KEY_S:
			if original_panels != null:
				# fixes-87: Legacy S presses the original Save button, closed in
				# the same states and while an item is held.
				original_panels.activate_toolbar(63)
			else:
				_show_save_overlay(not _save_overlay.visible)
			return true
		KEY_J:
			if original_panels != null:
				# Legacy stays the original: no remake casebook. J presses the
				# original notes button, like N, with its rules (closed during
				# Mel's call, a spoken line or while an item is held). A second
				# J closes the notes page again. J does not open it while a
				# mouse button is held: that press would end on the room under
				# the page (on a door, Julia walked out).
				if original_panels.page == "notes":
					original_panels.close_page()
				elif Input.get_mouse_button_mask() == 0:
					original_panels.activate_toolbar(62)
			else:
				_request_casebook()
			return true
		KEY_M:
			if original_panels != null:
				original_panels.activate_toolbar(55)
			else:
				_show_modern_map()
			return true
		KEY_N:
			if original_panels != null:
				original_panels.activate_toolbar(62)
			else:
				_show_modern_notebook("notes")
			return true
	return false


func _sync_modern_actor_speech(voice: Dictionary) -> void:
	var motion_paused: bool = not effect_host.is_processing()
	presenter.sync_modern_actor_voice(voice, motion_paused)
	presenter.sync_modern_actor_bodies(effect_host._active_animation, effect_host.director_frame_rate * effect_host.playback_rate, motion_paused)
	if is_instance_valid(_modern_cafe):_modern_cafe.sync_voice(voice,motion_paused)
	# These scene actors replace hidden original channels during close-ups.
	# They need the same voice owner as the ordinary presenter sprites.
	for scene: Node in [_modern_lab, _modern_paper, _modern_photo]:
		if is_instance_valid(scene):
			var actor: JuliaModernActorSprite = scene.get("actor")
			if is_instance_valid(actor):
				actor.set_motion_paused(motion_paused)
				actor.set_voice_snapshot(voice)
	if is_instance_valid(_modern_finale):
		for actor: JuliaModernActorSprite in _modern_finale.actors.values():
			actor.set_motion_paused(motion_paused)
			actor.set_voice_snapshot(voice)


func _process(delta: float) -> void:
	if presentation_edition == "modern":
		_advance_portrait_stage(delta)
		_keep_toast_clear_of_choices()
		# Tools pause the media host. Cosmetic tails and ambient props share
		# that pause even after their short original source job has completed.
		var motion_delta: float = delta * effect_host.playback_rate if effect_host.is_processing() else 0.0
		presenter.advance_environment_motion(motion_delta)
		var actor_voice: Dictionary = effect_host.active_voice_snapshot()
		if _modern_cafe != null:
			_modern_cafe.sync_scene(current_location_id(),session)
			if _modern_cafe.visible: _modern_cafe.advance(motion_delta)
		if _modern_lab != null and session != null:
			_modern_lab.sync_scene(current_location_id(),session.state,_is_hebrew())
			if _modern_lab.visible: _modern_lab.advance(motion_delta)
		if _modern_paper != null and session != null:
			_modern_paper.sync_scene(current_location_id(),session.state)
			if _modern_paper.visible: _modern_paper.advance(motion_delta)
		if _modern_photo != null and session != null:
			_modern_photo.sync_scene(current_location_id(),session.state,session)
			if _modern_photo.visible: _modern_photo.advance(motion_delta)
		if _modern_finale != null and session != null:
			_modern_finale.sync_scene(current_location_id(),session.state)
			_modern_finale.sync_source_face(effect_host._active_animation, 1.0 / maxf(0.001, effect_host.active_animation_frame_interval()) * effect_host.playback_rate, not effect_host.is_processing())
			if _modern_finale.visible: _modern_finale.advance(motion_delta)
		if _modern_street1 != null and session != null:
			_modern_street1.sync_scene(current_location_id() == "street1", str(session.state.channel_members.get(15,"")), _is_hebrew(), session.state.has_event("took_np"))
			if _modern_street1.visible: _modern_street1.advance(motion_delta)
			_modern_street2_rack.sync_state(current_location_id() == "street2", session.state.has_event("took_np"))
		if _modern_street3 != null:
			_modern_street3.set_scene_active(current_location_id() == "street3")
			if _modern_street3.visible: _modern_street3.advance(motion_delta)
		if _modern_street_travel != null and session != null:
			_modern_street_travel.sync_scene(current_location_id(),presenter.call("_is_scene_channel_visible",11))
			if _modern_street_travel.visible: _modern_street_travel.advance(motion_delta)
		if _modern_street6 != null and _modern_street6.visible and current_location_id() != "street6": _modern_street6.stop()
		if _modern_street6 != null and _modern_street6.visible: _modern_street6.advance(motion_delta)
		if _modern_street12 != null:
			_modern_street12.set_scene_active(current_location_id() == "street12")
			if _modern_street12.visible: _modern_street12.advance(motion_delta)
		if _modern_waterfront != null:
			_modern_waterfront.set_scene_active(current_location_id() == "street17")
			_modern_waterfront.advance(motion_delta)
		if _modern_cloth_ambient != null:
			_modern_cloth_ambient.sync_scene(current_location_id())
			_modern_cloth_ambient.advance(motion_delta)
		_sync_modern_actor_speech(actor_voice)
		_mell_pose_clock += motion_delta
		if is_instance_valid(_modern_parents):
			_sync_parent_portraits()
			_modern_parents.advance(motion_delta, not effect_host.is_processing())
		if _modern_sign != null and _modern_sign.visible:
			_modern_sign_clock += motion_delta * 8.0
			_modern_sign.material.set_shader_parameter("phase", _modern_sign_clock)
			if current_location_id() != "street5": _modern_sign.visible = false
		if _dylen_sprite is JuliaModernActorSprite and _dylen_sprite.visible:
			(_dylen_sprite as JuliaModernActorSprite).set_motion_paused(not effect_host.is_processing())
			(_dylen_sprite as JuliaModernActorSprite).set_voice_snapshot(actor_voice)
			(_dylen_sprite as JuliaModernActorSprite)._process(motion_delta)
		if is_instance_valid(_mell_portrait) and _mell_portrait.visible:
			if is_instance_valid(_modern_mell_phone) and session != null:
				_modern_mell_phone.sync(session.state.mell_close_enabled, locale)
			_sync_modern_mell_speech()
			ModernCharacterArt.advance_mell_performance(_mell_portrait, motion_delta, _mell_mouth_level, _mell_pose_clock, _mell_mouth_state, _modern_mell_voice_snapshot())
		return
	# fixes-87 round 2: Legacy's toolbar takes no pointer under a cover.
	_sync_original_toolbar_pointer()
	if is_instance_valid(_original_mell_surface):
		_original_mell_surface.visible = _mell_portrait.visible
		if _mell_fade_direction != 0:
			_mell_fade_elapsed += delta * effect_host.playback_rate
			var fade_fps: float = 15.0 if _mell_fade_direction > 0 else 30.0
			var fade_progress: float = minf(floorf(_mell_fade_elapsed * fade_fps) / 10.0, 1.0)
			_original_mell_surface.modulate.a = fade_progress if _mell_fade_direction > 0 else 1.0 - fade_progress
			if fade_progress >= 1.0:
				_mell_fade_direction = 0
	if not _mell_speaking or _mell_frames.is_empty():
		return
	_mell_frame_elapsed += delta
	var frame_rate: float = 6.5 if _mell_frames.size() == 2 else 15.0
	if _mell_frame_elapsed < 1.0 / frame_rate:
		return
	_mell_frame_elapsed = 0.0
	_set_mell_frame((_mell_frame_index + 1) % _mell_frames.size())


func _apply_locale() -> void:
	if not is_node_ready():
		return
	dialogue_overlay.set_locale(locale)
	if modern_map != null:
		modern_map.configure(session, locale)
	if modern_notebook != null:
		modern_notebook.configure(session, locale)
	_zoom_close_button.text = "×¡×’×™×¨×”" if _is_hebrew() else "Close"
	_apply_locale_to_label(_zoom_title)
	_apply_locale_to_button(_zoom_close_button)
	_apply_locale_to_button(_zoom_item_action)
	_zoom_title.get_parent().layout_direction = Control.LAYOUT_DIRECTION_RTL if _is_hebrew() else Control.LAYOUT_DIRECTION_LTR
	_loading_label.text = (
		"×˜×•×¢× ×ª ××ª ×¨×—×•×‘×•×ª 1967â€¦"
		if _is_hebrew()
		else "Loading the streets of 1967â€¦"
	)
	_refresh_toolbar() if session != null else _apply_toolbar_copy_without_session()
	if _inventory_overlay.visible:
		_rebuild_inventory()
	if _zoom_overlay.visible and not _zoom_item_id.is_empty():
		_zoom_title.text = ModernItems.label(_zoom_item_id, locale)
		var owned: bool = session.state.has_inventory_item("found", _zoom_item_id) or session.state.has_inventory_item("julia", _zoom_item_id)
		_zoom_item_action.text = ("×”×©×ª×ž×©×™" if owned else "××¡×¤×™") if _is_hebrew() else ("Use item" if owned else "Pick up")
	locale_changed.emit(locale)


func _apply_toolbar_copy_without_session() -> void:
	_refresh_added_tool_copy()
	_settings_button.text = "×”×’×“×¨×•×ª" if _is_hebrew() else "Settings"
	_inventory_button.text = "×—×¤×¦×™×" if _is_hebrew() else "Items"
	_inventory_button.tooltip_text = (
		"×—×¤×¦×™×" if _is_hebrew() else "Items"
	)
	_casebook_button.text = "×™×•×ž×Ÿ" if _is_hebrew() else "Journal"
	_casebook_button.tooltip_text = (
		"×¨×©×™×ž×•×ª" if _is_hebrew() else "Journal"
	)
	_save_button.text = "×”×©×”×™×”" if _is_hebrew() else "Pause"
	_save_button.tooltip_text = (
		"×”×©×”×™×” ×•×©×ž×™×¨×”" if _is_hebrew() else "Pause and save"
	)
	_menu_button.text = "×ª×¤×¨×™×˜" if _is_hebrew() else "Menu"
	_fullscreen_button.text = (
		"×ž×¡×š ×ž×œ×" if _is_hebrew() else "Fullscreen"
	)
	for button: Button in [
		_inventory_button,
		_casebook_button,
		_save_button,
		_menu_button,
		_fullscreen_button,
	]:
		_apply_locale_to_button(button)


func _location_copy(location_id: String, forced_locale: String = "") -> String:
	var selected_locale: String = (
		forced_locale
		if not forced_locale.is_empty()
		else ("he" if _is_hebrew() else "en")
	)
	var folded: String = location_id.to_lower()
	var strings: Dictionary = LOCATION_COPY.get(selected_locale, {})
	if strings.has(folded):
		return str(strings[folded])
	if folded.begins_with("street"):
		var number: String = folded.trim_prefix("street")
		return (
			"×¨×—×•×‘ %s" % number
			if selected_locale == "he"
			else "Street %s" % number
		)
	return folded.replace("_", " ").capitalize()


func _selected_inventory_label() -> String:
	return ModernItems.label(session.canonical_inventory_id(session.state.held_item), locale)


func _toggle_fullscreen() -> void:
	var window := get_window()
	window.mode = (
		Window.MODE_WINDOWED
		if _is_fullscreen()
		else Window.MODE_EXCLUSIVE_FULLSCREEN
	)
	_refresh_toolbar()


func _is_fullscreen() -> bool:
	return get_window().mode in [
		Window.MODE_FULLSCREEN, Window.MODE_EXCLUSIVE_FULLSCREEN,
	]


func _show_loading(value: bool) -> void:
	_loading_cover.visible = value


func _show_toast(message: String) -> void:
	_toast_label.text = message
	_apply_locale_to_label(_toast_label)
	if _toast_tween != null and _toast_tween.is_valid():
		_toast_tween.kill()
	_toast.modulate.a = 0.0
	if presentation_edition == "modern":
		# Modern keeps toasts off the conversation questions. Legacy keeps the
		# anchored bottom-centre place from _build_toast and always fades in.
		_toast_held = ""
		_toast_location = current_location_id()
		# A new message starts at full strength, wherever the last one moved.
		if _toast_move_tween != null and _toast_move_tween.is_valid():
			_toast_move_tween.kill()
		_toast.self_modulate.a = 1.0
		_toast_label.modulate.a = 1.0
		_fit_toast_width()
		if not _place_toast(true):
			# The questions fill every free strip (a very short window). Hold the
			# message until they leave; text is never drawn over a choice.
			_toast_held = message
			return
		# Check again once this frame's remaining handlers have run: the
		# questions can open or change right after the message was raised.
		call_deferred("_keep_toast_clear_of_choices")
	_toast_tween = create_tween()
	_toast_tween.tween_property(_toast, "modulate:a", 1.0, 0.12)
	_toast_tween.tween_interval(1.65)
	_toast_tween.tween_property(_toast, "modulate:a", 0.0, 0.24)


func _fit_toast_width() -> void:
	# Modern: 360 x 52 as before, or the screen width less 12 px margins on
	# phones. A longer message widens the slip, still centred and on one line.
	# Only a message wider than the whole screen (an English item name on a
	# narrow phone) is set in slightly smaller type instead of running off.
	if _toast_label.has_theme_font_size_override("font_size"):
		_toast_label.remove_theme_font_size_override("font_size")
	var available: float = size.x - 24.0 if size.x > 48.0 else TOAST_SIZE.x
	var width: float = minf(TOAST_SIZE.x, available)
	var font: Font = _toast_label.get_theme_font("font")
	if font != null and not _toast_label.text.is_empty():
		var font_size: int = _toast_label.get_theme_font_size("font_size")
		var chrome: float = _toast.get_theme_stylebox("panel").get_minimum_size().x + 2.0
		var text_width: float = font.get_string_size(
			_toast_label.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, font_size
		).x
		width = clampf(ceilf(text_width + chrome), width, maxf(width, available))
		if text_width + chrome > width:
			_toast_label.add_theme_font_size_override(
				"font_size", maxi(12, floori(font_size * (width - chrome) / text_width))
			)
	_toast.size = Vector2(width, TOAST_SIZE.y)


func _place_toast(fresh: bool) -> bool:
	# Modern: a new toast takes the first free slot, and so does one on
	# screen after a resize or rotation (_keep_toast_clear_of_choices). Else
	# a toast on screen keeps its place until questions appear under it,
	# then moves to a free slot. Returns false when no slot is free.
	var toast_size: Vector2 = _toast.size
	var choices: Rect2 = _dialogue_choice_area()
	var current := Rect2(
		Vector2(roundf((size.x - toast_size.x) * 0.5), _toast.position.y), toast_size
	)
	var keep: bool = (
		not fresh
		and current.position.y >= 0.0
		and current.end.y <= size.y
		and not (choices.has_area() and current.intersects(choices))
	)
	var target: Rect2 = current if keep else _toast_slot(toast_size, choices)
	if not target.has_area():
		return false
	# Showing, same layout, another strip: it makes way for the questions
	# and fades in at its new place. After a resize or rotation the whole
	# screen is laid out again in that frame, and the toast moves with it.
	var make_way: bool = (
		_toast.modulate.a > 0.0
		and size == _toast_view_size
		and not is_equal_approx(_toast.position.y, target.position.y)
	)
	if fresh:
		_toast_view_size = size
	if not _toast.position.is_equal_approx(target.position):
		_toast.position = target.position
	if make_way:
		_fade_toast_into_place()
	return true


func _fade_toast_into_place() -> void:
	# Modern: a showing toast that makes way for questions does not jump. It
	# leaves its old place at once, so no frame draws it over a choice, and
	# fades in at the new one. This runs on the panel's self_modulate and
	# the label's modulate: the toast's own fade-in, hold and fade-out on
	# modulate keep their timing, so a move never lengthens a message.
	if _toast_move_tween != null and _toast_move_tween.is_valid():
		_toast_move_tween.kill()
	_toast.self_modulate.a = 0.0
	_toast_label.modulate.a = 0.0
	_toast_move_tween = create_tween().set_parallel(true)
	_toast_move_tween.tween_property(_toast, "self_modulate:a", 1.0, TOAST_MOVE_FADE)
	_toast_move_tween.tween_property(_toast_label, "modulate:a", 1.0, TOAST_MOVE_FADE)


func _toast_slot(toast_size: Vector2, choices: Rect2) -> Rect2:
	# 1. The established place: centred, lower edge 34 px above the bottom.
	var slot := Rect2(
		Vector2(
			roundf((size.x - toast_size.x) * 0.5),
			size.y - TOAST_EDGE_INSET - toast_size.y
		),
		toast_size
	)
	if not choices.has_area() or not slot.intersects(choices):
		return slot
	# 2. Directly under the questions, where their band leaves the bottom
	# strip free (landscape phones keep it clear for the Tools button).
	slot.position.y = choices.end.y + TOAST_GAP
	if slot.end.y <= size.y - 4.0:
		return slot
	# 3. Top centre of the stage, above every question and action (closer to
	# the top edge only when a very short window leaves no other room).
	var stage_top: float = _toast_stage_top()
	for inset: float in [TOAST_EDGE_INSET, TOAST_GAP]:
		slot.position.y = stage_top + inset
		if slot.end.y + TOAST_GAP <= choices.position.y:
			return slot
	return Rect2()


func _dialogue_choice_area() -> Rect2:
	# Modern only: everything the open conversation lets the player press, in
	# this view's coordinates (the question band with its choices and action
	# row). Empty while the band is hidden, as it is while an answer plays.
	# Legacy never moves its toast, so there is no area to avoid.
	if presentation_edition != "modern":
		return Rect2()
	if not is_instance_valid(dialogue_overlay) or not dialogue_overlay.is_visible_in_tree():
		return Rect2()
	var band: Rect2 = dialogue_overlay.cinematic_band_rect()
	if not band.has_area():
		return Rect2()
	return (
		get_global_transform().affine_inverse() * dialogue_overlay.get_global_transform()
		* band
	)


func _toast_stage_top() -> float:
	# Top edge of the rendered 640x480 picture (below any letterbox band).
	if not is_instance_valid(presenter):
		return 0.0
	var stage := presenter.get("_stage_surface") as Control
	if stage == null or not stage.is_inside_tree():
		return 0.0
	var rect: Rect2 = (
		get_global_transform().affine_inverse() * stage.get_global_transform()
		* Rect2(Vector2.ZERO, stage.size)
	)
	return clampf(rect.position.y, 0.0, maxf(0.0, size.y - TOAST_SIZE.y))


func _keep_toast_clear_of_choices() -> void:
	# Modern only. Questions can appear, grow or move while a toast is up (a
	# reply ends, a follow-up sheet opens, the window turns). Check from the
	# moment it is raised, through the fade-in, until it has faded out, and
	# while a message is held; nothing runs between toasts.
	if presentation_edition != "modern" or not is_instance_valid(_toast):
		return
	if not _toast_held.is_empty():
		if _toast_slot(_toast.size, _dialogue_choice_area()).has_area():
			_show_toast(_toast_held)
		return
	var running: bool = _toast_tween != null and _toast_tween.is_valid()
	# After a resize or rotation choose the slot again, as for a new toast:
	# a moved toast keeps offsets measured from the bottom edge (the
	# _build_toast anchors), which can leave it mid-screen. This runs in
	# _process (or deferred), after the question band was laid out anew.
	var rechoose: bool = size != _toast_view_size
	if (_toast.modulate.a <= 0.0 and not running) or _place_toast(rechoose):
		return
	var message: String = _toast_label.text
	if running:
		_toast_tween.kill()
	_toast.modulate.a = 0.0
	_toast_held = message


func _expire_toast_on_location_change() -> void:
	# Modern only: a pickup note or warning belongs to the room that raised
	# it. Entering another room drops a held message and removes one still
	# showing. Legacy toasts keep the runtime timing across room changes.
	if presentation_edition != "modern" or not is_instance_valid(_toast):
		return
	if _toast_location == current_location_id():
		return
	_toast_held = ""
	if _toast_tween != null and _toast_tween.is_valid():
		_toast_tween.kill()
	_toast.modulate.a = 0.0


func _make_stage_sprite(
	path: String, position: Vector2, dimensions: Vector2, layer: int
) -> TextureRect:
	var result := TextureRect.new()
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.texture = load(path)
	result.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	result.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	result.mouse_filter = Control.MOUSE_FILTER_IGNORE
	result.z_index = layer
	result.visible = false
	_actor_stage.add_child(result)
	result.position = position
	result.size = dimensions
	return result


func _make_actor_button(bounds: Rect2, callback: Callable) -> Button:
	var result := Button.new()
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.flat = true
	result.focus_mode = Control.FOCUS_ALL
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	result.z_index = 35
	result.visible = false
	result.add_theme_stylebox_override("normal", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("hover", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("pressed", StyleBoxEmpty.new())
	result.add_theme_stylebox_override(
		"focus",
		ThemeFactory.make_box(
			Color.TRANSPARENT,
			ThemeFactory.MUSTARD,
			2,
			2,
			0.0,
			0.0
		)
	)
	result.pressed.connect(callback)
	_actor_stage.add_child(result)
	result.position = bounds.position
	result.size = bounds.size
	return result


func _make_toolbar_button() -> Button:
	var result := Button.new()
	for state: String in ["font_color", "font_pressed_color", "font_focus_color"]:
		result.add_theme_color_override(state, ThemeFactory.WARM_WHITE)
	result.add_theme_color_override("font_hover_color", ThemeFactory.MUSTARD)
	# A shown focus is a ring, as on the suitcase buttons. The theme's focus
	# box is filled cream, and this label is cream: a focused toolbar button
	# drew as a blank pill. Same content margins as that box: same size.
	result.add_theme_stylebox_override("focus", ThemeFactory.make_box(Color.TRANSPARENT, Color("fff1b5"), 2, 16, 16.0, 12.0))
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.flat = true
	result.custom_minimum_size = Vector2(76.0, 56.0)
	result.add_theme_font_size_override("font_size", 19)
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	return result


func _make_scrim_overlay(layer: int) -> Control:
	var result := Control.new()
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	result.mouse_filter = Control.MOUSE_FILTER_STOP
	result.z_index = layer
	result.visible = false
	var scrim := ColorRect.new()
	scrim.layout_direction = Control.LAYOUT_DIRECTION_LTR
	scrim.color = Color(0.10, 0.055, 0.025, 0.72)
	scrim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	scrim.mouse_filter = Control.MOUSE_FILTER_STOP
	result.add_child(scrim)
	return result


func _overlay_card(parent: Control, minimum: Vector2) -> PanelContainer:
	var card := PanelContainer.new()
	card.layout_direction = Control.LAYOUT_DIRECTION_LTR
	card.custom_minimum_size = Vector2.ZERO if WebLayout.enabled() else minimum
	card.add_theme_stylebox_override(
		"panel",
		ThemeFactory.make_box(
			ThemeFactory.WARM_WHITE,
			Color(ThemeFactory.INK, 0.68),
			2,
			3,
			12.0 if WebLayout.enabled() else 28.0,
			12.0 if WebLayout.enabled() else 23.0
		)
	)
	if WebLayout.enabled():
		parent.add_child(card)
		card.set_meta("web_preferred_size", minimum)
		_web_overlay_cards.append(card)
		# fixes-87 round 3: a card only grows by itself; when its content
		# settles (a wrapping title gets its width) it is laid out again.
		card.minimum_size_changed.connect(_layout_web_card.bind(card), CONNECT_DEFERRED)
	else:
		var center := CenterContainer.new()
		center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		parent.add_child(center)
		center.add_child(card)
	return card


func _make_overlay_title() -> Label:
	var result := Label.new()
	result.add_theme_font_size_override("font_size", 28)
	result.add_theme_color_override("font_color", ThemeFactory.INK)
	if WebLayout.enabled():
		result.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		result.add_theme_font_size_override("font_size", 23)
	return result


func _make_small_button() -> Button:
	var result := Button.new()
	result.layout_direction = Control.LAYOUT_DIRECTION_LTR
	result.custom_minimum_size = Vector2(88.0, 48.0) if WebLayout.enabled() else Vector2(112.0, 40.0)
	result.add_theme_font_size_override("font_size", 16 if WebLayout.enabled() else 14)
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	return result


func _layout_web_controls() -> void:
	if not WebLayout.enabled() or size.x < 1 or size.y < 1:
		return
	var portrait: bool = presentation_edition == "modern" and WebLayout.is_portrait(size)
	var portrait_stage_size: Vector2 = WebLayout.portrait_stage_size(size)
	if is_instance_valid(presenter) and is_instance_valid(effect_host):
		for layer: Control in [presenter, effect_host]:
			if portrait:
				layer.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
				layer.position = Vector2(0, _portrait_stage_offset)
				layer.size = portrait_stage_size
			else:
				layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		presenter.call("_layout_stage")
		effect_host.call("_fit_stage")
	if is_instance_valid(_portrait_room_backdrop):
		_portrait_room_backdrop.visible = portrait
		if portrait:
			_portrait_room_backdrop.position = Vector2(0, -_portrait_stage_offset)
			_portrait_room_backdrop.size = Vector2(size.x, size.y - WebLayout.PORTRAIT_CASE_HEIGHT)
			_portrait_room_backdrop.texture = presenter.get("_background").texture
	if is_instance_valid(_portrait_backdrop):
		_portrait_backdrop.visible = portrait
		if portrait:
			_portrait_backdrop.position = Vector2(0, size.y - WebLayout.PORTRAIT_CASE_HEIGHT)
			_portrait_backdrop.size = Vector2(size.x, WebLayout.PORTRAIT_CASE_HEIGHT)
			_portrait_backdrop.get_child(0).set("compact", true)
			_portrait_location.position = Vector2(32, 22)
			_portrait_location.size = Vector2(size.x - 164, 37)
			_portrait_location.add_theme_font_size_override("font_size", 18)
			_portrait_location.text = _location_copy(current_location_id())
			_portrait_actions.position = Vector2(24, 70)
			# The same source buttons live in the Tools drawer; do not expose
			# an oversized second set of pockets during exploration/finale.
			_portrait_actions.visible = false
			var pocket_height: float = clampf(floorf((_portrait_backdrop.size.y - 164) * 0.5), 82, 166)
			for action: Button in _portrait_action_sources:
				var source: Button = _portrait_action_sources[action]
				action.text = source.text
				action.disabled = source.disabled
				_apply_locale_to_button(action)
				# Keep each column equal even when the Hebrew label is short.
				action.custom_minimum_size = Vector2(maxf(0, (size.x - 60) * 0.5), pocket_height)
				for state: String in ["normal", "hover", "pressed", "focus", "disabled"]:
					action.get_theme_stylebox(state).content_margin_top = floorf(pocket_height * 0.47)
				for art: Node in action.get_children():
					if art is Control: art.queue_redraw()
			_portrait_actions.size = Vector2(size.x - 48, pocket_height * 2 + 12)
	if is_instance_valid(_tool_dock):
		# The open portrait drawer must not mix its labels with dialogue text
		# underneath. Landscape retains the existing unobtrusive dark dock.
		_tool_dock.add_theme_stylebox_override("panel",
			ThemeFactory.make_box(Color("325650"), Color("c19b64"), 2, 10, 7.0, 5.0) if portrait
			else ThemeFactory.make_box(Color(ThemeFactory.INK, 0.86), Color(ThemeFactory.WARM_WHITE, 0.20), 1, 24, 7.0, 5.0))
	if is_instance_valid(_dock_toggle):
		_dock_toggle.text = ("×¡×’×™×¨×”" if _is_hebrew() else "Close") if _tool_dock.visible else ("×›×œ×™×" if _is_hebrew() else "Tools")
		_dock_toggle.flat = not portrait
		for state: String in ["normal", "hover", "pressed"]:
			_dock_toggle.add_theme_stylebox_override(state, ThemeFactory.make_box(Color("765137"), Color("c19b64"), 2, 7, 12, 8) if portrait else StyleBoxEmpty.new())
		for state: String in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			_dock_toggle.add_theme_color_override(state, ThemeFactory.WARM_WHITE)
	if is_instance_valid(_tool_grid):
		_tool_grid.columns = 2 if size.x < 620 else 3
		var available: float = size.x - 129.0 - 4.0 * (_tool_grid.columns - 1)
		var width: float = clampf(floorf(available / _tool_grid.columns), 88, 148)
		for child: Node in _tool_grid.get_children():
			var button := child as Button
			button.custom_minimum_size = Vector2(width, 48)
			button.add_theme_font_size_override("font_size", 16)
			button.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	for card: PanelContainer in _web_overlay_cards:
		_layout_web_card(card)
	if is_instance_valid(_toast):
		_toast.size.x = minf(360, maxf(1, size.x - 24))
		_toast.position.x = (size.x - _toast.size.x) * 0.5
	_layout_portrait_stage_offset(portrait)
	if is_instance_valid(_toast) and presentation_edition == "modern":
		# Modern: the same width rule (wider only for a longer message), then a
		# slot clear of any open conversation questions.
		_fit_toast_width()
		_place_toast(false)


func _layout_web_card(card: PanelContainer) -> void:
	# A sheet card in the Web layout: its preferred size within the view less
	# 12 px a side, centred. fixes-87 round 3: the close-up's card keeps clear
	# of the shell's Settings button, and every card is laid out again once
	# its content settles (_overlay_card). The first close-up of a session was
	# laid out while its wrapping title still had no width (643 px tall when
	# set), so at 844x390 its card stayed 737 px tall at y -174: its title,
	# Close and Use off screen.
	if not is_instance_valid(card) or size.x < 1 or size.y < 1:
		return
	var preferred: Vector2 = card.get_meta("web_preferred_size")
	card.size = Vector2(minf(preferred.x, maxf(1, size.x - 24)), minf(preferred.y, maxf(1, size.y - 24)))
	card.position = ((size - card.size) * 0.5).round()
	if card == _zoom_card:
		_keep_card_clear_of_shell_button(card)


func keep_clear_of_shell_button(rect: Rect2) -> void:
	# fixes-87 round 3 (review): the shell's gameplay Settings button lies over
	# every layer of this view and takes the pointer first. In the landscape
	# Web layout (844x390) the item close-up's card reached under it, and its
	# Close (top left in Hebrew) lay beneath the button: a tap on Close opened
	# Settings and left the close-up open. The shell reports where the button
	# is (rect, in this view's coordinates; empty when it is not shown).
	if rect.is_equal_approx(_shell_button_rect):
		return
	_shell_button_rect = rect
	if WebLayout.enabled() and is_node_ready():
		_layout_web_controls()


func _keep_card_clear_of_shell_button(card: Control) -> void:
	# The close-up card, still centred, narrows until it is clear of the shell's
	# Settings button beside it (8 px apart). Its picture is limited by the
	# card's height there, so it keeps its size; only the card's width and
	# place change, not its style. With no room beside the button, the card
	# starts below it instead.
	var keep_clear: Rect2 = _shell_button_rect.grow(8.0)
	if not keep_clear.has_area() or not Rect2(card.position, card.size).intersects(keep_clear):
		return
	var margin: float = (
		keep_clear.end.x
		if keep_clear.get_center().x < size.x * 0.5
		else size.x - keep_clear.position.x
	)
	if size.x - 2.0 * margin >= 320.0:
		card.position.x = roundf(margin)
		card.size.x = size.x - 2.0 * card.position.x
	else:
		card.position.y = roundf(keep_clear.end.y)
		card.size.y = maxf(1.0, size.y - card.position.y - 12.0)


func _layout_portrait_stage_offset(portrait: bool) -> void:
	var dialogue_open: bool = session != null and session.state.dialogue_open
	var target: float = 0.0
	if portrait and not dialogue_open:
		target = maxf(0.0, (size.y - WebLayout.PORTRAIT_CASE_HEIGHT - WebLayout.portrait_stage_size(size).y) * 0.5)
	# Initial layout, rotation and accessibility changes settle immediately.
	# Only entering/leaving a conversation moves the unchanged world camera.
	var settle: bool = not portrait or not _portrait_layout_active or size != _portrait_layout_size or _portrait_reduced_motion
	if settle:
		_portrait_stage_target = target
		_portrait_stage_elapsed = 0.24
		_apply_portrait_stage_offset(target)
	elif dialogue_open != _portrait_layout_dialogue:
		_portrait_stage_from = _portrait_stage_offset
		_portrait_stage_target = target
		_portrait_stage_elapsed = 0.0
	_portrait_layout_active = portrait
	_portrait_layout_size = size
	_portrait_layout_dialogue = dialogue_open


func _advance_portrait_stage(delta: float) -> void:
	if not _portrait_layout_active or _portrait_stage_elapsed >= 0.24 or not _modal_pause_reasons.is_empty():
		return
	_portrait_stage_elapsed = minf(0.24, _portrait_stage_elapsed + delta)
	var progress: float = _portrait_stage_elapsed / 0.24
	var eased: float = progress * progress * (3.0 - 2.0 * progress)
	_apply_portrait_stage_offset(lerpf(_portrait_stage_from, _portrait_stage_target, eased))


func _apply_portrait_stage_offset(value: float) -> void:
	_portrait_stage_offset = value
	# A single offset keeps artwork, source effects and hit targets registered.
	for layer: Control in [presenter, effect_host]:
		if is_instance_valid(layer): layer.position.y = value
	if is_instance_valid(_portrait_room_backdrop):
		_portrait_room_backdrop.position.y = -value
	if dialogue_overlay is JuliaModernDialogueOverlay:
		(dialogue_overlay as JuliaModernDialogueOverlay).set_portrait_scene_offset(value)


func _apply_locale_to_label(label: Label) -> void:
	var hebrew: bool = _is_hebrew()
	label.language = "he" if hebrew else "en"
	label.layout_direction = Control.LAYOUT_DIRECTION_LTR
	label.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if hebrew
		else Control.TEXT_DIRECTION_LTR
	)
	label.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_RIGHT
		if hebrew
		else HORIZONTAL_ALIGNMENT_LEFT
	)


func _apply_locale_to_button(button: Button) -> void:
	var hebrew: bool = _is_hebrew()
	button.language = "he" if hebrew else "en"
	button.layout_direction = (
		Control.LAYOUT_DIRECTION_RTL
		if hebrew
		else Control.LAYOUT_DIRECTION_LTR
	)
	button.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if hebrew
		else Control.TEXT_DIRECTION_LTR
	)


func _make_mell_chroma_key_material() -> ShaderMaterial:
	var shader := Shader.new()
	shader.code = """
shader_type canvas_item;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	vec3 mint_key = vec3(0.20, 0.95, 0.66);
	float key_distance = distance(source.rgb, mint_key);
	float exact_key = 1.0 - smoothstep(0.07, 0.34, key_distance);
	float green_excess = source.g - max(source.r, source.b);
	float mixed_edge = smoothstep(0.055, 0.19, green_excess)
		* smoothstep(0.20, 0.64, source.g);
	float keyed = max(exact_key, mixed_edge);
	float neutral_green = min(source.g, max(source.r, source.b));
	vec3 despilled = vec3(
		source.r,
		mix(source.g, neutral_green, mixed_edge),
		source.b
	);
	COLOR = vec4(despilled, source.a * (1.0 - keyed));
}
"""
	var result := ShaderMaterial.new()
	result.shader = shader
	return result


func _load_mell_frames() -> void:
	_mell_frames.clear()
	if presentation_edition == "modern":
		_mell_portrait.material = null
		_mell_frames = ModernCharacterArt.mell_frames()
		_set_mell_frame(0)
		return
	# The mint screen is part of the original phone portrait. Only original
	# Director ink 36 (pure white transparent) is applied in Legacy mode.
	_mell_portrait.material = null
	for frame_number: int in range(38, 56):
		var member_name: String = (
			"EndAnim"
			if frame_number == 55
			else "Mel_frame_%d" % (frame_number - 37)
		)
		var path: String = MELL_FRAME_ROOT.path_join(
			"%04d_%s.png" % [frame_number, member_name]
		)
		if ResourceLoader.exists(path):
			var texture: Resource = load(path)
			if texture is Texture2D:
				_mell_frames.append(ImageTexture.create_from_image(OriginalBitmapInk.apply((texture as Texture2D).get_image(), 36)))
	if not _mell_frames.is_empty():
		_set_mell_frame(0)


func _set_mell_frame(index: int) -> void:
	if _mell_frames.is_empty():
		return
	_mell_frame_index = wrapi(index, 0, _mell_frames.size())
	_mell_portrait.texture = _mell_frames[_mell_frame_index]


func _collect_names(value: Variant, result: Array[String]) -> void:
	match typeof(value):
		TYPE_STRING:
			var name: String = str(value)
			if not name.is_empty() and name not in result:
				result.append(name)
		TYPE_ARRAY:
			for child: Variant in value:
				_collect_names(child, result)
		TYPE_DICTIONARY:
			var name: String = ValueParser.legacy_name(value)
			if not name.is_empty() and name not in result:
				result.append(name)
			for child: Variant in value.values():
				_collect_names(child, result)


func _first_texture(member_names: Array[String]) -> Texture2D:
	if catalog == null:
		return null
	for member_name: String in member_names:
		var resolution: Dictionary = catalog.asset_index.resolve(
			member_name, "image"
		)
		for value: Variant in resolution.get("matches", []):
			if typeof(value) != TYPE_DICTIONARY:
				continue
			var path: String = _runtime_path(str(value.get("path", "")))
			if path.is_empty() or not ResourceLoader.exists(path):
				continue
			var resource: Resource = load(path)
			if resource is Texture2D:
				return resource as Texture2D
	return null


func _runtime_path(path: String) -> String:
	var normalized: String = path.replace("\\", "/")
	if normalized.begins_with("res://"):
		return normalized
	var marker: int = normalized.to_lower().find("modern/game/")
	if marker >= 0:
		return "res://" + normalized.substr(marker + "modern/game/".length())
	return ""


func _payload(effect: Dictionary) -> Dictionary:
	var value: Variant = effect.get("payload", {})
	return value if value is Dictionary else {}


func _is_hebrew() -> bool:
	return locale in ["he", "heb", "he-il"]

func save_before_background() -> Dictionary:
	# SaveStore preserves the deferred command queue and pending effect IDs.
	# Restoring during speech safely replays that effect before continuing.
	if session == null:
		return {"ok": false, "message": "No game is running."}
	_autosave_generation += 1
	_autosave_pending = false
	return save_slot(SaveStoreScript.AUTOSAVE_SLOT_ID)


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_PAUSED:
		save_before_background()
