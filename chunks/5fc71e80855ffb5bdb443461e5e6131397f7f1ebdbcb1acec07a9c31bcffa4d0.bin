õ	û§hà.vÆ½TülëX|Cðo:±•E›.a~`|ÌÖç␀ðbÜß]–†º÷:¶ÂLm»œDƒ˜›Ü[À0,kÑwâî¯†¢Ç:‘^-ô·àš5¯@3Š4­Ð¦I~Çm“?D+÷EÝ„¢iv/QÈa»¦àƒž>ËaGã·.öyï€Î¾vŽ^®â7Ìý®éÆËçÆ~Õðû_y»µáä}•ôrÇ4Š^»­©\úJ—ì·^x[Ü«öWÛ‹ñ#ü‹{ç¾wI¿ÿEêD¬ÚzÄòT‘›-=Òòýøñ9£žH˜ûŽ?˜.*} påÈIÛ˜ðwsæžãáxL¶5Œ[&ü‘ôm¯Æ[ùÌuŸRžN}´)¬ÞâÌÄéíüce^áüN¨s/âÂz`á%LmÓ¾rÙ‰Ä™·dÁ­×¼…/y=ÛŸf†¹Ê½Ò{©ÅçKÇÌÄßê¬^›œqñû&µ^‹a ÖÑÞOIÑËüNl÷2Ëþ‚eùŸV(ÆÝ•‡­ùÈ©­WÀ{›oQG=~Ã¾bÁx·{säÝP:¹ãM—Sù¶ äOå™ä_ªvà6Ã`ä4ëScŸ½Úôœüaô`¼Ò?”;}øC©^ç”wd{‰@[Ï%Ãjìƒx'ÿÜHÔdŒùÿ¶èapŒöqD=€¯ˆ.ã”Þ.ÞÈVè!ÝæWÙgñ ÒßÃÎ´o¸4å´'†uH‚ÐV¸Óþl}×èFö8¡ï‹ÿ¶U8ÛFõe\dQ7dþ¾@:‘/eñ<3œ£/¯i'G~Ì5*2)V÷Yëpèè%Êf'ÃÀÓ^Eã7˜½ä¥qÃ5òÀ8g˜bw3â…zþOæ’Óðm--‡¿\z\¹}^`O¹šàÉ?æ?þn¿™cíœ3?ÙUfŽèEá0!OcõåJÌ®½␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;

// Drawn after a letterboxed cinematic stage. Inside the stage it is fully
// transparent; in the bars it shows a soft, dimmed extension of the live frame
// (the stage scaled to cover the screen, then blurred), so portrait phones get
// ambient colour instead of black bars. It never changes the stage pixels.
uniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;
uniform vec4 stage_rect = vec4(0.0, 0.0, 1.0, 1.0); // canvas units: x, y, w, h
uniform vec2 screen_size = vec2(1.0); // canvas units (the viewport rect)
uniform float blur_px = 26.0;
uniform float dim = 0.45;

vec3 cover_sample(vec2 screen_px, float lod) {
	vec2 centre = screen_size * 0.5;
	float cover = max(screen_size.x / stage_rect.z, screen_size.y / stage_rect.w);
	vec2 local = (screen_px - centre) / (stage_rect.zw * cover) + 0.5;
	local = clamp(local, vec2(0.01), vec2(0.99));
	return textureLod(screen_texture, (stage_rect.xy + local * stage_rect.zw) / screen_size, lod).rgb;
}

void fragment() {
	vec2 px = SCREEN_UV * screen_size;
	vec2 inside = step(stage_rect.xy, px) * step(px, stage_rect.xy + stage_rect.zw);
	if (inside.x * inside.y > 0.5) {
		COLOR = vec4(0.0);
	} else {
		// A coarse mip level of the screen copy is already a wide, soft blur;
		// five taps around it remove the remaining blockiness. Cheap on phones.
		vec2 texels = vec2(textureSize(screen_texture, 0));
		float lod = log2(max(texels.x, texels.y) / 48.0);
		vec3 ambient = cover_sample(px, lod) * 0.4;
		for (int tap = 0; tap < 4; tap++) {
			float angle = 1.5707963 * float(tap) + 0.785398;
			ambient += cover_sample(px + vec2(cos(angle), sin(angle)) * blur_px, lod) * 0.15;
		}
		// Darken toward the screen edges so the sharp stage stays the focus:
		// distance out from the stage, for top/bottom and side bars alike.
		vec2 out_of_stage = max(stage_rect.xy - px, px - (stage_rect.xy + stage_rect.zw));
		float edge = length(max(out_of_stage, vec2(0.0)));
		vec2 bars = max(stage_rect.xy, screen_size - stage_rect.xy - stage_rect.zw);
		float fade = clamp(edge / max(max(bars.x, bars.y), 1.0), 0.0, 1.0);
		COLOR = vec4(ambient * mix(dim, dim * 0.45, fade), 1.0);
	}
}
