        },
        "jmeab-10": {
          "path": "res://assets/languages/cs/audio/jmeab-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "863d6ec38e7a799f64c4721563f6812800015fbcb9517363ece3219c63cd0589",
          "text": "1967, jak se to stalo?",
