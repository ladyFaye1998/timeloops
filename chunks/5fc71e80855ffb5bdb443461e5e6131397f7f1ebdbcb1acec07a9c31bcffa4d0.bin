¿„ß‚þ0¢'ÿ¿eY[ELH ª(ð")/Dð"@Q™	ŽÂ¸ã"h‘˜¶Š˜€˜"f¤-1Ì†‹␀/Ê,¬c£ I¨±q¤$¥e3ñÄ(Ýy€&Pš“à&hJRÉ´oªvP§žw2iÆÔtíã‹¯¿°¯Pâ– °4{"z¿¾—ña␀ãûO'=§Ë¬5›‰Û	?80HÂ:->ÉáŸßüãþÉ{AO?4»vdf¡»:Ì¹F²NQ&ý‘pßz½˜×V'‰ðËüºÞ[,ñ¸<6 Y8~‰ý‡N†IÅÜÞ,þˆU:44£>%uDDAAŽAÏ`4„ŸÖ­K'§ê;çýYŠiÌÿgÚ'Ë4s]¡»írLÙØóêÊÁfvë(JÕ␀5Ï¿tä/ŒNê‡ÖìçzîþùãÉé6Ñ4>Ò;(ñ?$FGñm·j{h,òþYaÅsáõñf#Èýp?üÓÅÞÂÇäC^ôüþì‰´~²XiÏtp¾hzŒÈïö‡ñy7ÎöL5Æì‡½Z´œÒÆ®áG·Ñé•§„:èažÈ¿‚y1mÿêÉÝ­å€Û:ÜFü­WR§ØD?8ûo[rã×jk{È`­wòó]␀3?Ü3ø' 'ûtd­Ÿ¦õ²mþËŸï|æîùâÓ/«ë¿X­␀þ␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform vec3 source_u;
uniform vec3 source_v;
uniform vec3 source_w;
uniform vec2 source_size;
varying vec2 local_position;

void vertex() {
	local_position = VERTEX;
}

void fragment() {
	vec3 p = vec3(local_position, 1.0);
	float w = dot(source_w, p);
	vec2 uv = vec2(dot(source_u, p), dot(source_v, p)) / w / source_size;
	COLOR = texture(TEXTURE, uv);
	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
		COLOR = vec4(0.0);
	}
}
