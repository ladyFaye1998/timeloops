        },
        "jdob1-10": {
          "path": "res://assets/languages/de/audio/jdob1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4b4c7d1e200aa7f2ea81ba388e6985744c258972bb596825a052279d48a31623",
          "text": "Warum ist Alice so verÃ¤rgert Ã¼ber diesen Film?",
          "source_text": "Why is Alice so bugged about this film?",
          "transcription_review_required": false
        },
        "jdob1-11": {
          "path": "res://assets/languages/de/audio/jdob1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b8d64f7005a8f838ee4fd51b61a1408d4d363df372ee2e144182614eab50ebf2",
          "text": "Warum denkst du das?",
          "source_text": "Why do you think that?",
          "transcription_review_required": false
        },
        "jdob1-12": {
          "path": "res://assets/languages/de/audio/jdob1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5ca26697df83f3fad437341fb5661cf10debaa5dcbde1d423c7ef24897d88d14",
          "text": "Aus welchen GrÃ¼nden mÃ¶chte Alice Jimmy treffen?",
          "source_text": "What does Alice say her reasons are for wanting to meet Jimmy?",
          "transcription_review_required": false
        },
        "jdob1-20": {
          "path": "res://assets/languages/de/audio/jdob1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e0a46477e38cbf091fa48c117e87f9ac6783541ef1f14f7660243a9888e4662",
          "text": "Haben Sie eine Idee, wo der Film sein kÃ¶nnte?",
          "source_text": "Do you have any idea where the film could be?",
          "transcription_review_required": false
        },
        "jdob2-10": {
          "path": "res://assets/languages/de/audio/jdob2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "02cbc4ea2cbfcc8e0d7ed7c337cd5366ae8a22277f20310a0b99c05138943131",
          "text": "Wer hÃ¤tte eine Notiz fÃ¤lschen kÃ¶nnen, nur um dieses Treffen zu verhindern?",
          "source_text": "Who could have forged a note just to prevent this meeting?",
          "transcription_review_required": false
        },
        "jdob2-11": {
          "path": "res://assets/languages/de/audio/jdob2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b53670ec166d9bd2d008df7b19be6b21fc24912dd3cd718306b78aacfe76273",
          "text": "Sind Sie sicher, dass Sie es niemandem erzÃ¤hlt haben?",
          "source_text": "Are you sure you didn't tell anyone?",
          "transcription_review_required": false
        },
        "jdob2-12": {
          "path": "res://assets/languages/de/audio/jdob2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "eed9c1d21404ec3c8440ec3d18bae9a88da4d681349f9cb03e7aed85b6509eaa",
          "text": "Waren Sie heute derjenige, der das Labor besuchte?",
          "source_text": "Were you the one who visited the lab today?",
          "transcription_review_required": false
        },
        "jdob2-20": {
          "path": "res://assets/languages/de/audio/jdob2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0cf4bc6447e3181ab3c6dc5546308e8a726c3678230b191ca53b39c5cb95aa83",
          "text": "Glaubst du, Alice hat Angst vor dem, was passiert?",
          "source_text": "You think Alice is afraid of what's happening?",
          "transcription_review_required": false
        },
        "jsha1-10": {
          "path": "res://assets/languages/de/audio/jsha1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e09a7441bc7c59cd95af1ebb6a186e89cc7e52424e7f792ab3176894782be6ea",
          "text": "Haben Sie hier zufÃ¤llig eine Reihe von Filmen gefunden?",
          "source_text": "Did you by any chance find a row of film in here?",
          "transcription_review_required": false
        },
        "jsha1-20": {
          "path": "res://assets/languages/de/audio/jsha1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ec937d6cd9a13535a491f32c2da0fe43c80804a2d4f4989ddb78f0e2daf44e37",
          "text": "Kommst du aus der Gegend? Ich benÃ¶tige Informationen Ã¼ber Phillips Chemikalien.",
          "source_text": "Are you from around here? I need some information about Phillip's chemicals.",
          "transcription_review_required": false
        },
        "jsha1-30": {
          "path": "res://assets/languages/de/audio/jsha1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ee6c1187bdba61f0d2dbe1ec9ab190f9dc9d4264d5f36ce93938422cf4083a9d",
          "text": "Kennen Sie einen Reporter namens Jimmy Mackenzie?",
          "source_text": "Do you know a reporter named Jimmy Mackenzie?",
          "transcription_review_required": false
        },
        "jsha1-31": {
          "path": "res://assets/languages/de/audio/jsha1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8ef97b3d141d55843f21bb9c99abcef4a81deffe87e92c40bb59156e47bbbf5f",
          "text": "Welches GerÃ¼cht?",
          "source_text": "What rumor?",
          "transcription_review_required": false
        },
        "jsha1-32": {
          "path": "res://assets/languages/de/audio/jsha1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7163e16f3deda12ad91d36b0d3f61346e4f17f8f4b47aa7b9ae3ea4e20a52aa0",
          "text": "Wer verbreitet dieses GerÃ¼cht?",
          "source_text": "Who's spreading that rumor?",
          "transcription_review_required": false
        },
        "jsha2-10": {
          "path": "res://assets/languages/de/audio/jsha2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e1b714f916d3ed120e06e91d69794769551e1ce13b0297fa9e584863ace03931",
          "text": "Ich kam, um Alices rotes Perlenkleid abzuholen.",
