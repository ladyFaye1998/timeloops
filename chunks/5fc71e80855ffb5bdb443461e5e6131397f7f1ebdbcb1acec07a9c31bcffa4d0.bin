class_name JuliaFullAdventureView

## End-to-end playable host for the recovered Julia Flower Girl adventure.
##
## This view composes the data-driven location presenter, recovered media
## effect host, modern conversation sheet, inventory, minigames, save slots,
## item zooms, and endings.  It deliberately keeps actions in the illustrated
## scene: the small top strip only exposes persistent player tools.

signal return_to_menu_requested
signal casebook_requested
signal settings_requested
signal game_started(result: Dictionary)
signal game_loaded(result: Dictionary)
signal game_saved(result: Dictionary)
signal locale_changed(locale: String)

const ContentCatalog = preload(
	"res://src/domain/legacy_content_catalog.gd"
)
const LegacySessionScript = preload(
	"res://src/domain/legacy_session.gd"
)
const ClueJournalScript = preload(
	"res://src/domain/clue_journal.gd"
)
const SaveStoreScript = preload("res://src/domain/save_store.gd")
const AdventurePresenterScene: PackedScene = preload(
	"res://scenes/legacy_adventure_presenter.tscn"
)
const EffectHostScene: PackedScene = preload(
	"res://scenes/legacy_effect_host.tscn"
)
const DialogueOverlayScript = preload(
	"res://src/presentation/modern_dialogue_overlay.gd"
)
const OriginalDialogueOverlayScript = preload("res://src/presentation/original_dialogue_overlay.gd")
