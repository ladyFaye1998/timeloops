uniform bool row_active = false;
uniform float shoe_phase = 0.0;
uniform float row_phase = 0.0;

float edge_distance(vec2 point, vec2 start, vec2 end) {
	vec2 edge = end-start;
	return length(point-start-edge*clamp(dot(point-start,edge)/dot(edge,edge),0.0,1.0));
}

// Centreline of the boot's neon tube on the fixes-88 street1 plate (street1-gpt-1a-fixed2,
// sha256 411a6511...), in stage px: toe tip, instep, top-left exit; then top-right exit, back,
// heel, sole, toe tip. Two segments cross behind the rod. Re-trace if the sign is repainted.
float shoe_outline(vec2 point) {
	float distance = 10000.0;
	distance = min(distance,edge_distance(point,vec2(6.2,32.0),vec2(12.1,21.4)));
	distance = min(distance,edge_distance(point,vec2(12.1,21.4),vec2(22.4,16.6)));
	distance = min(distance,edge_distance(point,vec2(22.4,16.6),vec2(33.7,19.6)));
	distance = min(distance,edge_distance(point,vec2(33.7,19.6),vec2(49.3,29.9)));
	distance = min(distance,edge_distance(point,vec2(49.3,29.9),vec2(59.8,32.8)));
	distance = min(distance,edge_distance(point,vec2(59.8,32.8),vec2(74.0,33.3)));
	distance = min(distance,edge_distance(point,vec2(74.0,33.3),vec2(90.2,30.8)));
	distance = min(distance,edge_distance(point,vec2(90.2,30.8),vec2(101.2,26.2)));
	distance = min(distance,edge_distance(point,vec2(101.2,26.2),vec2(109.0,19.6)));
	distance = min(distance,edge_distance(point,vec2(109.0,19.6),vec2(113.8,10.6)));
	distance = min(distance,edge_distance(point,vec2(113.8,10.6),vec2(115.4,0.0)));
	distance = min(distance,edge_distance(point,vec2(124.6,0.0),vec2(154.7,15.5)));
	distance = min(distance,edge_distance(point,vec2(154.7,15.5),vec2(149.0,34.5)));
	distance = min(distance,edge_distance(point,vec2(149.0,34.5),vec2(155.0,59.8)));
	distance = min(distance,edge_distance(point,vec2(155.0,59.8),vec2(154.8,67.5)));
	distance = min(distance,edge_distance(point,vec2(154.8,67.5),vec2(153.1,77.9)));
	distance = min(distance,edge_distance(point,vec2(153.1,77.9),vec2(149.7,91.0)));
	distance = min(distance,edge_distance(point,vec2(149.7,91.0),vec2(146.4,93.6)));
	distance = min(distance,edge_distance(point,vec2(146.4,93.6),vec2(116.9,84.1)));
	distance = min(distance,edge_distance(point,vec2(116.9,84.1),vec2(117.8,73.2)));
	distance = min(distance,edge_distance(point,vec2(117.8,73.2),vec2(112.9,70.3)));
	distance = min(distance,edge_distance(point,vec2(112.9,70.3),vec2(86.7,73.4)));
	distance = min(distance,edge_distance(point,vec2(86.7,73.4),vec2(68.2,65.5)));
	distance = min(distance,edge_distance(point,vec2(68.2,65.5),vec2(50.9,59.4)));
	distance = min(distance,edge_distance(point,vec2(50.9,59.4),vec2(22.9,51.7)));
	distance = min(distance,edge_distance(point,vec2(22.9,51.7),vec2(11.5,41.6)));
	distance = min(distance,edge_distance(point,vec2(11.5,41.6),vec2(6.2,32.0)));
	return 1.0-smoothstep(1.5,4.0,distance);
}

void fragment() {
	vec2 pixel = UV * vec2(640.0,480.0);
	vec3 painted = texture(TEXTURE,UV).rgb;
	vec3 color = painted;
	float opacity = 0.0;
	// The source click cycles the projecting shoe's orange/yellow neon outline.
	if (shoe_active && pixel.x < 164.0 && pixel.y < 110.0) {
		float outline = smoothstep(0.20,0.42,painted.r-painted.b) * smoothstep(0.50,0.78,painted.r);
		float chase = 0.5 + 0.5 * sin(shoe_phase * 13.0 - pixel.x * 0.045);
		color = mix(vec3(1.0,0.29,0.08),vec3(1.0,0.93,0.25),chase);
		opacity = outline * shoe_outline(pixel) * 0.80;
	}
	// The separate ambient event lights the small boots on the repair sign.
	float row_band = pixel.y + pixel.x * 0.32;
	if (row_active && pixel.x > 210.0 && pixel.x < 352.0 && row_band > 148.0 && row_band < 168.0) {
		float boot = smoothstep(0.08,0.25,painted.r-painted.b) * (1.0-smoothstep(0.65,0.87,painted.g));
		float chase = 0.5 + 0.5 * sin(row_phase * 12.0 - floor((pixel.x-210.0)/14.0) * 0.8);
		color = mix(painted,vec3(1.0,0.36,0.08),chase * 0.8);
		opacity = boot;
	}
	COLOR = vec4(color,opacity);
}
␀␀␀␀␀␀␀␀[remap]

