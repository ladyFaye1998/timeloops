      "source": "res://assets/legacy/external_media/heb/asit/trivia/question39.bmp",
      "source_sha256": "48be4a93e6d6020e5985baa3c40e8cddaceefc9db6426a1e836244a11e8d8b48"
    },
    "40": {
      "he": "×‘×©× ×•×ª ×”-×©×™×©×™× ×”××•×¤× ×” ×”×™×ª×”: ×©×™×¢×¨ ××¨×•×š ×œ×’×‘×¨×™× ×•×¨×™×¡×™× ×ž×•×“×‘×§×™× ×œ× ×©×™×.",
      "en": "In the sixties, the fashion was long hair for men and false eyelashes for women.",
      "audio": "shyAn67",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question40.bmp",
      "source_sha256": "4a6fdcaa310d5bd44c4b7cfa49372f00f0c7672b2b1bbe9a311c1d60379d3191"
    },
    "41": {
      "he": "\"×ª×¨×‘×•×ª ×”× ×’×“\" ×”×•× ××—×“ ×”×©×ž×•×ª ×©× ×™×ª×Ÿ ×œ×ª×¨×‘×•×ª ×”× ×¢×•×¨×™× ×©×œ ×™×œ×“×™ ×”×¤×¨×—×™×.",
      "en": "Counterculture is one of the names given to the youth culture of the flower children.",
      "audio": "shyAn68",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question41.bmp",
      "source_sha256": "71d0f63c4e9e8d489a6ad0ebdfa3069446178a8830b8aad2df9a7aac7d1e9698"
    },
    "42": {
      "he": "×‘×©× ×•×ª ×”×©×™×©×™× × ×¨×¦×—×• ×’× ×’'×•×Ÿ ×§× ×“×™ ×•×’× ×¨×•×‘×¨×˜ ×§× ×“×™.",
      "en": "Both John Kennedy and Robert Kennedy were assassinated in the sixties.",
      "audio": "shyAn69",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question42.bmp",
      "source_sha256": "250ada3ee4eebf114a006cf07dc2fe003a3e7747d17e542222296ad1e3b8ad7f"
    },
    "43": {
      "he": "×’'×™×ž×™ ×”× ×“×¨×™×§×¡ ×”×ª×¤×¨×¡× ×‘×©×œ ×”×¢×™×‘×•×“ ×”×¨×•×§×™×¡×˜×™ ×œ×”×ž× ×•×Ÿ ×”××ž×¨×™×§× ×™.",
      "en": "Jimi Hendrix became famous for his rock arrangement of the American national anthem.",
      "audio": "shyAn70",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question43.bmp",
      "source_sha256": "13c3bccff4576b9bee3d7467f38e813e72662a96547266af8436f7b2d1795767"
    },
    "44": {
      "he": "×”×ž×™×§×¨×•×’×œ ×œ× ×”×™×” ×§×™×™× ×‘×©× ×•×ª ×”×©×™×©×™×.",
      "en": "The microwave oven did not exist in the sixties.",
      "audio": "shyAn71",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question44.bmp",
      "source_sha256": "3c744fa63fc8119667b4a11114e2cc190ffbf49fe780457c96cba83c14b3942a"
    },
    "45": {
      "he": "\"×”×“×œ×ª×•×ª\" ×”×•× ×©×ž×” ×©×œ ×”×’×™×¨×¡×” ×”×¨××©×•× ×” ×©×œ ×ª×•×›× ×ª ×”×ž×—×©×‘ \"×—×œ×•× ×•×ª\".",
      "en": "The Doors is the name of the first version of the computer software Windows.",
      "audio": "shyAn73",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question45.bmp",
      "source_sha256": "f8fcd9d219081856fcfba7ccbaeec7ff0c49159b4e116ca41dbdf7373af2f3be"
    },
    "46": {
      "he": "×ž×™×™×¡×“×ª ×”×ª× ×•×¢×” ×”×ž×•×“×¨× ×™×ª ×œ×©×—×¨×•×¨ ×”××™×©×” ×”×™× ×‘×˜×™ ×‘×•×¤.",
      "en": "The founder of the modern womenâ€™s liberation movement is Betty Boop.",
      "audio": "shyAn75",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question46.bmp",
      "source_sha256": "ff597de312fc644f161d9b046bedcb4bf89afbda8e99adaacac959d0f61a0b02"
    },
    "47": {
      "he": "\"×™×© ×œ×™ ×—×œ×•×\" ×–×” ×©×ž×• ×©×œ × ××•× ×ž×¤×•×¨×¡× ×©× ×©× ×ž×¨×˜×™×Ÿ ×œ×•×ª×¨ ×§×™× ×’.",
      "en": "I Have a Dream is the name of a famous speech delivered by Martin Luther King.",
      "audio": "shyAn77",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question47.bmp",
      "source_sha256": "ca9e1a7c91b98c162770e82280804daa46c7f18235f530052e488f6e2a4209ee"
    },
    "48": {
      "he": "×‘×©× ×•×ª ×”×©×™×©×™× ×›×‘×¨ ×”×•×©×§×” ×’×™×¨×¡×” ×¨××©×•× ×” ×©×œ ×”××™× ×˜×¨× ×˜.",
      "en": "An early version of the Internet had already launched in the sixties.",
      "audio": "shyAn78",
      "source": "res://assets/legacy/external_media/heb/asit/trivia/question48.bmp",
      "source_sha256": "6fd8a7e68365522b94c18099b0460e6c322ffb34ec4c69aa3fcafee35370c2ec"
    }
  }
}
