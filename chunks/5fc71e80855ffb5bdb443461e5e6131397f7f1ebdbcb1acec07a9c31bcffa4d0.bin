        "jmeab-02": {
          "path": "res://assets/languages/cs/audio/jmeab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a125029f8d1b1f2928f3eb4042cbfaed2631059ff59687bde2fc002692e65df9",
          "text": "DÃ­ky, Å¾e jsi mÄ› sem dostal!",
