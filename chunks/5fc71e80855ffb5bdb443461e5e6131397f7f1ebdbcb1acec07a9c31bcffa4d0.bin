          "transcription_review_required": false
        },
        "jshb1-10": {
          "path": "res://assets/languages/de/audio/jshb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "edbf69c2da800346b1bfe9a2c9faad662608f8e9253da35abf63f558d6e1a48c",
          "text": "Sehen Sie Jimmy McKenzie?",
