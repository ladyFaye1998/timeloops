“c†c;ÙRâ¯ò¾Á¡-Ø)ÎP.2¹ŒÛ‚Š.èî·Ù~ƒqx:¨ Ïy\oçÝgÓR?®™©èÄ¹Î?;üHk¹x?4N>è—Nf ¯8Ë''bÄ:iÅ␀áq©–|šItÁ­u?‰sVLyFÚ¨F•-qñ“ú‰»j¬ß:‡G¤£©´öIƒœo+m¯vÇ.œà7ÙÓÞ››Ê±} °QÿŽÿ¡æ6!˜Ñ$¶ºðç‰ÙªjÔ³9XXç1Èºlì~¾€Yæ¿ñFñ8çb‹kíù…â„–&§	pOV¹y\æ«ñ}ÓÏ’Î ¦€cûŒ³êñçó¶öŸ]v°]6û¯{J÷Î;1ÝÏs=½ê]ú)>Ú/Âá«oêà4]Ö‡wï¨n^íÉÆËWÄÅ³J9uöÕìÞÈGr”ÛÍ¹­‡QƒÜð÷ÌõãlÍ”ýìrt'KŸ8³G¸ò¼Â:óWü¢î=³­=­¡Éx„Ïò;=wëyÛ7×òåuã½’qQ»M(Ô»qÉ¯Š«7þP¿b;Ì£ÒL>í_çôÂ¾åøAQê/<¼f␀÷øs×9ÜO|¬2Í?YÞ4çè\ÝÖ~çY2Œ¼V␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;

// A single closed drawing owns the lips and body. One authored open drawing
// supplies only the inside of the mouth: tooth rows are never opacity blended.
uniform sampler2D oral_image : source_color, filter_linear, repeat_disable;
uniform vec2 source_size = vec2(1.0);
uniform vec2 oral_size = vec2(1.0);
uniform vec4 mouth_bounds = vec4(0.0);
// Optional face-interior half-plane: normalized XY, signed offset, feather px.
// All-zero default disables it, preserving existing rigs and mouth timing.
uniform vec4 mouth_protection_boundary = vec4(0.0);
// center x, half width, corner mean y, half the right-minus-left corner slope.
uniform vec4 closed_geometry = vec4(0.0);
uniform vec4 open_geometry = vec4(0.0);
uniform vec2 closed_edges = vec2(0.0);
// outside top, inside top, inside bottom, outside bottom at the mouth center.
uniform vec4 open_edges = vec4(0.0);
uniform float closed_inner_top[9];
uniform float closed_inner_bottom[9];
uniform float oral_top[9];
uniform float oral_bottom[9];
uniform float aperture : hint_range(0.0, 1.0) = 0.0;
uniform float rounding : hint_range(0.0, 1.0) = 0.0;
// Optional authored expression contours deform the same canonical lip ink.
// No second raster outline is blended. Zero strength keeps the old branch.
uniform bool expression_enabled = false;
uniform float expression_amount : hint_range(0.0, 1.0) = 0.0;
uniform vec4 expression_bounds = vec4(0.0);
uniform vec4 expression_geometry = vec4(0.0);
uniform vec2 expression_edges = vec2(0.0);
uniform float expression_inner_top[9];
uniform float expression_inner_bottom[9];
uniform bool expression_outer_contours_enabled = false;
uniform float expression_neutral_outer_top[9];
uniform float expression_neutral_outer_bottom[9];
uniform float expression_outer_top[9];
uniform float expression_outer_bottom[9];
varying vec4 item_tint;

void vertex() { item_tint = COLOR; }

float remap(float value, float a, float b, float c, float d) {
    return mix(c, d, clamp((value-a)/max(0.001,b-a),0.0,1.0));
}
float arch(float u) { return pow(max(0.0,1.0-u*u),0.72); }
vec4 closed_contour(float u) {
    float point=clamp((u+1.0)*4.0,0.0,7.999);
    int index=int(floor(point));
    float inner_top=mix(closed_inner_top[index],closed_inner_top[index+1],fract(point));
    float inner_bottom=mix(closed_inner_bottom[index],closed_inner_bottom[index+1],fract(point));
    float corner=closed_geometry.z+closed_geometry.w*u;
    float top=corner+(closed_edges.x-closed_geometry.z)*arch(u);
    float bottom=corner+(closed_edges.y-closed_geometry.z)*arch(u);
    return vec4(min(top,inner_top-0.5),inner_top,inner_bottom,max(bottom,inner_bottom+0.5));
}
vec4 open_contour(float u) {
    vec4 result=vec4(open_geometry.z+open_geometry.w*u)+(open_edges-vec4(open_geometry.z))*arch(u);
    float point=clamp((u+1.0)*4.0,0.0,7.999);
    int index=int(floor(point));
    result.y=mix(oral_top[index],oral_top[index+1],fract(point));
    result.z=mix(oral_bottom[index],oral_bottom[index+1],fract(point));
    return result;
}
float mapped_y(float y, vec4 target, vec4 original, float first, float last) {
    if (y<target.x) return remap(y,mouth_bounds.y,target.x,first,original.x);
    if (y<target.y) return remap(y,target.x,target.y,original.x,original.y);
    if (y<target.z) return remap(y,target.y,target.z,original.y,original.z);
    if (y<target.w) return remap(y,target.z,target.w,original.z,original.w);
    return remap(y,target.w,mouth_bounds.y+mouth_bounds.w,original.w,last);
}
vec4 expression_contour(float u) {
    float point=clamp((u+1.0)*4.0,0.0,7.999);
    int index=int(floor(point));
    float inner_top=mix(expression_inner_top[index],expression_inner_top[index+1],fract(point));
    float inner_bottom=mix(expression_inner_bottom[index],expression_inner_bottom[index+1],fract(point));
    float corner=expression_geometry.z+expression_geometry.w*u;
    float top=corner+(expression_edges.x-expression_geometry.z)*arch(u);
    float bottom=corner+(expression_edges.y-expression_geometry.z)*arch(u);
    return vec4(min(top,inner_top-0.5),inner_top,inner_bottom,max(bottom,inner_bottom+0.5));
}
vec4 expression_outer_samples(float u) {
    float point=clamp((u+1.0)*4.0,0.0,7.999);
    int index=int(floor(point));
    return mix(vec4(expression_neutral_outer_top[index],expression_neutral_outer_bottom[index],expression_outer_top[index],expression_outer_bottom[index]),vec4(expression_neutral_outer_top[index+1],expression_neutral_outer_bottom[index+1],expression_outer_top[index+1],expression_outer_bottom[index+1]),fract(point));
}
float expression_map_y(float y,vec4 target,vec4 original,vec4 bounds) {
    float first=bounds.y;
    float last=first+bounds.w;
    if (y<target.x) return remap(y,first,target.x,first,original.x);
    if (y<target.y) return remap(y,target.x,target.y,original.x,original.y);
    if (y<target.z) return remap(y,target.y,target.z,original.y,original.z);
    if (y<target.w) return remap(y,target.z,target.w,original.z,original.w);
    return remap(y,target.w,last,original.w,last);
}
float expression_map_x(float x,float center,float width,vec4 original,vec4 bounds) {
    float u=clamp((x-center)/max(1.0,width),-1.0,1.0);
    if (x<center-width) return remap(x,bounds.x,center-width,bounds.x,original.x-original.y);
    if (x>center+width) return remap(x,center+width,bounds.x+bounds.z,original.x+original.y,bounds.x+bounds.z);
    return original.x+u*original.y;
}
float protected_expression_sample(vec2 p) {
    if (dot(mouth_protection_boundary.xy,mouth_protection_boundary.xy)<=0.5) return 1.0;
    return smoothstep(0.0,max(0.1,mouth_protection_boundary.w),dot(mouth_protection_boundary.xy,p)+mouth_protection_boundary.z);
}
void fragment() {
    vec4 base=texture(TEXTURE,UV);
    vec2 pixel=UV*source_size;
    vec2 edge=min(pixel-mouth_bounds.xy,mouth_bounds.xy+mouth_bounds.zw-pixel);
    float mask=smoothstep(0.0,5.0,min(edge.x,edge.y));
    if (dot(mouth_protection_boundary.xy,mouth_protection_boundary.xy)>0.5) {
        float interior=dot(mouth_protection_boundary.xy,pixel)+mouth_protection_boundary.z;
        mask*=smoothstep(0.0,max(0.1,mouth_protection_boundary.w),interior);
    }
    if (expression_enabled && expression_amount>0.0) {
        float strength=clamp(expression_amount,0.0,1.0);
        // The optional path must approach the exact old speech deformation at
        // zero weight, including its source contour and surrounding mask.
        vec4 active_bounds=mix(mouth_bounds,expression_bounds,strength);
        vec2 expr_edge=min(pixel-active_bounds.xy,active_bounds.xy+active_bounds.zw-pixel);
        float expr_mask=smoothstep(0.0,5.0,min(expr_edge.x,expr_edge.y))*protected_expression_sample(pixel);
        if (expr_mask>0.0) {
            vec4 geometry=mix(closed_geometry,expression_geometry,strength);
            float width=mix(geometry.y,open_geometry.y,aperture)*(1.0-rounding*0.18);
            float u=clamp((pixel.x-geometry.x)/max(1.0,width),-1.0,1.0);
            vec4 neutral=closed_contour(u);
            vec4 expressed=expression_contour(u);
            if (expression_outer_contours_enabled) {
                vec4 outer=expression_outer_samples(u);
                // While closed, the traced ink contours fully register both
                // sources. At speech onset preserve the old geometry in the
                // zero-expression limit, without a discrete branch switch.
                float trace_weight=strength/max(.000001,strength+aperture*(1.0-strength));
                neutral.x=mix(neutral.x,min(outer.x,neutral.y-.5),trace_weight);
                neutral.w=mix(neutral.w,max(outer.y,neutral.z+.5),trace_weight);
                expressed.x=min(outer.z,expressed.y-.5);
                expressed.w=max(outer.w,expressed.z+.5);
            }
            vec4 closed=mix(neutral,expressed,strength);
            vec4 opened=open_contour(u);
            float anchored=geometry.z+geometry.w*u;
            float source_corner=open_geometry.z+open_geometry.w*u;
            float top=mix(closed.y,anchored+opened.y-source_corner,aperture);
            float bottom=mix(closed.z,anchored+opened.z-source_corner,aperture);
            vec4 target=vec4(top-(closed.y-closed.x),top,bottom,bottom+(closed.w-closed.z));
            vec2 neutral_sample=vec2(expression_map_x(pixel.x,geometry.x,width,closed_geometry,active_bounds),expression_map_y(pixel.y,target,neutral,active_bounds));
            expr_mask*=protected_expression_sample(neutral_sample);
            // Authored target geometry moves one canonical ink edge. The
            // original oral drawing remains the only teeth/cavity source.
            vec3 lips=texture(TEXTURE,neutral_sample/source_size).rgb;
            if (aperture>0.0001) {
                float oral_y=remap(pixel.y,target.y,target.z,opened.y,opened.z);
                vec3 interior=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,oral_y)/oral_size).rgb;
                vec3 cavity=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,mix(opened.y,opened.z,0.50))/oral_size).rgb;
                vec3 lower_cavity=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,mix(opened.y,opened.z,0.70))/oral_size).rgb;
                if (dot(lower_cavity,vec3(0.2126,0.7152,0.0722)) < dot(cavity,vec3(0.2126,0.7152,0.0722))) cavity=lower_cavity;
                interior=mix(cavity,interior,smoothstep(1.2,3.5,target.z-target.y));
                float gap=min(pixel.y-target.y,target.z-pixel.y);
                float inside=smoothstep(-0.25,0.5,gap)*smoothstep(0.0,0.8,target.z-target.y);
                lips=mix(lips,interior,inside);
            }
            base.rgb=mix(base.rgb,lips,expr_mask);
        }
    } else if (aperture>0.0001 && mask>0.0) {
        float width=mix(closed_geometry.y,open_geometry.y,aperture)*(1.0-rounding*0.18);
        float offset=pixel.x-closed_geometry.x;
        float u=clamp(offset/max(1.0,width),-1.0,1.0);
        vec4 original=closed_contour(u);
        vec4 opened=open_contour(u);
        // Corners remain attached to the same face. Upper and lower lip
        // thickness are preserved instead of squashing a rectangular patch.
        float anchored=closed_geometry.z+closed_geometry.w*u;
        float source_corner=open_geometry.z+open_geometry.w*u;
        float top=mix(original.y,anchored+opened.y-source_corner,aperture);
        float bottom=mix(original.z,anchored+opened.z-source_corner,aperture);
        vec4 target=vec4(top-(original.y-original.x),top,bottom,bottom+(original.w-original.z));
        float source_x=closed_geometry.x+u*closed_geometry.y;
        if (offset < -width) source_x=remap(pixel.x,mouth_bounds.x,closed_geometry.x-width,mouth_bounds.x,closed_geometry.x-closed_geometry.y);
        if (offset > width) source_x=remap(pixel.x,closed_geometry.x+width,mouth_bounds.x+mouth_bounds.z,closed_geometry.x+closed_geometry.y,mouth_bounds.x+mouth_bounds.z);
        float source_y=mapped_y(pixel.y,target,original,mouth_bounds.y,mouth_bounds.y+mouth_bounds.w);
        if (dot(mouth_protection_boundary.xy,mouth_protection_boundary.xy)>0.5) {
            float source_interior=dot(mouth_protection_boundary.xy,vec2(source_x,source_y))+mouth_protection_boundary.z;
            mask*=smoothstep(0.0,max(0.1,mouth_protection_boundary.w),source_interior);
        }
        vec3 lips=texture(TEXTURE,vec2(source_x,source_y)/source_size).rgb;
        float oral_y=remap(pixel.y,target.y,target.z,opened.y,opened.z);
        vec3 interior=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,oral_y)/oral_size).rgb;
        // Teeth cannot resolve inside a subpixel opening. Reveal the one
        // interior only once there is room for it, avoiding a dotted white
        // seam as the lips part. The narrow gap samples the authored cavity.
        vec3 cavity=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,mix(opened.y,opened.z,0.50))/oral_size).rgb;
        vec3 lower_cavity=texture(oral_image,vec2(open_geometry.x+u*open_geometry.y,mix(opened.y,opened.z,0.70))/oral_size).rgb;
        if (dot(lower_cavity,vec3(0.2126,0.7152,0.0722)) < dot(cavity,vec3(0.2126,0.7152,0.0722))) cavity=lower_cavity;
        interior=mix(cavity,interior,smoothstep(1.2,3.5,target.z-target.y));
        float gap=min(pixel.y-target.y,target.z-pixel.y);
        float inside=smoothstep(-0.25,0.5,gap)*smoothstep(0.0,0.8,target.z-target.y);
        lips=mix(lips,interior,inside);
        base.rgb=mix(base.rgb,lips,mask);
    }
    COLOR=base*item_tint;
}
