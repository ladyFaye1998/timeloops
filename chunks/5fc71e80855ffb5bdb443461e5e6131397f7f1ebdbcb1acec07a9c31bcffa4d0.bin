0\GŸ­üs^by¨ùçÐ³ÂÄÉÎV>~îøK]¥}Åx<?fs¦m”*J‰½YÔ¢H¾4„Ž^J= Œ‰ž-/ò…=*ú¿5Ï‰zSN©ñœ ©ˆhÅ2ŠKÙ<ðÆ˜ñý–ˆÚ^sðôg?¯2:Žê¯§mØ¿ ïÍhC²·-§âè÷P¿³ÊŽ¯w:ž÷Ë¶dýíÒÏ[.Öú _@èÓ3ÿpVùnèç¶˜k+ä†9¿þïÿÿ2¿2‡ÙýW1v»þY/LuÈSvï¨ïRäNœù¯ò]g¢»zd¿wÌ GÝp9d=t&ëøùšàE´»|ÉáÏæ4Ïê¢ì+ÆºVgš1ÌÛ¸M8»yÚMqß®-úãk¿øl¢·0¢Ÿ/éï,w´DÂñ:7ÆHzæíÇ'´ó¹ûOþBsé’¿¦;ÆþöSñà'l¢ÍÕfžl·³ê&ö”¼Ð·òºÖHF37¾'ö}¼²¦þ9öä3Â¾¯KmCõ3NT?&ÀDJ†Þ•ù×Î]ýx“á€8º·yŽ¯jåêâ¾Ó&/äu}þ|ttéìGd„xÏOæ6^ðA#Ð`|dõ>…S`#î^ÌG;ð8øÌÍà‰cùN÷¦FÝÓì•/=Õ³à)žÞ·ü¤¹¹Üa‡]x»c‚ÁÙ½ôö•6#çxCø£‡ã~žåˆª¶fêÎìƒÛ†é…*Ç¿©Å¸!³ïZ‡W6ÞÛÿrü‚óéŽóÍÞÎõYu0cÔäôº␀␀class_name JuliaGameLocalization
extends RefCounted

## Language affects presentation only; the recovered session keeps its state.
const CODES: Array[String] = ["he", "en", "fr", "de", "pl", "ru", "cs", "nl"]
const NAMES: Array[String] = ["×¢×‘×¨×™×ª", "English", "FranÃ§ais", "Deutsch", "Polski", "Ð ÑƒÑÑÐºÐ¸Ð¹", "ÄŒeÅ¡tina", "Nederlands"]
const CONTENT_CODES := {"he":"heb", "en":"eng", "fr":"fre", "de":"ger", "pl":"pol", "ru":"rus", "cs":"cze", "nl":"dut"}
static var current: String = "he"
static var _catalogs: Dictionary = {}
static var _voice_manifest: Dictionary = {}
static var _image_manifest: Dictionary = {}
static var _questions: Dictionary = {}
static var _voice_aliases: Dictionary = {}
static var _voice_paths: Dictionary = {}
static var _templates: Dictionary = {}
static var _font: Font

static func normalize(value: String) -> String:
	var code: String = value.to_lower().replace("_", "-").get_slice("-", 0)
	for key: String in CONTENT_CODES:
		if code == CONTENT_CODES[key]: return key
	return code if code in CODES else "he"

static func _catalog(locale: String) -> Dictionary:
	if not _catalogs.has(locale):
		var path: String = "res://data/locales/%s.json" % locale
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path)) if FileAccess.file_exists(path) else {}
		_catalogs[locale] = parsed if parsed is Dictionary else {}
	return _catalogs[locale]

static func text(source: String, locale: String = "") -> String:
	var code: String = normalize(locale) if not locale.is_empty() else current
	var catalog: Dictionary = _catalog(code)
	if catalog.has(source): return str(catalog[source])
	if not _templates.has(code):
		var path: String = "res://data/locales/templates.%s.json" % code
		var entries: Variant = JSON.parse_string(FileAccess.get_file_as_string(path)) if FileAccess.file_exists(path) else []
		var compiled: Array = []
		for entry: Dictionary in entries:
			var expression := RegEx.new()
			if expression.compile(str(entry.pattern)) == OK: compiled.append({"regex":expression, "text":entry.text})
		_templates[code] = compiled
	for entry: Dictionary in _templates[code]:
		var matched: RegExMatch = entry.regex.search(source)
		if matched != null:
			var translated: String = str(entry.text)
			for index: int in range(1, matched.get_group_count()+1):
				var captured: String = matched.get_string(index)
				translated = translated.replace("{p%d}" % (index-1), str(catalog.get(captured, captured)))
			return translated
	return source

static func font() -> Font:
	if _font == null:
		var path: String = "res://assets/fonts/noto-sans/NotoSans-wdth-wght.ttf"
		if ResourceLoader.exists(path): _font = load(path) as Font
		if _font == null:
			var raw := FontFile.new()
			raw.data = FileAccess.get_file_as_bytes(path)
			_font = raw
	return _font

static func voice_path(member: String) -> String:
	if current == "he": return ""
	if _voice_manifest.is_empty() and FileAccess.file_exists("res://data/voice_languages.json"):
		_voice_manifest = JSON.parse_string(FileAccess.get_file_as_string("res://data/voice_languages.json"))
		for code: String in _voice_manifest.get("languages", {}):
			var paths: Dictionary = {}
			for name: String in _voice_manifest.languages[code].get("clips", {}):
				paths[_voice_key(name)] = str(_voice_manifest.languages[code].clips[name].get("path", ""))
			_voice_paths[code] = paths
		if FileAccess.file_exists("res://data/voice_aliases.json"):
			_voice_aliases = JSON.parse_string(FileAccess.get_file_as_string("res://data/voice_aliases.json"))
	var key: String = _voice_key(member)
	var paths: Dictionary = _voice_paths.get(current, {})
	return str(paths.get(key, paths.get(str(_voice_aliases.get(key, "")), "")))

static func _voice_key(member: String) -> String:
	var value: String = member.get_file().get_basename().to_lower()
	var result: String = ""
	for index: int in value.length():
		var character: String = value.substr(index,1)
		if character in "abcdefghijklmnopqrstuvwxyz0123456789": result += character
	return result

static func voice_text(member: String) -> String:
	voice_path(member)
	var clips: Dictionary = _voice_manifest.get("languages",{}).get(current,{}).get("clips",{})
	return str(clips.get(member.to_lower(),{}).get("text",""))

static func localized_image(member: String) -> String:
	if current == "he": return ""
	if _image_manifest.is_empty() and FileAccess.file_exists("res://data/image_languages.json"):
		_image_manifest = JSON.parse_string(FileAccess.get_file_as_string("res://data/image_languages.json"))
	return str(_image_manifest.get("languages", {}).get(current, {}).get(member.to_lower(), ""))

static func question_text(sheet: String, index: int) -> String:
	if _questions.is_empty():
		_questions = JSON.parse_string(FileAccess.get_file_as_string("res://data/dialogue_questions.he.json")).get("sheets", {})
	var values: Array = _questions.get(sheet.to_lower(), [])
	return text(str(values[index])) if index >= 0 and index < values.size() else ""

static func apply_tree(owner: Node) -> void:
	# Remember source strings, so repeated switches never translate a translation.
	# Text assigned by the story is detected independently of presentation changes.
	for node: Node in owner.find_children("*", "Control", true, false):
		var control := node as Control
		if not control.is_visible_in_tree(): continue
		for property: String in ["text", "tooltip_text", "placeholder_text"]:
			if property == "text" and not (control is Label or control is Button or control is RichTextLabel): continue
			if property != "tooltip_text" and not (control is Label or control is Button or control is RichTextLabel or control is LineEdit or control is TextEdit): continue
			if property == "placeholder_text" and not (control is LineEdit or control is TextEdit): continue
			var actual: Variant = control.get(property)
			if not actual is String: continue
			var source_key: String = "localization_source_" + property
			var result_key: String = "localization_result_" + property
			var source: String = str(control.get_meta(source_key, actual))
			if str(actual) != str(control.get_meta(result_key, actual)):
				source = str(actual)
			control.set_meta(source_key, source)
			var translated: String = text(source)
			if str(actual) != translated: control.set(property, translated)
			control.set_meta(result_key, translated)
		if control is Label or control is Button or control is RichTextLabel or control is LineEdit:
			control.set("language", current)
			control.set("text_direction", control.get_meta("localization_text_direction", Control.TEXT_DIRECTION_RTL if current == "he" else Control.TEXT_DIRECTION_LTR))
			if not control.has_meta("localization_original_font"):
				control.set_meta("localization_original_font", control.get_theme_font("font"))
			var desired_font: Font = control.get_meta("localization_original_font") as Font
			if current != "he" and desired_font != font() and font() not in desired_font.fallbacks:
				var fallbacks: Array[Font] = desired_font.fallbacks
				fallbacks.append(font())
				desired_font.fallbacks = fallbacks
			if control.get_theme_font("font") != desired_font: control.add_theme_font_override("font", desired_font)
		if control.has_meta("original_language_label") and str(control.get_meta("original_language_applied", "")) != current:
			_apply_original_label(control as Button)
	for node: Node in owner.find_children("*", "PopupMenu", true, false):
		var popup := node as PopupMenu
		for index: int in popup.item_count:
			var actual: String = popup.get_item_text(index)
			var key: String = "localization_popup_%d" % index
			var previous: String = str(popup.get_meta(key+"_result", actual))
			var source: String = str(popup.get_meta(key, actual)) if actual == previous else actual
			popup.set_meta(key, source)
			var translated: String = text(source)
			if actual != translated: popup.set_item_text(index, translated)
			popup.set_meta(key+"_result", translated)

static func original_label(button: Button, source: String) -> void:
	button.set_meta("original_language_label", source)
	_apply_original_label(button)

static func _apply_original_label(button: Button) -> void:
	button.set_meta("original_language_applied", current)
	var source: String = str(button.get_meta("original_language_label", ""))
	button.text = "" if current == "he" else text(source)
	button.set_meta("localization_source_text", source if current != "he" else "")
	button.set_meta("localization_result_text", button.text)
	for state: String in ["normal", "hover", "pressed", "disabled", "focus"]:
		if current == "he": button.add_theme_stylebox_override(state, StyleBoxEmpty.new())
		else:
			var paper := StyleBoxFlat.new()
			paper.bg_color = Color("f6e3b1") if state != "hover" else Color("ffdb85")
			paper.border_color = Color("8e6336")
			paper.set_border_width_all(1)
			paper.set_corner_radius_all(3)
			paper.content_margin_left = 2; paper.content_margin_right = 2
			button.add_theme_stylebox_override(state, paper)
	if current != "he":
		button.add_theme_font_override("font", font())
		button.add_theme_color_override("font_color", Color("332418"))
		var font_size: int = mini(15, int(button.size.y)-6)
		while font_size > 8 and font().get_string_size(button.text,HORIZONTAL_ALIGNMENT_LEFT,-1,font_size).x > button.size.x-4: font_size -= 1
		button.add_theme_font_size_override("font_size", font_size)
