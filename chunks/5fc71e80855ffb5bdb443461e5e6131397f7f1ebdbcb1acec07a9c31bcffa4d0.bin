îßÎÌÿ1ÏÇg7ë¨4—ó~ûóÞ#x¾fäþýr¦2wÐ^éáŒÈ¬ILÛ*¢ßXëŸú´ðýÇÁ­Ù#Çö&öy(†»gþ¡­"µ’³8Ësƒç)±ÜÕÐo¡ïyÉøRœYº¥Û 'w­–ž&ë|}]»GÅß!mdÌÁ÷õWVæ=¾ŸŸŒ˜rý§{ÿS‡çÜ gZg“äUŸ€cp•xöÿÿ"»ëƒ§wã¼þ@ÜÉÚä␀å“ùüC~ú.¨ãxë¶¢O‡öhz?¤>æO:Qrñ¾›å­ì_?øl‹»Î•å5ü{±õñ¾ë¦çñKÐ0û·žêEZ?7É¡§²å‹Är¸Tš‡Kiõò­N÷J/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
uniform sampler2D underpaint:source_color,filter_linear_mipmap;
uniform vec2 clip_points[32];
uniform int clip_count=0;
void fragment(){
 vec2 p=UV/TEXTURE_PIXEL_SIZE;float d=100000.;bool inside=false;
 for(int i=0;i<32;i++){
  if(i>=clip_count)break;int j=i+1;if(j>=clip_count)j=0;
  vec2 a=clip_points[i];vec2 b=clip_points[j];vec2 v=b-a;
  float t=clamp(dot(p-a,v)/max(dot(v,v),.00001),0.,1.);d=min(d,length(p-(a+t*v)));
  if((a.y>p.y)!=(b.y>p.y)&&p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)inside=!inside;
 }
 float width=max(length(dFdx(p)),length(dFdy(p)))*.8;
 float mask=smoothstep(-width,width,inside?d:-d);
 COLOR=mix(texture(TEXTURE,UV),texture(underpaint,UV),mask);
}
