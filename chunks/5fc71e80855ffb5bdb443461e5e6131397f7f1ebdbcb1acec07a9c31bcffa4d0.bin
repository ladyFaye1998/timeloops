ÿôS8ÿ3;ßyöoVBòÀLÔMÛ¸m,å˜žÇúÒJ8^ïË<ŸMøÑó>YßÆb†í·¼kXà7r¶ô•_UŸžÁÊ\®Dî»(Í‘ïÈ8ú_çaòÿ#ï¸Ròôåp¼#¿ÅØ•/dõêÄðê±<åkÖ›5ž)wáNí¾ô(“žæ¶Ì¸2/Ú:öãý }Ãþ…îKúV§@|Ä2…kAù+'HMè¿D?’Ö~¼:à·ôVùïÛ/ŸÞ%Ü•ÞR¼Ä©ÓÃÆ4ef5;ÅM¨þN¿îÎñGV¢C—Ä7FWK±ºóë¥˜s·þOé8Pœ›æ»Ä<>D÷7r‚Ñ‡AIK°ÞG™Lº]¡?SÍÇÏN“÷G¶/º8"€öýnN¢ÖÞq‹­zQõ¡—cgI\²/␀mf‘[Þº‹=r‚OhteÇrÎ zÒsÑÓ¼û¯:å7ºþºNé‡ø␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

// Director ink 9: the following cast member supplies an inverse grayscale mask.
// Original cursor.ls changes its registration point as the pointer moves.
uniform sampler2D mask_texture : filter_nearest, repeat_disable;
uniform vec2 source_size;
uniform vec2 mask_size;
uniform vec2 pointer;
uniform bool magnifying = false;

void fragment() {
	vec2 pixel = UV * vec2(640.0,480.0);
	vec2 source_offset = magnifying ? clamp(pointer,vec2(0.0),vec2(640.0,430.0)) : vec2(0.0);
	vec2 mask_uv = (pixel - pointer + vec2(magnifying ? 50.0 : 95.0)) / mask_size;
	float inside = step(0.0,mask_uv.x) * step(0.0,mask_uv.y) * step(mask_uv.x,1.0) * step(mask_uv.y,1.0);
	float opacity = (1.0 - texture(mask_texture,mask_uv).r) * inside;
	COLOR = texture(TEXTURE,(pixel + source_offset) / source_size) * vec4(1.0,1.0,1.0,opacity);
}
