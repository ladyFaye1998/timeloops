¾{Å|L€Èš–¸‡¹¹ò(§èà‹q/º‰·ñðgÅøìý¡/èo’{mí ršHÓ;KçÒÝ×g¹ü2Æ‡—ûöbÉiü	¼yÐÒ•ÕNI¿jûf®aÎyúØ¤9Öo…ˆrÏñ␀gx«¤‹°ï1ÿ.Aóà=cnãèŸýÇœ/PºiãÁâì␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node

## Scroll native touch gestures even when a child Button owns the GUI input.
## Godot 4.7's ScrollContainer still bases touch panning on emulated mouse
## events; native ScreenTouch handling in children can consume that path.
const WebLayout = preload("res://src/ui/web_layout.gd")
const DRAG_THRESHOLD: float = 8.0
var _scroll: ScrollContainer
var _finger: int = -1
var _origin := Vector2.ZERO
var _offset: int = 0
var _dragging: bool = false

static func attach(scroll: ScrollContainer) -> void:
	if scroll.has_node("NativeTouchScroll"): return
	var helper = load("res://src/ui/native_touch_scroll.gd").new()
	helper.name = "NativeTouchScroll"
	helper._scroll = scroll
	scroll.add_child(helper)

func _ready() -> void:
	if not WebLayout.enabled(): return
	_connect_controls(_scroll)
	get_tree().node_added.connect(_on_node_added)
	_scroll.resized.connect(_cancel)

func _on_node_added(node: Node) -> void:
	if _scroll.is_ancestor_of(node): _connect_controls(node)

func _connect_controls(node: Node) -> void:
	# Text editors keep their own caret/selection gestures.
	if node is LineEdit or node is TextEdit: return
	if node is RichTextLabel and node.selection_enabled: return
	if node is Control and not node is ScrollBar:
		var callback := _on_gui_input.bind(node as Control)
		if not node.gui_input.is_connected(callback): node.gui_input.connect(callback)
	for child: Node in node.get_children(): _connect_controls(child)

func _clip_rect() -> Rect2:
	var observed: Dictionary = WebLayout.observed_control(_scroll)
	var value: Array = observed.clip_rect
	return Rect2(value[0], value[1], value[2], value[3])

func _on_gui_input(event: InputEvent, control: Control) -> void:
	if not _scroll.is_visible_in_tree():
		_cancel()
		return
	if event is InputEventScreenTouch:
		if event.pressed:
			# One GUI-picked control owns the gesture. Connecting its signal
			# avoids observing controls underneath a modal sheet.
			if _finger != -1:
				if _finger != event.index: _cancel()
				return
			var point: Vector2 = control.get_global_transform_with_canvas() * event.position
			var bar: VScrollBar = _scroll.get_v_scroll_bar()
			if not _clip_rect().has_point(point): return
			if bar.is_visible_in_tree() and WebLayout.control_rect(bar).has_point(point): return
			if _scroll.vertical_scroll_mode == ScrollContainer.SCROLL_MODE_DISABLED or bar.max_value <= bar.page: return
			_finger = event.index
			_origin = point
			_offset = _scroll.scroll_vertical
		elif event.index == _finger:
			if _dragging: control.accept_event()
			_cancel()
	elif event is InputEventScreenDrag and event.index == _finger:
		var point: Vector2 = control.get_global_transform_with_canvas() * event.position
		var distance: Vector2 = point - _origin
		if not _dragging and distance.length() < DRAG_THRESHOLD: return
		if not _dragging:
			_dragging = true
			# This is the same notification used by ScrollContainer. It
			# cancels pending Button presses before the finger is released.
			_scroll.propagate_notification(Control.NOTIFICATION_SCROLL_BEGIN)
		_scroll.scroll_vertical = _offset - roundi(distance.y)
		control.accept_event()

func _cancel() -> void:
	if _dragging and is_instance_valid(_scroll):
		_scroll.propagate_notification(Control.NOTIFICATION_SCROLL_END)
	_dragging = false
	_finger = -1
