    "nl": {
      "clips": {
        "laa-s14": {
          "path": "res://assets/languages/nl/audio/laa-s14.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7099c511afbc301a818800f56cd9aaf136418413c694fe88c944531833b6dff3",
          "text": "Dat duidt niet op een verschil tussen de blauwe en de rode buizen.",
          "source_text": "That doesn't indicate a difference between the blue and the red tubes.",
          "transcription_review_required": false
        },
        "laa1-02a": {
          "path": "res://assets/languages/nl/audio/laa1-02a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f3157bb51874ad07e0748aa0abd3c848d59c140f8fab056c90274c7833b7c7dd",
          "text": "De juiste buis weegt iets minder dan de andere. Mijn weegschaal registreert zulke kleine verschillen niet. GeruÃ¯neerd!",
          "source_text": "The correct tube weighs a little less than the others. My scale doesn't register such small differences. Ruined!",
          "transcription_review_required": false
        },
        "laa1-s12": {
          "path": "res://assets/languages/nl/audio/laa1-s12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0fff31de8bb8010dd28512c4469771d56be483d742accf4dabc1b8f0a13727b6",
          "text": "Je moet iets op de weegschaal leggen om erachter te komen welke buis het minst weegt.",
          "source_text": "You need to put something on the scale to find out which tube weighs less.",
          "transcription_review_required": false
        },
        "laa1-s13": {
          "path": "res://assets/languages/nl/audio/laa1-s13.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c8ced9d250221d7dacff95a6cc9932230bd2ff7242d387dba08da41025668252",
          "text": "Om deze schaal te gebruiken, moet je aan beide kanten iets plaatsen.",
          "source_text": "To use this scale, you need to put something on both sides of it.",
          "transcription_review_required": false
        },
        "laa1-s2": {
          "path": "res://assets/languages/nl/audio/laa1-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bbb3b72ae66614533d5e98470e1f8c3a154a1b3468801453d383903e2b3b29ab",
          "text": "Het verschil is nog niet te zien.",
          "source_text": "It doesn't show the difference yet.",
          "transcription_review_required": false
        },
        "laa1-s3": {
          "path": "res://assets/languages/nl/audio/laa1-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3d5cf29f2141ecfb98c7dbbf9617fc1efff025ba24b77eb2d134cfaa8b610b27",
          "text": "Dit is een grondschaal. Het kan niets wegen dat minder is dan een grond.",
          "source_text": "This is a ground scale. It can't weigh anything that's less than a ground.",
          "transcription_review_required": false
        },
        "laa1-s4": {
          "path": "res://assets/languages/nl/audio/laa1-s4.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "86f05073b706487ee2f757c82cb8446bae0bc5442fbc00388d43f010a9af18a2",
          "text": "Weet je nog dat ik je vertelde dat het probleem is om onderscheid te maken tussen de blauwe en rode buizen? De gele buis is niet relevant.",
          "source_text": "Remember, I told you that the problem is to differentiate between the blue and red tubes? The yellow tube is not relevant.",
          "transcription_review_required": false
        },
        "laa1-s7": {
          "path": "res://assets/languages/nl/audio/laa1-s7.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e6d2c6fed14d9c95b03d7d91e01ee83462ff2b236a7d89c2c90edc2fc6e3921d",
          "text": "Misschien lukt het je ooit wel. Als ik maar lang genoeg leef.",
          "source_text": "Maybe you'll succeed one day. That's if I live long enough.",
          "transcription_review_required": false
        },
        "laa1-s8": {
          "path": "res://assets/languages/nl/audio/laa1-s8.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "63da65890748c4c3b44771e39e8808cdb2f8a93d17674218b97eac771de0285a",
          "text": "Leuk! Nu zie ik dat de blauwe buis minder weegt. Je hebt een vermenigvuldigingstruc gebruikt. Je hebt veel buizen gebruikt om het gewicht van Ã©Ã©n buis te vinden. Al had ik daar ook aan kunnen denken als ik niet zo opgewonden was.",
          "source_text": "Nice! Now I can see that the blue tube weighs less. You used a multiplication trick. You used many tubes to find the weight of one tube. Although I could have thought of that too if I wasn't so agitated.",
          "transcription_review_required": false
        },
        "laa1-s9": {
          "path": "res://assets/languages/nl/audio/laa1-s9.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "69128d676e9b5e4b926edbb0bda8aa45a7bd84a04906aba29e89c56aaef2959e",
          "text": "Probeer erachter te komen welke buis minder weegt. Als je het zeker weet, klik je op het icoontje met je antwoord.",
          "source_text": "Try to find out which tube weighs less. When you know for sure, click on the icon that shows your answer.",
          "transcription_review_required": false
        },
        "mel13": {
          "path": "res://assets/languages/nl/audio/mel13.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a64075ac164b580b3f2c90aee4efb5cf27351813ea5706adc8d2bb80e4c5ef01",
          "text": "Gebruik de weegschaal om erachter te komen welke buis het minst weegt.",
          "source_text": "Use the scale to find out which tube weighs less.",
          "transcription_review_required": false
        },
        "mel14": {
          "path": "res://assets/languages/nl/audio/mel14.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "967ebdc14fba2791d0f6402cf75b0990a6f4d659bab1eab6143c12193202a025",
          "text": "Luister, ik denk dat je deze buizen beter kunt vergeten. Concentreer je meer op de vloeistof die erin zit en het verschil in gewicht.",
          "source_text": "Listen, I think you'd better forget about these tubes. Concentrate more on the liquid inside them, and the difference in their weights.",
          "transcription_review_required": false
        },
        "mel15": {
          "path": "res://assets/languages/nl/audio/mel15.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "50337060e36a738e2dff3e0bb3c9603be18aa6fadf2bab84531a3e37b6c98630",
          "text": "HÃ©, ik heb een idee. Waarom probeer je niet grote hoeveelheden vloeistof te vergelijken? Dat kan op een verschil duiden.",
          "source_text": "Hey, I've got an idea. Why don't you try to compare large quantities of the liquid? That may indicate a difference.",
          "transcription_review_required": false
        },
        "mel16": {
          "path": "res://assets/languages/nl/audio/mel16.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f8ee92939e1c358ded8d1d32c1a4eff171c519e128256b4a1d25b7ff77ce73c3",
          "text": "Jewel, ik zeg je, er stond iets belangrijks op dat briefje. We moeten een manier bedenken om erachter te komen wat het is.",
          "source_text": "Jewel, I'm telling you, something important was written on that note. We've got to think of a way to find out what it is.",
          "transcription_review_required": false
        },
        "mel17": {
          "path": "res://assets/languages/nl/audio/mel17.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bee96fb27c43321f0b5ef015810325d3e6652bda3d4e3511bb3fa431e89d31fe",
          "text": "Als je het briefje zelf niet kunt krijgen, kun je misschien een manier bedenken om het te reproduceren.",
          "source_text": "If you can't get the note itself, maybe you can think of a way to reproduce it.",
          "transcription_review_required": false
        },
        "sub2-s1": {
          "path": "res://assets/languages/nl/audio/sub2-s1.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "66f64023930b892fa7db3cf6424d050b3303c73dcade1812fcf32683cb3762aa",
          "text": "Ze kan er gewoon niet achter komen wat er in het briefje staat.",
          "source_text": "There's just no way she can find out what was written in the note.",
          "transcription_review_required": false
        },
        "mel34": {
          "path": "res://assets/languages/nl/audio/mel34.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "430ef2b7ba9f8a74c8136f1bd595dfd4550f7a4fc3206278954795df74fa39b7",
          "text": "Wil je wat aanwijzingen? Ik heb gehoord dat het bloemenmeisje veel weet.",
          "source_text": "Do you want some clues? I heard that the flower girl knows a lot.",
          "transcription_review_required": false
        },
        "shyan01": {
          "path": "res://assets/languages/nl/audio/shyan01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c4e473c955d08a1fce619928c5e6bfab64dd6bef5782b2600759902f448fd1bd",
          "text": "HÃ©, vreemdeling. Jij bent een reiziger, net als ik. Laten we een klein spelletje trivia spelen. Ik vertel je iets over de jaren zestig, en jij zegt of het waar of niet waar is.",
          "source_text": "Hey, stranger. You're a traveler just like me. Let's play a little game of trivia. I'll tell you something about the 60s, and you tell me if it's true or false.",
          "transcription_review_required": false
        },
        "shyan02": {
          "path": "res://assets/languages/nl/audio/shyan02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07076ae0255800629e9daddf36594ebb85881acfc8586299cb745c978891b8fe",
          "text": "Als mensen gaan slapen, trekken ze hun jassen uit.",
          "source_text": "When people go to sleep, they take off their coats.",
          "transcription_review_required": false
        },
        "shyan03": {
          "path": "res://assets/languages/nl/audio/shyan03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bd71cbe8a02f1de7d3d95e0665a6ebb26da9881f5b2895242bfc2db68a9306f2",
          "text": "Die dicht bij Alice lijkt te zijn. Kennelijk is dat niet zo dichtbij.",
          "source_text": "Who seems to be close to Alice. Apparently, is not that close.",
          "transcription_review_required": false
        },
        "shyan04": {
