          "transcription_review_required": false
        },
        "jdoa2-21": {
          "path": "res://assets/languages/de/audio/jdoa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b30e7a11bb59fb432801ba38905a9ea5305a531dbeac532b90ac04ee20bee13c",
          "text": "Viele Optionen.",
          "source_text": "Many options.",
          "transcription_review_required": false
        },
        "jdoa2-22": {
          "path": "res://assets/languages/de/audio/jdoa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ad8faa1d53a909623e2f66d38b80eafdb76ac9131d9cf3435f77dc90af81db56",
          "text": "Warum vermuten Sie, dass Susan dahinter stecken kÃ¶nnte?",
          "source_text": "Why did you suggest that Susan might be behind this?",
          "transcription_review_required": false
        },
        "jdoa2-30": {
          "path": "res://assets/languages/de/audio/jdoa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "186cae89ddafbc4580b5acbe4788bd9de28275267e7d231cf712c580aea13aeb",
          "text": "Sind Sie gegen etwas allergisch?",
          "source_text": "Are you allergic to something?",
          "transcription_review_required": false
        },
        "jdoa2-40": {
          "path": "res://assets/languages/de/audio/jdoa2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "04467268f5ca2429a84ec22a1cffc573871d3cd9045d90cb8cf676988b278307",
          "text": "Du brauchst dein Taschentuch. Deine Nase lÃ¤uft.",
          "source_text": "You need your handkerchief. Your nose is running.",
          "transcription_review_required": false
        },
        "jdoa2-50": {
          "path": "res://assets/languages/de/audio/jdoa2-50.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5dc34234f22410b5b0bc218d0ee86c96d5e5888425db26ef8a590291bab96689",
          "text": "Hast du einen Spitznamen?",
