÷²Ô-ò5˜ùj5±G$ü¤xò¥dWeží'åXÿÈòƒÅse¡pbsâÝîêYk_<·L°MÙ½¸NòÌîË‚Ï‡7*ŸNrßbæifÖÑùñð…ýÁë÷ôµp"Þsý‡æãÏû®ïRsðe}/Ó™þ¾Fz(Í]üƒ…g¹¥ùÂ¥±¶ý¦þ³ùŸ)c“ôúïÖñmé?þ	ÿÓÅ·õÇŽµc1ŽÑoçž_éwLøx÷àÛÀß…ø'ÿÓv7[ÛÖ3ÿ}zùÊ¹æ9ï#Ž;þˆ§é‡ÑÏMòC‡9½ïûr_óM}q¼â®éRâ1ñG}}B…¼þEƒ¯ÏØò„;à®áq€ô£p˜X-Æ˜÷¼.îÒ2°]o{á,Ú7¹¡.`“»Þ5î\äš×ÊOÙŽñ3Úè ×Ë?K×½þèþ¦vA}Ñ;¢Ùö2*íÿ?®ï˜ú‰ü³>üh_©[žCË2>Ÿ«Þï˜þïšá»Üó@Ú•Ï§¨>@_Ë0ê~ý€_ýéÐ%Oã1Æ¹·­³þÿ.#õ`'àºSnÏÒ²€}w¶}Î%#˜žýé"¿Õ:¦;U7õøZþ¸ÁÐ<þð}Ý'{³ªÈ‘ËY›\/»6cG>€¿¿}¾v8ŠÅ?Mƒ7H}yÝ2$,NÑÇr;)½öÅ‹␀S‰^<.Òvð~>íòTäÎ¨qUcÅ’t␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform vec2 source_size;
uniform vec4 lamp_centers;
uniform float light_amount=0.0;
uniform float sign_amount=0.0;
uniform float sign_progress=0.0;
void fragment(){
	vec2 p=UV*source_size;
	vec3 color=vec3(1.0,0.90,0.58);
	float d=min(length((p-lamp_centers.xy)/vec2(1.0,0.97)),length((p-lamp_centers.zw)/vec2(1.0,0.97)));
	float alpha=(exp(-d*d/128.0)*0.86+exp(-d*d/512.0)*0.20)*light_amount;
	vec2 center=vec2(676.0,405.0);
	vec2 local=(p-center)/vec2(58.0,31.0);
	float inside=1.0-smoothstep(0.55,1.0,dot(local,local));
	if(inside>0.0 && sign_amount>0.0){
		float angle=sin(sign_progress*6.2831853)*0.085*sign_amount;
		mat2 rotate=mat2(vec2(cos(angle),sin(angle)),vec2(-sin(angle),cos(angle)));
		vec2 shifted=center+(rotate*local)*vec2(58.0,31.0);
		vec3 art=texture(TEXTURE,shifted/source_size).rgb;
		float warm=(0.5+0.5*sin(sign_progress*6.2831853))*sign_amount;
		color=art+vec3(0.08,0.045,0.0)*warm;
		alpha=inside*sign_amount;
	}
	COLOR=vec4(color,clamp(alpha,0.0,1.0));
}
