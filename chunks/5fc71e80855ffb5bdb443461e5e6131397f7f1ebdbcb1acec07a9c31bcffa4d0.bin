ìoãÿIüvú@–Íî“ƒiøÛé§•8ZgâÛöÓúï¨Œ&WõÁØÔQ§Ï'àRë&Å±ÈÀÄk×~™eÖBL‹y[ë
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform int variant = 0;
uniform float phase = 0.0;
uniform float amount = 0.0;
void fragment() {
	vec2 point = UV * vec2(640.0,480.0);
	float top = 188.7 - (point.x - 230.3) * 0.40;
	float bottom = 284.2 + (point.x - 230.3) * 0.172;
	vec3 color = texture(TEXTURE,UV).rgb;
	float opacity = 0.0;
	if (variant >= 2 && point.x > 232.0 && point.x < 357.0 && point.y > top + 2.0 && point.y < bottom - 2.0) {
		vec2 poster = vec2((point.x-230.3)/129.0,(point.y-top)/(bottom-top));
		vec2 wave_center = vec2(0.5 + sin(phase * 1.4) * 0.15,0.5);
		float wave = sin(length((poster-wave_center)*vec2(1.0,1.5))*28.0-phase*5.0);
		float envelope = amount;
		vec2 displaced = UV + vec2(sin(poster.y*18.0-phase*4.0),wave) * 0.0035 * envelope;
		vec3 paint = texture(TEXTURE,displaced).rgb;
		vec3 tint = variant == 3 ? vec3(0.20,0.12,0.85) : (variant == 4 ? vec3(0.90,0.81,0.38) : vec3(0.98,0.35,0.13));
		color = mix(paint,tint,(0.18+0.17*wave)*envelope);
		opacity = envelope * 0.88;
	}
	COLOR = vec4(color,opacity);
}
