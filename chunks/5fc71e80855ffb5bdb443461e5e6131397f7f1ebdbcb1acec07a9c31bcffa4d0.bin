          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c6c316839e64b23edc476954443da34b0c6e921cbbfe329a8ff67bfd5ecd3ef",
          "text": "Aber ich habe die Quittung, wie kommt es also, dass jemand anderes das Kleid bereits genommen hat?",
          "source_text": "But I have the receipt, so how come someone else took the dress already?",
          "transcription_review_required": false
        },
        "jsha2-12": {
          "path": "res://assets/languages/de/audio/jsha2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f863698219ebd807f5d7273b8539c8a550be11737c4bef86db1993c5b0ca57c9",
          "text": "Wer hÃ¤tte es Ihrer Meinung nach nehmen kÃ¶nnen?",
