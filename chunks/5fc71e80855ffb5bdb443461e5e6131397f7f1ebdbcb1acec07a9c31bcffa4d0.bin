class_name JuliaEvidenceJournalView

## Full-screen evidence reader for the modern Julia presentation layer.
##
## The view can either bind directly to JuliaClueJournal or receive plain entry
## dictionaries through update_entries(). Localized interface copy is injected
## as a dictionary or a one-argument Callable that accepts a copy key.

signal close_requested
signal entry_selected(clue_id: String)
signal entry_read_requested(clue_id: String)

const UI_FONT_PATH: String = "res://assets/fonts/heebo/Heebo-wght.ttf"
const WebLayout = preload("res://src/ui/web_layout.gd")
const NativeTouchScroll = preload("res://src/ui/native_touch_scroll.gd")

## The casebook deliberately takes its colours from the illustrated 1967 world,
## not from a contemporary dark dashboard. It should read as a physical prop.
const INK: Color = Color("304955")
const MUTED: Color = Color("786556")
const DESK: Color = Color("40362b")
const DESK_DARK: Color = Color("203e39")
const PAPER: Color = Color("fbf4df")
const PAPER_LIGHT: Color = Color("fff9e9")
const PAPER_SHADE: Color = Color("e7d1a7")
const RULE_BLUE: Color = Color("6d9b93")
const VERMILION: Color = Color("c94f3c")
const MUSTARD: Color = Color("d4a72c")
const AVOCADO: Color = Color("87963b")
const TEAL: Color = Color("347d75")
const MAGENTA: Color = Color("b64267")
const ROW_HOVER: Color = Color(0.17, 0.37, 0.34, 0.035)
const ROW_SELECTED: Color = Color(0.17, 0.37, 0.34, 0.055)
## Web two-page spread: the ring binding spans about 11 px each side of the
## divider, so each page keeps its text this far from it.
const WEB_BINDING_GUTTER: int = 24
## A double tap or double click on Close: for this long after Close, pointer
## presses on its spot are kept from the game that shows there once the
## casebook is gone (at 844x390 the gameplay Settings button lies under it).
const CLOSE_SECOND_PRESS_MSEC: int = 500
## How far off the first the second tap may land: Close's rect grows by this
## much (8 px let a tap 10 to 20 px off reach the game, fixes-87). The shell
## also keeps those presses off a Settings button this spot touches.
const CLOSE_SECOND_PRESS_SLOP: float = 24.0

