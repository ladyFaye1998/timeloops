## Original epilogue text, rendered with the modern Hebrew font and touch UI.
signal profile_requested(profile: int)
signal gallery_requested
signal plot_requested
signal close_requested
const ThemeFactory=preload("res://src/ui/theme_factory.gd")
const TouchScroll=preload("res://src/ui/native_touch_scroll.gd")
# Each portrait sits in a framed window over a soft period-colour backdrop, so
# the bust crops of full-body art end on the frame instead of mid-card.
const PORTRAIT_BACKDROPS: Array[Color]=[Color("f2c46d"),Color("7cc4c2"),Color("ef9a7e"),Color("b9a1dd"),Color("a9c47d"),Color("ec9ab3"),Color("8fb4e6"),Color("dcae79"),Color("8fcfac"),Color("cf98bf")]
const PORTRAIT_FRAME:=Color("9a6a3a")
const PORTRAIT_RADIUS:=10.0
# Every gallery region frames the eyes about 32% down its height.
const PORTRAIT_EYE_LINE:=0.32
const ROUNDED_MASK:="shader_type canvas_item;
uniform vec2 size_px=vec2(100.0);
uniform float radius=10.0;
varying vec2 local_px;
void vertex(){local_px=VERTEX;}
void fragment(){vec2 q=abs(local_px-size_px*0.5)-(size_px*0.5-vec2(radius));float d=length(max(q,0.0))+min(max(q.x,q.y),0.0)-radius;COLOR.a*=clamp(0.5-d,0.0,1.0);}"
static var _rounded_shader: Shader
var content: Dictionary={}
var current_profile: int=0
var screen: String=""
var _page: Control
var _transition: Tween
var _paper: ColorRect
var _story:int=1

func _init() -> void:
	layout_direction=Control.LAYOUT_DIRECTION_LTR
	size=Vector2(640,480)
	z_index=40
	mouse_filter=Control.MOUSE_FILTER_STOP
	theme=ThemeFactory.build(false,false)
	var paper:=ColorRect.new()
	_paper=paper
	paper.layout_direction=Control.LAYOUT_DIRECTION_LTR
	paper.color=ThemeFactory.WARM_WHITE
	paper.size=size
	paper.mouse_filter=Control.MOUSE_FILTER_IGNORE
	add_child(paper)
	content=JSON.parse_string(FileAccess.get_file_as_string("res://data/modern_future_gallery.json"))
	hide()

func fit_to_viewport(available: Vector2) -> void:
	var previous_size:=size
	if available.x<600.0 and available.y>available.x:
		scale=Vector2.ONE
		position=Vector2.ZERO
		size=available
	else:
		size=Vector2(640,480)
		var factor:=minf(available.x/640.0,available.y/480.0)
		scale=Vector2.ONE*factor
		position=(available-size*factor)*0.5
	_paper.size=size
	if size!=previous_size and visible:
		match screen:
			"future":show_gallery()
			"profile":show_profile(current_profile)
			"plot":show_plot(_story)

func _phone() -> bool:
	return size.x<600.0 and size.y>size.x

func _mobile_gallery() -> void:
	_label(content.heading,Rect2(18,12,size.x-36,44),26,HORIZONTAL_ALIGNMENT_RIGHT)
	var scroll:=_scroll(Rect2(12,68,size.x-24,size.y-140),"PortraitCardsScroll")
	var cards:=Control.new()
	cards.layout_direction=Control.LAYOUT_DIRECTION_LTR
	var row_height:=maxf(100.0,(size.y-140.0)/5.0)
	var card_width:float=(size.x-40.0)/2.0
	cards.custom_minimum_size=Vector2(size.x-24,row_height*5)
	cards.mouse_filter=Control.MOUSE_FILTER_IGNORE
	scroll.add_child(cards)
	for index:int in range(content.profiles.size()):
		var profile:Dictionary=content.profiles[index]
		var bounds:=Rect2(4+(1-index%2)*(card_width+8),int(index/2.0)*row_height,card_width,row_height-8)
		var button:=_button("",bounds,profile_requested.emit.bind(index+1),"Future_%d"%(index+1),cards)
		button.tooltip_text=profile.name
		_portrait(profile,Rect2(8,5,card_width-16,row_height-43),button)
		_label(profile.short_name,Rect2(4,row_height-38,card_width-8,28),20,HORIZONTAL_ALIGNMENT_CENTER,button)
	_button("×”×ž×©×š",Rect2(18,size.y-62,size.x-36,48),plot_requested.emit,"FutureExit")
	_reveal()

func _mobile_profile(profile:Dictionary,profile_number:int) -> void:
	_label(content.heading,Rect2(18,12,size.x-36,30),18,HORIZONTAL_ALIGNMENT_RIGHT,null,ThemeFactory.MUTED)
	var portrait_height:=clampf(size.y*0.26,120,230)
	_portrait(profile,Rect2(18,58,size.x-36,portrait_height),_page)
	_label(profile.name,Rect2(18,64+portrait_height,size.x-36,56),26,HORIZONTAL_ALIGNMENT_RIGHT)
	var body_top:float=122+portrait_height
	var scroll:=_scroll(Rect2(18,body_top,size.x-36,maxf(60,size.y-140-body_top)),"BiographyScroll")
	var body:=_label(profile.body,Rect2(0,0,size.x-52,1),20,HORIZONTAL_ALIGNMENT_RIGHT,scroll)
	body.name="Biography"
	body.vertical_alignment=VERTICAL_ALIGNMENT_TOP
	body.custom_minimum_size.x=size.x-52
	_button("×—×–×¨×” ×œ×“×ž×•×™×•×ª",Rect2(18,size.y-62,size.x-36,48),gallery_requested.emit,"BackToFutures")
	var previous:=_button("×”×§×•×“×",Rect2(18,size.y-116,100,44),profile_requested.emit.bind(profile_number-1),"PreviousProfile")
	previous.disabled=profile_number==1
	var next:=_button("×”×‘×",Rect2(128,size.y-116,100,44),profile_requested.emit.bind(profile_number+1),"NextProfile")
	next.disabled=profile_number==10
	var counter:=_label("%d / 10"%profile_number,Rect2(238,size.y-111,size.x-256,34),17,HORIZONTAL_ALIGNMENT_CENTER,null,ThemeFactory.MUTED)
	counter.text_direction=Control.TEXT_DIRECTION_LTR
	counter.set_meta("localization_text_direction",Control.TEXT_DIRECTION_LTR)
	_reveal()

func _mobile_plot(story:int) -> void:
	_label("×”×¡×•×£",Rect2(18,30,size.x-36,55),36,HORIZONTAL_ALIGNMENT_CENTER)
	var scroll:=_scroll(Rect2(24,120,size.x-48,size.y-210),"PlotScroll")
	var body:=_label(content.plots[str(story)].body,Rect2(0,0,size.x-64,1),23,HORIZONTAL_ALIGNMENT_CENTER,scroll)
	body.name="PlotText"
	body.vertical_alignment=VERTICAL_ALIGNMENT_TOP
	body.custom_minimum_size.x=size.x-64
	_button("×¡×™×•×",Rect2(18,size.y-62,size.x-36,48),close_requested.emit,"ClosePlot")
	_reveal()

func _scroll(bounds:Rect2,node_name:String) -> ScrollContainer:
	var scroll:=ScrollContainer.new()
	scroll.name=node_name
	scroll.layout_direction=Control.LAYOUT_DIRECTION_LTR
	scroll.horizontal_scroll_mode=ScrollContainer.SCROLL_MODE_DISABLED
	scroll.set_meta("stage_rect",bounds)
	_page.add_child(scroll)
	scroll.position=bounds.position
	scroll.size=bounds.size
	TouchScroll.attach(scroll)
	return scroll

func show_gallery() -> void:
	_start_page("future")
	current_profile=0
	if _phone():
		_mobile_gallery()
		return
	_label(content.heading,Rect2(24,17,592,48),30,HORIZONTAL_ALIGNMENT_RIGHT)
	for index: int in range(content.profiles.size()):
		var profile: Dictionary=content.profiles[index]
		var bounds:=Rect2(24+(4-index%5)*120,80+int(index/5.0)*151,112,140)
		var button:=_button("",bounds,profile_requested.emit.bind(index+1),"Future_%d"%(index+1))
		button.tooltip_text=profile.name
		var portrait:=_portrait(profile,Rect2(7,6,98,100),button)
		portrait.mouse_filter=Control.MOUSE_FILTER_IGNORE
		_label(profile.short_name,Rect2(2,105,108,32),20,HORIZONTAL_ALIGNMENT_CENTER,button)
	_button("×”×ž×©×š",Rect2(458,411,158,46),plot_requested.emit,"FutureExit")
	_reveal()

func show_profile(profile_number: int) -> void:
	_start_page("profile")
	current_profile=profile_number
	var profile: Dictionary=content.profiles[profile_number-1]
	if _phone():
		_mobile_profile(profile,profile_number)
		return
	_label(content.heading,Rect2(24,18,592,32),18,HORIZONTAL_ALIGNMENT_RIGHT, null,ThemeFactory.MUTED)
	var backing:=Panel.new()
	backing.layout_direction=Control.LAYOUT_DIRECTION_LTR
	backing.position=Vector2(24,80)
	backing.size=Vector2(224,302)
	backing.add_theme_stylebox_override("panel",ThemeFactory.make_box(ThemeFactory.PAPER,Color(ThemeFactory.INK,0.2),1,1,0,0))
	backing.mouse_filter=Control.MOUSE_FILTER_IGNORE
	_page.add_child(backing)
	_portrait(profile,Rect2(28,91,216,284),_page)
	_label(profile.name,Rect2(272,72,344,74),27,HORIZONTAL_ALIGNMENT_RIGHT)
	var body:=_label(profile.body,Rect2(276,153,340,229),20,HORIZONTAL_ALIGNMENT_RIGHT)
	body.name="Biography"
	body.vertical_alignment=VERTICAL_ALIGNMENT_TOP
	_button("×—×–×¨×” ×œ×“×ž×•×™×•×ª",Rect2(440,411,176,46),gallery_requested.emit,"BackToFutures")
	var previous:=_button("×”×§×•×“×",Rect2(24,411,98,46),profile_requested.emit.bind(profile_number-1),"PreviousProfile")
	previous.disabled=profile_number==1
	var next:=_button("×”×‘×",Rect2(132,411,98,46),profile_requested.emit.bind(profile_number+1),"NextProfile")
	next.disabled=profile_number==10
	var counter:=_label("%d / 10"%profile_number,Rect2(268,417,110,34),17,HORIZONTAL_ALIGNMENT_CENTER,null,ThemeFactory.MUTED)
	counter.text_direction=Control.TEXT_DIRECTION_LTR
	counter.set_meta("localization_text_direction",Control.TEXT_DIRECTION_LTR)
	_reveal()

func show_plot(story: int) -> void:
	_start_page("plot")
	_story=story
	if _phone():
		_mobile_plot(story)
		return
	_label("×”×¡×•×£",Rect2(60,62,520,55),36,HORIZONTAL_ALIGNMENT_CENTER)
	var body:=_label(content.plots[str(story)].body,Rect2(72,151,496,204),24,HORIZONTAL_ALIGNMENT_CENTER)
	body.name="PlotText"
	_button("×¡×™×•×",Rect2(224,392,192,48),close_requested.emit,"ClosePlot")
	_reveal()

func _start_page(mode: String) -> void:
	screen=mode
	if _transition!=null and _transition.is_valid():_transition.kill()
	if is_instance_valid(_page):
		remove_child(_page)
		_page.queue_free()
	_page=Control.new()
	_page.layout_direction=Control.LAYOUT_DIRECTION_LTR
	_page.size=size
	_page.mouse_filter=Control.MOUSE_FILTER_IGNORE
	add_child(_page)
	var rule:=ColorRect.new()
	rule.layout_direction=Control.LAYOUT_DIRECTION_LTR
	rule.position=Vector2(24,66)
	rule.size=Vector2(size.x-48,2)
	rule.color=ThemeFactory.MAGENTA
	rule.mouse_filter=Control.MOUSE_FILTER_IGNORE
	if mode=="plot":rule.hide()
	_page.add_child(rule)
	show()

func _reveal() -> void:
	_page.modulate.a=0.0
	call_deferred("_settle_geometry",_page)
	_transition=create_tween()
	_transition.tween_property(_page,"modulate:a",1.0,0.18)

func _settle_geometry(node: Node) -> void:
	if not is_instance_valid(node) or node.is_queued_for_deletion():return
	# Godot settles inherited theme minima and RTL offsets after parenting.
	# Apply the authored stage geometry then, as in the existing trivia view.
	if node is Control and node.has_meta("stage_rect"):
		var bounds: Rect2=node.get_meta("stage_rect")
		node.position=bounds.position
		node.size=bounds.size
		if node is Label and bounds.size.y > 1:
			# Label theme line spacing is absent from Font's string measurement.
			# Fit the actual shaped control after parenting and final width.
			var fitted: int = node.get_theme_font_size("font_size")
			while fitted > 12 and node.get_minimum_size().y > bounds.size.y:
				fitted -= 1
				node.add_theme_font_size_override("font_size",fitted)
				node.size=bounds.size
	for child: Node in node.get_children():_settle_geometry(child)

func _portrait(profile: Dictionary,bounds: Rect2,parent: Control) -> TextureRect:
	var data: Dictionary=profile.portrait
	var window:=Control.new()
	window.layout_direction=Control.LAYOUT_DIRECTION_LTR
	window.mouse_filter=Control.MOUSE_FILTER_IGNORE
	window.set_meta("stage_rect",bounds)
	parent.add_child(window)
	window.size=bounds.size
	window.position=bounds.position
	# Hyphens are folded to spaces for the colour pick only, so correcting the
	# card label to the original spelling ×©×™-××Ÿ keeps her established window.
	var palette_key: String=str(profile.get("short_name","")).replace("-"," ")
	var tint: Color=PORTRAIT_BACKDROPS[absi(palette_key.hash())%PORTRAIT_BACKDROPS.size()]
	var gradient:=Gradient.new()
	gradient.set_color(0,tint.lightened(0.45))
	gradient.set_color(1,tint)
	var backdrop_texture:=GradientTexture2D.new()
	backdrop_texture.gradient=gradient
	backdrop_texture.fill_from=Vector2(0.5,0.0)
	backdrop_texture.fill_to=Vector2(0.5,1.0)
	var backdrop:=TextureRect.new()
	backdrop.texture=backdrop_texture
	backdrop.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
	backdrop.stretch_mode=TextureRect.STRETCH_SCALE
	backdrop.mouse_filter=Control.MOUSE_FILTER_IGNORE
	backdrop.material=_rounded_material(bounds.size)
	window.add_child(backdrop)
	backdrop.size=bounds.size
	var texture:=AtlasTexture.new()
	texture.atlas=load(data.path)
	var region: Array=data.region
	var crop:=Rect2(region[0],region[1],region[2],region[3])
	var frame_aspect: float=bounds.size.x/maxf(bounds.size.y,1.0)
	if frame_aspect>crop.size.x/crop.size.y:
		# A frame wider than the bust (phone cards, profile page) shows its full
		# width with the eye line a third of the way down, instead of a centred
		# crop that cuts across the eyes.
		var visible_height: float=crop.size.x/frame_aspect
		var eye_y: float=float(data.get("eye_y",crop.size.y*PORTRAIT_EYE_LINE))
		var top: float=clampf(eye_y-visible_height*0.35,0.0,crop.size.y-visible_height)
		crop=Rect2(crop.position.x,crop.position.y+top,crop.size.x,visible_height)
	texture.region=crop
	texture.filter_clip=true
	var result:=TextureRect.new()
	result.layout_direction=Control.LAYOUT_DIRECTION_LTR
	result.texture=texture
	result.texture_filter=CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	result.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
	result.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_COVERED
	result.mouse_filter=Control.MOUSE_FILTER_IGNORE
	result.material=_rounded_material(bounds.size)
	result.set_meta("stage_rect",Rect2(Vector2.ZERO,bounds.size))
	window.add_child(result)
	result.size=bounds.size
	var frame:=Panel.new()
	var style:=StyleBoxFlat.new()
	style.draw_center=false
	style.set_border_width_all(2)
	style.border_color=PORTRAIT_FRAME
	style.set_corner_radius_all(int(PORTRAIT_RADIUS))
	style.anti_aliasing=true
	frame.add_theme_stylebox_override("panel",style)
	frame.mouse_filter=Control.MOUSE_FILTER_IGNORE
	window.add_child(frame)
	frame.size=bounds.size
	return result

func _rounded_material(window_size: Vector2) -> ShaderMaterial:
	if _rounded_shader==null:
		_rounded_shader=Shader.new()
		_rounded_shader.code=ROUNDED_MASK
	var material:=ShaderMaterial.new()
	material.shader=_rounded_shader
	material.set_shader_parameter("size_px",window_size)
	material.set_shader_parameter("radius",PORTRAIT_RADIUS)
	return material

func _label(value: String,bounds: Rect2,font_size: int,alignment: HorizontalAlignment,parent: Control=null,color: Color=ThemeFactory.INK) -> Label:
	var label:=Label.new()
	label.text=JuliaGameLocalization.text(value)
	label.set_meta("localization_source_text",value)
	label.set_meta("localization_result_text",label.text)
	label.layout_direction=Control.LAYOUT_DIRECTION_LTR
	label.text_direction=Control.TEXT_DIRECTION_RTL
	label.language="he"
	label.horizontal_alignment=alignment
	label.vertical_alignment=VERTICAL_ALIGNMENT_CENTER
	label.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_font_size_override("font_size",font_size)
	if JuliaGameLocalization.current != "he":
		label.add_theme_font_override("font",JuliaGameLocalization.font())
		label.text_direction=Control.TEXT_DIRECTION_LTR
		label.language=JuliaGameLocalization.current
		var fitted: int = font_size
		if bounds.size.y > 1:
			while fitted > 12 and JuliaGameLocalization.font().get_multiline_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,bounds.size.x,fitted).y > bounds.size.y:
				fitted -= 1
			label.add_theme_font_size_override("font_size",fitted)
	label.add_theme_color_override("font_color",color)
	label.mouse_filter=Control.MOUSE_FILTER_IGNORE
	label.set_meta("stage_rect",bounds)
	(_page if parent==null else parent).add_child(label)
	# Font, wrapping and tree direction must be final before fixed geometry.
	label.size=bounds.size
	label.position=bounds.position
	return label

func _button(value: String,bounds: Rect2,action: Callable,node_name: String,parent:Control=null) -> Button:
	# A landscape phone scales the 640x480 stage down. Keep the footer's
	# real touch area at least 44px and inside the available stage.
	var physical_scale: float = absf(get_global_transform().get_scale().y)
	if physical_scale > 0 and physical_scale < 1:
		bounds.size.y=maxf(bounds.size.y,44.0/physical_scale)
		bounds.position.y=minf(bounds.position.y,size.y-bounds.size.y-4.0)
	var button:=Button.new()
	button.name=node_name
	button.text=JuliaGameLocalization.text(value)
	button.set_meta("localization_source_text",value)
	button.set_meta("localization_result_text",button.text)
	button.layout_direction=Control.LAYOUT_DIRECTION_LTR
	button.text_direction=Control.TEXT_DIRECTION_RTL
	button.language="he"
	button.mouse_default_cursor_shape=Control.CURSOR_POINTING_HAND
	button.add_theme_font_size_override("font_size",20)
	if JuliaGameLocalization.current != "he":
		button.add_theme_font_override("font",JuliaGameLocalization.font())
		button.text_direction=Control.TEXT_DIRECTION_LTR
		button.language=JuliaGameLocalization.current
	button.pressed.connect(action)
	button.set_meta("stage_rect",bounds)
	(_page if parent==null else parent).add_child(button)
	# Fit the translated caption before Godot expands the fixed stage button.
	var fitted:int=20
	while fitted>10 and button.get_minimum_size().x>bounds.size.x:
		fitted-=1
		button.add_theme_font_size_override("font_size",fitted)
	button.clip_text=true
	button.text_overrun_behavior=TextServer.OVERRUN_TRIM_ELLIPSIS
	button.size=bounds.size
	button.position=bounds.position
	return button
