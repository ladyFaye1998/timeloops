func _ready() -> void:
	get_tree().auto_accept_quit = false
	get_tree().quit_on_go_back = false
	WebLayout.configure_root(get_window())
	if not OS.has_feature("android") and not WebLayout.enabled():
		get_window().min_size = Vector2i(960, 600)
	_apply_window_icon()
	_load_preferences()
	if OS.has_feature("web"):
		var web_locale: Variant = JavaScriptBridge.eval("window.__juliaLanguage || ''", true)
		if str(web_locale) in JuliaGameLocalization.CODES:
			_locale = str(web_locale)
		_web_language_callback = JavaScriptBridge.create_callback(_on_web_language)
		JavaScriptBridge.get_interface("window").addEventListener("julia-language-change", _web_language_callback)
	JuliaGameLocalization.current = _locale
	_build_interface()
	_apply_theme()
	_apply_saved_window_mode()
	_apply_locale()
	_apply_audio()
	_apply_texture_filter()
	get_window().size_changed.connect(_on_window_resized)
	call_deferred("_layout_body")
	call_deferred("_layout_settings")
	call_deferred("_qa_render_state", "menu")
	if OS.is_debug_build() and OS.has_feature("web"):
		var observer = load("res://src/diagnostics/web_playthrough_observer.gd").new()
		add_child(observer)
		observer.start(self)
		var qa_story: int = int(JavaScriptBridge.eval("Number(new URLSearchParams(location.search).get('qa-story') || 0)", true))
		if qa_story in [1,2]: call_deferred("_run_web_story", qa_story)
	if "--qa-open-street5" in OS.get_cmdline_user_args():
		call_deferred("_run_packaged_street5_qa")
	if OS.get_name() == "Windows" and "--validate-windows" in OS.get_cmdline_user_args():
		call_deferred("_run_windows_release_validation")
	if OS.is_debug_build() and (OS.has_feature("android") or "--validate-story" in OS.get_cmdline_user_args()) and FileAccess.file_exists("user://route-validation-request.json"):
		call_deferred("_run_device_story_validation")


func _run_device_story_validation() -> void:
	var validation = load("res://src/diagnostics/device_story_entry.gd").new()
	await validation.run(self)

func _run_web_story(story: int) -> void:
	var validation = load("res://src/diagnostics/web_story_entry.gd").new()
	await validation.run(self, story, _presentation_edition)


func _run_windows_release_validation() -> void:
	# Official release templates ignore external --script overrides. The
	# explicit user argument runs diagnostics from this same packaged game.
	var validation = load("res://src/diagnostics/windows_release_validation.gd").new()
	await validation.run(self)


func _apply_window_icon() -> void:
	# The Web export and HTML already set this icon. Replacing it immediately
	# revokes the browser's first icon blob while it can still be loading.
	if OS.has_feature("web"):
		return
	if not DisplayServer.has_feature(DisplayServer.FEATURE_ICON):
		return
	var icon_texture := load(FLOWER_ICON_PATH) as Texture2D
	if icon_texture == null:
		return
	DisplayServer.set_icon(icon_texture.get_image())


func _build_interface() -> void:
	_backdrop = JuliaShellBackdrop.new()
	_backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_backdrop.visible = false
	add_child(_backdrop)

	_warm_ground = ColorRect.new()
	_warm_ground.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_warm_ground.color = INK
	_warm_ground.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_warm_ground)

	_shell_margin = MarginContainer.new()
	_shell_margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_shell_margin.add_theme_constant_override("margin_left", 0)
	_shell_margin.add_theme_constant_override("margin_top", 0)
	_shell_margin.add_theme_constant_override("margin_right", 0)
	_shell_margin.add_theme_constant_override("margin_bottom", 0)
	add_child(_shell_margin)

	var shell: VBoxContainer = VBoxContainer.new()
	shell.add_theme_constant_override("separation", 0)
	_shell_margin.add_child(shell)

	_build_header(shell)

	_body = Control.new()
	_body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_body.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_body.clip_contents = false
	shell.add_child(_body)
	_body.resized.connect(_layout_body)

	_build_menu_background()
	_build_stage()
	_build_side_panel()
	_build_footer(shell)
	_build_transition_overlay()
	_build_settings_overlay()
	_build_casebook()
	_build_toast()
	_build_opening_sequence()
	_rebuild_side_content()
	_update_stage_content()


func _build_opening_sequence() -> void:
	_opening_sequence = (
		OPENING_SEQUENCE_SCENE.instantiate() as JuliaOpeningSequence
	)
	if _opening_sequence == null:
		push_error("Unable to instantiate the recovered opening sequence")
		return
	_opening_sequence.visible = false
	_opening_sequence.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_opening_sequence.z_index = OPENING_Z_INDEX
	_opening_sequence.finished.connect(_on_opening_sequence_ended)
	_opening_sequence.skipped.connect(_on_opening_sequence_ended)
	add_child(_opening_sequence)
	_opening_sequence.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	_opening_sequence.layout_direction = Control.LAYOUT_DIRECTION_LTR


func _build_header(parent: VBoxContainer) -> void:
	_header = HBoxContainer.new()
	_header.custom_minimum_size.y = 56.0
	_header.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_header.add_theme_constant_override("separation", 10)
	parent.add_child(_header)

	_header_controls = HBoxContainer.new()
	_header_controls.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_header_controls.add_theme_constant_override("separation", 8)
	_header.add_child(_header_controls)

	_header_spacer = Control.new()
	_header_spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_header.add_child(_header_spacer)

	_brand_label = Label.new()
	_brand_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_brand_label.add_theme_font_size_override("font_size", 18)
	_brand_label.add_theme_color_override("font_color", GOLD)
	_brand_label.add_theme_constant_override("outline_size", 4)
	_brand_label.add_theme_color_override("font_outline_color", Color(0.03, 0.02, 0.06, 0.8))
	_header.add_child(_brand_label)

	_language_button = Button.new()
	_language_button.custom_minimum_size = Vector2(78.0, 42.0)
	_language_button.pressed.connect(_toggle_locale)
	_header_controls.add_child(_language_button)

	_fullscreen_button = Button.new()
	_fullscreen_button.custom_minimum_size = Vector2(112.0, 42.0)
	_fullscreen_button.pressed.connect(_toggle_fullscreen)
	_header_controls.add_child(_fullscreen_button)

	_settings_button = Button.new()
	_settings_button.custom_minimum_size = Vector2(100.0, 42.0)
	_settings_button.pressed.connect(_open_settings)
	_header_controls.add_child(_settings_button)


func _build_menu_background() -> void:
	_menu_art = TextureRect.new()
	_menu_art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_menu_art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	_menu_art.texture = _load_texture(MENU_IMAGE_PATH)
	_menu_art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_body.add_child(_menu_art)

	_menu_tint = ColorRect.new()
	_menu_tint.color = Color.WHITE
	var menu_shader := Shader.new()
	menu_shader.code = """
shader_type canvas_item;
uniform bool portrait = false;
void fragment() {
	float paper = 1.0 - smoothstep(0.22, 0.55, UV.x);
	float opacity = portrait ? smoothstep(0.10, 0.40, UV.y) : paper * 0.60;
	COLOR = vec4(0.973, 0.929, 0.812, opacity);
}
"""
	var menu_material := ShaderMaterial.new()
	menu_material.shader = menu_shader
	_menu_tint.material = menu_material
	_menu_tint.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_body.add_child(_menu_tint)


func _build_stage() -> void:
	_stage_card = Panel.new()
	_stage_card.size = Vector2(PLAY_STAGE_SIZE)
	_stage_card.clip_contents = false
	_body.add_child(_stage_card)

	var frame_margin: MarginContainer = MarginContainer.new()
	frame_margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_stage_card.add_child(frame_margin)

	_stage_aspect = AspectRatioContainer.new()
	_stage_aspect.ratio = 16.0 / 9.0
	_stage_aspect.stretch_mode = AspectRatioContainer.STRETCH_FIT
	_stage_aspect.alignment_horizontal = AspectRatioContainer.ALIGNMENT_CENTER
	_stage_aspect.alignment_vertical = AspectRatioContainer.ALIGNMENT_CENTER
	frame_margin.add_child(_stage_aspect)

	_stage_viewport_container = SubViewportContainer.new()
	_stage_viewport_container.stretch = true
	_stage_viewport_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stage_viewport_container.focus_mode = Control.FOCUS_ALL
	_stage_aspect.add_child(_stage_viewport_container)

	_stage_viewport = SubViewport.new()
	_stage_viewport.size = PLAY_STAGE_SIZE
	_stage_viewport.size_2d_override = PLAY_STAGE_SIZE
	_stage_viewport.size_2d_override_stretch = true
	_stage_viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
	_stage_viewport.gui_disable_input = true
	_stage_viewport.gui_embed_subwindows = true
