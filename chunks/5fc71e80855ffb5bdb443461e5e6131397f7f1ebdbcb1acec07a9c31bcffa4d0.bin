	_toast.position = Vector2(-180.0, -86.0)
	_toast.size = Vector2(360.0, 52.0)
	_toast.modulate.a = 0.0
	_toast.add_theme_stylebox_override(
		"panel",
		ThemeFactory.make_box(
			Color(ThemeFactory.WARM_WHITE, 0.97),
			ThemeFactory.MAGENTA,
			2,
			2,
			16.0,
			8.0
		)
	)
	add_child(_toast)
	_toast_label = Label.new()
	_toast_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_toast_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_toast_label.add_theme_color_override(
		"font_color", ThemeFactory.INK
	)
	_toast.add_child(_toast_label)


