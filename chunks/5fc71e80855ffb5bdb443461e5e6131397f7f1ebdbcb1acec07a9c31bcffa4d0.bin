        "mel19": {
          "path": "res://assets/languages/fr/audio/mel19.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d8447ac178d71648065bf4bfee26b46ff5b863e34dc1a8250bd4a8d595aa0679",
          "text": "Dorothy veut la montre d'Alice ? Eh bien, utilise-le pour prouver qu'il ne lui appartient pas.",
          "source_text": "Dorothy wants Alice's watch? Well, use it to prove that it doesn't belong to her.",
          "transcription_review_required": false
        },
        "mel20": {
          "path": "res://assets/languages/fr/audio/mel20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cc820c5fa603db91d520c1a691f021a5629aef4f606372e6ad59f769f8362fda",
          "text": "Au lieu de prouver que la montre appartient Ã  Alice, il serait plus facile de prouver que la montre n'appartient pas Ã  Dorothy.",
          "source_text": "Instead of proving that the watch belongs to Alice, it would be easier to prove that the watch doesn't belong to Dorothy.",
          "transcription_review_required": false
        }
