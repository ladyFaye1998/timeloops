          "transcription_review_required": false
        },
        "ala1-10": {
          "path": "res://assets/languages/nl/audio/ala1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ee517b3867e65aed0ec48938fb8bcde2a9fb8325deebb7f95d7b6170ccad42c3",
          "text": "De film die het gebruik van DDT door Philips chemicaliÃ«n blootlegt. Het doodt ons milieu.",
          "source_text": "The film that exposes the use of DDT by Philip's chemicals. It's killing our environment.",
          "transcription_review_required": false
        },
        "ala1-11a": {
          "path": "res://assets/languages/nl/audio/ala1-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "989d404fde7e5bc30fddb209f3c44b71a15b70ea4ab827db068b5dcefd2c5891",
          "text": "Tot gisteren was het in het lab. Misschien heb ik het in de kledingwinkel laten liggen. Wacht even. Misschien zit hij nog in mijn tas.",
          "source_text": "Till yesterday it was in the lab. Maybe I left it in the clothing store. Wait a minute. Maybe it's still in my bag.",
          "transcription_review_required": false
        },
        "ala1-11b": {
          "path": "res://assets/languages/nl/audio/ala1-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "29f10bcaba8aa93e3c51998fa1a7ffc7edb23f67d1970a4c68cbe0e2456563e5",
          "text": "Hm, wat is dit?",
          "source_text": "Hmm, what's this?",
          "transcription_review_required": false
        },
        "ala1-11c": {
          "path": "res://assets/languages/nl/audio/ala1-11c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7cbb71fe3a9617effe7fc95793e518181d0de987b15c577fb34b6e3e12717e23",
          "text": "Tot gisteren was het in het lab. Misschien heb ik het in de kledingwinkel laten liggen.",
          "source_text": "Till yesterday it was in the lab. Maybe I left it in the clothing store.",
          "transcription_review_required": false
        },
        "ala1-12a": {
          "path": "res://assets/languages/nl/audio/ala1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e20195e5854b68d26e1b2f7f3e9734f0312bbcd624b7c808fd068bb8422709cb",
          "text": "Ik geloof het niet. Dit is een vredige en liefdevolle gemeenschap.",
          "source_text": "I don't believe it. This is a peaceful and loving community.",
          "transcription_review_required": false
        },
        "ala1-12b": {
          "path": "res://assets/languages/nl/audio/ala1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6fd11c2863cc0e7a0b2331416947ddb72927a7176d993c7109c668fadd97f99d",
          "text": "Denk je?",
          "source_text": "You think?",
          "transcription_review_required": false
        },
        "ala1-12c": {
          "path": "res://assets/languages/nl/audio/ala1-12c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aaf6810865e35368d8ee8d4118e2fb40bbf49bddc7847f447dc3c6873c075323",
          "text": "Misschien heeft iemand van Philip's Chemicals het meegenomen?",
          "source_text": "Maybe someone from Philip's Chemicals took it?",
          "transcription_review_required": false
        },
        "ala1-20": {
          "path": "res://assets/languages/nl/audio/ala1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dab272c7194e4b0f38364428dbf3ae80ea7aa3efd8c9608db84c8be84b91f9b7",
          "text": "Zonder de film kan ik niet naar mijn ontmoeting met Jimmy Mackenzie.",
          "source_text": "Without the film, I can't go to my meeting with Jimmy Mackenzie.",
          "transcription_review_required": false
        },
        "ala1-21a": {
          "path": "res://assets/languages/nl/audio/ala1-21a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b3ba793f6c4f59467ddbac9b7fb44685432140c359d426b87e25c14f0de93b75",
          "text": "Papa, wie is papa?",
          "source_text": "Dad, who's Dad?",
          "transcription_review_required": false
        },
        "ala1-21b": {
          "path": "res://assets/languages/nl/audio/ala1-21b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "663b379cafc8f390294faac30be2e3fe38120d609fcac913a80808928cbfcd0c",
          "text": "Nee, Jimmy Mackenzie. Hij heeft de film nodig voor een artikel dat hij gaat schrijven over dit DDT-schandaal.",
          "source_text": "No, Jimmy Mackenzie. He needs the film for an article he's gonna write about this DDT scandal.",
          "transcription_review_required": false
        },
        "ala1-22": {
          "path": "res://assets/languages/nl/audio/ala1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2293b2f8a690c6fd6c17e92644fa2897dca17e9b8f997947ba4031f37b73a62d",
          "text": "Waarom zou ik hem ontmoeten? Ik wil het milieu beschermen, geen vriendje vinden.",
          "source_text": "Why should I meet him? I want to protect the environment, not find a boyfriend.",
          "transcription_review_required": false
        },
        "ala2-01": {
          "path": "res://assets/languages/nl/audio/ala2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5f8e245a8f6359eff0e2322deca01faecec2f6fe56271722a22f87613668b396",
          "text": "Man, het is goed dat je langskwam. Heb je ontdekt wie de film heeft gestolen?",
          "source_text": "Man, it's a good thing you dropped in. Did you find out who stole the film?",
          "transcription_review_required": false
        },
        "ala2-01a": {
          "path": "res://assets/languages/nl/audio/ala2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ceb2a41ff4f27af1892cb98569f802de423610f8d107580ef90172389a811957",
          "text": "Heeft u enig idee wie de film heeft meegenomen?",
          "source_text": "Do you have any clue who might have taken the film?",
          "transcription_review_required": false
        },
        "ala2-01h": {
          "path": "res://assets/languages/nl/audio/ala2-01h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dae6a26d0b2dbaddf35f2e08a4d5b3da2f5417f0da8e10244ea5931800493559",
          "text": "Veronica, ik ken niemand met die naam, maar misschien is zij degene achter de verdwijning van mijn jurk.",
          "source_text": "Veronica, I don't know anyone by that name, but maybe she's the one behind the disappearance of my dress.",
          "transcription_review_required": false
        },
        "ala2-03": {
          "path": "res://assets/languages/nl/audio/ala2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f150098ff1feb727dbdd9be280251da4cb07897b4d57c845e69a1871fed0f851",
          "text": "Cool, je bent een redder in nood.",
          "source_text": "Cool, you're a lifesaver.",
          "transcription_review_required": false
        },
        "ala2-04": {
          "path": "res://assets/languages/nl/audio/ala2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c06850732ae61b35ffa6ebcff98b92a55e7f12a2fc6f0475f11a3bf1fb4ec97",
          "text": "Ik begrijp niet hoe mijn jurk zomaar verdween.",
          "source_text": "I can't understand how my dress just vanished.",
          "transcription_review_required": false
        },
        "ala2-10": {
          "path": "res://assets/languages/nl/audio/ala2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e47f23b7b251fa2ec7bcbde90b943c34b1ec1870da181bae5239cde12f932e11",
          "text": "Mijn prachtige kralenjurk! Jimmy Mackenzie zou mij eraan herkennen.",
          "source_text": "My beautiful beaded dress! Jimmy Mackenzie was going to recognize me by it.",
          "transcription_review_required": false
        },
        "ala2-11": {
          "path": "res://assets/languages/nl/audio/ala2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "65d3c02725e42b90c3e263a49013b262f6a5d7b541ce3849a6ca5ffa2bcd6766",
          "text": "HÃ©, heb je met mijn moeder gepraat? Je klinkt net als zij.",
          "source_text": "Hey, have you been talking to my mother? You sound just like her.",
          "transcription_review_required": false
        },
        "ala2-11m": {
          "path": "res://assets/languages/nl/audio/ala2-11m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "086859701535a21d51c1ba73e8b4515337e30a72e820ca629375bc686aab5630",
          "text": "Je hebt een goede smaak. Ik wil al heel lang zulke armbanden.",
          "source_text": "You've got good taste. I've wanted bracelets like these for a long time.",
          "transcription_review_required": false
        },
        "ala2-12": {
          "path": "res://assets/languages/nl/audio/ala2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2012b3fbd5a668d7b5358318406af5e167cc5adc32408c7d5c2c56200e86c9bb",
          "text": "Nou ja, je herkent me misschien aan de tas, het horloge en een halve foto, maar het zal niet hetzelfde zijn zonder mijn prachtige kralenjurk.",
          "source_text": "Well, you may recognize me by the bag, the watch, and half a photo, but it won't be the same without my beautiful beaded dress.",
          "transcription_review_required": false
        },
        "ala2-20": {
          "path": "res://assets/languages/nl/audio/ala2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8fceb05be4dc73f4e7eec8f0cf46dfceac48a5d36acf69dbfeb79fe5d9ee0d72",
          "text": "In Sheila's boetiek. Ik heb het daar laten liggen om in te korten. Toen ik terugging om het op te halen, was het verdwenen.",
          "source_text": "At Sheila's boutique. I left it there to be shortened. When I went back to pick it up, it had disappeared.",
          "transcription_review_required": false
        },
        "ala2-30": {
          "path": "res://assets/languages/nl/audio/ala2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d2246a713a9d702a74693e4141bbbdfa1265885395c6814dc4090cd9f33bdbb0",
          "text": "Je denkt misschien dat ik paranoÃ¯de ben, maar ik denk dat iemand echt zijn uiterste best doet om ervoor te zorgen dat mijn ontmoeting met Mackenzie niet doorgaat.",
          "source_text": "You may think I'm paranoid, but I think someone is really going out of their way to make sure that my meeting with Mackenzie doesn't happen.",
          "transcription_review_required": false
        },
        "ala2-31": {
          "path": "res://assets/languages/nl/audio/ala2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "878a4f05c86e6654d636d277ef0cf732eee65a4e5ed00d13515f4897e18b32cd",
          "text": "Ik weet het niet. Misschien is deze persoon van plan mijn jurk te gebruiken en zich voor te doen als mij. Ik weet dat het een beetje gek klinkt, maar...",
          "source_text": "I don't know. Maybe this person plans to use my dress and pretend to be me. I know it sounds a little crazy, but-",
          "transcription_review_required": false
        },
        "ala2-32": {
          "path": "res://assets/languages/nl/audio/ala2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dbfec1e04189fd8ce3b867e6b4149cd2dc4a8d011a66d35b84629562c6f13b72",
          "text": "Het zou Sheila Phillips kunnen zijn, Jimmy's ex-vriendin. Ik heb gehoord dat ze nog steeds door hem geobsedeerd is.",
          "source_text": "It could be Sheila Phillips, Jimmy's ex-girlfriend. I've heard that she's still obsessed with him.",
          "transcription_review_required": false
        },
        "alb1-01": {
          "path": "res://assets/languages/nl/audio/alb1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bbe8cce98a9492492fab0513c85063cfe7e22a156f80997e093c11a71b9aaa81",
          "text": "Ik ben geruÃ¯neerd zonder mijn film.",
          "source_text": "I'm ruined without my film.",
          "transcription_review_required": false
        },
        "alb1-02": {
          "path": "res://assets/languages/nl/audio/alb1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fb5de2bc6d18e9928441f73f96751e9e4e1f7e9aef47905105b2809367a34d43",
          "text": "HÃ©, je komt me bekend voor. Hebben wij elkaar ontmoet? Ach, maakt niet uit. Misschien kun jij mij helpen mijn film te vinden.",
          "source_text": "Hey, you look familiar. Have we met? Oh, never mind. Maybe you can help me find my film.",
          "transcription_review_required": false
        },
        "alb1-03": {
          "path": "res://assets/languages/nl/audio/alb1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e2e7a911f1aea39c234aced5105fdc580e5d235601a09e4c9428e71a5753a22d",
          "text": "Dat zou geweldig zijn! Ik merk dat je een positieve uitstraling hebt.",
          "source_text": "That would be great! I can feel you have a positive aura about you.",
          "transcription_review_required": false
        },
        "alb1-10": {
          "path": "res://assets/languages/nl/audio/alb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3dac0a1e088844a02b5eab13a2d6621cd14bb8f5145e4d3969817df3e463bf63",
          "text": "De film die de ecologische catastrofe laat zien die zich in onze stad afspeelt.",
          "source_text": "The film that shows the ecological catastrophe that's happening in our city.",
          "transcription_review_required": false
        },
        "alb1-11": {
          "path": "res://assets/languages/nl/audio/alb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9b41497f8b1febca2b85e06797b8a65656beacc9c23f01ea2309f4f1c8837829",
          "text": "Een fabrieksstad giet DDT in het water en vergiftigt tonnen vis. Het enige waar het kapitaal om geeft is geld verdienen.",
          "source_text": "A factory-an-hour city pours DDT into the water, and poisons tons of fish. All that capital is cares about is making money.",
          "transcription_review_required": false
        },
        "alb1-12": {
          "path": "res://assets/languages/nl/audio/alb1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a592673902d2f3a5cebd4077f3b4bcc0b549fcd106fa6b23c2e69bbe2f090914",
          "text": "Ik geef om onze planeet, dus ik probeer mijn best te doen. Ik geloof ook in dierenrechten. Ik gebruik zelfs geen producten die op dieren zijn getest.",
          "source_text": "I care about our planet, so I try to do my best. I believe in animal rights too. I don't even use products that are tested on animals.",
          "transcription_review_required": false
        },
        "alb1-20": {
          "path": "res://assets/languages/nl/audio/alb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6206cae0884c2ab52537b1d0072bc1fb26b694df3bb2d534f6e03f35320c0c7d",
          "text": "Wat weet je over die bijeenkomst?",
          "source_text": "What do you know about that meeting?",
          "transcription_review_required": false
        },
        "alb1-20h": {
          "path": "res://assets/languages/nl/audio/alb1-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9d04ee9c21eca5fe81238bbdb81929bb107e49ffbf45bfb66209730fce787bed",
          "text": "O, het briefje. Niemand mocht weten dat ik het was. Er zijn veel mensen die willen voorkomen dat we elkaar ontmoeten.",
          "source_text": "Oh, the note. Nobody was supposed to know it was me. There are many people who would like to prevent us from meeting.",
          "transcription_review_required": false
        },
        "alb1-21": {
          "path": "res://assets/languages/nl/audio/alb1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "89d77407206ca21adb4b2ac21328ba78f02a91190d737f65be15001ad4c3c4cf",
          "text": "Om te beginnen de mensen van Philip's Chemicals. Als de dingen die ik tegen hen heb gepubliceerd worden, kan hun fabriek gesloten worden.",
          "source_text": "Well, for starters, the people at Philip's Chemicals. If the stuff I have against them gets published, their factory could get closed down.",
          "transcription_review_required": false
        },
        "alb1-22a": {
          "path": "res://assets/languages/nl/audio/alb1-22a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f4b13404e0fb45a57543b1742e13e913a034e732e140d2e81018b888b06898ce",
          "text": "Dat zou logisch zijn.",
          "source_text": "That would be logical.",
          "transcription_review_required": false
        },
        "alb1-22b": {
          "path": "res://assets/languages/nl/audio/alb1-22b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "577462de84a1bc637ff68dfa483ec848a6a0649a4ed2550f40c245fd1af63452",
          "text": "Zonder de film zou er voor mij geen reden zijn om Jimmy te ontmoeten.",
          "source_text": "Without the film, there would be no reason for me to meet with Jimmy.",
          "transcription_review_required": false
        },
        "alb1-30": {
          "path": "res://assets/languages/nl/audio/alb1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ea9147d5827d15ea00bbee78a309d392e14c96af9e2211a352b2f0bc796607c1",
          "text": "HÃ©, ik ben hierdoor zo in paniek dat ik me niets kan herinneren.",
          "source_text": "Hey, I'm so freaked out because of this, I can't seem to remember anything.",
          "transcription_review_required": false
        },
        "alb1-31a": {
          "path": "res://assets/languages/nl/audio/alb1-31a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af4456ae3d9651afbab03e8628d5acb39d7751538dceaff594bb7174ee1612a8",
          "text": "Ja, je hebt gelijk.",
          "source_text": "Yeah, you're right.",
          "transcription_review_required": false
        },
        "alb1-31c": {
          "path": "res://assets/languages/nl/audio/alb1-31c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "048a347db84585d27d6121906230521fb5730a1b83f5e695f9f399e2817cc288",
          "text": "Ik was vanochtend in het lab en wilde toen naar de fotowinkel, maar toen kwam ik erachter dat de film verdwenen was.",
          "source_text": "I was at the lab this morning, then I wanted to go to the photo store, but that's when I found out that the film had disappeared.",
          "transcription_review_required": false
        },
        "alb1-32": {
          "path": "res://assets/languages/nl/audio/alb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cb851fb0bc715c974abb2b00bed86d71efad8925960fb9c43c3ea02e5053243e",
          "text": "Er zijn hier grotere problemen dan mijn relatie met Jimmy. Ik dacht dat je dat begreep.",
          "source_text": "There are bigger issues here than my relationship with Jimmy. I thought you understood that.",
          "transcription_review_required": false
        },
        "alb1-32h": {
          "path": "res://assets/languages/nl/audio/alb1-32h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e89d5a766aa273631e4473b4de172d12c5e849ad8408351044421555ee1695a2",
          "text": "Bedankt. Wauw. Niet getest op dieren. Waar heb je dit vandaan?",
          "source_text": "Thanks. Wow. Not tested on animals. Where did you get this?",
          "transcription_review_required": false
        },
        "alb2-01": {
          "path": "res://assets/languages/nl/audio/alb2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "96288bc3af9d3f167f620cb836c95df934de997fbe5af3070f21f3dcbbe76801",
          "text": "HÃ©, ben ik blij je te zien? Heeft u enig idee wie de film heeft meegenomen?",
          "source_text": "Hey, am I glad to see you? Do you have any clue who might have taken the film?",
          "transcription_review_required": false
        },
        "alb2-01a": {
          "path": "res://assets/languages/nl/audio/alb2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1dd7a0c0630ae0c063dd9549d5a0e969bdcdec0c9abbfb0566bf236424b234e9",
          "text": "Heb je ontdekt wie de film heeft gestolen?",
          "source_text": "Did you find out who stole the film?",
          "transcription_review_required": false
        },
        "alb2-01h": {
          "path": "res://assets/languages/nl/audio/alb2-01h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "725c9b244a7d345fc18fb6cb10bc9125cb3793250f5291e92bd2ad290479c019",
          "text": "S.P. Misschien is het dezelfde persoon die dat verdachte briefje op mijn bureau in het lab heeft achtergelaten.",
          "source_text": "S.P. Maybe it's the same person who left that suspicious note on my desk in the lab.",
          "transcription_review_required": false
        },
        "alb2-04": {
          "path": "res://assets/languages/nl/audio/alb2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "deb145481d6084482e1ea3541459883b758b37e597e4ba3d63e9e2abf7d8bbaa",
          "text": "Doei.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "alb2-05": {
          "path": "res://assets/languages/nl/audio/alb2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "81f875fc96f893ecc7ef8949b4a9691ba0089e0df253b482a14c9fba015e2c77",
          "text": "Ik ben erg bezorgd over deze verdachte opmerking.",
          "source_text": "I'm really concerned about this suspicious note.",
          "transcription_review_required": false
        },
        "alb2-10": {
          "path": "res://assets/languages/nl/audio/alb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2cdfef36ad7a770a1edec8e165116d1bb1872859a659e85ec7abbe968a2db94d",
          "text": "De Forge-notitie. Ik denk dat ik echt met iets groots bezig ben. Als mijn moeder erachter komt, sluit ze me op in mijn kamer en gooit de sleutel weg.",
          "source_text": "The Forge Note. I guess I'm really onto something big. If my mother finds out she'll lock me in my room and throw away the key.",
          "transcription_review_required": false
        },
        "alb2-11a": {
          "path": "res://assets/languages/nl/audio/alb2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2d4ea4a4194d7bc39fb4b91f3ebda7df7476bbc6ef6f1ef0582a33a1ae83113b",
          "text": "Geef me een pauze. Weet je hoe ouders zijn?",
          "source_text": "Give me a break. You know how parents are?",
          "transcription_review_required": false
        },
        "alb2-11b": {
          "path": "res://assets/languages/nl/audio/alb2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "516616124f61f355a56867b426a9d4008fa4ed2739d64f321ab1964225ae984d",
          "text": "Het is een andere generatie. Ik zal nooit zijn zoals zij.",
          "source_text": "It's a different generation. I'll never be like them.",
          "transcription_review_required": false
        },
        "alb2-12": {
          "path": "res://assets/languages/nl/audio/alb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "714add021e017b81b0031c4997d526a1c4d247d9b0a339fb991178d769ef7a66",
          "text": "Ik heb geen idee, maar iemand doet veel moeite om te voorkomen dat ik Jimmy ontmoet.",
          "source_text": "I have no idea, but someone is going to a lot of trouble to prevent me from meeting Jimmy.",
          "transcription_review_required": false
        },
        "alb2-20": {
          "path": "res://assets/languages/nl/audio/alb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e6cf04e5d4dcf0d0a0058d20ccd4700074196252d7cd2e8028b2a7b21a8abbeb",
          "text": "Het was aan mij geadresseerd, maar het briefje dat ik Jimmy stuurde was anoniem. Ik heb hem nooit mijn naam verteld.",
          "source_text": "It was addressed to me, but the note I sent Jimmy was anonymous. I never told him my name.",
          "transcription_review_required": false
        },
        "alb2-21": {
          "path": "res://assets/languages/nl/audio/alb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8bd59709cd8ab354a9c3605c19b91bd3919e3ba158ca43aa24ba21cd0f8b6b18",
          "text": "Wie weet? Al zitten er wel wat foutjes in die heel bekend voorkomen.",
          "source_text": "Who knows? Although there are some mistakes in it that look very familiar.",
          "transcription_review_required": false
        },
        "alb2-22": {
          "path": "res://assets/languages/nl/audio/alb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "49f9add612fc086b83e886a61e732e75b0df37ee8a9996413b21ffab4b0ccd1c",
          "text": "Niemand die ik zou vermoeden. Alleen Dorothy en Larry. Nee, denk je niet... Larry? Dat kan niet zo zijn.",
          "source_text": "Nobody that I'd suspect. Just Dorothy and Larry. No, you don't think... Larry? It can't be.",
          "transcription_review_required": false
        },
        "doa1-01a": {
          "path": "res://assets/languages/nl/audio/doa1-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2a8d7cdecaf98d56b0be1629aa8bc8f2a9fded942b1c1bf91546726dca474c32",
          "text": "Goh, wat een verschrikkelijke dag!",
          "source_text": "Gosh, what a terrible day!",
          "transcription_review_required": false
        },
        "doa1-01b": {
          "path": "res://assets/languages/nl/audio/doa1-01b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e5d8ab1f8e1e5e1aa7b13d949aa0182da4b53849c7e086b6e3a0cf8203285134",
          "text": "De film wordt gestolen en ik moet de grootte van Golden Gate Park hebben.",
          "source_text": "The film gets stolen, and I've got to zit the size of Golden Gate Park.",
          "transcription_review_required": false
        },
        "doa1-03": {
          "path": "res://assets/languages/nl/audio/doa1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5e3f26f3c87b11c5829a681279d037a22a50fe4c54ae99d38c620ebbbd71fe6b",
          "text": "Als je informatie nodig hebt, zoek mij dan. Mijn naam is Dorothy.",
          "source_text": "If you need any information, look for me. My name is Dorothy.",
          "transcription_review_required": false
        },
        "doa1-04": {
          "path": "res://assets/languages/nl/audio/doa1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "213203060c948309e1307bb3d153b441ab015bf186e42dd9d4472a70b903b8f2",
          "text": "Ik heb geen nieuws over de film.",
          "source_text": "I have no news about the film.",
          "transcription_review_required": false
        },
        "doa1-10a": {
          "path": "res://assets/languages/nl/audio/doa1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7da3eb572542fdd655e8740804c0c758a3e464ad9b39ec7977c17cd7a62ea87d",
          "text": "Als je het mij vraagt, is het die andere man uit het laboratorium, Larry Chang, die het heeft meegenomen.",
          "source_text": "If you ask me, it's that other guy from the lab, Larry Chang who took it.",
          "transcription_review_required": false
        },
        "doa1-10b": {
          "path": "res://assets/languages/nl/audio/doa1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c7fe96dbe6b24312f519a031207f06296019f7611cd8b1d00881ded1c4d4b8c9",
          "text": "Hij is altijd jaloers geweest op Alice vanwege haar cijfers en studiebeurzen.",
          "source_text": "He's always been jealous of Alice because of her grades and scholarships.",
          "transcription_review_required": false
        },
        "doa1-20": {
          "path": "res://assets/languages/nl/audio/doa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "159692ba05ab41e02e7c73ecd148644bd5a678c1cdc4ba77e592fc3f4dce9328",
          "text": "Ze wil dat er recht wordt gedaan, maar ook, en dat heb je van mij niet gehoord, ik denk dat ze dol is op die verslaggever.",
          "source_text": "She wants justice to be done, but also, and you didn't hear this from me, I think she's wild about that reporter.",
          "transcription_review_required": false
        },
        "doa1-21": {
          "path": "res://assets/languages/nl/audio/doa1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6532e9485b0a1998c3bf64e85930c4d0514b2681f537317197240c1cea4b43de",
          "text": "Ze stuurde hem een â€‹â€‹anonieme brief waarin ze zichzelf beschreef en hem vroeg haar te ontmoeten in Minneapolis, waar ik vandaan kom. Dat is een uitnodiging voor een date.",
          "source_text": "She sent him an anonymous letter describing herself and asking him to meet her, in Minneapolis, where I come from. That's an invitation for a date.",
          "transcription_review_required": false
        },
        "doa1-22": {
          "path": "res://assets/languages/nl/audio/doa1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2adabded8eef8a5bae5d0ff397298d01cf414d07defaeea71f3f2b959282b039",
          "text": "Wat? Hoe durf je?",
          "source_text": "What? How dare you?",
          "transcription_review_required": false
        },
        "doa1-22m": {
          "path": "res://assets/languages/nl/audio/doa1-22m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "66bf5c6adc3f4bed1a2a24e09c0e05e503f17ad089d46b00b028a0918e4f1b84",
          "text": "HÃ©, bedankt! Hij past in mijn make-uptasje.",
          "source_text": "Hey, thanks! It fits into my makeup bag.",
          "transcription_review_required": false
        },
        "doa2-01": {
          "path": "res://assets/languages/nl/audio/doa2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e871073712837672548690e5910b2af09009a3770c6eef518e48e0f05f085fd",
          "text": "Ik ben echt geschokt door wat er met Alice gebeurt.",
          "source_text": "I'm really shocked by what's happening to Alice.",
          "transcription_review_required": false
        },
        "doa2-02": {
          "path": "res://assets/languages/nl/audio/doa2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c7a855d790d67115e5068765f2081a13430c768e7e5779f6e330900f8362a2e7",
          "text": "Heb je gehoord dat Alice's ontmoeting met Jimmy Mackenzie niet doorgaat?",
          "source_text": "Did you hear that Alice's meeting with Jimmy Mackenzie is off?",
          "transcription_review_required": false
        },
        "doa2-03": {
          "path": "res://assets/languages/nl/audio/doa2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "517b63278ca145cf381b2141323e5278bac30d17596717c848d1c091921fd367",
          "text": "Doei!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "doa2-04": {
          "path": "res://assets/languages/nl/audio/doa2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bd78cf5d42eaa99e28304c36ffa7b62027216c1c1f8abe89c4806f5fa37aa90d",
          "text": "Arme Alice, haar ontmoeting met Jimmy Mackenzie is niet doorgegaan.",
          "source_text": "Poor Alice, her meeting with Jimmy Mackenzie is off.",
          "transcription_review_required": false
        },
        "doa2-05": {
          "path": "res://assets/languages/nl/audio/doa2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3a4d7d2894e8c454b8f02ffd7a73f999b9d3adba389273282358fd6d20096c9d",
          "text": "Sorry, ik kan het gewoon niet, kan niet, uhh, CHOO! Het lijkt erop dat ik het niet kan, CHOO! Spullen!",
          "source_text": "Sorry, I just can't, can't, uhh, CHOO! I can't seem to, CHOO! Stuff!",
          "transcription_review_required": false
        },
        "doa2-05a": {
          "path": "res://assets/languages/nl/audio/doa2-05a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f34db8f35ff0983d46bea100ca708282ff832a9eb46b088b0d41c4b7d725b672",
          "text": "Ha-ha-ha-ha-ha-choo!",
          "source_text": "Ha-ha-ha-ha-ha-choo!",
          "transcription_review_required": false
        },
        "doa2-06": {
          "path": "res://assets/languages/nl/audio/doa2-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4269196aa2202d4dbd17501489fa0f9b372608741a4c87d5ca62813678eb8048",
          "text": "Doei!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "doa2-07": {
          "path": "res://assets/languages/nl/audio/doa2-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8207bed9f46253d8eb5d7c823faa006acdbd0ba0b4c365d21de6affd1dffbdef",
          "text": "Wat wil je nu?",
          "source_text": "What do you want now?",
          "transcription_review_required": false
        },
        "doa2-10": {
          "path": "res://assets/languages/nl/audio/doa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fd388ca7db77091f0aef16c025069cc2ec3312ec8ae959880e796675bb55175a",
          "text": "Nou, haar jurk is gestolen, de jurk die ze zou dragen tijdens de ontmoeting met Jimmy.",
          "source_text": "Well, her dress was stolen, the one she was supposed to wear to the meeting with Jimmy.",
          "transcription_review_required": false
        },
        "doa2-20": {
          "path": "res://assets/languages/nl/audio/doa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "79351dffcaa5668df17c8aa25c644540cd222985958282d31780b12af4f51625",
          "text": "Wie, dezelfde persoon die niet wil dat ze Jimmy ontmoet, en er zijn veel opties. Susan bijvoorbeeld.",
          "source_text": "Who, the same person who doesn't want her to meet Jimmy, and there are many options. Susan, for instance.",
          "transcription_review_required": false
        },
        "doa2-21": {
          "path": "res://assets/languages/nl/audio/doa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8df8a5ce6b2178e88b21ec7ec48fc2ef03ddd73d122777e59b92f5669275bf8e",
          "text": "Ja, veel mensen zijn jaloers op Alice. Alice is een slim, mooi meisje. Daarom ben ik haar beste vriendin.",
          "source_text": "Yes, lots of people are jealous of Alice. Alice is a smart, beautiful girl. That's why I'm her best friend.",
          "transcription_review_required": false
        },
        "doa2-22": {
          "path": "res://assets/languages/nl/audio/doa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "654ac1adb6544448d0d74152e63edc97bb386aec572870653ccde67aa8b42496",
          "text": "Laten we zeggen dat het niet de eerste keer is dat ze iets steelt, ook al zijn het meestal mannen. Geloof me, ik weet waar ik het over heb.",
          "source_text": "Let's just say that it wouldn't be the first time she's stolen something, although it's usually men. Believe me, I know what I'm talking about.",
          "transcription_review_required": false
        },
        "doa2-30": {
          "path": "res://assets/languages/nl/audio/doa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7dfe58442151afafbef04c576cc6bc100a2cd037ec7367c67f665a62f7d9369b",
          "text": "Niet meer, ik niet!",
          "source_text": "Not anymore, I'm not!",
          "transcription_review_required": false
        },
        "doa2-40": {
          "path": "res://assets/languages/nl/audio/doa2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7637f75707e1439f5c5f314fce47e824fafec70d59cb7e92e85ca2a0e521d7f1",
          "text": "Welke zakdoek?",
          "source_text": "What handkerchief?",
          "transcription_review_required": false
        },
        "doa2-40h": {
          "path": "res://assets/languages/nl/audio/doa2-40h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "181e1dad76c4ea854a74f9eb5c4f3d5b15735ddb9d688a8f5330a5ebfc7f1f62",
          "text": "Dat is niet de mijne. Mijn naam is Dorothy. Hier kan ik je mijn identiteitsbewijs laten zien.",
          "source_text": "That's not mine. My name is Dorothy. Here, I can show you my ID.",
          "transcription_review_required": false
        },
        "doa2-50": {
          "path": "res://assets/languages/nl/audio/doa2-50.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ee3fe639075da2a629a42cecb77063ef9b047f379f59996d3f0813239116f605",
          "text": "Ja, maar het is een geheim. Alleen mijn beste vriend van de middelbare school mag het gebruiken.",
          "source_text": "Yes, but it's a secret. Only my best friend from high school is allowed to use it.",
          "transcription_review_required": false
        },
        "doa2-s3": {
          "path": "res://assets/languages/nl/audio/doa2-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7a553dfa56bfded8397eb1ace40753476e5955a49ce521d79684f064d1d626ad",
          "text": "Bedankt voor het wegnemen van de oorzaak van mijn niezen. Ik haat die bloemen!",
          "source_text": "Bless you for removing the cause of my sneezing. I hate those flowers!",
          "transcription_review_required": false
        },
        "dob1-01": {
          "path": "res://assets/languages/nl/audio/dob1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "580cc9f6c2c932b37e4edb48e2f377b83367f3f96054477e5659563fe079f0e9",
          "text": "Heeft iemand je verteld dat je een beetje op Alice lijkt?",
          "source_text": "Did anyone tell you you look a little bit like Alice?",
          "transcription_review_required": false
        },
        "dob1-02": {
          "path": "res://assets/languages/nl/audio/dob1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f8a224dce88e281e21441d6e8bd4ff4e9a717b4b41e06255cd7636e246e87d7f",
          "text": "Doei!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "dob1-03": {
          "path": "res://assets/languages/nl/audio/dob1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d08fa68bb7ddae721f237e5f009719afd074d165ba071cddb4d228b8762508be",
          "text": "Ik had het gevoel dat we ons gesprekje nog niet hadden afgerond.",
          "source_text": "I had a feeling we hadn't finished our little conversation.",
          "transcription_review_required": false
        },
        "dob1-10a": {
          "path": "res://assets/languages/nl/audio/dob1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e0c2c754024fbf409d374032d558e2f92bd63ea61344c78ba25e829de86aed51",
          "text": "Het is zo duidelijk.",
          "source_text": "It's so obvious.",
          "transcription_review_required": false
        },
        "dob1-10b": {
          "path": "res://assets/languages/nl/audio/dob1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "060512a4ed65f9a09af2a151b8e0794bb8605de6acc768c319e155488d66d042",
          "text": "Ze wil heel graag Jimmy ontmoeten, maar ze zal het nooit toegeven.",
          "source_text": "She's dying to meet Jimmy, but she'll never admit it.",
          "transcription_review_required": false
        },
        "dob1-11a": {
          "path": "res://assets/languages/nl/audio/dob1-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "505bd5d3fc7c958e34ec0c363b9ea51273afc51b7ba2307e537005c389031bd7",
          "text": "Ze is net gescheiden van haar vriend Rick, van de platenwinkel, en ik weet dat dat maar Ã©Ã©n ding betekent.",
          "source_text": "She just separated from her boyfriend, Rick, from the record store, and I know that means only one thing.",
          "transcription_review_required": false
        },
        "dob1-11b": {
          "path": "res://assets/languages/nl/audio/dob1-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2c0d9e92c08f9ef13eebe0fdfc2300f2378374af621224591e101f99a7803e0d",
          "text": "Ze heeft al iemand anders in gedachten.",
          "source_text": "She's already got someone else on her mind.",
          "transcription_review_required": false
        },
        "dob1-12": {
          "path": "res://assets/languages/nl/audio/dob1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "30a3534415ddf374624698926acd245e6dd4b7a972db1b50efd18b7c0208ce67",
          "text": "Het enige waar Alice over praat is het milieu, maar geloof me, in haar gedachten denkt ze, zoals alle vrouwen denken, dat ze een goede echtgenoot wil vinden.",
          "source_text": "All Alice talks about is the environment, but believe me, in her mind, she thinks like all women think, she wants to find a good husband.",
          "transcription_review_required": false
        },
        "dob1-20a": {
          "path": "res://assets/languages/nl/audio/dob1-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4404737a9a76ffe3ff93381717c15f2e1439701c18eaa164e11f4fd0f7dcd413",
          "text": "Als je het mij vraagt, heeft haar collega van het lab het meegenomen, hij is zo jaloers op haar.",
          "source_text": "If you ask me, her colleague from the lab took it, he's so envious of her.",
          "transcription_review_required": false
        },
        "dob1-20b": {
          "path": "res://assets/languages/nl/audio/dob1-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "844d1e2d9d0a003474e24a6de0dcbbc5de7ea7670612a0e23b8c84bd9fb1b0c8",
          "text": "Terwijl hij de hele dag studeert en werkt, kiest zij alle beurzen.",
          "source_text": "While he's studying and working all day, she picks all the scholarships.",
          "transcription_review_required": false
        },
        "dob2-01": {
          "path": "res://assets/languages/nl/audio/dob2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f5ea3b2514b1abacfff462af1276de7b20750186c36bf7c9b7f8aa73a19ffad6",
          "text": "Ik moet Susan echt het laatste nieuws vertellen.",
          "source_text": "I really have to tell Susan the latest news.",
          "transcription_review_required": false
        },
        "dob2-02": {
          "path": "res://assets/languages/nl/audio/dob2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ffcdd79b3439c48e9ea100ef6a7aa6b66cf99a2d8630fe0a404185a58a188862",
          "text": "Dit is echt beangstigend. Een briefje vervalsen alleen maar om te voorkomen dat Alice Jimmy ontmoet? Oh, als ik hier maar een telefoon kon vinden, kon ik Susan op de hoogte houden.",
          "source_text": "This is really frightening. Forging a note just to prevent Alice from meeting Jimmy? Oh, if only I could find a phone here, I could update Susan.",
          "transcription_review_required": false
        },
        "dob2-03": {
          "path": "res://assets/languages/nl/audio/dob2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "737adf755326396b69c67c04c467be82535c3a4cffa7daa070bceb7c60f693df",
          "text": "Tot ziens!",
          "source_text": "See ya!",
          "transcription_review_required": false
        },
        "dob2-04": {
          "path": "res://assets/languages/nl/audio/dob2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6b2badc553a35b87723e1ec15f1a5afbd11e842fb8495e1524567cd5a50b81c6",
          "text": "Ik wou dat er hier een openbare telefoon was. Ik moet Susan echt vertellen over het vervalste briefje.",
          "source_text": "I wish there was a public phone here. I really have to tell Susan about the forged note.",
          "transcription_review_required": false
        },
        "dob2-10": {
          "path": "res://assets/languages/nl/audio/dob2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "166c3f5c2842e3a13b2dc6ab97d6b7a4136fc41f162cb87543523cfd07d935d7",
          "text": "Ik heb geen idee. Ik dacht dat Alice niemand anders dan mij over deze pak slaag had verteld.",
          "source_text": "I don't have a clue. I thought Alice didn't tell anyone but me about this beating.",
          "transcription_review_required": false
        },
        "dob2-11a": {
          "path": "res://assets/languages/nl/audio/dob2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ded05339c8e5af74fd9109b85efbc596064b647b6c0a7d86f609d5d484ae704d",
          "text": "Mij?",
          "source_text": "Me?",
          "transcription_review_required": false
        },
        "dob2-11b": {
          "path": "res://assets/languages/nl/audio/dob2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6eb740963b1148df756d87fd779560218fdf0ad77e8a745fff8457eb48baed9d",
          "text": "Nee. Nou ja, alleen Susan, maar Susan is een vriendin. Maar dat zou ze nooit doen, behalve al dat reizen alleen maar om Jimmy te ontmoeten, nee.",
          "source_text": "No. Well, just Susan, but Susan is a friend. She would never, although, but to go to all that travel just to meet Jimmy, nah.",
          "transcription_review_required": false
        },
        "dob2-12": {
          "path": "res://assets/languages/nl/audio/dob2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9b199202926020295fe891c22816e4460e456c8c2103e725e45495afac1a069e",
          "text": "Dit is te veel. Je verdenkt mij? Ik ben Alice's beste vriendin.",
          "source_text": "This is too much. You suspect me? I'm Alice's best friend.",
          "transcription_review_required": false
        },
        "dob2-12m": {
          "path": "res://assets/languages/nl/audio/dob2-12m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f45d98189800f073ca3a8c28d8b88d910e97e3867244717bb4aa593fc3eed7df",
          "text": "Wat een schattige telefoon! Maar waar is het snoer?",
          "source_text": "What a cute phone! But where's the cord?",
          "transcription_review_required": false
        },
        "dob2-20": {
          "path": "res://assets/languages/nl/audio/dob2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6b8427ff700d41acfd4963b695d5d153199f039edd59b7b29ed3974d488b8058",
          "text": "Alice? Echt niet. Voor haar is het een droom die uitkomt. Ze wilde altijd op zijn minst Robert Kennedy zijn.",
          "source_text": "Alice? No way. For her, it's a dream come true. She always wanted to be Robert Kennedy at the least.",
          "transcription_review_required": false
        },
        "dol-01": {
          "path": "res://assets/languages/nl/audio/dol-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b7d6208f3a28bee361d6ca316422bfb2f979941dcab77703abce249407edcc8d",
          "text": "Waarom denk je dat ik het deed?",
          "source_text": "Why do you think I did it?",
          "transcription_review_required": false
        },
        "dol-02": {
          "path": "res://assets/languages/nl/audio/dol-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "98720f296804de5fb2217dbf5758a47cf73a59627e1fa50091794fe1c1cacc19",
          "text": "Je kunt nog steeds niet bewijzen dat ik Veronica ben.",
          "source_text": "You still can't prove that I'm Veronica.",
          "transcription_review_required": false
        },
        "dol-03": {
          "path": "res://assets/languages/nl/audio/dol-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9d2f98745cf8ca98bc72ce3617fbb5ee5578e70e529d5beb651bd2120e41e0f2",
          "text": "OkÃ©, dus ik ben Veronica. Wat heb je tegen Veronica's?",
          "source_text": "OK, so I am Veronica. What do you have against Veronica's?",
          "transcription_review_required": false
        },
        "dol-04": {
          "path": "res://assets/languages/nl/audio/dol-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e81cab55866afdfc746757f25e11ca2e985417742b321431ecc0f2179d94b06",
          "text": "OkÃ©, ik ben het. Ik deed het alleen omdat ik denk dat Jimmy niet haar type is. Sterker nog, hij is precies de juiste man voor mij, dus ik ga hem ontmoeten voordat Alice er is.",
          "source_text": "Okay, it's me. I only did it because I don't think Jimmy's her type. In fact, he's just the right guy for me, so I'm gonna meet him before Alice gets there.",
          "transcription_review_required": false
        },
        "dol-05": {
          "path": "res://assets/languages/nl/audio/dol-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9f679503f4db3a705a344e8cfbf78081b99c2762dbeb51d88500dc06eef45131",
          "text": "Wat heeft dit met mij te maken?",
          "source_text": "What does this have to do with me?",
          "transcription_review_required": false
        },
        "dol-06": {
          "path": "res://assets/languages/nl/audio/dol-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2fe6fb848646e53e99b385ef2d8c011bc1c24533c19264655808e1ed2a8b2998",
          "text": "Alice is mijn vriendin. Ik zou haar nooit pijn doen.",
          "source_text": "Alice is my friend. I would never hurt her.",
          "transcription_review_required": false
        },
        "dol-08": {
          "path": "res://assets/languages/nl/audio/dol-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ec9beb967f5ccc5d0cae8b8ba313291456cba6b39adfc9cfd03ab269116e4e9a",
          "text": "Dus wat is dit bewijs?",
          "source_text": "So what's this prove?",
          "transcription_review_required": false
        },
        "dol-08a": {
          "path": "res://assets/languages/nl/audio/dol-08a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "16661f360aead9347040f1306cedd3aa7efdc87632fe7a8cdf0c3e9c8b61db10",
          "text": "Q! Dus wat bewijst dit? Q!",
          "source_text": "Q! So what does this prove? Q!",
          "transcription_review_required": false
        },
        "dol-09": {
          "path": "res://assets/languages/nl/audio/dol-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e0d2f55b30d5b6cec9010aa763dbe2d72af3415696bf9ef053d069c2f4680d6a",
          "text": "Ik hoorde dat ze uit elkaar gingen. Dat is goed nieuws voor alle vrouwen in de stad.",
          "source_text": "I heard they broke up. That's good news for all the women in town.",
          "transcription_review_required": false
        },
        "dol-10": {
          "path": "res://assets/languages/nl/audio/dol-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "18f88925e345dcd3a6fc744bf475e092a4465010e95b642a452a75cfc1448a8a",
          "text": "Je kunt nog niet bewijzen dat ik het ben.",
          "source_text": "You can't prove it's me yet.",
          "transcription_review_required": false
        },
        "dol-11": {
          "path": "res://assets/languages/nl/audio/dol-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c67d128bfa5a5e1333934da3d69360202ba70852c50d9fccb42ad5a1e10f9c5",
          "text": "Wat is er aan de hand? Heeft een kat je tong gekregen? Niets wat je kunt zeggen of gebruiken is bewijs tegen mij, hÃ¨?",
          "source_text": "What's the matter? A cat got your tongue? Nothing to say or use is proof against me, huh?",
          "transcription_review_required": false
        },
        "dolb-01": {
          "path": "res://assets/languages/nl/audio/dolb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d5814817133a46122e4ae86a8dfdca20f18e026a4eabc5d72899ec502e20302a",
          "text": "Alice heeft zoveel geluk met jou.",
          "source_text": "Alice is so lucky to have you.",
          "transcription_review_required": false
        },
        "jala1-10": {
          "path": "res://assets/languages/nl/audio/jala1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3327adf3f1f3343df27dfcf39cf8f38bd74a18eb367f6851ba6b59411c411010",
          "text": "Sorry dat ik stoor, maar welke film is dat precies?",
          "source_text": "I'm sorry to interrupt, but what film is that exactly?",
          "transcription_review_required": false
        },
        "jala1-11": {
          "path": "res://assets/languages/nl/audio/jala1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e294db2511e32a643dd2da1a5eeff82b685546f8bd06d0978c8372b7357691f4",
          "text": "Heeft u enig idee waar de film te zien is?",
          "source_text": "Do you have any idea where the film might be?",
          "transcription_review_required": false
        },
        "jala1-12": {
          "path": "res://assets/languages/nl/audio/jala1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c97aaf84ff43ef29d85b351c0eecbb110b930add73b3706b86e0e55e62a9fb4b",
          "text": "Zou iemand het meegenomen hebben?",
          "source_text": "Could someone have taken it?",
          "transcription_review_required": false
        },
        "jala1-20": {
          "path": "res://assets/languages/nl/audio/jala1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "665fd0af142eb26781b96d62945fb30137e138a30062670b79b0c291581c8a60",
          "text": "Waarom is de film zo belangrijk voor je?",
          "source_text": "Why is the film so important to you?",
          "transcription_review_required": false
        },
        "jala1-21": {
          "path": "res://assets/languages/nl/audio/jala1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "535ca46dd20c62f1403cdb44a986e5bf98b2850ccea9e791afe69df0cc482838",
          "text": "Waarom heeft papa de film nodig?",
          "source_text": "Why does Dad need the film?",
          "transcription_review_required": false
        },
        "jala1-22": {
          "path": "res://assets/languages/nl/audio/jala1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "245ab63081ca9c8ed4e6f614c715f1d00a2298c95cbb82cd4d6aacd419eebc51",
          "text": "Waarom kun je hem niet gewoon ontmoeten zonder de film?",
          "source_text": "Why can't you just meet him without the film?",
          "transcription_review_required": false
        },
        "jala1-by": {
          "path": "res://assets/languages/nl/audio/jala1-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "85a0c44968771dedbf4425147f734dccf42e108021a6e4a372f7144bbb29a835",
          "text": "Ik zal je helpen.",
          "source_text": "I'll help you.",
          "transcription_review_required": false
        },
        "jala2-10": {
          "path": "res://assets/languages/nl/audio/jala2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c3814798dbdc724185ad0bad496a2a9411a73f4243daa31a1fba7f364f789868",
          "text": "Adres verdwenen?",
          "source_text": "Address disappeared?",
          "transcription_review_required": false
        },
        "jala2-11": {
          "path": "res://assets/languages/nl/audio/jala2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "66414d3d0b2d02567f7cb620d503812d3e06e45e3029a66bed60569f104f3a98",
          "text": "Zou je ooit willen dat je korte, oude jurk de jurk zou zijn?",
          "source_text": "Could ever want your short, old be the dress?",
          "transcription_review_required": false
        },
        "jala2-12": {
          "path": "res://assets/languages/nl/audio/jala2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "688b13c1b15824d182f034be71763d21c2f135347d8e952bcf22df7a65c75b66",
          "text": "Zou Jimmy McKenzie je niet kunnen herkennen zonder de jurk?",
          "source_text": "Wouldn't Jimmy McKenzie be able to recognize you without the dress?",
          "transcription_review_required": false
        },
        "jala2-20": {
          "path": "res://assets/languages/nl/audio/jala2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cad63727b90e9c13bf6aa712c2b88e28057c11b8d7ad1c9bdd2cb5b3c80fc0b4",
          "text": "Waar heb je je jurk voor het laatst gezien?",
          "source_text": "Where did you last see your dress?",
          "transcription_review_required": false
        },
        "jala2-30": {
          "path": "res://assets/languages/nl/audio/jala2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "10b7acd72e163c9cea691c4c1f67194e12433daee6e8a34d7f7b1b5e75bd608d",
          "text": "Waarom zou iemand jouw jurk afpakken?",
          "source_text": "Why would anyone take your dress?",
          "transcription_review_required": false
        },
        "jala2-31": {
          "path": "res://assets/languages/nl/audio/jala2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6a72e101c340123d86a5f505171e08fa7eaa009feb7efaa3e21b423fb13d283b",
          "text": "Denk je dat iemand een jurk zou stelen alleen maar om de bijeenkomst te saboteren?",
          "source_text": "You think someone would steal a dress just to sabotage the meeting?",
          "transcription_review_required": false
        },
        "jala2-32": {
          "path": "res://assets/languages/nl/audio/jala2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "16f9394042ed47aa82436cd6970e7766c984738a6a83880ceb516f101e3979f7",
          "text": "Kun je iemand bedenken die zou willen voorkomen dat je Jimmy ontmoet?",
          "source_text": "Can you think of anyone who would want to prevent you from meeting Jimmy?",
          "transcription_review_required": false
        },
        "jala2-by": {
          "path": "res://assets/languages/nl/audio/jala2-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e76b154d5ae0580c3a19c4dc3f32f0cbfe08f6347d7a7015d6ec3780cb5b90f0",
          "text": "Maak je geen zorgen, ik blijf het onderzoeken.",
          "source_text": "Don't worry, I'll keep investigating.",
          "transcription_review_required": false
        },
        "jalb1-10": {
          "path": "res://assets/languages/nl/audio/jalb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9bfb200bf6a2754be86570b1e8641926588fab3718b14b049b2b8a21a7d2bbbd",
          "text": "Over welke film heb je het?",
          "source_text": "What film are you talking about?",
          "transcription_review_required": false
        },
        "jalb1-11": {
          "path": "res://assets/languages/nl/audio/jalb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ee04789483c5573ca33a33984db4c36ff993f4e3aa853f26b901ee93521af8e6",
          "text": "Welke ecologische catastrofe?",
          "source_text": "What ecological catastrophe?",
          "transcription_review_required": false
        },
        "jalb1-12": {
          "path": "res://assets/languages/nl/audio/jalb1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "223816af9c088bcd18b53a89234354169a20f0b05eae7d58b180c5725e326c50",
          "text": "Waarom heb je er foto's van gemaakt?",
          "source_text": "Why did you take photos of it?",
          "transcription_review_required": false
        },
        "jalb1-20": {
          "path": "res://assets/languages/nl/audio/jalb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "10a36aecd99eda025a122bb0d43368f382c6847dbbbb8c4842c7345f3f4133e4",
          "text": "Ben jij degene die de ontmoeting met Jimmy McKenzie vanavond heeft afgezegd?",
          "source_text": "Are you the one who canceled the meeting with Jimmy McKenzie tonight?",
          "transcription_review_required": false
        },
        "jalb1-21": {
          "path": "res://assets/languages/nl/audio/jalb1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bbf34328de9b42805b56686c7d09059e0972515ed6eb56f166f8cff3838266ec",
          "text": "Wie zou willen voorkomen dat je elkaar ontmoet?",
          "source_text": "Who would want to prevent you to from meeting?",
          "transcription_review_required": false
        },
        "jalb1-22": {
          "path": "res://assets/languages/nl/audio/jalb1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "adf74348470b26cff25e0bd03db8f1132d0a837b3e15aece5cee6885248ef164",
          "text": "Zou het kunnen dat de persoon die uw ontmoeting probeert te voorkomen, degene is die de film heeft gestolen?",
          "source_text": "Could it be that the person trying to prevent your meeting is the one who stole the film?",
          "transcription_review_required": false
        },
        "jalb1-30": {
          "path": "res://assets/languages/nl/audio/jalb1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b86dcc2db8e01a5e9ba56cc83ea9e89572e065fe7ced9b4ddb2a9835a3bac534",
          "text": "Misschien ben je de film ergens vergeten.",
          "source_text": "Maybe you forgot the film somewhere.",
          "transcription_review_required": false
        },
        "jalb1-31": {
          "path": "res://assets/languages/nl/audio/jalb1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9c342d3cb42ab3ad33ca14aa8ecfd1f019b687d50ec6e9cd7fcea65f27a152c1",
          "text": "Misschien moet je yoga eens proberen. Deze ademhalingsoefeningen kunnen je helpen ontspannen.",
          "source_text": "Maybe you should try yoga. Those breathing exercises may help you relax.",
          "transcription_review_required": false
        },
        "jalb1-32": {
          "path": "res://assets/languages/nl/audio/jalb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4ddde99f0610c7351365722be015da758584c9bf21a890b3c40f84f72f39c264",
          "text": "Concentreren. Het is belangrijk voor de toekomst van je relatie met Jimmy.",
          "source_text": "Concentrate. It's important for the future of your relationship with Jimmy.",
          "transcription_review_required": false
        },
        "jalb1-by": {
          "path": "res://assets/languages/nl/audio/jalb1-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c855b0bf00156b562f04607c8ec149efdd3c74e3904ff8f7342d03fbc0c11f65",
          "text": "Ik help je de film te vinden.",
          "source_text": "I'll help you find the film.",
          "transcription_review_required": false
        },
        "jalb2-10": {
          "path": "res://assets/languages/nl/audio/jalb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "464adbaa14a53549b0c3e44355efa774f0ea814d15128e6fa48ca0501b60fc11",
          "text": "Welke notitie?",
          "source_text": "What note?",
          "transcription_review_required": false
        },
        "jalb2-11": {
          "path": "res://assets/languages/nl/audio/jalb2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c1f8b00ff47da3e1fb3c7f0213d18ca87512074d3977eabbb12362b447611822",
          "text": "Waarom zou je moeder je opsluiten?",
          "source_text": "Why would your mother lock you up?",
          "transcription_review_required": false
        },
        "jalb2-12": {
          "path": "res://assets/languages/nl/audio/jalb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "43e9b6d58c75b04142fc6d58ccf6ce461c73d48a04cae4bd669470f349a25b9b",
          "text": "Waarom zou iemand een briefje vervalsen?",
          "source_text": "Why would anyone forge a note?",
          "transcription_review_required": false
        },
        "jalb2-20": {
          "path": "res://assets/languages/nl/audio/jalb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af5e3584f75eceb4f6f72d4525fb1d726926597e133092118eded6e1c007fc7b",
          "text": "Wat is er zo verdacht aan dit briefje?",
          "source_text": "What's so suspicious about this note?",
          "transcription_review_required": false
        },
        "jalb2-21": {
          "path": "res://assets/languages/nl/audio/jalb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7ccc3ffc75b0ae6f1e5708921f35d345a51db680f17e68089679b59f9de11554",
          "text": "Wie zou jou dat briefje kunnen sturen?",
          "source_text": "Who could have sent you that note?",
          "transcription_review_required": false
        },
        "jalb2-22": {
          "path": "res://assets/languages/nl/audio/jalb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7a6e660f901a4282bccb70c072d52d55063833fb150b1df9f6f6a68b3dfc482b",
          "text": "Wie wist van de anonieme brief die je naar Jimmy stuurde?",
          "source_text": "Who knew about the anonymous letter you sent to Jimmy?",
          "transcription_review_required": false
        },
        "jdoa1-10": {
          "path": "res://assets/languages/nl/audio/jdoa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aa709057dcad20cb4795f4301766506be5be57aecd0e3edc83368625e6c8e2ec",
          "text": "Misschien heb je een idee waar de film zich zou kunnen bevinden.",
          "source_text": "Maybe you have an idea where the film might be.",
          "transcription_review_required": false
        },
        "jdoa1-20": {
          "path": "res://assets/languages/nl/audio/jdoa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b98ed6f9977cd346e951291daee32b4da35845ca3883c1b77300884a8e64e713",
          "text": "Wis Alice in deze film?",
          "source_text": "Wise Alice into this film?",
          "transcription_review_required": false
        },
        "jdoa1-21": {
          "path": "res://assets/languages/nl/audio/jdoa1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "81b6ecfc3c46cae7e4fe8fe634ba84ecb280a4571de2b562ac7829df3125eda7",
          "text": "Waarom denk je dat?",
          "source_text": "Why do you think so?",
          "transcription_review_required": false
        },
        "jdoa1-22": {
          "path": "res://assets/languages/nl/audio/jdoa1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e47e3194defc71ea2fea0974ca93bdf901ea8a3fe39ac33a904155f4e938bcd4",
          "text": "Iedereen is verliefd op Jimmy! Jij ook?",
          "source_text": "Everyone's got a crush on Jimmy! You, too?",
          "transcription_review_required": false
        },
        "jdoa2-10": {
          "path": "res://assets/languages/nl/audio/jdoa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b4fec600ae984d77ba16033dccfa4515bbc3ea6e57e6a57e4f3bfb8e70bef1fb",
          "text": "Het is uit, hoe komt dat?",
          "source_text": "It's off, how come?",
          "transcription_review_required": false
        },
        "jdoa2-20": {
          "path": "res://assets/languages/nl/audio/jdoa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7c0bdeb5c72a6d535928ba6b79295acc67ec52b3ce0d1856028eefcb9836a4f4",
          "text": "Wie denk je dat hier achter zit?",
          "source_text": "Who do you think is behind this?",
          "transcription_review_required": false
        },
        "jdoa2-21": {
          "path": "res://assets/languages/nl/audio/jdoa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f7ff39c473d7ad09bcc59956f7493a8b94ed902f1adc53bed1098f49bf34ccc1",
          "text": "Veel opties.",
          "source_text": "Many options.",
          "transcription_review_required": false
        },
        "jdoa2-22": {
          "path": "res://assets/languages/nl/audio/jdoa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "258090af127a79b0259cacf7fc39e553682632a976c98afcd923743b8ee889a4",
          "text": "Waarom suggereerde je dat Susan hier misschien achter zat?",
          "source_text": "Why did you suggest that Susan might be behind this?",
          "transcription_review_required": false
        },
        "jdoa2-30": {
          "path": "res://assets/languages/nl/audio/jdoa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8c0f1dec3b945482472c642df68e29f66e647401c6caac4fb8824383feff4264",
          "text": "Bent u ergens allergisch voor?",
          "source_text": "Are you allergic to something?",
          "transcription_review_required": false
        },
        "jdoa2-40": {
          "path": "res://assets/languages/nl/audio/jdoa2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f82b3e16db932a93bd441a1934c9cb1e2662dd51af9622ac696cebfe22aecdb5",
          "text": "Je hebt je zakdoek nodig. Je neus loopt.",
          "source_text": "You need your handkerchief. Your nose is running.",
          "transcription_review_required": false
        },
        "jdoa2-50": {
          "path": "res://assets/languages/nl/audio/jdoa2-50.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c1f58f6760d77e66935687099eb535f592dd2f393049b6509a41b4c9fd30a54",
          "text": "Heb je een bijnaam?",
          "source_text": "Do you have a nickname?",
          "transcription_review_required": false
        },
        "jdob1-10": {
          "path": "res://assets/languages/nl/audio/jdob1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "598b746b14022be34ce1461ede0230e92f86dfc104e3acc3664b133aea597643",
          "text": "Waarom maakt Alice zich zo druk over deze film?",
          "source_text": "Why is Alice so bugged about this film?",
          "transcription_review_required": false
        },
        "jdob1-11": {
          "path": "res://assets/languages/nl/audio/jdob1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9d443a1885066159200a7eabd8d811437bfeb3bcea4352ac0950df167efec23c",
          "text": "Waarom denk je dat?",
          "source_text": "Why do you think that?",
          "transcription_review_required": false
        },
        "jdob1-12": {
          "path": "res://assets/languages/nl/audio/jdob1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "997bca60ccfacbf47e1f0f0429aac0494a6f463f1e1456e898e2f170d3265222",
          "text": "Wat zegt Alice dat haar redenen zijn om Jimmy te willen ontmoeten?",
          "source_text": "What does Alice say her reasons are for wanting to meet Jimmy?",
          "transcription_review_required": false
        },
        "jdob1-20": {
          "path": "res://assets/languages/nl/audio/jdob1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ef78dfa1adb6ccd568f9a8438e1359b3ac6a6c73622a202f6df774d1de116b7b",
          "text": "Heeft u enig idee waar de film zou kunnen zijn?",
          "source_text": "Do you have any idea where the film could be?",
          "transcription_review_required": false
        },
        "jdob2-10": {
          "path": "res://assets/languages/nl/audio/jdob2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7147f138c21cf0456185904a4a7c3365092ad0dfc59d8b70a6d02ccf2c3e138f",
          "text": "Wie had een briefje kunnen vervalsen om deze ontmoeting te voorkomen?",
          "source_text": "Who could have forged a note just to prevent this meeting?",
          "transcription_review_required": false
        },
        "jdob2-11": {
          "path": "res://assets/languages/nl/audio/jdob2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "47984cd3798d4eb66d248353f469002dedd7a2d11acc7af84f5612195bde8037",
          "text": "Weet je zeker dat je het aan niemand hebt verteld?",
          "source_text": "Are you sure you didn't tell anyone?",
          "transcription_review_required": false
        },
        "jdob2-12": {
          "path": "res://assets/languages/nl/audio/jdob2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c87edeb1ce94eba65ecbd830b1279acb7fbb67eaa50dd2b42f96e48e9ddbdbaa",
          "text": "Was jij degene die vandaag het lab bezocht?",
          "source_text": "Were you the one who visited the lab today?",
          "transcription_review_required": false
        },
        "jdob2-20": {
          "path": "res://assets/languages/nl/audio/jdob2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0ebbb889ed70f28814c7bf22560ed6358e2053de849f962f4d55e894d7232cd2",
          "text": "Denk je dat Alice bang is voor wat er gebeurt?",
          "source_text": "You think Alice is afraid of what's happening?",
          "transcription_review_required": false
        },
        "jsha1-10": {
          "path": "res://assets/languages/nl/audio/jsha1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "de1a4c8c8903fb0c547e002958ca4beb91de52f8081d1c18466b50d88393bac1",
          "text": "Heb je hier toevallig een rij films gevonden?",
          "source_text": "Did you by any chance find a row of film in here?",
          "transcription_review_required": false
        },
        "jsha1-20": {
          "path": "res://assets/languages/nl/audio/jsha1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0936be9b77a03c5ae237146ac5ebf0246233da48e9b8fbee1730a539ea94349c",
          "text": "Kom jij uit de buurt? Ik heb wat informatie nodig over de chemicaliÃ«n van Phillip.",
          "source_text": "Are you from around here? I need some information about Phillip's chemicals.",
          "transcription_review_required": false
        },
        "jsha1-30": {
          "path": "res://assets/languages/nl/audio/jsha1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fab256027c2a7c741bcb13a190df161476553d2415d02a17bfcd020c319755dd",
          "text": "Kent u een verslaggever genaamd Jimmy Mackenzie?",
          "source_text": "Do you know a reporter named Jimmy Mackenzie?",
          "transcription_review_required": false
        },
        "jsha1-31": {
          "path": "res://assets/languages/nl/audio/jsha1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "240f5d37d53d333066df7e358e4f4db0828918ea7d7676daa9d60fd352f92115",
          "text": "Welk gerucht?",
          "source_text": "What rumor?",
          "transcription_review_required": false
        },
        "jsha1-32": {
          "path": "res://assets/languages/nl/audio/jsha1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6062c51b776a4b0b19e7e7adfb748b5f0d1362dd0011062f18d04fe4605c3538",
          "text": "Wie verspreidt dat gerucht?",
          "source_text": "Who's spreading that rumor?",
          "transcription_review_required": false
        },
        "jsha2-10": {
          "path": "res://assets/languages/nl/audio/jsha2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2bf70b826eb5106cde8db5f8175043140554327036682abb385fa3ffd6c2f652",
          "text": "Ik kwam de rode kralenjurk van Alice ophalen.",
          "source_text": "I came to pick up Alice's red beaded dress.",
          "transcription_review_required": false
        },
        "jsha2-11": {
          "path": "res://assets/languages/nl/audio/jsha2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b9916c81cecb0a38b48fd0e27127759901f01b977397c549501203865bd63fe8",
          "text": "Maar ik heb de bon, dus waarom heeft iemand anders de jurk al meegenomen?",
          "source_text": "But I have the receipt, so how come someone else took the dress already?",
          "transcription_review_required": false
        },
        "jsha2-12": {
          "path": "res://assets/languages/nl/audio/jsha2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2fa21a1a0fc8d3215402bec78f3c9de98068d9f7d6f285c9cd30a74eaab79280",
          "text": "Wie denk je dat het zou kunnen hebben meegenomen?",
          "source_text": "Who do you think could have taken it?",
          "transcription_review_required": false
        },
        "jsha2-20": {
          "path": "res://assets/languages/nl/audio/jsha2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "63a4d8670ebe78335b980c9392defbfb305a4af610bf46f77430a02332bb2b00",
          "text": "Heeft iemand hier een jurk gestolen?",
          "source_text": "Did somebody steal a dress from here?",
          "transcription_review_required": false
        },
        "jsha2-30": {
          "path": "res://assets/languages/nl/audio/jsha2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a1536b5c01a3271fa5d7bdf6eb91ce1c435d3b4cd3d5edc2efddea9002b627ed",
          "text": "Wat zou je doen als je wist dat Jimmy met iemand omging?",
          "source_text": "What would you do if you knew Jimmy was seeing someone?",
          "transcription_review_required": false
        },
        "jshb1-10": {
          "path": "res://assets/languages/nl/audio/jshb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "77eb9fd3e239c82fbb199f871cfc103752d555b3976820e1f9330a4316109ed4",
          "text": "Zie je Jimmy McKenzie?",
          "source_text": "Are you seeing Jimmy McKenzie?",
          "transcription_review_required": false
        },
        "jshb1-11": {
          "path": "res://assets/languages/nl/audio/jshb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b9dfab22f2da60b40c1bfac660b90e351466441679b9be4346a368c54ff0a27",
          "text": "Wat zeggen ze over de fabriek van je vader?",
          "source_text": "What are they saying about your father's factory?",
          "transcription_review_required": false
        },
        "jshb1-12": {
          "path": "res://assets/languages/nl/audio/jshb1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c7b007441f1c655de535649ef64535d1a8e810ed89b2ac82c02bbb7d8b334cf7",
          "text": "Wie verspreidt deze leugens over de fabriek van je vader?",
          "source_text": "Who's spreading these lies about your father's factory?",
          "transcription_review_required": false
        },
        "jshb1-20": {
          "path": "res://assets/languages/nl/audio/jshb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aa376d8e65ace65fa40afe1150dee233b13aab0a6675af0c91589cc02e27c26c",
          "text": "Hoe zou jij je voelen als je ex-vriend met een ander meisje zou gaan daten?",
          "source_text": "How would you feel if your ex-boyfriend started dating another girl?",
          "transcription_review_required": false
        },
        "jshb1-30": {
          "path": "res://assets/languages/nl/audio/jshb1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "55149daa6479aa020a8304c3548bff32bf1e67d79a68c1349895c96ad269d616",
          "text": "Bent u de dochter van de eigenaar van de chemicaliÃ«n van Phillips?",
          "source_text": "Are you the daughter of the owner of Phillips' chemicals?",
          "transcription_review_required": false
        },
        "jshb1-31": {
          "path": "res://assets/languages/nl/audio/jshb1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "43562bc19469263ebf9ac93453ce20decfd8bdc14cb689d65e569b65c37316a2",
          "text": "Denkt u dat andere mensen er een probleem mee kunnen hebben dat u rijk bent?",
          "source_text": "Do you think other people may have a problem with you being rich?",
          "transcription_review_required": false
        },
        "jshb1-32": {
          "path": "res://assets/languages/nl/audio/jshb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bf706ea040ba35a765595f00cedb287dd7d63d7e1c9cc21637cb7a4a63f33285",
          "text": "Aan welke goede prijs schenkt jouw vader zijn geld?",
          "source_text": "What good cost does your daddy donate his money to?",
          "transcription_review_required": false
        },
        "jshb2-10": {
          "path": "res://assets/languages/nl/audio/jshb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a5a51847cd1f66525bd8e5f0865bacdad9ad85d50360b274730bc8ec64901be0",
          "text": "Ben je een bril kwijtgeraakt?",
          "source_text": "Did you lose a pair of glasses?",
          "transcription_review_required": false
        },
        "jshb2-11": {
          "path": "res://assets/languages/nl/audio/jshb2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8707ea87b16d9f8853cc586ebef6c5f0d0f81f4462e8da492ff2cb5e1b1b4535",
          "text": "Uit welk nummer komen deze muzieknoten?",
          "source_text": "What song are these music notes from?",
          "transcription_review_required": false
        },
        "jshb2-12": {
          "path": "res://assets/languages/nl/audio/jshb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8072e6dffbcf9395ae2dac645c1754154ce5225bdd12ca63ff031caddc5f4213",
          "text": "Lucardon-peper.",
          "source_text": "Lucardon Pepper.",
          "transcription_review_required": false
        },
        "jshb2-20": {
          "path": "res://assets/languages/nl/audio/jshb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "db5eec977024178d1fa17cff7834bfd5beda1c4fb015f85e0ae1591fedcaa043",
          "text": "Ik heb een briefje gevonden van Jimmy Mackenzie, waarin staat dat hij je altijd trouw zal blijven.",
          "source_text": "I found a note written by Jimmy Mackenzie, saying he'll always be loyal to you.",
          "transcription_review_required": false
        },
        "jshb2-21": {
          "path": "res://assets/languages/nl/audio/jshb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ea394f92c83a1014ca62e64982c7304b6718f34e6e51c56a75b92a1eb26f7b88",
          "text": "Waarom zou je niet teruggaan naar Jimmy?",
          "source_text": "Why wouldn't you go back to Jimmy?",
          "transcription_review_required": false
        },
        "jshb2-22": {
          "path": "res://assets/languages/nl/audio/jshb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2493661cf9a66676d6f462ae447ae9d898b51797fb1bdd782c8f656fd7b6e263",
          "text": "Kent u dit handschrift toevallig?",
          "source_text": "Do you by any chance know this handwriting?",
          "transcription_review_required": false
        },
        "jshb2-30": {
          "path": "res://assets/languages/nl/audio/jshb2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4362e5e589b9228ebfb0bf614a07b56e0ebd8d000d29984c12ffc311009e2ac4",
          "text": "Je hebt een geweldige stem. Heb je er ooit aan gedacht om bij een band te gaan?",
          "source_text": "You have a great voice. Did you ever think of joining a band?",
          "transcription_review_required": false
        },
        "jshb2-40": {
          "path": "res://assets/languages/nl/audio/jshb2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9bf582480a4a88a001b4257003ad91dcc7f58ea4b795e342032303346e1e7b6e",
          "text": "Ga door, zing voor mij!",
          "source_text": "Go on, sing to me!",
          "transcription_review_required": false
        },
        "sha1-01": {
          "path": "res://assets/languages/nl/audio/sha1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fd40277f1c5b6086ab17fc620fbbac5af979346737eb9184fd2f71848303818e",
          "text": "Ver weg, man, je outfit is zo cool.",
          "source_text": "Far out, man, your outfit is so cool.",
          "transcription_review_required": false
        },
        "sha1-02": {
          "path": "res://assets/languages/nl/audio/sha1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2cb0c7027f21769e3c008a04b1837247be91b1c1a4e32e0a671c26671debaf3e",
          "text": "Tata.",
          "source_text": "Tata.",
          "transcription_review_required": false
        },
        "sha1-03": {
          "path": "res://assets/languages/nl/audio/sha1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0eecf72604d37bd06fe21a104410546322c71d1b9cf4322d3f2b71015a3f7268",
          "text": "Ik heb het druk, lieverd. Mary en Faithful kunnen hier elk moment zijn.",
          "source_text": "I'm busy, darling. Mary and Faithful will be here any minute.",
          "transcription_review_required": false
        },
        "sha1-10": {
          "path": "res://assets/languages/nl/audio/sha1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c941cb0a55519b2f1832b1d7fcf314db148b92cf4ab9ad47a1158f27e263cab0",
          "text": "Film? Je maakt een grapje, toch? Dit is een kledingwinkel, voor het geval je het nog niet gemerkt had.",
          "source_text": "Film? You're kidding, right? This is a clothing store in case you hadn't noticed.",
          "transcription_review_required": false
        },
        "sha1-20": {
          "path": "res://assets/languages/nl/audio/sha1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3b1c49d79cddad40f6b421a05e72183d257eacb4260b9879bad5e7a825b2922b",
          "text": "Phillips Factory is het bedrijf van mijn familie, en niemand gaat het verpesten.",
          "source_text": "Phillips Factory is my family's business, and no one's going to ruin it.",
          "transcription_review_required": false
        },
        "sha1-30": {
          "path": "res://assets/languages/nl/audio/sha1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "69552f611d1fabd8c90c1f9581bd220997f402599d36297d14ddd6711f9694aa",
          "text": "Jimmy Mackenzie, waar haal je het idee vandaan dat ik hem ken?",
          "source_text": "Jimmy Mackenzie, where do you get the idea that I know him?",
          "transcription_review_required": false
        },
        "sha1-31": {
          "path": "res://assets/languages/nl/audio/sha1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4a7840004987bc3d91755ccff62de5849549287c7580ef4efab1d32af40f79d2",
          "text": "Er gaat een gerucht dat de chemicaliÃ«n van Philip giftige chemicaliÃ«n dumpen. Het is niet waar en er is geen film die het bewijst.",
          "source_text": "There's a rumor that Philip's chemicals dumps poisonous chemicals. It's not true and there's no film to prove it.",
          "transcription_review_required": false
        },
        "sha1-32a": {
          "path": "res://assets/languages/nl/audio/sha1-32a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d2da5ca9d1b9ac67efd6734affcdcf987bc03bdc5297d63fdaf8a199a2554e85",
          "text": "Jimmy.",
          "source_text": "Jimmy.",
          "transcription_review_required": false
        },
        "sha1-32b": {
          "path": "res://assets/languages/nl/audio/sha1-32b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0a00aaa12875cf39a7e3993e93e61669a5942608fcc640444b5a27775e44fa4f",
          "text": "Toen ik hem dumpte, was hij zo gekwetst dat hij dat belachelijke verhaal verzon.",
          "source_text": "When I dumped him, he was so hurt, he made up that ridiculous story.",
          "transcription_review_required": false
        },
        "sha130ha": {
          "path": "res://assets/languages/nl/audio/sha130ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a9fc9458f6fcb7399129fead984b2e2a5ec4d0766ccffbc8d9509e29a7aaae95",
          "text": "Goed...",
          "source_text": "Well...",
          "transcription_review_required": false
        },
        "sha130hb": {
          "path": "res://assets/languages/nl/audio/sha130hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a8c4cc1a5e94edfbabdb202c70dd0a7a4e485036b5d9923f3ae9aba4627126d1",
          "text": "Ter informatie: dat hele verhaal is een leugen. Hetzelfde als het gerucht over Philips chemicaliÃ«n.",
          "source_text": "For your information, that whole story is a lie. Same as the rumor about Philip's chemicals.",
          "transcription_review_required": false
        },
        "sha2-01": {
          "path": "res://assets/languages/nl/audio/sha2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e5bd831ddd4b0c83befb85b0749df28cfd697502f6d6fd445f872131a9c823a",
          "text": "Welke verre nagellak?",
          "source_text": "What far out nail polish?",
          "transcription_review_required": false
        },
        "sha2-02": {
          "path": "res://assets/languages/nl/audio/sha2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0eca67e8f92637c1b7ed1951a1d623a4599bba42f6e8aada87ad873615396399",
          "text": "Ciao!",
          "source_text": "Ciao!",
          "transcription_review_required": false
        },
        "sha2-03": {
          "path": "res://assets/languages/nl/audio/sha2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a1d360b5ee6114f039d051d857c542539da2dd477f585cde4f236406231bd1ee",
          "text": "Had ik je al verteld hoe hip je nagellak is?",
          "source_text": "Did I tell you how groovy your nail polish is?",
          "transcription_review_required": false
        },
        "sha2-10": {
          "path": "res://assets/languages/nl/audio/sha2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "16c5d8a39a19b510c5bb343b4c0c43787806fe05bc187937ba34a60d4594d9ab",
          "text": "Zonder bon geef ik niemand iets.",
          "source_text": "I don't give anything to anyone without a receipt.",
          "transcription_review_required": false
        },
        "sha2-10h": {
          "path": "res://assets/languages/nl/audio/sha2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ce9cc48f2c74b4a13f7133d3b363a141978c556e0eb60cfbb19ea05b1a784e11",
          "text": "Oh, het spijt me, maar ik heb het niet. Er kwam al iemand om het op te halen.",
          "source_text": "Oh, I'm sorry, but I don't have it. Someone already came to pick it up.",
          "transcription_review_required": false
        },
        "sha2-11": {
          "path": "res://assets/languages/nl/audio/sha2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "678d8922773c90f79575bc013ad83787835cd0b0c0770be91c7342ec7840f76a",
          "text": "Ik legde het op het aanrecht en ging even naar buiten. Toen ik terugkwam, was de jurk verdwenen. Natuurlijk zal ik het op de een of andere manier goedmaken met Alice.",
          "source_text": "I put it on the counter and went outside for a minute. When I came back, the dress was gone. Of course, I'll make it up to Alice somehow.",
          "transcription_review_required": false
        },
        "sha2-12a": {
          "path": "res://assets/languages/nl/audio/sha2-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "662509f9ca55d4cf75e1c85e8b503d2d82b25fc80143ecfaa60358a56d4dc548",
          "text": "Wie het ook was, heeft iets achtergelaten.",
          "source_text": "Whoever it was left something behind.",
          "transcription_review_required": false
        },
        "sha2-12b": {
          "path": "res://assets/languages/nl/audio/sha2-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0781c15d720c823491ac2a96b001a42c7307a6c6cb49c9931d1a86303afde583",
          "text": "Ik veronderstel dat het van een van die lelijke, gevederde jasjes is.",
          "source_text": "I suppose it's from one of those ugly, feathered jackets.",
          "transcription_review_required": false
        },
        "sha2-12c": {
          "path": "res://assets/languages/nl/audio/sha2-12c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "59deb4b6faed0f518ed72baa0fb12a54ba03e8f8031e0adfee5279f6a36c4b4f",
          "text": "Ik vertrouw niemand die zich kleedt als een parkiet.",
          "source_text": "I don't trust anyone who dresses like a parakeet.",
          "transcription_review_required": false
        },
        "sha2-20": {
          "path": "res://assets/languages/nl/audio/sha2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "df5778a7425375c4e5ac20e270d28766ce3a707648fbbc3c3e0d9bd47042d4c2",
          "text": "Dit is een exclusieve winkel. Niemand steelt hier iets.",
          "source_text": "This is an exclusive store. Nobody steals anything from here.",
          "transcription_review_required": false
        },
        "sha2-30": {
          "path": "res://assets/languages/nl/audio/sha2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "62e9ae70895db19bf98a60f1bd3beb237152661fc8841f9e10c13e889381e2be",
          "text": "Wat wil je van mij? Ik heb het je al verteld. Ik heb hem verlaten, en niet andersom.",
          "source_text": "What do you want from me? I've already told you. I left him, not the other way around.",
          "transcription_review_required": false
        },
        "sha2-30m": {
          "path": "res://assets/languages/nl/audio/sha2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "842566262b5b95c26beb493eae43106b49a9c33f4433de15df9df7c2dffdaaf5",
          "text": "Dit zijn echt originele kleuren.",
          "source_text": "These are really original colors.",
          "transcription_review_required": false
        },
        "sha2-h": {
          "path": "res://assets/languages/nl/audio/sha2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e6ff42c75e5309b40a6d0f0b7ef43e5b6fd59f2d58df7d2bca1175c103ea8697",
          "text": "Ik denk dat ik het in mijn haar ga doen. Het hoort echt bij deze dagen.",
          "source_text": "I think I'll put it in my hair. It's really in these days.",
          "transcription_review_required": false
        },
        "shb1-01": {
          "path": "res://assets/languages/nl/audio/shb1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6ecc1b64a34c040c3db44c80ef685c9500e4a8900cdd740e9ec1b0693283cee2",
          "text": "Hoi. Je bent in de hipste winkel van San Francisco. Zelfs Twiggy winkelt hier.",
          "source_text": "Hi. You're in the hippest store in San Francisco. Even Twiggy shops here.",
          "transcription_review_required": false
        },
        "shb1-02": {
          "path": "res://assets/languages/nl/audio/shb1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9fdbbd72f30c256ad0ff126b44cf539c4a8b3b618a9f4fc8af3539b2affdea56",
          "text": "Je kleding is een beetje ouderwets, maar ik vind je haarclips geweldig.",
          "source_text": "Your clothes are a bit old-fashioned, but I dig your hair clips.",
          "transcription_review_required": false
        },
        "shb1-03": {
          "path": "res://assets/languages/nl/audio/shb1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "deb145481d6084482e1ea3541459883b758b37e597e4ba3d63e9e2abf7d8bbaa",
          "text": "Doei.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "shb1-04": {
          "path": "res://assets/languages/nl/audio/shb1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b7a4b35de2680b0835ce09591a3fdbe35bab87408bae044f04bc8f4bcfb381a3",
          "text": "Schat, je hoeft me alleen maar te vertellen waar je die haarclip hebt gekocht.",
          "source_text": "Darling, you just have to tell me where you bought that hair clip.",
          "transcription_review_required": false
        },
        "shb1-10": {
          "path": "res://assets/languages/nl/audio/shb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1da1a766b241a92df4a590545e2eaca5ebd10c66b4136fbfdb52ec7bb708e677",
          "text": "Jimmy McKenzie, waarom denk je dat ik hem Ã¼berhaupt ken?",
          "source_text": "Jimmy McKenzie, why do you think I even know him?",
          "transcription_review_required": false
        },
        "shb1-10h": {
          "path": "res://assets/languages/nl/audio/shb1-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "21ffbc28ffe81a33ab9657cd0f38e1c82683250af29ce2b1d9545b4a5647e3ac",
          "text": "O, dat. Het zijn allemaal leugens. Net als de leugens die ze verspreiden over de fabriek van mijn vader.",
          "source_text": "Oh, that. It's all lies. Just like the lies they're spreading about my father's factory.",
          "transcription_review_required": false
        },
        "shb1-11": {
          "path": "res://assets/languages/nl/audio/shb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2494703316a99d38742c5b96b0199525e5110960c11646f2cff8f8ee06a982e7",
          "text": "Dat hij vergif in de zee giet. Het zijn allemaal leugens, en ze hebben geen film om het te bewijzen.",
          "source_text": "That he's pouring poison into the sea. It's all lies, and they don't have a film to prove it.",
          "transcription_review_required": false
        },
        "shb1-12a": {
          "path": "res://assets/languages/nl/audio/shb1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "40ab11d73b9c7b81ce8f9668999935825406e55f922da12489e3460cc6c03542",
          "text": "Het is Jimmy.",
          "source_text": "It's Jimmy.",
          "transcription_review_required": false
        },
        "shb1-12b": {
          "path": "res://assets/languages/nl/audio/shb1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "724d29540db39a39b2385347e0afc18a6438d3355f986a5e29b7817f62a21543",
          "text": "Hij is zo gekwetst dat ik hem verliet, dat hij mij probeert terug te pakken door mijn vader pijn te doen.",
          "source_text": "He's so hurt that I left him, that he's trying to get back at me by hurting my father.",
          "transcription_review_required": false
        },
        "shb1-20": {
          "path": "res://assets/languages/nl/audio/shb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "14cabc6bb86d105e2f8e37b91ef75c7845aade054e159c441dcf7a51f69d0e45",
          "text": "Hoe durf je mij, Sheila Phillips, die vraag te stellen?",
          "source_text": "How dare you ask me, Sheila Phillips, that question?",
          "transcription_review_required": false
        },
        "shb1-20m": {
          "path": "res://assets/languages/nl/audio/shb1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "33ed782a88192d237e0b41039e8bea8f738a199659e1807fd26684816e02dc74",
          "text": "Wauw. Diamanten zijn de beste vriend van een meisje. Het moet natuurlijk wel een fortuin zijn.",
          "source_text": "Wow. Diamonds are a girl's best friend. It must, of course, you'll fortune.",
          "transcription_review_required": false
        },
        "shb1-30a": {
          "path": "res://assets/languages/nl/audio/shb1-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3ee2ba3a9c8aedabf97b51acc55adcfc128e7b32a004eaae5595fba824d6981d",
          "text": "Ja, en ik ben er trots op. Ik heb er geen probleem mee om rijk te zijn.",
          "source_text": "Yes, and I'm proud of it. I don't have any problem with being rich.",
          "transcription_review_required": false
        },
        "shb1-30b": {
          "path": "res://assets/languages/nl/audio/shb1-30b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3a43070f7cb58abf7cd4269c3f057cd06bb118e62d3f71b4d38a44936f3dbf30",
          "text": "Hoe dan ook, mijn vader geeft zijn geld weg aan goede doelen.",
          "source_text": "Anyway, my father gives his money away to good causes.",
          "transcription_review_required": false
        },
        "shb1-31": {
          "path": "res://assets/languages/nl/audio/shb1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "990b9e02530d1faf3ee06a92dab1abea13fd62fcfba57b33d68630bf2556703f",
          "text": "Ik ben er zeker van. Waarom zouden ze anders midden in de nacht komen en foto's maken van dingen die niet eens bestaan?",
          "source_text": "I'm sure of it. Otherwise, why would they come in the middle of the night and take photos of things that don't even exist?",
          "transcription_review_required": false
        },
        "shb1-32": {
          "path": "res://assets/languages/nl/audio/shb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f610dd84e3372b0075f78c317eeb848b1fa332637cf0f55cf2cd3042fb06cbbe",
          "text": "Welnu, wij sponsoren jonge wetenschappers zoals Larry Chang bijvoorbeeld. Hij kan je vertellen dat we nog nooit DDT hebben gebruikt.",
          "source_text": "Well, we sponsor young scientists like Larry Chang, for example. He can tell you that we've never used DDT.",
          "transcription_review_required": false
        },
        "shb2-01": {
          "path": "res://assets/languages/nl/audio/shb2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5f7f9bfb3ae46daba4bdfd707a992d13976f97015f945bbdb4b85cb9fd2e086a",
          "text": "Je bent net op tijd. Jane staat op het punt te arriveren. Fonda, bedoel ik.",
          "source_text": "You're just in time. Jane is about to arrive. Fonda, I mean.",
          "transcription_review_required": false
        },
        "shb2-02": {
          "path": "res://assets/languages/nl/audio/shb2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7b6116209351fb849b6f2473b455c3adc4df28b813901d83fd3e83fc07599f34",
          "text": "Wil je niet op Jane wachten? Nou ja.",
          "source_text": "Don't you want to wait for Jane? Oh, well.",
          "transcription_review_required": false
        },
        "shb2-03": {
          "path": "res://assets/languages/nl/audio/shb2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f46ff1ffb4784605eacdd0a64acc538351bbf209b5cccb6b959fe440857c8a4c",
          "text": "Je mist gewoon Jane.",
          "source_text": "You just miss Jane.",
          "transcription_review_required": false
        },
        "shb2-10": {
          "path": "res://assets/languages/nl/audio/shb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1f8556e595f5fe147960e9335de84ade1fa9535996666093fb49ce20f4a8779d",
          "text": "Bril? Waarom denk je dat ik een bril kwijt ben?",
          "source_text": "Glasses? Why do you think I lost a pair of glasses?",
          "transcription_review_required": false
        },
        "shb2-11": {
          "path": "res://assets/languages/nl/audio/shb2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "40441d1100c78638a4e112fbac8463fe18ceeebae404bc5cedeed5fadfc40020",
          "text": "Ik kan geen muziek lezen, maar ik weet zeker dat Rick van de platenwinkel weet welk stuk dit is.",
          "source_text": "I can't read music, but I'm sure Rick from the record store will know what piece this is.",
          "transcription_review_required": false
        },
        "shb2-12": {
          "path": "res://assets/languages/nl/audio/shb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ee1e81a6c8b21f7168393080fc5dce795bffdf6299bfe885d13b6ae9337c4fa2",
          "text": "Ben je gisteren geboren of zo? Sergeant Pepper is de naam van het nieuwe Beatles-album.",
          "source_text": "Were you born yesterday or something? Sergeant Pepper is the name of the new Beatles album.",
          "transcription_review_required": false
        },
        "shb2-20": {
          "path": "res://assets/languages/nl/audio/shb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cce1926cd7dc602fd94ff084a3450cbc90194a4449484524853ffa4c39001527",
          "text": "Nee, je liegt. Laat me snel kijken.",
          "source_text": "No, you're lying. Let me see quickly.",
          "transcription_review_required": false
        },
        "shb2-20h": {
          "path": "res://assets/languages/nl/audio/shb2-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e2e4318df50b115332cab346cfc3ab6556759b913364fa5328fa33026feaa27b",
          "text": "Oh, dat is niet Jimmy's handschrift. Maar vergis je niet, ik zou niet naar hem terug willen, ook al smeekte hij om zijn leven.",
          "source_text": "Oh, that's not Jimmy's handwriting. But make no mistake, I wouldn't want to go back to him even if he begged for his life.",
          "transcription_review_required": false
        },
        "shb2-21": {
          "path": "res://assets/languages/nl/audio/shb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0f1d01f856456c6cbcbef346eb7f0b7b6ab26f6128ece365a5bc3ccb9508a7c0",
          "text": "Laten we iets duidelijk maken. Ik heb hem verlaten, en niet andersom. Ik geloof ook dat wat gedaan is, gedaan is. Ik ben niet zoals Rick, die zijn liefdesleven recycleert.",
          "source_text": "Let's get something straight. I left him, not the other way around. Also, I believe that what's done is done. I'm not like Rick, who recycles his love life.",
          "transcription_review_required": false
        },
        "shb2-22": {
          "path": "res://assets/languages/nl/audio/shb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6ef3677f332dc7b4d8c6ffacc0e3df7fad1c372d89c3afce4749fa38e0f4edbb",
          "text": "Nee, ik heb het nog nooit eerder gezien.",
          "source_text": "No, I've never seen it before.",
          "transcription_review_required": false
        },
        "shb2-30": {
          "path": "res://assets/languages/nl/audio/shb2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "45b42493769a55fee3abe355c1bec8aad795854301bf30b602b58c40b06e7be5",
          "text": "Nou, ik heb mensen horen zeggen dat ik een stem heb zoals Janice Joplin. Maar mijn stem heeft een hogere toon dan die van haar. Mm-hmm, neem nog een stukje van mijn hart, schat. Mm-hmm.",
          "source_text": "Well, I've heard people say that I've got a voice just like Janice Joplin. But my voice has a higher pitch than hers. Mm-hmm, take another piece of my heart, baby. Mm-hmm.",
          "transcription_review_required": false
        },
        "shb2-40": {
          "path": "res://assets/languages/nl/audio/shb2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "47106d1e27d88408517f4627475bb053fbbb1da9d9ad804fb4b180bfdedec2ed",
          "text": "Je bent te veel, dat weet je. Lijkt dit op mijn douche?",
          "source_text": "You're too much, you know that. Does this look like my shower to you?",
          "transcription_review_required": false
        },
        "shb2-40m": {
          "path": "res://assets/languages/nl/audio/shb2-40m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "70579efb0dada38325386eaff62f46c8976458d06275a9d4846fa9dd73dc74da",
          "text": "Ah, de collectie van volgende winter. Maar het is zo ouderwets. Vreemd.",
          "source_text": "Ah, next winter's collection. But it's so old-fashioned. Strange.",
          "transcription_review_required": false
        },
        "shb210ha": {
          "path": "res://assets/languages/nl/audio/shb210ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6ed8e6be43b943bd258a1914439f6837f452340f33abf0911bf308ebb83a863f",
          "text": "Wat? Denk je dat ik dat heb geschreven omdat mijn initialen SP zijn? Het volgende is dat u sergeant Pepper gaat beschuldigen.",
          "source_text": "What? You think I wrote that because my initials are SP? Next thing, you'll be accusing Sergeant Pepper.",
          "transcription_review_required": false
        },
        "shb210hb": {
          "path": "res://assets/languages/nl/audio/shb210hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "872af4fccd4d7f9b0998a683f3e7d8c4b95a49346f5d5f0c36c594d3c5bc6313",
          "text": "Eh, het moet van de man zijn die zijn muziek hier vergat.",
          "source_text": "Um, it must belong to the guy who forgot his music here.",
          "transcription_review_required": false
        },
        "shl-01": {
          "path": "res://assets/languages/nl/audio/shl-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fb9773dfbb552bc6ef277cf9ba273dd6c370764164152f6410a2772c7d9c2406",
          "text": "Waarom zou je in vredesnaam denken dat ik het deed?",
          "source_text": "Why on earth would you think I did it?",
          "transcription_review_required": false
        },
        "shl-02": {
          "path": "res://assets/languages/nl/audio/shl-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05e1653f1e71ec3f303731f57a22783699f5095cc390b4b6688337927a402aa7",
          "text": "Waarom is dit een zorg van mij?",
          "source_text": "Why is this any concern of mine?",
          "transcription_review_required": false
        },
        "shl-03": {
          "path": "res://assets/languages/nl/audio/shl-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "323b2fd982a7acb7d35cd52ebfa61fcc618a3089022c7eb74da0b2efaaabeeb5",
          "text": "HÃ©, ik ben niet zo wanhopig.",
          "source_text": "Hey, I'm not that desperate.",
          "transcription_review_required": false
        },
        "shl-04": {
          "path": "res://assets/languages/nl/audio/shl-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ba9104f921438fa48a9f1344accdcb96e457fd670f958b1e1f1804928ebd34a0",
          "text": "Dit bewijst nog steeds niets.",
          "source_text": "This still doesn't prove anything.",
          "transcription_review_required": false
        },
        "shl-05": {
          "path": "res://assets/languages/nl/audio/shl-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "50b2b259ea586c654bafd862488bedb6dcb9cb10b8d1018ae3cb476cdecf4346",
          "text": "Ik kan niet geloven dat ze al die dingen doet alleen maar om hem te ontmoeten.",
          "source_text": "I can't believe she's doing all that stuff just to meet him.",
          "transcription_review_required": false
        },
        "shl-06": {
          "path": "res://assets/languages/nl/audio/shl-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9e3dd3013b426e0f70bf350b48e673199a877e1a506640c4788703dfba809ad6",
          "text": "Dus wat?",
          "source_text": "So what?",
          "transcription_review_required": false
        },
        "shl-07": {
          "path": "res://assets/languages/nl/audio/shl-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3021f4be00ad551c0fe23ca427f43246d54a6c921c40c2bee3c4213c8058d868",
          "text": "Je kunt niet zomaar onschuldige mensen beschuldigen. Zit jij bij de KGB of zo?",
          "source_text": "You can't just accuse innocent people. Are you with a KGB or what?",
          "transcription_review_required": false
        },
        "shla-01": {
          "path": "res://assets/languages/nl/audio/shla-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3107c46c3dac03782a16f47d9cc3f7e5fc1383d33c3f69cc0079f1e543fc8ff4",
          "text": "Ik wist al die tijd dat het Dorothy was. Het staat helemaal op haar lijf geschreven. Geen wonder dat haar smaak in kleding zo verachtelijk is.",
          "source_text": "I knew it was Dorothy all along. It's written all over her. No wonder her taste in clothes is so despicable.",
          "transcription_review_required": false
        },
        "shlb-01": {
          "path": "res://assets/languages/nl/audio/shlb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "74bb396e8f7023a0caddf56be47c6da08365bfdfc95b8f7cc6356e9a1bee1d1c",
          "text": "Het is zielig hoe Rick Alice probeert vast te houden. Ik zeg: als je van iemand houdt, laat hem of haar dan vrij.",
          "source_text": "It's pathetic how Rick tries to hang on to Alice. I say, if you love someone, set them free.",
          "transcription_review_required": false
        },
        "jria1-10": {
          "path": "res://assets/languages/nl/audio/jria1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f9e571aaa493b87806269d0c86c396456abc713ac4d6879cfed597f2f4c499b3",
          "text": "Misschien kan ik je helpen.",
          "source_text": "Maybe I can help you.",
          "transcription_review_required": false
        },
        "jria2-10": {
          "path": "res://assets/languages/nl/audio/jria2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "08aa3fdd1c96217e76c2b9360e5044d59c33a68916b3374b2ae6e92ce8f6d015",
          "text": "Is er vandaag iemand in een roze hesje naar de winkel geweest?",
          "source_text": "Did anyone wearing a pink vest visit the store today?",
          "transcription_review_required": false
        },
        "jria2-11": {
          "path": "res://assets/languages/nl/audio/jria2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "402586ca573da7f79d67de8b40d298f0b79985cf12bc3e137768320e6449e44c",
          "text": "Wie is Veronica?",
          "source_text": "Who's Veronica?",
          "transcription_review_required": false
        },
        "jria2-12": {
          "path": "res://assets/languages/nl/audio/jria2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7a5c97f07b6937fe6cc2054f3db7321e56f250d9df94c4419b968c76af6ee891",
          "text": "Waarom maak je Veronica belachelijk?",
          "source_text": "Why are you mocking Veronica?",
          "transcription_review_required": false
        },
        "jria2-20": {
          "path": "res://assets/languages/nl/audio/jria2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "297a410ca45a1a56e8b005846a0e8917f936a96842591d68364d98e66f57bdf1",
          "text": "Ik heb een sjaal precies zoals die van jou! Laat die van jou ook overal zijn veren achter?",
          "source_text": "I have a scarf exactly like yours! Does yours also leave its feathers everywhere?",
          "transcription_review_required": false
        },
        "jria2-21": {
          "path": "res://assets/languages/nl/audio/jria2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af412a63e568ab72fa0aaeaca8b2a6cf1531df6174c86118b21004f4dd9a6076",
          "text": "Waar ben je vandaag geweest?",
          "source_text": "Where have you been today?",
          "transcription_review_required": false
        },
        "jria2-22": {
          "path": "res://assets/languages/nl/audio/jria2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c193ec6002519dc22e597db69046c7a3169994a3d74829f116b4127dac5689d",
          "text": "Ik vond sporen van jou in Alice's tas.",
          "source_text": "I found traces of you in Alice's bag.",
          "transcription_review_required": false
        },
        "jrib1-10": {
          "path": "res://assets/languages/nl/audio/jrib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dd34aacc4cedcbecb33449402fce1849ad9b140182ec15aaafdb415b3c93e4a4",
          "text": "Ken jij Jimmy McKenzie toevallig?",
          "source_text": "Do you happen to know Jimmy McKenzie?",
          "transcription_review_required": false
        },
        "jrib1-11": {
          "path": "res://assets/languages/nl/audio/jrib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "19ccbac87490303e24fc8f7c31299ac27934ede341288efd827e673bb4069c2b",
          "text": "Wil je me vertellen dat jullie vrienden zijn?",
          "source_text": "You want to tell me that you two are friends?",
          "transcription_review_required": false
        },
        "jrib1-12": {
          "path": "res://assets/languages/nl/audio/jrib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "32bba4260b8c8867f64e687130ddc4253cc8834ad87e9ede523d3d4f9939116e",
          "text": "Weet je wie Jimmy Mackenzie tegenwoordig ziet? Remantisch gesproken bedoel ik.",
          "source_text": "Do you know who Jimmy Mackenzie's seeing these days? Remantically speaking, I mean.",
          "transcription_review_required": false
        },
        "jrib1-20": {
          "path": "res://assets/languages/nl/audio/jrib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3b5056327cff514036e74219ffe1c2e2f3bffe3d2186133a3d7c37a94b909af5",
          "text": "Hoe voel jij je als je een slechte recensie krijgt?",
          "source_text": "How do you feel when you get a bad review?",
          "transcription_review_required": false
        },
        "jrib2-10": {
          "path": "res://assets/languages/nl/audio/jrib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "643c5c986ac64f74dda739d44c37fa3c50fc82a64356e43c0318be642cb4e669",
          "text": "Wauw, je ziet er geweldig uit. Mag ik je handtekening?",
          "source_text": "Wow, you seem great. Can I have your autograph?",
          "transcription_review_required": false
        },
        "jrib2-20": {
          "path": "res://assets/languages/nl/audio/jrib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0278266910fff37ad2e1a614675629dd53d09ff1783e7c7753852e5fd691a375",
          "text": "Waar gaat dit liedje over?",
          "source_text": "What's this song about?",
          "transcription_review_required": false
        },
        "jrib2-30": {
          "path": "res://assets/languages/nl/audio/jrib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c9702ffb67950ba227e909ece7ad8e9c0604fe41a1ed90d36b9e1fea26b28899",
          "text": "Heeft u een probleem met spelling?",
          "source_text": "Do you have a problem with spelling?",
          "transcription_review_required": false
        },
        "ria1-02": {
          "path": "res://assets/languages/nl/audio/ria1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "92432e099d76b760dfabc972ccffad7c0bbdc87613f36216d67e21e2c8db1eb0",
          "text": "Ik kan nu niet praten. Ik hoorde net dat mijn ex-vriendin over mij heen is. Ik ben verdwaald.",
          "source_text": "I can't talk now. I just heard my ex-girlfriend is over me. I'm lost.",
          "transcription_review_required": false
        },
        "ria1-03": {
          "path": "res://assets/languages/nl/audio/ria1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "527ee8a76c7237c862025f31d3c8da8145c3cdba33dbf27d295d1dca2850f6a0",
          "text": "Ik ben een beetje down vandaag. Ik moet nu mediteren, als je het niet erg vindt.",
          "source_text": "I'm a little bit down today. I need to meditate now, if you don't mind.",
          "transcription_review_required": false
        },
        "ria1-10": {
          "path": "res://assets/languages/nl/audio/ria1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7d7a5c59e4c6573ffa2d4c0b27beb0084635d4de6f76b628efa7e0c052e24a84",
          "text": "Jullie allemaal, ik kan wel wat hulp van mijn vrienden gebruiken, maar ik ben nu liever alleen.",
          "source_text": "Y'all, I can use a little help from my friends, but I'd rather be alone now.",
          "transcription_review_required": false
        },
        "ria2-01": {
          "path": "res://assets/languages/nl/audio/ria2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "34beff07d97e0786d5d32b5f1bb0b6f232f7625088c3198302012dee3829bb45",
          "text": "Dit kan mij niet gebeuren. Ik kan mijn gelukkige keuze voor mijn gitaar niet vinden, en ik heb vanavond een show!",
          "source_text": "This can't be happening to me. I can't find my lucky pick for my guitar, and I have a show tonight!",
          "transcription_review_required": false
        },
        "ria2-02": {
          "path": "res://assets/languages/nl/audio/ria2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "59db92831d78eadd27e1b9e6f5d2cd8717f7e3dc7c4caac41c4279f9f9d02830",
          "text": "Ik kan nu niets verwerken, het spijt me.",
          "source_text": "I can't deal with anything now, I'm sorry.",
          "transcription_review_required": false
        },
        "ria2-03": {
          "path": "res://assets/languages/nl/audio/ria2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c2f0c4c695ee3bac62f673fa1cd918dc3ab216b66e64085165136e076db3f2c7",
          "text": "Wat swingt het, man? Ik ben helemaal van jou, heb mijn keuze gevonden, relaxed, man.",
          "source_text": "What swingin', man? I'm all yours, found my pickin' down, laid back, man.",
          "transcription_review_required": false
        },
        "ria2-05": {
          "path": "res://assets/languages/nl/audio/ria2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "695bd19357c9ee8c04e439276aad6d3a84494ead671d19bd6223cb7112344e33",
          "text": "HÃ©, nogmaals. Terwijl er, zoals Lennon zegt, niets nieuws onder de zon is. Ha.",
          "source_text": "Hey, again. While, like, Lennon says, there's nothing new under the sun. Ha.",
          "transcription_review_required": false
        },
        "ria2-10": {
          "path": "res://assets/languages/nl/audio/ria2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aceff310caddf6b817fb2fbf0739b15ee9bf1669a6205482965d4e940006b3ea",
          "text": "Het spijt me, zuster. Vraag me wat voor soort muziek ze zingen, en ik zal het zo beantwoorden, maar het roze vest?",
          "source_text": "Sorry, sister. Ask me what kind of music they dig, and I'll answer it in a second, but the pink vest?",
          "transcription_review_required": false
        },
        "ria2-10h": {
          "path": "res://assets/languages/nl/audio/ria2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4dfc3846867f3a14372ce35027d258aaf9b3d1fa9ec0b06a8995f0fcead08941",
          "text": "Nu ben je aan het praten. De Paul Onka, dame. Ja, ze heeft dit achtergelaten. Veronica.",
          "source_text": "Now you're talking. The Paul Onka, lady. Yeah, she left this behind. Veronica.",
          "transcription_review_required": false
        },
        "ria2-11a": {
          "path": "res://assets/languages/nl/audio/ria2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3617564552a38797c42ca13a7d7f353c9cb7141fdc363cf503bd23336d0d35eb",
          "text": "Zuster, wanneer ben je op deze planeet aangekomen?",
          "source_text": "Sister, when did you arrive on this planet?",
          "transcription_review_required": false
        },
        "ria2-11b": {
          "path": "res://assets/languages/nl/audio/ria2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0406b0fdc48481780abcbde323d98f61231e3132b288e0ef3b7bc51ebc4ed5ca",
          "text": "Veronica, zoals in Betty en Veronica, uit de strips van Archie, je weet wel, Betty en Veronica, allebei verliefd op dezelfde jongen van school.",
          "source_text": "Veronica, as in Betty and Veronica, from the Archie's comics, you know, Betty and Veronica, both in love with the same guy from school.",
          "transcription_review_required": false
        },
        "ria2-12": {
          "path": "res://assets/languages/nl/audio/ria2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1aa787ec65a5f11c241099303da26980c8390e0d0dd8d97875f3076ea29b631e",
          "text": "Hallo, word wakker, het zijn de jaren 60, strips zijn uit, alsof we het echte werk willen.",
          "source_text": "Hello, wake up, it's the 60s, comics are out, like we want the real thing.",
          "transcription_review_required": false
        },
        "ria2-20": {
          "path": "res://assets/languages/nl/audio/ria2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4ffbb85404e69ccbd3c5a10a19a7a6cf344affb5508d627808efe14d411d469c",
          "text": "Daar kan ik me in vinden, man. Ik weet. Wat een spelbreker. Waar ik ook ga, ik laat sporen achter.",
          "source_text": "I can relate to that, man. I know. What a bummer. I leave tracks wherever I go.",
          "transcription_review_required": false
        },
        "ria2-21": {
          "path": "res://assets/languages/nl/audio/ria2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "12d6d033b4baceab3fb8dc3e9ef3350bb6a58248217eb3587e19183ce0eab502",
          "text": "Vandaag was ik hier de hele dag aan het zoeken in elke la naar mijn keuze, maar goed nieuws, ik heb het gevonden in Jefferson's vliegtuig, man.",
          "source_text": "Today, I was here all day searching every drawer for my pick, but good news, I found it in Jefferson's airplane, man.",
          "transcription_review_required": false
        },
        "ria2-22": {
          "path": "res://assets/languages/nl/audio/ria2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ba9486da54b91ef5942a54d118698a953c309b2dc6ddb0d22ad88eba5fa735c1",
          "text": "HÃ©, nieuwsgierig meisje, ik heb belangrijkere dingen te doen dan naar je beschuldigingen te luisteren, okÃ©?",
          "source_text": "Hey, nosy girl, I have more important things to do than to listen to your accusations, okay?",
          "transcription_review_required": false
        },
        "ria2-22m": {
          "path": "res://assets/languages/nl/audio/ria2-22m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5ab4d747cf2759f4670077dba1c4c39bf222cd3acd2e32fd48f99fe12392180b",
          "text": "Verreweg, man, een miniatuurplaat, maar ik zeg je, mensen gaan niet betalen voor zoiets kleins.",
          "source_text": "Far out, man, a miniature record, but I'm telling you, people aren't gonna pay for something that small.",
          "transcription_review_required": false
        },
        "ria2-h": {
          "path": "res://assets/languages/nl/audio/ria2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b66bf111a2a23644902064487b49904240e901621674b8a9267862708dbecef",
          "text": "Het ruikt naar een tienergeest.",
          "source_text": "It smells like a teen spirit.",
          "transcription_review_required": false
        },
        "rib1-01": {
          "path": "res://assets/languages/nl/audio/rib1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e5bea22048c6ecbf08dc4d031ea51399a0500b4877768cafd134c1416f7e176",
          "text": "Muziek, zuster, is de sleutel tot uw ziel. Vrede en harmonie zullen je doel worden. Diep, hÃ¨?",
          "source_text": "Music, Sister, is the key to your soul. Peace and harmony will become your goal. Deep, huh?",
          "transcription_review_required": false
        },
        "rib1-02": {
          "path": "res://assets/languages/nl/audio/rib1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3a25bc3acf2af69f57968632c9feb74d8f27ce2716839b2d577eecef2346b29d",
          "text": "Als je mij vraagt â€‹â€‹hoe ik me vandaag goed voel, lijken gisteren al mijn problemen zo ver weg. Ja.",
          "source_text": "If you ask me how I feel today well, yesterday all my troubles seem so far away. Yeah.",
          "transcription_review_required": false
        },
        "rib1-03": {
          "path": "res://assets/languages/nl/audio/rib1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "681066972c29fb30fa5af022b26e732f569bbe91afd99dff3d1fa85e6be83d9d",
          "text": "Ik hou van jou, zuster!",
          "source_text": "Love to you, sister!",
          "transcription_review_required": false
        },
        "rib1-04": {
          "path": "res://assets/languages/nl/audio/rib1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "042effc1c0e0b19568e46b876065d01c0e424bf054b497856ea75116746c6066",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib1-10": {
          "path": "res://assets/languages/nl/audio/rib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07707fe18dc23a83121318c5750559706bda7d911351c370bfa3cd139a0ab554",
          "text": "Ja, zeker. Hij is een coole kat, en ik vind hem leuk.",
          "source_text": "Yeah, sure. He's one cool cat, and I like the guy.",
          "transcription_review_required": false
        },
        "rib1-11": {
          "path": "res://assets/languages/nl/audio/rib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "964bc45efb45152720d2a726de60ad197f8d26504a01bfb4cabe9cd229db3c2e",
          "text": "Wat zorgt ervoor dat jij anders denkt?",
          "source_text": "What makes you think differently?",
          "transcription_review_required": false
        },
        "rib1-11h": {
          "path": "res://assets/languages/nl/audio/rib1-11h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bf094237bf8ad1531f291281acac63bb68d3dc70d6199de06f9ae6539e389517",
          "text": "Oh, nou, dat, nou, Jimmy kan wreed zijn met zijn schrijven, maar ik geloof in de vrijheid van meningsuiting, dus ik zeg: laat het zo zijn. Hoe dan ook, hij heeft zich al bij mij verontschuldigd, man.",
          "source_text": "Oh, well, that, well, Jimmy can be cruel with his writing, but I believe in the freedom of speech, so I say, let it be. Anyhow, he already apologized to me, man.",
          "transcription_review_required": false
        },
        "rib1-12a": {
          "path": "res://assets/languages/nl/audio/rib1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d53776df8779f9c6ab73ceebdd5988ff5c70683e2c0065eea1386f0201dc68ab",
          "text": "Hij heeft het net uitgemaakt met Sheila, man. Ik denk dat hij niet meer van haar houdt.",
          "source_text": "He just split up with Sheila, man. I guess he doesn't love her anymore.",
          "transcription_review_required": false
        },
        "rib1-12b": {
          "path": "res://assets/languages/nl/audio/rib1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bdbf92db2c20b6927684648ea9a775da796a2170450300810c9d5d249f162779",
          "text": "Wat mij doet denken aan mijn eigen liefde. Oh, waarom, dat was ze niet geweest, ik weet het niet. Ze zei: haha.",
          "source_text": "Which reminds me of my own love. Oh, why, she hadn't been, I don't know. She was saying, hah.",
          "transcription_review_required": false
        },
        "rib1-20": {
          "path": "res://assets/languages/nl/audio/rib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e1de5753e1a946d9faedeff5ed05105fdde9aeb5039827b58b14d8d2116dfbfd",
          "text": "Ik ben het negatieve bla, bla, bla, man beu. Ik wou dat mijn Eris alleen muziek kon horen.",
          "source_text": "I am sick and tired of negative blah, blah, blah, man. I wish my Eris could only hear music.",
          "transcription_review_required": false
        },
        "rib1-20m": {
          "path": "res://assets/languages/nl/audio/rib1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "618a3497e05b926379f5fde2936e97251dea95d22112801dfff5174304d204d2",
          "text": "Wat een coole nieuwe machine, man. Een wandelende muziekspeler. Dat ontroert mij, man.",
          "source_text": "What a cool new machine, man. A walking music player. That moves me, man.",
          "transcription_review_required": false
        },
        "rib2-01": {
          "path": "res://assets/languages/nl/audio/rib2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6dd4a13eaa8a661160c57cc121dd6298e8807a0576fea79fe4701e2e3bbd26aa",
          "text": "Ik kan nu niet praten, man. Ik ben mijn muziek voor het concert van vanavond kwijtgeraakt.",
          "source_text": "I can't talk now, man. I lost my music for tonight's concert.",
          "transcription_review_required": false
        },
        "rib2-02": {
          "path": "res://assets/languages/nl/audio/rib2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f447229e8e334722b277eb96ad379aa06e04a1c1fb9cf397ccb5906298ab11b8",
          "text": "Ik kan nu echt niet meer tegen deze rommel. Mijn muziek voor het concert van vanavond is nergens te vinden.",
          "source_text": "I can't really deal with this rubbish now. My music for tonight's concert is like nowhere to be found.",
          "transcription_review_required": false
        },
        "rib2-02h": {
          "path": "res://assets/languages/nl/audio/rib2-02h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5fe023f4eed3523241be4a2f81e225fb788b919d754ed5fa2a4316a5902e443b",
          "text": "Wat is dit? Ik kan het niet lezen. Ik heb mijn bril niet. O, mens. Wat een dag. Wat een dag.",
          "source_text": "What is this? I can't read it. I don't have my glasses. Oh, man. What a day. What a day.",
          "transcription_review_required": false
        },
        "rib2-03": {
          "path": "res://assets/languages/nl/audio/rib2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "333d819b966505ee94b67b9f9e9e8bf0d63aa498719717f54ef383c66c0794f2",
          "text": "Waar is mijn bril?",
          "source_text": "Where are my glasses?",
          "transcription_review_required": false
        },
        "rib2-04a": {
          "path": "res://assets/languages/nl/audio/rib2-04a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f4f53bc30fa29d22490247395747e18fd9d1ad513da002be45bafc33ab49593d",
          "text": "Laten we eens kijken. Ja, dit is mijn muziek.",
          "source_text": "Let's see. Yes, this is my music.",
          "transcription_review_required": false
        },
        "rib2-04b": {
          "path": "res://assets/languages/nl/audio/rib2-04b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f63414f5632a935c5a264fda6b21a5296115e796f162d5eac48b585d55a66e17",
          "text": "De muziek staat!",
          "source_text": "The music's up!",
          "transcription_review_required": true
        },
        "rib2-05": {
          "path": "res://assets/languages/nl/audio/rib2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7f6b571ccf516fa0989dae0c979c859d3d7a96f4dee223c188f7b882f8a473cd",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib2-05a": {
          "path": "res://assets/languages/nl/audio/rib2-05a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7f6b571ccf516fa0989dae0c979c859d3d7a96f4dee223c188f7b882f8a473cd",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "rib2-06": {
          "path": "res://assets/languages/nl/audio/rib2-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2e35db126ef239eccf67f9d597f836fa6b33959ffaca5473fcd5849fd16c0ea5",
          "text": "Ik hou voor altijd van je!",
          "source_text": "I love you forever!",
          "transcription_review_required": false
        },
        "rib2-10": {
          "path": "res://assets/languages/nl/audio/rib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "60d58fbd27a9c44f5e759900e4ec3e6f79f7f71162b88fb8f5a6b59cea2230d8",
          "text": "Het zal mijn eer zijn. Hier, dat is mijn artiestennaam. HÃ¨?",
          "source_text": "Like, it'll be my honor. Here, that's my stage name. Huh?",
          "transcription_review_required": false
        },
        "rib2-20": {
          "path": "res://assets/languages/nl/audio/rib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9f40b3d5407220bb27d808619d33272f242ff7e3eeb623b7633adba9b795016f",
          "text": "Het gaat over het verlangen naar een geliefde die nooit meer de mijne zal zijn.",
          "source_text": "It's about longing for a loved one who will never be mine again.",
          "transcription_review_required": false
        },
        "rib2-30": {
          "path": "res://assets/languages/nl/audio/rib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "216a9496f73f762fc56eb6b6025e9c751d14a7effaf6bc2e9396072fa7ee7196",
          "text": "Natuurlijk niet, ik won de eerste plaats bij de spellingbij toen ik in de eerste klas zat.",
          "source_text": "Of course not, I won first place in the spelling bee when I was in first grade.",
          "transcription_review_required": false
        },
        "ril-01": {
          "path": "res://assets/languages/nl/audio/ril-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "35a006ee9fc822b0dd6cb27ad76bf8bac6141bd96b1033412ebb23d71f0cd8a9",
          "text": "Ik, denk je dat ik het ben? Wat heb je tegen mij?",
          "source_text": "Me, you think it's me? What do you have against me?",
          "transcription_review_required": false
        },
        "ril-02": {
          "path": "res://assets/languages/nl/audio/ril-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ad114d91ee2156dca6c815b1a0d30cf6bc6db1ec4dd3a444fb5e80c327de9f4a",
          "text": "Je kunt nog steeds bewijzen dat ik dat nu heb geschreven.",
          "source_text": "You still can prove that I wrote that now.",
          "transcription_review_required": false
        },
        "ril-03": {
          "path": "res://assets/languages/nl/audio/ril-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5fb853862d354d1ad90eeb8b16122a011eac6983b2dc73808e8e5089e54fc69f",
          "text": "Je kunt nog steeds niet bewijzen dat ik het ben.",
          "source_text": "You still cannot prove that it's me.",
          "transcription_review_required": false
        },
        "ril-04": {
          "path": "res://assets/languages/nl/audio/ril-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0774ff1c0d107fda748112d107ab780694d7f98dbe7d70c75d0a6ac00e82777b",
          "text": "Ja, ik ben SP. En dan?",
          "source_text": "Yes, I'm S.P. So what?",
          "transcription_review_required": false
        },
        "ril-05": {
          "path": "res://assets/languages/nl/audio/ril-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6b35c3c63f4aff25224744ea020874f49e36501c0b77ceab698f1e9106d2ecac",
          "text": "OkÃ©, okÃ©, ik geef het toe. Ik heb het gedaan. Ik kon de gedachte niet verdragen dat mijn lieve Alice de beruchte Jimmy Mackenzie zou ontmoeten. Ik weet gewoon dat ze verliefd zullen worden. Oh, ik ben zo'n jaloerse kerel. Maar maak je geen zorgen, ik ga de film zelf aan Jimmy geven.",
          "source_text": "Alright, alright, I admit it. I did it. I couldn't bear the thought of my darling Alice meeting the infamous Jimmy Mackenzie. I just know they'll fall in love. Oh, I am such a jealous guy. But don't worry, I'm going to give the film to Jimmy myself.",
          "transcription_review_required": false
        },
        "ril-06": {
          "path": "res://assets/languages/nl/audio/ril-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5dbfd13bfd6b432800b108b7c06b0970bf6b9b039b1e9aa18201b950f6498414",
          "text": "Dit bewijst nog niets.",
          "source_text": "This doesn't prove anything yet.",
          "transcription_review_required": false
        },
        "ril-07": {
          "path": "res://assets/languages/nl/audio/ril-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9f679503f4db3a705a344e8cfbf78081b99c2762dbeb51d88500dc06eef45131",
          "text": "Wat heeft dit met mij te maken?",
          "source_text": "What does this have to do with me?",
          "transcription_review_required": false
        },
        "ril-08": {
          "path": "res://assets/languages/nl/audio/ril-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2f6d3efcb5000eaa3c4a945ed7203816ba8ac975d62aa5dc78a6a9bb56725221",
          "text": "Eh, zo licht.",
          "source_text": "Uh, so light.",
          "transcription_review_required": false
        },
        "ril-09": {
          "path": "res://assets/languages/nl/audio/ril-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c60ff9d948d2e63507c83d6f37c97c1ecaf8095d8fa1c974bcbe48c1d12c4102",
          "text": "Ze is mooi, maar ze is niet mijn type, man. Ik hou van brunettes.",
          "source_text": "Well, she's beautiful, but she's not my type, man. I like brunettes.",
          "transcription_review_required": false
        },
        "ril-10": {
          "path": "res://assets/languages/nl/audio/ril-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e67b40e9de33eb3aea1eb7371bbaee91e5ff63e9985fe487c788b2db2263db3d",
          "text": "Je kunt niet zomaar door de stad gaan en mensen beschuldigen alsof iemand onschuldig is, tenzij het tegendeel bewezen is.",
          "source_text": "You can't just go around town accusing people like a person is innocent unless proven otherwise.",
          "transcription_review_required": false
        },
        "rila-01": {
          "path": "res://assets/languages/nl/audio/rila-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1e8c621d5c9cd0c5247c1f42dc6850d620b6c3f7b4082a6fe60209e369c9b91f",
          "text": "Er gebeuren echt dingen in dit kleine stadje. Overal worden mensen groen. Dorothy wil Alice's huis. Wie is een echte vriend? Wat een schande.",
          "source_text": "Things really happen in this little town. People are turning green all around. Dorothy wants Alice's place. Who's a real friend? What a disgrace.",
          "transcription_review_required": false
        },
        "ala3b-01": {
          "path": "res://assets/languages/nl/audio/ala3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cdb4467626417a137e7a84c25f6807012565939ee5fce7ebaea51a1493d5f800",
          "text": "Ja, ik ben de fotograaf, niet zij. Hoi!",
          "source_text": "Yes, I'm the photographer, not her. Hey!",
          "transcription_review_required": false
        },
        "ala3b-02": {
          "path": "res://assets/languages/nl/audio/ala3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "852e0fb13da6d51e5dbbbd1e3cfc6d4d475ecc601ba58365cc593a98c350f4cd",
          "text": "Ja, en hoe zit het hiermee?",
          "source_text": "Yeah, and what about this?",
          "transcription_review_required": false
        },
        "ala3b-04a": {
          "path": "res://assets/languages/nl/audio/ala3b-04a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "80838d61963765374466043b7ad0d393ab8ff92fc20258e3d0b2c329a69aa35b",
          "text": "HÃ©, waar is Julia?",
          "source_text": "Hey, where's Julia?",
          "transcription_review_required": false
        },
        "ala3b-04b": {
          "path": "res://assets/languages/nl/audio/ala3b-04b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7e07682c83a18140fe0207646f5586ac95e2cdb3dd8fc5fe767ba735e1c29294",
          "text": "Ik wil haar bedanken. Ik hoop dat ik de kans krijg om haar nog eens te ontmoeten. Ik vind haar echt leuk.",
          "source_text": "I want to thank her. I hope I'll get a chance to meet her again. I really like her.",
          "transcription_review_required": false
        },
        "alb3b-02": {
          "path": "res://assets/languages/nl/audio/alb3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c09cf2916cce2f531b9fcda1d254482d5a24ce1cec7e0316d5ad83347ec6eaef",
          "text": "Ja, Rik. Echte liefde gaat niet over het bezitten van iemand. Het gaat erom die persoon vrijheid te geven.",
          "source_text": "Yes, Rick. Real love is not about owning someone. It's about giving that person freedom.",
          "transcription_review_required": false
        },
        "doa3b-01": {
          "path": "res://assets/languages/nl/audio/doa3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a25cfe50c6a2e1d894dee3aa94bf86a3c45776644f1b61124baee986bd086928",
          "text": "Ja, zeker, en daarom draag ik de jurk en de tas. Oh, en ik heb de tekening ook.",
          "source_text": "Yeah, sure, and that's why I'm wearing the dress, carrying the bag. Oh, and I have the drawing too.",
          "transcription_review_required": false
        },
        "doa3b-02": {
          "path": "res://assets/languages/nl/audio/doa3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a0e3de41c82a0fc8d0975e1cf60f783d0acc7302fdc9b323006df20d611d7d80",
          "text": "Dat is de mijne, jij dief!",
          "source_text": "That's mine, you thief!",
          "transcription_review_required": false
        },
        "doa3b-04": {
          "path": "res://assets/languages/nl/audio/doa3b-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "706b236160e50f9ae311f278d80eaabf33d5959d5bdb5323e23a37f78055d512",
          "text": "OkÃ©, ik geef het op. Hoe dan ook, ik heb genoeg van jullie zelfingenomen mensen.",
          "source_text": "Okay, I give up. Anyway, I've had enough of you self-righteous people.",
          "transcription_review_required": false
        },
        "jia3b-01": {
          "path": "res://assets/languages/nl/audio/jia3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c41f0208fdbe128e3d8d53295f71b38a5d01abc6ac8bb4689dbd99cf3eedfbd0",
          "text": "Jij bent dus de fotograaf. Ik denk dat we elkaar beter moeten leren kennen.",
          "source_text": "So, you're the photographer. I think we should get to know each other better.",
          "transcription_review_required": false
        },
        "jia3b-02": {
          "path": "res://assets/languages/nl/audio/jia3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1b32fd1c4feb59589a7fe7add414a5cb1007977807e738efff7ea5adf31a0715",
          "text": "Godzijdank ben jij het. Ze was niet echt mijn type, maar vanaf het moment dat ik je zag...",
          "source_text": "Thank goodness it's you. She wasn't really my type, but the minute I saw you...",
          "transcription_review_required": false
        },
        "jib3-01": {
          "path": "res://assets/languages/nl/audio/jib3-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "815bcdf200b5795e8fd4252ff6ae28ba7e21ab1f299b36d7ce280300ca96feea",
          "text": "Bedankt dat je me de film hebt gebracht, hoewel ik moet zeggen dat ik er erg naar uitkeek om het meisje te ontmoeten dat de foto's maakte.",
          "source_text": "Thanks for bringing me the film, although I must say I was really looking forward to meeting the girl who took the pictures.",
          "transcription_review_required": false
        },
        "jib3a-02": {
          "path": "res://assets/languages/nl/audio/jib3a-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b9e06347e2533a5329b1c8ecc54c147a22645e3b7e75fe42e8006a4eab19086e",
          "text": "Maar ik zou toch heel graag willen weten hoe de fotograaf eruit ziet.",
          "source_text": "But I'd still really like to know what the photographer looks like.",
          "transcription_review_required": false
        },
        "jib3a-03": {
          "path": "res://assets/languages/nl/audio/jib3a-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b79e6e247350b36e12cb976bcedadc15b6d4919beac13e0f6cb1945e59058169",
          "text": "Wauw, je tante is prachtig.",
          "source_text": "Wow, your aunt is gorgeous.",
          "transcription_review_required": false
        },
        "jib3a-04": {
          "path": "res://assets/languages/nl/audio/jib3a-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7026000338164875b1b026105b5969185fffedf82aa1c32bb044c46874f194b3",
          "text": "Ik geloofde altijd in liefde op het eerste gezicht, of in de eerste foto, of wat dan ook.",
          "source_text": "I always believed in love at first sight, or first picture, or whatever.",
          "transcription_review_required": false
        },
        "jib3b-02": {
          "path": "res://assets/languages/nl/audio/jib3b-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b09fba9d6596c0a6174d50e3e2afaa0b998b2ad33a45a469debd23b33a627c64",
          "text": "Je bent zo liberaal, dat vind ik geweldig in een vrouw.",
          "source_text": "You're so liberal, I love that in a woman.",
          "transcription_review_required": false
        },
        "mend": {
          "path": "res://assets/languages/nl/audio/mend.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "615ea556e6a33eb4ea196f7e7585d8e213f917a664f6eec67fb4633dd830007a",
          "text": "Eh, Julia, ik heb goed nieuws en slecht nieuws. Het slechte nieuws is dat je toch niet naar huis gaat.",
          "source_text": "Um, Julia, I have some good news and some bad news. The bad news is, I guess you're not going home after all.",
          "transcription_review_required": false
        },
        "mend2": {
          "path": "res://assets/languages/nl/audio/mend2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ef4b49c1cb8e8ad6891c348ac4d6fee9b32857dfd40e6b457952769a71425f92",
          "text": "Maar het goede nieuws is dat je naar Parijs gaat, naar de roerige jaren twintig. Je moet nog een mysterie oplossen.",
          "source_text": "But the good news is, you're going to Paris to the roaring 20s. You got another mystery to solve.",
          "transcription_review_required": false
        },
        "rib3a-01": {
          "path": "res://assets/languages/nl/audio/rib3a-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "37fafa0a594ea05795acbd80c942893e94a1e3e009100a8c04e97fa66286182c",
          "text": "Oh, je wilt haar niet ontmoeten. Het is mijn lelijke oude hand.",
          "source_text": "Oh, you don't want to meet her. It's, uh, my ugly old hand.",
          "transcription_review_required": false
        },
        "rib3a-02": {
          "path": "res://assets/languages/nl/audio/rib3a-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0bbaa99a447c0654bd2581f90ec7dd6162ab4d989645a151de6ec29a60a8ae15",
          "text": "Je kunt toch niet bewijzen dat het niet mijn oude rot is?",
          "source_text": "You can't prove it's not my old hands, can you?",
          "transcription_review_required": false
        },
        "rib3b-01": {
          "path": "res://assets/languages/nl/audio/rib3b-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "368f054f53b9a1a10c58f7125d75a63dd27eb9acb65930de8aa7aa147f8570d6",
          "text": "Het spijt me, Alice, maar ik deed het alleen omdat ik zoveel van je hou! Ik denk dat als ik je niet de mijne kan maken, ik je moet laten gaan.",
          "source_text": "I'm sorry, Alice, but I only did it because I love you so much! I guess that if I can't make you be mine, then I've gotta let you go.",
          "transcription_review_required": false
        },
        "jul1a": {
          "path": "res://assets/languages/nl/audio/jul1a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3a51a7b3ca0cb97ffafe8195c7338afce9d10dc8f134b7197df8e10a5cc7a2a8",
          "text": "Hoi Mel, Julia hier.",
          "source_text": "Hi, Mel, Julia here.",
          "transcription_review_required": false
        },
        "jul1b": {
          "path": "res://assets/languages/nl/audio/jul1b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ef66630a24585ef1e9e14af1b36f11a341bcd6ca2c39f1f943a88eb9f3543f46",
          "text": "Ik had de slechtste dag.",
          "source_text": "I had the worst day.",
          "transcription_review_required": false
        },
        "jul1c": {
          "path": "res://assets/languages/nl/audio/jul1c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9a6c498ec59a054c69464ec50573f12bc90ec67d13d176a55c06c4b7421e3f86",
          "text": "Eerst had ik ruzie met mijn moeder. Ze heeft maar Ã©Ã©n ding aan haar hoofd.",
          "source_text": "First, I had a fight with my mom. She has only one thing on her mind.",
          "transcription_review_required": false
        },
        "jul1d": {
          "path": "res://assets/languages/nl/audio/jul1d.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f80c16a29d68f039dabc910bda1288075c3ca25aa6d40fc46622bd40ac64ece9",
          "text": "Eigenlijk ook, het redden van de walvissen en mijn studies.",
          "source_text": "Actually too, saving the whales and my studies.",
          "transcription_review_required": false
        },
        "jul1e": {
          "path": "res://assets/languages/nl/audio/jul1e.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c70c6cbe30cd0430bf7d1d01bda3af7fd1b0f220e6fd29ded7c85c993c3c1b8f",
          "text": "Toen ik op weg was naar school, zag ik Laura giechelen met Dylan. Ik werd zo zenuwachtig dat ik niet meer kon praten. Man, ik wou dat ik deze dag opnieuw vanaf het begin kon beginnen.",
          "source_text": "Then, on my way to school, I saw Laura giggling with Dylan. I got so nervous, I couldn't speak. Man, I wish I could start this day from the beginning again.",
          "transcription_review_required": false
        },
        "jul2": {
          "path": "res://assets/languages/nl/audio/jul2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9df174ff48ca9894e53a0a76d699f03771b7470d9ac25268febd7d1f597e426b",
          "text": "Wauw. Wat gebeurt er?",
          "source_text": "Wow. What's happening?",
          "transcription_review_required": false
        },
        "mel1": {
          "path": "res://assets/languages/nl/audio/mel1.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "36f17f14225d772820aad4dd3c70ebb232174043fc055766327a9f177f9fce88",
          "text": "Ik weet wat je bedoelt. Misschien kan ik je helpen dat op te lossen. Wacht even en voer dit adres in op internet. Time Loops.com.",
          "source_text": "I know what you mean. Maybe I can help you fix that. Sit tight and enter this address on the net. Time Loops.com.",
          "transcription_review_required": false
        },
        "jbye": {
          "path": "res://assets/languages/nl/audio/jbye.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "deb145481d6084482e1ea3541459883b758b37e597e4ba3d63e9e2abf7d8bbaa",
          "text": "Doei.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "jlaa1-10": {
          "path": "res://assets/languages/nl/audio/jlaa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c1d86c9af9063c11197dac63e371ac9530dd531477f3069f96a91ab9925be121",
          "text": "Heb je hier een filmrolletje gevonden?",
          "source_text": "Did you find a roll of film here?",
          "transcription_review_required": false
        },
        "jlaa1-11": {
          "path": "res://assets/languages/nl/audio/jlaa1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "15f327029094a51f9fa2bdfd4e40a29910f195ecca299254e60a9d26729105ba",
          "text": "Ik ga...",
          "source_text": "I'm going to be...",
          "transcription_review_required": false
        },
        "jlaa1-12": {
          "path": "res://assets/languages/nl/audio/jlaa1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1366f1b5fd300c81f0167093395ac1c1ba17c366be4a2b77f9f2ae764547e9c8",
          "text": "Nee.",
          "source_text": "No.",
          "transcription_review_required": false
        },
        "jlaa1-20": {
          "path": "res://assets/languages/nl/audio/jlaa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8287edd3ba790ed978bfe196f4f07d94e8f97af5da0c1b775b2bd178173dcc84",
          "text": "Vind je het erg als ik even rondkijk? Alice stuurde me hierheen om een â€‹â€‹film te zoeken.",
          "source_text": "Do you mind if I take a look around? Alice sent me here to look for a film.",
          "transcription_review_required": false
        },
        "jlaa1-30": {
          "path": "res://assets/languages/nl/audio/jlaa1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "730cb71254d676cdae5e4fe7c782d4f3a7298fc119227c3371a4afd8e5df882d",
          "text": "Ik heb het gevoel dat je een Nobelprijs-materiaal bent. Heb je hier toevallig een rij films gezien?",
          "source_text": "I sense that you're a Nobel Prize material. Did you see a row of film around here by any chance?",
          "transcription_review_required": false
        },
        "jlaa1-31": {
          "path": "res://assets/languages/nl/audio/jlaa1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e692caa3beaf1f8c03de43c3e3872f08f2bbefe037889270614fed558eb1a1c",
          "text": "Wie was zij?",
          "source_text": "Who was she?",
          "transcription_review_required": false
        },
        "jlaa1-32": {
          "path": "res://assets/languages/nl/audio/jlaa1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d92769a0157c5175463d66c0e113feb6e0721aa0ae415913fe660398e6c6207e",
          "text": "Heeft dit meisje gezegd waarom ze de film nodig had?",
          "source_text": "Did this girl say why she needed the film?",
          "transcription_review_required": false
        },
        "jlaa2-10": {
          "path": "res://assets/languages/nl/audio/jlaa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8a958fe74e0c7fed5becb594a9aefa92e9ad6f3bf4ea13e29e84f9cf8baa5eb3",
          "text": "Ik zoek geen schaar. Ik kwam Alice's jurk zoeken.",
          "source_text": "I'm not looking for scissors. I came to look for Alice's dress.",
          "transcription_review_required": false
        },
        "jlaa2-20": {
          "path": "res://assets/languages/nl/audio/jlaa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fa873ed5ca7e654d787a6b1f09679cbb3121a0a4b98375c5424f72ce12a077bd",
          "text": "Waarom dacht je dat ik een schaar kwam halen?",
          "source_text": "What made you think I came for scissors?",
          "transcription_review_required": false
        },
        "jlaa2-21": {
          "path": "res://assets/languages/nl/audio/jlaa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7aaea56efdb272c4f1ea459657b8449bdcbda0bf3d963dff6a6fd0b77f3fc25d",
          "text": "Wie denk je dat zijn schaar hier heeft achtergelaten?",
          "source_text": "Who do you think left their scissors here?",
          "transcription_review_required": false
        },
        "jlaa2-22": {
          "path": "res://assets/languages/nl/audio/jlaa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5cfda66918d277334f85447d70a234e13b5a6514ee4e8e10d31a1cf6b40e9bb0",
          "text": "Waar hebben ze de schaar gelaten?",
          "source_text": "Where did they leave the scissors?",
          "transcription_review_required": false
        },
        "jlaa2-30": {
          "path": "res://assets/languages/nl/audio/jlaa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05d241f686407d05e5fddd894f82e479fe11c07f629fa6676539434c3f5e78b3",
          "text": "Kent u iemand met de naam Betty?",
          "source_text": "Do you know anyone by the name of Betty?",
          "transcription_review_required": false
        },
        "jlaa2-31": {
          "path": "res://assets/languages/nl/audio/jlaa2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b48e072cc7e6d46422b4505375b5aefdd190c363793b858c5e44ba0c435ce620",
          "text": "Ken jij iemand die Veronica heet?",
          "source_text": "Do you know someone called Veronica?",
          "transcription_review_required": false
        },
        "jlaa2-32": {
          "path": "res://assets/languages/nl/audio/jlaa2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e4ff2e9fa331be54ead0c65eb0ad0ded0582e87cd83f4c76117461f456502795",
          "text": "Ken jij een meisje dat Betty heet?",
          "source_text": "Do you know a girl called Betty?",
          "transcription_review_required": false
        },
        "jlaa2-by": {
          "path": "res://assets/languages/nl/audio/jlaa2-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4269196aa2202d4dbd17501489fa0f9b372608741a4c87d5ca62813678eb8048",
          "text": "Doei!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "jlab1-10": {
          "path": "res://assets/languages/nl/audio/jlab1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "45187d8a58bc79083c985ed43373b2890a98261f9446d1ef161646aacdc742bd",
          "text": "Weet jij iets over de foto's die bij Philip's Chemicals zijn gemaakt?",
          "source_text": "Do you know anything about the photos that were taken at Philip's Chemicals?",
          "transcription_review_required": false
        },
        "jlab1-11": {
          "path": "res://assets/languages/nl/audio/jlab1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "09d6329cc75a1a77087c8ebbddddc6ad6645717f33e507767b84483729d37d61",
          "text": "Wie kwam hier nog meer?",
          "source_text": "Who else came here?",
          "transcription_review_required": false
        },
        "jlab1-12": {
          "path": "res://assets/languages/nl/audio/jlab1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7e6c2415ffa74181f1192e7a444eb7849f3268575860bfc6a5464d0a44d49a13",
          "text": "Waar komt deze andere persoon naar op zoek?",
          "source_text": "What does this other person come looking for?",
          "transcription_review_required": false
        },
        "jlab1-20": {
          "path": "res://assets/languages/nl/audio/jlab1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "33c198a7cb21cc79de029cdc4c94c23b048c67b61ada4307cb6fd3cab0bd32a0",
          "text": "Zou je zeggen dat er concurrentie gaande is tussen jou en Alice?",
          "source_text": "Would you say there's competition going on between you and Alice?",
          "transcription_review_required": false
        },
        "jlab1-30": {
          "path": "res://assets/languages/nl/audio/jlab1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fe942d5114e9b18e5397a0a29c7847d0bcd19693bbfb730c8b883e6657693bd7",
          "text": "Heb je hier een filmrolletje gevonden?",
          "source_text": "Did you find a roll of film here?",
          "transcription_review_required": false
        },
        "jlab2-10": {
          "path": "res://assets/languages/nl/audio/jlab2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cff9a95e7a7977142517ab50d4693dde17eb967398b3923ec8757250d9d39b6e",
          "text": "Luister, Larry, heb je naast mij nog meer bezoekers gehad vanochtend?",
          "source_text": "Listen, Larry, did you have any other visitors this morning besides me?",
          "transcription_review_required": false
        },
        "jlab2-11": {
          "path": "res://assets/languages/nl/audio/jlab2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7e04766834af354af1cca775aa795a4a24d0cde726500dba6e1a41c978ecf54b",
          "text": "Wie is hier vandaag?",
          "source_text": "Who is here today?",
          "transcription_review_required": false
        },
        "jlab2-12": {
          "path": "res://assets/languages/nl/audio/jlab2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "531737874cfe6229cebe1c3355e5039090520a5a477daa9ea57c0bf02bde3ded",
          "text": "Wat deed deze persoon hier?",
          "source_text": "What was this person doing here?",
          "transcription_review_required": false
        },
        "jlab2-20": {
          "path": "res://assets/languages/nl/audio/jlab2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4dcd81915bc823dbc70250856695f21d4883dee6e64179abc85cddd27382fac4",
          "text": "Ik wil graag een voorbeeld van je handschrift zien.",
          "source_text": "I'd like to see a sample of your handwriting.",
          "transcription_review_required": false
        },
        "jlab2-30": {
          "path": "res://assets/languages/nl/audio/jlab2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fd86470a03edafd0911323e75303e479024aafaee981d640d7fd549ceea357a2",
          "text": "Ik heb het gevoel dat je heel goed bent in spelling. Kun je voor mij prachtig spellen?",
          "source_text": "I have a feeling that you're real good at spelling. Could you spell gorgeous for me?",
          "transcription_review_required": false
        },
        "laa1-01": {
          "path": "res://assets/languages/nl/audio/laa1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c9962dce58c7226457047a40180046e146d6a8a67d2fd8eb8a1e994d1b0afc24",
          "text": "O nee! Je hebt mijn aantekeningen verpest! Nu weet ik niet welke buis ik het beste kan gebruiken, de rode of de blauwe.",
          "source_text": "Oh, no! You messed up my notes! Now I don't know which tube is the right one to use, the red or the blue.",
          "transcription_review_required": false
        },
        "laa1-03": {
          "path": "res://assets/languages/nl/audio/laa1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f8a224dce88e281e21441d6e8bd4ff4e9a717b4b41e06255cd7636e246e87d7f",
          "text": "Doei!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "laa1-04": {
          "path": "res://assets/languages/nl/audio/laa1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3fa505638198204fea5ab780cae3a739f2a01a57fced30cd7dfbf8634c389bc9",
          "text": "Oh, je moet me helpen uit deze puinhoop te komen!",
          "source_text": "Oh, you gotta help me get out of this mess!",
          "transcription_review_required": false
        },
        "laa1-05": {
          "path": "res://assets/languages/nl/audio/laa1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0ada5c3b39d4c7bd8d4069f80eaeeccbbb14a914a5662b6f0477200630ddf0ac",
          "text": "Wat wil je deze keer?",
          "source_text": "What do you want this time?",
          "transcription_review_required": false
        },
        "laa1-10": {
          "path": "res://assets/languages/nl/audio/laa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "092af3498d8a58d28dfd2e48dacafb7ebf2af9135d54f0e1eb9e2f0f11f54e23",
          "text": "Waarom blijft iedereen mij vragen naar een of andere stomme film? Ben ik een verdachte of zo? En wie ben jij? Bent u familie van Alice?",
          "source_text": "Why does everyone keep asking me about some stupid film? Am I a suspect or what? And who are you? Are you related to Alice?",
          "transcription_review_required": false
        },
        "laa1-11": {
          "path": "res://assets/languages/nl/audio/laa1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "479c519f0179036849ac75519a583586efa6109a2d33fb0ea51f0acc33173c7d",
          "text": "Ooh, je gaat uit met haar broer, maar is hij niet 12 of zoiets?",
          "source_text": "Ooh, you're dating her brother, but isn't he like 12 or something?",
          "transcription_review_required": false
        },
        "laa1-12": {
          "path": "res://assets/languages/nl/audio/laa1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e4247665a36e068df3b58dbc04e0d525b99294872a61a0ae762d339f7144dd65",
          "text": "Vreemd, je lijkt precies op haar.",
          "source_text": "Strange, you look just like her.",
          "transcription_review_required": false
        },
        "laa1-20": {
          "path": "res://assets/languages/nl/audio/laa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ffe598bf1d52227e3346b9a2aae2e16213c88608d782884535a0d21130ee048f",
          "text": "Ja, dat vind ik erg. Het is al erg genoeg dat Alice mij al deze berekeningen alleen laat doen, en nu laat ze jou rondsnuffelen?",
          "source_text": "Yes, I do mind. It's bad enough that Alice leaves me to do all these calculations by myself, and now she has you snooping around?",
          "transcription_review_required": false
        },
        "laa1-20m": {
          "path": "res://assets/languages/nl/audio/laa1-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "97bdbbd5144e7a433186be5c97f528833a601d79bb836e7cc1abff1e44aa66d2",
          "text": "Wauw, bedankt! Hoe heb je het zo klein gekregen?",
          "source_text": "Whoa, thanks! How did you get it so small?",
          "transcription_review_required": false
        },
        "laa1-30": {
          "path": "res://assets/languages/nl/audio/laa1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "23f27931169c1969d3474a2970aef936c05b89a22f4d91b685d54f8ce6d1de75",
          "text": "Halleluja bij het visioen! Wat de film betreft, ik heb hem niet gezien, maar er was een meisje dat hiernaar kwam vragen.",
          "source_text": "Hallelujah at the vision! As for the film, I haven't seen it, but there was a girl who came here asking about it.",
          "transcription_review_required": false
        },
        "laa1-31": {
          "path": "res://assets/languages/nl/audio/laa1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a14913621b10611bd81552cecd9b7502bce9c50ac7e7c5155b41e854a88a7a82",
          "text": "Ik weet het niet. Ik had het te druk om zelfs maar naar haar te kijken. Ik weet nog dat ze de hele tijd niesde en iets over zonnebloem mompelde.",
          "source_text": "I don't know. I was too busy to even look at her. I do remember that she was sneezing all the time and muttering something about sunflower.",
          "transcription_review_required": false
        },
        "laa1-32": {
          "path": "res://assets/languages/nl/audio/laa1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8c9dd4fb1737bb4499d7849b4a39a8c8b16440d077efc98c3fab35cea41934a4",
          "text": "Nee, maar misschien was zij die verslaggever van The Guardian die mij steeds belt en naar de film vraagt.",
          "source_text": "No, but maybe she was that reporter from The Guardian who keeps calling and asking me about the film.",
          "transcription_review_required": false
        },
        "laa2-01": {
          "path": "res://assets/languages/nl/audio/laa2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "84744a194310f2a96173869e69e8325441efa93c5ecf0f9f7f5bbe58d323b4e2",
          "text": "O, jij weer! Kom je voor je schaar?",
          "source_text": "Oh, you again! Did you come for your scissors?",
          "transcription_review_required": false
        },
        "laa2-02": {
          "path": "res://assets/languages/nl/audio/laa2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "33f21f4b4353bfa75354f980317fb5250cb8d1439140bdd213d008f419ff4714",
          "text": "Waarom heb ik het gevoel dat ik dat zal doen?",
          "source_text": "Why do I have a feeling that I will?",
          "transcription_review_required": false
        },
        "laa2-03": {
          "path": "res://assets/languages/nl/audio/laa2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6916ad8d21f78e2d0617cb08fd330fe5eed47679840b1d405bc3957a45044e47",
          "text": "Misschien ben je deze keer op zoek naar een schaar?",
          "source_text": "Maybe this time you're looking for a scissors?",
          "transcription_review_required": false
        },
        "laa2-10": {
          "path": "res://assets/languages/nl/audio/laa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "eef59b0397a3e76987d2a1a97f8e0ba3c3cf502e53de79f1d1fcda666e81dc8f",
          "text": "Jurk? We zijn bezig met het zetten van een man op de maan, en jij bent op zoek naar een stomme jurk?",
          "source_text": "Dress? We're working on putting a man on the moon, and you are looking for a stupid dress?",
          "transcription_review_required": false
        },
        "laa2-20": {
          "path": "res://assets/languages/nl/audio/laa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4579de0a3997ab678755dc5ec6c43a36f46da88872c469ebdcccd198727d7ac8",
          "text": "Ik wist zeker dat jij het was die ze hier achterliet. Ik denk dat iemand anders mij een bezoek heeft gebracht.",
          "source_text": "I was sure it was you who left them here. I guess someone else paid me a visit.",
          "transcription_review_required": false
        },
        "laa2-21": {
          "path": "res://assets/languages/nl/audio/laa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "520a562eabae0520d57f98172dbf5ce9f3cf4e2bd8ea78e7e4a8fd0698ca3fd7",
          "text": "Degene die ze heeft achtergelaten heeft een voortreffelijke smaak en parfum, mmm, Charmont 500, precies mijn keuze.",
          "source_text": "Whoever left them has exquisite taste and perfume, mmm, Charmont 500, my choice exactly.",
          "transcription_review_required": false
        },
        "laa2-22": {
          "path": "res://assets/languages/nl/audio/laa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4cb71ad5bc3fdd020ed5e5be8a39009ba0418035ba67a25088fcd72dd2a825c2",
          "text": "Beer, naast de boeken van Alice.",
          "source_text": "Bear, next to Alice's books.",
          "transcription_review_required": false
        },
        "laa2-30": {
          "path": "res://assets/languages/nl/audio/laa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "61d4292a7685ba7a01924af1e5eae34f77092a4885ee8c3a204b496a3ecd7a67",
          "text": "Waarom zou je denken dat ik iemand ken die Betty heet?",
          "source_text": "Why would you think that I'd know someone called Betty?",
          "transcription_review_required": false
        },
        "laa2-30h": {
          "path": "res://assets/languages/nl/audio/laa2-30h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1485f839c770d584c59d171200dd78afa74151b66785ff8af0b58f0468251e11",
          "text": "Ach, Betty, mijn moeder Betty! Ik zou haar moeten bellen, maar wat wil je van Betty?",
          "source_text": "Ah, Betty, my mother Betty! I should give her a call, but what do you want from Betty?",
          "transcription_review_required": false
        },
        "laa2-30hh": {
          "path": "res://assets/languages/nl/audio/laa2-30hh.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "745f3c13ce505c3aee88ec75c9ba62a1228733f8ad06ef15095825b05677ac2b",
          "text": "HÃ©, mijn moeder kent Veronica niet, maar ze kent wel veel suhings.",
          "source_text": "Hey, my mother does not know of Veronica, but she does know many suhings.",
          "transcription_review_required": false
        },
        "laa2-31": {
          "path": "res://assets/languages/nl/audio/laa2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "13edd71f8540c5eb0fb771ed03ee77b897cae2ec700f532fee19fea0f31c1652",
          "text": "Ik las een artikel geschreven door iemand genaamd Nika, is Nika niet de afkorting van Veronica? Ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha.",
          "source_text": "I read an article written by someone called it Nika, isn't Nika short for Veronica? Ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha-ha.",
          "transcription_review_required": false
        },
        "laa2-32": {
          "path": "res://assets/languages/nl/audio/laa2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "88b30e075401b9f7e312291216d1bf7c648e04032028eef88a8498a4707f7d47",
          "text": "Ik ben hier om mijn onderzoek te doen, niet om allerlei soorten Betty's te ontmoeten.",
          "source_text": "I'm here to do my research, not to meet all kinds of Betty's.",
          "transcription_review_required": false
        },
        "laa2-h": {
          "path": "res://assets/languages/nl/audio/laa2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e0c55caec98dbce2439fb4490399e0575de878050dbb5e7c041c228d41ea76f7",
          "text": "O nee! Niet nog een zonnebloem! Mijn lab ziet eruit als een schilderij van Van Gogh!",
          "source_text": "Oh no! Not another sunflower! My lab looks like a Van Gogh painting!",
          "transcription_review_required": false
        },
        "lab1-01": {
          "path": "res://assets/languages/nl/audio/lab1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b7cfc979ce4c7d5433cc3d7b3e660d5cbf07afdac0c27684c6a649fdb7e2d87c",
          "text": "Kom niet binnen! Ik zit midden in een experiment!",
          "source_text": "Don't come in! I'm in the middle of an experiment!",
          "transcription_review_required": false
        },
        "lab1-02": {
          "path": "res://assets/languages/nl/audio/lab1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "65003d20de892d0db38216d45cd34c30b6be6d0935d31ddc7c3230e436e559e2",
          "text": "Ja.",
          "source_text": "Yes.",
          "transcription_review_required": false
        },
        "lab1-04": {
          "path": "res://assets/languages/nl/audio/lab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4269196aa2202d4dbd17501489fa0f9b372608741a4c87d5ca62813678eb8048",
          "text": "Doei!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "lab1-05": {
          "path": "res://assets/languages/nl/audio/lab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cad3df3358bd96c42f8f6d730991fcf29add3f99aad5e5240954bc7100ab71d7",
          "text": "Oh! Jij bent het weer!",
          "source_text": "Oh! It's you again!",
          "transcription_review_required": false
        },
        "lab1-10": {
          "path": "res://assets/languages/nl/audio/lab1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff67b3901c725eaa0b4d78def154afcbea5a55d134c4d91dc8c4eefc8201e308",
          "text": "Waarom denk je dat ik iets over deze foto's moet weten?",
          "source_text": "Why do you think I should know anything about these photos?",
          "transcription_review_required": false
        },
        "lab1-10h": {
          "path": "res://assets/languages/nl/audio/lab1-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f2dfcd3c3a3eeda3f0495558c3133b866a3c1a497cf384cf0152cde4cc6ec033",
          "text": "Nee, dat zijn cijfers. Het lijkt zoveel op Alice om haar persoonlijke aantekeningen op het labpapier te schrijven. Nu begrijp ik waarom die ander vanmorgen hier kwam.",
          "source_text": "Nah, that figures. It's so much like Alice to write her personal notes on the lab's paper. Now I understand why that other one came here this morning.",
          "transcription_review_required": false
        },
        "lab1-11": {
          "path": "res://assets/languages/nl/audio/lab1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "15456b6b309a1e15a0eedc9270376e6edf64ecae438dc2341ad7b66861e2d8bb",
          "text": "Ik heb niet eens gekeken. Ik nam aan dat het Alice was, maar later kwam ik erachter dat het iemand anders was toen ik haar sopraan hoorde zingen.",
          "source_text": "I didn't even take a look. I assumed it was Alice, but then, later I figured out that it was someone else when I heard her singing soprano.",
          "transcription_review_required": false
        },
        "lab1-12": {
          "path": "res://assets/languages/nl/audio/lab1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7df3fcc5e2801335865f943961688e49cfde3a8be078726ba2419f0501ff1bdf",
          "text": "Ik weet het niet. Ik veronderstel de film waar iedereen naar op zoek is, vooral die nieuwsgierige verslaggever die me blijft lastigvallen, maar mijn lippen zijn verzegeld.",
          "source_text": "I don't know. I suppose the film that everyone's after, especially that nosy reporter who keeps bothering me, but my lips are sealed.",
          "transcription_review_required": false
        },
        "lab1-20": {
          "path": "res://assets/languages/nl/audio/lab1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8ab7fee32198d5c38ddd538144965e5310dbd2ca127969cfa9dadbc5c3fbd172",
          "text": "Concurrentie? Tussen mij en Alice? Ha! Is er een reden waarom ik haar zou benijden?",
          "source_text": "Competition? Between me and Alice? Ha! Is there any reason why I should envy her?",
          "transcription_review_required": false
        },
        "lab1-30": {
          "path": "res://assets/languages/nl/audio/lab1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2816b78d115306ef0cb1e63da042e9da2562d0a32b2d0b755377be55c57d92ec",
          "text": "Alice is haar film kwijt? Dat meisje zou geen foto's meer mogen maken. Ik bedoel, ze mag geen foto's maken die haar in de problemen brengen.",
          "source_text": "Alice lost her film? That girl shouldn't be allowed to take pictures anymore. I mean she shouldn't take pictures that get her into trouble.",
          "transcription_review_required": false
        },
        "lab120ha": {
          "path": "res://assets/languages/nl/audio/lab120ha.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bc796bbd2226d3bed68bb664c4f6ba664ac685cee618e2039f8dc8079071a026",
          "text": "O, wie maakt zich daar druk om?",
          "source_text": "Oh, who cares about that?",
          "transcription_review_required": false
        },
        "lab120hb": {
          "path": "res://assets/languages/nl/audio/lab120hb.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b98639dcad80bdabbd67afd061a4518403f3c7be42c085a9541e251e8469849c",
          "text": "Ik zit hier met een grote subsidie â€‹â€‹van Phillips, Camagulls.",
          "source_text": "I'm sitting here with a big grant from Phillips, Camagulls.",
          "transcription_review_required": false
        },
        "lab2-01": {
          "path": "res://assets/languages/nl/audio/lab2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b071bb5a0daadb8427758a7a48ed37d873ad6fa6989c71fc5f342f4737318e39",
          "text": "Ik sta aan de vooravond van een grote doorbraak!",
          "source_text": "I'm on the verge of a major breakthrough!",
          "transcription_review_required": false
        },
        "lab2-02": {
          "path": "res://assets/languages/nl/audio/lab2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "564066a62540a3a0da09c920c5a8899cfbfb2d5cf6becf9a46b5e6b200471a74",
          "text": "Ja, ja.",
          "source_text": "Yes, yes.",
          "transcription_review_required": false
        },
        "lab2-03": {
          "path": "res://assets/languages/nl/audio/lab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4bc1ce93911992eda15a2f31deff7e857969ecc17b98ed48872d0ce658b762fd",
          "text": "Heb jij, nogmaals, geen enkel respect voor wetenschappelijke ontdekkingen?!",
          "source_text": "You, again, don't you have any respect for scientific discoveries?!",
          "transcription_review_required": false
        },
        "lab2-10": {
          "path": "res://assets/languages/nl/audio/lab2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9fea2f98de60584cc50d61c0461b1f2dd6ca43f7ad90880bfaf652ff9f34a537",
          "text": "Voordat u aan uw kruisverhoor begint, wil ik ons â€‹â€‹beiden wat tijd besparen. Er was hier vanmorgen iemand.",
          "source_text": "Before you begin your cross-examination, let me save us both some time. There was someone here this morning.",
          "transcription_review_required": false
        },
        "lab2-11": {
          "path": "res://assets/languages/nl/audio/lab2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3d6d086f026c62659d42fb90f5132067b967fe503517d94b85b6f10e55149c45",
          "text": "Dezelfde persoon die de sopraanstem heeft, maar ik kreeg niet de kans haar te zien omdat mijn bril beslagen was door de dampen in het laboratorium.",
          "source_text": "The same person who has the soprano voice, but I didn't get a chance to see her because my glasses were fogged up from the fumes in the lab.",
          "transcription_review_required": false
        },
        "lab2-12a": {
          "path": "res://assets/languages/nl/audio/lab2-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "88327f29ef6b7bb717c463715155d02652cfbcb317b7970a44b564ac5dc98a00",
          "text": "Ik heb geen idee, maar wie het ook was, hij heeft zijn bril achtergelaten.",
          "source_text": "I have no idea, but whoever it was, left their glasses behind.",
          "transcription_review_required": false
        },
        "lab2-12b": {
          "path": "res://assets/languages/nl/audio/lab2-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "acecc3c631d0d89da783b173be0b099657ac98ccc303efe657db275814209bea",
          "text": "Dit is trouwens exact dezelfde bril als die nieuwsgierige verslaggever draagt.",
          "source_text": "By the way, these are the exact same glasses as that nosey reporter wears.",
          "transcription_review_required": false
        },
        "lab2-20": {
          "path": "res://assets/languages/nl/audio/lab2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8bc793c96921201a6a26c7e6d07a871d352b1343d56e883bb72bf43c25277049",
          "text": "Ik heb geen tijd voor je beschuldigingen! Ik besteed mijn tijd aan het werken aan ontdekkingen en innovaties! Als je wilt dat ik een grafologietest doe, heb je een gerechtelijk bevel nodig!",
          "source_text": "I don't have time for your accusations! I devote my time to working on discoveries and innovations! If you want me to do a graphology test, you'll have to get a court order!",
          "transcription_review_required": false
        },
        "lab2-20m": {
          "path": "res://assets/languages/nl/audio/lab2-20m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07f77678890ea7f5325367632fcb80f8640fecc97fec93c76f613af1b5a934b7",
          "text": "Geweldige uitvindingen uit de jaren negentig van Robert Palmer! Oh, er zit een Robert Palmer in mijn natuurkundeles! Ik wist niet dat hij sciencefiction schreef!",
          "source_text": "Great inventions of the 1990s by Robert Palmer! Oh, there's a Robert Palmer in my physics class! I didn't know he wrote science fiction!",
          "transcription_review_required": false
        },
        "lab2-30": {
          "path": "res://assets/languages/nl/audio/lab2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dc2e4dfca33eeb731e30cd80115f81c7027d8866d739d8f6f3a6a7de09515b71",
          "text": "Natuurlijk kan ik dat. Mijn geheugen is fenomenaal.",
          "source_text": "Of course I can. My memory is phenomenal.",
          "transcription_review_required": false
        },
        "lal-01": {
          "path": "res://assets/languages/nl/audio/lal-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a84aaa4dd0ba008637b68a14ba317e210b0e6aef69ec84eda27c4dc1bec21a0d",
          "text": "Mij? Waarom denk je dat ik het ben?",
          "source_text": "Me? Why do you think it's me?",
          "transcription_review_required": false
        },
        "lal-02": {
          "path": "res://assets/languages/nl/audio/lal-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "94e536d54c50c313adea2b3e1f18f109cdf20a06e53cfdca241ba69666665d3c",
          "text": "Ik heb hier niets mee te maken!",
          "source_text": "I have nothing to do with this!",
          "transcription_review_required": false
        },
        "lal-04": {
          "path": "res://assets/languages/nl/audio/lal-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b866d0f09f8d88b2c72918a24edee05de50be019d7094018d9287a682885d186",
          "text": "Dus wat? Hoe durf je?",
          "source_text": "So what? How dare you?",
          "transcription_review_required": false
        },
        "lal-05": {
          "path": "res://assets/languages/nl/audio/lal-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cd7beb360f8de5c363e3867447ebd70309d72f4a8988dd36ede8e4e1aab50e0f",
          "text": "De enige mens die echt van mij houdt in deze wereld, en jij wilt dat van mij afnemen?",
          "source_text": "The only human being who truly loves me in this world, and you want to take that away from me?",
          "transcription_review_required": false
        },
        "lal-06": {
          "path": "res://assets/languages/nl/audio/lal-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d5a23ade94d1a7cffbe9e77c0ae879d5782b696a18ea67996dd6928d6ce60e78",
          "text": "Is ze niet mooi? Als ze eenmaal leest wat voor een geweldige wetenschapper ik ben, wordt ze smoorverliefd op mij.",
          "source_text": "Isn't she beautiful? Once she reads what a great scientist I am, she'll fall madly in love with me.",
          "transcription_review_required": false
        },
        "lal-07": {
          "path": "res://assets/languages/nl/audio/lal-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9e3dd3013b426e0f70bf350b48e673199a877e1a506640c4788703dfba809ad6",
          "text": "Dus wat?",
          "source_text": "So what?",
          "transcription_review_required": false
        },
        "lal-08": {
          "path": "res://assets/languages/nl/audio/lal-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "95e5301fa8cb34558629d1f7a57d1286c9379707c0b0fff781c56ad4582dbec9",
          "text": "Weet je dat jij en je beschuldigingen mij een dag werk hebben gekost? Verspil geen tijd meer!",
          "source_text": "Do you know that you and your accusations cost me a day's work? Do not waste any more of my time!",
          "transcription_review_required": false
        },
        "lal-09": {
          "path": "res://assets/languages/nl/audio/lal-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aa92afce80f99b44771add3ddb053685934234b1426cdb18896bbf85f4e5a04a",
          "text": "Dat was de mijne!",
          "source_text": "That was meant to be mine!",
          "transcription_review_required": false
        },
        "mel10": {
          "path": "res://assets/languages/nl/audio/mel10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f0e67934389be69a86e55148e8da2cdd287cba33c14630b2aad509e699942301",
          "text": "Je zult nog eens nadenken. Laten we niets overhaast doen. Als je een fout maakt, zullen je ouders elkaar niet ontmoeten en zul je voor altijd in de tijdtunnel blijven zweven.",
          "source_text": "You'll think again. Let's not do anything hasty. If you make a mistake, your parents won't meet, and you'll be floating in the time tunnel forever.",
          "transcription_review_required": false
        },
        "mel11": {
          "path": "res://assets/languages/nl/audio/mel11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d812f9a96be9dd3de19d34cc96c8eec3b69f41a5afc157a73cbf1a793456e21d",
          "text": "Nu kun je ervoor zorgen dat je ouders elkaar ontmoeten. Schiet op, ik heb je hier bij mij nodig.",
          "source_text": "Now you can make your parents meet. Hurry, I need you back here with me.",
          "transcription_review_required": false
        },
        "mel12": {
          "path": "res://assets/languages/nl/audio/mel12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a71bba61e1a2b6e96ca839f78543ddab86bfc7e35e662f917401f38bcd73c6fc",
          "text": "Zoek naar iets waaruit blijkt dat Alice de fotograaf is.",
          "source_text": "Look for something to show that Alice is the photographer.",
          "transcription_review_required": false
        },
        "mel2": {
          "path": "res://assets/languages/nl/audio/mel2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8c28d493908b8489ef3b5a064a3014ad5ef8389c618fecd17d360d46647eff18",
          "text": "HÃ©, kom op. Klik op deze persoon. Het lijkt erop dat ze je iets interessants te vertellen hebben.",
          "source_text": "Hey, come on. Click on this person. It looks as though they have something interesting to tell you.",
          "transcription_review_required": false
        },
        "mel21": {
          "path": "res://assets/languages/nl/audio/mel21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "96c28d30c53b5e3f3569894030d04a0b88683a54328854506a22213c70b68859",
          "text": "Ze lijkt niet te kunnen stoppen. Misschien is er iets waardoor ze stopt met niezen.",
          "source_text": "She can't seem to stop. Maybe there's something that will make her stop sneezing.",
          "transcription_review_required": false
        },
        "mel22": {
          "path": "res://assets/languages/nl/audio/mel22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "268dd9dbf665726f1ed17ced522b8cd6853ab953cefe93600c98a37b574a36c2",
          "text": "In plaats van te proberen dit probleem op te lossen, probeer dan het object dat het probleem veroorzaakt te verwijderen.",
          "source_text": "Instead of trying to solve this problem, try to remove the object that creates the problem.",
          "transcription_review_required": false
        },
        "mel23": {
          "path": "res://assets/languages/nl/audio/mel23.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "744c9a8e195f13a7b572362c85dd4603272071a6bc55968f52597ebf3c0db256",
          "text": "Ik denk dat Shy-Ann er is. Ik weet zeker dat ze ons kan helpen.",
          "source_text": "I think Shy-Ann's been around. I'm sure she can help us.",
          "transcription_review_required": false
        },
        "mel3": {
          "path": "res://assets/languages/nl/audio/mel3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "57f53593c2e007f1ebd5f83cae7e07ac7e0074d2af84dca0d0a70f67c727c34c",
          "text": "Ik denk dat iedereen hier op de een of andere manier betrokken is. Probeer af te stemmen op wat ze zeggen. Het kan zijn dat ze iets verbergen.",
          "source_text": "I think everyone here is involved somehow. Try to tune into what they're saying. They may be hiding something.",
          "transcription_review_required": false
        },
        "mel36": {
          "path": "res://assets/languages/nl/audio/mel36.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c310df87bf514ae88d5698564bb9abd6092cff559f02beafc0e8554c2899070b",
          "text": "Misschien heeft de persoon die de film heeft gemaakt hem afgezet om ontwikkeld te worden.",
          "source_text": "Maybe the person who took the film dropped it off to be developed.",
          "transcription_review_required": false
        },
        "mel4": {
          "path": "res://assets/languages/nl/audio/mel4.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9285e1d1a9a4062d4104c51eb59949262b2fef0986b4f63f40427ff81e099c8c",
          "text": "Weet je nog hoe we in de kamer van mijn zus rondsnuffelden? Doe het hier gerust ook! Je weet nooit wat je tegenkomt!",
          "source_text": "Remember how we used to snoop around in my sister's room? Feel free to do it here, too! You never know what you may find!",
          "transcription_review_required": false
        },
        "mel5": {
          "path": "res://assets/languages/nl/audio/mel5.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b80b1ee85fa856a149a8789e28f5aca7a92c5f9bc765c60eba129bb32a2be68d",
          "text": "Je kunt maar beter iets vragen, wat je maar wilt!",
          "source_text": "You'd better ask something, whatever you want!",
          "transcription_review_required": false
        },
        "mel6": {
          "path": "res://assets/languages/nl/audio/mel6.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9368588f173f68d96db505626031c506ab7933fd2a11da594337effd141a8bde",
          "text": "We moeten nadenken over wat we deze persoon uit onze tijd kunnen geven, het ideale geschenk dat de oplossing zal bieden.",
          "source_text": "We've got to think about what we can give this person from our time, the ideal gift that will do the trick.",
          "transcription_review_required": false
        },
        "mel6a": {
          "path": "res://assets/languages/nl/audio/mel6a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f101e99c0fd6d700b0c62a492b335da5554917dba85e96d0db78d2ac0b27ad30",
          "text": "Uh-oh, ik denk dat je iemand hier heel boos hebt gemaakt. Waarom kijk je niet in je rug naar iets dat hen zal kalmeren, zodat we onze reis kunnen voortzetten?",
          "source_text": "Uh-oh, I think you made someone here really mad. Why don't you look in your back for something that'll pacify them, so that we can continue our journey?",
          "transcription_review_required": false
        },
        "mel7": {
          "path": "res://assets/languages/nl/audio/mel7.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a70bebaf1b9af4a4a32a4706ed0c65509c89bcf02c331514e87832394dc29e67",
          "text": "Misschien kun je ze iets laten zien dat je hebt verzameld, waardoor ze aan het praten raken.",
          "source_text": "Maybe you can show them something you collected that will make them talk.",
          "transcription_review_required": false
        },
        "mel8": {
          "path": "res://assets/languages/nl/audio/mel8.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a1ac730bffc7dfb05b3e8839bd65cc00685374d0b20c135848fe21b704810019",
          "text": "Weet je zeker dat je dat wilt doen? Iemand beschuldigen is een zeer ernstige zaak, en daarvoor heb je bewijs nodig.",
          "source_text": "Are you sure you want to do that? Accusing someone is a very serious matter, and you need proof for that.",
          "transcription_review_required": false
        },
        "mel9": {
          "path": "res://assets/languages/nl/audio/mel9.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cdf59f4592d66a5a66a743cc53f9a2139f26af172ad8ace11a1973a208b55592",
          "text": "Ik zei toch dat ze bewijs wilden zien. Ik hoop dat je genoeg bewijs hebt.",
          "source_text": "I told you they'd want to see proof. I sure hope you have enough evidence.",
          "transcription_review_required": false
        },
        "melquit": {
          "path": "res://assets/languages/nl/audio/melquit.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f3fb0a2711120e1e2ed0a22268f113f3b22f036d3d33b1934dfc7f6da16484aa",
          "text": "Weet je zeker dat je het spel wilt verlaten?",
          "source_text": "Are you sure you want to quit the game?",
          "transcription_review_required": false
        },
        "jnia1-10": {
          "path": "res://assets/languages/nl/audio/jnia1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "39690f2aeee970a20669962e5f8be9d5375dbaab4d4dbed87c24d5ca97409406",
          "text": "Misschien heb je iets gehoord over een filmrolletje waar iedereen naar op zoek is?",
          "source_text": "Maybe you heard something about a roll of film that everyone's looking for?",
          "transcription_review_required": false
        },
        "jnia1-11": {
          "path": "res://assets/languages/nl/audio/jnia1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f86f683390cb0138e5277c3a4448a370592e96b1a99f0955d81d2194535b0ce4",
          "text": "Ik heb het gevoel dat je op een dag een beroemde verslaggever zult worden, met je scherpe zintuigen moet je weten waar de film is.",
          "source_text": "I have a feeling that one day you'll become a famous reporter, with your sharp senses, you must know where the film is.",
          "transcription_review_required": false
        },
        "jnia1-12": {
          "path": "res://assets/languages/nl/audio/jnia1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "44ded8736755b1ec4be20fd379e51e8ea4b6424cb1165c152c97f1559cd61724",
          "text": "Zit jij ook achter die film?",
          "source_text": "Are you also after that film?",
          "transcription_review_required": false
        },
        "jnia1-20": {
          "path": "res://assets/languages/nl/audio/jnia1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d95a20068ae4c2011b6650096d98c45439b176624079e4e4661148da1489b91e",
          "text": "Is dit waar Jimmy Mackenzie werkt?",
          "source_text": "Is this where Jimmy Mackenzie works?",
          "transcription_review_required": false
        },
        "jnia1-21": {
          "path": "res://assets/languages/nl/audio/jnia1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5c410d7e10fa8c8bb65f1229eb07a4ea33ff493b11f14856f88e5d547e251bc5",
          "text": "Waar is hij?",
          "source_text": "Where is he?",
          "transcription_review_required": false
        },
        "jnia1-22": {
          "path": "res://assets/languages/nl/audio/jnia1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "634fc2b82b37da36ae174ee4cb753880c6190a22287657cd829341735c5c9061",
          "text": "Je werkt samen met Jimmy. Weet je wie hij tegenwoordig ziet? Romantisch, bedoel ik.",
          "source_text": "You work with Jimmy. Do you know who he's seeing these days? Romanticly, I mean.",
          "transcription_review_required": false
        },
        "jnia2-10": {
          "path": "res://assets/languages/nl/audio/jnia2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bb8a761efbb0444097c94dc185b49f82ca9717934512e3c32eb48a3036ed1002",
          "text": "Vertel eens, ben jij de Veronica die dit ontwikkelingsblad heeft ondertekend?",
          "source_text": "Tell me, are you the Veronica who signed on this development sheet?",
          "transcription_review_required": false
        },
        "jnia2-20": {
          "path": "res://assets/languages/nl/audio/jnia2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "362e151aad66c4f0843fc37168ddd8a1b57a114124c3868c1d8ee1b41cf6b500",
          "text": "Veronica, is Jimmy hier?",
          "source_text": "Veronica, is Jimmy here?",
          "transcription_review_required": false
        },
        "jnia2-21": {
          "path": "res://assets/languages/nl/audio/jnia2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d1351fea93f08af95b095cad916b1d88beeccdc5f1890d7540ed5bcffd2302a6",
          "text": "Dus wie is deze mysterieuze Veronica?",
          "source_text": "So who's this mysterious Veronica?",
          "transcription_review_required": false
        },
        "jnia2-30": {
          "path": "res://assets/languages/nl/audio/jnia2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d0e5840871a88ac27ed374b5f79efe663f68cf25da6d4064382a50b4d6a38fa4",
          "text": "Ik denk dat ik iets in het lab heb gevonden dat van jou is.",
          "source_text": "I think I might have found something in the lab that belongs to you.",
          "transcription_review_required": false
        },
        "jnia2-31": {
          "path": "res://assets/languages/nl/audio/jnia2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b980165a7132502d3dba4928b735ea60fee743122fcad7f84db7e33022be588",
          "text": "Waar gaat het interview over?",
          "source_text": "What's the interview about?",
          "transcription_review_required": false
        },
        "jnia2-32": {
          "path": "res://assets/languages/nl/audio/jnia2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "11e730888a85ed4e928a7343425d6aeda25a6338d710ea81a7c158d98242161c",
          "text": "Heb je iemand verdacht op de schoot van Larry Chang zien hangen?",
          "source_text": "Did you notice anyone suspicious hanging around Larry Chang's lap?",
          "transcription_review_required": false
        },
        "jnib1-10": {
          "path": "res://assets/languages/nl/audio/jnib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d4c74d050c2f544c3a3f151fe4c51abca5d646c6bd5604640b99fbde4943bdff",
          "text": "Hoi! Werkt Jimmy Mackenzie hier?",
          "source_text": "Hi! Does Jimmy Mackenzie work here?",
          "transcription_review_required": false
        },
        "jnib1-11": {
          "path": "res://assets/languages/nl/audio/jnib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ff95795d2344d50a470c6a9701dcc4359ccd4790ad2fd9726017a544597577bc",
          "text": "Waar kan ik hem vinden?",
          "source_text": "Where can I find him?",
          "transcription_review_required": false
        },
        "jnib1-12": {
          "path": "res://assets/languages/nl/audio/jnib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cd50bdf7f29a04a9c95d997c5411892a91df83beef08470101f96d90bd1057f1",
          "text": "Weet jij toevallig of je vandaag een belangrijke vergadering hebt?",
          "source_text": "Would you happen to know if you have an important meeting today?",
          "transcription_review_required": false
        },
        "jnib1-20": {
          "path": "res://assets/languages/nl/audio/jnib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4a6396f097753644ac89c33cc521330ba55ba78e0729d95844f1e14ea389fb40",
          "text": "Bel om de vergadering zojuist te annuleren.",
          "source_text": "Call to cancel the meeting just now.",
          "transcription_review_required": false
        },
        "jnib1-21": {
          "path": "res://assets/languages/nl/audio/jnib1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f51a55a22cd9fb890c85188833a00154d9664eacf62374f8ad6d5be984a2fede",
          "text": "Wie bijvoorbeeld?",
          "source_text": "Who, for instance?",
          "transcription_review_required": false
        },
        "jnib1-22": {
          "path": "res://assets/languages/nl/audio/jnib1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e95df0ef7f296609deef7142b8894b35bbc07edd2314181fd04b16af6725679e",
          "text": "Zal Jimmy teleurgesteld zijn?",
          "source_text": "Is Jimmy going to be disappointed?",
          "transcription_review_required": false
        },
        "jnib1-30": {
          "path": "res://assets/languages/nl/audio/jnib1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0dee1a278f8b8460b44082d45db26cdeed3fd92cec1e4ba3a8a44c0f41ced375",
          "text": "Weet je toevallig of Jimmy McKenzie en Alice Kaplan aan het daten zijn?",
          "source_text": "Do you happen to know if Jimmy McKenzie and Alice Kaplan are dating?",
          "transcription_review_required": false
        },
        "jnib1-31": {
          "path": "res://assets/languages/nl/audio/jnib1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1c1c84e4ffd60b1b5d3d7fc8db73420dcd91e4e420a30d96a4c836874f70fe53",
          "text": "Wie is Sheila?",
          "source_text": "Who's Sheila?",
          "transcription_review_required": false
        },
        "jnib1-32": {
          "path": "res://assets/languages/nl/audio/jnib1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4d2f72bb175ed6399fc7d05b7cc12f6a22f058c095083382ae9619c804bddb44",
          "text": "Ik bedoelde Alice, Miss Equal Rights, Peace and Love, Alice.",
          "source_text": "I meant Alice, Miss Equal Rights, Peace and Love, Alice.",
          "transcription_review_required": false
        },
        "jnib2-10": {
          "path": "res://assets/languages/nl/audio/jnib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1bc9bf4e4f6135f163764e2dcd0089cd9bf3701cc787fc4fbd0712d23420d0fe",
          "text": "Ben je iets vergeten in het laboratorium?",
          "source_text": "Did you forget something in the lab?",
          "transcription_review_required": false
        },
        "jnib2-20": {
          "path": "res://assets/languages/nl/audio/jnib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4d16d7fe443da274a8ac7c3bad245765424d964b0ac39bba74e7d12119f22ece",
          "text": "Waar werk je aan?",
          "source_text": "What are you working on?",
          "transcription_review_required": false
        },
        "jnib2-21": {
          "path": "res://assets/languages/nl/audio/jnib2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "12816d7e12306ab9ec9e16ee5f5801ec02fac8801437e3cfd5587c231167f3a0",
          "text": "Kunt u het adres opschrijven waar het zal zijn?",
          "source_text": "Can you write down the address where it's going to be?",
          "transcription_review_required": false
        },
        "jnib2-22": {
          "path": "res://assets/languages/nl/audio/jnib2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "50a67674fedebcec50125356bb97d37abfb151a2938ee3b9442584484a9fc509",
          "text": "Kunt u mij een routebeschrijving geven?",
          "source_text": "Can you give me directions?",
          "transcription_review_required": false
        },
        "jnib2-30": {
          "path": "res://assets/languages/nl/audio/jnib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d0ddd2ea669d8ef7f4fd834c0a5518bae0cf04bd5e5977d6e67f46e1cbb61250",
          "text": "Hoe kwam je aan de primeur van dit artikel?",
          "source_text": "How did you get the scoop on this article?",
          "transcription_review_required": false
        },
        "nia1-01": {
          "path": "res://assets/languages/nl/audio/nia1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d1a9cbcbc20945d7b89526db2e618fba01f81a4e33cb2d12093ff3b43a7e069b",
          "text": "Bedankt voor de steun. Oh, als vrouwen over de hele wereld maar met elkaar konden communiceren. Nee, dat kan onmogelijk.",
          "source_text": "Thanks for the support. Oh, if only women all over the world could communicate among themselves. Nah, there's no way that could be done.",
          "transcription_review_required": false
        },
        "nia1-03": {
          "path": "res://assets/languages/nl/audio/nia1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a540e5634c81e587e9f5f42c3ef404d40a282d7c4909dcbc1cff3ff25b12c18b",
          "text": "Vrede!",
          "source_text": "Peace!",
          "transcription_review_required": false
        },
        "nia1-04": {
          "path": "res://assets/languages/nl/audio/nia1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d990197398f1b40e820fcfcccbc0e0b2c032b515ca7dff6648431161e178dba6",
          "text": "Wat wil je, zuster?",
          "source_text": "What do you want, sister?",
          "transcription_review_required": false
        },
        "nia1-10a": {
          "path": "res://assets/languages/nl/audio/nia1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "16d99595b34239c87eee75b1c8319c41030197dbe18587872ede5c6fe22cc66c",
          "text": "Luisteren.",
          "source_text": "Listen.",
          "transcription_review_required": false
        },
        "nia1-10b": {
          "path": "res://assets/languages/nl/audio/nia1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "195a6f6421a913df204f0ab21ec2767493e933c8d79d09f2c25a88a5d1c1602a",
          "text": "Jimmy vertelde me al dat hij een anonieme brief had gekregen over een film waarin de chemicaliÃ«n van Philip werden beschuldigd. Het zou mijn verhaal moeten zijn, maar je weet dat het een mannenwereld is.",
          "source_text": "Jimmy here already told me that he got an anonymous letter about a film incriminating Philip's chemicals. It should be my story, but you know it's a man's world out there.",
          "transcription_review_required": false
        },
        "nia1-11": {
          "path": "res://assets/languages/nl/audio/nia1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "28f44c227fb424c2f2b6765ecf55cda59a5e84f68dbb06315fd9deac7a4ed551",
          "text": "Hoi! Probeer die vleiende trucjes niet op mij uit!",
          "source_text": "Hey! Don't try those flattering tricks on me!",
          "transcription_review_required": false
        },
        "nia1-12": {
          "path": "res://assets/languages/nl/audio/nia1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2b9f0ad43637227e9309f043e23d671b31c698feef26848aba2c051a4ec2f038",
          "text": "Waarom vraag je dat? Heeft Larry Chang je die onzin verteld? Hij kreeg een beurs van Philip's Chemicals, weet je.",
          "source_text": "Why do you ask? Did Larry Chang tell you that nonsense? He got a scholarship from Philip's Chemicals, you know.",
          "transcription_review_required": false
        },
        "nia1-20a": {
          "path": "res://assets/languages/nl/audio/nia1-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "428e7cefeedb552dd28b8f8ec846f87cc32887bff3d80b087b1e1545b2e726ba",
          "text": "Ja, dat is zijn bureau.",
          "source_text": "Yep, that's his desk.",
          "transcription_review_required": false
        },
        "nia1-20b": {
          "path": "res://assets/languages/nl/audio/nia1-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c2f84cbc6ac4af942ead97afb4cd78640857d740a51c1939b05f0ce7888357c0",
          "text": "Ruikt hemels.",
          "source_text": "Smells heavenly.",
          "transcription_review_required": false
        },
        "nia1-21": {
          "path": "res://assets/languages/nl/audio/nia1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a21580f82c8375c276f3553e46d8f27592e6ad2d772437474382d0e8521cac05",
          "text": "Hier, daar en overal.",
          "source_text": "Here, there and everywhere.",
          "transcription_review_required": false
        },
        "nia1-22": {
          "path": "res://assets/languages/nl/audio/nia1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "57b57df730541db771dd24e7d0840b2244153a02bb78bbfe80308413f4eef083",
          "text": "Luister, nieuwsgierig. Jimmy Mackenzie is niet mijn enige interesse in het leven. Ik ben niet zoals Sheila Phillips, die geobsedeerd is door Jimmy, zelfs nadat hij haar gedumpt heeft.",
          "source_text": "Listen, nosy. Jimmy Mackenzie's not my only interest in life. I'm not like Sheila Phillips, who's obsessed with Jimmy even after he dumped her.",
          "transcription_review_required": false
        },
        "nia2-01": {
          "path": "res://assets/languages/nl/audio/nia2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "042effc1c0e0b19568e46b876065d01c0e424bf054b497856ea75116746c6066",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nia2-02": {
          "path": "res://assets/languages/nl/audio/nia2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d0e3a93709331880e2e5039944f793726c0dd94e7e68834945728ae7fb022f4d",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nia2-03": {
          "path": "res://assets/languages/nl/audio/nia2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cc3f1b97e8028df2e133bd4693410057bed92df08995f95be384fb503866e007",
          "text": "Er is niets nieuws onder de zon en wij zijn hier om een â€‹â€‹verschil te maken.",
          "source_text": "There's nothing new under the sun, and we are here to make a difference.",
          "transcription_review_required": false
        },
        "nia2-10": {
          "path": "res://assets/languages/nl/audio/nia2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c36ee6855ed89781d511c0547c78689e924690ae500f9968b7d2f52840aa01cd",
          "text": "HÃ©, ik ben een verslaggever die verhalen onderzoekt, niet creÃ«ert.",
          "source_text": "Hey, I'm a reporter investigating stories, not creating them.",
          "transcription_review_required": false
        },
        "nia2-10m": {
          "path": "res://assets/languages/nl/audio/nia2-10m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1bafdf3a49b143811e561a5c225a7923f2ea08b50524492a70ed34001e2b1ae0",
          "text": "Nixon zal president worden. Alleen omdat je zo'n fantasierijke geest hebt, zal ik je eerdere beschuldigingen vergeten.",
          "source_text": "Nixon will become president. Just because you have such an imaginative mind, I'll forget your previous accusations.",
          "transcription_review_required": false
        },
        "nia2-20": {
          "path": "res://assets/languages/nl/audio/nia2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3318795c5124d7ab8a539a110302424702a2e38b660457d68f61f28cf39853cf",
          "text": "Waarom denk je dat mijn naam Veronica is?",
          "source_text": "What makes you think my name is Veronica?",
          "transcription_review_required": false
        },
        "nia2-20h": {
          "path": "res://assets/languages/nl/audio/nia2-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "abf5556f75913542708b6a6b746424eec8873f3fdbba71749f8eedc7febf0a35",
          "text": "Oh, je dacht dat Nika een afkorting was voor Veronica. Eigenlijk is het een afkorting voor Monica.",
          "source_text": "Oh, you thought Nika was short for Veronica. Actually, it's short for Monica.",
          "transcription_review_required": false
        },
        "nia2-21a": {
          "path": "res://assets/languages/nl/audio/nia2-21a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c1609ad45008f0a7aabe937bb0438a1fd7989ab81989c76dc7717cab6a7552b",
          "text": "Dan bent u bij de juiste persoon terechtgekomen.",
          "source_text": "Well, you came to the right person.",
          "transcription_review_required": false
        },
        "nia2-21b": {
          "path": "res://assets/languages/nl/audio/nia2-21b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "923cef67d02d7358fc7a6c278e0ec8ae7c55684e20d50e86e2d2d5ac02722386",
          "text": "Ik doe onderzoek onder alle meisjes op de campus om te controleren van welke middelbare scholen ze afkomstig zijn. Geloof me, er is geen Veronica.",
          "source_text": "I'm doing research on all the girls on campus to check which high schools they came from. Believe me, there is no Veronica.",
          "transcription_review_required": false
        },
        "nia2-30": {
          "path": "res://assets/languages/nl/audio/nia2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bd774aa9eb80fc45493656fe80314e5014585ae5e11372143213557f05209500",
          "text": "Ja, ik was daar net. Wat heb je gevonden?",
          "source_text": "Yeah, I was just there. What did you find?",
          "transcription_review_required": false
        },
        "nia2-30h": {
          "path": "res://assets/languages/nl/audio/nia2-30h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ba757b6d8515de16f9840a7a9568c8be1636515c5afd7d54743cd35fec065e31",
          "text": "Ze zijn niet van mij. Ik knip niet tijdens het interviewen van mijn onderwerpen.",
          "source_text": "They're not mine. I don't do any cutting while interviewing my subjects.",
          "transcription_review_required": false
        },
        "nia2-31": {
          "path": "res://assets/languages/nl/audio/nia2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "229be7cbca5dcea64bc97b121b31a8d677b371f0a813a538bf2bb8a9850f3619",
          "text": "Ik controleer verschillende middelbare scholen om te zien welk percentage van hun vrouwelijke studenten doorstroomt naar het hoger onderwijs. Ik interview alle meisjes op de campus.",
          "source_text": "I'm checking different high schools to see what percentage of their women's students continue on to higher education. I'm interviewing all the girls on campus.",
          "transcription_review_required": false
        },
        "nia2-32": {
          "path": "res://assets/languages/nl/audio/nia2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9873a2488c6a6dd9e6c59db92a35651a8afce36df6fc59518ad5cb43e5342c7b",
          "text": "Niet vandaag, maar nu je het zegt, ik zag Susan, het meisje uit Photoshop, op een grappige manier door de gang lopen.",
          "source_text": "Not today, but now that you mention it, I did see Susan, the girl from the Photoshop, walking up and down the corridor in a funny sort of way.",
          "transcription_review_required": false
        },
        "nia2-h": {
          "path": "res://assets/languages/nl/audio/nia2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b88402b2435419c5174cef8e439c230212354aa6145e96729cb9a19dc1c82f84",
          "text": "Ik moet eerlijk tegen je zijn. Ik ben onverschillig voor bloemen.",
          "source_text": "I have to be frank with you. I'm indifferent to flowers.",
          "transcription_review_required": false
        },
        "nib1-01": {
          "path": "res://assets/languages/nl/audio/nib1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0c00b3c6c065f5334f168f90a6e498b6afd58d1d0e70421afa3a2d285b7bd6a5",
          "text": "OkÃ©, dus de film is weg en je vergadering wordt mogelijk geannuleerd.",
          "source_text": "Okay, so the film is gone and your meeting might be canceled.",
          "transcription_review_required": false
        },
        "nib1-02": {
          "path": "res://assets/languages/nl/audio/nib1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a34c6d67d50004df5b0abf60dccc7cec28fcdc8c59d0fd292f3ec8159e2a859c",
          "text": "Een momentje, ik moet een briefje voor Jimmy achterlaten waarin staat dat zijn vergadering mogelijk wordt geannuleerd.",
          "source_text": "Just a minute, I need to leave Jimmy a note saying that his meeting might be cancelled.",
          "transcription_review_required": false
        },
        "nib1-03": {
          "path": "res://assets/languages/nl/audio/nib1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7f6b571ccf516fa0989dae0c979c859d3d7a96f4dee223c188f7b882f8a473cd",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nib1-04": {
          "path": "res://assets/languages/nl/audio/nib1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "638eec235a99c7d1e4609a91944faa19ccdf186deb1f08f87ae0855a1950f86b",
          "text": "Ik vergat bijna Jimmy een briefje te schrijven over dat meisje dat belde om de vergadering af te zeggen.",
          "source_text": "I almost forgot to write Jimmy a note about that girl who called to cancel the meeting.",
          "transcription_review_required": false
        },
        "nib1-10": {
          "path": "res://assets/languages/nl/audio/nib1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "53638970094c5eba368f61bb26542af6c032f02d066856b0a1c417b527d7c1c1",
          "text": "Waarom vraag je dat? Heb jij een verhaal voor hem? Misschien kan ik je helpen.",
          "source_text": "Why do you ask? Do you have a story for him? Maybe I can help you.",
          "transcription_review_required": false
        },
        "nib1-11": {
          "path": "res://assets/languages/nl/audio/nib1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e3921af7f76e9f4a2c0f81563c2ee212a80dc114e2002923498dd9b73d5aa35f",
          "text": "Denk je dat ik zijn secretaris ben? Als ik een man was, durf ik om een â€‹â€‹miljoen dollar te wedden dat je zou aannemen dat ik een verslaggever was.",
          "source_text": "Do you think I'm his secretary? Now if I were as a man, I'd bet you a million dollars you'd assume I was a reporter.",
          "transcription_review_required": false
        },
        "nib1-12": {
          "path": "res://assets/languages/nl/audio/nib1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "29f6c147fa3450d3f846e47a470d2587b8c4e021629b4e835a6936bdea893430",
          "text": "Het nieuws verspreidt zich snel in deze stad, hÃ¨? Hij heeft een ontmoeting met een meisje dat hem bewijs moet geven van een ecologische ramp bij Philips chemicaliÃ«n.",
          "source_text": "Word gets around fast in this town, huh? He's got a meeting with some girl who's supposed to give him evidence of an ecological disaster at Philip's chemicals.",
          "transcription_review_required": false
        },
        "nib1-20": {
          "path": "res://assets/languages/nl/audio/nib1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0f84c504a738634f5368c758c71f268ccc4aef299109dbbebcd1939321f90536",
          "text": "Wauw, je hebt oren als een olifant! Dat was het anonieme meisje dat het briefje schreef. Ze zei dat de film verdwenen is. Het is geen wonder. Er zijn veel mensen die willen voorkomen dat Jimmy een goede aanwijzing krijgt over een mogelijk schandaal.",
          "source_text": "Wow, you've got ears like an elephant! That was the anonymous girl who wrote the note. She said that the film has disappeared. It's no wonder. There are many people who'd want to prevent Jimmy from getting a good lead on a potential scandal.",
          "transcription_review_required": false
        },
        "nib1-21": {
          "path": "res://assets/languages/nl/audio/nib1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "991ca64e1019398ae8706ed864945a842664bff5cafcc9e617292b49076c1d85",
          "text": "Bijvoorbeeld Rick van de muziekwinkel. Jimmy schreef een niet zo positieve recensie over zijn muziek, als je begrijpt wat ik bedoel. En laten we niet eens beginnen te praten over al zijn ex-vriendinnen die wrok tegen hem koesteren.",
          "source_text": "For instance, Rick from the music store. Jimmy wrote a not-so-positive review about his music if you get what I'm saying. And let's not even begin to talk about all his ex-girlfriends who hold grudges against him.",
          "transcription_review_required": false
        },
        "nib1-22": {
          "path": "res://assets/languages/nl/audio/nib1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "599b1707e435462135e3b023d96774454d0adea8ad090a1461ef46b2ec6ab741",
          "text": "Wat denk je? Hij wacht al jaren op zo'n primeur. Had ik dat verhaal maar voor hem in handen gehad.",
          "source_text": "What do you think? He's been waiting for a scoop like this for years. If only I had laid my hands on that story before him.",
          "transcription_review_required": false
        },
        "nib1-30": {
          "path": "res://assets/languages/nl/audio/nib1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3cd4deb9cb1419c3d43406a3b8a934e59f8a0a3c56526b0c75201829e20e7afe",
          "text": "Alice, wie is Alice? Oh, je bedoelt Sheila.",
          "source_text": "Alice, who's Alice? Oh, you mean Sheila.",
          "transcription_review_required": false
        },
        "nib1-31": {
          "path": "res://assets/languages/nl/audio/nib1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "df0bdf38d9f0eab461bc5be7dad6872aa37d76aa70e27ad5629bce6e05776d8d",
          "text": "Sheila Phillips, zijn verwoeste ex. Het is een week geleden en ze is nog steeds niet over hem heen.",
          "source_text": "Sheila Phillips, his devastated ex. It's been a week and she's still not over him.",
          "transcription_review_required": false
        },
        "nib1-32": {
          "path": "res://assets/languages/nl/audio/nib1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4316f0e74159190071b8b43fea97dd529fa429acd82aca4984f9f9f2a0fb59b1",
          "text": "Nou ja, zijn we dat niet allemaal, maar hoe dan ook, nee, ik ken je Alice niet.",
          "source_text": "Well, aren't we all, but anyway, no, I don't know your Alice.",
          "transcription_review_required": false
        },
        "nib2-01": {
          "path": "res://assets/languages/nl/audio/nib2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9b79cbce8f3fa251a7d9839471f51181690b11f7415bdea7f6c75748be9beccd",
          "text": "Ik heb het erg druk. Ik heb een deadline voor de voorpagina voor morgen.",
          "source_text": "I'm really busy. I have a front page deadline for tomorrow.",
          "transcription_review_required": false
        },
        "nib2-02": {
          "path": "res://assets/languages/nl/audio/nib2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c4ee72b87ed61d14101a044dec3ea7b2f8346e549ac00fc1786b25271d23fc44",
          "text": "Ik heb het druk. Ik moet een artikel schrijven.",
          "source_text": "I'm busy. I have an article to write.",
          "transcription_review_required": false
        },
        "nib2-03": {
          "path": "res://assets/languages/nl/audio/nib2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4797b04059d858a60234ffe33795ceb9e0e7c868622b8c5403ffd0bd84013ab7",
          "text": "Vrede.",
          "source_text": "Peace.",
          "transcription_review_required": false
        },
        "nib2-10": {
          "path": "res://assets/languages/nl/audio/nib2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c243672abebc9227526e182430bdc512c387657bbccbad19694324f067941172",
          "text": "Waarom vraag je dat?",
          "source_text": "Why do you ask?",
          "transcription_review_required": false
        },
        "nib2-10h": {
          "path": "res://assets/languages/nl/audio/nib2-10h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f82d5e91e6018ed08a57d5df9f858cfa6ed76707510d8dece7be38b379ba616a",
          "text": "Is dit een grap? Zie je niet dat ik mijn bril draag?",
          "source_text": "Is this a joke? Can't you see I'm wearing my glasses?",
          "transcription_review_required": false
        },
        "nib2-20": {
          "path": "res://assets/languages/nl/audio/nib2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "29b43cf5aed31da30999e7ba339918c94c9d8d7d0dd05fc4abda80368fa2c682",
          "text": "Een artikel over deze rally die we organiseren. Vrouwen voor de ERA. Het wordt wild. Wij gaan de wereld veranderen. Jij zou ook moeten komen.",
          "source_text": "An article about this rally we're organizing. Women for the ERA. It's going to be wild. We're going to change the world. You should come, too.",
          "transcription_review_required": false
        },
        "nib2-21": {
          "path": "res://assets/languages/nl/audio/nib2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b110db474aa27bd78d088bd06f9812932d9ae6e27d5e3e07b801519b017098a6",
          "text": "Zeker.",
          "source_text": "Sure.",
          "transcription_review_required": false
        },
        "nib2-22": {
          "path": "res://assets/languages/nl/audio/nib2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aeaf37af6e22ceec2cc700cd505e30413c00a1b3233dcd6398ace071b3eebda2",
          "text": "Het is twee blokken verderop aan uw rechterhand.",
          "source_text": "It's two blocks from here on your right.",
          "transcription_review_required": false
        },
        "nib2-30": {
          "path": "res://assets/languages/nl/audio/nib2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dc11623db7134c3fa9a4c06159545162467773a86fc563ce57a867b1a00fca41",
          "text": "Hoe bedoel je, hoe kwam ik eraan? Daar heb ik hard voor gewerkt. Als vrouw moet ik nog harder werken. Ze geven mij nooit aanwijzingen.",
          "source_text": "What do you mean, how did I get it? I worked hard for that. As a woman, I have to work even harder. They never give me any leads.",
          "transcription_review_required": false
        },
        "nib2-30m": {
          "path": "res://assets/languages/nl/audio/nib2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "31bf9f4882a7e43f63c93df428a60f30f456162695e516a34a2fbb4034ea4550",
          "text": "Martin Luther King zal worden vermoord? HÃ©, waar heb je deze informatie vandaan? Bent u van de FBI?",
          "source_text": "Martin Luther King will be assassinated? Hey, where did you get this information? Are you from the FBI?",
          "transcription_review_required": false
        },
        "nil-01": {
          "path": "res://assets/languages/nl/audio/nil-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e9c6dcffb04e1b58f982122faadac38dbbf1045f3463f9d111cd06160614bd68",
          "text": "Waarom denk je dat ik schuldig ben?",
          "source_text": "What gives you the idea that I'm guilty?",
          "transcription_review_required": false
        },
        "nil-02": {
          "path": "res://assets/languages/nl/audio/nil-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b99b3cc0d67aeaa2c67f70137123503184b1e68757002ae249988a7248be6fb2",
          "text": "Dit is niet de mijne.",
          "source_text": "This is not mine.",
          "transcription_review_required": false
        },
        "nil-03": {
          "path": "res://assets/languages/nl/audio/nil-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b4f85cde367e07295c54e98aa40ad5dc6199a3616d1ddc107890cfa156cad8c4",
          "text": "Dus...",
          "source_text": "So...",
          "transcription_review_required": false
        },
        "nil-04": {
          "path": "res://assets/languages/nl/audio/nil-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "faf926a4d154b458e588297393ee0a0e19a9e6e3b9f263168c4cfd0734a751d4",
          "text": "Eindelijk is het goed om te zien dat vrouwen ook onderzoeksbeurzen ontvangen. Ik ben trots op haar.",
          "source_text": "At last, it's good to see women receiving research scholarships, too. I'm proud of her.",
          "transcription_review_required": false
        },
        "nil-05": {
          "path": "res://assets/languages/nl/audio/nil-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "61524334e9102065e7f99d9ca73e8b4fe7fd30fe03ae6e15ac92911c6e547dc9",
          "text": "Zoals je kunt zien, heb ik mijn jurken nooit ingekort.",
          "source_text": "As you can see, I never shortened my dresses.",
          "transcription_review_required": false
        },
        "nil-06": {
          "path": "res://assets/languages/nl/audio/nil-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6ca3871272c10e5fcdf85d6b3b401a2b47aa9beac8f5a9543ee8fa714fee1022",
          "text": "OkÃ©, ik was het dus. Ik geef toe dat ik dat roddelartikel heb geschreven. Wat kan ik doen? Ik moet hier ook het vuile werk opknappen.",
          "source_text": "Okay, so it was me. I admit I wrote that gossipy article. What can I do? I have to do the dirty work around here, too.",
          "transcription_review_required": false
        },
        "nil-07": {
          "path": "res://assets/languages/nl/audio/nil-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c3719853ef205934df67a16bd8e2ff0b756a6450fca1da8c21c33a7733455a28",
          "text": "Met die onbetrouwbare bladeren red je het nooit als journalist.",
          "source_text": "You'll never make it as a journalist with those unreliable leaves.",
          "transcription_review_required": false
        },
        "nila-01": {
          "path": "res://assets/languages/nl/audio/nila-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "43c15237b7e27d471b8b106e348fbe835861d29f8e3a4c56dd9bcc4b40ba4311",
          "text": "Je hebt heel goed speurwerk verricht. Oh, als alleen vrouwen de wereld zouden regeren, zou het een betere plek zijn.",
          "source_text": "You did some very good detective work. Oh, if only women ruled the world it would be a better place.",
          "transcription_review_required": false
        },
        "nilb-01": {
          "path": "res://assets/languages/nl/audio/nilb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e4daff7cad1d2a25f8b6f3180129bd55bdfb5ccddfa7f6cb56056d36edaa3fa8",
          "text": "Ik wist dat je de klus zou klaren. Je bent een vrouw, nietwaar?",
          "source_text": "I knew you'd get the job done. You're a woman, aren't you?",
          "transcription_review_required": false
        },
        "jsua2-20": {
          "path": "res://assets/languages/nl/audio/jsua2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a47e6ccfda3f1f36fe789ec85191de341db324195da88ee0d6cd4eb549dae300",
          "text": "Ken jij Jimmy Mackenzie?",
          "source_text": "Do you know Jimmy Mackenzie?",
          "transcription_review_required": false
        },
        "jsua2-21": {
          "path": "res://assets/languages/nl/audio/jsua2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d4202dee5d10b8218b97efbdf5dd0189edb50366daadf6a20a6f916690c6c948",
          "text": "Is Jimmy niet jouw smaak? Ik dacht dat hij ieders smaak was.",
          "source_text": "Jimmy's not your taste? I thought he was everyone's taste.",
          "transcription_review_required": false
        },
        "jsua2-22": {
          "path": "res://assets/languages/nl/audio/jsua2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf8419e1eccfa5c854d921e2eee7817d6840a1732d83f41e0c16285405f9bf40",
          "text": "Wat is jouw smaak?",
          "source_text": "What is your taste?",
          "transcription_review_required": false
        },
        "jsua2-30": {
          "path": "res://assets/languages/nl/audio/jsua2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "71e1ab25bd8c2e490d6e526935f43406b2a1338a3b6c84dac1037daa40241cc6",
          "text": "Susan, zou jij een van Alice's jurken willen dragen?",
          "source_text": "Susan, would you wear one of Alice's dresses?",
          "transcription_review_required": false
        },
        "jsua2-40": {
          "path": "res://assets/languages/nl/audio/jsua2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "22be57ca0a49a8de92ae8c0bfebe148df01f715e3726536e3d4b8fc62ca2cf6b",
          "text": "Ik hou van je jurk. Waar doet u uw boodschappen?",
          "source_text": "I love your dress. Where do you do your shopping?",
          "transcription_review_required": false
        },
        "jsub2-10": {
          "path": "res://assets/languages/nl/audio/jsub2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07fc71ae6611db9b98f919263cfd4e630a0644482d8421f99d7632eb3bd29d78",
          "text": "Kent u iemand met de initialen SP?",
          "source_text": "Do you know anyone with the initials SP?",
          "transcription_review_required": false
        },
        "jsub2-20": {
          "path": "res://assets/languages/nl/audio/jsub2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "35f4e532cb8b9441f4186d7064fc87f068c36ce0d60c45013ca817b271d6c22e",
          "text": "Ken jij Alice Kaplan?",
          "source_text": "Do you know Alice Kaplan?",
          "transcription_review_required": false
        },
        "jsub2-21": {
          "path": "res://assets/languages/nl/audio/jsub2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2d8a5d0d4322e3569fd62fc051abfef0a67dd3a7a1d113a8a543ba5aa509e80a",
          "text": "Zou je uitgaan met iemand met wie Alice uitgaat?",
          "source_text": "Would you go out with someone who Alice dates?",
          "transcription_review_required": false
        },
        "jsub2-22": {
          "path": "res://assets/languages/nl/audio/jsub2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8abf965ae6c7950d43d330a1ceebb13a54fa2b0fbe013779c8e00e413154da2e",
          "text": "Weet jij iets over de annulering van Alice's bijeenkomst?",
          "source_text": "Do you know anything about Alice's meeting being canceled?",
          "transcription_review_required": false
        },
        "jsub2-30": {
          "path": "res://assets/languages/nl/audio/jsub2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f1c3517f825f98cbf354ed1c4590b40e4527377066aee4b8bb777575b87a1e30",
          "text": "Welk nummer speelde dat op de radio?",
          "source_text": "What song was that playing on the radio?",
          "transcription_review_required": false
        },
        "jsub2-40": {
          "path": "res://assets/languages/nl/audio/jsub2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dda1c500f367aeb0a35a12a155bd20c3a8aec5275de313dd7c68d1db7d7eb2e1",
          "text": "Je hebt een geweldige stem. Heb je er ooit aan gedacht om bij een band te gaan?",
          "source_text": "You have a great voice. Did you ever think of joining a band?",
          "transcription_review_required": false
        },
        "sua1-01": {
          "path": "res://assets/languages/nl/audio/sua1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a08448fdce58f2b71cffc21bbeab612bd5f2797948282af42d7b5b1c2edb4c19",
          "text": "Nog even!",
          "source_text": "Just a minute!",
          "transcription_review_required": false
        },
        "sua1-02": {
          "path": "res://assets/languages/nl/audio/sua1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "52151cb33fbb10a7a2321f290feaf16631f60478c8d58caf9192572cfcaef20b",
          "text": "Ik kom! Ken je die groene tas die Alice heeft? Nou, ik heb er precies zo Ã©Ã©n.",
          "source_text": "I'm coming! You know that green bag Alice has? Well, I got one just like it.",
          "transcription_review_required": false
        },
        "sua1-03": {
          "path": "res://assets/languages/nl/audio/sua1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f47d36fcd5a5c95d86c508bc77bfdc2164a5ba36fcb8fe830377e85319bff5fc",
          "text": "Laat uw film op het bureau liggen en vul uw naam in op het ontwikkelblad.",
          "source_text": "Please leave your film on the desk and fill in your name on the development sheet.",
          "transcription_review_required": false
        },
        "sua2-01": {
          "path": "res://assets/languages/nl/audio/sua2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e49cd27a7ffd0c49b1e8404c53e5a3e67347000e5d348169170edc38188bd134",
          "text": "Hallo, ik ben Susan. Hoe kan ik je helpen?",
          "source_text": "Hi, I'm Susan. How can I help you?",
          "transcription_review_required": false
        },
        "sua2-02": {
          "path": "res://assets/languages/nl/audio/sua2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "839917cc739ffc77b4e9f095f367d70ae50711a4ef7ee5349625eadad91bad8c",
          "text": "Ik hoop dat ze mijn briefje niet heeft gelezen.",
          "source_text": "Oh, I hope she didn't read my note.",
          "transcription_review_required": false
        },
        "sua2-03": {
          "path": "res://assets/languages/nl/audio/sua2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1ffd43a39ceb3024b89b0d3844bf1aa548dde7eb110b3c1a2d8c7632e495fc7c",
          "text": "Ik hoop dat ze mijn briefje niet heeft gelezen.",
          "source_text": "Oh, I hope she didn't read my note.",
          "transcription_review_required": false
        },
        "sua2-10": {
          "path": "res://assets/languages/nl/audio/sua2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "916434e541e37e150ffb54eca0a897f0f38d41988a27626eeb59604ab9b320bc",
          "text": "Heb je naar mijn persoonlijke notitie gekeken? Mijn privÃ©leven is erg privÃ©.",
          "source_text": "Did you peek at my personal note? My private life is very private.",
          "transcription_review_required": false
        },
        "sua2-20b": {
          "path": "res://assets/languages/nl/audio/sua2-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e7dd310b64ac418534c9a7c807d3d0ba713b28bec1e99d37d95c2095a356ab53",
          "text": "Ik heb over hem gehoord. Veel meisjes hier op de campus zijn verliefd op hem. Persoonlijk is hij niet mijn smaak.",
          "source_text": "I've heard about him. A lot of girls here on campus are in love with him. Personally, he's not my taste.",
          "transcription_review_required": false
        },
        "sua2-21": {
          "path": "res://assets/languages/nl/audio/sua2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3bc6f30b771bfb7cb6091992073b51be44878dd9cdd5e71b5196048f542322fa",
          "text": "Is een van die populaire jongens? Tegenwoordig probeer ik weg te blijven van dat soort mensen. Op de middelbare school was ik verliefd op een populaire jongen, en het kostte me bijna mijn beste vriend.",
          "source_text": "Is one of those popular guys? Nowadays, I try to stay away from those types. In high school, I was in love with a popular guy, and it almost cost me my best friend.",
          "transcription_review_required": false
        },
        "sua2-22": {
          "path": "res://assets/languages/nl/audio/sua2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "2690ede9624aa8ca3a3f9207f3957c0064f823a090152e6434a5b9303b2ec848",
          "text": "Iemand die heel serieus is en toegewijd aan zijn werk, zo toegewijd dat hij niet eens zijn hoofd opheft om naar mij te kijken.",
          "source_text": "Someone who is very serious and committed to his work, so committed that he doesn't even lift his head to look at me.",
          "transcription_review_required": false
        },
        "sua2-30a": {
          "path": "res://assets/languages/nl/audio/sua2-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c99b0e86a90e491c87bcfb6a0d1e45dc43343bb5a0c688b902e3820f586b3015",
          "text": "Alice's jurken? Nee. Haar groene tas, ja. Haar blauwe band, zeker. Oh, ik wou dat ik haar jurken kon dragen, maar ik heb haar figuur niet.",
          "source_text": "Alice's dresses? No. Her green bag, yes. Her blue belt, sure. Oh, I wish I could wear her dresses, but I don't have her figure.",
          "transcription_review_required": false
        },
        "sua2-30c": {
          "path": "res://assets/languages/nl/audio/sua2-30c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b0a678bed747da2d5103e627bfc38740f87c409359d4830204a8308f53281b8",
          "text": "En ik heb niet haar zijdezachte, sluike haar.",
          "source_text": "And I don't have her silky straight hair.",
          "transcription_review_required": false
        },
        "sua2-30m": {
          "path": "res://assets/languages/nl/audio/sua2-30m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e021752a73dd7a5a1f70ec29800c58f1fcc7d8d06682a1250dbc24c569955e3d",
          "text": "Wauw, ver weg. Ik heb mijn strijkijzer niet meer nodig.",
          "source_text": "Wow, far out. I don't need my iron anymore.",
          "transcription_review_required": false
        },
        "sua2-40": {
          "path": "res://assets/languages/nl/audio/sua2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "622480440d5b0d7ec4ed01efdce4a2077c4c168f1a34b9aaa854175c4d7cd25f",
          "text": "En Sheila's boetiek? Ze heeft daar verbluffende dingen, zoals de kralenjurk van Alice. Maar dat komt niet in mijn maat.",
          "source_text": "And Sheila's boutique? She's got mind-blowing things there, like the beaded dress Alice has. But that doesn't come in my size.",
          "transcription_review_required": false
        },
        "sua2-h": {
          "path": "res://assets/languages/nl/audio/sua2-h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "77d302a457bb852373e8450e9dc8f0e8960f17df70f5a07ec3673ec3d280bde6",
          "text": "HÃ©, kun je dat alsjeblieft van me af verplaatsen? Ik ben allergisch voor zonnebloemen.",
          "source_text": "Hey, can you please move that away from me? I'm allergic to sunflowers.",
          "transcription_review_required": false
        },
        "sub1-01": {
          "path": "res://assets/languages/nl/audio/sub1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3338956ea0a1f4216057c28cfabfa9093863ac5c546b38d4c57bd8ac1d61b6e6",
          "text": "Ik zal er zijn, het is niet het einde van de wereld. Je zult iemand vinden die beter bij je past.",
          "source_text": "I'll be there, it's not the end of the world. You'll find someone who's better for you.",
          "transcription_review_required": false
        },
        "sub1-03": {
          "path": "res://assets/languages/nl/audio/sub1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e6778e606da81e2ffd95e875a1f0b1aa58b6b1c2bb4666b03175eaff2b19b19",
          "text": "Laat de film gewoon op de toonbank liggen en vul uw naam en adres in op het ontwikkelblad.",
          "source_text": "Just leave the film on the counter and fill in your name and address on the development sheet.",
          "transcription_review_required": false
        },
        "sub2-01": {
          "path": "res://assets/languages/nl/audio/sub2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "de2f26d1291717cfb90803c2adc8bff2da512c1e726a04553dc6739a5878d50e",
          "text": "Wat een gaaf liedje. Die woorden kan ik me echt in vinden.",
          "source_text": "What a cool song. Those words I can really relate.",
          "transcription_review_required": false
        },
        "sub2-02": {
          "path": "res://assets/languages/nl/audio/sub2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bec0af496b173c38cb5715b375044384a026aba9d6683ee16ffb54da7204bbf2",
          "text": "Niemand zou dit moeten zien.",
          "source_text": "Nobody should see this.",
          "transcription_review_required": false
        },
        "sub2-03": {
          "path": "res://assets/languages/nl/audio/sub2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "df70ab7e0e130112daed95131cda3f815cec8954b4412e1267dd8146e22b6444",
          "text": "Ik hoop dat ze mijn briefje niet kan lezen.",
          "source_text": "I hope she can't read my note.",
          "transcription_review_required": false
        },
        "sub2-04": {
          "path": "res://assets/languages/nl/audio/sub2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c3965858889cde9b531f5c010c66facf563f6db0b67be380011c976d205014f4",
          "text": "Sorry, we zijn gesloten.",
          "source_text": "Sorry, we're closed.",
          "transcription_review_required": false
        },
        "sub2-10": {
          "path": "res://assets/languages/nl/audio/sub2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "77b551f2c2184a390864d6408999196c27eb12221997f8914f6832ec3b442e57",
          "text": "SP? Nee. Wacht. Je hebt naar mijn briefje gekeken. Het is persoonlijk.",
          "source_text": "SP? No. Wait. You looked at my note. It's personal.",
          "transcription_review_required": false
        },
        "sub2-20a": {
          "path": "res://assets/languages/nl/audio/sub2-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "039280e63f2cf05229cda2c61b82225d464f16e957b6759d8c6e17759fd40465",
          "text": "Natuurlijk ken ik Alice. Wauw, ze is zo ver weg.",
          "source_text": "Sure I know Alice. Wow, she's so far out.",
          "transcription_review_required": false
        },
        "sub2-20b": {
          "path": "res://assets/languages/nl/audio/sub2-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "70c48faf201e7b9061e89184e1d78953dc7518d81d9e95a71ed028a3a6a319ae",
          "text": "Ze heeft een hele persoonlijkheid. Wat een mooie sterveling. Jongens zijn betoverd door haar.",
          "source_text": "She's got this whole personality. What a beautiful mortal. Guys are enchanted by her.",
          "transcription_review_required": false
        },
        "sub2-21": {
          "path": "res://assets/languages/nl/audio/sub2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4af00a77137c6186727e267438509ddf630a9081fa64a8e7fc2b80bc9d775503",
          "text": "Mij? Ik wens. Maar ik denk niet dat de Alice-dates van die man met mij uit zouden willen gaan.",
          "source_text": "Me? I wish. But I don't think the guy's Alice dates would want to go out with me.",
          "transcription_review_required": false
        },
        "sub2-22": {
          "path": "res://assets/languages/nl/audio/sub2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7974e33bae0ba23a0da4c3f3cb917d3f9d4430d9bcc4bd86165fd463eaf07c96",
          "text": "Geannuleerd? Weet je het zeker? Ik mag toch niets weten over deze bijeenkomst?",
          "source_text": "Cancelled? Are you sure? I'm not supposed to know anything about this meeting, am I?",
          "transcription_review_required": false
        },
        "sub2-30a": {
          "path": "res://assets/languages/nl/audio/sub2-30a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "656d89ff92f450579ec7fcb73b9ab01efd960465393bc4a53734215675b49a98",
          "text": "En neemt je mee naar je plek aan de rivier.",
          "source_text": "And takes you down to your place by the river.",
          "transcription_review_required": false
        },
        "sub2-30b": {
          "path": "res://assets/languages/nl/audio/sub2-30b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1fd12af508465b17177eb5c6822caab916392eef18f10fc94b325c6766ace906",
          "text": "Het is Susan, van Leonard Cohen.",
          "source_text": "It's Susan, by Leonard Cohen.",
          "transcription_review_required": false
        },
        "sub2-40": {
          "path": "res://assets/languages/nl/audio/sub2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "055c993038c1e9c6961bbccb6b3f1f2bff9f263e7857fed99343d2c69a5a7908",
          "text": "Een bandje? Ik ben niet echt het type. Ik heb de neiging om dingen te verpesten. Als ik het podium zou betreden, zou het waarschijnlijk instorten. Deze week heb ik hier drie camera's kapot gemaakt.",
          "source_text": "A band? I'm not really the type. I tend to ruin things. If I got up on the stage, it would probably cave in. Just this week, I broke three cameras here.",
          "transcription_review_required": false
        },
        "sub2-40m": {
          "path": "res://assets/languages/nl/audio/sub2-40m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dc8532b96ef599ed604af437b1a99dc7a042eb9dcbf35d2707579f20f1382df9",
          "text": "Ruby, is dit echt maar voor Ã©Ã©n keer? Dus ik kan het echt niet vernietigen!",
          "source_text": "Ruby, is this really just for one time only? So I really can't destroy it!",
          "transcription_review_required": false
        },
        "sub2-s2": {
          "path": "res://assets/languages/nl/audio/sub2-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "51b4227067a12697ff61bcb54776b510bc8578e789722bd2212e04d8d539b39b",
          "text": "Het is maar goed dat ik het briefje heb verscheurd.",
          "source_text": "It's a good thing I tore up the note.",
          "transcription_review_required": false
        },
        "sub2-s3": {
          "path": "res://assets/languages/nl/audio/sub2-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bf63eaed2a1a6a0319d788b08af0e7f3835b71b492b9d935e445e0ccb13e293a",
          "text": "Wauw! Ze kon het briefje van het notitieblok reproduceren.",
          "source_text": "Wow! She was able to reproduce the note from the pad.",
          "transcription_review_required": false
        },
        "sul-01": {
          "path": "res://assets/languages/nl/audio/sul-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "53bb8ed5e8ad51df4b08cd296c6700422cbf9d1fe95bc808911c08f1ba121c1c",
          "text": "Denk je dat ik het ben? Oh mijn god, waarom?",
          "source_text": "You think it's me? Oh my gosh, why?",
          "transcription_review_required": false
        },
        "sul-02": {
          "path": "res://assets/languages/nl/audio/sul-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dc0be75c6b34d195aa16d3e3ce0a207945fd6c25df817aa324b52ba3904976e5",
          "text": "Maar waarom zou ik een briefje aan mezelf schrijven?",
          "source_text": "But why would I write a note to myself?",
          "transcription_review_required": false
        },
        "sul-03": {
          "path": "res://assets/languages/nl/audio/sul-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d86d4147f70af939d247239d43fedd70fed659469a21014428962a8644efa912",
          "text": "Dit heeft niets met mij te maken.",
          "source_text": "This has nothing to do with me.",
          "transcription_review_required": false
        },
        "sul-04": {
          "path": "res://assets/languages/nl/audio/sul-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b96f9c9575949a22be663d3a506943e70e8c6de1b033f285f7ce9ddc81154965",
          "text": "Dat bewijst niet dat ik het ben!",
          "source_text": "That doesn't prove it's me!",
          "transcription_review_required": false
        },
        "sul-05": {
          "path": "res://assets/languages/nl/audio/sul-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ffea23c8391d5f9e21daaad4fe4abdcbc9a8da75ef562dfea15612381f678dbb",
          "text": "Alice is zo getalenteerd. Ik wou dat ik net zoals zij kon zijn.",
          "source_text": "Alice is so talented. I wish I could be just like her.",
          "transcription_review_required": false
        },
        "sul-06": {
          "path": "res://assets/languages/nl/audio/sul-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d6008c04795576e819a26ac7b4bd6b7c1f023ebd222458b1616a66e7f303523c",
          "text": "Er bestaat een wet tegen het schrijven van brieven aan oude vrienden.",
          "source_text": "Law against writing letters to old friends is there.",
          "transcription_review_required": false
        },
        "sul-07": {
          "path": "res://assets/languages/nl/audio/sul-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8d25f999cd5f6be0cb7cfa169ec126e0fb406511f549221f116a1a45c9f9049d",
          "text": "Het is de volgende keer dat je onschuldige mensen beschuldigt. Sommigen van ons zijn erg gevoelig, en zoiets als dit kan ons jarenlang achtervolgen.",
          "source_text": "It's next there that you go around accusing innocent people. Some of us are very sensitive, and something like this could haunt us for years.",
          "transcription_review_required": false
        },
        "sula-01": {
          "path": "res://assets/languages/nl/audio/sula-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c9d9b273a9d0a71e2db815cdf06a0eb54040f19b2533827a3e7f5eb30193752c",
          "text": "Dorothy, ik kan niet geloven dat ze zoiets zou doen! Ik denk dat het leven in een grote stad ook zijn tol van haar heeft geÃ«ist.",
          "source_text": "Dorothy, I can't believe she'd do a thing like that! I guess living in a big city has taken its toll on her, too.",
          "transcription_review_required": false
        },
        "sulb-01": {
          "path": "res://assets/languages/nl/audio/sulb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d3c262477c8f1c06b2a4b68747cfb5c328e28603287381828c80b78e8a1215d5",
          "text": "Ik kan niet geloven dat het Rik is. Hij is zo'n zachtaardige ziel. Ik weet zeker dat hij het uit liefde deed. Ik zou willen dat iemand zo van mij zou houden.",
          "source_text": "I can't believe it's Rick. He's such a gentle soul. I'm sure he did it out of love. I wish someone would love me like that.",
          "transcription_review_required": false
        },
        "dyab-01": {
          "path": "res://assets/languages/nl/audio/dyab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f3ead8803ad3e4027978c1e397ef97ffffae25c4332273ff70576b9ba2832aa9",
          "text": "Niet veel. Ik weet dat ze niet van politieke betrokkenheid houdt. Ze laat me nooit een van mijn posters aan haar deur hangen.",
          "source_text": "Not much. I know she doesn't dig political involvement. She never lets me hang any of my posters on her door.",
          "transcription_review_required": false
        },
        "dyab-02": {
          "path": "res://assets/languages/nl/audio/dyab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e7b9b8a89ac90a97893d837d77f90e25bea629a8304a3d3d93aec218a85fcba",
          "text": "Een vriendin van mij heeft ooit met haar gedate. Alles was cool, man, totdat ze begon met al dat gedoe over het huwelijk en een huis met een wit houten hek.",
          "source_text": "A friend of mine dated her once. Everything was cool, man, until she started all this stuff about marriage and a house with a white picket fence.",
          "transcription_review_required": false
        },
        "dyab-03": {
          "path": "res://assets/languages/nl/audio/dyab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "939a6e54ff2ae175dcba0afc26444f60ef0b25ab05f32c7c7cf4a840f77334c5",
          "text": "Ik weet het niet, want hij komt nooit uit het laboratorium.",
          "source_text": "Him, I don't know, like, cause he never comes out of the lab.",
          "transcription_review_required": false
        },
        "dyab1-01": {
          "path": "res://assets/languages/nl/audio/dyab1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d594daac8357617f195c7d50bdab14ce71e26d3064d4a3048b0b0af444b8f920",
          "text": "VS uit Vietnam. VS uit Vietnam.",
          "source_text": "U.S. out of Vietnam. U.S. out of Vietnam.",
          "transcription_review_required": false
        },
        "dyab1-02": {
          "path": "res://assets/languages/nl/audio/dyab1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0b2f43ee9ba357fdbb9e4194a61a295bab4aad34f44f295c81cfc27e38f9e4ae",
          "text": "HÃ©, mooie sterfelijke vrouw. Liefde en vrede voor jou. Hier, neem een â€‹â€‹papiertje.",
          "source_text": "Hey, beautiful mortal woman. Love and peace to you. Here, have a paper.",
          "transcription_review_required": false
        },
        "dyab1-03": {
          "path": "res://assets/languages/nl/audio/dyab1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b8732a6d7bfa99ff9a7833f60b261e002339ffe9d945c48d0c81c2a3b4b26aea",
          "text": "Jimmy, de man zelf natuurlijk, man, wie niet. Als een echte idealist, een echte rebel.",
          "source_text": "Jimmy, the man himself, of course, man, who doesn't. Like a true idealist, a true rebel.",
          "transcription_review_required": false
        },
        "dyab1-04": {
          "path": "res://assets/languages/nl/audio/dyab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af77e47ea251c3c2ceb12e4e87c0342a19e73f0ded9b80003d6aefa8e384b64a",
          "text": "Alice, de brunette. Ja, ze is een typische Weegschaal. Ze strijdt voor gerechtigheid en gelijkheid. Zeer positieve sfeer, man.",
          "source_text": "Alice, the brunette. Yeah, she's a typical Libra. She fights for justice and equality. Very positive vibes, man.",
          "transcription_review_required": false
        },
        "dyab1-05": {
          "path": "res://assets/languages/nl/audio/dyab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fc02cd3752553944f3476ff229981bffedc487f4971ffd10fa8d03e5442fb78a",
          "text": "Ik help graag. Je bent net een wandelende regenboog, man.",
          "source_text": "Glad to help. You're like a walking rainbow, man.",
          "transcription_review_required": false
        },
        "dyab2-01": {
          "path": "res://assets/languages/nl/audio/dyab2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05bfc25ff256aeebaea9c136ed1fd0c3a39a1f0d3cff0fde439062ece488fa19",
          "text": "HÃ©, jij weer. Er moet hier wat kosmische energie tussen ons gebeuren, ja. Ik dacht net dat ik je iets te vertellen heb.",
          "source_text": "Hey, you again. There must be some cosmic energy happening between us here, yeah. I was just thinking I've got something to tell you.",
          "transcription_review_required": false
        },
        "dyab2-01a": {
          "path": "res://assets/languages/nl/audio/dyab2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ae796fb529388974bf68ef3ddcf59c5dea676f8e77e8f12f36548d449251749d",
          "text": "Alice zoekt je overal.",
          "source_text": "Alice is looking for you everywhere.",
          "transcription_review_required": false
        },
        "dyab2-03": {
          "path": "res://assets/languages/nl/audio/dyab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e01568b4eadbd6209427fac3da11588733c4d41d4fb2e5d9b4906637724edaf2",
          "text": "Zeker.",
          "source_text": "Definitely.",
          "transcription_review_required": false
        },
        "dyab3-01": {
          "path": "res://assets/languages/nl/audio/dyab3-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "75939616993332d3a3564af137628884e28951eea5984cb43076e6365b41ecf8",
          "text": "HÃ©, jij blijft maar uit de lucht vallen, waar ik ook ben. Misschien waren we in een vorig leven verenigd in Ã©Ã©n ziel.",
          "source_text": "Hey, you just keep falling out of the sky wherever I am. Maybe in a past life, we were like united in one soul.",
          "transcription_review_required": false
        },
        "jdyab-01": {
          "path": "res://assets/languages/nl/audio/jdyab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8ab84b8681bda59e54fe56a3d3a4346b922eecfbd59472f923ff246cdbe2abf1",
          "text": "Weet jij iets over het meisje uit de fotowinkel?",
          "source_text": "Do you know anything about the girl from the photo store?",
          "transcription_review_required": false
        },
        "jdyab-02": {
          "path": "res://assets/languages/nl/audio/jdyab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b9debafc84b32cffeb8eb7e7726b53873208be73c26af908704cee2aa7080723",
          "text": "Ken jij Dorothy, de vriendin van Alice?",
          "source_text": "Do you know Dorothy, Alice's friend?",
          "transcription_review_required": false
        },
        "jdyab-03": {
          "path": "res://assets/languages/nl/audio/jdyab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "04f3b9e61ff7219ab6193f77fcc1bf83810141acb8843e5e537a4244f1fa015d",
          "text": "Ken jij Larry Chang van het lab?",
          "source_text": "Do you know Larry Chang from the lab?",
          "transcription_review_required": false
        },
        "jdyab1-03": {
          "path": "res://assets/languages/nl/audio/jdyab1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c897358feb76c76c17c2189da48900f26774343fdf4c6aa7f5109e114f964cee",
          "text": "Kent u Jimmy Mackenzie, de verslaggever?",
          "source_text": "Do you know Jimmy Mackenzie, the reporter?",
          "transcription_review_required": false
        },
        "jdyab1-04": {
          "path": "res://assets/languages/nl/audio/jdyab1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4855b5f53f5e89bd0112199664a92d151f453e2a17d0e665e096acd6da5822bc",
          "text": "Ken jij Alice Kaplan?",
          "source_text": "Do you know Alice Kaplan?",
          "transcription_review_required": false
        },
        "jdyab1-05": {
          "path": "res://assets/languages/nl/audio/jdyab1-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "089215a8cdb1e7f7bc605b9f27de358b18ffa68057dae9fb9fb83cbcd0b47832",
          "text": "Bedankt!",
          "source_text": "Thanks!",
          "transcription_review_required": false
        },
        "jdyab2-03": {
          "path": "res://assets/languages/nl/audio/jdyab2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f2b1899eefe98cee4e329e95098437b0a7508dd7c94b60f06a25c7af2770615f",
          "text": "Tot snel!",
          "source_text": "See you soon!",
          "transcription_review_required": false
        },
        "dya2-01": {
          "path": "res://assets/languages/nl/audio/dya2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9acd15e89f61ea6bef27ae93f13ab3f463b02eea821f00fbe266c196b9ff1f3d",
          "text": "Ik heb iets voor je.",
          "source_text": "I've got something for you.",
          "transcription_review_required": false
        },
        "dya2-02": {
          "path": "res://assets/languages/nl/audio/dya2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3fbdb905e467bf0f45a6db6d2d7b1d5b067b07aadc03f6b993c701bc8eea7b83",
          "text": "Het hele veld lijkt meer op wat ik je wilde geven, maar het paste niet in mijn busje.",
          "source_text": "The whole field is more like what I wanted to give you, but it didn't fit in my van.",
          "transcription_review_required": false
        },
        "dyab3-03": {
          "path": "res://assets/languages/nl/audio/dyab3-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "12ef938f409c7c43be965665363e8abc3068b8cffc866f63dcc8b3d7c6edf8e2",
          "text": "Sla linksaf bij de graffitimuur en ga dan gewoon rechtdoor.",
          "source_text": "Turn left at the graffiti wall and then just go straight.",
          "transcription_review_required": false
        },
        "dyab3-04": {
          "path": "res://assets/languages/nl/audio/dyab3-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "40c815082b92b8a89fbf8d98385197a0e95d96b75fa63a7ecd8acd995e20b9ce",
          "text": "Luister, sommigen van ons gaan naar het bos om zich te verenigen met Moeder Natuur. We zijn als knuffels van bomen en mediteren. Het wordt hip. Wil je met ons meedoen?",
          "source_text": "Listen, some of us are going to the forest to unite with Mother Nature. We're like hugs from trees and meditate. It's gonna be groovy. Wanna join us?",
          "transcription_review_required": false
        },
        "jdyab3-03": {
          "path": "res://assets/languages/nl/audio/jdyab3-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "972b267dad3fca15da18e779e61fd1039004d4fb3ac7979ee3bcf724cf6e9522",
          "text": "Kunt u mij vertellen hoe ik het Paleis voor Schone Kunsten kan bereiken?",
          "source_text": "Can you tell me how to get to the Palace of Fine Arts?",
          "transcription_review_required": false
        },
        "dya2-10": {
          "path": "res://assets/languages/nl/audio/dya2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cb1922b78b2fed35bfdcdbcc2a2a7aefce0711f1ee2d954b2f14196556458364",
          "text": "Ik waardeer jouw stijl. Jij bent een van die hipchicks. Je moet een Boogschutter zijn, een vrije geest met visie. Heb ik gelijk of zo?",
          "source_text": "I dig your style. You're one of those hipchicks. You must be a Sagittarian, a free spirit with vision. Am I right or what?",
          "transcription_review_required": false
        },
        "dya2-10a": {
          "path": "res://assets/languages/nl/audio/dya2-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c82d9b8f0d8f07c85463bcaf0104b387f82bb18b449907b2492c300d00e156b1",
          "text": "Ik houd van jouw stijl, jij bent een van die hippe meiden.",
          "source_text": "I dig your style, you're one of those hip chicks.",
          "transcription_review_required": false
        },
        "dya2-11": {
          "path": "res://assets/languages/nl/audio/dya2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3e4f9999068aa7a1598cbb2a360ab62767a76e6d81503ea7ae461b5086588ba1",
          "text": "Ja, zeker. Ik denk het wel. Nou, weet je, heel veel mensen hebben ze. Misschien weet Cheyennell het.",
          "source_text": "Yeah, sure. I think so. Well, you know, tons of people have them. Maybe Cheyennell know.",
          "transcription_review_required": false
        },
        "dya2-12": {
          "path": "res://assets/languages/nl/audio/dya2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3ab40dca9bb0c77beab5b75e93bab909542b742068b15b1a7c144701ec2b8b17",
          "text": "HÃ©, Regenboog. Ik denk erover om een â€‹â€‹ontmoetingsplaats voor harmonie te hebben. Een spirituele suahre vanavond. Kun je komen?",
          "source_text": "Hey, Rainbow. I'm thinking about having a hangout for harmony. A spiritual suahre tonight. Can you come?",
          "transcription_review_required": false
        },
        "dyab-04": {
          "path": "res://assets/languages/nl/audio/dyab-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3ff16427dd44fcad3c20d665957578079bbc5db2201ca138927b30c76ca04143",
          "text": "Een vriend van mij heeft haar een keer ontmoet, hij kreeg de hele avond geen kans om zijn mond open te doen. Het enige waar ze in geÃ¯nteresseerd is, is een primeur. Dus uiteindelijk hadden ze een ijsje.",
          "source_text": "A friend of mine met her once, he didn't get a chance to open his mouth the whole evening. All she's interested in is a scoop. So, in the end, they had an ice cream.",
          "transcription_review_required": false
        },
        "dyab-05": {
          "path": "res://assets/languages/nl/audio/dyab-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b5f7772c22a7bdc387e7dad3e16dba268171d3b90757f53cb8eda9dde5b9fc31",
          "text": "Wat een materieel meisje. Een vriend van mij kwam haar ophalen in zijn VW-busje. Was niet goed genoeg voor haar. Ze rijdt alleen in Cadillacs.",
          "source_text": "What a material girl. A friend of mine came to pick her up in his VW van. Wasn't good enough for her. She only rides in Cadillacs.",
          "transcription_review_required": false
        },
        "dyab-06": {
          "path": "res://assets/languages/nl/audio/dyab-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "356a10a829e7bd2e87ee871b13446b8a1e79cf3d27a90928dec6c2be78718431",
          "text": "Ja, een behoorlijk spiritueel mens, goed verbonden met zijn innerlijke zelf, een echte zachte kerel.",
          "source_text": "Yeah, quite a spiritual human being, well connected with his inner self, a real mellow fellow.",
          "transcription_review_required": false
        },
        "jdya2-11": {
          "path": "res://assets/languages/nl/audio/jdya2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "40bb2aae26fb20e2698489ceb5ef5233aedb72243cf856443e46bf9f345db4ff",
          "text": "Kent u iemand met een roze verenjas?",
          "source_text": "Do you know anyone who has a pink feather coat?",
          "transcription_review_required": false
        },
        "jdyab-04": {
          "path": "res://assets/languages/nl/audio/jdyab-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0df1ea8789fdc03392f8a4066b14b5a2a77c411d0e49cec27d5b4972a757aa19",
          "text": "Kent u de verslaggever van The Guardian?",
          "source_text": "Do you know the reporter from The Guardian?",
          "transcription_review_required": false
        },
        "jdyab-05": {
          "path": "res://assets/languages/nl/audio/jdyab-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8ca923c34b22cc7a3a9fe8c496e530636ccd942273f62d755df459a1652b85bd",
          "text": "Ken jij Sheila van de kledingwinkel?",
          "source_text": "Do you know Sheila from the clothing store?",
          "transcription_review_required": false
        },
        "jdyab-06": {
          "path": "res://assets/languages/nl/audio/jdyab-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0c699f3d4d76d30f4af4b49e2d7ce4136f7f0fdf5dfcc27669bcfe4d848ca752",
          "text": "Ken jij Rick van de platenwinkel?",
          "source_text": "Do you know Rick from the record store?",
          "transcription_review_required": false
        },
        "jmeab-02": {
          "path": "res://assets/languages/nl/audio/jmeab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "89a4ea6ac51c51efb50ce353a1927074847736819766c6b9f7d9eb73b115d496",
          "text": "Bedankt dat je me hier hebt geland!",
          "source_text": "Thanks for landing me here!",
          "transcription_review_required": false
        },
        "jmeab-10": {
          "path": "res://assets/languages/nl/audio/jmeab-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07a6700ea1a469fd390a096bcf586878db68234548721c2e4f418d58db8de71b",
          "text": "1967, hoe gebeurde dat?",
          "source_text": "1967, how did that happen?",
          "transcription_review_required": false
        },
        "jmeab-20": {
          "path": "res://assets/languages/nl/audio/jmeab-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f79469b4dce492885bed59627b265c887ef626315979adb27ef31cc4260d5d42",
          "text": "Wat doe ik hier?",
          "source_text": "What am I doing here?",
          "transcription_review_required": false
        },
        "jmeab-21": {
          "path": "res://assets/languages/nl/audio/jmeab-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ac728a4ef76c4a42500d353ed0c99cc618ceff5723310bc8d791dbeaf6b5d305",
          "text": "Dit moet mijn straf zijn omdat ik te vaak naar de toekomst heb gekeken. Wat moet ik nu doen?",
          "source_text": "This must be my punishment for watching back to the future too many times. So, what should I do now?",
          "transcription_review_required": false
        },
        "meab-01": {
          "path": "res://assets/languages/nl/audio/meab-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a98362e0a4111b1787ff49391da334c469e605749a6b02574a937ee5ac6c1f72",
          "text": "Welkom tijd, reiziger. Je bent zojuist in de Rockin' Sixties beland. De lokale tijd is hier 10.00 uur, het jaar 1967, locatie San Francisco. Het is de zomer van de liefde.",
          "source_text": "Welcome time, traveler. You've just landed in the Rockin' Sixties. The local time here is 10 a.m., the year 1967, location San Francisco. It's the summer of love.",
          "transcription_review_required": false
        },
        "meab-02": {
          "path": "res://assets/languages/nl/audio/meab-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8cbdc0e01048efa8d453af4fd0fdfba42f3e2ef5b052edec3308b5b0f5bd26c9",
          "text": "Bedenk dat je ervoor kunt kiezen om eerst je vader of je moeder te vinden, maar elk pad dat je besluit te bewandelen zal je naar een ander verhaal leiden.",
          "source_text": "Remember, you can choose to find either your father first or your mother, but each path you decide to take will lead you to a different story.",
          "transcription_review_required": false
        },
        "meab-03": {
          "path": "res://assets/languages/nl/audio/meab-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "bbd1d3e441ac7927f8bcd462cc2d067eabc9ce37cc4886106613ad4cd6766f0d",
          "text": "Wauw, ik ben jaloers op je. 1967, San Francisco? Zo cool. De winkels, de kleding? Je hoeft alleen maar naar binnen te gaan en ze te bekijken.",
          "source_text": "Wow, I envy you. 1967, San Francisco? So cool. The shops, the clothes? You just have to go in and check them out.",
          "transcription_review_required": false
        },
        "meab-10": {
          "path": "res://assets/languages/nl/audio/meab-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e8a48650cac432b8750fdf18072ca499a03cbc8588804d9eff7c5a53187e3c55",
          "text": "Oh, ik wilde je terugsturen naar vanmorgen, niet naar 1967.",
          "source_text": "Uh-oh, I meant to send you back to this morning, not to 1967.",
          "transcription_review_required": false
        },
        "meab-20": {
          "path": "res://assets/languages/nl/audio/meab-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dce35da9a7db9f713d6c428716d4cdbe58638e73f184b724ad05506b7f5da354",
          "text": "Oeps, er is iets veranderd in de geschiedenis. Je ouders zouden elkaar vanavond ontmoeten, maar dat gaat niet gebeuren. Vertaling? Dat gaat je niet gebeuren. Je moet ervoor zorgen dat ze elkaar ontmoeten.",
          "source_text": "Oops, something in history has changed. Your parents were supposed to meet tonight, but it's not gonna happen. Translation? You're not going to happen. You have to make them meet.",
          "transcription_review_required": false
        },
        "meab-21": {
          "path": "res://assets/languages/nl/audio/meab-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "49d1e6cc3786f4eedf5953eeac7b7289f2f0c3cfa906164bd098a4fabfd8d1b1",
