        "shyan28": {
          "path": "res://assets/languages/de/audio/shyan28.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e53db7300801959f5675da5fc1288e93b4beaadb419aec96a0e9c6d9384e7f04",
