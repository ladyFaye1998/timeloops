          "sha256": "25ba24e283a2567210cf3c24dc1a36c90ba6aeb162da462dd80cb8a979a751ea",
          "text": "Das beweist nicht, dass es nicht meins ist.",
          "source_text": "That doesn't prove it's not mine.",
          "transcription_review_required": false
        },
        "jia3b-s2": {
          "path": "res://assets/languages/de/audio/jia3b-s2.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f6c1eb84c6dc17a263bd14efb9e2033797af8eb4c67ae8238fca948d0c114e0f",
          "text": "Geniale Idee, Dorothy die Uhr zu geben, um zu beweisen, dass sie nicht ihre ist. Ihre braune Linie zeigt, dass sie eine Uhr mit einem breiteren Armband trÃ¤gt.",
          "source_text": "Brilliant idea to give Dorothy the watch to prove that it's not hers. Her tan line shows that she has a watch with a wider strap.",
          "transcription_review_required": false
        },
        "mel19": {
          "path": "res://assets/languages/de/audio/mel19.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "204ea1bd622344ac807e3f55fc9989d7f9a2d2876cb728f6cd70d2cc3ae67595",
          "text": "Dorothy will Alices Uhr? Nun, beweisen Sie damit, dass es nicht ihr gehÃ¶rt.",
          "source_text": "Dorothy wants Alice's watch? Well, use it to prove that it doesn't belong to her.",
          "transcription_review_required": false
        },
        "mel20": {
          "path": "res://assets/languages/de/audio/mel20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5eb70436412900d5a51256a510b7ffbf19e009bd9a10a5700216ae5b993a0ada",
          "text": "Anstatt zu beweisen, dass die Uhr Alice gehÃ¶rt, wÃ¤re es einfacher zu beweisen, dass die Uhr nicht Dorothy gehÃ¶rt.",
          "source_text": "Instead of proving that the watch belongs to Alice, it would be easier to prove that the watch doesn't belong to Dorothy.",
          "transcription_review_required": false
        },
        "al-m": {
          "path": "res://assets/languages/de/audio/al-m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "67823014052c907b042195279fa220468f8d4ee45c847720e6d1fc255adb11d4",
          "text": "Gib mir eine Pause.",
          "source_text": "Give me a break.",
          "transcription_review_required": false
        },
        "ala1-01": {
          "path": "res://assets/languages/de/audio/ala1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "aa075f41592fa94b260225466549d419da82fe63f3052e47bbb728e93783e650",
          "text": "Das ist total psychedelisch. Mein Film Ã¼ber Philip's Chemicals ist verschwunden.",
          "source_text": "This is totally psychedelic. My film on Philip's Chemicals has disappeared.",
          "transcription_review_required": false
        },
        "ala1-02": {
          "path": "res://assets/languages/de/audio/ala1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05d9a33df86e39f1bff68746a700977adaa240c084d596f8f6674d67d646ed1c",
          "text": "Ohne diesen Film bin ich ruiniert.",
          "source_text": "I'm ruined without that film.",
          "transcription_review_required": false
        },
        "ala1-03": {
          "path": "res://assets/languages/de/audio/ala1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fe609139746d455f497c1a76bc853bdb23b2bdaebe17fbb26e108a3377edafb6",
          "text": "Das wÃ¤re groÃŸartig.",
          "source_text": "That would be great.",
          "transcription_review_required": false
        },
        "ala1-10": {
          "path": "res://assets/languages/de/audio/ala1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "52df67204211321d1dfe8b7145c68ba5ee6edba62cd6bee3c64560322924c205",
          "text": "Der Film, der die Verwendung von DDT durch Philips Chemikalien aufdeckt. Es zerstÃ¶rt unsere Umwelt.",
          "source_text": "The film that exposes the use of DDT by Philip's chemicals. It's killing our environment.",
          "transcription_review_required": false
        },
        "ala1-11a": {
          "path": "res://assets/languages/de/audio/ala1-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "56b85a0694309a254ae0a0c3c271b6da9765a9971f2a12de0ee05c42c9c4ab82",
          "text": "Bis gestern war es im Labor. Vielleicht habe ich es im BekleidungsgeschÃ¤ft gelassen. Warten Sie eine Minute. Vielleicht ist es noch in meiner Tasche.",
          "source_text": "Till yesterday it was in the lab. Maybe I left it in the clothing store. Wait a minute. Maybe it's still in my bag.",
          "transcription_review_required": false
        },
        "ala1-11b": {
          "path": "res://assets/languages/de/audio/ala1-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5988db2a3637d84b17499777b43caf8c363524cc34f6ef7e3c4d33516b979ccf",
          "text": "Hmm, was ist das?",
          "source_text": "Hmm, what's this?",
          "transcription_review_required": false
        },
        "ala1-11c": {
          "path": "res://assets/languages/de/audio/ala1-11c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af8cff5b480cbe494feb2e060278319e57755fb467858dcc644fcdf2e4b40d28",
          "text": "Bis gestern war es im Labor. Vielleicht habe ich es im BekleidungsgeschÃ¤ft gelassen.",
          "source_text": "Till yesterday it was in the lab. Maybe I left it in the clothing store.",
          "transcription_review_required": false
        },
        "ala1-12a": {
          "path": "res://assets/languages/de/audio/ala1-12a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "efdf8d5476914c331f34f9befd359667c243b188d5ac0fc0aaaa91e793b7c9da",
          "text": "Ich glaube es nicht. Dies ist eine friedliche und liebevolle Gemeinschaft.",
          "source_text": "I don't believe it. This is a peaceful and loving community.",
          "transcription_review_required": false
        },
        "ala1-12b": {
          "path": "res://assets/languages/de/audio/ala1-12b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "15d8ccbb6b02f02ad2f1c5c0246b35ae72f8c65ca8626026074136fe3808cc4a",
          "text": "Du denkst?",
          "source_text": "You think?",
          "transcription_review_required": false
        },
        "ala1-12c": {
          "path": "res://assets/languages/de/audio/ala1-12c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "07db17b6d42c084931f99c1c11dd711787a057156a4bcb8a5b55bec48d94aafb",
          "text": "Vielleicht hat es jemand von Philip's Chemicals genommen?",
          "source_text": "Maybe someone from Philip's Chemicals took it?",
          "transcription_review_required": false
        },
        "ala1-20": {
          "path": "res://assets/languages/de/audio/ala1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8e33b86c7c3e90aaf0d5834aba7f533d7af686b89529f121649e4f7ac21f3982",
          "text": "Ohne den Film kann ich nicht zu meinem Treffen mit Jimmy Mackenzie gehen.",
          "source_text": "Without the film, I can't go to my meeting with Jimmy Mackenzie.",
          "transcription_review_required": false
        },
        "ala1-21a": {
          "path": "res://assets/languages/de/audio/ala1-21a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a4570edb39f74500d82612bf8e2f3c1e91fa7dcd53c525de7b37aed305ff22a4",
          "text": "Papa, wer ist Papa?",
          "source_text": "Dad, who's Dad?",
          "transcription_review_required": false
        },
        "ala1-21b": {
          "path": "res://assets/languages/de/audio/ala1-21b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7f13adc4edce86c3ad9cbd2462ce36edd89b70909f6041aa2ecdfaf23c051617",
          "text": "Nein, Jimmy Mackenzie. Er braucht den Film fÃ¼r einen Artikel, den er Ã¼ber diesen DDT-Skandal schreiben wird.",
          "source_text": "No, Jimmy Mackenzie. He needs the film for an article he's gonna write about this DDT scandal.",
          "transcription_review_required": false
        },
        "ala1-22": {
          "path": "res://assets/languages/de/audio/ala1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b2344d24cae8d9dba4beac206670e4f5e46cd71979529b0d25768e666e7952a",
          "text": "Warum sollte ich ihn treffen? Ich mÃ¶chte die Umwelt schÃ¼tzen und keinen Freund finden.",
          "source_text": "Why should I meet him? I want to protect the environment, not find a boyfriend.",
          "transcription_review_required": false
        },
        "ala2-01": {
          "path": "res://assets/languages/de/audio/ala2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "dbb1a6469cfb8a42735ac042beee2180ea6f040fd6579dd284e786bc7b84151b",
          "text": "Mann, es ist gut, dass du vorbeigekommen bist. Hast du herausgefunden, wer den Film gestohlen hat?",
          "source_text": "Man, it's a good thing you dropped in. Did you find out who stole the film?",
          "transcription_review_required": false
        },
        "ala2-01a": {
          "path": "res://assets/languages/de/audio/ala2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "66f9ade46cc4ef4639596f75db86d93ce68a9f39b24ceb9efbc09e29ca1c926f",
          "text": "Haben Sie eine Ahnung, wer den Film aufgenommen haben kÃ¶nnte?",
          "source_text": "Do you have any clue who might have taken the film?",
          "transcription_review_required": false
        },
        "ala2-01h": {
          "path": "res://assets/languages/de/audio/ala2-01h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d02fad0becc841aff62d06a51beb1c3b29e9d281d35c8be2cb1c7ba4e7d990d4",
          "text": "Veronica, ich kenne niemanden mit diesem Namen, aber vielleicht ist sie diejenige, die hinter dem Verschwinden meines Kleides steckt.",
          "source_text": "Veronica, I don't know anyone by that name, but maybe she's the one behind the disappearance of my dress.",
          "transcription_review_required": false
        },
        "ala2-03": {
          "path": "res://assets/languages/de/audio/ala2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "615f77addc7b1a71b8e9ba480b7306b41580346fa7c2911a651a0f9772b6cf37",
          "text": "Cool, du bist ein Lebensretter.",
          "source_text": "Cool, you're a lifesaver.",
          "transcription_review_required": false
        },
        "ala2-04": {
          "path": "res://assets/languages/de/audio/ala2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "88725024794f3d6d379b66b44ff6ce6c4fb257ee78ba3b7f2ce0b3aa288d1e70",
          "text": "Ich kann nicht verstehen, wie mein Kleid einfach verschwunden ist.",
          "source_text": "I can't understand how my dress just vanished.",
          "transcription_review_required": false
        },
        "ala2-10": {
          "path": "res://assets/languages/de/audio/ala2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "00538c09f62d690e05b66687136872a0bdbeae4a5415c951cda037facea6aa58",
          "text": "Mein wunderschÃ¶nes Perlenkleid! Jimmy Mackenzie wÃ¼rde mich daran erkennen.",
          "source_text": "My beautiful beaded dress! Jimmy Mackenzie was going to recognize me by it.",
          "transcription_review_required": false
        },
        "ala2-11": {
          "path": "res://assets/languages/de/audio/ala2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c8e140f1e9c41e8b3c3d6eb7369e02686398609ea8e21d5172c42763ec53b546",
          "text": "Hey, hast du mit meiner Mutter gesprochen? Du klingst genau wie sie.",
          "source_text": "Hey, have you been talking to my mother? You sound just like her.",
          "transcription_review_required": false
        },
        "ala2-11m": {
          "path": "res://assets/languages/de/audio/ala2-11m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ebb8aef42ca732ab73eda00f6c527dc3c052d562fb185f44d5f1f5bbe1b0e795",
          "text": "Du hast einen guten Geschmack. Solche ArmbÃ¤nder habe ich mir schon lange gewÃ¼nscht.",
          "source_text": "You've got good taste. I've wanted bracelets like these for a long time.",
          "transcription_review_required": false
        },
        "ala2-12": {
          "path": "res://assets/languages/de/audio/ala2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d10369cb9b01dcf87880a18d899d7704fbc24da11753d706d7bed391be868270",
          "text": "Nun, Sie erkennen mich vielleicht an der Tasche, der Uhr und einem halben Foto, aber ohne mein wunderschÃ¶nes Perlenkleid wÃ¤re es nicht dasselbe.",
          "source_text": "Well, you may recognize me by the bag, the watch, and half a photo, but it won't be the same without my beautiful beaded dress.",
          "transcription_review_required": false
        },
        "ala2-20": {
          "path": "res://assets/languages/de/audio/ala2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "11c6d63442c72a29d94d6a15e9c3e03adf47aa34fa2ae36d0007e9383020279a",
          "text": "In Sheilas Boutique. Ich habe es dort gelassen, um es zu kÃ¼rzen. Als ich zurÃ¼ckkam, um es abzuholen, war es verschwunden.",
          "source_text": "At Sheila's boutique. I left it there to be shortened. When I went back to pick it up, it had disappeared.",
          "transcription_review_required": false
        },
        "ala2-30": {
          "path": "res://assets/languages/de/audio/ala2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1735234e6fe89dbfe4d1b9d22bc78cd4d818cfb86bdf70ddd7747e1a1852e7fb",
          "text": "Du denkst vielleicht, ich bin paranoid, aber ich glaube, jemand tut wirklich alles, um sicherzustellen, dass mein Treffen mit Mackenzie nicht zustande kommt.",
          "source_text": "You may think I'm paranoid, but I think someone is really going out of their way to make sure that my meeting with Mackenzie doesn't happen.",
          "transcription_review_required": false
        },
        "ala2-31": {
          "path": "res://assets/languages/de/audio/ala2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6933eaa52d825f0ac5159a134d1f27eb6eca24b0952ac1330370927fd4b7a4ff",
          "text": "Ich weiÃŸ nicht. Vielleicht hat diese Person vor, mein Kleid zu benutzen und so zu tun, als wÃ¤re ich ich. Ich weiÃŸ, es klingt ein bisschen verrÃ¼ckt, aber-",
          "source_text": "I don't know. Maybe this person plans to use my dress and pretend to be me. I know it sounds a little crazy, but-",
          "transcription_review_required": false
        },
        "ala2-32": {
          "path": "res://assets/languages/de/audio/ala2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "19f3ef62165c00d5251f1bdde6ce3ccd02d7b87ffc6e5690b5e0555fc905bcaa",
          "text": "Es kÃ¶nnte Sheila Phillips sein, Jimmys Ex-Freundin. Ich habe gehÃ¶rt, dass sie immer noch von ihm besessen ist.",
          "source_text": "It could be Sheila Phillips, Jimmy's ex-girlfriend. I've heard that she's still obsessed with him.",
          "transcription_review_required": false
        },
        "alb1-01": {
          "path": "res://assets/languages/de/audio/alb1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c66d9ec37727cec9e33aef7abe503c627bd4134b39b7c0ff5f678d8e80195a0",
          "text": "Ohne meinen Film bin ich ruiniert.",
          "source_text": "I'm ruined without my film.",
          "transcription_review_required": false
        },
        "alb1-02": {
          "path": "res://assets/languages/de/audio/alb1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "285838681699136343e3578d63e209116e3ad7b99764acfec3f5280848045e22",
          "text": "Hey, du kommst mir bekannt vor. Kennen wir uns? Oh, egal. Vielleicht kÃ¶nnen Sie mir helfen, meinen Film zu finden.",
          "source_text": "Hey, you look familiar. Have we met? Oh, never mind. Maybe you can help me find my film.",
          "transcription_review_required": false
        },
        "alb1-03": {
          "path": "res://assets/languages/de/audio/alb1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "df753e1681fb49f9a9551959376adcca75de12a51f58f61de29a1fba0a856cb7",
          "text": "Das wÃ¤re groÃŸartig! Ich kann spÃ¼ren, dass du eine positive Ausstrahlung hast.",
          "source_text": "That would be great! I can feel you have a positive aura about you.",
          "transcription_review_required": false
        },
        "alb1-10": {
          "path": "res://assets/languages/de/audio/alb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f54e4ba206bad7aa80d68aba653e6f2e88bf0114288b3f11a6426deea107b626",
          "text": "Der Film, der die Ã¶kologische Katastrophe zeigt, die sich in unserer Stadt ereignet.",
          "source_text": "The film that shows the ecological catastrophe that's happening in our city.",
          "transcription_review_required": false
        },
        "alb1-11": {
          "path": "res://assets/languages/de/audio/alb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf677cb8dca3f5104a66da0f2be2c7c38290e0fd4771af262a067a0975d05249",
          "text": "Eine Stadt mit Fabrikbetrieb schÃ¼ttet DDT ins Wasser und vergiftet Tonnen von Fischen. Dem Kapital geht es nur darum, Geld zu verdienen.",
          "source_text": "A factory-an-hour city pours DDT into the water, and poisons tons of fish. All that capital is cares about is making money.",
          "transcription_review_required": false
        },
        "alb1-12": {
          "path": "res://assets/languages/de/audio/alb1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8c68fc619942809b5105e1910a3fe377188106966796f130bf6487605bf176b3",
          "text": "Mir liegt unser Planet am Herzen, deshalb versuche ich, mein Bestes zu geben. Ich glaube auch an Tierrechte. Ich verwende nicht einmal Produkte, die an Tieren getestet wurden.",
          "source_text": "I care about our planet, so I try to do my best. I believe in animal rights too. I don't even use products that are tested on animals.",
          "transcription_review_required": false
        },
        "alb1-20": {
          "path": "res://assets/languages/de/audio/alb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c991b5a53006827ae835f42f0333f030977af016423307eb66cdde794112a9c8",
          "text": "Was wissen Sie Ã¼ber dieses Treffen?",
          "source_text": "What do you know about that meeting?",
          "transcription_review_required": false
        },
        "alb1-20h": {
          "path": "res://assets/languages/de/audio/alb1-20h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c00bc32fb3a2cc8a77acecbd910f3238c3f0d8c6f56e5ab66df8d36033d96cd2",
          "text": "Oh, die Notiz. Niemand sollte wissen, dass ich es war. Es gibt viele Menschen, die uns am liebsten daran hindern wÃ¼rden, uns zu treffen.",
          "source_text": "Oh, the note. Nobody was supposed to know it was me. There are many people who would like to prevent us from meeting.",
          "transcription_review_required": false
        },
        "alb1-21": {
          "path": "res://assets/languages/de/audio/alb1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "10421471d1dd9a8d12ebcb48aaf3bc2020f72d0fcba0da3b864b5e56cfe10cac",
          "text": "Nun, zunÃ¤chst einmal die Leute von Philip's Chemicals. Wenn die Dinge, die ich gegen sie habe, verÃ¶ffentlicht werden, kÃ¶nnte ihre Fabrik geschlossen werden.",
          "source_text": "Well, for starters, the people at Philip's Chemicals. If the stuff I have against them gets published, their factory could get closed down.",
          "transcription_review_required": false
        },
        "alb1-22a": {
          "path": "res://assets/languages/de/audio/alb1-22a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d77eed71011fc1ea199426ddb054aa2530feb59b74f22878714042e000b4e772",
          "text": "Das wÃ¤re logisch.",
          "source_text": "That would be logical.",
          "transcription_review_required": false
        },
        "alb1-22b": {
          "path": "res://assets/languages/de/audio/alb1-22b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b0f3e278406aae97d88226f206cbfbf640279e6559619a394802be9ef16bf366",
          "text": "Ohne den Film gÃ¤be es fÃ¼r mich keinen Grund, Jimmy zu treffen.",
          "source_text": "Without the film, there would be no reason for me to meet with Jimmy.",
          "transcription_review_required": false
        },
        "alb1-30": {
          "path": "res://assets/languages/de/audio/alb1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b3ba895d4a2d81c4cd0934cebacf3d369e67f93aeb4ea3c7301ea44516f3549e",
          "text": "Hey, ich bin deswegen so erschrocken, dass ich mich anscheinend an nichts erinnern kann.",
          "source_text": "Hey, I'm so freaked out because of this, I can't seem to remember anything.",
          "transcription_review_required": false
        },
        "alb1-31a": {
          "path": "res://assets/languages/de/audio/alb1-31a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "224c63b1b437376f9b2a7ce48bb618e3e252c141a56c4426e305d71a80bc1fc9",
          "text": "Ja, du hast recht.",
          "source_text": "Yeah, you're right.",
          "transcription_review_required": false
        },
        "alb1-31c": {
          "path": "res://assets/languages/de/audio/alb1-31c.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5a99fe9336689c4fab3a08589d4991d7fedd4d5a18650f0fce68f86eef95658e",
          "text": "Ich war heute Morgen im Labor, dann wollte ich zum Fotoladen, aber da erfuhr ich, dass der Film verschwunden war.",
          "source_text": "I was at the lab this morning, then I wanted to go to the photo store, but that's when I found out that the film had disappeared.",
          "transcription_review_required": false
        },
        "alb1-32": {
          "path": "res://assets/languages/de/audio/alb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "56398dc6455bf294da9c5ef10bea98188fdf8dc07aebd166522c5cf9471e7154",
          "text": "Hier gibt es grÃ¶ÃŸere Probleme als meine Beziehung zu Jimmy. Ich dachte, du hÃ¤ttest das verstanden.",
          "source_text": "There are bigger issues here than my relationship with Jimmy. I thought you understood that.",
          "transcription_review_required": false
        },
        "alb1-32h": {
          "path": "res://assets/languages/de/audio/alb1-32h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f020e3fa540767b76dece39f8bcdcec95f941cdd74b7df2a3f16ee9f727f22c8",
          "text": "Danke. Wow. Nicht an Tieren getestet. Wo hast du das her?",
          "source_text": "Thanks. Wow. Not tested on animals. Where did you get this?",
          "transcription_review_required": false
        },
        "alb2-01": {
          "path": "res://assets/languages/de/audio/alb2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "78ecf4e443367d3b429a2dc2b892a0c2a6a5d116d31e87bd0c772c42dfa33816",
          "text": "Hey, freue ich mich, dich zu sehen? Haben Sie eine Ahnung, wer den Film aufgenommen haben kÃ¶nnte?",
          "source_text": "Hey, am I glad to see you? Do you have any clue who might have taken the film?",
          "transcription_review_required": false
        },
        "alb2-01a": {
          "path": "res://assets/languages/de/audio/alb2-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "afea3bb24c00faaf7985c7153c15735f0dc6992fd717d59bd3829caf7747a9cc",
          "text": "Haben Sie herausgefunden, wer den Film gestohlen hat?",
          "source_text": "Did you find out who stole the film?",
          "transcription_review_required": false
        },
        "alb2-01h": {
          "path": "res://assets/languages/de/audio/alb2-01h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "34b1ad8fad55d8784a8d8ffaf1b2431e1716005f012de80854ce2d45ca520d94",
          "text": "S.P. Vielleicht ist es dieselbe Person, die diese verdÃ¤chtige Notiz auf meinem Schreibtisch im Labor hinterlassen hat.",
          "source_text": "S.P. Maybe it's the same person who left that suspicious note on my desk in the lab.",
          "transcription_review_required": false
        },
        "alb2-04": {
          "path": "res://assets/languages/de/audio/alb2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "200f2211717a2f52d722cb30e856291c7b210380387e371808274c96f94daabe",
          "text": "TschÃ¼ss.",
          "source_text": "Bye.",
          "transcription_review_required": false
        },
        "alb2-05": {
          "path": "res://assets/languages/de/audio/alb2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "324200860abf4d4c627c0cfeb6431cc855717196a82f47fb88bd0da93eed71a8",
          "text": "Ich mache mir wirklich Sorgen wegen dieser verdÃ¤chtigen Notiz.",
          "source_text": "I'm really concerned about this suspicious note.",
          "transcription_review_required": false
        },
        "alb2-10": {
          "path": "res://assets/languages/de/audio/alb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1a807bf8196d2dbc86127b637b98ab6f549c2b0939d6fd935c9b1fd8e61a048e",
          "text": "Die Forge-Notiz. Ich glaube, ich habe wirklich etwas GroÃŸes vor. Wenn meine Mutter es herausfindet, sperrt sie mich in mein Zimmer ein und wirft den SchlÃ¼ssel weg.",
          "source_text": "The Forge Note. I guess I'm really onto something big. If my mother finds out she'll lock me in my room and throw away the key.",
          "transcription_review_required": false
        },
        "alb2-11a": {
          "path": "res://assets/languages/de/audio/alb2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9d08a2d6c8b7ada1c170049a61a8887725db6b57480cda0a1c3ebd4698eb6fcd",
          "text": "Gib mir eine Pause. WeiÃŸt du, wie Eltern sind?",
          "source_text": "Give me a break. You know how parents are?",
          "transcription_review_required": false
        },
        "alb2-11b": {
          "path": "res://assets/languages/de/audio/alb2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d125977c216d079dae130f506162d6c3fb68aef60ccd8d3f4ecd170673421853",
          "text": "Es ist eine andere Generation. Ich werde nie so sein wie sie.",
          "source_text": "It's a different generation. I'll never be like them.",
          "transcription_review_required": false
        },
        "alb2-12": {
          "path": "res://assets/languages/de/audio/alb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "abe2c16e8d1499fc6200273939d398d0078a88f9f667103cecf88e0f735412c0",
          "text": "Ich habe keine Ahnung, aber jemand wird sich groÃŸe MÃ¼he geben, mich daran zu hindern, Jimmy zu treffen.",
          "source_text": "I have no idea, but someone is going to a lot of trouble to prevent me from meeting Jimmy.",
          "transcription_review_required": false
        },
        "alb2-20": {
          "path": "res://assets/languages/de/audio/alb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b2efead476dcc67ccfd3e597740e1856fd65c82905af7c26515a7b52bf10512b",
          "text": "Es war an mich adressiert, aber die Nachricht, die ich Jimmy schickte, war anonym. Ich habe ihm nie meinen Namen gesagt.",
          "source_text": "It was addressed to me, but the note I sent Jimmy was anonymous. I never told him my name.",
          "transcription_review_required": false
        },
        "alb2-21": {
          "path": "res://assets/languages/de/audio/alb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3da05fc824c285fac86901004c665177ffa2e5baa7d1caca1c198bb2781bc9aa",
          "text": "Wer weiÃŸ? Obwohl darin einige Fehler enthalten sind, die einem sehr bekannt vorkommen.",
          "source_text": "Who knows? Although there are some mistakes in it that look very familiar.",
          "transcription_review_required": false
        },
        "alb2-22": {
          "path": "res://assets/languages/de/audio/alb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c790c38087f9d1ac712614915708e3e4a92944c2e535bd2b6781e20e6cfa88af",
          "text": "Niemand, den ich verdÃ¤chtigen wÃ¼rde. Nur Dorothy und Larry. Nein, denkst du nicht... Larry? Das kann nicht sein.",
          "source_text": "Nobody that I'd suspect. Just Dorothy and Larry. No, you don't think... Larry? It can't be.",
          "transcription_review_required": false
        },
        "doa1-01a": {
          "path": "res://assets/languages/de/audio/doa1-01a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "34980830af644259bc94c8ae19ca246044524e837cf93ef065474d0c54b5bd2d",
          "text": "Meine GÃ¼te, was fÃ¼r ein schrecklicher Tag!",
          "source_text": "Gosh, what a terrible day!",
          "transcription_review_required": false
        },
        "doa1-01b": {
          "path": "res://assets/languages/de/audio/doa1-01b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6645802a5e691ba65e9ba43185fa1c9c0fcedf0efe968f68178807c439b17045",
          "text": "Der Film wird gestohlen und ich muss die GrÃ¶ÃŸe des Golden Gate Park schÃ¤tzen.",
          "source_text": "The film gets stolen, and I've got to zit the size of Golden Gate Park.",
          "transcription_review_required": false
        },
        "doa1-03": {
          "path": "res://assets/languages/de/audio/doa1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e149d66aa503698e5db6e769cdcac077d25c941ad75866117d8d1cf792628c2a",
          "text": "Wenn Sie Informationen benÃ¶tigen, suchen Sie mich. Mein Name ist Dorothy.",
          "source_text": "If you need any information, look for me. My name is Dorothy.",
          "transcription_review_required": false
        },
        "doa1-04": {
          "path": "res://assets/languages/de/audio/doa1-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "fec7ba765183d9a54684a1879a4369ae59aa664d05b8e9270edba7a3214373ab",
          "text": "Ich habe keine Neuigkeiten Ã¼ber den Film.",
          "source_text": "I have no news about the film.",
          "transcription_review_required": false
        },
        "doa1-10a": {
          "path": "res://assets/languages/de/audio/doa1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8c371ec69b9831e36aa0f28059417e64ff886c89a383cc51628c6886694bf861",
          "text": "Wenn Sie mich fragen, ist es dieser andere Typ aus dem Labor, Larry Chang, der es genommen hat.",
          "source_text": "If you ask me, it's that other guy from the lab, Larry Chang who took it.",
          "transcription_review_required": false
        },
        "doa1-10b": {
          "path": "res://assets/languages/de/audio/doa1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a88535672ec7f724619c12f27964a746cd9cba085df1389221a05f13f4bf74e3",
          "text": "Er war schon immer eifersÃ¼chtig auf Alice wegen ihrer Noten und Stipendien.",
          "source_text": "He's always been jealous of Alice because of her grades and scholarships.",
          "transcription_review_required": false
        },
        "doa1-20": {
          "path": "res://assets/languages/de/audio/doa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a88d3a441eeabfbf5040e65e03464d119a1ccc28e1c60e6ffa955bc5662613e9",
          "text": "Sie mÃ¶chte, dass Gerechtigkeit geschieht, aber ich glaube, sie ist auch ganz verrÃ¼ckt nach diesem Reporter, das haben Sie noch nicht von mir gehÃ¶rt.",
          "source_text": "She wants justice to be done, but also, and you didn't hear this from me, I think she's wild about that reporter.",
          "transcription_review_required": false
        },
        "doa1-21": {
          "path": "res://assets/languages/de/audio/doa1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b185e9520fee68fdfc66f0f53990ac4a08c78c5e0dcd4658a7aa231b6849d1bc",
          "text": "Sie schickte ihm einen anonymen Brief, in dem sie sich selbst beschrieb und ihn bat, sie in Minneapolis zu treffen, wo ich herkomme. Das ist eine Einladung zu einem Date.",
          "source_text": "She sent him an anonymous letter describing herself and asking him to meet her, in Minneapolis, where I come from. That's an invitation for a date.",
          "transcription_review_required": false
        },
        "doa1-22": {
          "path": "res://assets/languages/de/audio/doa1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c5387d42e8d5b4edb50c130d69e531f28ab85ba062f1703840bbb3a56c081d08",
          "text": "Was? Wie kannst du es wagen?",
          "source_text": "What? How dare you?",
          "transcription_review_required": false
        },
        "doa1-22m": {
          "path": "res://assets/languages/de/audio/doa1-22m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "58e9500dcfb5c623482d8ed59a6ba073a197a4cb5953e5c67f4894d97f945321",
          "text": "Hey, danke! Es passt in meine Kosmetiktasche.",
          "source_text": "Hey, thanks! It fits into my makeup bag.",
          "transcription_review_required": false
        },
        "doa2-01": {
          "path": "res://assets/languages/de/audio/doa2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5e8793911b3ab67cec9ee9bb6dce7eebe1a1e53d8062822a99897a7359b97b57",
          "text": "Ich bin wirklich schockiert darÃ¼ber, was mit Alice passiert.",
          "source_text": "I'm really shocked by what's happening to Alice.",
          "transcription_review_required": false
        },
        "doa2-02": {
          "path": "res://assets/languages/de/audio/doa2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "72f576c588571216e086207d123c1ca330ab3427309fcae46eb21f998f0691a2",
          "text": "Hast du gehÃ¶rt, dass Alices Treffen mit Jimmy Mackenzie nicht stattfinden kann?",
          "source_text": "Did you hear that Alice's meeting with Jimmy Mackenzie is off?",
          "transcription_review_required": false
        },
        "doa2-03": {
          "path": "res://assets/languages/de/audio/doa2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "becf1407a84992732b65f63f1fbb0fdd08f50e62f3870b402f436abc7d800d67",
          "text": "Bis spÃ¤ter!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "doa2-04": {
          "path": "res://assets/languages/de/audio/doa2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c412157f534e70ada93fe75eb3e85b6c6777c060bfd2f0292d2d9a470b859d08",
          "text": "Arme Alice, ihr Treffen mit Jimmy Mackenzie ist ausgefallen.",
          "source_text": "Poor Alice, her meeting with Jimmy Mackenzie is off.",
          "transcription_review_required": false
        },
        "doa2-05": {
          "path": "res://assets/languages/de/audio/doa2-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "171a4fd87ff6e695be813bda2619bf066d7ca4f0a3c4ebb0b46216f5824387e1",
          "text": "Tut mir leid, ich kann einfach nicht, kann nicht, Ã¤hm, CHOO! Ich kann es scheinbar nicht, CHOO! Sachen!",
          "source_text": "Sorry, I just can't, can't, uhh, CHOO! I can't seem to, CHOO! Stuff!",
          "transcription_review_required": false
        },
        "doa2-05a": {
          "path": "res://assets/languages/de/audio/doa2-05a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9a3ff25f5efcaab57fac056bda36b8d90452554350fee3deec3620391df47185",
          "text": "Ha-ha-ha-ha-ha-choo!",
          "source_text": "Ha-ha-ha-ha-ha-choo!",
          "transcription_review_required": false
        },
        "doa2-06": {
          "path": "res://assets/languages/de/audio/doa2-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "becf1407a84992732b65f63f1fbb0fdd08f50e62f3870b402f436abc7d800d67",
          "text": "Bis spÃ¤ter!",
          "source_text": "See you later!",
          "transcription_review_required": false
        },
        "doa2-07": {
          "path": "res://assets/languages/de/audio/doa2-07.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "49768af760be806877423642b09961fe054983adb7be8025965f2a375d7d62af",
          "text": "Was willst du jetzt?",
          "source_text": "What do you want now?",
          "transcription_review_required": false
        },
        "doa2-10": {
          "path": "res://assets/languages/de/audio/doa2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "195f6b39c08cf3d88c07a31a712a48150753763466aa355e40f97e5a6d69c657",
          "text": "Nun, ihr Kleid wurde gestohlen, das sie eigentlich zu dem Treffen mit Jimmy tragen sollte.",
          "source_text": "Well, her dress was stolen, the one she was supposed to wear to the meeting with Jimmy.",
          "transcription_review_required": false
        },
        "doa2-20": {
          "path": "res://assets/languages/de/audio/doa2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "325d002f074ce9e5a2bd25dd1aa974c52e553f1fd3a857c72c36996cc0cf5c81",
          "text": "Wer, dieselbe Person, die nicht mÃ¶chte, dass sie Jimmy trifft, und es gibt viele MÃ¶glichkeiten. Susan zum Beispiel.",
          "source_text": "Who, the same person who doesn't want her to meet Jimmy, and there are many options. Susan, for instance.",
          "transcription_review_required": false
        },
        "doa2-21": {
          "path": "res://assets/languages/de/audio/doa2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b4b70b392907960111cf7f1a149fa35c8d1cb6f392a3904e34a3863230c5636b",
          "text": "Ja, viele Leute sind eifersÃ¼chtig auf Alice. Alice ist ein kluges, schÃ¶nes MÃ¤dchen. Deshalb bin ich ihre beste Freundin.",
          "source_text": "Yes, lots of people are jealous of Alice. Alice is a smart, beautiful girl. That's why I'm her best friend.",
          "transcription_review_required": false
        },
        "doa2-22": {
          "path": "res://assets/languages/de/audio/doa2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e1d3038cf469b066021ca8dc49405efd5c2fa1ceebf34db14e85bf6f92532909",
          "text": "Sagen wir einfach, es wÃ¤re nicht das erste Mal, dass sie etwas gestohlen hat, obwohl es normalerweise MÃ¤nner sind. Glauben Sie mir, ich weiÃŸ, wovon ich rede.",
          "source_text": "Let's just say that it wouldn't be the first time she's stolen something, although it's usually men. Believe me, I know what I'm talking about.",
          "transcription_review_required": false
        },
        "doa2-30": {
          "path": "res://assets/languages/de/audio/doa2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "421c1c925f4e35599e333feca5619da7d55f2b31de8ddd3ef3c5741e4ca9846a",
          "text": "Nicht mehr, das bin ich nicht!",
          "source_text": "Not anymore, I'm not!",
          "transcription_review_required": false
        },
        "doa2-40": {
          "path": "res://assets/languages/de/audio/doa2-40.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7999c6390d6430848e237d443106ce0176f5d82033dd65de1ec7b968285e8187",
          "text": "Welches Taschentuch?",
          "source_text": "What handkerchief?",
          "transcription_review_required": false
        },
        "doa2-40h": {
          "path": "res://assets/languages/de/audio/doa2-40h.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b372723dc61443b01ef0d81bc4ae92e538966a6244bb143707425cff3326d664",
          "text": "Das ist nicht meins. Mein Name ist Dorothy. Hier kann ich Ihnen meinen Ausweis zeigen.",
          "source_text": "That's not mine. My name is Dorothy. Here, I can show you my ID.",
          "transcription_review_required": false
        },
        "doa2-50": {
          "path": "res://assets/languages/de/audio/doa2-50.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "84c361e69069501ec8db64e0b0bae2534f3c237c5704799ee877b5bfc262555f",
          "text": "Ja, aber es ist ein Geheimnis. Nur mein bester Freund aus der High School darf es benutzen.",
          "source_text": "Yes, but it's a secret. Only my best friend from high school is allowed to use it.",
          "transcription_review_required": false
        },
        "doa2-s3": {
          "path": "res://assets/languages/de/audio/doa2-s3.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8146793818b15af47c3d0f2a4a6aa10035fcb0b69d52ded2a1b6af104f93ca92",
          "text": "Ich segne Sie dafÃ¼r, dass Sie die Ursache meines Niesens beseitigt haben. Ich hasse diese Blumen!",
          "source_text": "Bless you for removing the cause of my sneezing. I hate those flowers!",
          "transcription_review_required": false
        },
        "dob1-01": {
          "path": "res://assets/languages/de/audio/dob1-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "05a251ac7a7e5a5ba565b3bfc602dff7ee73bca8f4959b63fc80426aca8ea3e8",
          "text": "Hat dir jemand gesagt, dass du ein bisschen wie Alice aussiehst?",
          "source_text": "Did anyone tell you you look a little bit like Alice?",
          "transcription_review_required": false
        },
        "dob1-02": {
          "path": "res://assets/languages/de/audio/dob1-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0df5b522d068698275f46783337e16da6080458882caccd430617a07ace7ab2c",
          "text": "TschÃ¼ss!",
          "source_text": "Bye!",
          "transcription_review_required": false
        },
        "dob1-03": {
          "path": "res://assets/languages/de/audio/dob1-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e4ce4d23202b97534eef7d7d8e4d788a8f5a5a38d9f0ec3b3dda7fa7b63f20b4",
          "text": "Ich hatte das GefÃ¼hl, dass wir unser kleines GesprÃ¤ch noch nicht beendet hatten.",
          "source_text": "I had a feeling we hadn't finished our little conversation.",
          "transcription_review_required": false
        },
        "dob1-10a": {
          "path": "res://assets/languages/de/audio/dob1-10a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "3545a0f2a2db6401bb503de0d4f7b3b10b880cc1f8a5719b3a4043243831e640",
          "text": "Es ist so offensichtlich.",
          "source_text": "It's so obvious.",
          "transcription_review_required": false
        },
        "dob1-10b": {
          "path": "res://assets/languages/de/audio/dob1-10b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "64857296fc68a99d94d42656b8beed887ac570e8b8e7236340c2a9751ba3032f",
          "text": "Sie brennt darauf, Jimmy kennenzulernen, aber sie wird es niemals zugeben.",
          "source_text": "She's dying to meet Jimmy, but she'll never admit it.",
          "transcription_review_required": false
        },
        "dob1-11a": {
          "path": "res://assets/languages/de/audio/dob1-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9ed16cdd2768ae7638b3065d1b0a7643afd77e9dc6462e97b46db0f8d30c77fa",
          "text": "Sie hat sich gerade von ihrem Freund Rick aus dem Plattenladen getrennt, und ich weiÃŸ, dass das nur eines bedeutet.",
          "source_text": "She just separated from her boyfriend, Rick, from the record store, and I know that means only one thing.",
          "transcription_review_required": false
        },
        "dob1-11b": {
          "path": "res://assets/languages/de/audio/dob1-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "defb616b402f0c1efb2b7fe2fb9f85cc9e6e8206f8c15388082572d47cb814cf",
          "text": "Sie hat bereits jemand anderen im Kopf.",
          "source_text": "She's already got someone else on her mind.",
          "transcription_review_required": false
        },
        "dob1-12": {
          "path": "res://assets/languages/de/audio/dob1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "98959687033eeb4df9cfddaebf85bd06f421cae816b0b128e87f2be995b8c1ba",
          "text": "Alles, worÃ¼ber Alice spricht, ist die Umwelt, aber glauben Sie mir, in ihren Gedanken denkt sie, wie alle Frauen denken, sie mÃ¶chte einen guten Ehemann finden.",
          "source_text": "All Alice talks about is the environment, but believe me, in her mind, she thinks like all women think, she wants to find a good husband.",
          "transcription_review_required": false
        },
        "dob1-20a": {
          "path": "res://assets/languages/de/audio/dob1-20a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b4ac362cfb3559b337fab664a9d96e6d2d0ffd1ccef7ab8d20364683914b56b9",
          "text": "Wenn Sie mich fragen, hat es ihr Kollege aus dem Labor genommen, er ist so neidisch auf sie.",
          "source_text": "If you ask me, her colleague from the lab took it, he's so envious of her.",
          "transcription_review_required": false
        },
        "dob1-20b": {
          "path": "res://assets/languages/de/audio/dob1-20b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "520fefbbe88dfb274fd1da185a70a42280932a9e886b09388a059a1f2e79db88",
          "text": "WÃ¤hrend er den ganzen Tag lernt und arbeitet, wÃ¤hlt sie alle Stipendien aus.",
          "source_text": "While he's studying and working all day, she picks all the scholarships.",
          "transcription_review_required": false
        },
        "dob2-01": {
          "path": "res://assets/languages/de/audio/dob2-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5da3e59166210735a99719775fc48006b5d17f8824f65535f6ed83ce9a627ede",
          "text": "Ich muss Susan unbedingt die neuesten Nachrichten erzÃ¤hlen.",
          "source_text": "I really have to tell Susan the latest news.",
          "transcription_review_required": false
        },
        "dob2-02": {
          "path": "res://assets/languages/de/audio/dob2-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "b26a4be0054b7486d7df172f3aee22a79fac7121926375a147229b3a83a0333c",
          "text": "Das ist wirklich beÃ¤ngstigend. Eine Notiz fÃ¤lschen, nur um Alice daran zu hindern, Jimmy zu treffen? Oh, wenn ich hier nur ein Telefon finden kÃ¶nnte, kÃ¶nnte ich Susan auf den neuesten Stand bringen.",
          "source_text": "This is really frightening. Forging a note just to prevent Alice from meeting Jimmy? Oh, if only I could find a phone here, I could update Susan.",
          "transcription_review_required": false
        },
        "dob2-03": {
          "path": "res://assets/languages/de/audio/dob2-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "835124a64ebc8877bfd1b9979f0f55fc1b18256979bfc9e34a8521aa4ad30763",
          "text": "Wir sehen uns!",
          "source_text": "See ya!",
          "transcription_review_required": false
        },
        "dob2-04": {
          "path": "res://assets/languages/de/audio/dob2-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e99a12e212dfd5ee237d0f2a6033b09568c0dba29cb9a7a3888ecc46471034e1",
          "text": "Ich wÃ¼nschte, es gÃ¤be hier ein Ã¶ffentliches Telefon. Ich muss Susan unbedingt von der gefÃ¤lschten Notiz erzÃ¤hlen.",
          "source_text": "I wish there was a public phone here. I really have to tell Susan about the forged note.",
          "transcription_review_required": false
        },
        "dob2-10": {
          "path": "res://assets/languages/de/audio/dob2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "cf15b327a42267d9dd6469119ecad9f8337b89f97dacc3439c7ddf05f52cf35a",
          "text": "Ich habe keine Ahnung. Ich dachte, Alice hÃ¤tte niemandem auÃŸer mir von dieser PrÃ¼gel erzÃ¤hlt.",
          "source_text": "I don't have a clue. I thought Alice didn't tell anyone but me about this beating.",
          "transcription_review_required": false
        },
        "dob2-11a": {
          "path": "res://assets/languages/de/audio/dob2-11a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c79426cf3c3a8069a728d094907708fa8da3df40cc49a2ab3ee31a75a8969e1",
          "text": "Mich?",
          "source_text": "Me?",
          "transcription_review_required": false
        },
        "dob2-11b": {
          "path": "res://assets/languages/de/audio/dob2-11b.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f662ac68b1cd033e3371970d063e9927ff9a326f7c54c321b6f2c03320b06373",
          "text": "Nein, nur Susan, aber Susan ist eine Freundin. Sie wÃ¼rde es aber nie tun, aber sie wÃ¼rde die ganzen Reisen auf sich nehmen, nur um Jimmy zu treffen, nein.",
          "source_text": "No. Well, just Susan, but Susan is a friend. She would never, although, but to go to all that travel just to meet Jimmy, nah.",
          "transcription_review_required": false
        },
        "dob2-12": {
          "path": "res://assets/languages/de/audio/dob2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "76e8fd2ced6a8c58774923a5fba71a2537f48c0b5d8c7e6828b148daf7005b0d",
          "text": "Das ist zu viel. Sie verdÃ¤chtigen mich? Ich bin Alices beste Freundin.",
          "source_text": "This is too much. You suspect me? I'm Alice's best friend.",
          "transcription_review_required": false
        },
        "dob2-12m": {
          "path": "res://assets/languages/de/audio/dob2-12m.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f502363bd937f0d87cfc0215892dd6ac5dca62de1235fd354d01dc9da28be8a7",
          "text": "Was fÃ¼r ein sÃ¼ÃŸes Telefon! Aber wo ist das Kabel?",
          "source_text": "What a cute phone! But where's the cord?",
          "transcription_review_required": false
        },
        "dob2-20": {
          "path": "res://assets/languages/de/audio/dob2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5c7c4d85273e58fb5d9fa4c6a586302da8af3aad1efb621f96fa1c16d268f845",
          "text": "Alice? Auf keinen Fall. FÃ¼r sie ist es ein wahrgewordener Traum. Sie wollte immer mindestens Robert Kennedy sein.",
          "source_text": "Alice? No way. For her, it's a dream come true. She always wanted to be Robert Kennedy at the least.",
          "transcription_review_required": false
        },
        "dol-01": {
          "path": "res://assets/languages/de/audio/dol-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "98121f75c7b819851104b748ea185c405291d79a90e79b227cd732f84ec81603",
          "text": "Warum glaubst du, dass ich es getan habe?",
          "source_text": "Why do you think I did it?",
          "transcription_review_required": false
        },
        "dol-02": {
          "path": "res://assets/languages/de/audio/dol-02.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "57fa096d6059c90d523e64acff0b54c3c90fcc485098e90748993130f833a669",
          "text": "Du kannst immer noch nicht beweisen, dass ich Veronica bin.",
          "source_text": "You still can't prove that I'm Veronica.",
          "transcription_review_required": false
        },
        "dol-03": {
          "path": "res://assets/languages/de/audio/dol-03.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1f8f6f472be896d53d387129f86d1943a0c8ea2bf5612d2d8b3a619f53dd4561",
          "text": "OK, also ich bin Veronica. Was hast du gegen Veronicas?",
          "source_text": "OK, so I am Veronica. What do you have against Veronica's?",
          "transcription_review_required": false
        },
        "dol-04": {
          "path": "res://assets/languages/de/audio/dol-04.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "561730548aa494020be17a61a8e8cb4dacf330b320ba071cac32ea5085ccfa5f",
          "text": "Okay, ich bin es. Ich habe es nur getan, weil ich glaube, dass Jimmy nicht ihr Typ ist. TatsÃ¤chlich ist er genau der Richtige fÃ¼r mich, also werde ich ihn kennenlernen, bevor Alice dort ankommt.",
          "source_text": "Okay, it's me. I only did it because I don't think Jimmy's her type. In fact, he's just the right guy for me, so I'm gonna meet him before Alice gets there.",
          "transcription_review_required": false
        },
        "dol-05": {
          "path": "res://assets/languages/de/audio/dol-05.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0c0bd98123beba6bf163bf1925fc9919827878cb8ad5210956ef3778d9582862",
          "text": "Was hat das mit mir zu tun?",
          "source_text": "What does this have to do with me?",
          "transcription_review_required": false
        },
        "dol-06": {
          "path": "res://assets/languages/de/audio/dol-06.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "f7f1426a33cff8a11e9c17f8e04794056f60a59025e6f9800da9df0c199560d4",
          "text": "Alice ist meine Freundin. Ich wÃ¼rde ihr niemals wehtun.",
          "source_text": "Alice is my friend. I would never hurt her.",
          "transcription_review_required": false
        },
        "dol-08": {
          "path": "res://assets/languages/de/audio/dol-08.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "43e727dc532157eee3abc6f1b14288dd15e4ce14609edb9426cc46a4a60bd59c",
          "text": "Also, was ist das fÃ¼r ein Beweis?",
          "source_text": "So what's this prove?",
          "transcription_review_required": false
        },
        "dol-08a": {
          "path": "res://assets/languages/de/audio/dol-08a.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "36546f5153f09f51db915f3e858dad75e614de4f0c94ce14960f8e73777d3a11",
          "text": "Q! Was beweist das also? Q!",
          "source_text": "Q! So what does this prove? Q!",
          "transcription_review_required": false
        },
        "dol-09": {
          "path": "res://assets/languages/de/audio/dol-09.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ccbb48b7fa3207d08debcfa1e46335b91eab372cb7928d07724cc2d623f23d4e",
          "text": "Ich habe gehÃ¶rt, dass sie sich getrennt haben. Das sind gute Nachrichten fÃ¼r alle Frauen in der Stadt.",
          "source_text": "I heard they broke up. That's good news for all the women in town.",
          "transcription_review_required": false
        },
        "dol-10": {
          "path": "res://assets/languages/de/audio/dol-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6c868721fd92949503dfaeb30a32505e64e6c3993be9f8d2e2d8d2be867e0afc",
          "text": "Du kannst noch nicht beweisen, dass ich es bin.",
          "source_text": "You can't prove it's me yet.",
          "transcription_review_required": false
        },
        "dol-11": {
          "path": "res://assets/languages/de/audio/dol-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ec8191f86146792e58ce8c5f4873f05e6778ebadbec366f8d3f0fec261ec618e",
          "text": "Was ist los? Eine Katze hat deine Zunge erwischt? Nichts zu sagen oder zu verwenden ist ein Beweis gegen mich, oder?",
          "source_text": "What's the matter? A cat got your tongue? Nothing to say or use is proof against me, huh?",
          "transcription_review_required": false
        },
        "dolb-01": {
          "path": "res://assets/languages/de/audio/dolb-01.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "08eb74d6515fbb71dcc943f2179bdae21c50b6646d39ce4a29adf8965b2b3823",
          "text": "Alice ist so glÃ¼cklich, dich zu haben.",
          "source_text": "Alice is so lucky to have you.",
          "transcription_review_required": false
        },
        "jala1-10": {
          "path": "res://assets/languages/de/audio/jala1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d90e31097f098821ace29f68ba95b5e7608c5fea1a715ccb400386320fc573c7",
          "text": "Es tut mir leid, dass ich unterbreche, aber um welchen Film handelt es sich genau?",
          "source_text": "I'm sorry to interrupt, but what film is that exactly?",
          "transcription_review_required": false
        },
        "jala1-11": {
          "path": "res://assets/languages/de/audio/jala1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6e0a46477e38cbf091fa48c117e87f9ac6783541ef1f14f7660243a9888e4662",
          "text": "Haben Sie eine Idee, wo der Film sein kÃ¶nnte?",
          "source_text": "Do you have any idea where the film might be?",
          "transcription_review_required": false
        },
        "jala1-12": {
          "path": "res://assets/languages/de/audio/jala1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7dad4de4c796481a453b4dc06f8ef063449ad5e8d48c9a84aa6a7ea23c90b47c",
          "text": "KÃ¶nnte es jemand mitgenommen haben?",
          "source_text": "Could someone have taken it?",
          "transcription_review_required": false
        },
        "jala1-20": {
          "path": "res://assets/languages/de/audio/jala1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1bc363d1c90652edb55c01ffc8f30fd60216acf29d280694cf1601aa5c58f87b",
          "text": "Warum ist Ihnen der Film so wichtig?",
          "source_text": "Why is the film so important to you?",
          "transcription_review_required": false
        },
        "jala1-21": {
          "path": "res://assets/languages/de/audio/jala1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "60ec9e62a041abb726a9994a92134ea99ac76885783cf1be0268a2d32f031df3",
          "text": "Warum braucht Papa den Film?",
          "source_text": "Why does Dad need the film?",
          "transcription_review_required": false
        },
        "jala1-22": {
          "path": "res://assets/languages/de/audio/jala1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "af17f2237c055b293f7273a94e8a0ed9894466a327e55f99e3d2ee3c86a2baa8",
          "text": "Warum kannst du ihn nicht einfach ohne den Film treffen?",
          "source_text": "Why can't you just meet him without the film?",
          "transcription_review_required": false
        },
        "jala1-by": {
          "path": "res://assets/languages/de/audio/jala1-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0540f4af0b2117871d88641f506826e644b8b0158ff805d092ce1fd7b1fe57aa",
          "text": "Ich helfe dir.",
          "source_text": "I'll help you.",
          "transcription_review_required": false
        },
        "jala2-10": {
          "path": "res://assets/languages/de/audio/jala2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4b936441c6c5b75d962ce98c8489547f90228c7df60d478df0142a63b2b7fe04",
          "text": "Adresse verschwunden?",
          "source_text": "Address disappeared?",
          "transcription_review_required": false
        },
        "jala2-11": {
          "path": "res://assets/languages/de/audio/jala2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9ad553155b4ee47d48edaa02ac5ac53f052f4467b1ca9cf2860973e8c3549c9f",
          "text": "KÃ¶nnten Sie sich jemals wÃ¼nschen, dass Ihr kleines, altes Kleid das Kleid ist?",
          "source_text": "Could ever want your short, old be the dress?",
          "transcription_review_required": false
        },
        "jala2-12": {
          "path": "res://assets/languages/de/audio/jala2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "d52ab556ca20c26de18c33a93ba4181a4e44ec330acf43d7ef6114df2aabe1e0",
          "text": "HÃ¤tte Jimmy McKenzie Sie ohne das Kleid nicht erkennen kÃ¶nnen?",
          "source_text": "Wouldn't Jimmy McKenzie be able to recognize you without the dress?",
          "transcription_review_required": false
        },
        "jala2-20": {
          "path": "res://assets/languages/de/audio/jala2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "8040f598aeda1624fbf3e1c1df4531fe56c735c9a5bd0b9291dc5965aae3b88d",
          "text": "Wo hast du dein Kleid zuletzt gesehen?",
          "source_text": "Where did you last see your dress?",
          "transcription_review_required": false
        },
        "jala2-30": {
          "path": "res://assets/languages/de/audio/jala2-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6a674b58ef326c13ec0408e86a82f55f9168cb47c7a2d6f960b95b7dafad13c5",
          "text": "Warum sollte jemand dein Kleid nehmen?",
          "source_text": "Why would anyone take your dress?",
          "transcription_review_required": false
        },
        "jala2-31": {
          "path": "res://assets/languages/de/audio/jala2-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "7e62266f5c54817c4e1c136d04b1784865fb4b5d1fd6ba508ca3e14f14368bbf",
          "text": "Glaubst du, jemand wÃ¼rde ein Kleid stehlen, nur um das Treffen zu sabotieren?",
          "source_text": "You think someone would steal a dress just to sabotage the meeting?",
          "transcription_review_required": false
        },
        "jala2-32": {
          "path": "res://assets/languages/de/audio/jala2-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "1d449bb9d17465eb898b9f2e8ac051f81e4f82e903607d2a1fcd4c62f5ad53a2",
          "text": "FÃ¤llt Ihnen jemand ein, der Sie daran hindern mÃ¶chte, Jimmy zu treffen?",
          "source_text": "Can you think of anyone who would want to prevent you from meeting Jimmy?",
          "transcription_review_required": false
        },
        "jala2-by": {
          "path": "res://assets/languages/de/audio/jala2-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "23d14a64b3b2352d674164e4eeb905410c3d65ddd38402524995b6b80f713e0a",
          "text": "Keine Sorge, ich werde weiter forschen.",
          "source_text": "Don't worry, I'll keep investigating.",
          "transcription_review_required": false
        },
        "jalb1-10": {
          "path": "res://assets/languages/de/audio/jalb1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "81f634b258f4c3c6e3b2bf96dbbdfae859cfe26cf3fbe7e73d50645ed6335c94",
          "text": "Von welchem â€‹â€‹Film sprichst du?",
          "source_text": "What film are you talking about?",
          "transcription_review_required": false
        },
        "jalb1-11": {
          "path": "res://assets/languages/de/audio/jalb1-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "517ec489d28bbbb4384178832bf462fc7f5c52ed02d3f831d628a195e6583672",
          "text": "Welche Ã¶kologische Katastrophe?",
          "source_text": "What ecological catastrophe?",
          "transcription_review_required": false
        },
        "jalb1-12": {
          "path": "res://assets/languages/de/audio/jalb1-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "00da0ffa33d168c11e9e259782123e6081a944ba13ec6cc639dbef435355b3fd",
          "text": "Warum hast du Fotos davon gemacht?",
          "source_text": "Why did you take photos of it?",
          "transcription_review_required": false
        },
        "jalb1-20": {
          "path": "res://assets/languages/de/audio/jalb1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "a7d8a4d6cd1b01a82527cfcfdedcb726623634edecc49b9260968dd0e07ed397",
          "text": "Sind Sie derjenige, der das Treffen mit Jimmy McKenzie heute Abend abgesagt hat?",
          "source_text": "Are you the one who canceled the meeting with Jimmy McKenzie tonight?",
          "transcription_review_required": false
        },
        "jalb1-21": {
          "path": "res://assets/languages/de/audio/jalb1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6eab26d2eaed3945fc3ea00838ba113ff7c515f06914052f1046a5c97c50ed49",
          "text": "Wer mÃ¶chte Sie daran hindern, sich zu treffen?",
          "source_text": "Who would want to prevent you to from meeting?",
          "transcription_review_required": false
        },
        "jalb1-22": {
          "path": "res://assets/languages/de/audio/jalb1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5b686a413667185b861cd40cce65753e4b46a12e35a87d6b151341106b06ea03",
          "text": "KÃ¶nnte es sein, dass die Person, die Ihr Treffen verhindern wollte, derjenige ist, der den Film gestohlen hat?",
          "source_text": "Could it be that the person trying to prevent your meeting is the one who stole the film?",
          "transcription_review_required": false
        },
        "jalb1-30": {
          "path": "res://assets/languages/de/audio/jalb1-30.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "6f4de4d20f144b1f44a80aa3738209a0417fb2c5e9658f2cf621b6f7c8f2789b",
          "text": "Vielleicht hast du den Film irgendwo vergessen.",
          "source_text": "Maybe you forgot the film somewhere.",
          "transcription_review_required": false
        },
        "jalb1-31": {
          "path": "res://assets/languages/de/audio/jalb1-31.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5bcf4f43776c4d8022496d953f5e5d1cea7edc5e78c3a751a91de86219883de7",
          "text": "Vielleicht solltest du es mit Yoga versuchen. Diese AtemÃ¼bungen kÃ¶nnen Ihnen helfen, sich zu entspannen.",
          "source_text": "Maybe you should try yoga. Those breathing exercises may help you relax.",
          "transcription_review_required": false
        },
        "jalb1-32": {
          "path": "res://assets/languages/de/audio/jalb1-32.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "4760e6b1c098ca10070d80ae0ae2c9bfec14219b7d69472002359c23b07d35bc",
          "text": "Konzentrieren. Es ist wichtig fÃ¼r die Zukunft Ihrer Beziehung mit Jimmy.",
          "source_text": "Concentrate. It's important for the future of your relationship with Jimmy.",
          "transcription_review_required": false
        },
        "jalb1-by": {
          "path": "res://assets/languages/de/audio/jalb1-by.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c1f6a09d0c62b1bbf15e8943aa8f27b5280c787f0fe0f44e56b31436b76d4a37",
          "text": "Ich helfe Ihnen, den Film zu finden.",
          "source_text": "I'll help you find the film.",
          "transcription_review_required": false
        },
        "jalb2-10": {
          "path": "res://assets/languages/de/audio/jalb2-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e69c0d13ec3680e22e9ca8f15681199c8c537206fbf5e47ed616b63d5aef8506",
          "text": "Welcher Hinweis?",
          "source_text": "What note?",
          "transcription_review_required": false
        },
        "jalb2-11": {
          "path": "res://assets/languages/de/audio/jalb2-11.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "9c21fc571d82ec8490ad81d4c84091d395175ad36b2c2d61428134f0954d24d6",
          "text": "Warum sollte deine Mutter dich einsperren?",
          "source_text": "Why would your mother lock you up?",
          "transcription_review_required": false
        },
        "jalb2-12": {
          "path": "res://assets/languages/de/audio/jalb2-12.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "ce25eed2d526cb40b1a4bfe745a0d9f92dd2fac274d2f85a56b9f014bb165083",
          "text": "Warum sollte jemand eine Notiz fÃ¤lschen?",
          "source_text": "Why would anyone forge a note?",
          "transcription_review_required": false
        },
        "jalb2-20": {
          "path": "res://assets/languages/de/audio/jalb2-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "e7b3ab2d6b9db0e5cde76278bb7b1874124953873ecc90acdae08a904b7b871a",
          "text": "Was ist an dieser Notiz so verdÃ¤chtig?",
          "source_text": "What's so suspicious about this note?",
          "transcription_review_required": false
        },
        "jalb2-21": {
          "path": "res://assets/languages/de/audio/jalb2-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "217c05e32bc4161fe1900d7074247591c414508289f0ac8fa59b840417674236",
          "text": "Wer kÃ¶nnte Ihnen diese Nachricht geschickt haben?",
          "source_text": "Who could have sent you that note?",
          "transcription_review_required": false
        },
        "jalb2-22": {
          "path": "res://assets/languages/de/audio/jalb2-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "5e722e6198a43dcfe4dfac3000abdf0275d5f6b24be01c2b8ac8ea56fcc0d00c",
          "text": "Wer wusste von dem anonymen Brief, den Sie an Jimmy geschickt haben?",
          "source_text": "Who knew about the anonymous letter you sent to Jimmy?",
          "transcription_review_required": false
        },
        "jdoa1-10": {
          "path": "res://assets/languages/de/audio/jdoa1-10.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "0f6b49f9efc90031141f68842efe839ef94e8a0f5f613a6faa6d1c516c58c847",
          "text": "Vielleicht haben Sie eine Idee, wo der Film sein kÃ¶nnte.",
          "source_text": "Maybe you have an idea where the film might be.",
          "transcription_review_required": false
        },
        "jdoa1-20": {
          "path": "res://assets/languages/de/audio/jdoa1-20.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "762259741ceb0841aef2f4250ce0bf87d5103537e9c43c9f4eef3d0f2911f430",
          "text": "Kluge Alice in diesen Film?",
          "source_text": "Wise Alice into this film?",
          "transcription_review_required": false
        },
        "jdoa1-21": {
          "path": "res://assets/languages/de/audio/jdoa1-21.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c51c61dd897d98df0a025cc3afadfeb89d73763ee32385071fbdf813f1697d1f",
          "text": "Warum glauben Sie das?",
          "source_text": "Why do you think so?",
          "transcription_review_required": false
        },
        "jdoa1-22": {
          "path": "res://assets/languages/de/audio/jdoa1-22.mp3",
          "source": "Google Translate TTS (gTTS)",
          "sha256": "c1816b9edfff49d0619a6b0c3005924194ba2e8adc24b9cb58f37fb3c8fe03cd",
          "text": "Jeder ist in Jimmy verknallt! Du auch?",
          "source_text": "Everyone's got a crush on Jimmy! You, too?",
