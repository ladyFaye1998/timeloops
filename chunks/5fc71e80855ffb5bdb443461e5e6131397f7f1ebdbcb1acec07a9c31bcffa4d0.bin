pû -`ý^•ŸKï
<ÂrùïÙl—‰ðÔZ*s#b¶q	\-ƒ²,»Qäò€áæÍ9óì\ñåJÇ#?Ó# <5ðöÖ&½¢s%ü¼®±FáçÕ¯hÃ5ê“c¹ÏË`.½Zíå}˜.½àã>ºNxƒñ{ÞÂ”d´ãÞb¿␀8zBÿÃb}öò5þðU¯öàÿp÷Îƒcz•Û1Ša†1ëG‘‰‰ÆçÂ©\üÂ’SÇ‚ï5cÿÀÃGWÿ?8L×¢œÛëàž¬K½6É¤Åúä*&àçWe¿•í oÁG,”ßþ7xØ÷Œ%=æÿB2þôöfûŽ™;³ü3w¾ÁÀé…fZáïÐ·/]¼ _þ:-ß␀ÿ~üÊ»‹¯ýŠøËŠ>“5ÏÄëƒÉŽ'␀·±£Zì#)÷Ù@ã³€¸s½¢ÒÐÃÚÂÅ
~rîœY‹-Ð·ïñ@·‹éécbÜ“£è#ÁH(?␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

// All variants share one source canvas. The authored head poses replace only
// the local head/neck area; torso, chair, wrists and feet stay registered.
// GLES3 reserves texture units above the eight custom canvas slots available
// on a 16-unit WebGL device. Retired pose samplers must not remain declared:
// even unused declarations occupy slots and can alias the blue normal map.
uniform sampler2D typing_pose : source_color, filter_linear, repeat_disable;
uniform sampler2D head_turn_atlas : source_color, filter_linear, repeat_disable;
uniform sampler2D head_mouth_atlas : source_color, filter_linear, repeat_disable;
uniform sampler2D head_blink_atlas : source_color, filter_linear, repeat_disable;
uniform bool use_head_atlas = false;
uniform vec2 source_size = vec2(1672.0, 941.0);
uniform vec4 typing_bounds = vec4(548.0, 356.0, 94.0, 62.0);
uniform vec4 head_bounds = vec4(710.0, 14.0, 250.0, 250.0);
uniform float gaze_progress : hint_range(0.0, 1.0) = 0.0;
uniform float mouth_mix : hint_range(0.0, 1.0) = 0.0;
uniform float blink_mix : hint_range(0.0, 1.0) = 0.0;
uniform float typing_mix : hint_range(0.0, 1.0) = 0.0;
uniform float edge_cleanup : hint_range(0.0, 1.0) = 1.0;
varying vec4 tint;

// Nine opaque drawings provide genuine angular in-betweens. Per-cell neck
// anchors keep the new drawings attached to the unchanged seated body.
const float TURN_NECK_X[9] = float[](279.42,270.31,269.80,288.53,273.74,270.66,286.86,274.72,278.18);
const vec2 TURN_MOUTH[9] = vec2[](vec2(123.0,274.0),vec2(127.0,276.0),vec2(137.0,274.0),vec2(166.0,274.0),vec2(156.0,270.0),vec2(175.0,273.0),vec2(204.0,275.0),vec2(206.0,275.0),vec2(220.0,276.0));
// Trace the closed lip seam in each drawing. Coordinates are local to the
// 418px head cell. The seam bends with the smile and the head angle; it is
// not a horizontal strip through the teeth. Both commissures remain fixed.
const vec2 LIP_CORNERS[9] = vec2[](
    vec2(111.0,140.0),vec2(113.0,144.0),vec2(118.0,160.0),
    vec2(151.0,189.0),vec2(139.0,187.0),vec2(156.0,205.0),
    vec2(182.0,235.0),vec2(181.0,239.0),vec2(190.0,250.0));
const vec4 LIP_SEAM_Y[9] = vec4[](
    vec4(271.0,274.0,273.0,270.0),vec4(274.0,277.0,274.0,271.0),
    vec4(274.0,277.0,273.0,270.0),vec4(271.0,271.0,270.0,267.0),
    vec4(266.0,270.0,268.0,264.0),vec4(270.0,273.0,272.0,267.0),
    vec4(272.0,274.0,273.0,267.0),vec4(272.0,274.0,274.0,268.0),
    vec4(273.0,276.0,272.0,267.0));
const float LIP_RIGHT_Y[9] = float[](266.0,267.0,263.0,263.0,257.0,259.0,260.0,260.0,260.0);

float lip_seam(float t, int key) {
    vec4 ys = LIP_SEAM_Y[key];
    float segment = clamp(t,0.0,1.0)*4.0;
    // Cubic interpolation avoids a sharp hinge between traced control points.
    float f = fract(segment);
    f = f*f*(3.0-2.0*f);
    if (segment < 1.0) return mix(ys.x,ys.y,f);
    if (segment < 2.0) return mix(ys.y,ys.z,f);
    if (segment < 3.0) return mix(ys.z,ys.w,f);
    return mix(ys.w,LIP_RIGHT_Y[key],smoothstep(3.0,4.0,segment));
}

vec3 articulate_lips(vec2 local, vec2 cell, int key, vec3 neutral) {
    float aperture = clamp(mouth_mix,0.0,1.0);
    if (aperture <= 0.0) return neutral;
    vec2 corners = LIP_CORNERS[key];
    float t = (local.x-corners.x)/(corners.y-corners.x);
    if (t <= 0.0 || t >= 1.0) return neutral;
    float seam = lip_seam(t,key);
    float curve = pow(sin(t*3.14159265),1.25);
    float gap = 12.0*aperture*curve;
    float lift = gap*0.10;
    float drop = gap*0.90;
    float upper = seam-lift;
    float lower = seam+drop;
    // Translate each painted lip intact. Only surrounding skin relaxes back
    // to its original position; lip thickness is never scaled by aperture.
    float above = local.y-upper;
    float below = local.y-lower;
    float offset = local.y < seam ? lift : -drop;
    float distance = local.y < seam ? max(-above,0.0) : max(below,0.0);
    offset *= 1.0-smoothstep(12.0,28.0,distance);
    vec2 moved = local+vec2(0.0,offset);
    vec4 lip = texture(head_turn_atlas,(cell*418.0+moved)/1254.0);
    vec3 drawing = mix(neutral,lip.rgb,smoothstep(0.90,0.99,lip.a));

    // The dark cavity lies between the two intact lips. Tooth/tongue colour
    // is borrowed only from the authored interior, never from a vertically
    // flattened whole mouth. A tiny opening is a dark seam, not white teeth.
    float v = clamp((local.y-upper)/max(gap,0.001),0.0,1.0);
    vec2 inside = vec2(local.x,seam-1.5+v*12.0*curve);
    vec4 authored = texture(head_mouth_atlas,(cell*418.0+inside)/1254.0);
    vec3 cavity = vec3(0.115,0.018,0.030);
    float interior_exposure = smoothstep(2.5,7.0,gap);
    // Opaque interior pixels only; transparent profile edges cannot enter
    // the face. Neutral art still owns the character silhouette and alpha.
    cavity = mix(cavity,authored.rgb,interior_exposure*smoothstep(0.90,0.99,authored.a));
    float opening = smoothstep(-0.45,0.45,local.y-upper)
        * (1.0-smoothstep(-0.45,0.45,local.y-lower));
    opening *= smoothstep(0.0,0.7,gap);
    return mix(drawing,cavity,opening);
}

vec4 head_key(vec2 pixel, int key) {
    vec2 cell = vec2(float(key % 3), float(key / 3));
    vec2 local = (pixel - vec2(693.4,12.0)) / 0.65;
    local.x += TURN_NECK_X[key] - TURN_NECK_X[0];
    if (local.x < 0.0 || local.y < 0.0 || local.x >= 418.0 || local.y >= 418.0) return vec4(0.0);
    vec2 atlas_uv = (cell * 418.0 + local) / 1254.0;
    vec4 drawing = texture(head_turn_atlas, atlas_uv);
    drawing.rgb = articulate_lips(local,cell,key,drawing.rgb);
    vec2 eye_edge = min(local-vec2(66.0,174.0),vec2(280.0,237.0)-local);
    float eyes = smoothstep(0.0,8.0,min(eye_edge.x,eye_edge.y));
    vec4 eyelids = texture(head_blink_atlas,atlas_uv);
    // The head drawing owns opacity. A transparent edge in the blink sheet
    // must never punch a rectangular hole through the face.
    drawing.rgb = mix(drawing.rgb,eyelids.rgb,eyes*blink_mix*smoothstep(0.90,0.99,eyelids.a));
    return drawing;
}

float region_mask(vec2 pixel, vec4 bounds) {
	vec2 edge = min(pixel - bounds.xy, bounds.xy + bounds.zw - pixel);
	return smoothstep(0.0, 4.0, min(edge.x, edge.y));
}

void vertex() { tint = COLOR; }

void fragment() {
	vec2 pixel = UV * source_size;
	vec4 actor = texture(TEXTURE, UV);
	float head = region_mask(pixel, head_bounds);
	if (use_head_atlas && head > 0.0) {
		int key = int(clamp(floor(gaze_progress * 8.0 + 0.5),0.0,8.0));
		vec4 drawing = head_key(pixel,key);
		// One head atlas is used at rest as well as in every turn frame,
		// avoiding an endpoint pose/scale jump. The original shoulder/neck
		// remains beneath the head and owns the join below the jaw.
		float neck_join = smoothstep(216.0,238.0,pixel.y);
		actor = mix(actor,mix(drawing,actor,neck_join),head);
	}
	actor = mix(actor, texture(typing_pose, UV), region_mask(pixel, typing_bounds) * typing_mix);
	// Suppress weak coloured matte residue while retaining opaque ink and all
	// interior pixels. Source PNGs and registration are never rewritten.
	actor.a *= mix(1.0, smoothstep(0.18, 0.72, actor.a), edge_cleanup);
	COLOR = actor * tint;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform float clock_seconds = 0.0;
uniform float strength : hint_range(0.0, 1.0) = 0.15;
uniform float tunnel : hint_range(0.0, 1.0) = 0.0;
uniform vec2 focus = vec2(0.5, 0.5);
uniform float aspect = 1.7777778;
uniform float blur_amount : hint_range(0.0, 1.0) = 0.0;
uniform float depth_progress : hint_range(0.0, 1.0) = 0.0;
uniform float edge_feather : hint_range(0.0, 0.2) = 0.0;
uniform float oblique_aperture : hint_range(0.0, 1.0) = 0.0;
uniform float interior_scale = 1.0;
// The light is laid out on this frame, given in this rect's UV (offset,
// size); the rect itself may be larger, e.g. to reach all the masked glass.
uniform vec4 light_frame = vec4(0.0, 0.0, 1.0, 1.0);
// Visible glass of the bedroom monitor, cut from the room art: the plant
// leaf and flowers in front of the screen stay in front of the light.
uniform sampler2D glass_mask : filter_linear_mipmap, repeat_disable;
uniform float glass_mask_mix : hint_range(0.0, 1.0) = 0.0;
varying vec4 tint;

void vertex() { tint = COLOR; }

void fragment() {
	vec2 uv = (UV - light_frame.xy) / light_frame.zw;
	vec2 p = (uv - focus) * vec2(aspect, 1.0) * interior_scale;
	float radius = length(p);
	float angle = atan(p.y, p.x);
	float breath = 0.96 + 0.04 * sin(clock_seconds * 1.3);
	float core = exp(-radius * radius * 22.0);
	float halo = exp(-radius * radius * 3.0);
	float wave = pow(0.5 + 0.5 * sin(radius * 25.0 - clock_seconds * 2.6 - depth_progress * 32.0 + sin(angle * 3.0) * 0.4), mix(10.0, 3.0, blur_amount));
	float rays = pow(0.5 + 0.5 * sin(angle * 11.0 + radius * 5.0 + clock_seconds * 0.12), 12.0);
	float dust = 0.0;
	// Bounded deterministic particles drift towards the light at render rate.
	for (int i = 0; i < 22; i++) {
		float seed = float(i);
		float phase = fract(seed * 0.6180339 + clock_seconds * (0.035 + mod(seed, 3.0) * 0.008));
		float a = seed * 2.39996 + clock_seconds * 0.045;
		vec2 point = vec2(cos(a), sin(a)) * (1.0 - phase) * 0.95;
		dust += exp(-dot(p - point, p - point) * 16000.0) * sin(phase * 3.14159265);
	}
	vec3 glow = mix(vec3(0.20, 0.76, 0.85), vec3(1.0, 0.87, 0.69), core);
	float light = (core * 0.65 + halo * 0.20 + wave * halo * 0.17 + rays * halo * 0.09 + dust * 0.6) * strength * breath;
	vec3 night = mix(vec3(0.025, 0.055, 0.12), vec3(0.15, 0.08, 0.20), uv.y);
	vec3 tunnel_color = night + glow * light * 1.8;
	// The recovered blur beat now visibly blooms the aperture before the
	// camera enters it; the same bloom decays continuously during expansion.
	float bloom = blur_amount * exp(-radius * radius * 2.8);
	tunnel_color = mix(tunnel_color, vec3(1.0, 0.965, 0.88), bloom * 0.88);
	float edge_distance = min(min(UV.x, 1.0 - UV.x) * aspect, min(UV.y, 1.0 - UV.y));
	float coverage = edge_feather > 0.0001 ? smoothstep(0.0, edge_feather, edge_distance) : 1.0;
	// Match the actual trapezoid of the bedroom monitor. This stays attached
	// to the screen while Julia crosses and the common camera moves through it.
	float top = uv.y - uv.x * 0.32;
	float left = uv.x - uv.y * 0.12;
	float oblique = smoothstep(0.0, 0.012, min(top, left));
	float frame = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
	// The visible glass from the room art can replace the trapezoid.
	coverage *= mix(mix(1.0, oblique, oblique_aperture) * frame, texture(glass_mask, UV).r, glass_mask_mix);
	COLOR = vec4(mix(glow, tunnel_color, tunnel), mix(clamp(light, 0.0, 0.85), 1.0, tunnel) * coverage) * tint;
}
␀␀shader_type canvas_item;
render_mode unshaded;

// Portal-only actor layer. A separate authored empty chair stays in the room.
uniform vec2 actor_origin = vec2(0.0);
uniform float actor_scale = 1.0;
uniform float actor_roll = 0.0;
uniform vec2 screen_edge = vec2(176.0, 88.0);
uniform float screen_edge_slope = 0.05;
uniform float crossing_enabled = 0.0;
uniform float entry_light = 0.0;
varying vec2 scene_point;
varying vec4 tint;

void vertex() {
	tint = COLOR;
	float c = cos(actor_roll), s = sin(actor_roll);
	vec2 p = VERTEX * actor_scale;
	scene_point = actor_origin + vec2(c*p.x-s*p.y, s*p.x+c*p.y);
}

void fragment() {
	vec4 pixel = texture(TEXTURE, UV);
		// Crossing is a physical plane, not a whole-body opacity dissolve.
		// Leading hands/head disappear first; trailing feet remain in-room.
		float plane_x = screen_edge.x + (scene_point.y-screen_edge.y)*screen_edge_slope;
		float outside = smoothstep(-0.75, 0.75, scene_point.x-plane_x);
		float rim = exp(-abs(scene_point.x-plane_x)*0.11)*entry_light;
		pixel.rgb = mix(pixel.rgb, vec3(0.66,0.93,1.0), rim*0.65);
		pixel.a *= mix(1.0, outside, crossing_enabled);
	COLOR = pixel * tint;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[remap]

