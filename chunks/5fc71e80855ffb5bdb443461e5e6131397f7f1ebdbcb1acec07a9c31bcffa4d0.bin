render_mode unshaded;
uniform vec2 clip_points[64];
uniform int clip_count=0;
uniform bool proximal_left=false;
void fragment(){
 vec2 p=UV/TEXTURE_PIXEL_SIZE;
 float d=100000.;bool inside=false;
 for(int i=0;i<64;i++){
  if(i>=clip_count)break;
  int j=i+1;if(j>=clip_count)j=0;
  vec2 a=clip_points[i];vec2 b=clip_points[j];vec2 v=b-a;
  float t=clamp(dot(p-a,v)/max(dot(v,v),.00001),0.,1.);
  d=min(d,length(p-(a+t*v)));
  if((a.y>p.y)!=(b.y>p.y)){
   float crossing=(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x;
   if(p.x<crossing)inside=!inside;
  }
 }
 float width=max(length(dFdx(p)),length(dFdy(p)))*.8;
 COLOR.a*=smoothstep(-width,width,inside?d:-d);
 if(proximal_left)COLOR.a*=1.-smoothstep(655.,685.,p.y);
}
