ê°yÿýótv–3u␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

// The regenerated room supplies a subdued color wash behind the complete
// interactive 4:3 stage. It never replaces that stage or its hit geometry.
void fragment() {
	vec2 offset = TEXTURE_PIXEL_SIZE * 28.0;
	vec3 room = textureLod(TEXTURE, UV, 5.0).rgb * 0.20;
	room += textureLod(TEXTURE, UV + vec2(offset.x, 0.0), 5.0).rgb * 0.12;
	room += textureLod(TEXTURE, UV - vec2(offset.x, 0.0), 5.0).rgb * 0.12;
	room += textureLod(TEXTURE, UV + vec2(0.0, offset.y), 5.0).rgb * 0.12;
	room += textureLod(TEXTURE, UV - vec2(0.0, offset.y), 5.0).rgb * 0.12;
	room += textureLod(TEXTURE, UV + offset, 5.0).rgb * 0.08;
	room += textureLod(TEXTURE, UV - offset, 5.0).rgb * 0.08;
	room += textureLod(TEXTURE, UV + vec2(offset.x, -offset.y), 5.0).rgb * 0.08;
	room += textureLod(TEXTURE, UV + vec2(-offset.x, offset.y), 5.0).rgb * 0.08;
	float edge = smoothstep(0.15, 0.75, abs(UV.y - 0.5));
	COLOR = vec4(mix(vec3(0.075, 0.059, 0.049), room, mix(0.36, 0.23, edge)), 1.0);
}
