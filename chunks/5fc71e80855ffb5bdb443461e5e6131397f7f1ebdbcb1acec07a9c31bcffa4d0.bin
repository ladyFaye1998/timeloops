T3Ûé>¯­W»ÿ°~âÕ␀º¤ªÛ<þ½³fÀò␀G`°2Îöàràoáâg÷ÛÚºya¬þ}üô{½~›␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform sampler2D neutral_image:source_color,filter_linear_mipmap;
uniform sampler2D offer_image:source_color,filter_linear_mipmap;
uniform vec2 neutral_points[32];
uniform vec2 offer_points[32];
uniform int neutral_count=0;
uniform int offer_count=0;
uniform vec3 neutral_row0;
uniform vec3 neutral_row1;
uniform vec3 offer_row0;
uniform vec3 offer_row1;
uniform float shape_mix=0.;
uniform vec3 fallback_color=vec3(.04,.72,.52);
varying vec2 local_point;
varying vec4 tint;
void vertex(){local_point=VERTEX;tint=COLOR;}
float boundary(vec2 p,bool offered){
 int count=offered?offer_count:neutral_count;float d=100000.;bool inside=false;
 for(int i=0;i<32;i++){
  if(i>=count)break;int j=i+1;if(j>=count)j=0;
  vec2 a=offered?offer_points[i]:neutral_points[i];vec2 b=offered?offer_points[j]:neutral_points[j];vec2 v=b-a;
  float t=clamp(dot(p-a,v)/max(dot(v,v),.00001),0.,1.);d=min(d,length(p-a-t*v));
  if((a.y>p.y)!=(b.y>p.y)&&p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)inside=!inside;
 }
 return inside?d:-d;
}
void fragment(){
 vec3 p=vec3(local_point,1.);
 vec2 q0=vec2(dot(neutral_row0,p),dot(neutral_row1,p));
 vec2 q1=vec2(dot(offer_row0,p),dot(offer_row1,p));
 float d0=boundary(q0,false);float d1=boundary(q1,true);
 float d=mix(d0,d1,shape_mix);float width=max(length(dFdx(local_point)),length(dFdy(local_point)))*.8;
 vec4 c0=texture(neutral_image,q0/vec2(1024.,1536.));vec4 c1=texture(offer_image,q1/vec2(1024.,1536.));
 float w0=(1.-shape_mix)*smoothstep(-2.,2.,d0)*c0.a;
 float w1=shape_mix*smoothstep(-2.,2.,d1)*c1.a;
 vec3 color=(c0.rgb*w0+c1.rgb*w1)/max(w0+w1,.00001);
 float coverage=smoothstep(-width,width,d);
 if(w0+w1<.0001)color=fallback_color;
 COLOR=vec4(color,coverage)*tint;
}
