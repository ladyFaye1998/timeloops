°°™¡Õ;ô]7¯âI& ½¯­üx]Û{‚¿™ïœ…X¬õV†ýú~ãøÞ7W?m¾reZ­õ½ŸùÒI'9H?€Kƒ5ó÷õ?lhÅO}àßKfñ×Mä¿¾œ—Þœ­mú␀ÜÙânvªµm8Dk¼úO=ý«ÄÛ³VŠÍ›’3½˜\Ô7jgãp¸Ø¬Ÿ6soT«‡ßæÃ¾ôTvæVG¹6nÕG¿×çž&K;ròÛ]ž·ø«¯<ëàˆe±æ0·õ¿{ä,ÿ×©ƒq+U␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform float phase = 0.0;

void fragment() {
	vec2 stage = UV * vec2(640.0,480.0);
	// Stay inside the painted pool. The shoreline, paving and clue never move.
	// Hand-measured new plate: pool interior center670,595/radii610,70 at1448x1086.
	vec2 painted = UV * vec2(1448.0,1086.0);
	vec2 pool = (painted - vec2(670.0,595.0)) / vec2(610.0,70.0);
	float water = 1.0 - smoothstep(0.78,1.0,dot(pool,pool));
	// Foreground cast-iron pole is solid, even where it crosses the water.
	water *= smoothstep(40.0,44.0,abs(painted.x - 168.0));
	float drift = sin(stage.y * 0.72 + phase * 1.35) * 0.62;
	drift += sin(stage.y * 1.57 - phase * 0.85 + stage.x * 0.02) * 0.22;
	vec2 shifted = UV + vec2(drift * water / 640.0,0.0);
	COLOR = vec4(texture(TEXTURE,shifted).rgb,water);
}
