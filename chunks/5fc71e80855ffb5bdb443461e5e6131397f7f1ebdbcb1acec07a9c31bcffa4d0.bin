Ô/"]p\¥$c¼} óS^ò.€èoŠ6.Æ8¥;±ýg‹jc÷ß«÷ž;Ý|¥˜¯â¯ÃŽx.ölÙ›Àf«”' Ÿ–_Ã*ÿ²ëÆŽ[a2x5è&ŸSýr‡ÏÌÌÑåªõ*1Àcë—úŒ¼Œ—–Â¢ªO»´>}ô~2;Ù°'·Á3uñu ¼µÚg…0‘®²aÑ6÷Iœh<ÓIÕ÷Ñ°cß¬šyh_ð&r‹²3šDöÍÜ¥“ÛãU 3Úð{ûSÆ\÷ì=_º?ûôÓèÏÑmâ3æ±gÂW×3ýgñZpör¼W®j(7Þå"æeq
KGÿ‰}‡g8ºŠøŽ~à¶h5ò‘°l3›ËÌmnÊüˆ»ùˆÃùü£,îpåB×þ}ÿÐ·ýµ¢8èœ³õ×Ó÷Iý¦æ>ûqóíÕ¡~ýcðù—îÕÍÆXÓsüÆ¿iÚ¦jAï¿ðkX>ë[újü$à-Å#wê_ÿÑá	à§»BõÖÕìˆfS‡Œð—ž×³É¬Ëj×«åø­^9{u«ó}\1ä~6–G~␀8º†atÙ)ì“°mÒî©Çû=Ý&·úCüŠàõ­Éüxàß vº9Æ~ óÐDOÛÞ" ]^ÔöÊ^»à£<š.¬µNÂE³ÝÁ/»ùÂï|²3à†vñeyXŸçxMßhý¢Ñ;ÎÌgûÉ2>øæîˆ0ì¹ÍéþŸ<Aw.G®ò*Ü£ëþÊp˜£í¶ù ó1vÛí{¿á\„7sér|”Ç‚Gó†}[!Çd÷¸LÚß—Ù ¿²Õ®"ücøï?‚~ÒÚQ–ÏH¹fYÌ1üÕÞýrÜÁ½Q>+ôÐ6è×î~Ô/“¦®qÞäy”à8Ì‡ãÔKüåm€ÓÈ␀¸Ø¡š©}8¯%ûòÆ®o°ìˆ~î'ïñã2é½Í7ˆ—ÆãºlÏþîk¡~“Œ°ö9‹zäƒxªA|ò?¼¯£«ÙÀŽüwq€=°3ƒíuÏ$å<ŒæªFÏDÑ<70#áõ˜€ð”³ýX‡=ù®EF´8Ü]ûa8£ÆãjŒÅˆÃv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform int bird_id = 0;
uniform float motion_seconds = 0.0;
const vec2 SOURCE_SIZE = vec2(1536.0,1024.0);

float rectangle(vec2 p,vec2 lo,vec2 hi) {
	return step(lo.x,p.x)*step(p.x,hi.x)*step(lo.y,p.y)*step(p.y,hi.y);
}

int bird_region(vec2 p) {
    // New shared birds are separated at transparent gaps, including the
    // central bird's wider shoulder. Keep motion from borrowing its pixels.
    float left_edge = 613.0;
    if (p.y >= 590.0) left_edge = 650.0;
    else if (p.y >= 565.0) left_edge = mix(638.0,650.0,(p.y-565.0)/25.0);
    else if (p.y >= 540.0) left_edge = mix(613.0,638.0,(p.y-540.0)/25.0);
    float right_edge = 930.0;
    if (p.y >= 660.0) right_edge = 1250.0;
    else if (p.y >= 640.0) right_edge = mix(1180.0,1250.0,(p.y-640.0)/20.0);
    else if (p.y >= 550.0) right_edge = mix(1160.0,1180.0,(p.y-550.0)/90.0);
    else if (p.y >= 360.0) right_edge = mix(930.0,1160.0,(p.y-360.0)/190.0);
    if (p.x < left_edge && p.y > 390.0) return 0;
    if (p.x > right_edge && p.y < 675.0) return 2;
    return 1;
}

vec2 bird_offset(vec2 p,int id) {
	float t=motion_seconds;
	vec2 offset=vec2(0.0);
	if (id == 0) {
		float head=(1.0-smoothstep(220.0,400.0,p.x))*smoothstep(510.0,650.0,p.y);
		float feet=max(rectangle(p,vec2(115.0,782.0),vec2(338.0,900.0)),rectangle(p,vec2(385.0,763.0),vec2(555.0,915.0)));
		float peck=pow(sin(t*3.14159265/2.4),2.0);
		offset=vec2(5.0*sin(t*1.1),-34.0*peck)*head*(1.0-feet);
		offset.y-=2.3*sin(t*1.7)*(1.0-smoothstep(715.0,775.0,p.y))*(1.0-head);
	} else if (id == 1) {
		float head=(1.0-smoothstep(425.0,565.0,p.y))*(1.0-smoothstep(790.0,900.0,p.x));
		float glance=sin(t*0.85);
		offset=vec2(13.0*glance,-5.0*pow(sin(t*1.0),2.0))*head;
		float chest=exp(-pow((p.x-850.0)/220.0,2.0))*smoothstep(430.0,560.0,p.y)*(1.0-smoothstep(710.0,770.0,p.y));
		offset.x+=3.0*sin(t*1.35)*chest;
	} else {
		float head=smoothstep(1305.0,1435.0,p.x)*smoothstep(385.0,450.0,p.y);
		float feet=rectangle(p,vec2(1175.0,548.0),vec2(1445.0,690.0));
		float peck=pow(sin((t+1.4)*3.14159265/2.9),2.0);
		offset=vec2(-3.0*sin(t*1.0),-25.0*peck)*head*(1.0-feet);
		offset.y-=2.0*sin(t*1.4+1.8)*(1.0-smoothstep(500.0,550.0,p.y))*(1.0-head);
	}
	return offset;
}

void fragment() {
	vec2 destination=vec2(14.0,205.0)+UV*vec2(1518.0,713.0);
	vec2 source=destination-bird_offset(destination,bird_id);
	vec4 paint=texture(TEXTURE,source/SOURCE_SIZE);
	paint.a*=bird_region(source)==bird_id ? 1.0 : 0.0;
	COLOR=paint;
}
