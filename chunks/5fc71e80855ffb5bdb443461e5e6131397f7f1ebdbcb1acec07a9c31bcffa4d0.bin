þMšÍ¸w“×\R7hÔWBï-dƒ¶ò†‘öAjØ␀É¼ò|Ý®Y—OY¼õ{K<HóþY¿ñ÷¦ÏN8õrpcõ%pßö1¬à_/xÇ;3]»è+øy0Ã)üóS¡š·Ýô¥‚Ž ÿÓ&-Ü¤Ÿr=©çréÂv1lûç¥ÐÃ†.ËQçþy2çIú/ž¿;Y½ƒçÐ/Í7ÏÚÁ…ïÿ•äC6AÝvoÃÑrZxï×ls]`1Ù␀î{DWáÌáî«–Ÿê×=èöú&O°ÚË9ÌGÉžÐéoðò <hœŠ÷rÔO(ä¯è«wâ°ÏÝ„ÏpÃ’GjÓ7ö—¹¬Sâ^ô˜±1ÛîÚ&Pi;87ÿð&&¼ÞqÕ¶ö¶óŸÜ^#|º[Üž{A‚G1¨wM-çpªsºÄ½5ï•u ‡–L‘Ÿ¿D=õâ“è+ê¾Ì‰=™Õê<]>…Ç{y[O§âüßÕkp§Úr<@áÂp07TôÝÂ´¶o¢ý=z›özý7nûñtÁå␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
// Analytic coverage of a registered donor mask. No old image frames or state.
uniform vec2 clip_points[32];
uniform int clip_count = 0;
void fragment() {
    vec2 p = UV / TEXTURE_PIXEL_SIZE;
    float d = 100000.0;
    bool inside = false;
    for (int i=0; i<32; i++) {
        if (i>=clip_count) { break; }
        int next_i = i+1;
        if (next_i>=clip_count) { next_i=0; }
        vec2 a=clip_points[i]; vec2 b=clip_points[next_i];
        vec2 v=b-a;
        float t=clamp(dot(p-a,v)/max(dot(v,v),0.00001),0.0,1.0);
        d=min(d,length(p-(a+t*v)));
        if ((a.y>p.y)!=(b.y>p.y)) {
            float crossing=(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x;
            if (p.x<crossing) { inside=!inside; }
        }
    }
    float width=max(length(dFdx(p)),length(dFdy(p)))*0.8;
    float coverage=smoothstep(-width,width,inside?d:-d);
    COLOR.a *= coverage;
}
