func _make_mell_chroma_key_material() -> ShaderMaterial:
	# The recovered Mell frames are animation cells on a flat mint-green field.
	# Key only that field; unlike the removed Dylen white-key shader, this keeps
	# the character's eyes, clothing, and light facial details intact.
	var shader: Shader = Shader.new()
	shader.code = """
shader_type canvas_item;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	vec3 mint_key = vec3(0.20, 0.95, 0.66);
	float key_distance = distance(source.rgb, mint_key);
	float exact_key = 1.0 - smoothstep(0.07, 0.34, key_distance);
	float green_excess = source.g - max(source.r, source.b);
	float mixed_edge = smoothstep(0.055, 0.19, green_excess)
		* smoothstep(0.20, 0.64, source.g);
	float keyed = max(exact_key, mixed_edge);
	float neutral_green = min(source.g, max(source.r, source.b));
	vec3 despilled = vec3(
		source.r,
		mix(source.g, neutral_green, mixed_edge),
		source.b
	);
	COLOR = vec4(despilled, source.a * (1.0 - keyed));
}
"""
	var result: ShaderMaterial = ShaderMaterial.new()
	result.shader = shader
	return result


func _add_world_hotspot(
	hotspot_id: String,
	bounds: Rect2,
	label_key: String,
	observation_key: String
) -> Button:
	var hotspot: Button = Button.new()
	hotspot.position = bounds.position
	hotspot.size = bounds.size
	hotspot.focus_mode = Control.FOCUS_ALL
	hotspot.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	hotspot.z_index = 900
	hotspot.add_theme_stylebox_override("normal", StyleBoxEmpty.new())
	hotspot.add_theme_stylebox_override("hover", StyleBoxEmpty.new())
	hotspot.add_theme_stylebox_override("pressed", StyleBoxEmpty.new())
	hotspot.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	hotspot.pressed.connect(_on_world_hotspot_pressed.bind(hotspot_id))
	hotspot.mouse_entered.connect(_show_hotspot_prompt.bind(hotspot_id))
	hotspot.mouse_exited.connect(_hide_hotspot_prompt)
	hotspot.focus_entered.connect(_show_hotspot_prompt.bind(hotspot_id))
	hotspot.focus_exited.connect(_hide_hotspot_prompt)
	_stage_root.add_child(hotspot)
	_world_hotspots[hotspot_id] = hotspot
	_hotspot_observation_keys[hotspot_id] = {
		"label": label_key,
		"observation": observation_key,
	}
	return hotspot


func _build_hotspot_prompt() -> void:
	_hotspot_prompt = PanelContainer.new()
	_hotspot_prompt.z_index = 1200
	_hotspot_prompt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotspot_prompt.visible = false
	_hotspot_prompt.add_theme_stylebox_override(
		"panel",
		JuliaThemeFactory.make_box(
			Color(PAPER, 0.97),
			GOLD,
			0,
			0,
			12.0,
			7.0
		)
	)
	_stage_root.add_child(_hotspot_prompt)

	_hotspot_prompt_label = Label.new()
	_hotspot_prompt_label.add_theme_font_size_override("font_size", 16)
	_hotspot_prompt_label.add_theme_color_override("font_color", INK)
	_hotspot_prompt.add_child(_hotspot_prompt_label)


func _show_hotspot_prompt(hotspot_id: String) -> void:
	if (
		_view_mode != ViewMode.FIRST_SCENE
		or not _hotspot_observation_keys.has(hotspot_id)
	):
		return
	var metadata: Dictionary = _hotspot_observation_keys[hotspot_id]
	_hotspot_prompt_label.text = _copy(str(metadata["label"]))
	_hotspot_prompt_label.text_direction = (
		Control.TEXT_DIRECTION_RTL
		if _locale == "he"
		else Control.TEXT_DIRECTION_LTR
	)
	var hotspot: Button = _world_hotspots[hotspot_id] as Button
	_hotspot_prompt.position = Vector2(
		clampf(hotspot.position.x, 18.0, 730.0),
		clampf(hotspot.position.y + hotspot.size.y + 8.0, 18.0, 486.0)
	)
	_hotspot_prompt.visible = true


func _hide_hotspot_prompt() -> void:
	if is_instance_valid(_hotspot_prompt):
		_hotspot_prompt.visible = false


func _on_world_hotspot_pressed(hotspot_id: String) -> void:
	if (
		_view_mode != ViewMode.FIRST_SCENE
		or _dialogue_busy
		or _casebook_open
		or not _hotspot_observation_keys.has(hotspot_id)
	):
		return
	_hide_hotspot_prompt()
	match hotspot_id:
		"alley":
			_change_street_view(StreetView.STREET4)
		"s4_to_street5":
			_change_street_view(StreetView.STREET5)
		"s4_to_street3":
			_change_street_view(StreetView.STREET3)
		"s3_to_street4":
			_change_street_view(StreetView.STREET4)
		_:
			_perform_world_interaction(hotspot_id)


func _perform_world_interaction(hotspot_id: String) -> void:
	if (
		_casebook_open
		or not _hotspot_observation_keys.has(hotspot_id)
	):
		return
	if hotspot_id == "neon" and _street5_slice != null:
		_street5_slice.run_section("LightClick")
	_play_sfx(CLICK_BUTTON_PATH)
	var metadata: Dictionary = _hotspot_observation_keys[hotspot_id]
	var observation: String = _copy(str(metadata["observation"]))
	var discovered: bool = false
	if STREET5_HOTSPOT_CLUES.has(hotspot_id):
		discovered = _discover_street5_clue(
			str(STREET5_HOTSPOT_CLUES[hotspot_id]),
			false
		)
	_show_toast(
		"%s\n%s" % [observation, _copy("casebook_clue_stamped")]
		if discovered
		else observation
	)


func _change_street_view(target: StreetView) -> void:
	if _casebook_open or _street_transitioning or target == _street_view:
		return
	_street_transitioning = true
	_update_casebook_access()
	_play_sfx(CLICK_BUTTON_PATH)
	if not _reduced_motion:
		var fade_out: Tween = create_tween()
		fade_out.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		fade_out.tween_property(_stage_texture, "modulate:a", 0.0, 0.16)
		await fade_out.finished
	_street_view = target
	_update_street_view_texture()
	_sync_street5_nodes()
	if _reduced_motion:
		_stage_texture.modulate.a = 1.0
	else:
		var fade_in: Tween = create_tween()
		fade_in.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
		fade_in.tween_property(_stage_texture, "modulate:a", 1.0, 0.24)
		await fade_in.finished
	_street_transitioning = false
	_update_casebook_access()


func _update_street_view_texture() -> void:
	var texture_path: String = STREET5_IMAGE_PATH
	match _street_view:
		StreetView.STREET4:
			texture_path = STREET4_IMAGE_PATH
		StreetView.STREET3:
			texture_path = STREET3_IMAGE_PATH
	_stage_texture.texture = _load_texture(texture_path)


func _make_stage_portrait_hotspot(
	position_value: Vector2,
	size_value: Vector2,
	callback: Callable
) -> Button:
	var result: Button = Button.new()
	result.position = position_value
	result.size = size_value
	result.focus_mode = Control.FOCUS_ALL
	result.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	result.add_theme_stylebox_override("normal", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("hover", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("pressed", StyleBoxEmpty.new())
	result.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	result.pressed.connect(callback)
	result.visible = false
	return result


func _build_side_panel() -> void:
	_side_panel = Panel.new()
	_side_panel.clip_contents = true
	_body.add_child(_side_panel)

	var side_margin: MarginContainer = MarginContainer.new()
	side_margin.name = "MenuRailMargin"
	side_margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	side_margin.add_theme_constant_override("margin_left", 24)
	side_margin.add_theme_constant_override("margin_top", 20)
	side_margin.add_theme_constant_override("margin_right", 24)
	side_margin.add_theme_constant_override("margin_bottom", 18)
	_side_panel.add_child(side_margin)

	var scroll: ScrollContainer = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	side_margin.add_child(scroll)
	NativeTouchScroll.attach(scroll)

	_side_content = VBoxContainer.new()
	_side_content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_side_content.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_side_content.add_theme_constant_override("separation", 8)
	scroll.add_child(_side_content)


func _build_footer(parent: VBoxContainer) -> void:
	_footer = HBoxContainer.new()
	_footer.custom_minimum_size.y = 30.0
	_footer.layout_direction = Control.LAYOUT_DIRECTION_LTR
	_footer.add_theme_constant_override("separation", 16)
	parent.add_child(_footer)

	_footer_status = Label.new()
	_footer_status.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_footer_status.add_theme_font_size_override("font_size", 13)
	_footer_status.add_theme_color_override("font_color", MUTED)
	_footer.add_child(_footer_status)

	_footer_shortcuts = Label.new()
	_footer_shortcuts.add_theme_font_size_override("font_size", 13)
	_footer_shortcuts.add_theme_color_override("font_color", MUTED)
	_footer.add_child(_footer_shortcuts)


func _build_transition_overlay() -> void:
	_transition_overlay = ColorRect.new()
