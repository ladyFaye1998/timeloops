«ÀÜbkÁoÞ¿Q,bã=îhÚŸ¼Ôj+ó†É.Åº½Q~åEöº#røÀðÚ­¿‹u|Ø}¿W:âÜËÂÞú¿ÃÜVq¨b¿tüÿ«Üu-èÈÇ<ûÜ÷ó`åð¨¤ámÝgt,>‚ò×¿ÆØ|§³ŸP½Õïñ5—œ¡Ÿì/Ì{UÉŒä²?¸'´ó>e~×©w”Ÿ³~Æ‡‘Ÿ"f†ÿyçjâs–öiÏg“ªyp.6ÿmcÁTx␀ÓNaßý_™!.Öí3ä÷v$÷Á­^—(ŠýeÛO¾7?œp
ÂŸ;iì›]`æ(sýEh	=¾†æÐ·ÝUvÄSx¨ú^¼:ö¿³6ãl™’'y3¢³ã†ûáå]õºOð}·ûñëôúQé þ½"BÁŸŸP<¦bpAüÿö ,dÌ	 ŸIt@sþsŸ“V—ç¾	àyŸ/œ%jØÄ_½oäXž¿Í`UÇgäóüuê2	÷	4à	X<bÅýið˜'ÎËéwýŸ‡>¡¹_õ—ÂQA^_·¿˜…7\␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform sampler2D underpaint:source_color,filter_linear_mipmap;
uniform sampler2D writing_arm:source_color,filter_linear_mipmap;
uniform vec2 writing_offset=vec2(0.0);
uniform vec3 arm_row0;
uniform vec3 arm_row1;
void fragment(){
 vec2 p=UV/TEXTURE_PIXEL_SIZE;
 vec4 backdrop=texture(underpaint,UV);
 vec2 q=p;
 for(int i=0;i<5;i++)q=p-writing_offset*smoothstep(441.,610.,q.x);
 vec2 arm_uv=vec2(dot(arm_row0,vec3(q,1.)),dot(arm_row1,vec3(q,1.)))/vec2(1024.,1536.);
 vec4 hand=texture(writing_arm,arm_uv);
 float a=hand.a+backdrop.a*(1.-hand.a);
 COLOR=vec4((hand.rgb*hand.a+backdrop.rgb*backdrop.a*(1.-hand.a))/max(a,.00001),a);
}
